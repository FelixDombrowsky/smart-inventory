    async function rpOpenLocDropdown() {
        const dd  = document.getElementById('rpLocDropdown')
        const btn = document.getElementById('rpLocBtn')
        if (dd.style.display !== 'none') { dd.style.display = 'none'; return }

        if (!navigator.geolocation) {
            showToast('This browser does not support GPS', 'error'); return
        }

        dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">⏳ Getting GPS…</div>'
        dd.style.display = ''
        btn.disabled = true

        let pos
        try {
            pos = await new Promise((res, rej) =>
                navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
            )
        } catch (e) {
            dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default">❌ GPS: ${e.message}</div>`
            btn.disabled = false; return
        }

        const lat = pos.coords.latitude
        const lng = pos.coords.longitude
        rpReceiveLat = lat
        rpReceiveLng = lng
        console.log('[GPS] lat:', lat, 'lng:', lng, 'accuracy:', pos.coords.accuracy, 'm')
        dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">⏳ Searching locations…</div>'

        try {
            const res = await api(`/location/gps-match?currentLatitude=${lat}&currentLongitude=${lng}`)
            const arr = Array.isArray(res) ? res : (res?.data || [])
            btn.disabled = false

            if (!arr.length) {
                dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">📍 No locations found within current GPS range</div>'
                return
            }

            dd.innerHTML = arr.map(l =>
                `<div class="wo-item" onmousedown="rpLocSelect('${escHtml(l.locationCode)}','${escHtml(l.locationType||'')}')">
                    <div style="display:flex;align-items:center;gap:6px">
                        <span style="font-weight:700;font-family:monospace">${escHtml(l.locationCode)}</span>
                        ${l.locationType ? `<span style="font-size:11px;background:var(--blue-lt);color:var(--blue);border-radius:4px;padding:1px 6px;font-weight:600">${escHtml(l.locationType)}</span>` : ''}
                        <span style="font-size:11px;color:var(--green);font-weight:600;margin-left:auto">~${(l.distanceMeters ?? 0).toFixed(1)} m</span>
                    </div>
                    ${l.description ? `<div style="font-size:11px;color:var(--t2);margin-top:2px">${escHtml(l.description)}</div>` : ''}
                </div>`
            ).join('')
        } catch (e) {
            btn.disabled = false
            dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default">Load failed: ${e.message}</div>`
        }
    }

