            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
        </div>`
        dd.style.display = 'block'
        clearTimeout(_rpPnTimer)
        _rpPnTimer = setTimeout(async () => {
            try {
                const res = await api(`/master/items?search=${encodeURIComponent(q)}&page=1&pageSize=20`, 'GET')
                _rpPnResults = res.data || []
