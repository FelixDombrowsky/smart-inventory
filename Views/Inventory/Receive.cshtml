@{
    ViewData["Title"] = "Receive Materials";
}
<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --green:#059669; --green-lt:#ecfdf5;
    --red:#dc2626;
}

/* Header */
.page-header {
    background:linear-gradient(135deg,var(--navy) 0%,#1e3a6e 60%,#1a6fff 100%);
    border-radius:16px; padding:20px 28px; margin-bottom:20px;
    position:relative; overflow:hidden;
}
.page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04); }
.page-header h2 { font-size:22px; font-weight:700; color:#fff; margin-bottom:4px; }
.page-header p  { font-size:13px; color:rgba(255,255,255,.65); margin:0; }

/* Cards */
.rx-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.rx-card-body { padding:22px 24px; }

/* Location */
.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:10px 12px 10px 38px;
    border:1.5px solid var(--border); border-radius:10px;
    font-size:14px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item {
    padding:10px 14px; font-size:13px; cursor:pointer;
    border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px;
    transition:.12s;
}
.loc-item:last-child { border-bottom:none; }
.loc-item:hover { background:var(--blue-lt); }
.loc-item:first-child { border-radius:8px 8px 0 0; }
.loc-item:last-child  { border-radius:0 0 8px 8px; }

/* Table */
.rx-table { width:100%; border-collapse:collapse; font-size:13px; }
.rx-table th {
    background:#f8f9fc; color:var(--t2); font-weight:700; font-size:11px;
    letter-spacing:.04em; text-transform:uppercase;
    padding:10px 16px; border-bottom:2px solid var(--border); text-align:left;
}
.rx-table td { padding:9px 16px; border-bottom:1px solid var(--border); vertical-align:middle; }
.rx-table tr:last-child td { border-bottom:none; }
.rx-table tbody tr:hover td { background:#fafbff; }
.rx-table tbody tr.row-err td { background:#fef2f2; }
.rx-table tbody tr.row-err td:first-child { border-left:3px solid var(--red); }
.rx-table tbody tr.row-err-detail td { background:#fef2f2; border-top:1px solid #fecaca; border-left:3px solid var(--red); padding:4px 14px 7px; }
.rx-table tbody tr.row-ok  td { background:var(--green-lt); opacity:.6; transition:opacity .4s; }
.rx-input { width:100%; padding:6px 9px; border:1.5px solid var(--border); border-radius:7px; font-size:13px; font-family:inherit; outline:none; box-sizing:border-box; }
.rx-input:focus { border-color:var(--blue); }
.rx-input.err { border-color:var(--red); background:#fff8f8; }
.del-btn  { width:30px; height:30px; border:none; border-radius:7px; background:#fef2f2; color:var(--red);  cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.del-btn:hover  { background:var(--red);  color:#fff; }
.view-btn { width:30px; height:30px; border:none; border-radius:7px; background:#eff6ff; color:var(--blue); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.view-btn:hover { background:var(--blue); color:#fff; }

/* Receive button */
.receive-btn {
    width:100%; padding:14px; border:none; border-radius:12px;
    font-size:15px; font-weight:700; font-family:inherit; cursor:pointer;
    transition:.2s; background:var(--blue); color:#fff; margin-top:16px;
}
.receive-btn:disabled { background:#e5e7eb; color:#9ca3af; cursor:not-allowed; }
.receive-btn:not(:disabled):hover { background:var(--blue-dk); }

/* Toast */
.toast-wrap { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.toast-item { padding:11px 20px; border-radius:10px; font-size:13px; font-weight:600; color:#fff; box-shadow:0 4px 16px rgba(0,0,0,.18); animation:tIn .25s ease; min-width:160px; }
.toast-ok   { background:var(--green); }
.toast-err  { background:var(--red); }
.toast-warn { background:#d97706; }
@@keyframes tIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:none} }
</style>

<partial name="_PhotoCapture" model="@("rc")" />

<div class="toast-wrap" id="toastWrap"></div>

<!-- Header -->
<div class="page-header">
    <div>
        <h2 style="display:flex;align-items:center;gap:10px;margin:0">
            Receive Materials
            <i class="bi bi-inbox me-1" style="color:#fff;opacity:.85"></i>
        </h2>
    </div>
</div>

<!-- Work Order + Location + Camera -->
<div class="rx-card">
    <div class="rx-card-body">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
            <!-- Work Order -->
            <div style="flex:1;min-width:180px">
                <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                    <i class="bi bi-box-seam me-1" style="color:var(--blue)"></i> Work Order <span style="color:var(--red)">*</span>
                </div>
                <div class="loc-wrap">
                    <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                    <input id="woSearch" class="loc-input"
                           placeholder="ค้นหา Work Order..."
                           autocomplete="off">
                    <div id="woDropdown" class="loc-dd"></div>
                </div>
            </div>
            <!-- Location -->
            <div style="flex:1;min-width:180px">
                <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                    <i class="bi bi-geo-alt-fill me-1" style="color:var(--blue)"></i>Location <span style="color:var(--red)">*</span>
                </div>
                <div class="loc-wrap">
                    <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                    <input id="locationSearch" class="loc-input"
                           placeholder="ค้นหา Location..."
                           autocomplete="off">
                    <input type="hidden" id="locationId">
                    <div id="locationDropdown" class="loc-dd"></div>
                </div>
            </div>
            <!-- Camera button -->
            <button id="cameraBtn" onclick="toggleScan()"
                    style="height:44px;padding:0 20px;background:var(--blue);color:#fff;
                           border:none;border-radius:10px;font-size:14px;font-weight:700;
                           cursor:pointer;font-family:inherit;transition:.2s;white-space:nowrap;
                           display:flex;align-items:center;gap:8px;flex-shrink:0">
                <i class="bi bi-camera" style="font-size:20px"></i>
            </button>
            <!-- HW Scanner button -->
            <button id="hwScanBtn" onclick="toggleHwScan()"
                    style="height:44px;padding:0 20px;background:#6b7280;color:#fff;
                           border:none;border-radius:10px;font-size:14px;font-weight:700;
                           cursor:pointer;font-family:inherit;transition:.2s;white-space:nowrap;
                           display:flex;align-items:center;gap:8px;flex-shrink:0"
                    title="Hardware Barcode Scanner">
                <i class="bi bi-upc-scan" style="font-size:20px"></i>
            </button>
        </div>
    </div>
</div>

<!-- Scanner (hidden until open) -->
<partial name="_BarcodeScannerSection" />

<!-- Items table (always visible) -->
<div class="rx-card" style="overflow:hidden">
    <div style="padding:12px 18px;border-bottom:1px solid var(--border);
                display:flex;align-items:center;justify-content:space-between;gap:10px">
        <span style="font-size:13px;font-weight:700;color:var(--navy);display:flex;align-items:center;gap:8px">
            <i class="bi bi-inbox me-1" style="color:var(--blue)"></i> Receiving Items
            <span id="itemCountBadge"
                  style="background:var(--blue-lt);color:var(--blue);
                         padding:2px 12px;border-radius:20px;font-size:12px;font-weight:700">
                0/10
            </span>
        </span>
        <div style="display:flex;align-items:center;gap:8px">
            <button onclick="openManualEntry()"
                    style="padding:5px 14px;border:1.5px solid var(--border);border-radius:7px;
                           background:#fff;color:var(--t2);font-size:12px;font-weight:600;
                           cursor:pointer;font-family:inherit;transition:.15s;white-space:nowrap"
                    onmouseover="this.style.borderColor='var(--blue)';this.style.color='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--t2)'">
                <i class="bi bi-pencil me-1"></i>Manual
            </button>
        </div>
    </div>
    <!-- HW Scanner Section (inline) -->
    <partial name="_HwScannerSection" />

    <div id="receivingTableWrap">
        <table class="rx-table">
            <thead>
                <tr>
                    <th>Part No</th>
                    <th>Description</th>
                    <th style="width:110px">Qty</th>
                    <th style="width:80px">Unit</th>
                    <th style="width:46px"></th>
                </tr>
            </thead>
            <tbody id="receivingTable"></tbody>
        </table>
        <div id="emptyState" style="text-align:center;padding:32px;color:var(--t3);font-size:13px">
            <i class="bi bi-inbox" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4"></i>
            ยังไม่มีรายการ — สแกน QR หรือกด Manual
        </div>
    </div>
</div>

<div id="scanResultSection">
    <!-- Advanced Options (collapsible) -->
    <partial name="_AdvancedOptions" />
    <button class="receive-btn" id="receiveBtn" onclick="receive()" disabled>
        Receive
    </button>
</div>

<!-- Manual Entry Modal -->
<div class="modal fade" id="manualModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.18)">
            <div class="modal-header" style="border-bottom:1px solid var(--border);padding:16px 20px">
                <h5 id="manualModalTitle" class="modal-title" style="font-size:15px;font-weight:700;color:var(--navy)">
                    <i class="bi bi-pencil-square me-2" style="color:var(--blue)"></i>Manual Entry
                </h5>
                <button type="button" data-bs-dismiss="modal"
                        style="background:none;border:none;cursor:pointer;color:var(--t3);font-size:20px;line-height:1;padding:0;margin-left:auto"
                        onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--t3)'">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body" style="padding:0;max-height:70vh;overflow-y:auto">
                <table style="width:100%;border-collapse:collapse;font-size:13px">
                    <thead>
                        <tr>
                            <th style="padding:10px 16px;background:#f8f9fc;color:var(--t2);font-weight:700;font-size:11px;letter-spacing:.04em;text-transform:uppercase;border-bottom:2px solid var(--border);width:110px">Field</th>
                            <th style="padding:10px 16px;background:#f8f9fc;color:var(--t2);font-weight:700;font-size:11px;letter-spacing:.04em;text-transform:uppercase;border-bottom:2px solid var(--border)">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">P/N <span style="color:var(--red)">*</span></td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)">
                                <input id="mePn" class="rx-input" placeholder="Part No." style="width:100%"
                                       oninput="searchManualPn()" autocomplete="off"
                                       onblur="setTimeout(hidePnDropdown, 200)">
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">QTY <span style="color:var(--red)">*</span></td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meQty" class="rx-input" inputmode="decimal" placeholder="QTY" value="1" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">UNIT <span style="color:var(--red)">*</span></td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meUnit" class="rx-input" placeholder="UNIT" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">Item Type</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)">
                                <select id="meItemType" class="rx-input" style="width:100%;cursor:pointer">
                                    <option value="">— Loading… —</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">Description</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meDesc" class="rx-input" placeholder="Description" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">VENDOR</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meVendor" class="rx-input" placeholder="VENDOR" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">D/C</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meDc" class="rx-input" placeholder="Date Code" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">T/C</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meTc" class="rx-input" placeholder="Trading Code" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">PO</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="mePo" class="rx-input" placeholder="PO" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">I/N</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meIn" class="rx-input" placeholder="I/N" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">TRACE ID</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meTrace" class="rx-input" placeholder="Trace ID" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">W/O</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)">
                                <input id="meWo" class="rx-input" placeholder="MO Number" style="width:100%" autocomplete="off">
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">LINE</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meLine" class="rx-input" placeholder="LINE" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;font-weight:600;color:var(--t2);font-size:12px">LOT NO</td>
                            <td style="padding:6px 16px">
                                <input id="meLotNo" class="rx-input" placeholder="auto-gen after add item" readonly
                                       style="width:100%;background:#f8f9fc;color:var(--t2);cursor:default">
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--border);padding:14px 20px;justify-content:space-between">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal"
                        style="font-size:13px;font-weight:600">Cancel</button>
                <button id="manualSubmitBtn" type="button" onclick="submitManualEntry()"
                        style="padding:8px 24px;border:none;border-radius:9px;background:var(--blue);
                               color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                    + Add Item
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius:14px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.18)">
            <div class="modal-body" style="padding:28px 20px 16px;text-align:center">
                <i class="bi bi-trash3" style="font-size:36px;color:var(--red);display:block;margin-bottom:12px"></i>
                <p style="font-size:14px;font-weight:700;color:var(--navy);margin:0 0 4px">ลบรายการนี้?</p>
                <p id="deletePartLabel" style="font-size:12px;color:var(--t2);margin:0;word-break:break-all"></p>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--border);padding:12px 20px;justify-content:space-between">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal"
                        style="font-size:13px;font-weight:600">ยกเลิก</button>
                <button type="button" onclick="confirmDelete()"
                        style="padding:8px 24px;border:none;border-radius:9px;background:var(--red);
                               color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                    ลบ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Autocomplete dropdowns (fixed-pos — avoids modal overflow:auto clipping) -->
<div id="pnDropdown"       class="loc-dd" style="position:fixed;z-index:9999;display:none;min-width:200px"></div>
<div id="woModalDropdown"  class="loc-dd" style="position:fixed;z-index:9999;display:none;min-width:200px"></div>

@section Scripts {
    <script src="/js/api.js"></script>
    <script src="/js/apiForm.js"></script>
    <script src="/js/barcodeScanner.js"></script>
    <script src="/js/hwScanner.js"></script>
    <script src="/js/scanPipeline.js"></script>
    <script src="/js/locationTypeMeta.js"></script>
    <script src="/js/locationAutocomplete.js"></script>
    <script src="/js/workOrderAutocomplete.js"></script>
    <script src="/js/photoCapture.js"></script>
    <script>
        const rxScanner = createBarcodeScanner({
            videoId: 'bcVideo', canvasId: 'bcCanvas', labelId: 'bcLabel',
            onDetect: raw => rxScan.submit(raw)
        });

        // ── Role: show Advanced Options for admin only ──
        (function() {
            const adminRoles = ['Admin', 'Inventory_Admin', 'Admin_WH', 'Supervisor'];
            try {
                const user = JSON.parse(localStorage.getItem('user') || '{}');
                if (adminRoles.includes(user.role))
                    document.getElementById('advAdvancedOptions').style.display = '';
            } catch (_) {}
        })();
        let scannedTrace = new Set();
        let currentWO = null, currentLine = null;
        let _rxReceiving = false;

        function rxSetScanStatus(t) {
            const bc = document.getElementById("bcStatus"); if (bc) bc.textContent = t;
            const hw = document.getElementById("hwStatus"); if (hw) hw.textContent = t;
        }

        // ── Scan pipeline (decode + cooldown + queue ใช้ร่วมกันทั้งกล้องและ HW scanner) ──
        const rxScan = createScanPipeline({
            mode: 'vendor',
            cooldownMs: 1500,
            onResult: async (scanData, rawCode) => {
                rxSetScanStatus("⏳ กำลังตรวจสอบ…");
                try {
                    const traceId = scanData.wH_TraceId || scanData.traceId || rawCode;
                    if (scannedTrace.has(traceId)) { toast("สแกนซ้ำ", "err"); return; }

                    const newWO = scanData.workOrderNo || scanData.workOrder || null;
                    if (newWO && currentWO && newWO !== currentWO) {
                        toast(`❌ W/O ไม่ตรง — กำลัง receive W/O: ${currentWO}`, "err"); return;
                    }
                    if (newWO) currentWO = newWO;

                    scannedTrace.add(traceId);
                    await addRow(scanData.partNo || "", scanData.quantity || 1, scanData.unit || "", traceId, {
                        vendor:      scanData.vendor      || "",
                        dateCode:    scanData.dateCode    || "",
                        tradingCode: scanData.tradingCode || "",
                        po:          scanData.po          || "",
                        inventoryNo: scanData.inventoryNo || "",
                        lotNo:       scanData.lotNo       || "",
                    });
                    if (navigator.vibrate) navigator.vibrate(120)
                    toast(scanData.message || "สแกนสำเร็จ ✓", "ok");
                } finally {
                    rxSetScanStatus("พร้อมสแกน…");
                }
            },
            onError: err => {
                toast(err.message || "Scan ล้มเหลว", "err");
                rxSetScanStatus("พร้อมสแกน…");
            }
        });

        function rxShowError(id, show) {
            const el = document.getElementById(id);
            if (!el) return;
            el.style.transition  = "border-color .15s, box-shadow .15s";
            el.style.borderColor = show ? "var(--red)" : "";
            el.style.boxShadow   = show ? "0 0 0 3px rgba(220,38,38,.15)" : "";
        }

        window.addEventListener("beforeunload", (e) => {
            stopScan();
            if (document.querySelectorAll("#receivingTable tr").length > 0) {
                e.preventDefault();
                e.returnValue = "";
            }
        });

        // ── Camera ─────────────────────────────────────
        function toggleScan() { if (rxScanner.running) stopScan(); else startScan(); }

        function setCameraBtn(running) {
            const btn = document.getElementById("cameraBtn");
            if (running) {
                btn.style.background = "#dc2626";
                btn.onmouseover = () => btn.style.background = "#b91c1c";
                btn.onmouseout  = () => btn.style.background = "#dc2626";
            } else {
                btn.style.background = "var(--blue)";
                btn.onmouseover = () => btn.style.background = "var(--blue-dk)";
                btn.onmouseout  = () => btn.style.background = "var(--blue)";
            }
        }

        async function startScan() {
