<style>
.rp-toggle-wrap { position:relative; display:inline-block; width:38px; height:22px; flex-shrink:0; }
.rp-toggle-wrap input { opacity:0; width:0; height:0; }
.rp-toggle-slider { position:absolute; inset:0; background:#e5e7eb; border-radius:22px; cursor:pointer; transition:.2s; }
.rp-toggle-slider:before { content:''; position:absolute; left:3px; bottom:3px; width:16px; height:16px; background:#fff; border-radius:50%; transition:.2s; box-shadow:0 1px 3px rgba(0,0,0,.2); }
.rp-toggle-wrap input:checked + .rp-toggle-slider { background:var(--blue); }
.rp-toggle-wrap input:checked + .rp-toggle-slider:before { transform:translateX(16px); }
.rp-opt-row { display:flex; align-items:center; justify-content:space-between; padding:10px 0; border-bottom:1px solid var(--border); }
.rp-opt-row:last-child { border-bottom:none; }
</style>

<!-- ══════ TAB: RECEIVE ══════ -->
<div class="tab-pane active" id="tab-receive">

        <!-- 1. W/O + Line + Layout card -->
        <div class="rp-card" style="overflow:visible">
            <div class="rp-card-head">
                Work Order &amp; Layout
            </div>
            <div id="rpWoCardBody" class="rp-card-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start">
                    <!-- W/O + Production Area -->
                    <div>
                        <label class="form-label" style="margin-bottom:5px">Work Order <span class="req">*</span></label>
                        <div class="wo-autocomplete">
                            <div style="position:relative">
                                <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:15px;pointer-events:none">🔍</span>
                                <input class="form-input" id="rpWoInput" placeholder="Search W/O..." autocomplete="off"
                                    style="padding-left:38px;padding-right:90px"
                                    oninput="rpWoInputHandler()" onkeydown="rpWoKeyDown(event)" onblur="setTimeout(()=>rpHideWoDropdown(),180)">
                                <div id="rpLineDisplay" style="display:none;position:absolute;right:10px;top:50%;transform:translateY(-50%);padding:2px 10px;background:var(--blue-lt);border:1.5px solid var(--blue);border-radius:20px;font-size:12px;font-weight:700;color:var(--blue);white-space:nowrap;pointer-events:none"></div>
                            </div>
                            <div class="wo-dropdown" id="rpWoDropdown" style="display:none"></div>
                        </div>
                        <div style="margin-top:10px">
                            <label class="form-label" style="margin-bottom:5px">Production Area</label>
                            <div style="position:relative">
                                <select class="form-select" id="rpProductionAreaInput"
                                    onchange="rpProductionArea = this.value"
                                    style="appearance:none;-webkit-appearance:none;padding-right:32px">
                                    <option value="FAN_01" selected>FAN_01</option>
                                    <option value="FAN_02">FAN_02</option>
                                </select>
                                <svg style="position:absolute;right:11px;top:50%;transform:translateY(-50%);pointer-events:none;color:var(--t2)" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </div>
                        </div>
                    </div>
                    <!-- Layout + Receive Location (right column) -->
                    <div style="display:flex;flex-direction:column;gap:10px">
                        <div>
                            <div style="font-size:12px;font-weight:600;color:var(--t2);margin-bottom:5px">Layout Template <span class="req">*</span></div>
                            <div style="display:flex;gap:6px;align-items:center">
                                <select class="form-select" id="rpLayout" onchange="rpLayoutChange()" style="flex:1;min-width:0">
                                    <option value="">-- Select Layout --</option>
                                </select>
                                <button class="btn-outline" style="padding:7px 10px;flex-shrink:0;display:flex;align-items:center;justify-content:center" onclick="goToDesignLayout(document.getElementById('rpLayout').value)" title="Design Layout"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                            </div>
                        </div>
                        <div>
                            <div style="font-size:12px;font-weight:600;color:var(--t2);margin-bottom:5px">Receive Location <span class="req">*</span></div>
                            <div style="position:relative">
                                <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--t3);pointer-events:none;z-index:1"></i>
                                <input id="rpLocSearch" class="form-input" placeholder="ค้นหา Location..." autocomplete="off"
                                    style="padding-left:32px"
                                    oninput="rpSearchLocation()"
                                    onkeydown="rpLocKeyDown(event)"
                                    onblur="setTimeout(rpHideLocDropdown, 180)">
                                <div class="wo-dropdown" id="rpLocDropdown" style="display:none;min-width:100%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3+4. Item list card (with inline manual input) -->
        <div class="rp-card" style="overflow:visible">
            <div class="rp-card-head">
                <span>Item List</span>
                <span class="rp-counter-badge" id="rpCounter">0/10</span>
                <button id="rpManualBtn" class="btn-secondary" onclick="rpOpenManualModal()"
                    style="font-size:11px;padding:4px 10px;margin-left:auto">⌨ Manual</button>
                <button class="btn-primary" id="rpBtnCam" onclick="rpToggleCam()"
                    style="font-size:12px;padding:5px 10px;border-radius:8px;display:flex;align-items:center">
                    <i class="bi bi-camera" style="font-size:16px"></i>
                </button>
                <button id="rpHwScanBtn" onclick="rpToggleHwScan()"
                    style="font-size:12px;padding:5px 10px;border-radius:8px;background:#6b7280;color:#fff;border:none;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center">
                    <i class="bi bi-upc-scan" style="font-size:16px"></i>
                </button>
            </div>
            <!-- HW Scanner Section — lives here by default; rpToggleHwScan moves it to the active tab's item card -->
            <div id="rpHwScanSection" style="display:none;padding:12px 14px;border-bottom:1px solid var(--border);background:#f0f8ff">
                <div style="position:relative">
                    <i class="bi bi-upc-scan" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--blue);font-size:16px;pointer-events:none"></i>
                    <input id="rpHwScanInput"
                           style="width:100%;padding:10px 12px 10px 38px;border:1.5px solid var(--blue);border-radius:9px;font-size:14px;font-family:inherit;color:var(--text);outline:none;box-sizing:border-box;background:#fff"
                           placeholder="พร้อมสแกน — สแกน barcode ได้เลย..."
                           autocomplete="off"
                           onkeydown="onRpHwScanKey(event)"
                           oninput="onRpHwScanInput()">
                </div>
                <div id="rpHwScanStatus" style="text-align:center;font-size:13px;color:var(--t2);margin-top:8px;min-height:18px">พร้อมสแกน…</div>
            </div>
            <div id="rpScanAnchor"></div>
            <div style="display:flex;align-items:center;gap:16px;padding:7px 14px;background:#f8f9fc;border-bottom:1px solid var(--border);font-size:11px;font-weight:700;color:var(--t2);letter-spacing:.04em;text-transform:uppercase">
                <div style="flex:1;min-width:0">Part No</div>
                <div style="flex:1;min-width:0;text-align:center">Lot No</div>
                <div style="flex:1;min-width:0;text-align:right">Qty</div>
                <div style="flex:1;min-width:0;text-align:right">Unit</div>
                <div style="width:160px"></div>
            </div>
            <div id="rpItemList">
                <div class="rp-empty-state">No items yet — scan or type to add</div>
            </div>
        </div>

        <!-- 4b. Advanced Options (admin only) -->
        <div class="rp-card" id="rpAdvancedOptions" style="margin-bottom:8px;display:none">
            <div style="padding:12px 18px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none" onclick="rpToggleOptions()">
                <span style="font-size:13px;font-weight:700;color:var(--navy)">
                    <i class="bi bi-sliders me-1" style="color:var(--t2)"></i> Advanced Options
                </span>
                <i class="bi bi-chevron-down" id="rpOptIcon" style="color:var(--t2);font-size:13px;transition:transform .2s"></i>
            </div>
            <div id="rpOptBody" style="display:none;padding:0 18px 4px;border-top:1px solid var(--border)">
                <div style="padding-top:4px">
                    <div class="rp-opt-row">
                        <div style="font-size:13px;color:var(--text)">Skip GPS Validation</div>
                        <label class="rp-toggle-wrap"><input type="checkbox" id="rpOptSkipGps"><span class="rp-toggle-slider"></span></label>
                    </div>
                    <div class="rp-opt-row">
                        <div style="font-size:13px;color:var(--text)">Skip Printed Validation</div>
                        <label class="rp-toggle-wrap"><input type="checkbox" id="rpOptSkipPrinted"><span class="rp-toggle-slider"></span></label>
                    </div>
                    <div class="rp-opt-row">
                        <div style="font-size:13px;color:var(--text)">Skip Work Order Validation</div>
                        <label class="rp-toggle-wrap"><input type="checkbox" id="rpOptSkipWO"><span class="rp-toggle-slider"></span></label>
                    </div>
                    <div class="rp-opt-row">
                        <div style="font-size:13px;color:var(--text)">Skip Location Validation</div>
                        <label class="rp-toggle-wrap"><input type="checkbox" id="rpOptSkipLoc"><span class="rp-toggle-slider"></span></label>
                    </div>
                    <div class="rp-opt-row">
                        <div style="font-size:13px;color:var(--text)">Skip Lot Duplicate Validation</div>
                        <label class="rp-toggle-wrap"><input type="checkbox" id="rpOptSkipDup"><span class="rp-toggle-slider"></span></label>
                    </div>
                    <div class="rp-opt-row">
                        <div style="font-size:13px;color:var(--text)">Skip Reserved Lot Validation</div>
                        <label class="rp-toggle-wrap"><input type="checkbox" id="rpOptSkipRes"><span class="rp-toggle-slider"></span></label>
                    </div>
                    <div class="rp-opt-row">
                        <div style="font-size:13px;color:var(--text)">Skip Manual Lot Validation</div>
                        <label class="rp-toggle-wrap"><input type="checkbox" id="rpOptSkipManual"><span class="rp-toggle-slider"></span></label>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Printer + Print (sticky) -->
        <div class="rp-sticky-bottom">
            <div class="rp-printer-row">
                <div class="rp-pd-wrap">
                    <div class="rp-pd-trigger" id="rpPrinterTrigger" tabindex="0"
                         onclick="rpPrinterDdToggle('rp')">
                        <div class="rp-pd-val">
                            <span class="rp-pd-dot" id="rpPrinterDot" style="display:none"></span>
                            <div>
                                <div class="rp-pd-sel-name" id="rpPrinterName" style="color:var(--t2);font-weight:400">-- Select Printer --</div>
                                <div class="rp-pd-sel-ip" id="rpPrinterIp" style="display:none"></div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-down rp-pd-chevron"></i>
                    </div>
                    <div class="rp-pd-menu" id="rpPrinterMenu" style="display:none">
                        <div class="rp-pd-msg">⏳ Loading…</div>
                    </div>
                    <input type="hidden" id="rpPrinterSelect">
                </div>
                <!-- PC only -->
                <button id="rpPrintBtn" class="rpr-btn-inline btn-primary" onclick="rpShowPrintModal()"
                    style="white-space:nowrap;padding:9px 20px;flex-shrink:0;opacity:0.45;cursor:not-allowed" disabled>
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
            <!-- Mobile only -->
            <div class="rpr-btn-mobile rp-btn-row">
                <button id="rpPrintBtnMobile" class="btn-primary" onclick="rpShowPrintModal()"
                    style="opacity:0.45;cursor:not-allowed" disabled>
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
        </div>

</div><!-- end #tab-receive -->

<script>
    let rpItems        = []
    let rpScannedTrace = new Set()
    let _rpPrinting        = false
    let _rpShowUnreviewed  = false

    ;(function() {
        const adminRoles = ['Admin', 'Inventory_Admin', 'Admin_WH', 'Supervisor']
        try {
            const user = JSON.parse(localStorage.getItem('user') || '{}')
            if (adminRoles.includes(user.role))
                document.getElementById('rpAdvancedOptions').style.display = ''
        } catch (_) {}
    })()

    function rpToggleOptions() {
        const body = document.getElementById('rpOptBody')
        const icon = document.getElementById('rpOptIcon')
        const open = body.style.display !== 'none'
        body.style.display   = open ? 'none' : ''
        icon.style.transform = open ? '' : 'rotate(180deg)'
    }

    function rpShowError(id, show) {
        const el = document.getElementById(id)
        if (!el) return
        el.style.transition  = 'border-color .15s, box-shadow .15s'
        el.style.borderColor = show ? 'var(--red)' : ''
        el.style.boxShadow   = show ? '0 0 0 3px rgba(220,38,38,.15)' : ''
    }
    let rpCurrentWo      = null
    let rpCurrentLine    = null
    let rpProductionArea = 'FAN_01'
    let rpLayoutConfig = null
    let _rpScanActive        = false
    let _rpFacingMode        = 'environment'
    let _rpStream            = null
    let _rpRafId             = null
    let _rpDetector          = null
    let _rpScannerOrigParent = null
    let _rpLastScanTime = 0
    const _RP_COOLDOWN = 1500
    let _rpFoundLot    = null

    let _rpWoTimer = null
    function rpWoInputHandler() {
        const q = document.getElementById('rpWoInput').value.trim()
        const dd = document.getElementById('rpWoDropdown')
        if (!q) {
            dd.style.display = 'none'
            rpCurrentWo   = null
            rpCurrentLine = null
            const ld = document.getElementById('rpLineDisplay')
            if (ld) { ld.textContent = ''; ld.style.display = 'none' }
            return
        }
        clearTimeout(_rpWoTimer)
        _rpWoTimer = setTimeout(() => rpFetchWo(q), 280)
    }

    async function rpWoKeyDown(e) {
        if (e.key !== 'Enter') return
        e.preventDefault()
        const q = document.getElementById('rpWoInput').value.trim()
        if (!q) return

        try {
            const res = await api(`/workorder?Page=1&PageSize=5&Search=${encodeURIComponent(q)}&SortBy=LastSyncedAt&SortDir=desc`, 'GET')
            const arr = res?.data?.data ?? []
            const exact = arr.find(x => (x.moNumber ?? '').toLowerCase() === q.toLowerCase())
            if (exact) { rpSelectWo(exact.moNumber, exact.lineName ?? ''); return }
        } catch {}

        rpCurrentWo   = q
        rpCurrentLine = null
        rpHideWoDropdown()
        const ld = document.getElementById('rpLineDisplay')
        if (ld) { ld.textContent = ''; ld.style.display = 'none' }
        rpShowError('rpWoInput', false)
    }

    async function rpFetchWo(q) {
        const dd = document.getElementById('rpWoDropdown')
        dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">⏳ Searching…</div>'
        dd.style.display = ''
        try {
            const res = await api(`/workorder?Page=1&PageSize=20&Search=${encodeURIComponent(q)}&SortBy=LastSyncedAt&SortDir=desc`, 'GET')
            const arr = res?.data?.data ?? []
            if (arr.length === 0) {
                dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">No Work Order found</div>'
                return
            }
            dd.innerHTML = arr.map(x =>
                `<div class="wo-item" onmousedown="rpSelectWo('${escHtml(x.moNumber)}','${escHtml(x.lineName ?? '')}')">
                    <span style="font-weight:700">${escHtml(x.moNumber)}</span>
                    <span class="wo-item-line">${escHtml(x.lineName ?? '—')} · ${escHtml(x.modelName ?? '')}</span>
                </div>`
            ).join('')
        } catch (err) {
            console.error('[rpFetchWo]', err)
            dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default">❌ ${escHtml(err.message || 'Load failed')}</div>`
        }
    }

    function rpCheckScanReady() {
        // Scan and manual entry are always available; WO/Location are only required at print time
    }

    function rpSelectWo(mo, line) {
        document.getElementById('rpWoInput').value = mo
        rpCurrentWo   = mo
        rpCurrentLine = line
        const ld = document.getElementById('rpLineDisplay')
        ld.textContent = line || ''
        ld.style.display = line ? '' : 'none'
        rpShowError('rpWoInput', false)
        rpHideWoDropdown()
        rpCheckScanReady()
    }

    function rpHideWoDropdown() {
        document.getElementById('rpWoDropdown').style.display = 'none'
    }

    async function rpLoadLayouts() {
        const sel = document.getElementById('rpLayout')
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const arr = Array.isArray(layouts) ? layouts : (layouts?.data || [])
            sel.innerHTML = '<option value="">-- Select Layout --</option>' +
                arr.map(l => `<option value="${l.id}" data-cfg='${escHtml(l.zplData ?? "")}'>${escHtml(l.templateName ?? 'Untitled')}</option>`).join('')
            sel._layoutsData = arr
        } catch (_) {
            sel.innerHTML = '<option value="">-- (Unable to load Layouts) --</option>'
        }
    }

    function rpLayoutChange() {
        const sel = document.getElementById('rpLayout')
        const id  = sel.value
        rpShowError('rpLayout', false)
        if (!id) { rpLayoutConfig = null; rpCheckScanReady(); return }
        const arr  = sel._layoutsData || []
        const tmpl = arr.find(l => String(l.id) === String(id))
        if (!tmpl) { rpLayoutConfig = null; rpCheckScanReady(); return }
        rpLayoutConfig = parseZplDataJson(tmpl)
        rpRebuildAllZpl()
        rpCheckScanReady()
    }

    let _rpViewIdx = null

    function rpViewItemData(idx) {
        const item = rpItems[idx]
        if (!item) return
        item.reviewed = true
        _rpViewIdx = idx
        rpRenderList()
        rpRenderViewModal(idx)
        document.getElementById('rpManualModal').style.display = 'flex'
    }

    function rpRenderViewModal(idx) {
        const item = rpItems[idx]
        if (!item) return
        const d   = item.data
        const cfg = rpLayoutConfig ?? {}
        const qrFields  = Array.isArray(cfg.qrFields)    ? cfg.qrFields    : []
        const lblFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : []

        const colHdr = document.getElementById('rpManualColHeaders')
        if (colHdr) colHdr.style.display = 'none'

        const colHeadersHtml = `<div style="position:sticky;top:0;z-index:5;background:#f8f9fc;border-bottom:2px solid var(--border);display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px 16px;align-items:center;padding:10px 16px;flex-shrink:0">
            <div style="font-size:12px;font-weight:800;color:var(--blue);text-align:center;letter-spacing:.5px">QR</div>
            <div style="font-size:12px;font-weight:800;color:var(--purple,#7c3aed);text-align:center;letter-spacing:.5px">Label</div>
            <div style="font-size:12px;font-weight:800;color:var(--navy);letter-spacing:.5px">Field</div>
            <div style="font-size:12px;font-weight:800;color:var(--navy);letter-spacing:.5px">Value</div>
        </div>`

        const fieldRowsHtml = ALL_FIELD_KEYS.map(k => {
            const inQr   = qrFields.find(f  => f.key === k)?.inQr  ?? false
            const inLbl  = lblFields.find(f => f.key === k)?.show  ?? false
            const isAuto = AUTO_GEN_KEYS.has(k)
            const prefill = d[k] ?? (k === 'workOrder' ? (rpCurrentWo ?? '') : k === 'line' ? (rpCurrentLine ?? '') : k === 'productionArea' ? (rpProductionArea ?? '') : '')
            const isReq  = REQUIRED_KEYS.has(k)
            const isReadonly = k === 'workOrder' || k === 'productionArea' || k === 'line'

            const inputEl = isAuto
                ? `<div style="padding:7px 10px;background:#f0f2f5;border:1.5px solid var(--border);border-radius:8px;font-size:12px;color:var(--t2);font-style:italic">${escHtml(prefill || 'Auto-Gen after receive')}</div>`
                : k === 'partNo'
                ? `<div style="position:relative">
                       <input id="rpm_partNo" class="form-input" value="${escHtml(prefill)}"
                           style="font-size:13px;padding:7px 10px;width:100%"
                           oninput="this.style.borderColor='';rpPnAutocomplete(this.value)"
                           onblur="setTimeout(rpHidePnDropdown, 180)"
                           placeholder="${escHtml(FIELD_PLACEHOLDERS['partNo'] ?? FIELD_LABELS['partNo'])}">
                       <div id="rpPnDropdown" class="wo-dropdown" style="display:none"></div>
                   </div>`
                : k === 'quantity'
                ? `<input id="rpm_quantity" class="form-input" inputmode="decimal"
                       value="${escHtml(prefill || '1')}"
                       style="font-size:13px;padding:7px 10px"
                       oninput="this.style.borderColor=''"
                       placeholder="${escHtml(FIELD_PLACEHOLDERS['quantity'] ?? FIELD_LABELS['quantity'])}">`
                : `<input id="rpm_${cid(k)}" class="form-input" value="${escHtml(prefill)}"
                       ${isReadonly ? 'readonly' : ''}
                       style="font-size:13px;padding:7px 10px${isReadonly ? ';background:#f8f9fc' : ''}"
                       oninput="this.style.borderColor=''"
                       placeholder="${escHtml(FIELD_PLACEHOLDERS[k] ?? FIELD_LABELS[k])}">`

            return `<div style="display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px 16px;align-items:center;padding:6px 16px;border-bottom:1px solid var(--border)">
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inQr ? 'var(--blue)' : 'var(--border)'};background:${inQr ? 'var(--blue)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inQr ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inLbl ? 'var(--purple,#7c3aed)' : 'var(--border)'};background:${inLbl ? 'var(--purple,#7c3aed)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inLbl ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="font-size:13px;font-weight:600;color:var(--navy)">
                    ${escHtml(FIELD_LABELS[k])}${isReq ? ' <span style="color:var(--red)">*</span>' : ''}
                </div>
                ${inputEl}
            </div>`
        }).join('')

        document.getElementById('rpManualFields').innerHTML = `
            <div style="position:sticky;top:0;z-index:10;background:#fff;border-bottom:2px solid var(--border);display:flex;flex-shrink:0">
                <button id="rpViewTabPreview" onclick="rpSwitchViewTab('preview')"
                    style="padding:10px 18px;font-size:13px;font-weight:700;color:var(--blue);border:none;background:none;cursor:pointer;border-bottom:2px solid var(--blue);margin-bottom:-2px;font-family:inherit;display:flex;align-items:center;gap:6px">
                    <i class="bi bi-printer"></i> Preview Label
                </button>
