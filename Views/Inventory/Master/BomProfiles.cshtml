                </div>
            </div>
            <div id="beWoFields" style="display:none">
                <div style="display:flex;gap:8px;align-items:center">
                    <input id="beWoInput" class="modal-input" placeholder="Work Order No. (e.g. 36225034115)"
                        style="margin-bottom:0;font-family:ui-monospace,monospace;font-size:13px;font-weight:600;letter-spacing:.03em"
                        onkeydown="if(event.key==='Enter') beFetchWorkOrder()">
                    <button onclick="beFetchWorkOrder()" class="btn-create" id="beWoFetchBtn"
                        style="padding:8px 18px;font-size:12px;white-space:nowrap;flex-shrink:0">Fetch</button>
                </div>
                <div id="beWoPreview" style="display:none;margin-top:10px;background:#fff;border:1.5px solid var(--border);border-radius:10px;padding:12px 14px">
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        <span style="font-size:11px;font-weight:700;color:var(--green)">Work Order Loaded</span>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">MO Number</div><div id="beWoMo" style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">—</div></div>
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Model</div><div id="beWoModel" style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--blue)">—</div></div>
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Target Qty</div><div id="beWoQty" style="font-size:12px;font-weight:700;color:var(--navy)">—</div></div>
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Line</div><div id="beWoLine" style="font-size:12px;font-weight:600;color:var(--text)">—</div></div>
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Items</div><div id="beWoItems" style="font-size:12px;font-weight:700;color:var(--text)">—</div></div>
                    </div>
                </div>
            </div>
        </div>
        <div style="padding:16px 24px 0">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                <span style="font-size:12px;font-weight:700;color:var(--navy)">Components</span>
                <span id="beCompCount" style="font-size:11px;background:var(--blue-lt);color:var(--blue);padding:2px 8px;border-radius:20px;font-weight:700">0</span>
            </div>
            <div id="beCompList" style="border:1px solid var(--border);border-radius:10px;max-height:220px;overflow-y:auto;margin-bottom:12px;background:var(--card)">
                <div style="padding:20px;text-align:center;color:var(--t3);font-size:13px">No components yet</div>
            </div>
            <div style="background:var(--blue-lt);border:1.5px dashed var(--blue);border-radius:10px;padding:12px 14px">
                <div style="font-size:10px;font-weight:700;color:var(--blue);margin-bottom:8px;text-transform:uppercase;letter-spacing:.05em">+ Add Component</div>
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                    <div style="flex:1;min-width:180px;position:relative">
                        <input id="beSearchInput" class="modal-input" placeholder="Search part no. or name…"
                            style="margin-bottom:0;padding:8px 12px;font-size:13px"
                            oninput="beSearchItem(this.value)" autocomplete="off">
                        <div id="beSearchDd"
                            style="display:none;position:absolute;top:calc(100% + 3px);left:0;right:0;z-index:400;
                                   background:#fff;border:1.5px solid var(--blue);border-radius:9px;
                                   box-shadow:0 8px 24px rgba(0,0,0,.12);max-height:170px;overflow-y:auto"></div>
                        <input type="hidden" id="beItemId">
                    </div>
                    <input id="beAddQty" class="modal-input" type="number" min="0.001" step="any" placeholder="Qty"
                        style="width:90px;margin-bottom:0;padding:8px 10px;font-size:13px;font-weight:700;text-align:right">
                    <button onclick="beAddComp()" class="btn-create" style="padding:8px 18px;font-size:12px;white-space:nowrap">Add</button>
                </div>
            </div>
        </div>
        <div style="padding:16px 24px;display:flex;gap:10px;justify-content:flex-end;border-top:1px solid var(--border);margin-top:16px">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('bomEditModal')">ยกเลิก</button>
            <button class="modal-btn modal-btn-primary" onclick="beSave()" style="display:flex;align-items:center;gap:6px">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Save Changes
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/apiForm.js"></script>
<script src="js/master-shared.js"></script>
<script src="js/itemTypeMeta.js"></script>
<script>
    let _selectedBomId      = null   // id ของ root ที่กำลังโฟกัสอยู่ (ใช้กับปุ่ม Edit/Delete บน hero)
    let _selectedRootPartNo = null
    let _bomProfilesCache   = []
    let _byPartNo           = new Map()
    let _bomRoots           = []
    let _expanded           = new Set()   // path ที่ถูก expand ไว้ ("Root/0:Child/1:Grandchild")

    async function loadBoms() {
        try {
            const res = await api('/master/bom-profiles')
            _bomProfilesCache = Array.isArray(res) ? res : (res?.data || [])
            _byPartNo = new Map(_bomProfilesCache.map(p => [p.outputPartNo, p]))
            // Root = outputPartNo ที่ไม่เคยถูกอ้างถึงเป็น component ของ profile อื่นเลย
            const referenced = new Set()
            _bomProfilesCache.forEach(p => (p.components || []).forEach(c => referenced.add(c.component)))
            _bomRoots = _bomProfilesCache.filter(p => !referenced.has(p.outputPartNo))
            renderRootList()
            if (_selectedRootPartNo && _bomRoots.some(r => r.outputPartNo === _selectedRootPartNo)) {
                renderHierarchyDetail()
            } else if (_selectedRootPartNo) {
                _selectedRootPartNo = null; _selectedBomId = null
                showEmptyDetail()
            }
        } catch (err) {
            document.getElementById('rootList').innerHTML =
                `<div style="text-align:center;color:var(--red);padding:32px 16px;font-size:13px">Load failed: ${err.message}</div>`
        }
    }

    function showEmptyDetail() {
        document.getElementById('bomDetailEmpty').style.display   = 'flex'
        document.getElementById('bomDetailContent').style.display = 'none'
    }

    // เช็คว่า partNo เอง หรือ part ลูกหลานที่ระเบิด BOM ลงไป (ทุกชั้น) มีตัวไหนตรงกับคำค้นบ้าง
    function subtreeMatches(partNo, q, seen) {
        seen = seen || new Set()
        if (seen.has(partNo)) return false
        seen = new Set(seen); seen.add(partNo)
        if ((partNo ?? '').toLowerCase().includes(q)) return true
        const bom = _byPartNo.get(partNo)
        if (!bom || !Array.isArray(bom.components)) return false
        return bom.components.some(c => subtreeMatches(c.component, q, seen))
    }

    // หา path ของ node ที่ match คำค้น (เพื่อเอาไป auto-expand ให้เห็นเลยว่าซ่อนอยู่ชั้นไหน)
    function findMatchPath(partNo, q, parentPath, seen) {
        seen = seen || new Set()
        if (seen.has(partNo)) return null
        seen = new Set(seen); seen.add(partNo)
        const bom = _byPartNo.get(partNo)
        if (!bom || !Array.isArray(bom.components)) return null
        for (let i = 0; i < bom.components.length; i++) {
            const c    = bom.components[i]
            const path = parentPath + '/' + i + ':' + c.component
            if ((c.component ?? '').toLowerCase().includes(q)) return [path]
            const sub = findMatchPath(c.component, q, path, seen)
            if (sub) return [path, ...sub]
        }
        return null
    }

    function renderRootList() {
        const q = (document.getElementById('bomSearch')?.value || '').trim().toLowerCase()
        const roots = q ? _bomRoots.filter(r => subtreeMatches(r.outputPartNo, q)) : _bomRoots
        document.getElementById('bomCount').textContent = _bomRoots.length + ' roots'
        document.getElementById('rootList').innerHTML = roots.length === 0
            ? `<div style="text-align:center;color:var(--t3);padding:32px 16px;font-size:13px">ไม่พบ Root Assembly หรือ Part ที่ตรงกับคำค้น</div>`
            : roots.map(r => {
                const hasRecipe   = Array.isArray(r.components) && r.components.length > 0
                const typeKey     = hasRecipe ? 'subassembly' : 'material'
                const rootItself  = (r.outputPartNo ?? '').toLowerCase().includes(q)
                const childMatch  = q && !rootItself
                return `<div class="root-row${_selectedRootPartNo === r.outputPartNo ? ' active' : ''}" onclick="selectRoot('${escJs(r.outputPartNo)}')">
                    <div class="root-icon" style="${itemTypeBadgeStyle(typeKey)}">
                        ${itemTypeIcon(typeKey, 15)}
                    </div>
                    <div class="root-main">
                        <div class="root-part">${locEsc(r.outputPartNo || '—')}</div>
                        <div class="root-meta">
                            <span>v${r.version ?? '—'}</span>
                            <span>·</span>
                            <span>${hasRecipe ? r.components.length + ' ส่วนประกอบ' : 'ไม่มีสูตร'}</span>
                            ${childMatch ? `<span style="color:var(--blue);font-weight:700">· พบใน sub-tree</span>` : ''}
                        </div>
                    </div>
                    <div class="root-qty">${(r.outputQuantity ?? 0).toLocaleString()}</div>
                </div>`
            }).join('')
        // ถ้ากำลังเปิด root อยู่ ให้ auto-expand ไปยัง node ที่ match ทันทีขณะพิมพ์ค้นหา
        if (_selectedRootPartNo) {
            if (q) {
                const matchPath = findMatchPath(_selectedRootPartNo, q, _selectedRootPartNo)
                if (matchPath) matchPath.forEach(p => _expanded.add(p))
            }
            renderHierarchyDetail()
        }
    }

    function selectRoot(partNo) {
        const bom = _byPartNo.get(partNo)
        if (!bom) return
        _selectedRootPartNo = partNo
        _selectedBomId      = bom.id
        _expanded           = new Set([partNo])   // เปิดชั้นแรกให้อัตโนมัติ
        renderRootList()   // จะ auto-expand ไปยัง node ที่ match คำค้น (ถ้ามี) แล้ว render hierarchy ให้เอง
    }

    function maxDepth(partNo, seen) {
        seen = seen || new Set()
        if (seen.has(partNo)) return 0   // กัน circular reference
        seen = new Set(seen); seen.add(partNo)
        const p = _byPartNo.get(partNo)
        if (!p || !Array.isArray(p.components) || !p.components.length) return 0
        return 1 + Math.max(0, ...p.components.map(c => maxDepth(c.component, seen)))
    }

    function toggleNode(path) {
        if (_expanded.has(path)) _expanded.delete(path)
        else _expanded.add(path)
        renderHierarchyDetail()
    }

    function fmtRatio(c) {
        if (c.ratio == null) return '—'
        const r = c.ratio
        return r % 1 === 0 ? String(r) : r.toFixed(4).replace(/\.?0+$/, '')
    }

    // วาด children ของ node หนึ่งชั้น (เรียกซ้ำตาม path ที่ expand ไว้)
    function renderChildren(components, parentPath, q) {
        if (!Array.isArray(components) || !components.length) return ''
        return `<div class="tnode-children">` + components.map((c, i) => {
            const path        = parentPath + '/' + i + ':' + c.component
            const childProfile = _byPartNo.get(c.component)
            const isAssembly   = !!childProfile && Array.isArray(childProfile.components) && childProfile.components.length > 0
            const hasProfile   = !!childProfile
            const isOpen       = _expanded.has(path)
            const typeKey      = isAssembly ? 'subassembly' : 'material'
            const typeLabel    = isAssembly ? 'SubAssembly' : 'Material'
            const isMatch      = !!q && (c.component ?? '').toLowerCase().includes(q)
            return `
                <div class="tnode">
                    <div class="trow" style="${isMatch ? 'background:var(--blue-lt);box-shadow:inset 0 0 0 1.5px var(--blue)' : ''}">
                        ${isAssembly
                            ? `<div class="trow-toggle${isOpen ? ' open' : ''}" onclick="toggleNode('${escJs(path)}')">
                                 <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 18 15 12 9 6"/></svg>
                               </div>`
                            : `<div class="trow-spacer"></div>`}
                        <div class="trow-icon" style="${itemTypeBadgeStyle(typeKey)}">${itemTypeIcon(typeKey, 13)}</div>
                        <span class="trow-part">${locEsc(c.component ?? '—')}</span>
                        <span class="trow-badge" style="${itemTypeBadgeStyle(typeKey)}">${typeLabel}</span>
                        <div class="trow-qty">
                            <b>${(c.quantity ?? 0).toLocaleString()}</b>
                            <span>ratio ${fmtRatio(c)}</span>
                        </div>
                        ${hasProfile ? `
                        <div class="trow-actions">
                            <button class="btn-edit" onclick="event.stopPropagation();beOpen(_byPartNo.get('${escJs(c.component)}'))" title="Edit"
                                style="width:26px;height:26px;padding:0;display:flex;align-items:center;justify-content:center">
                                <i class="bi bi-pencil-square" style="font-size:11px"></i>
                            </button>
                            <button class="btn-edit" onclick="event.stopPropagation();bomDelete(_byPartNo.get('${escJs(c.component)}').id)" title="Delete"
                                style="width:26px;height:26px;padding:0;display:flex;align-items:center;justify-content:center;color:var(--red);border-color:var(--red);background:#fef2f2">
                                <i class="bi bi-trash3" style="font-size:11px"></i>
                            </button>
                        </div>` : ''}
                    </div>
                    ${isAssembly && isOpen ? renderChildren(childProfile.components, path, q) : ''}
                </div>`
        }).join('') + `</div>`
    }

    function renderHierarchyDetail() {
        const bom = _byPartNo.get(_selectedRootPartNo)
        if (!bom) { showEmptyDetail(); return }
        const q = (document.getElementById('bomSearch')?.value || '').trim().toLowerCase()
        document.getElementById('bomDetailEmpty').style.display   = 'none'
        document.getElementById('bomDetailContent').style.display = 'block'
        const comps = Array.isArray(bom.components) ? bom.components : []
        document.getElementById('bomDetailPartNo').textContent    = bom.outputPartNo ?? '—'
        document.getElementById('bomDetailQty').textContent       = (bom.outputQuantity ?? 0).toLocaleString()
        document.getElementById('bomDetailVersion').textContent   = bom.version ?? '—'
        document.getElementById('bomDetailCompCount').textContent = comps.length
        document.getElementById('bomDetailDepth').textContent     = maxDepth(bom.outputPartNo)
        document.getElementById('treeRoot').innerHTML = comps.length === 0
            ? `<div style="text-align:center;color:var(--t3);padding:24px;font-size:13px">ยังไม่มี component — กด ✎ Edit เพื่อเพิ่ม</div>`
            : renderChildren(comps, bom.outputPartNo, q)
    }

    // _bnComponents = รายการ item part ทั้งหมดของ Work Order ที่ fetch มา (ใช้เป็น picker ใน tab By WorkOrder เท่านั้น)
    // _bnManualComponents = list "Components" จริงที่จะส่งสร้าง BOM — ใช้ร่วมกันทั้ง 2 tab (ติ๊กจาก WO หรือค้นหาเพิ่มเองจาก Manual ก็ลงที่นี่หมด)
    let _bomEditingId = null, _bnMode = 'manual', _bnComponents = []
    let _bnManualComponents = [], _bnSearchTimer = null

    function bnRenderComps() {
        const list = document.getElementById('bnCompList')
        document.getElementById('bnCompCount').textContent = _bnManualComponents.length
        if (!_bnManualComponents.length) {
            list.innerHTML = `<div style="padding:16px;text-align:center;color:var(--t3);font-size:13px">No components yet</div>`
            return
        }
        list.innerHTML = _bnManualComponents.map((c, i) => `
            <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:${i < _bnManualComponents.length - 1 ? '1px solid var(--border)' : 'none'}">
                <span style="font-size:11px;color:var(--t3);width:18px;flex-shrink:0;text-align:right">${i + 1}</span>
                <span style="flex:1;font-family:ui-monospace,monospace;font-size:13px;font-weight:600;color:var(--navy);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                      title="${locEsc(c.partNo)}">${locEsc(c.partNo)}</span>
                <input type="number" min="0.001" step="any" value="${c.quantity}"
                    oninput="_bnManualComponents[${i}].quantity = parseFloat(this.value)||0"
                    style="width:78px;padding:5px 8px;border:1.5px solid var(--border);border-radius:7px;font-size:13px;font-weight:700;text-align:right;font-family:inherit;outline:none;color:var(--blue);background:#fff"
                    onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor='var(--border)'">
                <button type="button" onclick="bnRemoveComp(${i})"
                    style="width:26px;height:26px;flex-shrink:0;border:1.5px solid #fca5a5;border-radius:6px;background:#fef2f2;color:var(--red);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
                </button>
            </div>`).join('')
    }

    function bnRemoveComp(idx) { _bnManualComponents.splice(idx, 1); bnRenderComps() }

    function bnSearchItem(q) {
        const dd = document.getElementById('bnSearchDd')
        clearTimeout(_bnSearchTimer)
        document.getElementById('bnItemId').value = ''
        if (!q.trim()) { dd.style.display = 'none'; return }
        dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">Searching…</div>`
        dd.style.display = 'block'
        // ค้นหาด้วยตัวพิมพ์ใหญ่เสมอ (Part No. ในระบบเก็บเป็นตัวพิมพ์ใหญ่) — ไม่กระทบข้อความที่ผู้ใช้พิมพ์ในช่อง #bnSearchInput
        const searchQ = q.trim().toUpperCase()
        _bnSearchTimer = setTimeout(async () => {
            try {
                const res   = await api(`/master/items?PartNo=${encodeURIComponent(searchQ)}&page=1&pageSize=15`)
                const items = Array.isArray(res) ? res : (res?.data || [])
                dd.innerHTML = items.length === 0
                    ? `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">No items found</div>`
                    : items.map(it => `
                        <div onclick="bnPickItem(${it.id},'${escJs(it.partNo ?? '')}','${escJs(it.itemName ?? '')}')"
                            style="padding:9px 14px;font-size:13px;cursor:pointer;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px"
                            onmouseover="this.style.background='var(--blue-lt)'" onmouseout="this.style.background=''">
                            <span style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">${locEsc(it.partNo ?? '')}</span>
                            <span style="color:var(--t2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${locEsc(it.itemName ?? '')}</span>
                        </div>`).join('')
            } catch { dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--red)">Load failed</div>` }
        }, 280)
    }

    function bnPickItem(id, partNo, desc) {
        document.getElementById('bnSearchInput').value      = `${partNo}${desc ? ' — ' + desc : ''}`
        document.getElementById('bnItemId').value           = id
        document.getElementById('bnSearchDd').style.display = 'none'
        document.getElementById('bnAddQty').focus()
    }

    function bnAddComp() {
        const itemId = parseInt(document.getElementById('bnItemId').value)
        const qty    = parseFloat(document.getElementById('bnAddQty').value)
        const label  = document.getElementById('bnSearchInput').value.trim()
        if (!itemId) { showToast('กรุณาเลือก item จาก dropdown', 'error'); return }
        if (!qty || qty <= 0) { showToast('กรุณากรอก Quantity', 'error'); return }
        if (_bnManualComponents.find(c => c.componentItemId === itemId)) { showToast('Item นี้มีอยู่แล้วใน BOM', 'error'); return }
        _bnManualComponents.push({ componentItemId: itemId, partNo: label.split(' — ')[0].trim(), quantity: qty })
        bnRenderComps()
        document.getElementById('bnSearchInput').value      = ''
        document.getElementById('bnItemId').value           = ''
        document.getElementById('bnAddQty').value           = ''
        document.getElementById('bnSearchDd').style.display = 'none'
        document.getElementById('bnSearchInput').focus()
    }

    function bnSetMode(mode) {
        _bnMode = mode
        document.getElementById('bnBtn_manual').classList.toggle('active',    mode === 'manual')
        document.getElementById('bnBtn_workorder').classList.toggle('active', mode === 'workorder')
        document.getElementById('bnManualFields').style.display = mode === 'manual'    ? '' : 'none'
        document.getElementById('bnWoFields').style.display     = mode === 'workorder' ? '' : 'none'
    }

    async function bnFetchWorkOrder() {
        const wo  = document.getElementById('bnWoInput').value.trim()
        if (!wo) { showToast('กรุณากรอก Work Order No.', 'error'); return }
        const btn = document.getElementById('bnWoFetchBtn')
        btn.disabled = true; btn.textContent = '⏳ Loading…'
        try {
            const res = await api(`/workorder/${encodeURIComponent(wo)}/detail`)
            document.getElementById('bnWoMo').textContent    = res.moNumber  ?? '—'
            document.getElementById('bnWoModel').textContent = res.modelName ?? '—'
            document.getElementById('bnWoQty').textContent   = res.targetQty ?? '—'
            document.getElementById('bnWoLine').textContent  = res.lineName  ?? '—'
            // prefill Output Qty จาก Target Qty ของ WO ให้เลย (แก้ไขได้)
            document.getElementById('bnWoOutputQty').value   = res.targetQty ?? ''
            _bnComponents = (res.items || [])
                .filter(it => (it.planQty ?? 0) > 0)
                .map(it => ({ componentItemId: it.itemId, partNo: it.partNo ?? String(it.itemId), quantity: it.planQty, selected: true }))
            document.getElementById('bnWoItems').textContent = _bnComponents.length + ' items'
            document.getElementById('bnWoPreview').style.display = ''
            bnWoSelectAll(true)   // default: เลือกทุกตัว + ใส่เข้า Components list ให้เลย (เหมือน tab Manual)
            showToast(`โหลด Work Order สำเร็จ — ${_bnComponents.length} items`, 'success')
        } catch (err) {
            showToast('ไม่พบ Work Order: ' + err.message, 'error')
            document.getElementById('bnWoPreview').style.display = 'none'
        } finally { btn.disabled = false; btn.textContent = 'Fetch' }
    }

    function bnRenderWoComps() {
        const list = document.getElementById('bnWoCompList')
        const selCount = _bnComponents.filter(c => c.selected).length
        document.getElementById('bnWoSelCount').textContent = `(${selCount}/${_bnComponents.length} เลือกแล้ว)`
        list.innerHTML = !_bnComponents.length
            ? `<div style="padding:16px;text-align:center;color:var(--t3);font-size:13px">No items</div>`
            : _bnComponents.map((c, i) => `
                <label style="display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:${i < _bnComponents.length - 1 ? '1px solid var(--border)' : 'none'};cursor:pointer">
                    <input type="checkbox" ${c.selected ? 'checked' : ''} onchange="bnToggleWoComp(${i})" style="width:15px;height:15px;flex-shrink:0;cursor:pointer">
                    <span style="flex:1;font-family:ui-monospace,monospace;font-size:12.5px;font-weight:600;color:${c.selected ? 'var(--navy)' : 'var(--t3)'};min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${locEsc(c.partNo)}</span>
                    <span style="font-size:12px;font-weight:700;color:${c.selected ? 'var(--blue)' : 'var(--t3)'}">${c.quantity}</span>
                </label>`).join('')
    }

    // ติ๊ก/เลิกติ๊ก item part จาก Work Order = เพิ่ม/เอาออกจาก _bnManualComponents (list เดียวกับที่ tab Manual ใช้) เลย
    // กันซ้ำด้วย componentItemId — เผื่อ user เพิ่ม item เดียวกันเองผ่านช่องค้นหาไปแล้วก่อนหน้านี้
    function _bnSyncWoCompToShared(c) {
        const i = _bnManualComponents.findIndex(x => x.componentItemId === c.componentItemId)
        if (c.selected) {
            if (i === -1) _bnManualComponents.push({ componentItemId: c.componentItemId, partNo: c.partNo, quantity: c.quantity })
        } else if (i > -1) {
            _bnManualComponents.splice(i, 1)
        }
    }

    function bnToggleWoComp(idx) {
        const c = _bnComponents[idx]
        c.selected = !c.selected
        _bnSyncWoCompToShared(c)
        bnRenderWoComps()
        bnRenderComps()
    }

    function bnWoSelectAll(val) {
        _bnComponents.forEach(c => { c.selected = val; _bnSyncWoCompToShared(c) })
        bnRenderWoComps()
        bnRenderComps()
    }

    // ── Output Part No autocomplete (ค้นจาก GET /master/items — ถ้าพิมพ์แล้วไม่มี Part No นี้จริง เสนอปุ่มสร้างใหม่) ──
    let _bnOutputPartTimer = null, _bnOutputPartResults = []
    // input/dropdown ที่ autocomplete กำลังทำงานด้วยอยู่ตอนนี้ — ใช้ฟังก์ชันชุดเดียวกันได้ทั้ง #bomPartNo (tab Manual)
    // และ #bnWoOutputPartNo (tab By WorkOrder) โดยสลับ target ตาม field ที่ผู้ใช้พิมพ์ล่าสุด
    let _bnOutputPartInputId = 'bomPartNo', _bnOutputPartDdId = 'bnOutputPartDd'

    function bnSearchOutputPart(q, inputId, ddId) {
        if (inputId) _bnOutputPartInputId = inputId
        if (ddId)    _bnOutputPartDdId    = ddId
        q = (q || '').trim()
        const dd = document.getElementById(_bnOutputPartDdId)
        clearTimeout(_bnOutputPartTimer)
        _bnOutputPartResults = []
        if (!q) { dd.style.display = 'none'; return }
        dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">Searching…</div>`
        dd.style.display = 'block'
        // ค้นหาด้วยตัวพิมพ์ใหญ่เสมอ (Part No. ในระบบเก็บเป็นตัวพิมพ์ใหญ่) — ไม่กระทบข้อความที่ผู้ใช้พิมพ์ในช่อง
        const searchQ = q.toUpperCase()
        _bnOutputPartTimer = setTimeout(async () => {
            try {
                const res   = await api(`/master/items?PartNo=${encodeURIComponent(searchQ)}&page=1&pageSize=10`)
                const items = Array.isArray(res) ? res : (res?.data || [])
                _bnOutputPartResults = items
                const exact = items.some(it => (it.partNo ?? '').toUpperCase() === searchQ)
                let html = items.map(it => `
                    <div onclick="bnPickOutputPart('${escJs(it.partNo ?? '')}')"
                        style="padding:9px 14px;font-size:13px;cursor:pointer;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px"
                        onmouseover="this.style.background='var(--blue-lt)'" onmouseout="this.style.background=''">
                        <span style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">${locEsc(it.partNo ?? '')}</span>
                        <span style="color:var(--t2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${locEsc(it.itemName ?? '')}</span>
                    </div>`).join('')
                if (!exact) {
                    html += `<div onclick="bnOpenQuickCreateItem('${escJs(searchQ)}')"
                        style="padding:10px 14px;font-size:12.5px;font-weight:700;color:var(--green);cursor:pointer;background:var(--green-lt);display:flex;align-items:center;gap:8px;${items.length ? 'border-top:1.5px dashed var(--border)' : ''}">
                        <i class="bi bi-plus-circle"></i> สร้าง Part No ใหม่: "${locEsc(searchQ)}"
                    </div>`
                }
                dd.innerHTML = html
            } catch {
                dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--red)">Load failed</div>`
            }
        }, 280)
    }

    function bnPickOutputPart(partNo) {
        document.getElementById(_bnOutputPartInputId).value = partNo
        document.getElementById(_bnOutputPartDdId).style.display = 'none'
    }

    // Enter ในช่อง Output Part No = เลือกตัวแรกใน list ทันที ถ้าไม่มี item ตรงเลยและมีแต่ปุ่ม "สร้างใหม่" ก็เปิด quick-create แทน
    function bnOutputPartEnter() {
        const dd = document.getElementById(_bnOutputPartDdId)
        if (dd.style.display === 'none') return
        if (_bnOutputPartResults.length) {
            bnPickOutputPart(_bnOutputPartResults[0].partNo)
        } else {
            const q = document.getElementById(_bnOutputPartInputId).value.trim().toUpperCase()
            if (q) bnOpenQuickCreateItem(q)
        }
    }

    // ── Quick Create Item (จากในนี้เลย ถ้า Output Part No ที่พิมพ์ยังไม่มีในระบบ) ──
    let _bnQiTypesLoaded = false

    async function bnQiLoadItemTypes() {
        if (_bnQiTypesLoaded) return
        try {
            const data = await api('/master/items/item-type')
            const arr  = Array.isArray(data) ? data : (data?.data || [])
            document.getElementById('bnQiItemType').innerHTML =
                '<option value="">เลือกประเภท</option>' + arr.map(t => `<option value="${locEsc(t.name || t)}">${locEsc(t.name || t)}</option>`).join('')
            _bnQiTypesLoaded = true
        } catch (err) { console.error('bnQiLoadItemTypes:', err) }
    }

    async function bnOpenQuickCreateItem(partNo) {
        document.getElementById(_bnOutputPartDdId).style.display = 'none'
        document.getElementById('bnQiPartNo').value        = partNo
        document.getElementById('bnQiName').value          = ''
        document.getElementById('bnQiUnit').value          = 'PCE'
        document.getElementById('bnQiWeight').value        = ''
        document.getElementById('bnQiWeightUnit').value    = ''
        document.getElementById('bnQiDescription').value   = ''
        document.getElementById('bnQiImageFile').value     = ''
        document.getElementById('bnQiImgPreview').src      = 'images/no-image.png'
        clearModalError('bnQiError')
        await bnQiLoadItemTypes()
        // มาจาก Output Part No ของ BOM → เดา default เป็น "Sub Assembly" ไว้ก่อน (เทียบแบบ normalize กันสะกด/เว้นวรรคไม่ตรงกันเป๊ะ)
        const sel = document.getElementById('bnQiItemType')
        const norm = s => (s || '').toLowerCase().replace(/[\s_-]/g, '')
        const subAssemblyOpt = [...sel.options].find(o => norm(o.value) === 'subassembly')
        sel.value = subAssemblyOpt ? subAssemblyOpt.value : ''
        openModal('bnQuickItemModal')
    }

    function bnQiPreviewImage(input) {
        const file = input.files[0]
        if (!file) return
        const reader = new FileReader()
        reader.onload = e => { document.getElementById('bnQiImgPreview').src = e.target.result }
        reader.readAsDataURL(file)
    }

    async function bnQiSave() {
        // Part No. ส่งเป็นตัวพิมพ์ใหญ่เสมอ (เช่นพิมพ์ "Frame_22" → parse เป็น "FRAME_22" ก่อนส่ง payload)
        const partNo   = document.getElementById('bnQiPartNo').value.trim().toUpperCase()
        const itemName = document.getElementById('bnQiName').value.trim()
        if (!partNo)   { showModalError('bnQiError', 'กรุณากรอก Part No.'); return }
        if (!itemName) { showModalError('bnQiError', 'กรุณากรอก Name'); return }

        const body = { partNo, itemName }
        const baseUnit    = document.getElementById('bnQiUnit').value.trim()
        const description = document.getElementById('bnQiDescription').value.trim()
        const itemType    = document.getElementById('bnQiItemType').value.trim()
        const weightVal   = document.getElementById('bnQiWeight').value.trim()
        const weightUnit  = document.getElementById('bnQiWeightUnit').value.trim()
        if (baseUnit)    body.baseUnit    = baseUnit
        if (description) body.description = description
        if (itemType)    body.itemType    = itemType
        if (weightVal)   body.weight      = parseFloat(weightVal)
        if (weightUnit)  body.weightUnit  = weightUnit

        const imageFile = document.getElementById('bnQiImageFile').files[0]
        try {
            await apiForm('/master/items', body, imageFile ? [imageFile] : [], 10000, 'POST', 'file')
            closeModal('bnQuickItemModal')
            document.getElementById(_bnOutputPartInputId).value = partNo
            document.getElementById(_bnOutputPartDdId).style.display = 'none'
            showToast('สร้าง Item ใหม่สำเร็จ: ' + partNo)
        } catch (err) { showModalError('bnQiError', 'สร้างไม่สำเร็จ: ' + err.message) }
    }

    function bomOpenNew() {
        _bomEditingId = null; _bnComponents = []; _bnManualComponents = []
        document.getElementById('bomPartNo').value  = ''
        document.getElementById('bomPartNo').disabled = false
        document.getElementById('bnOutputPartDd').style.display = 'none'
        document.getElementById('bomQty').value     = ''
        document.getElementById('bnWoInput').value  = ''
        document.getElementById('bnWoOutputPartNo').value = ''
        document.getElementById('bnWoOutputQty').value    = ''
        document.getElementById('bnWoOutputPartDd').style.display = 'none'
        document.getElementById('bnWoPreview').style.display = 'none'
        _bnOutputPartInputId = 'bomPartNo'; _bnOutputPartDdId = 'bnOutputPartDd'
        document.getElementById('bnSearchInput').value      = ''
        document.getElementById('bnItemId').value           = ''
        document.getElementById('bnAddQty').value           = ''
        document.getElementById('bnSearchDd').style.display = 'none'
        document.getElementById('bomError').classList.remove('show')
        bnRenderComps()
        bnSetMode('manual')
        openModal('bomModal')
    }

    async function saveBom() {
        const isWo = _bnMode === 'workorder'
        // Components ใช้ _bnManualComponents ตัวเดียวกันเสมอไม่ว่าจะ tab ไหน — ติ๊กจาก By WorkOrder หรือค้นหาเพิ่มเองจาก Manual
        // ก็ลงท้ายมาที่ array นี้ทั้งคู่ (ดู bnToggleWoComp/bnWoSelectAll/bnAddComp)
        let outputPartNo, outputQuantity
        const components = _bnManualComponents.map(c => ({ componentItemId: c.componentItemId, quantity: c.quantity }))
        if (isWo) {
            if (document.getElementById('bnWoPreview').style.display === 'none') {
                showToast('กรุณา Fetch Work Order ก่อน', 'error'); return
            }
            outputPartNo   = document.getElementById('bnWoOutputPartNo').value.trim().toUpperCase()
            outputQuantity = parseFloat(document.getElementById('bnWoOutputQty').value) || 0
            if (!outputPartNo) { showToast('กรุณากรอก Output Part No.', 'error'); return }
            if (!(outputQuantity > 0)) { showToast('กรุณากรอก Output Qty', 'error'); return }
        } else {
            outputPartNo   = document.getElementById('bomPartNo').value.trim()
            outputQuantity = parseFloat(document.getElementById('bomQty').value) || 0
            if (!outputPartNo) { showToast('กรุณากรอก Output Part No.', 'error'); return }
        }
        if (!components.length) { showToast('กรุณาเพิ่ม Component อย่างน้อย 1 รายการ', 'error'); return }
        try {
            await api('/master/bom-profiles', 'POST', { outputPartNo, outputQuantity, components })
            showToast('สร้าง BOM Profile สำเร็จ')
            closeModal('bomModal')
            _bomProfilesCache = []
            loadBoms()
        } catch (err) { showToast('บันทึกไม่สำเร็จ: ' + err.message, 'error') }
    }

    function bomEditHeader() {
        const bom = _bomProfilesCache.find(x => x.id === _selectedBomId)
        if (!bom) { showToast('ไม่พบข้อมูล BOM', 'error'); return }
        beOpen(bom)
    }

    // ── BOM Edit Modal ──
    let _beComponents = [], _beBomId = null, _beSearchTimer = null, _beMode = 'manual'

    function beSetMode(mode) {
        _beMode = mode
        document.getElementById('beBtn_manual').classList.toggle('active',    mode === 'manual')
        document.getElementById('beBtn_workorder').classList.toggle('active', mode === 'workorder')
        document.getElementById('beManualFields').style.display = mode === 'manual'    ? 'flex' : 'none'
        document.getElementById('beWoFields').style.display     = mode === 'workorder' ? ''     : 'none'
    }

    async function beFetchWorkOrder() {
        const wo  = document.getElementById('beWoInput').value.trim()
        if (!wo) { showToast('กรุณากรอก Work Order No.', 'error'); return }
        const btn = document.getElementById('beWoFetchBtn')
        btn.disabled = true; btn.textContent = '⏳ Loading…'
        try {
            const res = await api(`/workorder/${encodeURIComponent(wo)}/detail`)
            document.getElementById('beWoMo').textContent    = res.moNumber    ?? '—'
            document.getElementById('beWoModel').textContent = res.modelName   ?? '—'
            document.getElementById('beWoQty').textContent   = res.targetQty   ?? '—'
            document.getElementById('beWoLine').textContent  = res.lineName    ?? '—'
            document.getElementById('beWoItems').textContent = (res.items?.length ?? 0) + ' items'
            document.getElementById('beWoPreview').style.display = ''
            _beComponents = (res.items || [])
                .filter(it => (it.planQty ?? 0) > 0)
                .map(it => ({ componentItemId: it.itemId, partNo: it.partNo ?? String(it.itemId), quantity: it.planQty }))
            beRenderComps()
            showToast(`โหลด Work Order สำเร็จ — ${_beComponents.length} items`, 'success')
        } catch (err) {
            showToast('ไม่พบ Work Order: ' + err.message, 'error')
            document.getElementById('beWoPreview').style.display = 'none'
        } finally { btn.disabled = false; btn.textContent = 'Fetch' }
    }

    async function beOpen(bom) {
        _beBomId      = bom.id
        _beComponents = []
        document.getElementById('bePartNoChip').textContent  = bom.outputPartNo ?? '—'
        document.getElementById('beQty').value               = bom.outputQuantity ?? ''
        document.getElementById('beSearchInput').value       = ''
        document.getElementById('beItemId').value            = ''
        document.getElementById('beAddQty').value            = ''
        document.getElementById('beSearchDd').style.display  = 'none'
        document.getElementById('beWoInput').value           = ''
        document.getElementById('beWoPreview').style.display = 'none'
        beSetMode('manual')
        document.getElementById('beCompCount').textContent = '…'
        document.getElementById('beCompList').innerHTML =
            `<div style="padding:24px;text-align:center;color:var(--t3);font-size:13px">กำลังโหลด…</div>`
        openModal('bomEditModal')
        try {
            // GET /master/bom-profiles (list) ไม่คืน componentItemId มาด้วย — ต้องดึงทีละตัวผ่าน /{id} ถึงจะได้ id จริง
            const detail = await api(`/master/bom-profiles/${bom.id}`)
            document.getElementById('bePartNoChip').textContent = detail.outputPartNo   ?? bom.outputPartNo   ?? '—'
            document.getElementById('beQty').value              = detail.outputQuantity ?? bom.outputQuantity ?? ''
            _beComponents = (detail.components || []).map(c => ({
                componentItemId: c.componentItemId ?? null,
                partNo:          c.partNo ?? c.component ?? String(c.componentItemId ?? ''),
                quantity:        c.quantity ?? 0
            }))
        } catch (err) {
            showToast('โหลดรายละเอียด BOM ไม่สำเร็จ: ' + err.message, 'error')
        }
        beRenderComps()
    }

    function beRenderComps() {
        const list = document.getElementById('beCompList')
        document.getElementById('beCompCount').textContent = _beComponents.length
        if (!_beComponents.length) {
            list.innerHTML = `<div style="padding:24px;text-align:center;color:var(--t3);font-size:13px">No components — add one below</div>`
            return
        }
        list.innerHTML = _beComponents.map((c, i) => `
            <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:${i < _beComponents.length-1 ? '1px solid var(--border)' : 'none'}">
                <span style="font-size:11px;color:var(--t3);width:18px;flex-shrink:0;text-align:right">${i+1}</span>
                <span style="flex:1;font-family:ui-monospace,monospace;font-size:13px;font-weight:600;color:var(--navy);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                      title="${locEsc(c.partNo)}">${locEsc(c.partNo)}</span>
                <input type="number" min="0.001" step="any" value="${c.quantity}"
                    oninput="_beComponents[${i}].quantity = parseFloat(this.value)||0"
                    style="width:78px;padding:5px 8px;border:1.5px solid var(--border);border-radius:7px;font-size:13px;font-weight:700;text-align:right;font-family:inherit;outline:none;color:var(--blue);background:#fff"
                    onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor='var(--border)'">
                <button onclick="beRemoveComp(${i})"
                    style="width:26px;height:26px;flex-shrink:0;border:1.5px solid #fca5a5;border-radius:6px;background:#fef2f2;color:var(--red);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
                </button>
            </div>`).join('')
    }

    function beRemoveComp(idx) { _beComponents.splice(idx, 1); beRenderComps() }

    function beSearchItem(q) {
        const dd = document.getElementById('beSearchDd')
        clearTimeout(_beSearchTimer)
        document.getElementById('beItemId').value = ''
        if (!q.trim()) { dd.style.display = 'none'; return }
        dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">Searching…</div>`
        dd.style.display = 'block'
        _beSearchTimer = setTimeout(async () => {
            try {
                const res   = await api(`/master/items?PartNo=${encodeURIComponent(q)}&page=1&pageSize=15`)
                const items = Array.isArray(res) ? res : (res?.data || [])
                dd.innerHTML = items.length === 0
                    ? `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">No items found</div>`
                    : items.map(it => `
                        <div onclick="bePickItem(${it.id},'${escJs(it.partNo??'')}','${escJs(it.itemName??'')}')"
                            style="padding:9px 14px;font-size:13px;cursor:pointer;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px"
                            onmouseover="this.style.background='var(--blue-lt)'" onmouseout="this.style.background=''">
                            <span style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">${locEsc(it.partNo??'')}</span>
                            <span style="color:var(--t2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${locEsc(it.itemName??'')}</span>
                        </div>`).join('')
            } catch { dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--red)">Load failed</div>` }
        }, 280)
    }

    function bePickItem(id, partNo, desc) {
        document.getElementById('beSearchInput').value      = `${partNo}${desc ? ' — ' + desc : ''}`
        document.getElementById('beItemId').value           = id
        document.getElementById('beSearchDd').style.display = 'none'
        document.getElementById('beAddQty').focus()
    }

    function beAddComp() {
        const itemId = parseInt(document.getElementById('beItemId').value)
        const qty    = parseFloat(document.getElementById('beAddQty').value)
        const label  = document.getElementById('beSearchInput').value.trim()
        if (!itemId) { showToast('กรุณาเลือก item จาก dropdown', 'error'); return }
        if (!qty || qty <= 0) { showToast('กรุณากรอก Quantity', 'error'); return }
        if (_beComponents.find(c => c.componentItemId === itemId)) { showToast('Item นี้มีอยู่แล้วใน BOM', 'error'); return }
        _beComponents.push({ componentItemId: itemId, partNo: label.split(' — ')[0].trim(), quantity: qty })
        beRenderComps()
        document.getElementById('beSearchInput').value      = ''
        document.getElementById('beItemId').value           = ''
        document.getElementById('beAddQty').value           = ''
        document.getElementById('beSearchDd').style.display = 'none'
        document.getElementById('beSearchInput').focus()
    }

    async function beSave() {
        const isWo = _beMode === 'workorder'
        if (isWo && document.getElementById('beWoPreview').style.display === 'none') {
            showToast('กรุณา Fetch Work Order ก่อน', 'error'); return
        }
        if (!isWo) {
            const unresolved = _beComponents.filter(c => !c.componentItemId)
            if (unresolved.length) {
                showToast('ไม่พบ Item ID ของ: ' + unresolved.map(c => c.partNo).join(', ') + ' — ลองปิดแล้วเปิด Edit ใหม่อีกครั้ง', 'error')
                return
            }
        }
        const outputPartNo   = isWo ? document.getElementById('beWoModel').textContent : document.getElementById('bePartNoChip').textContent
        const outputQuantity = isWo ? parseFloat(document.getElementById('beWoQty').textContent) || 0 : parseFloat(document.getElementById('beQty').value) || 0
        const payload = {
            outputPartNo, outputQuantity,
            components: _beComponents.map(c => ({ componentItemId: c.componentItemId, quantity: c.quantity }))
        }
        console.log('[beSave] PUT /master/bom-profiles/' + _beBomId, 'payload:', payload)
        try {
            const res = await api(`/master/bom-profiles/${_beBomId}`, 'PUT', payload)
            console.log('[beSave] response:', res)
            showToast('อัปเดต BOM Profile สำเร็จ')
            closeModal('bomEditModal')
            await loadBoms()
        } catch (err) {
            console.log('[beSave] error:', err)
            showToast('บันทึกไม่สำเร็จ: ' + err.message, 'error')
        }
    }

    let _bomPendingDeleteId = null

    function bomDelete(id) {
        const bom = _byPartNo.get(_selectedRootPartNo)?.id === id
            ? _byPartNo.get(_selectedRootPartNo)
            : _bomProfilesCache.find(x => x.id === id)
        _bomPendingDeleteId = id
        document.getElementById('bomDeleteTarget').textContent = bom?.outputPartNo ?? ('#' + id)
        clearModalError('bomDeleteError')
        openModal('bomDeleteModal')
    }

    async function bomConfirmDelete() {
        const id = _bomPendingDeleteId
        if (!id) return
        try {
            await api(`/master/bom-profiles/${id}`, 'DELETE')
            closeModal('bomDeleteModal')
            if (_selectedBomId === id) {
                _selectedBomId = null
                document.getElementById('bomDetailEmpty').style.display   = 'flex'
                document.getElementById('bomDetailContent').style.display = 'none'
            }
            await loadBoms()
            showToast('ลบ BOM Profile สำเร็จ')
        } catch (err) { showModalError('bomDeleteError', 'ลบไม่สำเร็จ: ' + err.message) }
    }

    loadBoms()
</script>
}
