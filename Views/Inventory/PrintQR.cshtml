                    style="width:16px;height:16px;flex-shrink:0">
                <input type="text" id="dflabel_${cid(k)}" value="${escHtml(label)}"
                    style="flex:1;border:none;outline:none;font-size:13px;font-weight:600;background:transparent;padding:0;margin:0;line-height:1;color:var(--text);min-width:0;display:block;box-sizing:content-box"
                    oninput="dsPreviewDebounce()">
                <span style="font-size:12px;color:var(--blue);font-weight:600;font-family:monospace;white-space:nowrap">{${k}}</span>
            </div>`
        }).join('')
