@{
    ViewData["Title"] = "Move Materials";
}
<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --green:#059669; --green-lt:#ecfdf5;
    --red:#dc2626; --red-lt:#fef2f2; --amber:#d97706; --amber-lt:#fffbeb;
}

.page-header {
    background:linear-gradient(135deg,var(--navy) 0%,#1e3a6e 60%,#1a6fff 100%);
    border-radius:16px; padding:20px 28px; margin-bottom:20px;
    position:relative; overflow:hidden;
}
.page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04); }
.page-header h2 { font-size:22px; font-weight:700; color:#fff; margin-bottom:4px; }

.rp-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.rp-card-head {
    padding:12px 18px; border-bottom:1px solid var(--border);
    font-size:13px; font-weight:700; color:var(--navy);
    display:flex; align-items:center; gap:8px;
}
.rp-card-body { padding:18px 20px; }

/* Location */
.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:10px 12px 10px 38px;
    border:1.5px solid var(--border); border-radius:10px;
    font-size:14px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item { padding:10px 14px; font-size:13px; cursor:pointer; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; transition:.12s; }
.loc-item:last-child  { border-bottom:none; }
.loc-item:hover       { background:var(--blue-lt); }
.loc-item:first-child { border-radius:8px 8px 0 0; }
.loc-item:last-child  { border-radius:0 0 8px 8px; }

/* Icon buttons */
.icon-btn {
    width:34px; height:34px; border-radius:9px; border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:16px;
    transition:.15s; flex-shrink:0;
}
.icon-btn:disabled { opacity:.35; cursor:not-allowed; }

/* Counter badge */
.count-badge {
    font-size:11px; font-weight:700; padding:2px 9px;
    border-radius:20px; background:var(--blue-lt); color:var(--blue);
}

/* HW scan section */
.hw-scan-section {
    display:none; padding:12px 16px;
    border-bottom:1px solid var(--border); background:#f0f8ff;
}

/* Scanner */
.scanner-box {
    width:100%; height:50vh; max-height:520px; border:3px solid var(--blue);
    border-radius:16px; position:relative; overflow:hidden; background:#000;
}
.scanner-box video  { position:absolute;inset:0;width:100%;height:100%;object-fit:cover; }
.scanner-box canvas { position:absolute;inset:0;width:100%;height:100%;pointer-events:none; }
.mv-cam-label {
    position:absolute; bottom:0; left:0; right:0;
    background:rgba(0,0,0,.65); color:#fff;
    font-size:12px; font-weight:600; padding:6px 10px;
    text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}

/* Table */
.rx-table { width:100%; border-collapse:collapse; font-size:13px; }
.rx-table th {
    background:#f8f9fc; color:var(--t2); font-weight:700; font-size:11px;
    letter-spacing:.04em; text-transform:uppercase;
    padding:10px 16px; border-bottom:2px solid var(--border); text-align:left;
}
.rx-table td { padding:9px 16px; border-bottom:1px solid var(--border); vertical-align:middle; }
.rx-table tr:last-child td { border-bottom:none; }
.rx-table tbody tr:hover td { background:#fafbff; }
.rx-table tbody tr.row-err td { background:var(--red-lt); }
.rx-table tbody tr.row-ok  td { background:var(--green-lt); opacity:.6; transition:opacity .4s; }
.del-btn { width:30px; height:30px; border:none; border-radius:7px; background:#fef2f2; color:var(--red); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.del-btn:hover { background:var(--red); color:#fff; }
.empty-state { padding:36px; text-align:center; color:var(--t3); font-size:13px; }

/* Options toggles */
.opt-row { display:flex; align-items:center; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f4f4f7; }
.opt-row:last-child { border-bottom:none; }
.toggle-wrap { position:relative; display:inline-block; width:38px; height:22px; flex-shrink:0; }
.toggle-wrap input { opacity:0; width:0; height:0; }
.toggle-slider { position:absolute; inset:0; background:#e5e7eb; border-radius:22px; cursor:pointer; transition:.2s; }
.toggle-slider:before { content:''; position:absolute; left:3px; bottom:3px; width:16px; height:16px; background:#fff; border-radius:50%; transition:.2s; box-shadow:0 1px 3px rgba(0,0,0,.2); }
.toggle-wrap input:checked + .toggle-slider { background:var(--blue); }
.toggle-wrap input:checked + .toggle-slider:before { transform:translateX(16px); }

/* Move button */
.move-btn {
    width:100%; padding:14px; border:none; border-radius:12px;
    font-size:15px; font-weight:700; font-family:inherit; cursor:pointer;
    transition:.2s; background:var(--blue); color:#fff; margin-top:4px;
}
.move-btn:disabled { background:#e5e7eb; color:#9ca3af; cursor:not-allowed; }
.move-btn:not(:disabled):hover { background:var(--blue-dk); }

/* Toast */
.toast-wrap { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.toast-item { padding:11px 20px; border-radius:10px; font-size:13px; font-weight:600; color:#fff; box-shadow:0 4px 16px rgba(0,0,0,.18); animation:tIn .25s ease; min-width:160px; }
.toast-ok   { background:var(--green); }
.toast-err  { background:var(--red); }
.toast-warn { background:var(--amber); }
@@keyframes tIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:none} }
</style>

<div class="toast-wrap" id="toastWrap"></div>

<!-- ── Header ── -->
<div class="page-header">
    <h2 style="display:flex;align-items:center;gap:10px;margin:0">
        Move Materials
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="opacity:.85">
            <line x1="2" y1="9" x2="22" y2="9"/><polyline points="18 5 22 9 18 13"/>
            <line x1="22" y1="15" x2="2" y2="15"/><polyline points="6 11 2 15 6 19"/>
        </svg>
    </h2>
</div>

<!-- ── 1. Destination Location ── -->
<div class="rp-card">
    <div class="rp-card-head">
        <i class="bi bi-geo-alt-fill" style="color:var(--blue)"></i>
        Destination Location <span style="color:var(--red)">*</span>
    </div>
    <div class="rp-card-body">
        <div class="loc-wrap">
            <i class="bi bi-search loc-icon" style="font-size:14px"></i>
            <input id="locationSearch" class="loc-input"
                   placeholder="ค้นหา Destination Location…"
                   autocomplete="off"
                   oninput="searchLocation()"
                   onblur="setTimeout(hideLocDd,200)">
            <input type="hidden" id="locationCode">
            <div id="locationDropdown" class="loc-dd"></div>
        </div>
        <div style="margin-top:12px">
            <div style="font-size:12px;font-weight:600;color:var(--t2);margin-bottom:5px">Remark <span style="font-weight:400;color:var(--t3)">(optional)</span></div>
            <input id="mvRemark" style="width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:9px;font-size:13px;font-family:inherit;outline:none;box-sizing:border-box;transition:border-color .15s" placeholder="หมายเหตุ…" onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor='var(--border)'">
        </div>
    </div>
</div>

<!-- ── 2. Item List ── -->
<div class="rp-card" style="overflow:hidden">
    <div class="rp-card-head">
        <i class="bi bi-box-arrow-right" style="color:var(--blue)"></i>
        <span>Move List</span>
        <span class="count-badge" id="mvCountBadge">0 รายการ</span>
        <div style="margin-left:auto;display:flex;gap:6px">
            <!-- Camera -->
            <button id="mvCamBtn" class="icon-btn" title="Camera scan"
                    style="background:var(--blue);color:#fff"
                    onclick="mvToggleCam()">
                <i class="bi bi-camera-fill"></i>
            </button>
            <!-- HW Scanner -->
            <button id="mvHwBtn" class="icon-btn" title="HW scanner"
                    style="background:#6b7280;color:#fff"
                    onclick="mvToggleHwScan()">
                <i class="bi bi-upc-scan"></i>
            </button>
        </div>
    </div>

    <!-- HW scan input section -->
    <div id="mvHwSection" class="hw-scan-section">
        <div style="position:relative">
            <i class="bi bi-upc-scan" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--blue);font-size:16px;pointer-events:none"></i>
            <input id="mvHwInput"
                   style="width:100%;padding:10px 12px 10px 40px;border:1.5px solid var(--blue);border-radius:9px;font-size:14px;font-family:inherit;color:var(--text);outline:none;box-sizing:border-box;background:#fff"
                   placeholder="พร้อมสแกน — สแกน barcode ได้เลย…"
                   autocomplete="off"
                   onkeydown="onMvHwKey(event)">
        </div>
        <div id="mvHwStatus" style="text-align:center;font-size:13px;color:var(--t2);margin-top:8px;min-height:18px">พร้อมสแกน…</div>
    </div>

    <!-- Table -->
    <div style="overflow-x:auto">
        <table class="rx-table">
            <thead>
                <tr>
                    <th>Part No</th>
                    <th>Lot No</th>
                    <th>Description</th>
                    <th>From</th>
                    <th>Type</th>
                    <th style="text-align:right">On Hand</th>
                    <th style="width:46px"></th>
                </tr>
            </thead>
            <tbody id="moveTable">
                <tr id="mvEmptyRow">
                    <td colspan="7" class="empty-state">
                        <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                        No items yet — scan or use HW scanner to add
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- ── Camera section (appears after Item List) ── -->
<div id="mvCamSection" style="display:none" class="rp-card">
    <div class="rp-card-body" style="padding:16px">
        <div class="scanner-box">
            <video id="mvVideo" autoplay playsinline muted></video>
            <canvas id="mvCanvas"></canvas>
            <div class="mv-cam-label" id="mvCamLabel">— กำลังค้นหา barcode —</div>
        </div>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:14px">
            <button onclick="switchCamera()"
                    style="padding:9px 20px;border:1.5px solid var(--border);border-radius:9px;background:#fff;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s"
                    onmouseover="this.style.borderColor='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)'">
                <i class="bi bi-arrow-repeat me-1"></i>สลับกล้อง
            </button>
            <button onclick="mvToggleCam()"
                    style="padding:9px 20px;border:none;border-radius:9px;background:#fee2e2;color:var(--red);font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                ⏹ ปิดกล้อง
            </button>
        </div>
        <div id="mvCamStatus" style="text-align:center;font-size:13px;color:var(--t2);margin-top:10px;min-height:18px">กำลังสแกน…</div>
    </div>
</div>

<!-- ── 3. Advanced Options (collapsible) ── -->
<div class="rp-card">
    <div class="rp-card-head" style="cursor:pointer" onclick="toggleOptions()">
        <i class="bi bi-sliders" style="color:var(--t2)"></i>
        <span style="font-weight:700">Advanced Options</span>
        <i class="bi bi-chevron-down" id="optArrow" style="margin-left:auto;color:var(--t2);transition:transform .2s"></i>
    </div>
    <div id="optBody" class="rp-card-body" style="display:none;padding-top:10px">
        <div class="opt-row">
            <div><div style="font-size:13px;color:var(--text)">Skip GPS Validation</div><div style="font-size:11px;color:var(--t3);margin-top:1px">ไม่ตรวจสอบพิกัด GPS</div></div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipGps" checked><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div><div style="font-size:13px;color:var(--text)">Skip Printed Validation</div><div style="font-size:11px;color:var(--t3);margin-top:1px">ไม่ตรวจสอบสถานะการพิมพ์</div></div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipPrinted" checked><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div><div style="font-size:13px;color:var(--text)">Skip Work Order Validation</div><div style="font-size:11px;color:var(--t3);margin-top:1px">ไม่ตรวจสอบ Work Order</div></div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipWo" checked><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div><div style="font-size:13px;color:var(--text)">Skip Location Validation</div><div style="font-size:11px;color:var(--t3);margin-top:1px">ไม่ตรวจสอบ Location ปลายทาง</div></div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipLoc" checked><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div><div style="font-size:13px;color:var(--text)">Skip Lot Duplicate Validation</div><div style="font-size:11px;color:var(--t3);margin-top:1px">อนุญาตให้ Lot ซ้ำใน Location เดิม</div></div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipDup" checked><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div><div style="font-size:13px;color:var(--text)">Skip Reserved Lot Validation</div><div style="font-size:11px;color:var(--t3);margin-top:1px">อนุญาต Lot ที่ถูก Reserve</div></div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipReserved" checked><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div><div style="font-size:13px;color:var(--text)">Skip Manual Lot Validation</div><div style="font-size:11px;color:var(--t3);margin-top:1px">อนุญาต Lot ที่สร้างด้วยมือ</div></div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipManual" checked><span class="toggle-slider"></span></label>
        </div>
    </div>
</div>

<!-- ── Move button ── -->
<button class="move-btn" id="moveBtn" onclick="submitMove()" disabled>Move</button>

@section Scripts {
<script src="/js/api.js"></script>
<script src="/lib/html5-qrcode/html5-qrcode.min.js"></script>
<script>
    // ── State ─────────────────────────────────────────
    let mvStream = null, mvRafId = null, mvDetector = null;
    let camRunning = false, facingMode = 'environment';
    let scannedLots = new Set();
    let lastScanTime = 0;
    let _processing = false;

    window.addEventListener('beforeunload', () => { if (camRunning) stopCam(); });

    // ── Options ───────────────────────────────────────
    function toggleOptions() {
        const body  = document.getElementById('optBody');
        const arrow = document.getElementById('optArrow');
        const open  = body.style.display === 'none';
        body.style.display    = open ? '' : 'none';
        arrow.style.transform = open ? 'rotate(180deg)' : '';
    }

    // ── HW Scanner ────────────────────────────────────
    function mvToggleHwScan() {
        const section = document.getElementById('mvHwSection');
        const btn     = document.getElementById('mvHwBtn');
        const open    = section.style.display === 'none';
        section.style.display = open ? '' : 'none';
        btn.style.background  = open ? 'var(--blue)' : '#6b7280';
        if (open) {
            if (camRunning) mvToggleCam();           // close cam if open
            document.getElementById('mvHwInput').focus();
        }
    }

    function onMvHwKey(e) {
        if (e.key !== 'Enter') return;
        const inp = e.target;
        const val = inp.value.trim();
        inp.value = '';
        document.getElementById('mvHwStatus').textContent = 'พร้อมสแกน…';
        if (val) processScan(val);
    }

    // ── Camera ────────────────────────────────────────
    function mvToggleCam() { if (camRunning) stopCam(); else startCam(); }

    function setCamBtn(running) {
        const btn = document.getElementById('mvCamBtn');
        btn.style.background = running ? '#dc2626' : 'var(--blue)';
    }

    async function startCam() {
        if (!('BarcodeDetector' in window)) { toast('เบราว์เซอร์นี้ไม่รองรับ BarcodeDetector', 'err'); return; }
        // Close HW scan if open
        const hwSection = document.getElementById('mvHwSection');
        if (hwSection.style.display !== 'none') mvToggleHwScan();

        document.getElementById('mvCamSection').style.display = '';
        document.getElementById('mvCamStatus').textContent = 'กำลังสแกน…';
        setCamBtn(true);

        try {
            mvStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode, width: { ideal: 1280 }, height: { ideal: 720 } }
            });
        } catch {
            try {
                mvStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
                facingMode = 'user';
            } catch (e2) {
                toast('ไม่สามารถเข้าถึงกล้อง: ' + e2.message, 'err');
                document.getElementById('mvCamSection').style.display = 'none';
                setCamBtn(false); return;
            }
        }
        const video = document.getElementById('mvVideo');
        video.srcObject = mvStream;
        await video.play();
        const formats = await BarcodeDetector.getSupportedFormats();
        mvDetector  = new BarcodeDetector({ formats });
        camRunning = true;
        detectLoop();
    }

    function detectLoop() {
        if (!camRunning) return;
        const video  = document.getElementById('mvVideo');
        const canvas = document.getElementById('mvCanvas');
        const ctx    = canvas.getContext('2d');
        const dw = canvas.offsetWidth, dh = canvas.offsetHeight;
        if (canvas.width !== dw || canvas.height !== dh) { canvas.width = dw; canvas.height = dh; }
        if (video.readyState < 2) { mvRafId = requestAnimationFrame(detectLoop); return; }

        mvDetector.detect(video).then(results => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (results.length > 0) {
                const sx = canvas.width  / (video.videoWidth  || canvas.width);
                const sy = canvas.height / (video.videoHeight || canvas.height);
                results.forEach(b => {
                    const x = b.boundingBox.x * sx, y = b.boundingBox.y * sy;
                    const w = b.boundingBox.width * sx, h = b.boundingBox.height * sy;
                    ctx.strokeStyle = '#60a5fa'; ctx.lineWidth = 3; ctx.strokeRect(x, y, w, h);
                    const ty = y > 24 ? y - 4 : y + h + 16;
                    ctx.fillStyle = 'rgba(26,111,255,.88)'; ctx.fillRect(x, ty - 16, Math.min(w, 180), 18);
                    ctx.fillStyle = '#fff'; ctx.font = 'bold 11px sans-serif';
                    ctx.fillText(b.format.replace('_', ' ').toUpperCase(), x + 4, ty);
                });
                const first = results[0];
                document.getElementById('mvCamLabel').textContent = `${first.format}: ${first.rawValue}`;
                onCamScan(first.rawValue);
            } else {
                document.getElementById('mvCamLabel').textContent = '— กำลังค้นหา barcode —';
            }
            if (camRunning) mvRafId = requestAnimationFrame(detectLoop);
        }).catch(() => { if (camRunning) mvRafId = requestAnimationFrame(detectLoop); });
    }

    function stopCam() {
        camRunning = false;
        cancelAnimationFrame(mvRafId);
        if (mvStream) { mvStream.getTracks().forEach(t => t.stop()); mvStream = null; }
        const video = document.getElementById('mvVideo');
        video.srcObject = null;
        document.getElementById('mvCanvas').getContext('2d').clearRect(0, 0, 9999, 9999);
        document.getElementById('mvCamLabel').textContent = '— กำลังค้นหา barcode —';
        document.getElementById('mvCamSection').style.display = 'none';
        setCamBtn(false);
    }

    async function switchCamera() {
        if (!camRunning) return;
        facingMode = facingMode === 'environment' ? 'user' : 'environment';
        camRunning = false; cancelAnimationFrame(mvRafId);
        if (mvStream) { mvStream.getTracks().forEach(t => t.stop()); mvStream = null; }
        await startCam();
    }

    // ── Scan cooldown (camera only) ───────────────────
    function onCamScan(raw) {
        const now = Date.now();
        if (now - lastScanTime < 1800 || _processing) return;
        lastScanTime = now;
        processScan(raw);
    }

    // ── Core: resolve barcode → lotNo → lot details ───
    async function processScan(rawCode) {
        rawCode = (rawCode || '').trim();
        if (!rawCode || _processing) return;
        _processing = true;

        const statusCam = document.getElementById('mvCamStatus');
        const statusHw  = document.getElementById('mvHwStatus');
        const setStatus = t => { if (statusCam) statusCam.textContent = t; if (statusHw) statusHw.textContent = t; };
        setStatus('กำลังประมวลผล…');

        try {
            // 1. JSON → extract lotNo
            let lotNo = null;
            try {
                const obj = JSON.parse(rawCode);
                if (obj && obj.lotNo) lotNo = obj.lotNo;
            } catch (_) {}

            // 2. ส่งไป scan API ถ้ายังไม่มี lotNo
            if (!lotNo) {
                try {
                    const res = await api('/scan/scan', 'POST', { barcode: rawCode, mode: 0 });
                    const r = Array.isArray(res) ? res[0] : res;
                    lotNo = r?.lotNo ?? r?.lot_no ?? null;
                } catch (err) {
                    toast('Scan ล้มเหลว: ' + err.message, 'err');
                    return;
                }
            }

            if (!lotNo) { toast('ไม่พบ Lot No ใน barcode นี้', 'err'); return; }
            if (scannedLots.has(lotNo)) { toast('สแกนซ้ำ: ' + lotNo, 'warn'); return; }

            // 3. ดึงข้อมูล Lot
            const lotsRes = await api('/inventory/lots', 'POST', { lotNo, page: 1, pageSize: 1 });
            const lot = (lotsRes?.data ?? [])[0];
            if (!lot) { toast('ไม่พบ Lot: ' + lotNo, 'err'); return; }

            scannedLots.add(lotNo);
            addRow(lot);
            toast('✓ ' + lotNo, 'ok');

        } finally {
            _processing = false;
            setStatus('พร้อมสแกน…');
        }
    }

    // ── Table ─────────────────────────────────────────
    function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function addRow(lot) {
        // Remove empty state row
        const empty = document.getElementById('mvEmptyRow');
        if (empty) empty.remove();

        const fromLoc = lot.location ?? lot.locationCode ?? '—';
        const locType = lot.locationType ?? '';

        document.getElementById('moveTable').insertAdjacentHTML('beforeend', `
            <tr data-lot-no="${esc(lot.lotNo)}">
                <td style="font-family:ui-monospace,monospace;font-weight:700;font-size:12px;color:var(--navy)">${esc(lot.partNo ?? lot.itemPartNo ?? '—')}</td>
                <td style="color:var(--blue);font-weight:600;font-size:12px">${esc(lot.lotNo)}</td>
                <td style="color:var(--t2);font-size:12px;max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${esc(lot.description)}">${esc(lot.description ?? '—')}</td>
                <td>
                    <span style="background:#f0f2f5;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--t2)">${esc(fromLoc)}</span>
                    ${locType ? `<div style="font-size:10px;color:var(--t3);margin-top:2px">${esc(locType)}</div>` : ''}
                </td>
                <td><span style="font-size:11px;background:#e8f0ff;color:var(--blue);padding:2px 8px;border-radius:5px;font-weight:600">${esc(lot.itemType ?? lot.itemTypeName ?? '—')}</span></td>
                <td style="text-align:right;font-weight:700;color:var(--navy)">${(lot.onHandQty ?? lot.available ?? 0).toLocaleString()}</td>
                <td><button class="del-btn" onclick="removeRow(this)" title="Remove"><i class="bi bi-trash3"></i></button></td>
            </tr>`);

        updateCounter();
    }

    function removeRow(btn) {
        const row = btn.closest('tr');
        scannedLots.delete(row.dataset.lotNo);
        row.remove();
        if (!document.querySelectorAll('#moveTable tr[data-lot-no]').length) {
            document.getElementById('moveTable').insertAdjacentHTML('beforeend', `
                <tr id="mvEmptyRow">
                    <td colspan="7" class="empty-state">
                        <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                        No items yet — scan or use HW scanner to add
                    </td>
                </tr>`);
        }
        updateCounter();
    }

    function updateCounter() {
        const count = document.querySelectorAll('#moveTable tr[data-lot-no]').length;
        document.getElementById('mvCountBadge').textContent = count + ' รายการ';
        const hasLoc = !!document.getElementById('locationCode').value;
        document.getElementById('moveBtn').disabled = !(hasLoc && count > 0);
    }

    // ── Submit ────────────────────────────────────────
    async function submitMove() {
        const toCode = document.getElementById('locationSearch').value.trim();
        if (!document.getElementById('locationCode').value || !toCode) {
            toast('เลือก Destination Location ก่อน', 'err'); return;
        }

        const remark   = document.getElementById('mvRemark').value.trim();
        const rows     = document.querySelectorAll('#moveTable tr[data-lot-no]');
        const commands = [...rows].map(r => ({
            lotNo: r.dataset.lotNo, toLocationCode: toCode,
            remark, latitude: 0, longitude: 0
        }));

        if (!commands.length) { toast('ไม่มีรายการ', 'err'); return; }

        const payload = {
            command: commands,
            options: {
                skipGpsValidation:          document.getElementById('optSkipGps').checked,
                skipPrintedValidation:      document.getElementById('optSkipPrinted').checked,
                skipWorkOrderValidation:    document.getElementById('optSkipWo').checked,
                skipLocationValidation:     document.getElementById('optSkipLoc').checked,
                skipLotDuplicateValidation: document.getElementById('optSkipDup').checked,
                skipReservedLotValidation:  document.getElementById('optSkipReserved').checked,
                skipManualLotValidation:    document.getElementById('optSkipManual').checked,
            }
        };

        const btn = document.getElementById('moveBtn');
        btn.disabled = true; btn.textContent = '⏳ กำลัง Move…';

        try {
            const result   = await api('/inventory/re-locate', 'POST', payload);
            const resultArr = Array.isArray(result) ? result : (result?.results ?? []);

            let failCount = 0;
            rows.forEach(r => {
                const lotNo = r.dataset.lotNo;
                const item  = resultArr.find(x => x.lotNo === lotNo);
                if (item && item.success === false) {
                    r.classList.add('row-err'); failCount++;
                } else {
                    r.classList.add('row-ok');
                    setTimeout(() => { scannedLots.delete(lotNo); r.remove(); updateCounter(); }, 900);
                }
            });

            setTimeout(() => {
                const remain = document.querySelectorAll('#moveTable tr[data-lot-no]').length;
                if (remain === 0) toast('Move สำเร็จทั้งหมด ✓', 'ok');
                else if (failCount) toast(`สำเร็จบางส่วน — ${failCount} รายการล้มเหลว`, 'warn');
                else toast('Move สำเร็จ ✓', 'ok');
                btn.textContent = 'Move';
                updateCounter();
            }, 1100);

        } catch (err) {
            toast(err.message || 'Move ล้มเหลว', 'err');
            btn.disabled = false; btn.textContent = 'Move'; updateCounter();
        }
    }

    // ── Location search ───────────────────────────────
    let _locTimer = null;

    async function searchLocation() {
        const text = document.getElementById('locationSearch').value.trim();
        document.getElementById('locationCode').value = '';
        updateCounter();
        const dd = document.getElementById('locationDropdown');
        if (!text) { dd.style.display = 'none'; return; }
        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…</div>`;
        dd.style.display = 'block';
        clearTimeout(_locTimer);
        _locTimer = setTimeout(async () => {
            try {
                const json = await api(`/master/locations?search=${encodeURIComponent(text)}&isActive=true&page=1&pageSize=20`, 'GET');
                const list = json.data ?? json.Data ?? [];
                if (!list.length) {
                    dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>ไม่พบ Location</div>`;
                    return;
                }
                dd.innerHTML = list.map(loc => `
                    <div class="loc-item" onclick="selectLoc('${esc(loc.locationCode)}')">
                        <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0"></i>
                        <span>
                            <strong>${esc(loc.locationCode)}</strong>
                            ${loc.description ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${esc(loc.description)}</span>` : ''}
                        </span>
                        ${loc.typeName ? `<span style="margin-left:auto;font-size:11px;color:var(--t3)">${esc(loc.typeName)}</span>` : ''}
                    </div>`).join('');
            } catch {
                dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default"><i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ</div>`;
            }
        }, 300);
    }

    function selectLoc(code) {
        document.getElementById('locationSearch').value = code;
        document.getElementById('locationCode').value  = code;
        document.getElementById('locationDropdown').style.display = 'none';
        updateCounter();
    }

    function hideLocDd() { document.getElementById('locationDropdown').style.display = 'none'; }

    // ── Fallback keyboard HW scanner ─────────────────
    // (ใช้เมื่อ focus อยู่นอก input ใดๆ)
    ;(function() {
        let _buf = '', _timer = null;
        const THRESHOLD = 150, MIN = 4;
        function commit() {
            const c = _buf; _buf = '';
            if (c.length >= MIN) processScan(c);
        }
        document.addEventListener('keydown', e => {
            if (camRunning) return;
            const active = document.activeElement;
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) return;
            if (e.key === 'Enter') { clearTimeout(_timer); commit(); return; }
            if (e.key.length === 1) { _buf += e.key; clearTimeout(_timer); _timer = setTimeout(commit, THRESHOLD); }
        });
    })();

    // ── Toast ─────────────────────────────────────────
    function toast(msg, type) {
        const wrap = document.getElementById('toastWrap');
        const el   = document.createElement('div');
        el.className = 'toast-item ' + (type === 'ok' ? 'toast-ok' : type === 'warn' ? 'toast-warn' : 'toast-err');
        el.textContent = msg;
        wrap.appendChild(el);
        setTimeout(() => el.remove(), type === 'warn' ? 5000 : 3000);
    }
</script>
}
