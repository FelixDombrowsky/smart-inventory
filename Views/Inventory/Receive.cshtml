        // ── HTML escape helper ─────────────────────────
        function esc(s) { return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }

        // ── WO autocomplete ────────────────────────────
        const woAuto = createWorkOrderAutocomplete({
            inputId: "woSearch", dropdownId: "woDropdown",
