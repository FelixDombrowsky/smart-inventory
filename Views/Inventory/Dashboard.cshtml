<!-- ── STAT CARDS ── -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--blue-lt);color:var(--blue)">OHH</div>
        <div>
            <div class="stat-num" id="totalOnHand">—</div>
            <div class="stat-lbl" data-i18n="totalOnHand">Total On Hand</div>
