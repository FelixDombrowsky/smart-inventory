@{
    ViewData["Title"] = "Move Materials";
}
<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --green:#059669; --green-lt:#ecfdf5;
    --red:#dc2626; --red-lt:#fef2f2; --amber:#d97706; --amber-lt:#fffbeb;
}

.page-header {
    background:linear-gradient(135deg,var(--navy) 0%,#1e3a6e 60%,#1a6fff 100%);
    border-radius:16px; padding:20px 28px; margin-bottom:20px;
    position:relative; overflow:hidden;
}
.page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04); }
.page-header h2 { font-size:22px; font-weight:700; color:#fff; margin-bottom:4px; }

.rp-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.rp-card-head {
    padding:12px 18px; border-bottom:1px solid var(--border);
    font-size:13px; font-weight:700; color:var(--navy);
    display:flex; align-items:center; gap:8px;
}
.rp-card-body { padding:18px 20px; }

/* Location */
.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:10px 12px 10px 38px;
    border:1.5px solid var(--border); border-radius:10px;
    font-size:14px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item { padding:10px 14px; font-size:13px; cursor:pointer; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; transition:.12s; }
.loc-item:last-child  { border-bottom:none; }
.loc-item:hover       { background:var(--blue-lt); }
.loc-item:first-child { border-radius:8px 8px 0 0; }
.loc-item:last-child  { border-radius:0 0 8px 8px; }

/* Icon buttons */
.icon-btn {
    width:34px; height:34px; border-radius:9px; border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:16px;
    transition:.15s; flex-shrink:0;
}
.icon-btn:disabled { opacity:.35; cursor:not-allowed; }

/* Counter badge */
.count-badge {
    font-size:11px; font-weight:700; padding:2px 9px;
    border-radius:20px; background:var(--blue-lt); color:var(--blue);
}

/* Table */
.rx-table { width:100%; border-collapse:collapse; font-size:13px; }
.rx-table th {
    background:#f8f9fc; color:var(--t2); font-weight:700; font-size:11px;
    letter-spacing:.04em; text-transform:uppercase;
    padding:10px 16px; border-bottom:2px solid var(--border); text-align:left;
}
.rx-table td { padding:9px 16px; border-bottom:1px solid var(--border); vertical-align:middle; }
.rx-table tr:last-child td { border-bottom:none; }
.rx-table tbody tr:hover td { background:#fafbff; }
.rx-table tbody tr.row-err td { background:var(--red-lt); }
.rx-table tbody tr.row-err td:first-child { border-left:3px solid var(--red); }
.rx-table tbody tr.row-err-detail td { background:var(--red-lt); border-top:1px solid #fecaca; border-left:3px solid var(--red); padding:4px 14px 7px; }
.rx-table tbody tr.row-ok  td { background:var(--green-lt); opacity:.6; transition:opacity .4s; }
.del-btn { width:30px; height:30px; border:none; border-radius:7px; background:#fef2f2; color:var(--red); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.del-btn:hover { background:var(--red); color:#fff; }
.mv-act-btn { height:26px; padding:0 10px; border:none; border-radius:6px; font-size:11px; font-weight:700; cursor:pointer; font-family:inherit; transition:.12s; display:inline-flex; align-items:center; gap:4px; }
.mv-retry-btn { background:#fff3cd; color:#856404; }
.mv-retry-btn:hover { background:#ffc107; color:#fff; }
.mv-edit-btn  { background:#e8f0ff; color:var(--blue); }
.mv-edit-btn:hover  { background:var(--blue); color:#fff; }
.row-processing td { opacity:.5; pointer-events:none; }
.empty-state { padding:36px; text-align:center; color:var(--t3); font-size:13px; }

/* Options toggles */
.opt-row { display:flex; align-items:center; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f4f4f7; }
.opt-row:last-child { border-bottom:none; }
.toggle-wrap { position:relative; display:inline-block; width:38px; height:22px; flex-shrink:0; }
.toggle-wrap input { opacity:0; width:0; height:0; }
.toggle-slider { position:absolute; inset:0; background:#e5e7eb; border-radius:22px; cursor:pointer; transition:.2s; }
.toggle-slider:before { content:''; position:absolute; left:3px; bottom:3px; width:16px; height:16px; background:#fff; border-radius:50%; transition:.2s; box-shadow:0 1px 3px rgba(0,0,0,.2); }
.toggle-wrap input:checked + .toggle-slider { background:var(--blue); }
.toggle-wrap input:checked + .toggle-slider:before { transform:translateX(16px); }

/* Move button */
.move-btn {
    width:100%; padding:14px; border:none; border-radius:12px;
    font-size:15px; font-weight:700; font-family:inherit; cursor:pointer;
    transition:.2s; background:var(--blue); color:#fff; margin-top:4px;
}
.move-btn:disabled { background:#e5e7eb; color:#9ca3af; cursor:not-allowed; }
.move-btn:not(:disabled):hover { background:var(--blue-dk); }

/* Toast */
.toast-wrap { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.toast-item { padding:11px 20px; border-radius:10px; font-size:13px; font-weight:600; color:#fff; box-shadow:0 4px 16px rgba(0,0,0,.18); animation:tIn .25s ease; min-width:160px; }
.toast-ok   { background:var(--green); }
.toast-err  { background:var(--red); }
.toast-warn { background:var(--amber); }
@@keyframes tIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:none} }
</style>

<div class="toast-wrap" id="toastWrap"></div>

<!-- ── Header ── -->
<div class="page-header">
    <h2 style="display:flex;align-items:center;gap:10px;margin:0">
        Move Materials
        <i class="bi bi-box-arrow-right" style="opacity:.85;font-size:24px"></i>
    </h2>
</div>

<!-- ── 1. Destination Location ── -->
<div class="rp-card">
    <div class="rp-card-body">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
            <div style="flex:1;min-width:180px">
                <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                    <i class="bi bi-geo-alt-fill me-1" style="color:var(--blue)"></i>Destination Location <span style="color:var(--red)">*</span>
                </div>
                <div class="loc-wrap">
                    <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                    <input id="locationSearch" class="loc-input"
                           placeholder="ค้นหา Destination Location…"
                           autocomplete="off"
                           oninput="searchLocation()"
                           onblur="setTimeout(hideLocDd,200)">
                    <input type="hidden" id="locationCode">
                    <div id="locationDropdown" class="loc-dd"></div>
                </div>
            </div>
            <!-- Camera -->
            <button id="mvCamBtn" class="icon-btn" title="Camera scan"
                    style="background:var(--blue);color:#fff;width:44px;height:44px;font-size:20px;flex-shrink:0"
                    onclick="mvToggleCam()">
                <i class="bi bi-camera-fill"></i>
            </button>
            <!-- HW Scanner -->
            <button id="mvHwBtn" class="icon-btn" title="HW scanner"
                    style="background:#6b7280;color:#fff;width:44px;height:44px;font-size:20px;flex-shrink:0"
                    onclick="mvToggleHwScan()">
                <i class="bi bi-upc-scan"></i>
            </button>
        </div>
    </div>
</div>

<!-- ── Camera section ── -->
    <partial name="_BarcodeScannerSection" />

<!-- ── 2. Item List ── -->
<div class="rp-card" style="overflow:visible">
    <div class="rp-card-head">
        <i class="bi bi-box-arrow-right" style="color:var(--blue)"></i>
        <span>Move List</span>
        <span class="count-badge" id="mvCountBadge">0/10</span>
        <div style="margin-left:auto">
            <button onclick="mvToggleManual()"
                    style="padding:5px 14px;border:1.5px solid var(--border);border-radius:7px;background:#fff;color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s;white-space:nowrap"
                    onmouseover="this.style.borderColor='var(--blue)';this.style.color='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--t2)'">
                <i class="bi bi-pencil me-1"></i>Manual
            </button>
        </div>
    </div>

    <!-- Manual Search Section (inline) -->
    <div id="mvManualSection" style="display:none;padding:12px 16px;border-bottom:1px solid var(--border);background:#f8faff">
        <div style="position:relative">
            <i class="bi bi-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--blue);font-size:14px;pointer-events:none"></i>
            <input id="mvManualInput"
                   class="loc-input"
                   style="padding-left:38px;border-color:var(--blue);background:#fff"
                   placeholder="พิมพ์ Lot No เพื่อค้นหา…"
                   autocomplete="off"
                   oninput="mvManualAutocomplete()"
                   onkeydown="if(event.key==='Escape')mvToggleManual();else if(event.key==='Enter'){event.preventDefault();mvManualEnter();}"
                   onblur="setTimeout(mvHideLotDd,200)">
            <div id="mvManualDd" class="loc-dd"></div>
        </div>
    </div>

    <!-- HW Scanner Section (inline) -->
    <partial name="_HwScannerSection" />

    

    <!-- Table -->
    <div style="overflow-x:auto">
        <table class="rx-table">
            <thead>
                <tr>
                    <th>Part No</th>
                    <th>Lot No</th>
                    <th>From</th>
                    <th>To</th>
                    <th style="text-align:right">QTY</th>
                    <th style="width:46px"></th>
                </tr>
            </thead>
            <tbody id="moveTable">
                <tr id="mvEmptyRow">
                    <td colspan="6" class="empty-state">
                        <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                        ยังไม่มีรายการ — สแกน QR หรือกด Manual
                    </td>
                </tr>
            </tbody>

        </table>
    </div>
</div>

<!-- ── 3. Advanced Options (collapsible) ── -->
<div class="rp-card" id="mvAdvancedOptions" style="display:none">
    <div class="rp-card-head" style="cursor:pointer" onclick="toggleOptions()">
        <i class="bi bi-sliders" style="color:var(--t2)"></i>
        <span style="font-weight:700">Advanced Options</span>
        <i class="bi bi-chevron-down" id="optArrow" style="margin-left:auto;color:var(--t2);transition:transform .2s"></i>
    </div>
    <div id="optBody" class="rp-card-body" style="display:none;padding-top:10px">
        <div class="opt-row">
            <div style="font-size:13px;color:var(--text)">Skip GPS Validation</div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipGps"><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div style="font-size:13px;color:var(--text)">Skip Printed Validation</div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipPrinted"><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div style="font-size:13px;color:var(--text)">Skip Work Order Validation</div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipWo"><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div style="font-size:13px;color:var(--text)">Skip Location Validation</div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipLoc"><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div style="font-size:13px;color:var(--text)">Skip Lot Duplicate Validation</div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipDup"><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div style="font-size:13px;color:var(--text)">Skip Reserved Lot Validation</div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipReserved"><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div style="font-size:13px;color:var(--text)">Skip Manual Lot Validation</div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipManual"><span class="toggle-slider"></span></label>
        </div>
        <div class="opt-row">
            <div style="font-size:13px;color:var(--text)">Skip Unique Id Validation</div>
            <label class="toggle-wrap"><input type="checkbox" id="optSkipUnique"><span class="toggle-slider"></span></label>
        </div>
    </div>
</div>

<!-- ── Move button ── -->
<button class="move-btn" id="moveBtn" onclick="submitMove()" disabled>Move</button>

@section Scripts {
<script src="/js/api.js"></script>
<script src="/js/barcodeScanner.js"></script>
<script src="/js/hwScanner.js"></script>
<script src="/lib/html5-qrcode/html5-qrcode.min.js"></script>
<script>
    // ── State ─────────────────────────────────────────
    let scannedLots = new Set();
    let lastScanTime = 0;
    let _processing = false;
    let mvLatitude = 0, mvLongitude = 0;
    let _mvMoving = false;

    const mvScanner = createBarcodeScanner({
        videoId: 'bcVideo', canvasId: 'bcCanvas', labelId: 'bcLabel',
        onDetect: onCamScan
    });

    function mvShowError(id, show) {
        const el = document.getElementById(id);
        if (!el) return;
        el.style.transition  = 'border-color .15s, box-shadow .15s';
        el.style.borderColor = show ? 'var(--red)' : '';
        el.style.boxShadow   = show ? '0 0 0 3px rgba(220,38,38,.15)' : '';
    }

    window.addEventListener('beforeunload', () => { if (mvScanner.running) stopScan(); });

    // ── Role: show Advanced Options for admin only ─────
    (function() {
        const adminRoles = ['Admin', 'Inventory_Admin', 'Admin_WH', 'Supervisor'];
        try {
            const user = JSON.parse(localStorage.getItem('user') || '{}');
            if (adminRoles.includes(user.role))
                document.getElementById('mvAdvancedOptions').style.display = '';
        } catch (_) {}
    })();

    // ── Manual Search ─────────────────────────────────
    let _mvManualTimer = null, _mvManualResults = [];

    function mvToggleManual() {
        const sec = document.getElementById('mvManualSection');
        const open = sec.style.display === 'none';
        sec.style.display = open ? '' : 'none';
        if (open) setTimeout(() => document.getElementById('mvManualInput').focus(), 50);
        else mvHideLotDd();
    }

    function mvHideLotDd() {
        document.getElementById('mvManualDd').style.display = 'none';
    }

    function mvManualAutocomplete() {
        const inp  = document.getElementById('mvManualInput');
        const dd   = document.getElementById('mvManualDd');
        const text = inp.value.trim();
        if (!text) { dd.style.display = 'none'; return; }

        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <i class="bi bi-hourglass-split me-2"></i>กำลังค้นหา…</div>`;
        dd.style.display = 'block';

        clearTimeout(_mvManualTimer);
        _mvManualTimer = setTimeout(async () => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: text });
                const list = Array.isArray(res) ? res : (res?.data || []);
                if (!list.length) {
                    dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                        <i class="bi bi-search me-2"></i>ไม่พบ Lot No</div>`;
                    return;
                }
                _mvManualResults = list;
                dd.innerHTML = list.map((l, i) => `
                    <div class="loc-item" onmousedown="mvManualSelect(${i})">
                        <div>
                            <div style="font-weight:700;font-size:13px">${esc(l.lotNo || '')}</div>
                            ${l.partNo ? `<div style="font-size:11px;color:var(--t3)">${esc(l.partNo)}</div>` : ''}
                        </div>
                        <span style="margin-left:auto;font-size:11px;color:var(--t2)">${esc(l.location ?? l.locationCode ?? '')}</span>
                    </div>`).join('');
                dd.style.display = 'block';
            } catch (err) {
                dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                    <i class="bi bi-exclamation-circle me-2"></i>${esc(err.message || 'Error')}</div>`;
            }
        }, 300);
    }

    function mvManualSelect(i) {
        const lot = _mvManualResults[i];
        if (!lot) return;
        mvHideLotDd();
        document.getElementById('mvManualInput').value = '';
        if (scannedLots.has(lot.lotNo)) { toast('สแกนซ้ำ: ' + lot.lotNo, 'warn'); return; }
        scannedLots.add(lot.lotNo);
        addRow(lot);
        toast('✓ ' + lot.lotNo, 'ok');
    }

    function mvManualEnter() {
        const val = document.getElementById('mvManualInput').value.trim();
        if (!val) return;
        mvHideLotDd();
        clearTimeout(_mvManualTimer);
        document.getElementById('mvManualInput').value = '';
        // If autocomplete already has an exact match, use it directly
        const idx = _mvManualResults.findIndex(l => l.lotNo === val);
        if (idx >= 0) { mvManualSelect(idx); return; }
        // No match — add row directly with typed value as lotNo
        if (scannedLots.has(val)) { toast('สแกนซ้ำ: ' + val, 'warn'); return; }
        scannedLots.add(val);
        addRow({ lotNo: val });
        toast('✓ ' + val, 'ok');
    }

    // ── Options ───────────────────────────────────────
    function toggleOptions() {
        const body  = document.getElementById('optBody');
        const arrow = document.getElementById('optArrow');
        const open  = body.style.display === 'none';
        body.style.display    = open ? '' : 'none';
        arrow.style.transform = open ? 'rotate(180deg)' : '';
    }

    // ── HW Scanner ────────────────────────────────────
    const mvHwScanner = createHwScanner({
        inputId: 'hwInput', statusId: 'hwStatus',
        onScan: mvHwProcess
    });

    function mvToggleHwScan() {
        const section = document.getElementById('hwSection');
        const btn     = document.getElementById('mvHwBtn');
        if (mvHwScanner.active) {
            mvHwScanner.close();
            section.style.display = 'none';
            btn.style.background  = '#6b7280';
        } else {
            section.style.display = '';
            btn.style.background  = 'var(--red)';
            if (mvScanner.running) mvToggleCam();
            mvHwScanner.open();
        }
    }

    async function mvHwProcess(rawCode) {
        if (_processing) return;
        _processing = true;

        try {
            let lotNo = rawCode;
            let uniqueId = null;
            try {
                const obj = JSON.parse(rawCode);
                if (obj?.lotNo) lotNo = obj.lotNo;
                if (obj?.uniqueId) uniqueId = obj.uniqueId;
            } catch (_) {}
            console.log('[Move][HW Scan] rawCode →', rawCode, '| lotNo →', lotNo, '| uniqueId →', uniqueId)

            if (scannedLots.has(lotNo)) { toast('สแกนซ้ำ: ' + lotNo, 'warn'); return; }

            const res  = await api('/inventory/lots', 'POST', { lotNo });
            const list = Array.isArray(res) ? res : (res?.data || []);
            const lot  = list.find(l => l.lotNo === lotNo);
            if (!lot) { toast('ไม่พบ Lot: ' + lotNo, 'err'); return; }
            console.log('[Move][HW Scan] lot →', lot)

            scannedLots.add(lotNo);
            addRow({ ...lot, uniqueId });
            toast('✓ ' + lotNo, 'ok');
        } catch (err) {
            toast(err.message || 'Error', 'err');
        } finally {
            _processing = false;
        }
    }

    // ── Camera ────────────────────────────────────────
    function mvToggleCam() { if (mvScanner.running) stopScan(); else startCam(); }

    function setCamBtn(running) {
        const btn = document.getElementById('mvCamBtn');
        btn.style.background = running ? '#dc2626' : 'var(--blue)';
    }

    async function startCam() {
        // Close HW scan if open
        const hwSection = document.getElementById('hwSection');
        if (hwSection.style.display !== 'none') mvToggleHwScan();

        document.getElementById('bcSection').style.display = '';
        document.getElementById('bcStatus').textContent = 'กำลังสแกน…';
        setCamBtn(true);

        try {
            await mvScanner.start();
        } catch (err) {
            toast(err.message.includes('BarcodeDetector') ? err.message : 'ไม่สามารถเข้าถึงกล้อง: ' + err.message, 'err');
            document.getElementById('bcSection').style.display = 'none';
            setCamBtn(false);
        }
    }

    function stopScan() {
        mvScanner.stop();
        document.getElementById('bcSection').style.display = 'none';
        setCamBtn(false);
    }

    async function switchCamera() {
        await mvScanner.switchCamera();
    }

    // ── Scan cooldown (camera only) ───────────────────
    function onCamScan(raw) {
        const now = Date.now();
        if (now - lastScanTime < 1800 || _processing) return;
        lastScanTime = now;
        processScan(raw);
    }

    // ── Core: resolve barcode → lotNo → lot details ───
    async function processScan(rawCode) {
        rawCode = (rawCode || '').trim();
        if (!rawCode || _processing) return;
        _processing = true;

        const statusCam = document.getElementById('bcStatus');
        const statusHw  = document.getElementById('hwStatus');
        const setStatus = t => { if (statusCam) statusCam.textContent = t; if (statusHw) statusHw.textContent = t; };
        setStatus('กำลังประมวลผล…');

        try {
            // 1. JSON → extract lotNo + uniqueId
            let lotNo = null;
            let uniqueId = null;
            try {
                const obj = JSON.parse(rawCode);
                if (obj && obj.lotNo) lotNo = obj.lotNo;
                if (obj && obj.uniqueId) uniqueId = obj.uniqueId;
            } catch (_) {}
            console.log('[Move][Cam Scan] rawCode →', rawCode, '| parsed lotNo →', lotNo, '| uniqueId →', uniqueId)

            // 2. ส่งไป scan API ถ้ายังไม่มี lotNo
            if (!lotNo) {
                try {
                    const res = await api('/scan', 'POST', { barcode: rawCode, mode: 0 });
                    const r = Array.isArray(res) ? res[0] : res;
                    lotNo = r?.lotNo ?? r?.lot_no ?? null;
                    if (uniqueId == null) uniqueId = r?.uniqueId ?? r?.unique_id ?? null;
                    console.log('[Move][Cam Scan] /scan response →', res, '| lotNo →', lotNo, '| uniqueId →', uniqueId)
                } catch (err) {
                    toast('Scan ล้มเหลว: ' + err.message, 'err');
                    return;
                }
            }

            if (!lotNo) { toast('ไม่พบ Lot No ใน barcode นี้', 'err'); return; }
            if (scannedLots.has(lotNo)) { toast('สแกนซ้ำ: ' + lotNo, 'warn'); return; }

            // 3. ดึงข้อมูล Lot
            const lotsRes = await api('/inventory/lots', 'POST', { lotNo, page: 1, pageSize: 1 });
            const lot = (lotsRes?.data ?? [])[0];
            if (!lot) { toast('ไม่พบ Lot: ' + lotNo, 'err'); return; }
            console.log('[Move][Cam Scan] lot →', lot)

            scannedLots.add(lotNo);
            addRow({ ...lot, uniqueId });
            toast('✓ ' + lotNo, 'ok');

        } finally {
            _processing = false;
            setStatus('พร้อมสแกน…');
        }
    }

    // ── Table ─────────────────────────────────────────
    function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function addRow(lot) {
        if (document.querySelectorAll('#moveTable tr[data-lot-no]').length >= 10) {
            toast('ครบ 10 รายการแล้ว', 'warn'); return;
        }
        const empty = document.getElementById('mvEmptyRow');
        if (empty) empty.remove();

        const fromLoc = lot.location ?? lot.locationCode ?? '—';
        const toLoc   = document.getElementById('locationSearch').value.trim() || document.getElementById('locationCode').value || '—';
        const qty     = lot.onHandQty ?? lot.available ?? 0;

        document.getElementById('moveTable').insertAdjacentHTML('beforeend', `
            <tr data-lot-no="${esc(lot.lotNo)}" data-unique-id="${esc(lot.uniqueId ?? '')}">
                <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${esc(lot.partNo ?? lot.itemPartNo ?? '—')}</td>
                <td style="color:var(--blue);font-weight:600;font-size:12px">${esc(lot.lotNo)}</td>
                <td><span style="background:#f0f2f5;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--t2)">${esc(fromLoc)}</span></td>
                <td data-to-cell><span style="background:#e8f0ff;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--blue)">${esc(toLoc)}</span></td>
                <td style="text-align:right;font-weight:700;color:var(--navy)">${qty.toLocaleString()}</td>
                <td><button class="del-btn" onclick="removeRow(this)" title="Remove"><i class="bi bi-trash3"></i></button></td>
            </tr>`);

        updateCounter();
    }

    function removeRow(btn) {
        const row = btn.closest('tr');
        scannedLots.delete(row.dataset.lotNo);
        const nextRow = row.nextElementSibling;
        if (nextRow?.classList.contains('row-err-detail')) nextRow.remove();
        row.remove();
        if (!document.querySelectorAll('#moveTable tr[data-lot-no]').length) {
            document.getElementById('moveTable').insertAdjacentHTML('beforeend', `
                <tr id="mvEmptyRow">
                    <td colspan="6" class="empty-state">
                        <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                        ยังไม่มีรายการ — สแกน QR หรือกด Manual
                    </td>
                </tr>`);
        }
        updateCounter();
    }

    function updateCounter() {
        const count = document.querySelectorAll('#moveTable tr[data-lot-no]').length;
        document.getElementById('mvCountBadge').textContent = count + '/10';
        const enabled = count > 0 && !_mvMoving;
        const btn = document.getElementById('moveBtn');
        btn.disabled      = !enabled;
        btn.style.opacity = enabled ? '1' : '0.45';
        btn.style.cursor  = enabled ? 'pointer' : 'not-allowed';
        if (document.getElementById('locationCode').value) mvShowError('locationSearch', false);
    }

    // ── Submit (per-item sequential) ──────────────────
    function _mvOptions() {
        return {
            skipGpsValidation:          document.getElementById('optSkipGps').checked,
            skipPrintedValidation:      document.getElementById('optSkipPrinted').checked,
            skipWorkOrderValidation:    document.getElementById('optSkipWo').checked,
            skipLocationValidation:     document.getElementById('optSkipLoc').checked,
            skipLotDuplicateValidation: document.getElementById('optSkipDup').checked,
            skipReservedLotValidation:  document.getElementById('optSkipReserved').checked,
            skipManualLotValidation:    document.getElementById('optSkipManual').checked,
            skipUniquenIdValidation:    document.getElementById('optSkipUnique').checked,
        };
    }

    async function _moveOneRow(row) {
        const toCode   = document.getElementById('locationCode').value;
        const lotNo    = row.dataset.lotNo;
        const uniqueId = row.dataset.uniqueId || '';

        const errDetail = row.nextElementSibling;
        if (errDetail?.classList.contains('row-err-detail')) errDetail.remove();
        row.classList.remove('row-err', 'row-ok');
        row.classList.add('row-processing');
        _setRowAction(row, `<span style="font-size:12px;color:var(--t2)">⏳</span>`);

        try {
            const payload = {
                command: [{ lotNo, toLocationCode: toCode, latitude: mvLatitude, longitude: mvLongitude, uniqueId }],
                options: _mvOptions()
            }
            console.log('[Move] payload →', JSON.stringify(payload, null, 2))
            const res = await api('/inventory/re-locate', 'POST', payload);
            console.log('[Move] response →', res)
            const arr  = Array.isArray(res) ? res : (res?.results ?? res?.data ?? [res]);
            const item = arr.find(x => x.lotNo === lotNo) ?? arr[0];

            row.classList.remove('row-processing');
            if (item?.success === false || item?.isSuccess === false) {
                const errMsg = [item.errorCode, item.message || item.error].filter(Boolean).join(': ') || 'Move ล้มเหลว';
                _setRowError(row, errMsg);
                return false;
            } else {
                row.classList.add('row-ok');
                await new Promise(r => setTimeout(r, 700));
                scannedLots.delete(lotNo);
                row.remove();
                updateCounter();
                return true;
            }
        } catch (err) {
            row.classList.remove('row-processing');
            _setRowError(row, err.message || 'Move ล้มเหลว');
            return false;
        }
    }

    function _setRowAction(row, html) {
        const lastTd = row.cells[row.cells.length - 1];
        if (lastTd) lastTd.innerHTML = html;
    }

    function _setRowError(row, errMsg) {
        row.classList.add('row-err');
        _setRowAction(row, `<button class="del-btn" onclick="removeRow(this)" title="Remove"><i class="bi bi-trash3"></i></button>`);
        const existing = row.nextElementSibling;
        if (existing?.classList.contains('row-err-detail')) existing.remove();
        const colspan = row.cells.length;
        row.insertAdjacentHTML('afterend', `
            <tr class="row-err-detail">
                <td colspan="${colspan}"><span style="font-size:11px;color:var(--red);font-weight:600">${esc(errMsg)}</span></td>
            </tr>`);
    }

    async function submitMove() {
        const rows = [...document.querySelectorAll('#moveTable tr[data-lot-no]')];
        if (!rows.length || _mvMoving) return;

        // Validate: Destination Location
        if (!document.getElementById('locationCode').value) {
            mvShowError('locationSearch', true);
            document.getElementById('locationSearch').scrollIntoView({ behavior: 'smooth', block: 'center' });
            setTimeout(() => document.getElementById('locationSearch').focus(), 300);
            toast('กรุณาเลือก Destination Location', 'err');
            return;
        }

        _mvMoving = true;
        updateCounter();
        const btn = document.getElementById('moveBtn');
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลัง Move…';

        try {
            // ── GPS ───────────────────────────────────────
            mvLatitude = 0; mvLongitude = 0;
            if (!document.getElementById('optSkipGps').checked) {
                if (!navigator.geolocation) { toast('Browser ไม่รองรับ GPS', 'err'); return; }
                btn.innerHTML = '<i class="bi bi-geo-alt"></i> Getting GPS…';
                try {
                    const pos = await new Promise((res, rej) =>
                        navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
                    );
                    mvLatitude  = pos.coords.latitude;
                    mvLongitude = pos.coords.longitude;
                } catch (e) {
                    toast('GPS error: ' + e.message, 'err'); return;
                }
                btn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลัง Move…';
            }

            let successCount = 0, failCount = 0;
            for (const row of rows) {
                const ok = await _moveOneRow(row);
                ok ? successCount++ : failCount++;
            }

            if (failCount === 0)       toast(`Move สำเร็จ ${successCount} รายการ ✓`, 'ok');
            else if (successCount > 0) toast(`สำเร็จ ${successCount} รายการ — ล้มเหลว ${failCount} รายการ`, 'warn');
            else                       toast(`ล้มเหลว ${failCount} รายการ`, 'err');
        } finally {
            _mvMoving = false;
            btn.innerHTML = 'Move';
            updateCounter();
        }
    }

    // ── Retry / Edit row ──────────────────────────────
    async function mvRetryRow(btn) {
        const row = btn.closest('tr');
        if (!row || !document.getElementById('locationCode').value) {
            toast('เลือก Destination Location ก่อน', 'err'); return;
        }
        await _moveOneRow(row);
        updateCounter();
    }


    // ── Location search ───────────────────────────────
    let _locTimer = null;

    async function searchLocation() {
        const text = document.getElementById('locationSearch').value.trim();
        document.getElementById('locationCode').value = '';
        updateCounter();
        const dd = document.getElementById('locationDropdown');
        if (!text) { dd.style.display = 'none'; return; }
        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…</div>`;
        dd.style.display = 'block';
        clearTimeout(_locTimer);
        _locTimer = setTimeout(async () => {
            try {
                const json = await api(`/location?search=${encodeURIComponent(text)}&page=1&pageSize=20`, 'GET');
                const list = json.data ?? json.Data ?? [];
                if (!list.length) {
                    dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>ไม่พบ Location</div>`;
                    return;
                }
                dd.innerHTML = list.map(loc => `
                    <div class="loc-item" onclick="selectLoc('${esc(loc.locationCode)}')">
                        <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0"></i>
                        <span>
                            <strong>${esc(loc.locationCode)}</strong>
                            ${loc.description ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${esc(loc.description)}</span>` : ''}
                        </span>
                        ${loc.typeName ? `<span style="margin-left:auto;font-size:11px;color:var(--t3)">${esc(loc.typeName)}</span>` : ''}
                    </div>`).join('');
            } catch {
                dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default"><i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ</div>`;
            }
        }, 300);
    }

    function selectLoc(code) {
        document.getElementById('locationSearch').value = code;
        document.getElementById('locationCode').value  = code;
        document.getElementById('locationDropdown').style.display = 'none';
        mvShowError('locationSearch', false);
        document.querySelectorAll('#moveTable tr[data-lot-no] td[data-to-cell]').forEach(td => {
            td.innerHTML = `<span style="background:#e8f0ff;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--blue)">${esc(code)}</span>`;
        });
        updateCounter();
    }

    function hideLocDd() { document.getElementById('locationDropdown').style.display = 'none'; }

    // ── Fallback keyboard HW scanner ─────────────────
    // (ใช้เมื่อ focus อยู่นอก input ใดๆ)
    ;(function() {
        let _buf = '', _timer = null;
        const THRESHOLD = 150, MIN = 4;
        function commit() {
            const c = _buf; _buf = '';
            if (c.length >= MIN) processScan(c);
        }
        document.addEventListener('keydown', e => {
            if (mvScanner.running) return;
            const active = document.activeElement;
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) return;
            if (e.key === 'Enter') { clearTimeout(_timer); commit(); return; }
            if (e.key.length === 1) { _buf += e.key; clearTimeout(_timer); _timer = setTimeout(commit, THRESHOLD); }
        });
    })();

    // ── Toast ─────────────────────────────────────────
    function toast(msg, type) {
        const wrap = document.getElementById('toastWrap');
        const el   = document.createElement('div');
        el.className = 'toast-item ' + (type === 'ok' ? 'toast-ok' : type === 'warn' ? 'toast-warn' : 'toast-err');
        el.textContent = msg;
        wrap.appendChild(el);
        setTimeout(() => el.remove(), type === 'warn' ? 5000 : 3000);
    }
</script>
}
