@{
    ViewData["Title"] = "Master Management";
}
<link rel="stylesheet" href="css/master-shared.css"/>
<style>
.bom-grid { display:grid; grid-template-columns:340px 1fr; min-height:520px; }
.bom-master-panel { border-right:1px solid var(--border); overflow-y:auto; max-height:640px; display:flex; flex-direction:column; }
.bom-detail-panel { overflow-y:auto; max-height:640px; }
@@media (max-width:900px) {
    .bom-grid { grid-template-columns:1fr; }
    .bom-master-panel { border-right:none; border-bottom:1px solid var(--border); max-height:280px; }
    .bom-detail-panel { max-height:none; }
}
[data-theme="dark"] .bom-master-panel,
[data-theme="dark"] .bom-detail-panel { border-color:var(--border); }
[data-theme="dark"] .bom-grid { border-color:var(--border); }

/* ── root list (left) ── */
.root-list{ flex:1; overflow-y:auto; }
.root-row{ display:flex; align-items:center; gap:10px; padding:11px 16px; cursor:pointer; border-bottom:1px solid var(--border); transition:background .12s; }
.root-row:hover{ background:var(--blue-lt); }
.root-row.active{ background:var(--blue-lt); box-shadow:inset 3px 0 0 var(--blue); }
.root-icon{ width:32px; height:32px; border-radius:9px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.root-main{ flex:1; min-width:0; }
.root-part{ font-family:ui-monospace,monospace; font-weight:700; font-size:13px; color:var(--navy); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.root-meta{ font-size:11px; color:var(--t2); margin-top:2px; display:flex; gap:6px; align-items:center; }
.root-qty{ font-size:12px; font-weight:700; color:var(--blue); white-space:nowrap; flex-shrink:0; }

/* ── hero + tree (right) ── */
.bom-hero{ padding:20px 24px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
.hero-icon{ width:50px; height:50px; border-radius:13px; background:var(--blue-lt); color:var(--blue); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.hero-part{ font-family:ui-monospace,monospace; font-size:18px; font-weight:800; color:var(--navy); line-height:1.15; }
.hero-stats{ display:flex; gap:18px; margin-left:auto; }
.hero-stat{ text-align:center; }
.hero-stat b{ display:block; font-size:15px; font-weight:700; color:var(--navy); }
.hero-stat span{ font-size:10.5px; color:var(--t3); text-transform:uppercase; letter-spacing:.04em; font-weight:700; }
.tree-wrap{ padding:16px 24px 24px; overflow-x:auto; }
.legend{ display:flex; gap:18px; padding:0 24px 14px; font-size:11.5px; color:var(--t2); flex-wrap:wrap; }
.legend-item{ display:flex; align-items:center; gap:6px; }
.legend-dot{ width:9px; height:9px; border-radius:3px; flex-shrink:0; }
.tnode-children{ margin-left:26px; border-left:1.5px dashed var(--border); padding-left:18px; }
.trow{ display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:9px; transition:background .12s; margin:2px 0; }
.trow:hover{ background:var(--bg-page); }
.trow-toggle{ width:20px; height:20px; border-radius:6px; border:1.5px solid var(--border); background:var(--card); display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0; color:var(--t2); }
.trow-toggle:hover{ border-color:var(--blue); color:var(--blue); }
.trow-toggle.open{ background:var(--blue); border-color:var(--blue); color:#fff; }
.trow-toggle svg{ transition:transform .15s; }
.trow-toggle.open svg{ transform:rotate(90deg); }
.trow-spacer{ width:20px; flex-shrink:0; }
.trow-icon{ width:26px; height:26px; border-radius:7px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.trow-part{ font-family:ui-monospace,monospace; font-weight:700; font-size:12.5px; color:var(--navy); white-space:nowrap; }
.trow-badge{ font-size:10px; font-weight:700; padding:1px 8px; border-radius:20px; white-space:nowrap; flex-shrink:0; }
.trow-qty{ margin-left:auto; text-align:right; flex-shrink:0; padding-left:12px; }
.trow-qty b{ font-size:12.5px; color:var(--navy); font-variant-numeric:tabular-nums; }
.trow-qty span{ display:block; font-size:10px; color:var(--t3); margin-top:1px; }
.trow-actions{ display:flex; gap:4px; flex-shrink:0; margin-left:10px; }
</style>

<div class="toast-stack" id="toastStack"></div>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2>Master Management</h2>
    </div>
</div>

@await Html.PartialAsync("Master/_MasterManagement")

<!-- ── BOM PROFILES ── -->
<div class="section-card" style="overflow:visible">
    <div class="sc-head">
        <div class="sc-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
            </svg>
            BOM Profiles
            <span id="bomCount" class="count-badge"></span>
        </div>
        <div class="filter-bar">
            <input id="bomSearch" class="filter-input" placeholder="ค้นหา Root Part No…" oninput="renderRootList()">
            <button class="btn-create" onclick="bomOpenNew()">+ New BOM</button>
        </div>
    </div>

    <div class="bom-grid">
        <!-- MASTER (left list — root assemblies only) -->
        <div class="bom-master-panel">
            <div class="root-list" id="rootList"></div>
        </div>

        <!-- DETAIL (right — hierarchy explosion) -->
        <div id="bomDetail" class="bom-detail-panel">
            <div id="bomDetailEmpty" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:var(--t3);gap:12px;min-height:300px">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".4">
                    <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
                <div style="font-size:14px">เลือก Root Assembly จากรายการด้านซ้าย</div>
            </div>

            <div id="bomDetailContent" style="display:none">
                <div class="bom-hero">
                    <div class="hero-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    </div>
                    <div>
                        <div class="hero-part" id="bomDetailPartNo">—</div>
                        <div style="font-size:11.5px;color:var(--t3);margin-top:2px">Version <span id="bomDetailVersion" style="font-weight:700;color:var(--t2)">—</span></div>
                    </div>
                    <div class="hero-stats">
                        <div class="hero-stat"><b id="bomDetailQty">—</b><span>Output Qty</span></div>
                        <div class="hero-stat"><b id="bomDetailCompCount">—</b><span>Direct Parts</span></div>
                        <div class="hero-stat"><b id="bomDetailDepth">—</b><span>Max Depth</span></div>
                    </div>
                    <div style="display:flex;gap:6px">
                        <button class="btn-edit" onclick="bomEditHeader()" style="width:32px;height:32px;padding:0;display:flex;align-items:center;justify-content:center" title="Edit">
                            <i class="bi bi-pencil-square" style="font-size:14px"></i>
                        </button>
                        <button class="btn-edit" onclick="bomDelete(_selectedBomId)" title="Delete"
                            style="width:32px;height:32px;padding:0;display:flex;align-items:center;justify-content:center;color:var(--red);border-color:var(--red);background:#fef2f2">
                            <i class="bi bi-trash3" style="font-size:14px"></i>
                        </button>
                    </div>
                </div>
                <div class="legend">
                    <div class="legend-item"><span class="legend-dot" style="background:#7c3aed"></span>SubAssembly (มีสูตรของตัวเอง — กด expand ได้)</div>
                    <div class="legend-item"><span class="legend-dot" style="background:#1a6fff"></span>Material (วัตถุดิบ — ไม่มีสูตรต่อ)</div>
                </div>
                <div class="tree-wrap"><div id="treeRoot"></div></div>
            </div>
        </div>
    </div>
</div>

<!-- ── BOM DELETE CONFIRM MODAL ── -->
<div class="modal-overlay" id="bomDeleteModal">
    <div class="modal-box" style="max-width:400px">
        <div class="modal-title" style="display:flex;align-items:center;gap:10px">
            <span style="width:34px;height:34px;border-radius:9px;background:#fef2f2;color:var(--red);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <i class="bi bi-trash3" style="font-size:15px"></i>
            </span>
            ยืนยันการลบ BOM Profile
        </div>
        <div style="font-size:13.5px;color:var(--t2);margin:6px 0 20px;line-height:1.65">
            ต้องการลบ BOM Profile <b id="bomDeleteTarget" style="color:var(--navy);font-family:ui-monospace,monospace">—</b> ใช่หรือไม่?<br>
            การลบไม่สามารถย้อนกลับได้ และหากมี BOM อื่นอ้างอิงถึงชิ้นนี้ อาจกระทบต้นไม้ hierarchy ที่เกี่ยวข้อง
        </div>
        <div class="modal-error" id="bomDeleteError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('bomDeleteModal')">ยกเลิก</button>
            <button class="modal-btn modal-btn-primary" style="background:var(--red);border-color:var(--red)" onclick="bomConfirmDelete()">
                <i class="bi bi-trash3" style="font-size:12px;margin-right:6px"></i>ลบ BOM Profile
            </button>
        </div>
    </div>
</div>

<!-- ── QUICK CREATE ITEM MODAL (เด้งขึ้นตอนพิมพ์ Output Part No ที่ยังไม่มีในระบบ) ── -->
<div class="modal-overlay" id="bnQuickItemModal" style="z-index:1100">
    <div class="modal-box" style="max-width:480px">
        <div class="modal-title" style="display:flex;align-items:center;gap:8px">
            <i class="bi bi-plus-circle" style="color:var(--green)"></i> สร้าง Part No ใหม่
        </div>
        <div style="display:flex;gap:14px;align-items:flex-start;margin-bottom:14px">
            <img id="bnQiImgPreview" src="images/no-image.png"
                 style="width:76px;height:76px;object-fit:cover;border-radius:10px;border:1.5px solid var(--border);flex-shrink:0;background:#f8fafc">
            <div style="flex:1;padding-top:2px">
                <label style="display:block;cursor:pointer">
                    <div style="padding:8px 14px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-weight:600;color:var(--t2);text-align:center;background:#fff;transition:.15s"
                         onmouseover="this.style.background='var(--blue-lt)';this.style.color='var(--blue)';this.style.borderColor='var(--blue)'"
                         onmouseout="this.style.background='#fff';this.style.color='var(--t2)';this.style.borderColor='var(--border)'">
                        📁 Upload Image (optional)
                    </div>
                    <input type="file" id="bnQiImageFile" accept="image/*" style="display:none" onchange="bnQiPreviewImage(this)">
                </label>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="modal-field">
                <div class="modal-label">Part No. <span style="color:var(--red)">*</span></div>
                <input class="modal-input" id="bnQiPartNo">
            </div>
            <div class="modal-field">
                <div class="modal-label">Item Type</div>
                <select class="modal-select" id="bnQiItemType"></select>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="modal-field">
                <div class="modal-label">Name <span style="color:var(--red)">*</span></div>
                <input class="modal-input" id="bnQiName">
            </div>
            <div class="modal-field">
                <div class="modal-label">Base Unit</div>
                <input class="modal-input" id="bnQiUnit">
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="modal-field">
                <div class="modal-label">Weight</div>
                <input class="modal-input" id="bnQiWeight" type="number" min="0" step="any" placeholder="0">
            </div>
            <div class="modal-field">
                <div class="modal-label">Weight Unit</div>
                <input class="modal-input" id="bnQiWeightUnit" placeholder="kg, g, ...">
            </div>
        </div>
        <div class="modal-field">
            <div class="modal-label">Description</div>
            <input class="modal-input" id="bnQiDescription">
        </div>
        <div class="modal-error" id="bnQiError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('bnQuickItemModal')">ยกเลิก</button>
            <button class="modal-btn modal-btn-primary" onclick="bnQiSave()">
                <i class="bi bi-check-circle" style="font-size:12px;margin-right:6px"></i>สร้าง Item
            </button>
        </div>
    </div>
</div>

<!-- ── BOM MODAL ── -->
<div class="modal-overlay" id="bomModal">
    <div class="modal-box">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px">
            <div class="modal-title" style="margin-bottom:0">New BOM Profile</div>
            <div class="loc-view-toggle">
                <button class="loc-view-btn active" id="bnBtn_manual" onclick="bnSetMode('manual')">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Manual
                </button>
                <button class="loc-view-btn" id="bnBtn_workorder" onclick="bnSetMode('workorder')">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                    By WorkOrder
                </button>
            </div>
        </div>
        <div id="bnManualFields">
            <div class="modal-field">
                <div class="modal-label">Output Part No. <span style="color:var(--red)">*</span></div>
                <div style="position:relative">
                    <input class="modal-input" id="bomPartNo" autocomplete="off" style="margin-bottom:0"
                           oninput="bnSearchOutputPart(this.value,'bomPartNo','bnOutputPartDd')"
                           onfocus="bnSearchOutputPart(this.value,'bomPartNo','bnOutputPartDd')"
                           onkeydown="if(event.key==='Enter'){event.preventDefault();bnOutputPartEnter();}"
                           onblur="setTimeout(() => document.getElementById('bnOutputPartDd').style.display='none', 200)">
                    <div id="bnOutputPartDd"
                        style="display:none;position:absolute;top:calc(100% + 3px);left:0;right:0;z-index:400;
                               background:#fff;border:1.5px solid var(--blue);border-radius:9px;
                               box-shadow:0 8px 24px rgba(0,0,0,.12);max-height:220px;overflow-y:auto"></div>
                </div>
            </div>
            <div class="modal-field">
                <div class="modal-label">Output Qty</div>
                <input class="modal-input" id="bomQty" type="number" min="0">
            </div>
        </div>
        <div id="bnWoFields" style="display:none">
            <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px">
                <input id="bnWoInput" class="modal-input" placeholder="Work Order No. (e.g. 36225034115)"
                    style="margin-bottom:0;font-family:ui-monospace,monospace;font-size:13px;font-weight:600"
                    onkeydown="if(event.key==='Enter') bnFetchWorkOrder()">
                <button onclick="bnFetchWorkOrder()" class="btn-create" id="bnWoFetchBtn"
                    style="padding:8px 18px;font-size:12px;white-space:nowrap;flex-shrink:0">Fetch</button>
            </div>
            <div id="bnWoPreview" style="display:none;background:#f8fafc;border:1.5px solid var(--border);border-radius:10px;padding:12px 14px">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-size:11px;font-weight:700;color:var(--green)">Work Order Loaded</span>
                </div>
                <div style="display:grid;grid-template-columns:2fr 1fr;gap:8px;margin-bottom:10px">
                    <div>
                        <div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">
                            Output Part No <span style="color:var(--red)">*</span>
                        </div>
                        <div style="position:relative">
                            <input id="bnWoOutputPartNo" class="modal-input" placeholder="Output Part No." autocomplete="off"
                                style="margin-bottom:0;font-family:ui-monospace,monospace;font-size:13px;font-weight:700"
                                oninput="bnSearchOutputPart(this.value,'bnWoOutputPartNo','bnWoOutputPartDd')"
                                onfocus="bnSearchOutputPart(this.value,'bnWoOutputPartNo','bnWoOutputPartDd')"
                                onkeydown="if(event.key==='Enter'){event.preventDefault();bnOutputPartEnter();}"
                                onblur="setTimeout(() => document.getElementById('bnWoOutputPartDd').style.display='none', 200)">
                            <div id="bnWoOutputPartDd"
                                style="display:none;position:absolute;top:calc(100% + 3px);left:0;right:0;z-index:400;
                                       background:#fff;border:1.5px solid var(--blue);border-radius:9px;
                                       box-shadow:0 8px 24px rgba(0,0,0,.12);max-height:220px;overflow-y:auto"></div>
                        </div>
                    </div>
                    <div>
                        <div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">
                            Output Qty <span style="color:var(--red)">*</span>
                        </div>
                        <input id="bnWoOutputQty" class="modal-input" type="number" min="0" step="any" placeholder="0"
                            style="margin-bottom:0;font-size:13px;font-weight:700">
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">MO Number</div><div id="bnWoMo" style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">—</div></div>
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Model</div><div id="bnWoModel" style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--blue)">—</div></div>
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Target Qty</div><div id="bnWoQty" style="font-size:12px;font-weight:700;color:var(--navy)">—</div></div>
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Line</div><div id="bnWoLine" style="font-size:12px;font-weight:600;color:var(--text)">—</div></div>
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Components</div><div id="bnWoItems" style="font-size:12px;font-weight:700;color:var(--text)">—</div></div>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin:14px 0 8px">
                    <span style="font-size:12px;font-weight:700;color:var(--navy)">Item Parts <span id="bnWoSelCount" style="color:var(--blue)"></span></span>
                    <span style="display:flex;gap:10px">
                        <span onclick="bnWoSelectAll(true)" style="font-size:11.5px;font-weight:700;color:var(--blue);cursor:pointer">Select All</span>
                        <span onclick="bnWoSelectAll(false)" style="font-size:11.5px;font-weight:700;color:var(--t2);cursor:pointer">Clear</span>
                    </span>
                </div>
                <div id="bnWoCompList" style="border:1px solid var(--border);border-radius:10px;max-height:220px;overflow-y:auto;background:#fff"></div>
            </div>
        </div>

        <!-- Components — ใช้ร่วมกันทั้ง 2 tab: ติ๊ก Item Parts จาก By WorkOrder หรือค้นหา/เพิ่มเองจาก Manual ก็มาลงที่ list เดียวกันนี้ แก้ Qty ได้ตรงนี้ -->
        <div class="modal-field">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                <span class="modal-label" style="margin-bottom:0">Components</span>
                <span id="bnCompCount" style="font-size:11px;background:var(--blue-lt);color:var(--blue);padding:2px 8px;border-radius:20px;font-weight:700">0</span>
            </div>
            <div id="bnCompList" style="border:1px solid var(--border);border-radius:10px;max-height:160px;overflow-y:auto;margin-bottom:12px;background:var(--card)">
                <div style="padding:16px;text-align:center;color:var(--t3);font-size:13px">No components yet</div>
            </div>
            <div style="background:var(--blue-lt);border:1.5px dashed var(--blue);border-radius:10px;padding:12px 14px">
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                    <div style="flex:1;min-width:160px;position:relative">
                        <input id="bnSearchInput" class="modal-input" placeholder="ค้นหา part no. หรือชื่อ item…"
                            style="margin-bottom:0;padding:8px 12px;font-size:13px"
                            oninput="bnSearchItem(this.value)" autocomplete="off">
                        <div id="bnSearchDd"
                            style="display:none;position:absolute;top:calc(100% + 3px);left:0;right:0;z-index:400;
                                   background:#fff;border:1.5px solid var(--blue);border-radius:9px;
                                   box-shadow:0 8px 24px rgba(0,0,0,.12);max-height:170px;overflow-y:auto"></div>
                        <input type="hidden" id="bnItemId">
                    </div>
                    <input id="bnAddQty" class="modal-input" type="number" min="0.001" step="any" placeholder="Qty"
                        style="width:90px;margin-bottom:0;padding:8px 10px;font-size:13px;font-weight:700;text-align:right">
                    <button type="button" onclick="bnAddComp()" class="btn-create" style="padding:8px 18px;font-size:12px;white-space:nowrap">Add</button>
                </div>
