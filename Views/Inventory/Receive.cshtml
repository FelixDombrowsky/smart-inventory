                updateReceiveBtn();
            }
        });

        // ── Photo capture ──────────────────────────────
        const rcPhoto = createPhotoCapture({ prefix: "rc", maxDimension: 1920 });

        // ── Receive ────────────────────────────────────
        async function receive() {
            const hasItems = document.querySelectorAll("#receivingTable tr").length > 0;
            if (!hasItems || _rxReceiving) return;

            // Validate: Work Order
            if (!currentWO) {
                rxShowError("woSearch", true);
                document.getElementById("woSearch").scrollIntoView({ behavior: "smooth", block: "center" });
                setTimeout(() => document.getElementById("woSearch").focus(), 300);
                toast("กรุณาเลือก Work Order", "err");
                return;
            }

            // Validate: Location
            const locationCode = document.getElementById("locationSearch").value.trim();
            const locationId   = document.getElementById("locationId").value;
            if (!locationCode || !locationId) {
                rxShowError("locationSearch", true);
                document.getElementById("locationSearch").scrollIntoView({ behavior: "smooth", block: "center" });
                setTimeout(() => document.getElementById("locationSearch").focus(), 300);
                toast("กรุณาเลือก Location", "err");
                return;
            }

            // Validate: Items
            const hasValidItem = [...document.querySelectorAll("#receivingTable tr")].some(r => {
                const partNo = r.querySelector("td:first-child")?.textContent?.trim();
                const qty    = parseInt(r.querySelector(".qty")?.value) || 0;
                return partNo && qty > 0;
            });
            if (!hasValidItem) { toast("ไม่มีรายการ", "err"); return; }

            // ครบแล้ว → เปิด modal ถ่ายรูปยืนยัน (ข้ามได้ถ้าติ๊ก Skip Upload Images Validation)
            if (document.getElementById("advSkipImg")?.checked) {
                doReceive();
            } else {
                rcPhoto.open();
            }
        }

        // ── Send (กดจากปุ่ม Send ใน modal ถ่ายรูป) ───────
        async function doReceive() {
            if (_rxReceiving) return;
            _rxReceiving = true;
            updateReceiveBtn();

            const sendBtn = document.getElementById("rcPcSendBtn");
            sendBtn.disabled = true;

            try {
            const locationCode = document.getElementById("locationSearch").value.trim();

            let latitude = 0, longitude = 0, altitude = 0;
            const skipGps = document.getElementById("advSkipGps").checked;
            if (!skipGps) {
                if (!navigator.geolocation) {
                    toast("Browser ไม่รองรับ GPS", "err"); return;
                }
                sendBtn.innerHTML = '<i class="bi bi-geo-alt"></i> Getting GPS…';
                try {
                    const pos = await new Promise((res, rej) =>
                        navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
                    );
                    console.log("GSP : ", pos.coords)
                
                    latitude  = pos.coords.latitude;
                    longitude = pos.coords.longitude;
                    altitude = pos.coords.altitude ?? 0;
                    //toast(`GPS: ${pos.coords.latitude}, ${pos.coords.longitude} , ${pos.coords.altitude}`, "ok")

                    console.log('[Receive] GPS lat:', latitude, 'lng:', longitude, 'Alt:', altitude);
                } catch (e) {
                    toast("GPS error: " + e.message, "err"); return;
                }
            }
            sendBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลัง Receive…';

            const rows  = document.querySelectorAll("#receivingTable tr");
            const items = [];
            rows.forEach(r => {
                const partNo      = r.querySelector("td:first-child")?.textContent?.trim();
                const desc        = r.querySelector(".desc")?.value || "";
                const unit        = r.querySelector(".unit")?.value || "";
                const qty         = parseInt(r.querySelector(".qty")?.value) || 0;
                const traceId     = r.querySelector(".traceId")?.value || "";
                const vendor      = r.querySelector(".rowVendor")?.value || "";
                const dateCode    = r.querySelector(".rowDc")?.value || "";
                const tradingCode = r.querySelector(".rowTc")?.value || "";
                const po          = r.querySelector(".rowPo")?.value || "";
                const inventoryNo = r.querySelector(".rowIn")?.value || "";
                const lotNo       = r.querySelector(".rowLotNo")?.value || "";
                const itemType    = parseInt(r.querySelector(".rowItemType")?.value) || 1;
                if (!partNo || qty <= 0) return;
                items.push({
                    partNo, description: desc,
                    workOrderNo: currentWO || "", locationCode,
                    quantity: qty, unit, traceId,
                    vendor, dateCode, tradingCode, po, inventoryNo,
                    lotNo, itemType, latitude, longitude, zHeigth: altitude
                });
            });

            if (!items.length) { toast("ไม่มีรายการ", "err"); return; }

            const allOptions = getAdvancedOptions();
            const options = Object.fromEntries(Object.entries(allOptions).filter(([, v]) => v));
            console.log("Options : ", options)

            const findRow = traceId => [...document.querySelectorAll("#receivingTable tr")]
                .find(r => r.querySelector(".traceId")?.value === traceId);

            // reset UI ทุกแถวก่อนยิง
            items.forEach(item => {
                const row = findRow(item.traceId);
                if (row) {
                    const errDetail = row.nextElementSibling
                    if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
                    row.classList.remove("row-err", "row-ok"); row.style.pointerEvents = "none"; row.style.opacity = ".5";
                }
            });

            //console.log("Payload : ", items)
            //toast("Payload zHeight: " + items[0].zHeigth, "ok")

            let successCount = 0, failCount = 0;
            try {
                const res  = await apiForm("/inventory/receive", { command: { items }, options }, rcPhoto.getBlobs(), 10000);
                const data = res?.data || [];
                const globalErr = data.find(d => !d.lotNo && !(d.sucess || d.success));

                for (const item of items) {
                    const row      = findRow(item.traceId);
                    const results  = data.filter(d => d.lotNo === item.lotNo);
                    const failures = results.filter(d => !(d.sucess || d.success));

                    if (failures.length) {
                        failCount++;
                        const errMsgs = failures.map(d => [d.errorCode, d.message].filter(Boolean).join(': ') || "Error");
                        toast(`❌ ${item.partNo}: ${errMsgs.join(', ')}`, "err");
                        if (row) showRowError(row, errMsgs);
                    } else {
                        successCount++;
                        if (row) {
                            row.classList.add("row-ok");
                            setTimeout(() => { row.remove(); syncTableState(); }, 600);
                        }
                        scannedTrace.delete(item.traceId);
                    }
                }

                if (globalErr) {
                    toast(`❌ ${[globalErr.errorCode, globalErr.message].filter(Boolean).join(': ')}`, "err");
                }
            } catch (err) {
                failCount = items.length;
                const errMsg = err.message || "Error";
                toast(`❌ ${errMsg}`, "err");
                items.forEach(item => {
                    const row = findRow(item.traceId);
                    if (row) showRowError(row, errMsg);
                });
            }

            if (failCount === 0) {
                toast(`Receive สำเร็จ ${successCount} รายการ ✓`, "ok");
                syncTableState(); syncWODisplay();
            } else if (successCount > 0) {
                toast(`สำเร็จ ${successCount} — ล้มเหลว ${failCount} รายการ`, "warn");
            } else {
                toast(`ล้มเหลว ${failCount} รายการ`, "err");
            }

            } finally {
                _rxReceiving = false;
                updateReceiveBtn();
                sendBtn.innerHTML = "Send";
                rcPhoto.close();
            }
        }

        document.getElementById("rcPcSendBtn").addEventListener("click", doReceive);
        document.getElementById("rcPcCancelBtn").addEventListener("click", () => rcPhoto.close());

        // ── Toast ──────────────────────────────────────
        function toast(msg, type) {
            const wrap = document.getElementById("toastWrap");
            const el   = document.createElement("div");
            const cls  = type === "ok" ? "toast-ok" : type === "warn" ? "toast-warn" : "toast-err";
            el.className = "toast-item " + cls;
            el.textContent = msg;
            wrap.appendChild(el);
            setTimeout(() => el.remove(), type === "warn" ? 5000 : 3000);
        }

    </script>
}
