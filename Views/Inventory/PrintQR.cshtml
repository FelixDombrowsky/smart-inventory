    // ── Printer discovery ──
    async function loadPrinters(showFeedback) {
        const sel = document.getElementById('printerSelect')
        const prevVal = sel.value
        sel.innerHTML = '<option value="">⏳ กำลังค้นหา…</option>'
        try {
            const res = await api('/printer/discover', 'GET')
            const arr = Array.isArray(res) ? res : (res?.data ?? res?.printers ?? [])
            if (arr.length === 0) {
                sel.innerHTML = '<option value="">ไม่พบเครื่องพิมพ์</option>' +
                    '<option value="__test__">🧪 test</option>'
                if (showFeedback) showToast('ไม่พบเครื่องพิมพ์ในเครือข่าย', 'error')
                return
            }
            sel.innerHTML = '<option value="">-- เลือกเครื่องพิมพ์ --</option>' +
                arr.map(p => {
                    const id    = p.id ?? p.ip ?? p.name
                    const label = p.name
                        ? (p.ip ? `${p.name} (${p.ip})` : p.name)
                        : (p.ip ?? String(id))
                    return `<option value="${escHtml(String(id))}">${escHtml(label)}</option>`
                }).join('') +
                '<option value="__test__">🧪 test</option>'
            // Restore previous selection if still available
            if (prevVal && [...sel.options].some(o => o.value === prevVal)) sel.value = prevVal
            if (showFeedback) showToast(`พบ ${arr.length} เครื่องพิมพ์`, 'success')
        } catch (err) {
            sel.innerHTML = '<option value="">โหลดไม่สำเร็จ</option>'
            if (showFeedback) showToast('โหลดเครื่องพิมพ์ไม่สำเร็จ: ' + err.message, 'error')
        }
    }

