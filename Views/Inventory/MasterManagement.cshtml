        document.getElementById('bomVersion').value = ''
        document.getElementById('bomQty').value     = ''
        document.getElementById('bnWoInput').value  = ''
        document.getElementById('bnWoPreview').style.display = 'none'
        if (document.getElementById('bomError')) {
            document.getElementById('bomError').classList.remove('show')
        }
        bnSetMode('manual')
        openModal('bomModal')
    }

    async function saveBom() {
        const isWo = _bnMode === 'workorder'

        let outputPartNo, outputQuantity, components
        if (isWo) {
            if (document.getElementById('bnWoPreview').style.display === 'none') {
                showToast('กรุณา Fetch Work Order ก่อน', 'error'); return
            }
            outputPartNo   = document.getElementById('bnWoModel').textContent
            outputQuantity = parseFloat(document.getElementById('bnWoQty').textContent) || 0
            components     = _bnComponents.map(c => ({ componentItemId: c.componentItemId, quantity: c.quantity }))
        } else {
            outputPartNo   = document.getElementById('bomPartNo').value.trim()
            outputQuantity = parseFloat(document.getElementById('bomQty').value) || 0
            components     = []
            if (!outputPartNo) { showToast('กรุณากรอก Output Part No.', 'error'); return }
        }

        const postBody = { outputPartNo, outputQuantity, components }
        console.log('[saveBom] req body:', postBody)
        try {
            const res = await api('/master/bom-profiles', 'POST', postBody)
            console.log('[saveBom] res:', res)
            showToast('สร้าง BOM Profile สำเร็จ')
            closeModal('bomModal')
            _bomProfilesCache = []
            loadBoms()
        } catch (err) {
            console.error('[saveBom] error:', err)
            showToast('บันทึกไม่สำเร็จ: ' + err.message, 'error')
        }
    }

    function bomEditHeader() {
        const bom = _bomProfilesCache.find(x => x.id === _selectedBomId)
        if (!bom) { showToast('ไม่พบข้อมูล BOM', 'error'); return }
        beOpen(bom)
    }

    // ── BOM Edit Modal (PUT full payload) ────────────────────────────────
    let _beComponents  = []   // [{componentItemId, partNo, quantity}]
    let _beBomId       = null
    let _beSearchTimer = null
    let _beMode        = 'manual'  // 'manual' | 'workorder'

    function beSetMode(mode) {
        _beMode = mode
        document.getElementById('beBtn_manual').classList.toggle('active',    mode === 'manual')
        document.getElementById('beBtn_workorder').classList.toggle('active', mode === 'workorder')
        document.getElementById('beManualFields').style.display = mode === 'manual'    ? 'flex' : 'none'
        document.getElementById('beWoFields').style.display     = mode === 'workorder' ? ''     : 'none'
    }

    async function beFetchWorkOrder() {
        const wo  = document.getElementById('beWoInput').value.trim()
        if (!wo) { showToast('กรุณากรอก Work Order No.', 'error'); return }
        const btn = document.getElementById('beWoFetchBtn')
        btn.disabled = true; btn.textContent = '⏳ Loading…'
        try {
            const res = await api(`/workorder/${encodeURIComponent(wo)}/detail`)
            // Fill header fields (stored internally; beSave() will read from _beWo*)
            document.getElementById('beWoMo').textContent    = res.moNumber    ?? '—'
            document.getElementById('beWoModel').textContent = res.modelName   ?? '—'
            document.getElementById('beWoQty').textContent   = res.targetQty   ?? '—'
            document.getElementById('beWoLine').textContent  = res.lineName    ?? '—'
            document.getElementById('beWoItems').textContent = (res.items?.length ?? 0) + ' items'
            document.getElementById('beWoPreview').style.display = ''

            // Auto-fill components from work order items (skip planQty = 0)
            _beComponents = (res.items || [])
                .filter(it => (it.planQty ?? 0) > 0)
                .map(it => ({
                    componentItemId: it.itemId,
                    partNo:          it.partNo ?? String(it.itemId),
                    quantity:        it.planQty
                }))
            beRenderComps()
            showToast(`โหลด Work Order สำเร็จ — ${_beComponents.length} items`, 'success')
        } catch (err) {
            showToast('ไม่พบ Work Order: ' + err.message, 'error')
            document.getElementById('beWoPreview').style.display = 'none'
        } finally {
            btn.disabled = false; btn.textContent = 'Fetch'
        }
    }

    function beOpen(bom) {
        _beBomId      = bom.id
        _beComponents = (bom.components || []).map(c => ({
            componentItemId: c.componentItemId ?? null,
            partNo:          c.component ?? c.componentPartNo ?? String(c.componentItemId ?? ''),
            quantity:        c.quantity ?? 0
        }))
        document.getElementById('bePartNoChip').textContent     = bom.outputPartNo ?? '—'
        document.getElementById('beQty').value                  = bom.outputQuantity ?? ''
        document.getElementById('beSearchInput').value          = ''
        document.getElementById('beItemId').value               = ''
        document.getElementById('beAddQty').value               = ''
        document.getElementById('beSearchDd').style.display     = 'none'
        document.getElementById('beWoInput').value              = ''
        document.getElementById('beWoPreview').style.display    = 'none'
        beSetMode('manual')
        beRenderComps()
        openModal('bomEditModal')
    }

    function beRenderComps() {
        const list = document.getElementById('beCompList')
        document.getElementById('beCompCount').textContent = _beComponents.length
        if (!_beComponents.length) {
            list.innerHTML = `<div style="padding:24px;text-align:center;color:var(--t3);font-size:13px">No components — add one below</div>`
            return
        }
        list.innerHTML = _beComponents.map((c, i) => `
            <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:${i < _beComponents.length-1 ? '1px solid var(--border)' : 'none'}">
                <span style="font-size:11px;color:var(--t3);width:18px;flex-shrink:0;text-align:right">${i+1}</span>
                <span style="flex:1;font-family:ui-monospace,monospace;font-size:13px;font-weight:600;color:var(--navy);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                      title="${locEsc(c.partNo)}">${locEsc(c.partNo)}</span>
                <input type="number" min="0.001" step="any" value="${c.quantity}"
                    oninput="_beComponents[${i}].quantity = parseFloat(this.value)||0; beUpdateCount()"
                    style="width:78px;padding:5px 8px;border:1.5px solid var(--border);border-radius:7px;
                           font-size:13px;font-weight:700;text-align:right;font-family:inherit;outline:none;
                           color:var(--blue);background:#fff"
                    onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor='var(--border)'">
                <button onclick="beRemoveComp(${i})"
                    style="width:26px;height:26px;flex-shrink:0;border:1.5px solid #fca5a5;border-radius:6px;
                           background:#fef2f2;color:var(--red);cursor:pointer;
                           display:flex;align-items:center;justify-content:center;padding:0">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2"/>
                    </svg>
                </button>
            </div>`).join('')
    }

    function beUpdateCount() {
        document.getElementById('beCompCount').textContent = _beComponents.length
    }

    function beRemoveComp(idx) {
        _beComponents.splice(idx, 1)
        beRenderComps()
    }

    function beSearchItem(q) {
        const dd = document.getElementById('beSearchDd')
        clearTimeout(_beSearchTimer)
        document.getElementById('beItemId').value = ''
        if (!q.trim()) { dd.style.display = 'none'; return }
        dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">Searching…</div>`
        dd.style.display = 'block'
        _beSearchTimer = setTimeout(async () => {
            try {
                const res   = await api(`/master/items?search=${encodeURIComponent(q)}&page=1&pageSize=15`)
                const items = Array.isArray(res) ? res : (res?.data || [])
                dd.innerHTML = items.length === 0
                    ? `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">No items found</div>`
                    : items.map(it => `
                        <div onclick="bePickItem(${it.id},'${escJs(it.itemPartNo??'')}','${escJs(it.description??'')}')"
                            style="padding:9px 14px;font-size:13px;cursor:pointer;
                                   border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px"
                            onmouseover="this.style.background='var(--blue-lt)'"
                            onmouseout="this.style.background=''">
                            <span style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">${escHtml(it.itemPartNo??'')}</span>
                            <span style="color:var(--t2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(it.description??'')}</span>
                        </div>`).join('')
            } catch {
                dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--red)">Load failed</div>`
            }
        }, 280)
    }

    function bePickItem(id, partNo, desc) {
        document.getElementById('beSearchInput').value  = `${partNo}${desc ? ' — ' + desc : ''}`
        document.getElementById('beItemId').value       = id
        document.getElementById('beSearchDd').style.display = 'none'
        document.getElementById('beAddQty').focus()
    }

    function beAddComp() {
        const itemId = parseInt(document.getElementById('beItemId').value)
        const qty    = parseFloat(document.getElementById('beAddQty').value)
        const label  = document.getElementById('beSearchInput').value.trim()
        if (!itemId) { showToast('กรุณาเลือก item จาก dropdown', 'error'); return }
        if (!qty || qty <= 0) { showToast('กรุณากรอก Quantity', 'error'); return }
        if (_beComponents.find(c => c.componentItemId === itemId)) {
            showToast('Item นี้มีอยู่แล้วใน BOM', 'error'); return
        }
        const partNo = label.split(' — ')[0].trim()
        _beComponents.push({ componentItemId: itemId, partNo, quantity: qty })
        beRenderComps()
        document.getElementById('beSearchInput').value      = ''
        document.getElementById('beItemId').value           = ''
        document.getElementById('beAddQty').value           = ''
        document.getElementById('beSearchDd').style.display = 'none'
        document.getElementById('beSearchInput').focus()
    }

    async function beSave() {
        const isWo       = _beMode === 'workorder'
        const outputPartNo   = isWo
            ? document.getElementById('beWoModel').textContent
            : document.getElementById('bePartNoChip').textContent
        const outputQuantity = isWo
            ? parseFloat(document.getElementById('beWoQty').textContent) || 0
            : parseFloat(document.getElementById('beQty').value) || 0
        if (isWo && document.getElementById('beWoPreview').style.display === 'none') {
            showToast('กรุณา Fetch Work Order ก่อน', 'error'); return
        }
        const body = {
            outputPartNo,
            outputQuantity,
            components: _beComponents.map(c => ({ componentItemId: c.componentItemId, quantity: c.quantity }))
        }
        try {
            await api(`/master/bom-profiles/${_beBomId}`, 'PUT', body)
            showToast('อัปเดต BOM Profile สำเร็จ')
            closeModal('bomEditModal')
            _bomProfilesCache = []
            loadBoms()
            bomLoadDetail(_beBomId)
        } catch (err) {
            showToast('บันทึกไม่สำเร็จ: ' + err.message, 'error')
        }
    }
