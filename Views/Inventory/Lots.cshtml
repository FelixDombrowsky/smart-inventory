@{
    ViewData["Title"] = "Lots";
}

<link rel="stylesheet" href="css/lots.css"/>

<!-- TOAST CONTAINER -->
<div class="toast-stack" id="toastStack"></div>

<!-- VOID MODAL -->
<div class="modal-overlay" id="voidModal">
    <div class="modal-box">
        @* <div class="modal-icon" style="background:var(--red-lt)">🗑️</div> *@
        @* <div class="modal-title">Void Lot</div> *@
        <div class="modal-lot">Lot No. &nbsp;<span id="voidLotNo">—</span></div>
        <div class="modal-field">
            <div class="modal-label"><span data-i18n="reasonForVoid">Reason for Void</span> <span style="color:var(--red)">*</span></div>
            <textarea class="modal-textarea" id="voidReason" placeholder="Enter reason..." data-i18n-placeholder="reasonPlaceholder"></textarea>
        </div>
        <div class="modal-error" id="voidError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="closeModal('voidModal')">Cancel</button>
            <button class="modal-btn modal-btn-red" data-i18n="voidLotTitle" onclick="confirmVoid()">Void Lot</button>
        </div>
    </div>
</div>

<!-- ADJUST MODAL -->
<div class="modal-overlay" id="adjustModal">
    <div class="modal-box">
        @* <div class="modal-icon" style="background:var(--amber-lt)">⚖️</div> *@
        @* <div class="modal-title">Adjust Lot</div> *@
        <div class="modal-lot">Lot No. &nbsp;<span id="adjustLotNo">—</span></div>
        <div class="modal-info-row">
            <span data-i18n="currentOnHand">Current On Hand</span>
            <strong id="adjustCurrentQty">—</strong>
        </div>
        <div class="modal-field">
            <div class="modal-label"><span data-i18n="newQuantity">New Quantity</span> <span style="color:var(--red)">*</span></div>
            <input class="modal-input" id="adjustNewQty" type="number" min="0" placeholder="0">
        </div>
        <div class="modal-error" id="adjustError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="closeModal('adjustModal')">Cancel</button>
            <button class="modal-btn modal-btn-amber" data-i18n="adjust" onclick="confirmAdjust()">Adjust</button>
        </div>
    </div>
</div>

<!-- EXPORT CONFIRM MODAL -->
<div class="modal-overlay" id="exportConfirmModal">
    <div class="modal-box">
        <div class="modal-title" data-i18n="exportConfirmTitle">Export to Excel</div>
        <div class="modal-lot" data-i18n="exportConfirmSub">This will export every lot matching your current filters.</div>
        <div class="modal-info-row">
            <span data-i18n="exportRowCount">Rows to export</span>
            <strong id="exportRowCountVal">—</strong>
        </div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="closeModal('exportConfirmModal')">Cancel</button>
            <button class="modal-btn modal-btn-green" data-i18n="exportExcel" onclick="confirmExportLots()">Export Excel</button>
        </div>
    </div>
</div>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2 data-i18n="pageTitle">Inventory Lots</h2>
    </div>
    <div class="total-pill">
        <div class="total-num" id="lotsTotal">—</div>
        <div class="total-lbl" data-i18n="totalLots">Total Lots</div>
    </div>
</div>

<!-- TABLE SECTION -->
<div class="section-card">
    <div class="sc-head">
        <div class="sc-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
            </svg>
            <span data-i18n="lots">Lots</span>
        </div>
        <div class="filter-bar">
            <input id="filterPartNo"   class="filter-input" placeholder="Part No." data-i18n-placeholder="partNoPlaceholder"
                   oninput="lotsDebouncedSearch()">
            <input id="filterWO"       class="filter-input" placeholder="Work Order" data-i18n-placeholder="woPlaceholder"
                   oninput="lotsDebouncedSearch()">
            <input id="filterLotNo" class="filter-input" placeholder="Lot No." data-i18n-placeholder="lotNoPlaceholder"
                   oninput="lotsDebouncedSearch()">
            <input id="filterLine"     class="filter-input" placeholder="Line" data-i18n-placeholder="linePlaceholder" style="width:110px"
                   oninput="lotsDebouncedSearch()">
            <label class="avail-toggle">
                <input type="checkbox" id="filterAvailable" checked onchange="searchLots()">
                <span data-i18n="available">Available</span>
            </label>
            <div class="loc-filter-dd-wrap">
                <div class="loc-filter-dd-trigger" id="filterLocationTypeTrigger" tabindex="0" onclick="toggleFilterDd('filterLocationTypeTrigger','filterLocationTypeMenu')">
                    <span id="filterLocationTypeLabel">All Locations</span>
                    <i class="bi bi-chevron-down" style="font-size:11px;margin-left:auto;color:var(--t2)"></i>
                </div>
                <div class="loc-filter-dd-menu" id="filterLocationTypeMenu" style="display:none">
                    <div class="loc-filter-dd-item active" data-val="" data-i18n="allLocations" onclick="filterLocationTypeDdPick('', 'All Locations')">All Locations</div>
                </div>
                <input type="hidden" id="filterLocationType" value="">
            </div>
            <div class="loc-filter-dd-wrap">
                <div class="loc-filter-dd-trigger" id="filterLotStatusTrigger" tabindex="0" onclick="toggleFilterDd('filterLotStatusTrigger','filterLotStatusMenu')">
                    <span id="filterLotStatusLabel">All Status</span>
                    <i class="bi bi-chevron-down" style="font-size:11px;margin-left:auto;color:var(--t2)"></i>
                </div>
                <div class="loc-filter-dd-menu" id="filterLotStatusMenu" style="display:none">
                    <div class="loc-filter-dd-item active" data-val="" data-i18n="allStatus" onclick="filterLotStatusDdPick('', 'All Status')">All Status</div>
                </div>
                <input type="hidden" id="filterLotStatus" value="">
            </div>
            <div class="loc-filter-dd-wrap">
                <div class="loc-filter-dd-trigger" id="filterItemTypeTrigger" tabindex="0" onclick="toggleFilterDd('filterItemTypeTrigger','filterItemTypeMenu')">
                    <span id="filterItemTypeLabel">All Item Types</span>
                    <i class="bi bi-chevron-down" style="font-size:11px;margin-left:auto;color:var(--t2)"></i>
                </div>
                <div class="loc-filter-dd-menu" id="filterItemTypeMenu" style="display:none">
                    <div class="loc-filter-dd-item active" data-val="" data-i18n="allItemTypes" onclick="filterItemTypeDdPick('')">All Item Types</div>
                </div>
                <input type="hidden" id="filterItemType" value="">
            </div>
            <partial name="_DateRangePicker" model="@("lot")" />
            <button type="button" class="btn-export" id="btnExportExcel" onclick="openExportConfirm()" title="Export Excel" data-i18n-title="exportExcel">
                <i class="bi bi-file-earmark-excel"></i>
            </button>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table class="inv-table">
            <thead>
                <tr>
                    <th id="th-LotNo"       data-i18n="colLotNo"       onclick="sort('LotNo')">Lot No.</th>
                    <th id="th-PartNo"      data-i18n="colPartNo"      onclick="sort('PartNo')">Part No.</th>
                    <th class="no-sort"     data-i18n="colDescription">Description</th>
                    <th id="th-WorkOrder"   data-i18n-title="colWorkOrder" title="Work Order" onclick="sort('WorkOrder')">W/O</th>
                    <th id="th-LineName"    data-i18n="colLine"        onclick="sort('LineName')">Line</th>
                    <th id="th-Location"    data-i18n="colLocation"    onclick="sort('Location')">Location</th>
                    <th id="th-Status"      data-i18n="colStatus">Status</th>
                    <th id="th-OnHandQty" data-i18n-title="colOnHand" title="On Hand" onclick="sort('OnHandQty')">OH</th>
                    <th id="th-ReservedQty" data-i18n-title="colReserved" title="Reserved" onclick="sort('ReservedQty')">RS</th>
                    <th id="th-ConsumedQty" data-i18n-title="colConsumed" title="Consumed" onclick="sort('ConsumedQty')">CS</th>
                    <th id="th-Available" data-i18n-title="colAvailable" title="Available" onclick="sort('Available')" class="sort-desc">AV</th>
                    <th id="th-CreatedAt"data-i18n="colCreatedAt"   onclick="sort('CreatedAt')">Created At</th>
                    <th id="th-LocationEnteredAt" data-i18n-title="colLocationEnteredAt" title="Location Entered At" onclick="sort('LocationEnteredAt')">Loc Enter</th>
                    <th id="th-ProductionDeadlineAt" data-i18n-title="colProductionDeadlineAt" title="Production Deadline At" onclick="sort('ProductionDeadlineAt')">PD Deadline</th>
                    <th class="no-sort" data-i18n-title="colLate" title="Late By">Late</th>
                    <th class="no-sort" style="text-align:center" data-i18n="colAction">Action</th>
                </tr>
            </thead>
            <tbody id="lotTable"></tbody>
        </table>
    </div>

    <div class="pag-bar">
        <div style="display:flex;align-items:center;gap:10px">
            <select class="pag-size" id="pageSize" onchange="changePageSize()">
                <option value="10">10 rows</option>
                <option value="20" selected>20 rows</option>
                <option value="50">50 rows</option>
                <option value="100">100 rows</option>
            </select>
            <span class="pag-info"><span data-i18n="showingPage">Showing page</span> <span id="pageInfo">—</span></span>
        </div>
        <div class="pag-btns">
            <button id="btnPrev" class="pag-btn" onclick="prevPage()">← <span data-i18n="prev">Prev</span></button>
            <span class="pag-page" id="pageNum">—</span>
            <button id="btnNext" class="pag-btn" onclick="nextPage()"><span data-i18n="next">Next</span> →</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/locationTypeMeta.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/lotStatusTypeMeta.js"></script>
<script src="js/itemTypeMeta.js"></script>
<script src="js/dateRangePicker.js"></script>
<script>
    let page = 1, totalPages = 1
    let sortBy = "CreatedAt", desc = true
    let canAdjust = false
    let canVoid   = false
    let canExportExcel = false
    let _lastTotalLot = 0   // totalLot ล่าสุดจาก loadLots() — ใช้โชว์ preview จำนวนแถวใน modal ยืนยัน Export (กันกดพลาด)

    // คำแปลของหน้านี้ (LOTS_LABELS มาจาก js/i18n.js) — เรียก lotsDict() สดทุกจุดที่สร้างข้อความแทน hardcode
    function lotsDict() { return LOTS_LABELS[getCurrentLang()] || LOTS_LABELS.en }

    // รูปแบบสากล ISO 8601-ish (YYYY-MM-DD HH:mm) — เลี่ยง locale th-TH เพราะได้ปี พ.ศ. ที่สับสนตอนสื่อสารข้ามระบบ/ประเทศ (เหมือน LotDetail.cshtml)
    // PD Deadline = สีแดง เมื่อ Late:
    //  - อยู่ใน Location type Production แล้ว → Late ถ้า Loc Enter เลย PD Deadline (เข้าช้ากว่ากำหนด)
    //  - ยังไม่อยู่ใน Production → Late ถ้าเวลาปัจจุบันเลย PD Deadline แล้ว
    // คืนจำนวน ms ที่ Late (0 = ไม่ Late)
    function lateMs(x) {
        if (!x.productionDeadlineAt) return 0
        const deadline = new Date(x.productionDeadlineAt).getTime()
        if (isNaN(deadline)) return 0
        const inProduction = (_locNameMap.get(x.location)?.typeName || '').toLowerCase() === 'production'
        let ref = Date.now()
        if (inProduction) {
            ref = x.locationEnteredAt ? new Date(x.locationEnteredAt).getTime() : NaN
            if (isNaN(ref)) return 0
        }
        return ref > deadline ? ref - deadline : 0
    }
    function isLocEnterLate(x) { return lateMs(x) > 0 }

    // "3d 4h 25m" — วัน/ชั่วโมง/นาที (ข้ามหน่วยที่เป็น 0 ด้านหน้า)
    function fmtLate(ms) {
        const mins = Math.max(1, Math.floor(ms / 60000))
        const d = Math.floor(mins / 1440), h = Math.floor((mins % 1440) / 60), m = mins % 60
        return d ? `${d}d ${h}h ${m}m` : h ? `${h}h ${m}m` : `${m}m`
    }

    // Part No. + badge Item Type — ถ้า /inventory/lots ไม่ส่ง itemType มา จะ fallback ไปดึงจาก /master/items/{partNo} (cache ต่อ partNo)
    const _escHtml = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
    let _partTypeCache = {}   // partNo → item type name ('' = ไม่มี type)
    function partNoBadge(partNo, itemType) {
        const label = _escHtml(partNo || '')
        const type  = itemType || _partTypeCache[partNo]
        if (!type) return `<span style="font-weight:600;color:var(--navy)">${label}</span>`
        return `<span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:700;padding:2px 9px;border-radius:6px;font-family:ui-monospace,monospace;${itemTypeBadgeStyle(type)}" title="${_escHtml(String(type))}">${itemTypeIcon(type)}${label}</span>`
    }
    async function loadPartTypes(rows) {
        const need = [...new Set(rows.filter(x => x.partNo && !(x.itemTypeName ?? x.itemType) && !(x.partNo in _partTypeCache)).map(x => x.partNo))]
        await Promise.all(need.map(async p => {
            try {
                const item = await api(`/master/items/${encodeURIComponent(p)}`, 'GET')
                _partTypeCache[p] = String(item?.itemTypeName ?? item?.itemType ?? '')
            } catch { _partTypeCache[p] = '' }
            document.querySelectorAll('#lotTable td.lot-part-cell').forEach(td => {
                if (td.dataset.part === p) td.innerHTML = partNoBadge(p)
            })
        }))
    }

    function fmtDate(d) {
        if (!d) return "—"
        const dt  = new Date(d)
        const pad = n => String(n).padStart(2, "0")
        return `${pad(dt.getDate())}/${pad(dt.getMonth() + 1)}/${dt.getFullYear()} ${pad(dt.getHours())}:${pad(dt.getMinutes())}`
    }

    // badge ชื่อ Location พร้อม icon+สีตาม type (join เอา type จาก _locNameMap เหมือนหน้า WorkOrderLots/Printers)
    function locBadgeForCode(code) {
        if (!code) return '—'
        const loc = _locNameMap.get(code)
        const name = loc?.displayName || code
        const type = loc?.typeName || ''
        if (!type) return name
        return `<span style="font-size:11px;font-weight:700;padding:2px 9px;border-radius:20px;${locTypeBadgeStyle(type)};white-space:nowrap;display:inline-flex;align-items:center;gap:5px">${locHierTypeIcon(type)}${name}</span>`
    }

    async function loadLocationTypes() {
        try {
            const types = await api('/location/types', 'GET')
            const arr = Array.isArray(types) ? types : (types?.data ?? [])
            const menu = document.getElementById('filterLocationTypeMenu')
            menu.innerHTML = `<div class="loc-filter-dd-item active" data-val="" data-i18n="allLocations" onclick="filterLocationTypeDdPick('', 'All Locations')">${lotsDict().allLocations}</div>` +
                arr.map(t => {
                    const label = t.displayName ?? t.name
                    return `<div class="loc-filter-dd-item" data-val="${t.name}" onclick="filterLocationTypeDdPick('${t.name}', '${label}')">
                        ${locHierTypeIcon(label)} <span style="color:${locTypeMeta(label).color};font-weight:600">${label}</span>
                    </div>`
                }).join('')
        } catch (err) {
            console.error('loadLocationTypes:', err)
        }
    }

    // ── Custom filter dropdowns (Location Type / Lot Status) — trigger+menu ใช้ CSS .loc-filter-dd-* ร่วมกัน ──
    const _FILTER_DD_IDS = [
        { trigger: 'filterLocationTypeTrigger', menu: 'filterLocationTypeMenu' },
        { trigger: 'filterLotStatusTrigger',    menu: 'filterLotStatusMenu' },
        { trigger: 'filterItemTypeTrigger',     menu: 'filterItemTypeMenu' },
    ]
    function closeAllFilterDd() {
        _FILTER_DD_IDS.forEach(({ trigger, menu }) => {
            const menuEl = document.getElementById(menu)
            const trgEl  = document.getElementById(trigger)
            if (menuEl) menuEl.style.display = 'none'
            if (trgEl)  trgEl.classList.remove('open')
        })
    }
    function toggleFilterDd(triggerId, menuId) {
        const menu    = document.getElementById(menuId)
        const trigger = document.getElementById(triggerId)
        const opening = menu.style.display === 'none'
        closeAllFilterDd()
        if (opening) {
            const r = trigger.getBoundingClientRect()
            menu.style.left     = r.left + 'px'
            menu.style.top      = (r.bottom + 4) + 'px'
            menu.style.minWidth = r.width + 'px'
            menu.style.display  = ''
            trigger.classList.add('open')
        }
    }
    window.addEventListener('scroll', e => {
        _FILTER_DD_IDS.forEach(({ menu }) => {
            const el = document.getElementById(menu)
            if (el && el.style.display !== 'none' && !el.contains(e.target)) el.style.display = 'none'
        })
    }, true)
    window.addEventListener('resize', closeAllFilterDd)
    document.addEventListener('click', e => {
        if (!e.target.closest('.loc-filter-dd-wrap')) closeAllFilterDd()
    })

    function filterLocationTypeDdPick(val, label) {
        document.getElementById('filterLocationType').value = val
        document.getElementById('filterLocationTypeLabel').innerHTML = val
            ? `${locHierTypeIcon(label)} <span style="color:${locTypeMeta(label).color};font-weight:600">${label}</span>`
            : lotsDict().allLocations
        document.querySelectorAll('#filterLocationTypeMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        closeAllFilterDd()
        searchLots()
    }

    // ── Lot Status filter dropdown (รายชื่อ status ดึงจาก API, icon+color จาก lotStatusTypeMeta.js) ──
    async function loadLotStatusOptions() {
        try {
            const res  = await api('/inventory/lot/status-type', 'GET')
            const arr  = Array.isArray(res) ? res : (res?.data ?? [])
            const menu = document.getElementById('filterLotStatusMenu')
            menu.innerHTML = `<div class="loc-filter-dd-item active" data-val="" data-i18n="allStatus" onclick="filterLotStatusDdPick('', 'All Status')">${lotsDict().allStatus}</div>` +
                arr.map(s => {
                    const name = s.name
                    return `<div class="loc-filter-dd-item" data-val="${name}" onclick="filterLotStatusDdPick('${name}', '${name}')">
                        ${lotStatusIcon(name)} <span style="color:${lotStatusMeta(name).color};font-weight:600">${name}</span>
                    </div>`
                }).join('')
        } catch (err) {
            console.error('loadLotStatusOptions:', err)
        }
    }
    function filterLotStatusDdPick(val, label) {
        document.getElementById('filterLotStatus').value = val
        document.getElementById('filterLotStatusLabel').innerHTML = val
            ? `${lotStatusIcon(val)} <span style="color:${lotStatusMeta(val).color};font-weight:600">${label}</span>`
            : lotsDict().allStatus
        document.querySelectorAll('#filterLotStatusMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        closeAllFilterDd()
        searchLots()
    }

    // ── Item Type filter dropdown (รายชื่อ type ดึงจาก /master/items/item-type, icon+color จาก itemTypeMeta.js) ──
    async function loadItemTypeOptions() {
        try {
            const res  = await api('/master/items/item-type', 'GET')
            const arr  = (Array.isArray(res) ? res : (res?.data ?? [])).map(t => t.name || t).filter(Boolean)
            const menu = document.getElementById('filterItemTypeMenu')
            menu.innerHTML = `<div class="loc-filter-dd-item active" data-val="" data-i18n="allItemTypes" onclick="filterItemTypeDdPick('')">${lotsDict().allItemTypes}</div>` +
                arr.map(name => `<div class="loc-filter-dd-item" data-val="${name}" onclick="filterItemTypeDdPick('${name}')">
                        ${itemTypeIcon(name)} <span style="color:${itemTypeMeta(name).color};font-weight:600">${name}</span>
                    </div>`).join('')
        } catch (err) {
            console.error('loadItemTypeOptions:', err)
        }
    }
    function filterItemTypeDdPick(val) {
        document.getElementById('filterItemType').value = val
        document.getElementById('filterItemTypeLabel').innerHTML = val
            ? `${itemTypeIcon(val)} <span style="color:${itemTypeMeta(val).color};font-weight:600">${val}</span>`
            : lotsDict().allItemTypes
        document.querySelectorAll('#filterItemTypeMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        closeAllFilterDd()
        searchLots()
    }

    // ── Date Range Picker (Created At) — component ใช้ร่วมกับหน้าอื่นได้ ดู dateRangePicker.js ──
    const lotDateRange = createDateRangePicker({ prefix: 'lot', onApply: () => searchLots() })

    function updateSortHeaders() {
        document.querySelectorAll('.inv-table th[id^="th-"]').forEach(th => {
            th.classList.remove('sort-asc', 'sort-desc')
            if (th.id === 'th-' + sortBy)
                th.classList.add(desc ? 'sort-desc' : 'sort-asc')
        })
    }

    // อ่าน filter ปัจจุบันทั้งหมดจากหน้าจอ ใช้ร่วมกันทั้ง loadLots() (โหลดทีละหน้า) และ exportLotsToExcel() (โหลดทุกหน้า) —
    // กัน logic การอ่าน filter เพี้ยนไม่ตรงกันระหว่าง 2 จุด (page/pageSize/sortBy/desc ไม่รวมอยู่ในนี้ ผู้เรียกใส่เองทีหลัง)
    function _buildLotsFilterBody() {
        const partNo      = document.getElementById("filterPartNo").value.trim()
        const workOrder   = document.getElementById("filterWO").value.trim()
        const lotNo       = document.getElementById("filterLotNo").value.trim()
        const line        = document.getElementById("filterLine").value.trim()
        const availableOnly = document.getElementById("filterAvailable").checked
        const locationType = document.getElementById("filterLocationType").value
        const lotStatus    = document.getElementById("filterLotStatus").value
        const itemType     = document.getElementById("filterItemType").value
        const createdAfter  = lotDateRange.getFrom()
        const createdBefore = lotDateRange.getTo()

        const body = {}
        if (partNo)       body.partNo       = partNo
        if (workOrder)    body.workOrder    = workOrder
        if (lotNo)        body.lotNo        = lotNo
        if (line)         body.line         = line
        if (locationType) body.locationType = locationType
        if (availableOnly) body.availableOnly = true
        if (lotStatus)      body.lotStatus      = lotStatus
        if (itemType)       body.itemType       = itemType
        if (createdAfter)   body.createdAfter   = new Date(createdAfter  + 'T00:00:00').toISOString()
        if (createdBefore)  body.createdBefore  = new Date(createdBefore + 'T23:59:59.999').toISOString()
        return body
    }

    async function loadLots() {
        const pageSize = parseInt(document.getElementById("pageSize").value)
        const body = { ..._buildLotsFilterBody(), page, pageSize, sortBy, desc }

        try {
            const json = await api("/inventory/lots", "POST", body)
            const list = json.data || []

            _lastTotalLot = json.totalLot ?? 0
            document.getElementById("lotsTotal").textContent = _lastTotalLot.toLocaleString()

            const html = list.map(x => {
                const av = x.available ?? 0
                const onHand = x.onHandQty ?? 0
                const pct = onHand > 0 ? (av / onHand * 100) : 0
                const avCls = pct >= 30 ? 'num-ok' : 'num-bad'
                return `<tr>
                    <td><a href="Inventory/LotDetail?lot=${encodeURIComponent(x.lotNo ?? '')}" class="mono" style="text-decoration:none;color:var(--blue)">${x.lotNo ?? ""}</a></td>
                    <td class="lot-part-cell" data-part="${x.partNo ?? ""}">${partNoBadge(x.partNo, x.itemTypeName ?? x.itemType)}</td>
                    <td><div class="lot-desc-cell" title="${String(x.description ?? "").replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;")}">${x.description ?? "—"}</div></td>
                    <td style="color:var(--t2);font-size:12px">${x.workOrder ?? "—"}</td>
                    <td><span style="background:#f0f2f5;color:#475569;padding:2px 8px;border-radius:5px;font-size:11px;font-weight:600">${x.lineName ?? "—"}</span></td>
                    <td>${locBadgeForCode(x.location)}</td>
                    <td>${lotStatusBadge(x.status)}</td>
                    <td style="font-weight:600">${(x.onHandQty ?? 0).toLocaleString()}</td>
                    <td style="color:var(--amber);font-weight:600">${(x.reservedQty ?? 0).toLocaleString()}</td>
                    <td style="color:var(--t2)">${(x.consumedQty ?? 0).toLocaleString()}</td>
                    <td class="${avCls}">${av.toLocaleString()}</td>
                    <td style="color:var(--t2);font-size:12px;white-space:nowrap">${fmtDate(x.createdAt)}</td>
                    <td style="color:var(--t2);font-size:12px;white-space:nowrap">${x.locationEnteredAt ? fmtDate(x.locationEnteredAt) : "—"}</td>
                    <td style="${isLocEnterLate(x) ? 'color:var(--red);font-weight:700' : 'color:var(--t2)'};font-size:12px;white-space:nowrap">${x.productionDeadlineAt ? fmtDate(x.productionDeadlineAt) : "—"}</td>
                    ${(() => { const ms = lateMs(x); return ms > 0
                        ? `<td style="color:var(--red);font-weight:700;font-size:12px;white-space:nowrap">${fmtLate(ms)}</td>`
                        : `<td style="color:var(--t3);font-size:12px">—</td>` })()}
                    <td style="text-align:center">
                        <button type="button" class="btn-action-menu" onclick="toggleLotActionMenu(event, '${x.lotNo}', ${x.onHandQty ?? 0}, ${x.isVoided === true || x.status?.toLowerCase() === 'void' || x.status?.toLowerCase() === 'voided'})" title="${lotsDict().colAction}">
                            <i class="bi bi-three-dots"></i>
                        </button>
                    </td>
                </tr>`
            }).join("")

            document.getElementById("lotTable").innerHTML = html ||
                `<tr><td colspan="16" style="text-align:center;color:var(--t3);padding:32px">${lotsDict().noLotsFound}</td></tr>`

            totalPages = json.totalPages || Math.ceil((json.totalLot || 0) / pageSize) || 1
            document.getElementById("pageInfo").textContent = `${json.page} / ${totalPages}`
            document.getElementById("pageNum").textContent  = json.page
            document.getElementById("btnPrev").disabled = (page <= 1)
            document.getElementById("btnNext").disabled = (page >= totalPages)

            updateSortHeaders()
            loadPartTypes(list)   // ไม่ await — ดึง Item Type ของ part ที่ API ไม่ส่งมา แล้ว patch badge ทีหลัง

        } catch (err) {
            console.error(err)
            document.getElementById("lotTable").innerHTML =
                `<tr><td colspan="16" style="text-align:center;color:var(--red);padding:32px">${lotsDict().loadFailed}: ${err.message}</td></tr>`
        }
    }

    // Export Excel — ดึง Lot "ทุกแถวที่ตรงกับ filter ปัจจุบัน" (ไม่ใช่แค่หน้าที่กำลังโชว์อยู่) มาเป็นไฟล์เดียว ใช้ filter
    // เดียวกับ loadLots() ทุกอย่าง (_buildLotsFilterBody) ต่างกันแค่ page/pageSize — โหลดหน้าแรกก่อนเพื่อรู้ totalLot แล้ว
    // ค่อยยิงหน้าที่เหลือพร้อมกันทีเดียว (เหมือน pattern _fetchPrintHistoriesForWo ใน WorkOrderLots.cshtml) กัน pageSize
    // เดียวใหญ่เกินไปจนช้า/timeout ถ้า Lot มีเยอะมาก
    async function _fetchAllLotsForExport() {
        const EXPORT_PAGE_SIZE = 500
        const filterBody = _buildLotsFilterBody()
        const qs = p => ({ ...filterBody, page: p, pageSize: EXPORT_PAGE_SIZE, sortBy, desc })

        const first = await api("/inventory/lots", "POST", qs(1))
        let all     = first?.data || []
        const total = first?.totalLot ?? all.length
        const pages = Math.ceil(total / EXPORT_PAGE_SIZE) || 1
        if (pages > 1) {
            const rest = await Promise.all(
                Array.from({ length: pages - 1 }, (_, i) => api("/inventory/lots", "POST", qs(i + 2)))
            )
            rest.forEach(r => { all = all.concat(r?.data || []) })
        }
        return all
    }

    // แปลงค่าหนึ่ง field ให้ปลอดภัยกับ CSV — ตัวเลข (On Hand/Reserved/Consumed/Available) ปล่อยไม่ครอบ "" เพื่อให้ Excel
    // มองเป็นตัวเลขจริง (sum/sort ได้) ส่วนข้อความครอบด้วย "" เสมอ (กัน comma/newline เช่น Description) พร้อม escape
    // เครื่องหมาย " ที่อยู่ข้างในด้วยการเพิ่มเป็น "" ตามสเปก CSV มาตรฐาน
    function _csvCell(v) {
        if (typeof v === "number") return String(v)
        return `"${String(v ?? "").replace(/"/g, '""')}"`
    }

    // เด้ง modal ให้ preview จำนวนแถวก่อน Export จริง กันมือลั่นกดโดนปุ่ม Export เฉยๆ (ไอคอนเดียว ไม่มีข้อความ อาจกดพลาดง่าย)
    function openExportConfirm() {
        if (!canExportExcel) { alert("You don't have permission please contact admin"); return }
        document.getElementById("exportRowCountVal").textContent = _lastTotalLot.toLocaleString()
        openModal("exportConfirmModal")
    }
    function confirmExportLots() {
        closeModal("exportConfirmModal")
        exportLotsToExcel()
    }

    async function exportLotsToExcel() {
        const btn = document.getElementById("btnExportExcel")
        const originalHtml = btn.innerHTML
        btn.disabled = true
        btn.innerHTML = `<span class="spinner-border spinner-border-sm"></span>`
        try {
            const rows = await _fetchAllLotsForExport()
            const headers = ["Lot No.", "Part No.", "Description", "Work Order", "Model", "Line", "Location", "Location Type",
                              "Status", "On Hand", "Reserved", "Consumed", "Available", "Created At", "Location Entered At", "Production Deadline At", "Late By"]
            const lines = [headers.map(_csvCell).join(",")]
            rows.forEach(x => {
                lines.push([
                    x.lotNo ?? "", x.partNo ?? "", x.description ?? "", x.workOrder ?? "", x.modelName ?? "",
                    x.lineName ?? "", locName(x.location) === x.location ? (x.location ?? "") : locName(x.location),
                    _locNameMap.get(x.location)?.typeName ?? "",
                    x.status ?? "", x.onHandQty ?? 0, x.reservedQty ?? 0, x.consumedQty ?? 0, x.available ?? 0,
                    fmtDate(x.createdAt),
                    x.locationEnteredAt ? fmtDate(x.locationEnteredAt) : "",
                    x.productionDeadlineAt ? fmtDate(x.productionDeadlineAt) : "",
                    lateMs(x) > 0 ? fmtLate(lateMs(x)) : "",
                ].map(_csvCell).join(","))
            })
            // BOM (﻿) นำหน้า — กัน Excel เปิดแล้วภาษาไทยเพี้ยนเป็นตัวอักษรมั่ว (คิดว่าเป็น ANSI ถ้าไม่มี BOM)
            const blob = new Blob(["﻿" + lines.join("\r\n")], { type: "text/csv;charset=utf-8;" })
            const url  = URL.createObjectURL(blob)
            const a    = document.createElement("a")
            const ts   = new Date()
            const pad  = n => String(n).padStart(2, "0")
            a.href     = url
            a.download = `Lots_Export_${ts.getFullYear()}${pad(ts.getMonth()+1)}${pad(ts.getDate())}_${pad(ts.getHours())}${pad(ts.getMinutes())}.csv`
            document.body.appendChild(a)
            a.click()
            a.remove()
            URL.revokeObjectURL(url)
            showToast(`${lotsDict().exportSuccess} (${rows.length.toLocaleString()} ${lotsDict().lots})`)
        } catch (err) {
            console.error(err)
            showToast(`${lotsDict().exportFailed}: ${err.message}`, "error")
        } finally {
            btn.disabled = false
            btn.innerHTML = originalHtml
        }
    }

    function sort(col) {
        desc = (sortBy === col) ? !desc : true
        sortBy = col
        page = 1
        loadLots()
    }

    function searchLots()    { page = 1; loadLots() }
    // พิมพ์ช่อง search แล้ว debounce รอสักครู่ค่อยยิงค้นหาเอง ไม่ต้องกดปุ่ม Search (เหมือนหน้า WorkOrders)
    let _lotsSearchTimer = null
    function lotsDebouncedSearch() {
        clearTimeout(_lotsSearchTimer)
        _lotsSearchTimer = setTimeout(searchLots, 400)
    }
    function changePageSize(){ page = 1; loadLots() }
    function nextPage()      { if (page < totalPages) { page++; loadLots() } }
    function prevPage()      { if (page > 1)          { page--; loadLots() } }

    // ── Action menu — รวม Re-Print/Adjust/Void เป็นปุ่ม ⋯ เดียว append เข้า <body> ตรงๆ กัน overflow ของตาราง clip dropdown ──
    // canAdjust/canVoid ใช้กรองว่าจะโชว์ตัวเลือกไหนใน dropdown
    function closeLotActionMenu() {
        document.getElementById('lotActionMenu')?.remove()
        document.querySelector('.btn-action-menu.active')?.classList.remove('active')
    }
    document.addEventListener('click', closeLotActionMenu)

    function toggleLotActionMenu(e, lotNo, onHandQty, isVoided) {
        e.stopPropagation()
        const btn = e.currentTarget
        const wasOpen = btn.classList.contains('active')
        closeLotActionMenu()
        if (wasOpen) return

        const d = lotsDict()
        const items = []
        items.push(`<div class="lot-action-item" onclick="closeLotActionMenu();location.href='Inventory/PrintQR?tab=reprint&lot='+encodeURIComponent('${lotNo}')"><i class="bi bi-printer"></i>${d.rePrint}</div>`)
        if (canAdjust) {
            items.push(isVoided
                ? `<div class="lot-action-item disabled" title="${d.alreadyVoided}"><i class="bi bi-pencil-square"></i>${d.adjust}</div>`
                : `<div class="lot-action-item amber" onclick="closeLotActionMenu();adjustLot('${lotNo}', ${onHandQty})"><i class="bi bi-pencil-square"></i>${d.adjust}</div>`)
        }
        if (canVoid) {
            items.push(isVoided
                ? `<div class="lot-action-item disabled"><i class="bi bi-slash-circle"></i>${d.voided}</div>`
                : `<div class="lot-action-item danger" onclick="closeLotActionMenu();voidLot('${lotNo}')"><i class="bi bi-slash-circle"></i>${d.voidAction}</div>`)
        }

        const rect = btn.getBoundingClientRect()
        const menu = document.createElement('div')
        menu.id        = 'lotActionMenu'
        menu.className = 'lot-action-menu'
        menu.style.position = 'fixed'
        menu.style.top   = (rect.bottom + 4) + 'px'
        menu.style.right = (window.innerWidth - rect.right) + 'px'
        menu.innerHTML   = items.join('')
        menu.addEventListener('click', ev => ev.stopPropagation())
        document.body.appendChild(menu)
        btn.classList.add('active')
    }

    function applyRoleUI() {
        const user       = JSON.parse(localStorage.getItem("user") || "{}")
        const userRoles  = Array.isArray(user.roles) ? user.roles : []
        const userPermis = Array.isArray(user.permissions) ? user.permissions : []
        const isAdmin    = userRoles.includes("Admin")

        canAdjust = isAdmin || userPermis.includes("WMS.Lot.Update")
        canVoid   = isAdmin || userPermis.includes("WMS.Lot.Void")
        canExportExcel = isAdmin || userPermis.includes("WMS.UI.Export.Excel")

        document.getElementById("btnExportExcel").style.display  = canExportExcel ? "" : "none"
    }

    let _voidLotNo = null
    let _adjustLotNo = null

    function showToast(message, type = "success") {
        const stack = document.getElementById("toastStack")
        const t = document.createElement("div")
        t.className = `toast toast-${type}`
        t.innerHTML = `<span>${type === "success" ? "✓" : "✕"}</span>${message}`
        stack.appendChild(t)
        setTimeout(() => { t.style.opacity = "0"; t.style.transform = "translateX(28px)"; t.style.transition = ".2s" }, 2800)
        setTimeout(() => t.remove(), 3100)
    }

    function showModalError(errorId, message) {
        const el = document.getElementById(errorId)
        el.textContent = message
        el.classList.add("show")
    }

    function clearModalError(errorId) {
        const el = document.getElementById(errorId)
        el.textContent = ""
        el.classList.remove("show")
    }

    function openModal(id)  { document.getElementById(id).classList.add("show") }
    function closeModal(id) { document.getElementById(id).classList.remove("show") }

    function voidLot(lotNo) {
        _voidLotNo = lotNo
        document.getElementById("voidLotNo").textContent = lotNo
        document.getElementById("voidReason").value = ""
        clearModalError("voidError")
        openModal("voidModal")
    }

    async function confirmVoid() {
        const reason = document.getElementById("voidReason").value.trim()
        if (!reason) { document.getElementById("voidReason").focus(); return }
        clearModalError("voidError")
        try {
            await api(`/inventory/void-lot/${_voidLotNo}`, "POST", { reason })
            closeModal("voidModal")
            showToast(`Lot ${_voidLotNo} ${lotsDict().wasVoided}`)
            loadLots()
        } catch (err) {
            showModalError("voidError", err.message || lotsDict().errorOccurred)
        }
    }

    function adjustLot(lotNo, currentQty) {
        _adjustLotNo = lotNo
        document.getElementById("adjustLotNo").textContent       = lotNo
        document.getElementById("adjustCurrentQty").textContent  = currentQty.toLocaleString()
        document.getElementById("adjustNewQty").value = ""
        clearModalError("adjustError")
        openModal("adjustModal")
    }

    async function confirmAdjust() {
        const qty = parseFloat(document.getElementById("adjustNewQty").value)
        if (isNaN(qty) || qty < 0) { document.getElementById("adjustNewQty").focus(); return }
        clearModalError("adjustError")
        try {
            await api("/inventory/adjust", "POST", { lotNo: _adjustLotNo, adjustQty: qty })
            closeModal("adjustModal")
            showToast(`Lot ${_adjustLotNo} ${lotsDict().wasAdjusted}`)
            loadLots()
        } catch (err) {
            showModalError("adjustError", err.message || lotsDict().errorOccurred)
        }
    }

    document.querySelectorAll(".modal-overlay").forEach(el =>
        el.addEventListener("click", e => { if (e.target === el) closeModal(el.id) })
    )

    // แปลภาษาหน้านี้ทั้งหมด — เรียกตอน init และทุกครั้งที่กดสลับภาษา (ผูกผ่าน window.onLangChange ที่ _Layout.cshtml เรียกให้)
    function applyLotsLang() {
        applyDataI18n(lotsDict())
        if (!document.getElementById('filterLocationType').value)
            document.getElementById('filterLocationTypeLabel').textContent = lotsDict().allLocations
        if (!document.getElementById('filterLotStatus').value)
            document.getElementById('filterLotStatusLabel').textContent = lotsDict().allStatus
        if (!document.getElementById('filterItemType').value)
            document.getElementById('filterItemTypeLabel').textContent = lotsDict().allItemTypes
        loadLots()
    }
    window.onLangChange = applyLotsLang

    async function _init(){
        await loadLocation()
        applyRoleUI()
        loadLocationTypes()
        loadLotStatusOptions()
        loadItemTypeOptions()
        applyLotsLang()
    }

    _init()

</script>
}
