</style>


@section Scripts {
  <script src="js/api.js"></script>
  <script src="js/locationTypeMeta.js"></script>
  <script src="js/loadLocation.js"></script>
  <script src="js/workOrderAutocomplete.js"></script>
  <script src="js/barcodeScanner.js"></script>
  <script src="js/hwScanner.js"></script>
  <script src="js/scanPipeline.js"></script>
  <script src="lib/leaflet/leaflet.js"></script>
  <script src="lib/leaflet/leaflet-rotate.js"></script>
  <script src="lib/leaflet/leaflet-distortable.js"></script>
  <script>
    // ── Check Stock Modal ──
    let _chkScanner  = null
    let _chkHwScanner = null
    let _chkPipeline = null
    let _chkMode     = 'camera'   // 'camera' | 'hw' — แหล่งสแกน (กล้อง vs เครื่องอ่านภายนอก)
    let _chkScanMode = 'lot'      // 'lot' | 'parse' — โหมดประมวลผลผลสแกน (lookup lot เต็มรูปแบบ vs parse บาร์โค้ด vendor ดิบๆ)
    let _chkCurrentPos = null

    // เปลี่ยนโหมดประมวลผลผลสแกน — 'lot' = ผ่าน scanPipeline เหมือนเดิม (หา lot/qr เรา), 'parse' = ยิง /label/parse ตรงๆ โชว์ทุก field ดิบที่อ่านได้ (ใช้เช็ค barcode vendor ละเอียด)
    function chkSetScanMode(mode) {
        _chkScanMode = mode
        document.getElementById('chkResult').innerHTML = mode === 'parse'
            ? '<div class="chk-result-idle">สแกน barcode เพื่อ Parse ดูข้อมูลดิบ</div>'
            : '<div class="chk-result-idle">สแกน barcode เพื่อดูข้อมูล Lot</div>'
    }

    // จุดเดียวที่ raw string จากกล้อง/HW scanner วิ่งเข้ามา — แยกเส้นทางตาม _chkScanMode
    function _chkOnRawScan(raw) {
        if (_chkScanMode === 'parse') _chkParseBarcode(raw)
        else _chkPipeline.submit(raw)
    }

    function openCheckModal() {
        // Fetch Current Location
        fetchGPS()
            .then(pos => { _chkCurrentPos = pos })
            .catch(() => { _chkCurrentPos = null })

        console.log("Current POS :", _chkCurrentPos)

        toggleFab()
        _chkMode = 'camera'
        _chkScanMode = 'lot'
        document.getElementById('chkScanModeSelect').value = 'lot'
        document.getElementById('chkOverlay').classList.add('open')
        document.getElementById('chkResult').innerHTML = '<div class="chk-result-idle">สแกน barcode เพื่อดูข้อมูล Lot</div>'
        _chkPipeline = createScanPipeline({
            mode: 'check', cooldownMs: 2000,
            onResult: (data) => _chkRenderResult(data)
        })
        _chkScanner = createBarcodeScanner({
            videoId: 'chkVideo', canvasId: 'chkCanvas', labelId: 'chkLabel',
            onDetect: raw => _chkOnRawScan(raw)
        })
        _chkHwScanner = createHwScanner({
            inputId: 'chkHwInput', statusId: 'chkHwStatus',
            onScan: raw => _chkOnRawScan(raw)
        })
        _chkSetMode('camera')
    }

    async function fetchGPS() {
        return new Promise((resolve, reject) =>
            navigator.geolocation.getCurrentPosition(resolve, reject, {
                enableHighAccuracy: true,
                timeout: 5000
            })
        )
    }

    function closeCheckModal() {
        _chkScanner?.stop();    _chkScanner  = null
        _chkHwScanner?.close(); _chkHwScanner = null
        _chkPipeline = null
        document.getElementById('chkOverlay').classList.remove('open')
        document.getElementById('chkCameraWrap').style.display = ''
        document.getElementById('chkHwSection').style.display  = 'none'
    }

    function _chkSetMode(mode) {
        _chkMode = mode
        const isCam = mode === 'camera'
        document.getElementById('chkCameraWrap').style.display = isCam ? ''       : 'none'
        document.getElementById('chkSwitchBtn').style.display  = isCam ? ''       : 'none'
        document.getElementById('chkHwSection').style.display  = isCam ? 'none'   : ''
        document.getElementById('chkLabel').style.display      = isCam ? ''       : 'none'
        const modeBtn = document.getElementById('chkModeBtn')
        modeBtn.classList.toggle('hw-active', !isCam)
        modeBtn.title = isCam ? 'เปลี่ยนเป็น HW Scanner' : 'เปลี่ยนเป็นกล้อง'
        modeBtn.innerHTML = isCam
            ? '<i class="bi bi-camera-fill"></i>'
            : '<i class="bi bi-upc-scan"></i>'
        if (isCam) {
            _chkHwScanner?.close()
            _chkScanner?.start().catch(err => {
                document.getElementById('chkLabel').textContent = 'กล้องเปิดไม่ได้: ' + err.message
            })
        } else {
            _chkScanner?.stop()
            document.getElementById('chkResult').innerHTML = _chkScanMode === 'parse'
                ? '<div class="chk-result-idle">สแกน barcode เพื่อ Parse ดูข้อมูลดิบ</div>'
                : '<div class="chk-result-idle">สแกน barcode เพื่อดูข้อมูล Lot</div>'
            setTimeout(() => _chkHwScanner?.open(), 80)
        }
    }

    function chkToggleMode() { _chkSetMode(_chkMode === 'camera' ? 'hw' : 'camera') }
    function chkSwitchCamera() { _chkScanner?.switchCamera() }

    // ── Parse mode: ยิง /label/parse ตรงๆ ไม่ผ่าน scanPipeline — โชว์ทุก field ดิบที่อ่านได้ ใช้เช็ค barcode vendor แบบละเอียด
    async function _chkParseBarcode(raw) {
        const el = document.getElementById('chkResult')
        el.innerHTML = `<div class="chk-result-idle"><span class="spinner-border spinner-border-sm me-2"></span>กำลัง Parse…</div>`
        try {
            const res = await api('/label/parse', 'POST', { rawData: raw })
            const d = res?.data ?? {}
            el.innerHTML = _chkParseResultHtml(d)
        } catch (err) {
            el.innerHTML = `<div class="chk-err-msg"><i class="bi bi-x-circle me-1"></i>Parse ไม่สำเร็จ: ${err.message}</div>`
        }
    }

    // field จาก /label/parse มาจากการอ่าน barcode ภายนอก (vendor) ไว้ใจไม่ได้ 100% — escape ก่อน insert ผ่าน innerHTML กัน XSS
    function _chkEscHtml(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;') }

    // แสดงทุก field ที่ /label/parse คืนมา (ไม่กรอง ไม่ตีความ) — เจตนาใช้หน้านี้เป็นเครื่องมือเช็ค barcode vendor ดิบๆ
    function _chkParseResultHtml(d) {
        const rows = [
            ['Format Type',    d.formatType],
            ['Description',   d.description],
            ['Supplier',      d.supplier],
            ['Plant',         d.plant],
            ['Part No',       d.partNo],
            ['Qty',           d.qty],
            ['Unit',          d.unit],
            ['Vendor',        d.vendor],
            ['Date Code',     d.dateCode],
            ['Revision',      d.revision],
            ['Trading Code',  d.tradingCode],
            ['PO',            d.po],
            ['Invoice No',    d.invoiceNo],
            ['Barcode Serial',d.barcodeSerial],
            ['Main W/O',      d.mainWorkOrder],
            ['Sub W/O',       d.subWorkder],
            ['MIC No',        d.micNo],
            ['Box No',        d.boxNo],
            ['Line',          d.line],
        ]
        const rowsHtml = rows.map(([label, val]) =>
            `<div class="chk-info-row"><span class="chk-info-label">${label}</span><span class="chk-info-val">${val === null || val === undefined ? '—' : _chkEscHtml(val)}</span></div>`
        ).join('')
        return `
            <div class="chk-parse-hdr">Parsed Fields</div>
            ${rowsHtml}
            <div class="chk-parse-hdr" style="margin-top:12px">Raw Data</div>
            <div class="chk-parse-raw">${d.rawData ? _chkEscHtml(d.rawData) : '—'}</div>`
    }

    // raw barcode เดียวกันอาจผูกกับหลาย lot (รับหลายรอบ) — เก็บ list ของ match ไว้เดินหน้า/ถอยหลังด้วย < >
    let _chkMatches  = []
    let _chkMatchIdx = 0

    async function _chkRenderResult(data) {
        const el = document.getElementById('chkResult')
        if (!data || data.status === 'unknown') {
            _chkMatches = []
            el.innerHTML = `<div class="chk-err-msg"><i class="bi bi-question-circle me-1"></i>ไม่รู้จัก barcode นี้</div>`
            return
        }
        if (data.status === 'notReceived') {
            _chkMatches = []
            el.innerHTML = `
                <div class="chk-err-msg"><i class="bi bi-exclamation-triangle me-1"></i>This item not receive yet !!</div>
                <div class="chk-action-row">
                    <button class="chk-btn chk-btn-receive" onclick="location.href='Inventory/Receive'">
                        <i class="bi bi-box-arrow-in-down me-1"></i>Receive
                    </button>
                </div>`
            return
        }
        if (data.status === 'noLot') {
            _chkMatches = []
            el.innerHTML = `<div class="chk-err-msg"><i class="bi bi-x-circle me-1"></i>ไม่พบ Lot นี้ในระบบ</div>`
            return
        }
        if (data.status === 'match') {
            // barcode เดียวกัน match หลาย lot — โชว์ตัวแรกก่อน แล้วให้กด < > เดินดูตัวอื่น
            _chkMatches  = data.matches || []
            _chkMatchIdx = 0
            await _chkRenderMatchAt(0)
            return
        }
        // QR ของเราเอง (mode 'our') — มี lot เดียวแน่นอน ไม่มี list ให้เดิน
        _chkMatches = []
        await _chkRenderLotData(data)
    }

    // ดึงข้อมูล Lot เต็มของ match ตัวที่ idx แบบ lazy (ยิง /inventory/lots เฉพาะตัวที่กำลังแสดงเท่านั้น
    // ไม่ยิงรวดเดียวทุกตัว เพราะ 1 raw barcode อาจ match ได้หลายสิบ lot)
    async function _chkRenderMatchAt(idx) {
        const el = document.getElementById('chkResult')
        const m  = _chkMatches[idx]
        if (!m) return
        el.innerHTML = `<div class="chk-result-idle"><span class="spinner-border spinner-border-sm me-2"></span>กำลังโหลด…</div>`
        let lot = null
        try {
            const res = await api('/inventory/lots', 'POST', { lotNo: m.lotNo, page: 1, pageSize: 1 })
            lot = res.data?.[0] ?? null
        } catch (_) {}
        if (!lot) {
            el.innerHTML = `<div class="chk-err-msg"><i class="bi bi-x-circle me-1"></i>ไม่พบ Lot นี้ในระบบ</div>${_chkNavHtml()}`
            return
        }
        await _chkRenderLotData({ status: m.uniqueId ? 'Print' : 'NoPrint', qrType: 'vendor', lotNo: m.lotNo, uniqueId: m.uniqueId, lot })
    }

    function chkMatchNav(delta) {
        const n = _chkMatches.length
        if (!n) return
        _chkMatchIdx = (_chkMatchIdx + delta + n) % n
        _chkRenderMatchAt(_chkMatchIdx)
    }

    function _chkNavHtml() {
        if (_chkMatches.length <= 1) return ''
        return `<div class="chk-nav-row">
            <button class="chk-nav-btn" onclick="chkMatchNav(-1)" title="ก่อนหน้า">‹</button>
            <span class="chk-nav-count">${_chkMatchIdx + 1} / ${_chkMatches.length}</span>
            <button class="chk-nav-btn" onclick="chkMatchNav(1)" title="ถัดไป">›</button>
        </div>`
    }

    async function _chkRenderLotData(data) {
        const el = document.getElementById('chkResult')
        console.log("Data From ScanPipe : ",data)
        const lot = data.lot || {}
        const loc = lot.location || '—'

        // Check Distance
        let checkDistance = null
        if (_chkCurrentPos) {
            try {
                checkDistance = await api('/location/check-distance', 'POST', {
                    locationCode:      loc,
                    currentLatitude:   _chkCurrentPos.coords.latitude,
                    currentLongitude:  _chkCurrentPos.coords.longitude,
                    currentHeigth:     _chkCurrentPos.coords.altitude
                })
            } catch(_) {}
        }

        // สร้าง UI ของ distance status
        let distHtml = ''
        let showMoveBtn = false
        if (!checkDistance) {
            // GPS ยังไม่พร้อม หรือ API error
            distHtml = `<div class="chk-dist chk-dist-unknown">
                <i class="bi bi-geo-alt"></i> ${locName(loc) || '—'}
                <span class="chk-dist-badge chk-dist-badge-unknown">GPS ไม่พร้อม</span>
            </div>`
        } else if (checkDistance.isSuccess) {
            distHtml = `<div class="chk-dist chk-dist-ok">
                <i class="bi bi-geo-alt-fill"></i> ${locName(loc) || '—'}
                <span class="chk-dist-badge chk-dist-badge-ok">✓ อยู่ในตำแหน่ง</span>
            </div>`
        } else if (checkDistance.message === 'Heigth is not Match') {
            distHtml = `<div class="chk-dist chk-dist-warn">
                <i class="bi bi-geo-alt-fill"></i> ${locName(loc) || '—'}
                <span class="chk-dist-badge chk-dist-badge-warn">⚠ ต่างชั้น (${Math.round(checkDistance.heigthDiffer ?? 0)} m)</span>
            </div>`
            showMoveBtn = true
        } else if (checkDistance.message === 'Too far') {
            distHtml = `<div class="chk-dist chk-dist-far">
                <i class="bi bi-geo-alt-fill"></i> ${locName(loc) || '—'}
                <span class="chk-dist-badge chk-dist-badge-far">✗ ไกลเกินไป (${Math.round(checkDistance.distanceMeters ?? 0)} m)</span>
            </div>`
            showMoveBtn = true
        }

        const _lotNo  = (data.lotNo  || '').replace(/'/g, "\\'")
        const _loc    = (loc         || '').replace(/'/g, "\\'")
        const _partNo = (lot.partNo  || '').replace(/'/g, "\\'")

        el.innerHTML = `
            <div class="chk-info-row"><span class="chk-info-label">Lot</span><span class="chk-info-val">${data.lotNo || '—'}</span></div>
            <div class="chk-info-row"><span class="chk-info-label">W/O</span><span class="chk-info-val">${lot.workOrder || '—'}</span></div>
            <div class="chk-info-row"><span class="chk-info-label">Part No</span><span class="chk-info-val">${lot.partNo || '—'}</span></div>
            <div class="chk-info-row"><span class="chk-info-label">QTY</span><span class="chk-info-val">${lot.onHandQty ?? '—'} Pcs</span></div>
            ${distHtml}
            ${showMoveBtn ? `<div class="chk-action-row">
                <button class="chk-btn chk-btn-move" onclick="location.href='Inventory/Move?openCamera=1'">
                    <i class="bi bi-arrow-left-right me-1"></i>Move
                </button>
                <button class="chk-btn chk-btn-nav" onclick="closeCheckModal();dashFindLot('${_lotNo}','${_loc}','${_partNo}')">
                    <i class="bi bi-crosshair2 me-1"></i>Navigate
                </button>
            </div>` : ''}
            ${_chkNavHtml()}`
    }

    let _selectedLocTypeId = 5  // default WIP, null = All
    let _dashLotImgMap = {}    // lotNo → [imageUrl, ...]

    // ── Lightbox ──
    let _lbImages = [], _lbIndex = 0, _lbCaption = ''
    function dashOpenLightbox(images, index, caption) {
        _lbImages = images; _lbIndex = ((index||0) + images.length) % images.length; _lbCaption = caption||''
        _dashRenderLb()
        document.getElementById('dashLightbox').classList.add('show')
    }
    function _dashRenderLb() {
        const multi = _lbImages.length > 1
        document.getElementById('dashLbImg').src = _lbImages[_lbIndex]
        document.getElementById('dashLbCaption').textContent = _lbCaption + (multi ? ` · ${_lbIndex+1}/${_lbImages.length}` : '')
        document.querySelector('#dashLightbox .dash-lb-nav:first-child').style.display = multi ? 'flex' : 'none'
        document.querySelector('#dashLightbox .dash-lb-nav:last-child').style.display  = multi ? 'flex' : 'none'
    }
    function dashLbStep(d) { _lbIndex = (_lbIndex+d+_lbImages.length)%_lbImages.length; _dashRenderLb() }
    function dashOpenLotLightbox(lotNo) {
        const entry = _dashLotImgMap[lotNo]
        if (!entry?.images?.length) return
        const d = entry.createdAt ? new Date(entry.createdAt) : null
        const dateStr = d ? d.toLocaleString('th-TH', {dateStyle:'short', timeStyle:'medium'}) : ''
        const caption = [lotNo, entry.performedBy, dateStr].filter(Boolean).join(' | ')
        dashOpenLightbox(entry.images, 0, caption)
    }
    function dashCloseLightbox() { document.getElementById('dashLightbox').classList.remove('show') }
    document.addEventListener('keydown', e => { if(e.key==='Escape') dashCloseLightbox() })
    let _allLocTypeIds = []
    let _dashLocTypes  = []
    let _currentDashWo = null

    document.addEventListener('DOMContentLoaded', async () => {
    // 1. แสดงชื่อจริง (displayName) ของ User ที่ Login อยู่
    const userJson = localStorage.getItem("user");
    if (userJson) {
        const dataObj = JSON.parse(userJson);
        const displayElt = document.getElementById("displayUserName");

        if (displayElt) {
            // ดึง displayName มาแสดง ถ้าไม่มีให้ใช้ username แทนเป็นตัวสำรอง
            displayElt.innerText = dataObj.displayName || dataObj.username || "User";
        }
    }
    const h = new Date().getHours()
    const greeting = h < 12 ? 'Good Morning' : h < 18 ? 'Good Afternoon' : 'Good Evening'
    document.getElementById('displayGreeting').textContent = greeting

    // 2. โหลด Location Types → populate dropdown
    try {
        const types = await api('/location/types', 'GET')
        _allLocTypeIds = types.map(t => t.id)
        _dashLocTypes  = types
        const menu  = document.getElementById('dashLocTypeMenu')
        menu.innerHTML =
            `<div class="loc-filter-dd-item${_selectedLocTypeId == null ? ' active' : ''}" data-val="" onclick="dashSetLocType(null,'All')">All Types</div>` +
            types.map(t => `<div class="loc-filter-dd-item${t.id === _selectedLocTypeId ? ' active' : ''}" data-val="${t.id}" onclick="dashSetLocType(${t.id},'${t.displayName}')">
                ${locHierTypeIcon(t.displayName)} <span style="color:${locTypeMeta(t.displayName).color};font-weight:600">${t.displayName}</span>
            </div>`).join('')
        const wip = types.find(t => t.id === _selectedLocTypeId)
        if (wip) {
            document.getElementById('dashLocTypeLabel').innerHTML =
                `${locHierTypeIcon(wip.displayName)} <span style="color:${locTypeMeta(wip.displayName).color};font-weight:600">${wip.displayName}</span>`
        }
    } catch (_) {}

    // 3. โหลดรายการ Work Orders
    await renderWorkOrders();

    // 3. ช่องค้นหา Work Order -> โชว์ Lot Summary (WIP) ในหน้านี้
    createWorkOrderAutocomplete({
        inputId: 'dashWoSearch', dropdownId: 'dashWoDropdown',
        onSelect: x => {
            if (x?.moNumber) loadDashLotSummary(x.moNumber)
        }
    });

    // 4. Find modal — รอ shown.bs.modal แล้วค่อย init map (Leaflet ต้องการ DOM ที่ visible)
    document.getElementById('findLocModal').addEventListener('shown.bs.modal', _onFindModalShown)

    // 5. หา Factory ที่ใกล้ตำแหน่งปัจจุบันที่สุด (ไม่ block init อื่น — GPS prompt อาจรอ user กด allow)
    _initNearestFactory()
    });

    function fmt(n) { return (n || 0).toLocaleString() }

    // ── Custom Location Type Dropdown (My Tasks ↑ ไม่เกี่ยว — อันนี้ของ Lot Summary filter) ──
    function dashLocTypeDdToggle() {
        const menu    = document.getElementById('dashLocTypeMenu')
        const trigger = document.getElementById('dashLocTypeBtn')
        const opening = menu.style.display === 'none'
        menu.style.display = 'none'
        trigger.classList.remove('open')
        if (opening) {
            const r = trigger.getBoundingClientRect()
            menu.style.left     = r.left + 'px'
            menu.style.top      = (r.bottom + 4) + 'px'
            menu.style.minWidth = r.width + 'px'
            menu.style.display  = ''
            trigger.classList.add('open')
        }
    }
    window.addEventListener('scroll', e => {
        const menu = document.getElementById('dashLocTypeMenu')
        if (!menu || menu.style.display === 'none') return
        if (menu.contains(e.target)) return
        dashLocTypeDdToggle()
    }, true)
    window.addEventListener('resize', () => {
        const menu = document.getElementById('dashLocTypeMenu')
        if (menu && menu.style.display !== 'none') dashLocTypeDdToggle()
    })
    document.addEventListener('click', e => {
        if (!e.target.closest('.loc-filter-dd-wrap')) {
            const menu    = document.getElementById('dashLocTypeMenu')
            const trigger = document.getElementById('dashLocTypeBtn')
            if (menu)    menu.style.display = 'none'
            if (trigger) trigger.classList.remove('open')
        }
    })

    // ── Lot Summary (location type = WIP) สำหรับ Work Order ที่เลือก ──
    function dashSetLocType(id, label) {
        document.querySelectorAll('#dashLocTypeMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === String(id ?? ''))
        })
        document.getElementById('dashLocTypeLabel').innerHTML = id == null
            ? label
            : `${locHierTypeIcon(label)} <span style="color:${locTypeMeta(label).color};font-weight:600">${label}</span>`
        _selectedLocTypeId = id
        dashLocTypeDdToggle()
        if (_currentDashWo) loadDashLotSummary(_currentDashWo)
    }

    let _dashLots         = []
    let _dashLotPage      = 0
    let _dashPartNoFilter = ''
    let _dashLocNameMap   = null

    // โหลดรายชื่อ Location ทั้งหมดมา cache ครั้งเดียว (ไว้ join locationCode → displayName)
    async function _ensureDashLocNameMap() {
        if (_dashLocNameMap) return _dashLocNameMap
        _dashLocNameMap = new Map()
        try {
            const res = await api('/location?pageSize=500', 'GET')
            const arr = Array.isArray(res) ? res : (res?.data ?? [])
            arr.forEach(loc => _dashLocNameMap.set(loc.locationCode, loc.displayName || loc.locationCode))
        } catch (_) {}
        return _dashLocNameMap
    }
    const DASH_PAGE_SIZE  = 5

    async function loadDashLotSummary(mo) {
        _currentDashWo = mo
        const card  = document.getElementById('dashLotSummaryCard')
        const tbody = document.getElementById('dashLotTable')
        document.getElementById('dashLotSummaryWo').textContent = mo
        document.getElementById('dashLotSummaryCount').textContent = ''
        document.getElementById('dashLotPager').style.display = 'none'
        card.style.display = 'block'
        tbody.innerHTML = `<tr><td colspan="8" class="text-center text-muted py-3">กำลังโหลด...</td></tr>`

        try {
            const ids = _selectedLocTypeId != null ? [_selectedLocTypeId] : _allLocTypeIds
            const locParam = ids.map(id => `locationTypes=${id}`).join('&')
            const [detail] = await Promise.all([
                api(`/workorder/${encodeURIComponent(mo)}/detail?${locParam}`, 'GET'),
                _ensureDashLocNameMap()
            ])
            //console.log("detail", detail)
            //console.log("inventoryLots", detail.inventoryLots)
            _dashLots    = detail.inventoryLots || []
            _dashLotPage = 0
            _dashLotImgMap = {}
            _dashPartNoFilter = ''
            const srch = document.getElementById('dashPartNoSearch')
            if (srch) srch.value = ''
            document.getElementById('dashLotSummaryCount').textContent = _dashLots.length
            document.getElementById('dashLotSummaryLine').textContent = detail.lineName || '—'
            _renderDashLotPage()

            // fetch confirm images แบบ async (render ตารางก่อน แล้ว inject รูปทีหลัง)
            ;(async () => {
                const lotSet = new Set(_dashLots.map(l => l.lotNo))
                let pg = 1
                while (true) {
                    const txData = await api('/transaction/get', 'POST', {
                        page: pg, pageSize: 100, workOrder: mo, sortBy: 'createdAt', desc: true
                    })
                    const rows = Array.isArray(txData) ? txData : (txData?.data || [])
                    rows.forEach(tx => {
                        if (!tx.lotNo || !lotSet.has(tx.lotNo) || tx.lotNo in _dashLotImgMap) return
                        _dashLotImgMap[tx.lotNo] = {
                            images:      (tx.images || []).map(im => CONFIG.INVENTORY_API + im.imageUrl),
                            performedBy: tx.performedBy || '',
                            createdAt:   tx.createdAt   || ''
                        }
                    })
                    const allMapped = _dashLots.every(l => l.lotNo in _dashLotImgMap)
                    if (allMapped || pg >= (txData?.totalPages ?? 1) || !rows.length) break
                    pg++
                }
                _renderDashLotPage()
            })().catch(() => {})
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-3">${err.message}</td></tr>`
        }
    }

    // Location + Location Type รวมเป็น badge เดียว — ใช้สไตล์ (สี+icon) ของ location type ครอบชื่อ location
    function _dashLocBadge(l) {
        const name = _dashLocNameMap?.get(l.locationCode) || l.locationCode || '-'
        const type = l.locationType
        if (!type) return `<span style="display:inline-flex;align-items:center;gap:5px;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600;background:#f3f4f6;color:#374151"><i class="bi bi-geo-alt" style="font-size:10px"></i>${name}</span>`
        return `<span style="display:inline-flex;align-items:center;gap:5px;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600;${locTypeBadgeStyle(type)}">${locHierTypeIcon(type)}${name}</span>`
    }

    function _renderDashLotPage() {
        const tbody    = document.getElementById('dashLotTable')
        const pager    = document.getElementById('dashLotPager')
        const flt      = _dashPartNoFilter.toLowerCase()
        const filtered = flt ? _dashLots.filter(l => (l.partNo || '').toLowerCase().includes(flt)) : _dashLots
        const total    = filtered.length
        const pages    = Math.ceil(total / DASH_PAGE_SIZE)
        const start    = _dashLotPage * DASH_PAGE_SIZE
        const slice    = filtered.slice(start, start + DASH_PAGE_SIZE)

        tbody.innerHTML = slice.map(l => {
            const avOk   = (l.availableQty || 0) > 0
            const entry  = _dashLotImgMap[l.lotNo]
            const imgs   = entry?.images || []
            const lotKey = l.lotNo.replace(/'/g, "\\'")
            const imgCell = imgs.length           
                ? `<div class="thumb-wrap">
                       <img src="${imgs[0]}" class="proof-thumb"
                            onclick="dashOpenLotLightbox('${lotKey}')"
                            onerror="this.closest('.thumb-wrap').innerHTML='<span class=no-photo>—</span>'">
                       ${imgs.length > 1 ? `<span class="thumb-badge">+${imgs.length - 1}</span>` : ''}
                   </div>`
                : `<span class="no-photo" style="font-size:16px;color:#cbd5e1">—</span>`

            return `<tr>
                <td><span class="lot-badge">${l.lotNo || '-'}</span></td>
                <td><span class="mono">${l.partNo || '-'}</span></td>
                <td>${_dashLocBadge(l)}</td>
                <td class="text-center" data-label="On Hand"><span class="qty-pill qty-oh">${fmt(l.onHandQty)}</span></td>
                <td class="text-center" data-label="Reserved"><span class="qty-pill qty-rs">${fmt(l.reservedQty)}</span></td>
                <td class="text-center" data-label="Available"><span class="qty-pill ${avOk ? 'qty-av-ok' : 'qty-av-low'}">${fmt(l.availableQty)}</span></td>
                <td class="text-center">${imgCell}</td>
                <td class="text-center">
                    <button class="nav-btn" onclick="dashFindLot('${l.lotNo}','${l.locationCode}','${l.partNo || ''}')"
                            title="นำทางไปยัง ${l.locationCode}" aria-label="Find ${l.locationCode}">
                        <i class="bi bi-crosshair2" style="font-size:16px"></i>
                    </button>
                </td>
            </tr>`
        }).join('') || `<tr><td colspan="8" class="text-center text-muted py-4" style="font-size:13px">ไม่พบ lot</td></tr>`

        if (pages > 1) {
            pager.style.display = 'flex'
            document.getElementById('dashLotPageInfo').textContent = `หน้า ${_dashLotPage + 1} / ${pages}`
            document.getElementById('dashLotPrev').disabled = _dashLotPage === 0
            document.getElementById('dashLotNext').disabled = _dashLotPage >= pages - 1
        } else {
            pager.style.display = 'none'
        }
    }

    function dashLotPage(dir) {
        const pages = Math.ceil(_dashLots.length / DASH_PAGE_SIZE)
        _dashLotPage = Math.max(0, Math.min(pages - 1, _dashLotPage + dir))
        _renderDashLotPage()
    }

    // ── Find Location — Compass Navigator (offline) ──
    let _pendingFind   = null
    let _findGeoWatch  = null
    let _findTargetLat = null, _findTargetLng = null
    let _findCurLat    = null, _findCurLng    = null, _findCurAlt    = null
    let _findHeading   = 0

    function dashFindLot(lotNo, locationCode, partNo) {
        _pendingFind = { lotNo, locationCode }
        document.getElementById('findLocTitle').textContent    = locationCode || '—'
        document.getElementById('findLocSubtitle').textContent = [partNo, lotNo].filter(Boolean).join(' · ')
        document.getElementById('findNavDist').textContent     = '— m'
        document.getElementById('findNavAccuracy').textContent = ''
        document.getElementById('findNavStatus').textContent   = 'กำลังโหลดพิกัดปลายทาง…'
        document.getElementById('findNavPermBtn').style.display = 'none'
        document.getElementById('findNavArrow').style.transform = 'rotate(0deg)'
        new bootstrap.Modal(document.getElementById('findLocModal')).show()
    }

    async function _onFindModalShown() {
        if (!_pendingFind) return
        const { locationCode } = _pendingFind
        _findTargetLat = null; _findTargetLng = null
        _findCurLat = null; _findCurLng = null

        // 1. ดึงพิกัด target location จาก backend
        try {
            const res   = await api(`/location?search=${encodeURIComponent(locationCode)}&pageSize=10`)
            const items = Array.isArray(res) ? res : (res?.data || [])
            const found = items.find(l => l.locationCode === locationCode) || items[0]
            if (!found) { document.getElementById('findNavStatus').textContent = 'ไม่พบ Location นี้ในระบบ'; return }

            const detail = await api(`/location/${found.id}`)
            if (!detail.latitude || !detail.longitude || (detail.latitude === 0 && detail.longitude === 0)) {
                document.getElementById('findNavStatus').textContent = 'Location นี้ยังไม่มีพิกัด GPS'
                return
            }
            _findTargetLat = detail.latitude
            _findTargetLng = detail.longitude
            document.getElementById('findNavStatus').textContent = 'กำลังหาตำแหน่งของคุณ…'
        } catch (err) {
            document.getElementById('findNavStatus').textContent = 'โหลดพิกัดไม่สำเร็จ'
            return
        }

        // 2. GPS — ติดตามตำแหน่งปัจจุบัน
        if (_findGeoWatch) navigator.geolocation.clearWatch(_findGeoWatch)
        _findGeoWatch = navigator.geolocation.watchPosition(
            pos => {
                _findCurLat = pos.coords.latitude
                _findCurLng = pos.coords.longitude
                _findCurAlt = pos.coords.altitude
                _updateCompass(pos.coords.accuracy)
            },
            err => { document.getElementById('findNavStatus').textContent = 'GPS: ' + err.message },
            { enableHighAccuracy: true, maximumAge: 1000 }
        )

        // 3. Compass heading
        _gotAbsoluteOrientation = false
        if (typeof DeviceOrientationEvent !== 'undefined' &&
            typeof DeviceOrientationEvent.requestPermission === 'function') {
            // iOS 13+ ต้องกดขอ permission
            document.getElementById('findNavPermBtn').style.display = 'inline-block'
        } else {
            // ลอง absolute ก่อน — ถ้าไม่มี event ใน 1.5s ค่อย fallback ไป relative
            window.addEventListener('deviceorientationabsolute', _onAbsoluteOrientation, true)
            setTimeout(() => {
                if (!_gotAbsoluteOrientation)
                    window.addEventListener('deviceorientation', _onRelativeOrientation, true)
            }, 1500)
        }
    }

    let _gotAbsoluteOrientation = false
    let _lastDistZone = null

    function _requestCompassPermission() {
        DeviceOrientationEvent.requestPermission().then(state => {
            if (state === 'granted') {
                document.getElementById('findNavPermBtn').style.display = 'none'
                window.addEventListener('deviceorientation', _onAbsoluteOrientation, true)
            }
        }).catch(console.error)
    }

    function _onAbsoluteOrientation(e) {
        _gotAbsoluteOrientation = true
        // deviceorientationabsolute: alpha = CCW from North → แปลงเป็น CW
        // iOS webkitCompassHeading = CW from North ✓
        _findHeading = e.webkitCompassHeading != null
            ? e.webkitCompassHeading
            : (360 - (e.alpha || 0)) % 360
        _showHeadingDebug('abs', _findHeading)
        _updateCompass(null)
    }

    function _onRelativeOrientation(e) {
        if (_gotAbsoluteOrientation) return  // absolute ดีกว่า ไม่ใช้ relative
        // deviceorientation: alpha วัดจากตำแหน่งเริ่มต้น ไม่ใช่ North จริง
        _findHeading = e.webkitCompassHeading != null
            ? e.webkitCompassHeading         // iOS: ยังเชื่อถือได้
            : (360 - (e.alpha || 0)) % 360
        _showHeadingDebug('rel', _findHeading)
        _updateCompass(null)
    }

    function _showHeadingDebug(src, heading) {
        const el = document.getElementById('findNavAccuracy')
        if (el) el.textContent = `compass ${Math.round(heading)}° (${src})`
    }

    let _findAltTimer = null

    function _updateCompass(accuracy) {
        if (_findTargetLat == null || _findCurLat == null) return
        const dist    = _haversineDist(_findCurLat, _findCurLng, _findTargetLat, _findTargetLng)
        const bearing = _bearing(_findCurLat, _findCurLng, _findTargetLat, _findTargetLng)
        const rot     = (bearing - _findHeading + 360) % 360

        document.getElementById('findNavArrow').style.transform = `rotate(${rot}deg)`

        const distEl = document.getElementById('findNavDist')
        distEl.textContent = dist < 1000 ? Math.round(dist) + ' m' : (dist / 1000).toFixed(1) + ' km'
        distEl.style.color = dist <= 10 ? '#059669' : dist <= 30 ? '#d97706' : '#1a2744'

        // Vibration on zone change (Android only — iOS does not support navigator.vibrate)
        const zone = dist <= 5 ? 'arrived' : dist <= 10 ? 'near' : 'far'
        if (zone !== _lastDistZone) {
            if (zone === 'near'    && navigator.vibrate) navigator.vibrate([200, 100, 200])
            if (zone === 'arrived' && navigator.vibrate) navigator.vibrate([300, 100, 300, 100, 300])
            _lastDistZone = zone
        }

        document.getElementById('findNavStatus').textContent = ''
        if (accuracy != null)
            document.getElementById('findNavAccuracy').textContent = `GPS ±${Math.round(accuracy)} m`

        // Altitude badge — debounce 4s เพื่อไม่ call API ทุก GPS tick
        clearTimeout(_findAltTimer)
        _findAltTimer = setTimeout(_updateAltBadge, 4000)
    }

    async function _updateAltBadge() {
        if (!_pendingFind?.locationCode || !_findCurLat) return
        const altWrap  = document.getElementById('findNavAltWrap')
        const altBadge = document.getElementById('findNavAltBadge')
        try {
            const res = await api('/location/check-distance', 'POST', {
                locationCode:     _pendingFind.locationCode,
                currentLatitude:  _findCurLat,
                currentLongitude: _findCurLng,
                currentHeight:    _findCurAlt
            })
            altWrap.style.display = ''
            if (res.isSuccess) {
                altBadge.style.background = '#dcfce7'; altBadge.style.color = '#15803d'
                altBadge.textContent = '✓ ชั้นเดียวกัน'
            } else if (res.message === 'Heigth is not Match') {
                altBadge.style.background = '#fef3c7'; altBadge.style.color = '#92400e'
                altBadge.textContent = `⚠ ต่างชั้น (${Math.round(res.heigthDiffer ?? 0)} m)`
            } else {
                altWrap.style.display = 'none'
            }
        } catch(_) {
            altWrap.style.display = 'none'
        }
    }

    function _haversineDist(la1, lo1, la2, lo2) {
        const R = 6371000, r = Math.PI / 180
        const dLa = (la2 - la1) * r, dLo = (lo2 - lo1) * r
        const a = Math.sin(dLa/2)**2 + Math.cos(la1*r) * Math.cos(la2*r) * Math.sin(dLo/2)**2
        return R * 2 * Math.asin(Math.sqrt(a))
    }

    function _bearing(la1, lo1, la2, lo2) {
        const r = Math.PI / 180, dLo = (lo2 - lo1) * r
        const y = Math.sin(dLo) * Math.cos(la2 * r)
        const x = Math.cos(la1*r) * Math.sin(la2*r) - Math.sin(la1*r) * Math.cos(la2*r) * Math.cos(dLo)
        return (Math.atan2(y, x) / r + 360) % 360
    }

    // ── หา Factory ที่ใกล้ตำแหน่งปัจจุบันที่สุด → แสดงชื่อ + Parent บน header ──
    async function _initNearestFactory() {
        const elParent  = document.getElementById('dashNearestParent')
        const elFactory = document.getElementById('dashNearestFactory')
        if (!elParent || !elFactory || !navigator.geolocation) return

        const factoryType = _dashLocTypes.find(t => (t.displayName || '').toLowerCase() === 'factory')
        if (!factoryType) return

        let pos
        try {
            pos = await new Promise((res, rej) =>
                navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
            )
        } catch (_) { return }

        // อุปกรณ์/เบราว์เซอร์นี้ไม่รองรับความสูง (altitude) — เทียบ heigthDiff ไม่ได้ ไม่ฟันธงว่าใกล้ตัวไหน
        if (pos.coords.altitude == null) {
            elFactory.textContent = '-'
            elParent.textContent  = '-'
            return
        }

        try {
            // backend หาให้เลยว่า location type=Factory ตัวไหนอยู่ในรัศมี distanceLimit (m) จากพิกัดปัจจุบัน
            // พร้อมคำนวณ heigthDiff (ส่วนต่างความสูง) มาให้ในแต่ละตัว
            const params = new URLSearchParams({
                type:             factoryType.id,
                currentLatitude:  pos.coords.latitude,
                currentLongitude: pos.coords.longitude,
                currentZHeigth:   pos.coords.altitude,
                distanceLimit:    200,
                pageSize:         500,
            })
            const res   = await api(`/location?${params}`, 'GET')
            const items = Array.isArray(res) ? res : (res?.data || [])
            if (!items.length) return

            // เลือกตัวที่ heigthDiff ใกล้ 0 ที่สุด (อยู่ชั้นเดียวกับเราที่สุด) ในกลุ่มที่อยู่ในรัศมีแล้ว
            const nearest = items.reduce((best, l) =>
                (best == null || Math.abs(l.heigthDiff ?? Infinity) < Math.abs(best.heigthDiff ?? Infinity)) ? l : best
            , null)
            if (!nearest) return

            elFactory.textContent = nearest.displayName || nearest.locationCode || '—'
            elParent.textContent  = nearest.parentLocationDisplayName || '—'
        } catch (_) { /* เงียบ ปล่อยให้แสดง — ไว้เหมือนเดิม */ }
    }

    // cleanup เมื่อปิด modal
    document.getElementById('findLocModal').addEventListener('hidden.bs.modal', () => {
        if (_findGeoWatch) { navigator.geolocation.clearWatch(_findGeoWatch); _findGeoWatch = null }
        window.removeEventListener('deviceorientationabsolute', _onAbsoluteOrientation)
        window.removeEventListener('deviceorientation',         _onRelativeOrientation)
        _gotAbsoluteOrientation = false
        _lastDistZone = null
    })

    // ── Gamified Rank (My Tasks Today): Bronze→Silver→Gold→Platinum→Diamond ──
    const RANK_TIERS = [
        { name: 'Bronze',   target: 20,  color: '#c8854f', glow: 'rgba(200,133,79,.55)'  },
        { name: 'Silver',   target: 50,  color: '#b9c4d6', glow: 'rgba(185,196,214,.55)' },
        { name: 'Gold',     target: 100, color: '#e8b94d', glow: 'rgba(232,185,77,.6)'   },
        { name: 'Platinum', target: 200, color: '#5fd4d0', glow: 'rgba(95,212,208,.6)'   },
        { name: 'Diamond',  target: 500, color: '#9f8bff', glow: 'rgba(159,139,255,.6)'  },
    ]
    const RANK_ICON_PATH = `<path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/>`
    let _lastRankName = null  // กันฉลอง level-up ตอนโหลดหน้าครั้งแรก

    function getRank(count) {
        for (const tier of RANK_TIERS) { if (count <= tier.target) return tier }
        return RANK_TIERS[RANK_TIERS.length - 1]
    }

    function renderTaskRank(count) {
        const tier = getRank(count)
        const idx  = RANK_TIERS.indexOf(tier)
        const next = RANK_TIERS[idx + 1]
        const atMax = !next && count >= tier.target

        document.getElementById('dashTaskCount').textContent  = count
        document.getElementById('dashTaskTarget').textContent = '/ ' + tier.target
        document.getElementById('dashRankName').textContent   = tier.name
        document.getElementById('dashRankIcon').innerHTML     = RANK_ICON_PATH
        document.getElementById('dashRankIcon').style.fill    = tier.color

        const pct = Math.min((count / tier.target) * 100, 100)
        const bar = document.getElementById('dashTaskBar')
        bar.style.width      = pct + '%'
        bar.style.background = `linear-gradient(90deg, ${tier.color}cc, ${tier.color})`

        const pill = document.getElementById('dashRankPill')
        pill.style.borderColor = tier.color + 'aa'
        pill.style.color       = tier.color

        const nextWrap = document.getElementById('dashRankNextWrap')
        if (next) {
            nextWrap.innerHTML = `<span style="opacity:.65"><strong>${next.target - count}</strong> to reach <strong>${next.name}</strong></span>`
        } else if (atMax) {
            nextWrap.innerHTML = `<span style="opacity:.8">🏆 สูงสุดแล้ว — เก่งมาก!</span>`
        }

        const card = document.getElementById('rankCard')
        card.style.setProperty('--rank-glow', tier.glow)

        // ฉลอง level-up เฉพาะตอนเปลี่ยน tier จริงๆ (ไม่ฉลองตอนโหลดหน้าครั้งแรก)
        if (_lastRankName !== null && _lastRankName !== tier.name) {
            document.getElementById('rankLevelUpBanner').textContent = `⭐ ${tier.name.toUpperCase()}!`
            card.classList.remove('level-up')
            requestAnimationFrame(() => {
                card.classList.add('level-up')
                setTimeout(() => card.classList.remove('level-up'), 1700)
            })
        }
        _lastRankName = tier.name
    }

    async function loadDashboardData() {
        const userJson = localStorage.getItem("user")
        const username = JSON.parse(userJson).username
        const todayStr = new Date().toISOString().slice(0, 10)

        // ── 1. นับ Tasks วันนี้ (fetch จนเจอเมื่อวาน) ──
        try {
            let todayCount = 0, page = 1, keepGoing = true
            while (keepGoing) {
                const data = await api("/transaction/get", "POST", {
                    page, pageSize: 50, performedBy: username, sortBy: "createdAt", desc: true
                })
                const batch = Array.isArray(data) ? data : (data?.data || [])
                if (!batch.length) break
                for (const t of batch) {
                    if ((t.createdAt || '').slice(0, 10) < todayStr) { keepGoing = false; break }
                    todayCount++
                }
                if (page >= (data?.totalPages ?? 1)) keepGoing = false
                page++
            }
            renderTaskRank(todayCount)
        } catch (err) {
            console.error('Failed to load task count:', err)
        }

        // ── 2. หา 10 WO ล่าสุด (50 transactions ไม่ filter วัน) ──
        try {
            const data = await api("/transaction/get", "POST", {
                page: 1, pageSize: 50, performedBy: username, sortBy: "createdAt", desc: true
            })
            const transactions = Array.isArray(data) ? data : (data?.data || [])
            const uniqueWorkOrders = []
            const seen = new Set()
            for (const item of transactions) {
                if (item.workOrder && !seen.has(item.workOrder)) {
                    seen.add(item.workOrder)
                    uniqueWorkOrders.push({ workOrder: item.workOrder, performedBy: item.performedBy, createdAt: item.createdAt })
                }
                if (uniqueWorkOrders.length === 10) break
            }
            return uniqueWorkOrders
        } catch (err) {
            console.error('Failed to load work orders:', err)
            return []
        }
    }
    
    function formatWODate(dateStr) {
        if(!dateStr) return "-";
        const d = new Date(dateStr);
        return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear().toString().substr(-2)} ${d.toLocaleTimeString()}`;
    }

    async function renderWorkOrders() {
        try {
            // 1. โหลดข้อมูลมาเก็บในตัวแปร
            const workOrders = await loadDashboardData(); 
            
            const container = document.getElementById('woListContainer');
            if (!container) return;
            
            container.innerHTML = ''; 

            if (workOrders.length === 0) {
                container.innerHTML = '<div class="p-3 text-center text-muted">No recent Work Orders</div>';
                return;
            }

            // 2. วน Loop สร้าง UI
            workOrders.forEach(wo => {
               // console.log(`Work Order : ${wo.workOrder}`)
                const itemHtml = `
                    <a onclick="loadDashLotSummary('${wo.workOrder}')"
                       class="list-group-item list-group-item-action border-0 d-flex align-items-center py-3">
                        
                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3" 
                             style="width: 45px; height: 45px; background-color: #eef2f7;">
                            <i class="bi bi-clipboard-check fs-5" style="color:var(--tint)"></i>
                        </div>

                        <div class="flex-grow-1">
                            <div class="fw-bold mb-0" style="color: #333;">${wo.workOrder}</div>
                            <small class="text-muted">${formatWODate(wo.createdAt)}</small>
                        </div>

                        <div class="text-muted">
                            <i class="bi bi-chevron-right"></i>
                        </div>
                    </a>
                `;
                container.innerHTML += itemHtml;
            });
        } catch (err) {
            const container = document.getElementById('woListContainer');
            if (container) container.innerHTML = `<div class="p-3 text-danger">Error: ${err.message}</div>`;
        }
    }

    async function init(){
        await loadLocation()
    }

    init()
  </script>
}