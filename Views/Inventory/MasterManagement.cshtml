    async function bomEditComp(bomId, compId, currentQty) {
        const qty = parseFloat(prompt('Quantity:', currentQty))
        if (!qty || qty <= 0) return
        try {
            await api(`/master/boms/${bomId}/components/${compId}`, 'PUT', { quantity: qty })
            bomLoadDetail(bomId)
        } catch (err) { alert('แก้ไขไม่สำเร็จ: ' + err.message) }
    }

    async function bomRemoveComp(bomId, compId) {
        if (!confirm('ลบ component นี้?')) return
        try {
            await api(`/master/boms/${bomId}/components/${compId}`, 'DELETE')
            bomLoadDetail(bomId)
        } catch (err) { alert('ลบไม่สำเร็จ: ' + err.message) }
    }

    function escJs(s) { return String(s).replace(/\\/g,"\\\\").replace(/'/g,"\\'") }

    function bomOpenImg(src, caption) {
