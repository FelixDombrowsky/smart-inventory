    function toggleLocMap() {
        const panel = document.getElementById('locMapPanel')
        const btn   = document.getElementById('locMapBtn')
        const open  = panel.style.display === 'none' || panel.style.display === ''
        panel.style.display = open ? 'block' : 'none'
        btn.classList.toggle('active', open)
        if (open) {
            if (!_locMap) initLocMap()
            else { _locMap.invalidateSize(); loadLocMapMarkers() }
        }
    }

    function initLocMap() {
        // Fix Leaflet marker icon path for local hosting
        delete L.Icon.Default.prototype._getIconUrl
        L.Icon.Default.mergeOptions({
            iconUrl:      '/lib/leaflet/marker-icon.png',
            iconRetinaUrl:'/lib/leaflet/marker-icon-2x.png',
            shadowUrl:    '/lib/leaflet/marker-shadow.png',
        })

        _locMap = L.map('locMap', {
            zoomControl: true,
            rotate: true,
            bearing: 0,
            minZoom: 17, maxZoom: 22
        })

        // รูปผังโรงงาน warp ตาม 4 พิกัดจริง
        _locImgOverlay = L.distortableImageOverlay(FACTORY_IMAGE, {
            corners: FACTORY_CORNERS.map(c => L.latLng(c[0], c[1])),
            mode: 'lock',
        }).addTo(_locMap)

        _locMap.fitBounds(FACTORY_BOUNDS, { padding: [20, 20] })
        _locMarkers = L.featureGroup().addTo(_locMap)
        loadLocMapMarkers()
    }

    function setMapBearing(deg) {
        document.getElementById('mapBearingVal').textContent = deg + '°'
        if (_locMap) _locMap.setBearing(parseFloat(deg))
    }

    function updateFactoryTransform() {
        const deg = parseFloat(document.getElementById('mapRotation').value)
        const x   = parseFloat(document.getElementById('mapOffsetX').value)
        const y   = parseFloat(document.getElementById('mapOffsetY').value)
        document.getElementById('mapRotationVal').textContent = deg + '°'
        document.getElementById('mapOffsetXVal').textContent  = x + 'px'
        document.getElementById('mapOffsetYVal').textContent  = y + 'px'

        if (_locMap) _locMap.setBearing(deg)

        // X/Y offset ยังใช้ CSS translate บน overlay สำหรับ fine-tune
        const el = _locImgOverlay?.getElement()
        if (el) {
            el.style.marginLeft = x + 'px'
            el.style.marginTop  = y + 'px'
        }
    }

    function changeMapTheme(key) {
        if (!_locMap) return

        // ลบ tile layer เดิม
        if (_locTileLayer) { _locMap.removeLayer(_locTileLayer); _locTileLayer = null }

        if (key === 'factory') {
            // แสดงรูปโรงงาน, ซ่อน tile
            if (_locImgOverlay) _locImgOverlay.setOpacity(1)
            _locMap.fitBounds(FACTORY_BOUNDS, { padding: [20, 20] })
            return
        }

        // ซ่อน/ลด opacity รูปโรงงาน เพื่อดู tile
        if (_locImgOverlay) _locImgOverlay.setOpacity(0.35)

        const t = MAP_THEMES[key]
        if (!t) return
        _locTileLayer = L.tileLayer(t.url, { attribution: t.attr, maxZoom: t.maxZoom }).addTo(_locMap)
        _locTileLayer.bringToBack()
    }

    async function loadLocMapMarkers() {
        _locMarkers.clearLayers()
        try {
            const res   = await api('/location?isActive=true&page=1&pageSize=200')
            const items = Array.isArray(res) ? res : (res?.data || [])
            const details = await Promise.allSettled(items.map(l => api(`/location/${l.id}`)))
            const validPts = []
            details.forEach(r => {
                if (r.status !== 'fulfilled') return
                const d = r.value
                if (!d || d.latitude == null || d.longitude == null) return
                if (d.latitude === 0 && d.longitude === 0) return
                validPts.push(d)
                const marker = L.marker([d.latitude, d.longitude])
                    .bindPopup(`
                        <div style="font-family:sans-serif;min-width:160px">
                            <div style="font-weight:700;font-size:14px;margin-bottom:4px">${d.locationCode}</div>
                            ${d.description ? `<div style="color:#6b7280;font-size:12px;margin-bottom:4px">${d.description}</div>` : ''}
                            <div style="display:flex;gap:6px;flex-wrap:wrap">
                                ${d.typeName ? `<span style="background:#e8f0ff;color:#1a6fff;font-size:11px;font-weight:700;padding:2px 7px;border-radius:10px">${d.typeName}</span>` : ''}
                                <span style="background:${d.isActive ? '#ecfdf5' : '#f0f2f5'};color:${d.isActive ? '#059669' : '#9ca3af'};font-size:11px;font-weight:700;padding:2px 7px;border-radius:10px">${d.isActive ? 'Active' : 'Inactive'}</span>
                            </div>
                            <div style="font-size:11px;color:#9ca3af;margin-top:6px">${d.latitude.toFixed(6)}, ${d.longitude.toFixed(6)}</div>
                            ${d.accuracy ? `<div style="font-size:11px;color:#9ca3af">Accuracy: ${d.accuracy}m</div>` : ''}
                        </div>`)
                    .addTo(_locMarkers)
            })
            if (validPts.length === 0) {
                L.popup()
                    .setLatLng(_locMap.getCenter())
                    .setContent('<div style="font-size:13px">ไม่พบ Location ที่มีพิกัด GPS</div>')
                    .openOn(_locMap)
            }
        } catch (err) {
            console.error('loadLocMapMarkers:', err)
        }
    }
</script>
}
<script src="/lib/leaflet/leaflet.js"></script>
