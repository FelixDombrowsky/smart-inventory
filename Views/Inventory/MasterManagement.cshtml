    async function editItem(partNo) {
        let x
        try {
            x = await api(`/master/items/${encodeURIComponent(partNo)}`)
        } catch (_) {
            x = _itemsCache[partNo]
        }
        if (!x) { showToast('ไม่พบข้อมูล Item', 'error'); return }
        const cached  = _itemsCache[partNo] || {}
        const imgPath = cached.imagePath || x.imagePath || ''
        document.getElementById('itemModalTitle').textContent = 'Edit Item'
        document.getElementById('itemId').value = x.id || ''
        document.getElementById('itemImagePath').value = imgPath
        document.getElementById('itemImagePreview').src = imgPath ? (CONFIG.INVENTORY_API + imgPath + '?t=' + _imgCacheBust) : NO_IMG
        document.getElementById('itemImageFile').value = ''
        _itemCapturedBlob = null
        document.getElementById('itemImgSourceBadge').style.display = 'none'
        document.getElementById('itemPartNo').value = x.partNo || x.part_no || partNo
        document.getElementById('itemPartNo').disabled = true
        document.getElementById('itemType').value = cached.itemTypeName || x.itemTypeName || cached.itemType || x.itemType || ''
        document.getElementById('itemName').value = x.itemName || x.name || ''
        document.getElementById('itemDescription').value = cached.description || x.description || ''
        document.getElementById('itemUnit').value = x.baseUnit || x.unit || ''
        document.getElementById('itemWeight').value = cached.weight ?? x.weight ?? ''
        document.getElementById('itemWeightUnit').value = cached.weightUnit || x.weightUnit || ''
        openModal('itemModal')
    }

    async function saveItem() {
        const partNo    = document.getElementById('itemPartNo').value.trim()
        const itemName  = document.getElementById('itemName').value.trim()
        const imageFile = document.getElementById('itemImageFile').files[0]
            ?? (_itemCapturedBlob ? new File([_itemCapturedBlob], 'photo.jpg', { type: 'image/jpeg' }) : null)

        if (!partNo || !itemName) { alert('กรุณากรอกข้อมูลให้ครบ'); return }

        const isEdit     = !!document.getElementById('itemId').value
        const cachedItem = _itemsCache[partNo] || {}
        const imagePath  = `/images/items/${partNo}/main.png`

        const body = { partNo, itemName }
        if (imageFile || cachedItem.imagePath) body.imagePath = imagePath

        const baseUnit   = document.getElementById('itemUnit').value.trim()
        const description = document.getElementById('itemDescription').value.trim()
        const itemType   = document.getElementById('itemType').value.trim()
        const weightVal  = document.getElementById('itemWeight').value.trim()
        const weightUnit = document.getElementById('itemWeightUnit').value.trim()

        if (baseUnit)    body.baseUnit    = baseUnit
        if (description) body.description = description
        if (itemType)    body.itemType    = itemType
        if (weightVal)   body.weight      = parseFloat(weightVal)
        if (weightUnit)  body.weightUnit  = weightUnit

        // Step 1: PUT ก่อนเสมอ
        try {
            if (isEdit) {
                await api(`/master/items/${encodeURIComponent(partNo)}`, 'PUT', body)
            } else {
                await api('/master/items', 'POST', body)
            }
        } catch (err) {
            alert('บันทึกไม่สำเร็จ: ' + err.message)
            return
        }

        // Step 2: Upload image เฉพาะเมื่อเลือกไฟล์ใหม่
        if (imageFile) {
            try {
                const form = new FormData()
                form.append('file', imageFile)
                const res = await fetch(`${CONFIG.INVENTORY_API}/inventory/items/${encodeURIComponent(partNo)}/upload-image`, {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') },
                    body: form
                })
                if (!res.ok) throw new Error(await res.text())
                _imgCacheBust = Date.now()
                showToast('บันทึกและอัปโหลดรูปสำเร็จ')
            } catch (err) {
                alert('บันทึกสำเร็จ แต่ upload รูปไม่สำเร็จ: ' + err.message)
            }
        } else {
            showToast(isEdit ? 'อัปเดต Item สำเร็จ' : 'สร้าง Item สำเร็จ')
        }

        closeModal('itemModal')

        if (isEdit) {
            loadItems(_itemsCurrentPage)
        } else {
            // Item ใหม่อาจไม่ได้อยู่หน้าเดิม → ค้นหาด้วย partNo แล้วเลื่อนไปไฮไลต์ให้เห็นทันที
            document.getElementById('itemSearch').value = partNo
            await loadItems(1)
            flashItemRow(partNo)
        }
    }

    function flashItemRow(partNo) {
        const row = document.querySelector(`#itemsTable tr[data-partno="${CSS.escape(partNo)}"]`)
        if (!row) return
        row.scrollIntoView({ behavior: 'smooth', block: 'center' })
        row.classList.add('row-flash')
        setTimeout(() => row.classList.remove('row-flash'), 1600)
    }

