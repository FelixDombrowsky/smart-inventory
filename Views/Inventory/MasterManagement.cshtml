    let _itemCamStream    = null

    function previewItemImage(input) {
        const file = input.files[0]
        if (!file) return
        _itemCapturedBlob = null
        document.getElementById('itemImgSourceBadge').style.display = 'none'
        const reader = new FileReader()
        reader.onload = e => { document.getElementById('itemImagePreview').src = e.target.result }
        reader.readAsDataURL(file)
