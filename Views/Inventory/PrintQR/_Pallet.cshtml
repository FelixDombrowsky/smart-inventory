<!-- ══════ TAB: PALLET ══════ -->
<div class="tab-pane" id="tab-pallet">
    <div class="card" style="overflow:visible">
        <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
            <div style="font-size:13px;font-weight:700;color:var(--navy);display:flex;align-items:center;gap:8px">
                <i class="bi bi-pallet" style="color:var(--blue)"></i>
                Pallet
                <span id="palCountBadge" class="count-badge"></span>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input id="palSearchNo" class="filter-input" placeholder="Pallet No." style="width:160px"
                       oninput="palDebouncedSearch()">
                <div style="position:relative;display:inline-block" title="กรองตามวันที่ (จากเลขที่ Pallet YYYYMMDD-NNNN) — ล้างช่องนี้เพื่อดูทุกวันที่">
                    <div id="palFilterDateDisplay" class="filter-input" style="width:150px;box-sizing:border-box;display:flex;align-items:center;gap:6px;cursor:pointer">
                        <i class="bi bi-calendar3" style="color:var(--t3);font-size:12px"></i>
                        <span id="palFilterDateText">All Dates</span>
                    </div>
                    <input id="palFilterDate" type="date" onclick="palOpenDatePicker(this)" onchange="palOnDateFilterChange()"
                           style="position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;border:none;padding:0;margin:0">
                </div>
                <!-- ปุ่ม All — เคลียร์ date filter ทิ้ง ดึง /mat-pallets มาเฉยๆ ไม่กรองอะไรเลย (ปกติต้องเคลียร์ผ่าน native date input เอง
                     ซึ่งไม่ค่อยมีใครรู้ว่าเคลียร์ได้ยังไง) -->
                <button type="button" id="palFilterAllBtn" onclick="palClearDateFilter()" title="แสดงทุก Pallet ไม่กรองตามวันที่"
                        style="padding:8px 14px;border:1.5px solid var(--blue);border-radius:8px;background:var(--blue-lt);color:var(--blue);font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s;white-space:nowrap">
                    All
                </button>
                <!-- ติ๊กไว้ (default) = กรองเหลือแต่ Pallet ใน Location ที่ตัวเองมีสิทธิ์เห็น (เหมือนพฤติกรรมเดิม) — ติ๊กออก = ดูทุก
                     Location เหมือน Admin ไม่ว่า role จริงจะเป็นอะไร (ไม่กระทบข้อมูลที่ backend ส่งมาอยู่แล้ว แค่ปลดฝั่ง client กรองเอง) -->
                <label style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--t2);cursor:pointer;white-space:nowrap;user-select:none" title="ติ๊กออกเพื่อดู Pallet ทุก Location เหมือน Admin">
                    <input type="checkbox" id="palMyLocationOnly" checked onchange="palOnMyLocationToggle()" style="width:15px;height:15px;accent-color:var(--blue);cursor:pointer">
                    My Location
                </label>
                <button class="btn-create" onclick="palOpenCreateModal()"><i class="bi bi-plus-lg"></i> Pallet</button>
            </div>
        </div>
        <!-- แต่ละใบ = การ์ดภาพ pallet + กองกล่อง (จำนวนกล่องที่โชว์ = จำนวน Lot จริง ดึงจาก /mat-pallets/{no}/lots แบบ parallel หลัง list โหลดเสร็จ) -->
        <div class="pal-card-grid" id="palGrid">
            <div class="pal-grid-empty">Loading…</div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-top:1px solid var(--border);flex-wrap:wrap;gap:10px">
            <div style="display:flex;align-items:center;gap:10px">
                <select class="pag-size" id="palPageSize" onchange="loadPallets(1)">
                    <option value="20" selected>20 rows</option>
                    <option value="50">50 rows</option>
                    <option value="100">100 rows</option>
                </select>
                <span class="pag-info" id="palPageInfo"></span>
            </div>
            <div class="pag-btns">
                <button id="palBtnPrev" class="pag-btn" onclick="palPrevPage()">← Prev</button>
                <span class="pag-page"  id="palPageNum">—</span>
                <button id="palBtnNext" class="pag-btn" onclick="palNextPage()">Next →</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ PALLET DETAIL MODAL — ดู Lots เป็นกล่องซ้อนชั้น 3x3 ต่อชั้น (1 Lot = 1 กล่อง) ══ -->
<div id="palDetailModal" style="display:none" onclick="if(event.target===this && !_palConfirmActive)palCloseDetail()">
    <div class="pal-detail-inner" id="palDetailInner">
        <button class="rp-preview-close" id="palDetailCloseBtn" onclick="_palConfirmActive ? _palConfirmResolve('dismiss') : palCloseDetail()">✕</button>

        <!-- เนื้อหาทั้งหมด scroll อยู่ในนี้ (แยกจาก footer ปุ่ม +) กัน FAB ลอยทับ Action button ของแถวสุดท้ายเวลา list สั้น
             พอดีจอ ไม่ต้อง scroll เลย (เดิมใช้ position:absolute ลอยทับเนื้อหาตรงๆ แก้ด้วย padding-bottom ไม่พอเสมอไป) -->
        <div class="pal-detail-scroll" id="palDetailScroll">
            <!-- Confirm bar — โชว์เฉพาะตอนเปิด modal นี้ผ่าน palOpenPalletConfirm() (เช่น จากแท็บ Receive ตอนเปลี่ยน Work Order
                 ทั้งที่มี Pallet เลือกค้างอยู่แล้ว) ไม่งั้นซ่อนตลอด ใช้ preview เดียวกับตอนคลิ๊กดู Pallet ในแท็บ Pallet ปกติเป๊ะๆ
                 (เนื้อหาด้านล่าง .pal-detail-head ลงไปมาจาก palOpenDetail()/palRenderStack() เดิมทั้งหมด ไม่ได้เขียนซ้ำ) -->
            <div class="pal-confirm-bar" id="palConfirmBar" style="display:none">
                <div class="pal-confirm-icon"><i class="bi bi-signpost-split"></i></div>
                <div class="pal-confirm-text">
                    <div class="pal-confirm-title" id="palConfirmTitle"></div>
                    <div class="pal-confirm-sub" id="palConfirmSub"></div>
                </div>
                <div class="pal-confirm-actions">
                    <button class="pal-confirm-btn pal-confirm-btn-new" id="palConfirmNewBtn" onclick="_palConfirmResolve('new')">
                        <i class="bi bi-plus-lg"></i> <span></span>
                    </button>
                    <button class="pal-confirm-btn pal-confirm-btn-continue" id="palConfirmContinueBtn" onclick="_palConfirmResolve('continue')">
                        <i class="bi bi-check2"></i> <span></span>
                    </button>
                </div>
            </div>

            <div class="pal-detail-head">
                <div class="pal-detail-no" id="palDetailNo">—</div>
                <div class="pal-detail-meta-row">
                    <div class="pal-detail-loc" id="palDetailLoc"></div>
                    <div class="pal-detail-lots"><i class="bi bi-box-seam"></i> <span id="palDetailLotCount">—</span> Lots</div>
                </div>
            </div>

            <!-- แผง Add Lot — 3 วิธี: Manual (พิมพ์เอง) / Camera (เปิดกล้องสแกน) / Scanner (เครื่องสแกนภายนอกแบบ keyboard wedge) -->
            <div class="pal-add-panel" id="palAddPanel" style="display:none">
                <div class="pal-add-tabs">
                    <button class="pal-add-tab active" data-mode="manual"  onclick="palSetAddMode('manual')"><i class="bi bi-keyboard"></i> Manual</button>
                    <button class="pal-add-tab"        data-mode="camera"  onclick="palSetAddMode('camera')"><i class="bi bi-camera"></i> Camera</button>
                    <button class="pal-add-tab"        data-mode="scanner" onclick="palSetAddMode('scanner')"><i class="bi bi-upc-scan"></i> Scanner</button>
                </div>

                <div class="pal-add-mode" id="palAddManual">
                    <div class="wo-autocomplete">
                        <input id="palManualInput" class="filter-input" style="width:100%;box-sizing:border-box"
                               placeholder="พิมพ์ Lot No. แล้วกด Enter" autocomplete="off"
                               oninput="palManualLotSearch()"
                               onkeydown="palManualLotKeydown(event)"
                               onblur="setTimeout(palHideManualDropdown, 150)">
                        <div id="palManualDropdown" class="wo-dropdown" style="display:none"></div>
                    </div>
                    <button class="btn-create" style="margin-top:8px;width:100%" onclick="palSubmitManualLot()">+ Add</button>
                </div>

                <div class="pal-add-mode" id="palAddCamera" style="display:none">
                    <div class="pal-cam-wrap">
                        <video id="palCamVideo" autoplay playsinline muted></video>
                        <canvas id="palCamCanvas"></canvas>
                    </div>
                    <div class="pal-scan-status" id="palCamLabel">— กำลังค้นหา barcode —</div>
                </div>

                <div class="pal-add-mode" id="palAddScanner" style="display:none">
                    <input id="palHwInput" class="filter-input" style="width:100%;box-sizing:border-box" placeholder="พร้อมสแกน…" autocomplete="off">
                    <div class="pal-scan-status" id="palHwStatus">พร้อมสแกน…</div>
                </div>

                <div class="pal-add-result" id="palAddResult"></div>
            </div>

            <div class="pal-stack" id="palStack">
                <div class="pal-empty">Loading…</div>
            </div>
        </div>

        <!-- Footer ปุ่ม + — อยู่นอก .pal-detail-scroll เป็น bar ปกติ (ไม่ใช่ position:absolute ลอยทับแล้ว) เลยไม่มีทางบังเนื้อหา
             ข้างในได้อีกต่อไป ไม่ว่า list จะสั้นหรือยาวแค่ไหน -->
        <div class="pal-detail-footer" id="palDetailFooter">
            <button class="pal-fab" id="palAddLotBtn" onclick="palToggleAddLot()" title="Add Lot">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
    </div>
</div>

<!-- ══ CREATE PALLET MODAL — POST /mat-pallets { currentLocationId, currentLocationCode } (matPalletNo auto-gen จาก backend) ══ -->
<div id="palCreateModal" style="display:none" onclick="if(event.target===this)palCloseCreateModal()">
    <div class="pal-create-inner">
        <button class="rp-preview-close" onclick="palCloseCreateModal()">✕</button>
        <div class="pal-create-title">Create Pallet</div>
        <label class="form-label" style="margin-bottom:5px">Location <span class="req">*</span></label>
        <div class="wo-autocomplete">
            <div style="position:relative">
                <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--t3);pointer-events:none;z-index:1"></i>
                <input id="palCreateLocInput" class="form-input" placeholder="ค้นหา Location..." autocomplete="off" style="padding-left:32px">
            </div>
            <div id="palCreateLocDropdown" class="wo-dropdown" style="display:none"></div>
        </div>
        <div class="pal-create-result" id="palCreateResult"></div>
        <button class="btn-create" id="palCreateSubmitBtn" style="margin-top:16px;width:100%" onclick="palSubmitCreatePallet()" disabled>Create</button>
    </div>
</div>

<!-- ── Delete Lot (from pallet) confirm modal — DELETE /mat-pallets/{MatPalletNo}/lots/{LotNo} ── -->
<div id="palDeleteLotModal" style="display:none" onclick="if(event.target===this)palCloseDeleteLotConfirm()">
    <div class="pal-delete-inner">
        <div class="pal-delete-title"><i class="bi bi-trash3" style="color:var(--red)"></i> Remove Lot from Pallet</div>
        <div class="pal-delete-sub">Remove lot <b id="palDeleteLotNo" style="font-family:ui-monospace,monospace;color:var(--navy)">—</b> from this pallet? This only removes it from the pallet — the lot itself is not deleted.</div>
        <div id="palDeleteLotError" style="display:none;font-size:12px;color:var(--red);font-weight:600;margin-bottom:12px"></div>
        <div class="pal-delete-actions">
            <button type="button" class="pal-delete-btn-cancel" onclick="palCloseDeleteLotConfirm()">Cancel</button>
            <button type="button" class="pal-delete-btn-confirm" id="palDeleteLotConfirmBtn" onclick="palConfirmDeleteLot()">Remove</button>
        </div>
    </div>
</div>

<script>
    // ── Pallet tab — grid การ์ดภาพ (แทนตารางเดิม) จาก /mat-pallets + modal ดู Lots แบบ Grid/Table ──
    let _palPage = 1, _palTotalPages = 1
    const PAL_ILLUST_COLS  = 5
    const PAL_ILLUST_MAX_N = 30   // จำกัดจำนวนกล่องที่วาด (เกินนี้โชว์ "+N" ต่อท้าย) กันภาพรก/สูงเกินการ์ด

    // gen เพิ่มทุกครั้งที่ loadPallets() รันใหม่ — กัน response ของ palFetchAndRenderCount() รอบเก่า (เช่น debounce search
    // ยิงซ้อนกันตอนพิมพ์เร็วๆ) มาถึงช้าแล้วเขียนทับการ์ดของรอบใหม่ที่ id ซ้ำกัน (idx นับ 0 ใหม่ทุกรอบ) ทำให้เห็น "N Lots" ถูก
    // แต่กล่องว่างเปล่า (มาจากคำตอบของ pallet คนละใบที่เคยอยู่ตำแหน่งนี้ในรอบก่อน)
    let _palRenderGen = 0

    // Pallet No. เป็นเลขที่ auto-gen รูปแบบ YYYYMMDD-NNNN (เช่น 20260910-0001) — backend ยังไม่มี field วันที่แยกต่างหาก
    // เลยใช้วันที่ที่ฝังอยู่ในเลขที่ pallet นี่แหละเป็นตัวกรอง "วันที่" แทน (ตัด - ออกแล้วส่งเป็น MatPalletNo search ตรงๆ)
    //
    // Default = All Dates (ไม่ตั้งวันที่ให้เลย) ตามที่ขอ — เดิม default เป็น Today (ดึงเวลาจาก /master/date-time-now มาตั้ง
    // ให้อัตโนมัติ) เปลี่ยนมาปล่อยว่างแทน ไม่ต้องยิง API เช็คเวลาเซิร์ฟเวอร์อีกต่อไป
    let _palDateInited = false
    function palEnsureDefaultDate() {
        if (_palDateInited) return
        _palDateInited = true
        palUpdateDateFilterText()
    }

    // input[type=date] จริงถูกวางทับ (opacity:0) บน div ที่โชว์ label แทน — เพื่อโชว์คำว่า "Today" แทนวันที่เวลาตรงกับวันนี้พอดี
    // (native date input เปลี่ยนข้อความในตัวเองไม่ได้ เลยต้องใช้ div ลอยทับแบบนี้แทน)
    //
    // ปัญหา "กดไม่ได้": input[type=date] ของ Chrome คลิกเปิด calendar picker ได้เฉพาะโดนไอคอนปฏิทินจริงของ browser (ฝั่งขวาสุดของ
    // input) เท่านั้น — ถ้าคลิกโดนช่องวัน/เดือน/ปี จะแค่ focus เข้าไปแก้ text segment เฉยๆ (มองไม่เห็นเพราะ opacity:0) เลยดูเหมือนกด
    // เฉยๆ ไม่มีอะไรเกิดขึ้น ยิ่งไอคอนปฏิทินปลอมที่โชว์ให้ user เห็นอยู่ฝั่งซ้ายของกล่อง (ตรงข้ามกับตำแหน่งไอคอนจริงของ input) คนเลย
    // มักคลิกพลาดโซนที่ไม่เปิด picker อยู่เสมอ — เรียก showPicker() ตรงๆ แทน ให้เปิด calendar ไม่ว่าจะคลิกโดนตรงไหนของกล่องก็ตาม
    function palOpenDatePicker(input) {
        if (typeof input.showPicker === 'function') {
            try { input.showPicker() } catch (_) {}
        }
    }

    function palUpdateDateFilterText() {
        const label   = document.getElementById('palFilterDateText')
        const allBtn  = document.getElementById('palFilterAllBtn')
        if (!label) return
        const val = document.getElementById('palFilterDate').value

        // ปุ่ม All ไฮไลต์เป็นสีฟ้าตอนไม่มีการกรองวันที่อยู่ (val ว่าง) — ให้เห็นชัดว่ากำลังดูโหมดไหนอยู่
        if (allBtn) {
            allBtn.style.borderColor = val ? 'var(--border)' : 'var(--blue)'
            allBtn.style.color       = val ? 'var(--text)'   : 'var(--blue)'
            allBtn.style.background  = val ? '#fff'          : 'var(--blue-lt)'
        }

        if (!val) { label.textContent = 'All Dates'; return }
        const [y, m, d] = val.split('-').map(Number)
        const now = new Date()
        if (y === now.getFullYear() && m === now.getMonth() + 1 && d === now.getDate()) {
            label.textContent = 'Today'
            return
        }
        label.textContent = new Date(y, m - 1, d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
    }

    // ปุ่ม All — เคลียร์ date filter ทิ้ง ดึง /mat-pallets มาเฉยๆ ไม่กรองอะไรเลย (loadPallets() เช็คว่า dateVal ว่างแล้ว fallback ไป
    // fetch ปกติแบบไม่ผ่าน palFetchPalletsForDate() อยู่แล้ว — ดูเงื่อนไข if (!search && dateVal) ด้านล่าง)
    function palClearDateFilter() {
        const input = document.getElementById('palFilterDate')
        if (!input.value) return   // ไม่มีอะไรต้องเคลียร์อยู่แล้ว
        input.value = ''
        palOnDateFilterChange()
    }

    function palOnDateFilterChange() {
        palUpdateDateFilterText()
        loadPallets(1)
    }

    // /mat-pallets?MatPalletNo=... ทำ exact match เท่านั้น (ไม่รองรับ partial/contains) — จะกรองตาม "วันที่" ต้องไล่ยิงทีละเลข
    // ตั้งแต่ YYYYMMDD-0001, -0002, ... ไปเรื่อยๆ จนกว่าจะเจอ totalCount=0 ถึงจะรู้ว่าวันนั้นมี pallet กี่ใบ (ตามที่ backend รองรับจริง)
    // cache ผลไว้ต่อวันที่ กัน re-scan ทุกครั้งที่เปลี่ยนหน้า/page size (scan ใหม่เฉพาะตอนเปลี่ยนวันที่ หรือหลังสร้าง pallet ใหม่)
    let _palDateCache = { date: null, rows: [] }

    async function palFetchPalletsForDate(dateStr, myGen) {
        if (_palDateCache.date === dateStr) return _palDateCache.rows
        const prefix = dateStr.replace(/-/g, '')
        const found  = []
        let seq = 1
        while (true) {
            if (myGen !== _palRenderGen) return found   // มีการเปลี่ยน filter/หน้าใหม่ระหว่างไล่ยิงอยู่ — เลิกยิงต่อ ทิ้งผลรอบนี้
            let res
            try {
                res = await api(`/mat-pallets?${new URLSearchParams({ MatPalletNo: `${prefix}-${String(seq).padStart(4, '0')}`, page: 1, pageSize: 1 })}`, 'GET')
            } catch (_) {
                break   // error ก็ถือว่าไม่เจอ หยุดไล่ต่อ (กันวนไม่รู้จบถ้า backend ล่ม)
            }
            const rows = res?.data ?? []
            if (!rows.length) break
            found.push(...rows)
            seq++
        }
        if (myGen === _palRenderGen) _palDateCache = { date: dateStr, rows: found }
        return found
    }

    // null = Admin เห็นทุก location ไม่ต้องกรอง, ไม่งั้น = Set ของ locationCode ที่ user มีสิทธิ์ canRead (จาก myLocations ที่
    // loadPerLocation() เตรียมไว้ใน loadLocation.js — pattern เดียวกับ filterPrintersByLocation() ใน js/loadPrinter.js)
    let _palMyLocationOnly = true   // checkbox "My Location" — default ติ๊กไว้ (กรองตามสิทธิ์) ปิดได้เพื่อดูทุก Location เหมือน Admin
    function palOnMyLocationToggle() {
        _palMyLocationOnly = document.getElementById('palMyLocationOnly').checked
        loadPallets(1)
    }

    function _palAllowedLocationCodes() {
        if (!_palMyLocationOnly) return null   // ติ๊กออก = ไม่กรอง เห็นทุก Location เหมือน Admin ไม่ว่า role จริงจะเป็นอะไร
        if (typeof isAdmin !== 'undefined' && isAdmin) return null
        return new Set((typeof myLocations !== 'undefined' ? myLocations : []).map(l => l.locationCode).filter(Boolean))
    }

    async function loadPallets(page = 1) {
        if (window._printQrLocationsReady) await window._printQrLocationsReady   // ต้องมี _locNameMap ก่อน ไม่งั้น badge location type ในการ์ดหา type ไม่เจอ
        await palEnsureDefaultDate()   // ตั้งค่า default = Today ครั้งแรกที่เปิดแท็บ Pallet เท่านั้น (ครั้งต่อไปข้ามเลย ไม่ทับค่าที่ user เปลี่ยนเอง)
        _palPage = page
        const myGen = ++_palRenderGen
        const search   = document.getElementById('palSearchNo').value.trim()
        const dateVal  = document.getElementById('palFilterDate').value   // 'YYYY-MM-DD' หรือว่างถ้า clear แล้ว (= ทุกวันที่)
        const ps       = parseInt(document.getElementById('palPageSize').value)

        document.getElementById('palGrid').innerHTML =
            `<div class="pal-grid-empty">Loading…</div>`
        try {
            let rows, total, cp
            const allowedLocs = _palAllowedLocationCodes()   // null = ไม่กรอง (Admin)

            if (!search && dateVal) {
                // กรองตามวันที่ (ไม่ได้พิมพ์ค้นหาเอง) — ไล่ยิง exact match ทีละเลขแล้ว paginate เอง client-side จากผลที่ scan ได้
                // กรอง location permission ก่อนคำนวณ total/pages เลย ถึงจะได้เลขหน้าที่ตรงกับที่ user เห็นจริง (ทำได้เพราะ scan มาครบทุกใบของวันนั้นอยู่แล้ว)
                let allRows = await palFetchPalletsForDate(dateVal, myGen)
                if (myGen !== _palRenderGen) return
                if (allowedLocs) allRows = allRows.filter(x => allowedLocs.has(x.locationCode))
                total = allRows.length
                _palTotalPages = Math.ceil(total / ps) || 1
                cp    = Math.min(page, _palTotalPages)
                rows  = allRows.slice((cp - 1) * ps, cp * ps)
            } else {
                // พิมพ์ค้นหาเอง (อาจอยากหาข้ามวันที่) หรือไม่ได้เลือกวันที่เลย — ใช้ paginate ปกติจาก server ตรงๆ
                // หมายเหตุ: กรอง location permission ทำได้แค่ "หลัง" fetch มาแล้ว (server ไม่มี query param กรองตาม location ให้)
                // เลย total/totalPages ที่โชว์อาจไม่ตรงกับจำนวนการ์ดที่เห็นจริงเป๊ะๆ ถ้ามีใบที่ถูกกรองออกอยู่ในหน้านั้น — เคสหลักที่ใช้บ่อย
                // (list ตามวันที่ ซึ่งเป็นค่า default) ถูกต้องเป๊ะอยู่แล้วจากเงื่อนไขด้านบน เคสนี้เกิดเฉพาะตอนพิมพ์ค้นหาเอง/กด All ล้าง filter วันที่
                const params = new URLSearchParams({ page, pageSize: ps })
                if (search) params.set('MatPalletNo', search)
                const res = await api(`/mat-pallets?${params}`, 'GET')
                if (myGen !== _palRenderGen) return   // มี loadPallets() รอบใหม่เริ่มไปแล้วระหว่างรอ response นี้ — ทิ้งผลรอบนี้ ไม่ต้อง render ทับ
                rows  = res?.data ?? []
                if (allowedLocs) rows = rows.filter(x => allowedLocs.has(x.locationCode))
                total = res?.totalCount ?? rows.length
                cp    = res?.page ?? page
                _palTotalPages = res?.totalPages ?? (Math.ceil(total / ps) || 1)
            }

            _palPage = cp
            document.getElementById('palCountBadge').textContent = total.toLocaleString() + ' records'
            document.getElementById('palPageInfo').textContent = `Page ${cp} / ${_palTotalPages}`
            document.getElementById('palPageNum').textContent  = cp
            document.getElementById('palBtnPrev').disabled = (cp <= 1)
            document.getElementById('palBtnNext').disabled = (cp >= _palTotalPages)

            document.getElementById('palGrid').innerHTML = rows.length === 0
                ? `<div class="pal-grid-empty">No records found</div>`
                : rows.map((x, i) => `<div class="pal-card" data-no="${escHtml(x.matPalletNo ?? '')}" data-loc="${escHtml(x.locationName ?? '')}" data-loccode="${escHtml(x.locationCode ?? '')}" onclick="palOpenDetail(this.dataset.no, this.dataset.loc, this.dataset.loccode)">
                    <div class="pal-illust">
                        <div class="pal-illust-stack" id="palIllustBoxes-${i}"></div>
                        <div class="pal-illust-base"></div>
                        <div class="pal-illust-loading" id="palIllustLoading-${i}"><span class="spinner-border spinner-border-sm" style="width:14px;height:14px;border-width:2px"></span></div>
                        <div class="pal-illust-more" id="palIllustMore-${i}" style="display:none"></div>
                    </div>
                    <div class="pal-card-foot">
                        <div class="pal-card-no">${escHtml(x.matPalletNo ?? '—')}</div>
                        <div class="pal-card-meta">
                            <span class="pal-card-loc">${x.locationCode ? rprLocBadge(x.locationCode) : `<i class="bi bi-geo-alt"></i> ${escHtml(x.locationName ?? '—')}`}</span>
                            <span class="pal-card-lots" id="palCardLots-${i}">···</span>
                        </div>
                    </div>
                </div>`).join('')

            // ยิงหา Lot count จริงของแต่ละใบแบบขนาน (endpoint เดียวกับตอนเปิด detail) แล้วค่อยวาดกองกล่อง/เลข Lot ทับ placeholder
            // ไม่ block การ render list หลัก — ใบไหนโหลดเสร็จก่อนก็ขึ้นก่อน
            rows.forEach((x, i) => palFetchAndRenderCount(x.matPalletNo, i, myGen))
        } catch (err) {
            document.getElementById('palGrid').innerHTML =
                `<div class="pal-grid-empty" style="color:var(--red)">Load failed: ${escHtml(err.message)}</div>`
        }
    }

    function palPrevPage() { if (_palPage > 1) loadPallets(_palPage - 1) }
    function palNextPage() { if (_palPage < _palTotalPages) loadPallets(_palPage + 1) }

    let _palSearchTimer = null
    function palDebouncedSearch() {
        clearTimeout(_palSearchTimer)
        _palSearchTimer = setTimeout(() => loadPallets(1), 400)
    }

    async function palFetchAndRenderCount(matPalletNo, idx, gen) {
        let rawLots = []
        let count   = 0
        try {
            const res = await api(`/mat-pallets/${encodeURIComponent(matPalletNo)}/lots`, 'GET')
            rawLots   = Array.isArray(res) ? res : (res?.data ?? [])
            count     = rawLots.length
        } catch (_) {
            count = -1   // โหลดไม่สำเร็จ — แยกจาก 0 (มี pallet จริงแต่ไม่มี lot) เพื่อโชว์ข้อความต่างกัน
        }
        if (gen !== _palRenderGen) return   // การ์ดชุดนี้ถูกแทนที่ด้วย loadPallets() รอบใหม่ไปแล้วระหว่างรอ response — ผลที่ได้มาช้าไม่เกี่ยวกับการ์ดที่เห็นอยู่ตอนนี้แล้ว

        const lotsEl = document.getElementById(`palCardLots-${idx}`)
        if (lotsEl) {
            lotsEl.innerHTML = count < 0
                ? `—`
                : `<i class="bi bi-box-seam"></i> ${count.toLocaleString()} Lot${count === 1 ? '' : 's'}`
        }

        if (count <= 0) { palRenderIllustBoxes(idx, []); return }

        // วาดกล่องเปล่า (ยังไม่รู้ print status) ไปก่อนให้เห็นจำนวนไวๆ ไม่ต้องรอ enrich — ค่อย enrich + เช็ค print status
        // ทีหลังแล้ว re-render อีกรอบให้กล่องเปลี่ยนสีตามสถานะจริง (เฉพาะ lot ที่วาดเป็นกล่องจริงแค่ PAL_ILLUST_MAX_N ตัวแรก
        // เกินนั้นไม่ได้วาดอยู่แล้วไม่ต้องเสีย call เพิ่ม)
        palRenderIllustBoxes(idx, rawLots)
        const boxLots  = rawLots.slice(0, PAL_ILLUST_MAX_N)
        const enriched = await palEnrichLots(boxLots)
        if (gen !== _palRenderGen) return
        await palEnsurePrintStatusCached(enriched)
        if (gen !== _palRenderGen) return
        palRenderIllustBoxes(idx, enriched)
    }

    // เติม _rprPrintStatusCache ให้ครบทุก lot ในนี้ (ตัวที่ยังไม่เคย cache) — แยกยิงเป็นก้อนต่อ Work Order ก่อน (เร็วกว่ายิงทีละ
    // Lot มาก ดู _palFetchPrintHistoriesByWorkOrder ด้านล่าง) ส่วน lot ที่ไม่มี W/O ผูกอยู่เลย fallback ไปยิงทีละ Lot แทน
    // (ปกติมีน้อยมาก) — ใช้ทั้งตอนวาดกล่องใน list card และตอนวาดตารางใน detail modal
    async function palEnsurePrintStatusCached(lots) {
        const uncached = lots.filter(l => l.lotNo && !(l.lotNo in _rprPrintStatusCache))
        if (!uncached.length) return

        const byWo = new Map()
        const noWo = []
        uncached.forEach(l => {
            if (l.workOrder && l.workOrder !== '—') {
                if (!byWo.has(l.workOrder)) byWo.set(l.workOrder, [])
                byWo.get(l.workOrder).push(l)
            } else {
                noWo.push(l)
            }
        })

        await Promise.all([...byWo.entries()].map(async ([wo, woLots]) => {
            const rows = await _palFetchPrintHistoriesByWorkOrder(wo)
            const seen = new Set()
            rows.forEach(r => {
                if (!r.lotNo || seen.has(r.lotNo)) return   // sort PrintedAt desc มาแล้ว — เจอ record แรกของแต่ละ lot = ล่าสุด
                seen.add(r.lotNo)
                _rprPrintStatusCache[r.lotNo] = { status: r.success ? 'success' : 'failed', errorMessage: r.errorMessage || '' }
            })
            woLots.forEach(l => {
                if (!(l.lotNo in _rprPrintStatusCache)) _rprPrintStatusCache[l.lotNo] = { status: 'none' }
            })
        }))

        if (noWo.length) {
            await Promise.all(noWo.map(async l => {
                _rprPrintStatusCache[l.lotNo] = await _rprFetchLatestPrintStatus(l.lotNo)
            }))
        }
    }

    // แยก HTML generator ออกมาจาก palRenderIllustBoxes เพื่อใช้ซ้ำตอน refresh การ์ดใน list หลัง Add Lot สำเร็จด้วย (ดู palUpdateListCard)
    // 1 Lot = 1 กล่องตรงๆ (ไม่มีสูตรลดทอนแล้ว) เรียงเต็มแถวละ PAL_ILLUST_COLS ก่อนค่อยขึ้นแถวใหม่ (ไม่กระจายมั่ว) — แถวแรก
    // (i=0..COLS-1) ติดฐาน pallet เสมอ แล้วค่อยซ้อนขึ้นด้านบนด้วย flex-direction:column-reverse (ดู .pal-illust-stack ใน
    // printqr.css) แถวสุดท้ายที่ไม่ครบจะจัดกึ่งกลางแถวนั้นเอง — เช่น 15 Lot = 3 แถว แถวละ 5 กล่องเป๊ะ
    //
    // สีกล่องอิงจาก print status จริงของแต่ละ lot (_rprPrintStatusCache เดียวกับที่ใช้ใน detail modal/Search W/O) —
    // ยังไม่ cache/ยังไม่เคยพิมพ์ = กล่องเหลืองเดิม, Success = เช็คเขียว, Failed = X แดง (ดู palEnsurePrintStatusCached)
    function palBuildBoxesHtml(lots) {
        if (!lots.length) return ''
        const boxLots  = lots.slice(0, PAL_ILLUST_MAX_N)
        const rowCount = Math.ceil(boxLots.length / PAL_ILLUST_COLS)
        let html = ''
        for (let r = 0; r < rowCount; r++) {
            const rowLots = boxLots.slice(r * PAL_ILLUST_COLS, r * PAL_ILLUST_COLS + PAL_ILLUST_COLS)
            html += `<div class="pal-illust-row">${rowLots.map((lot, c) => {
                const d     = _rprPrintStatusCache[lot.lotNo]
                const delay = (r * PAL_ILLUST_COLS + c) * 25
                const tip   = escHtml(lot.lotNo || '')
                if (d?.status === 'success') return `<div class="pal-cube pal-cube-success" style="animation-delay:${delay}ms" title="${tip} — Printed"><i class="bi bi-check-lg"></i></div>`
                if (d?.status === 'failed')  return `<div class="pal-cube pal-cube-failed"  style="animation-delay:${delay}ms" title="${tip} — Print Failed"><i class="bi bi-x-lg"></i></div>`
                return `<div class="pal-cube" style="animation-delay:${delay}ms" title="${tip}"></div>`
            }).join('')}</div>`
        }
        return html
    }

    function palRenderIllustBoxes(idx, lots) {
        const wrap      = document.getElementById(`palIllustBoxes-${idx}`)
        const loadingEl = document.getElementById(`palIllustLoading-${idx}`)
        const moreEl    = document.getElementById(`palIllustMore-${idx}`)
        if (!wrap) return
        if (loadingEl) loadingEl.remove()   // ได้ผลจริงมาแล้ว (ไม่ว่าจะมี lot หรือไม่) — เอา spinner ออก

        if (!lots.length) { wrap.innerHTML = ''; if (moreEl) moreEl.style.display = 'none'; return }   // 0 lot = ฐานเปล่าๆ ไม่มีข้อความทับ

        wrap.innerHTML = palBuildBoxesHtml(lots)

        if (moreEl) {
            if (lots.length > PAL_ILLUST_MAX_N) { moreEl.textContent = `+${lots.length - PAL_ILLUST_MAX_N}`; moreEl.style.display = '' }
            else moreEl.style.display = 'none'
        }
    }

    // ── Pallet detail modal: ดึง Lot ทั้งหมดของ Pallet No. นั้นมาจาก GET /mat-pallets/{MatPalletNo}/lots ──
    // แสดง Lot ทั้งหมดเป็นกล่อง 3 คอลัมน์ต่อแถว จัดกลุ่มตาม W/O (1 Pallet อาจมีหลาย W/O ปนกัน) — ไม่มี concept "Layer" แบบสุ่มจำนวนแล้ว
    let _palCurrentLots = []
    let _palCurrentPalletNo = null   // pallet ที่ modal เปิดอยู่ตอนนี้ — ให้ Add Lot รู้ว่าจะ POST เข้า pallet ไหน

    // ── Pallet confirm dialog — เรียกจาก _Receive.cshtml ตอนมี Pallet เลือกค้างอยู่แล้วแต่ user เปลี่ยน Work Order ใหม่
    // (กัน receive ต่อเข้า pallet เดิมข้าม W/O โดยไม่ได้ตั้งใจ) ใช้ modal + การ render เดียวกับตอนคลิ๊กดู Pallet ในแท็บ Pallet
    // เป๊ะๆ (เรียก palOpenDetail() ตรงๆ) แค่โชว์แถบถามยืนยันด้านบน + ซ่อนปุ่ม +/ปุ่มปิด บังคับให้ต้องเลือกอย่างใดอย่างหนึ่งก่อน ──
    let _palConfirmActive    = false
    let _palConfirmCallbacks = null

    async function palOpenPalletConfirm(matPalletNo, locationName, locationCode, { onContinue, onCreateNew, title } = {}) {
        _palConfirmActive    = true
        _palConfirmCallbacks = { onContinue, onCreateNew }

        // แถบนี้ตามที่ขอให้เป็นภาษาไทยตายตัวเสมอ ไม่ต้องสลับตาม getCurrentLang() เหมือนข้อความอื่นในหน้านี้ (ตัด subtitle
        // "You're currently using pallet..." ออกไปเลยตามที่ขอด้วย เหลือแค่ title คำถามสั้นๆ พอ) — title รับ override ได้ เพราะโมดัลนี้
        // ถูกเรียกจากหลาย trigger ตอนนี้ (เปลี่ยน W/O ขณะมี pallet ค้าง, หรือเจอ pallet ล่าสุดที่ location ตอนเข้าหน้าแรก) แต่ละอันคำถามไม่เหมือนกัน
        document.getElementById('palConfirmTitle').textContent = title || 'มีการเปลี่ยน Work Order — ต้องการใช้ Pallet นี้ต่อหรือไม่?'
        const subEl = document.getElementById('palConfirmSub')
        subEl.textContent = ''
        subEl.style.display = 'none'
        document.querySelector('#palConfirmContinueBtn span').textContent = 'ใช้ต่อ'
        document.querySelector('#palConfirmNewBtn span').textContent      = 'สร้างพาเลทใหม่'

        document.getElementById('palConfirmBar').style.display     = 'flex'
        document.getElementById('palDetailFooter').style.display   = 'none'   // ซ่อนปุ่ม + Add Lot ระหว่างรอ user ตัดสินใจ
        // ปุ่ม ✕ มุมบนขวา ปล่อยให้กดได้ตามปกติระหว่างรอตัดสินใจ (กด = ยกเลิก ไม่ทำอะไรเพิ่ม ดู _palConfirmResolve('dismiss'))

        await palOpenDetail(matPalletNo, locationName, locationCode)   // preview เดียวกับตอนคลิ๊ก Pallet ในแท็บ Pallet ทุกอย่าง
    }

    // choice: 'continue' | 'new' | 'dismiss' (กด ✕ ปิดเฉยๆ ไม่เลือกอะไร — ไม่เรียก callback ไหนเลย เท่ากับยกเลิก คงสถานะเดิมไว้)
    function _palConfirmResolve(choice) {
        const cbs = _palConfirmCallbacks
        _palConfirmActive    = false
        _palConfirmCallbacks = null
        document.getElementById('palConfirmBar').style.display     = 'none'
        document.getElementById('palDetailFooter').style.display   = ''
        palCloseDetail()
        if (choice === 'continue') cbs?.onContinue?.()
        else if (choice === 'new') cbs?.onCreateNew?.()
    }

    async function palOpenDetail(matPalletNo, locationName, locationCode) {
        _palCurrentPalletNo = matPalletNo
        document.getElementById('palDetailModal').style.display = 'flex'
        document.getElementById('palDetailNo').textContent    = matPalletNo
        // badge icon+สีตาม location type จริง (เหมือนการ์ด Pallet ในกริด) แทนข้อความเปล่าๆ — fallback เป็นข้อความถ้าไม่มี code
        document.getElementById('palDetailLoc').innerHTML     = locationCode
            ? rprLocBadge(locationCode)
            : (locationName ? `<i class="bi bi-geo-alt"></i> ${escHtml(locationName)}` : '')
        document.getElementById('palDetailLotCount').textContent = '—'
        document.getElementById('palStack').innerHTML =
            `<div class="pal-empty"><span class="spinner-border spinner-border-sm me-2" style="width:16px;height:16px;border-width:2px"></span>Loading…</div>`
        palCollapseAddLot()   // เปิด pallet ใหม่ทุกครั้ง พับแผง Add Lot ของใบก่อนหน้ากลับไปก่อนเสมอ

        let rawLots = []
        try {
            const res = await api(`/mat-pallets/${encodeURIComponent(matPalletNo)}/lots`, 'GET')
            rawLots = Array.isArray(res) ? res : (res?.data ?? [])
        } catch (err) {
            _palCurrentLots = []
            document.getElementById('palDetailLotCount').textContent = '0'
            document.getElementById('palStack').innerHTML =
                `<div class="pal-empty" style="color:var(--red)">Load failed: ${escHtml(err.message)}</div>`
            return
        }

        document.getElementById('palDetailLotCount').textContent = rawLots.length.toLocaleString()
        if (!rawLots.length) {
            _palCurrentLots = []
            document.getElementById('palStack').innerHTML = `<div class="pal-empty">No lots on this pallet</div>`
            return
        }

        // /mat-pallets/{no}/lots เองมีแค่ lotNo/rawBarcode/addedAt/addedBy ไม่มี W/O, Part No, จำนวน — ต้องยิง
        // POST /inventory/lots ทีละ Lot แบบขนานเพิ่ม (ยังไม่มี batch endpoint) ถึงจะเอามา Summary/group ตาม W/O ได้
        _palCurrentLots = await palEnrichLots(rawLots)
        palRenderStack(_palCurrentLots)
    }

    // เติม partNo/description/workOrder/onHandQty/location/locationType/reservedQty/available ให้แต่ละ lot จาก POST
    // /inventory/lots (endpoint เดียวกับที่ autocomplete ช่อง Manual ใช้อยู่แล้ว, field ชื่อเดียวกับที่ LotDetail.cshtml ใช้
    // — lot.location เป็น code, lot.locationType เป็นชื่อ type ใช้กับ locTypeBadge()/rprLocBadge() ได้ตรงๆ) — ยิงขนานทั้งหมดทีเดียว
    async function palEnrichLots(rawLots) {
        return Promise.all(rawLots.map(async lot => {
            try {
                const res    = await api('/inventory/lots', 'POST', { lotNo: lot.lotNo, page: 1, pageSize: 1 })
                const detail = (Array.isArray(res) ? res : (res?.data ?? []))[0]
                return {
                    ...lot,
                    partNo:       detail?.partNo       ?? null,
                    description:  detail?.description  ?? null,
                    workOrder:    detail?.workOrder     ?? null,
                    onHandQty:    detail?.onHandQty     ?? null,
                    location:     detail?.location      ?? null,
                    locationType: detail?.locationType  ?? null,
                    reservedQty:  detail?.reservedQty   ?? null,
                    available:    detail?.available     ?? null,
                }
            } catch (_) {
                return { ...lot, partNo: null, description: null, workOrder: null, onHandQty: null, location: null, locationType: null, reservedQty: null, available: null }
            }
        }))
    }

    // จัดกลุ่ม lot ตาม workOrder (Lot ที่ไม่มี W/O ติดมาเลยจัดไว้กลุ่ม "No W/O" รวมกัน) คืน array ของ
    // { workOrder, partNos: Set, locTypes: Set, totalQty, lots } เรียงตามลำดับที่เจอ W/O ครั้งแรกใน list
    function palGroupByWo(lots) {
        const order = []
        const map   = new Map()
        lots.forEach(lot => {
            const key = lot.workOrder || '—'
            if (!map.has(key)) { map.set(key, { workOrder: key, partNos: new Set(), locTypes: new Set(), totalQty: 0, lots: [] }); order.push(key) }
            const g = map.get(key)
            g.lots.push(lot)
            if (lot.partNo) g.partNos.add(lot.partNo)
            if (lot.locationType) g.locTypes.add(lot.locationType)
            g.totalQty += Number(lot.onHandQty || 0)
        })
        return order.map(k => map.get(k))
    }

    // จัดกลุ่มย่อยของ lot ในแต่ละ W/O อีกทีตาม Part No. (เก็บชื่อ/description ของ part นั้นไว้ด้วย) — เรียงตามลำดับที่เจอ
    // partNo ครั้งแรกใน list เดียวกับ palGroupByWo
    function palGroupByPart(lots) {
        const order = []
        const map   = new Map()
        lots.forEach(lot => {
            const key = lot.partNo || '—'
            if (!map.has(key)) { map.set(key, { partNo: key, description: '', totalQty: 0, lots: [] }); order.push(key) }
            const g = map.get(key)
            g.lots.push(lot)
            g.totalQty += Number(lot.onHandQty || 0)
            if (!g.description && lot.description) g.description = lot.description
        })
        return order.map(k => map.get(k))
    }

    // จัดกลุ่ม lot ของ part นี้ตาม onHandQty ที่เท่ากัน (lot รับเข้าคนละรอบมักมีจำนวนต่อ lot ไม่เท่ากันทั้งหมด แต่ส่วนใหญ่จะซ้ำกัน
    // เป็นกลุ่มๆ) แต่ละกลุ่มคือ 1 แถวย่อยใน cell เดียวกัน (Qty x Lots = Total ของกลุ่มนั้น) เรียงจากกลุ่มที่มี lot เยอะสุดก่อน
    function palQtyGroups(pg) {
        const map = new Map()
        pg.lots.forEach(l => {
            const qty = Number(l.onHandQty || 0)
            map.set(qty, (map.get(qty) || 0) + 1)
        })
        return [...map.entries()]
            .map(([qty, count]) => ({ qty, count, total: qty * count }))
            .sort((a, b) => b.count - a.count || b.qty - a.qty)
    }

    function palPsId(lotNo) {
        return 'palps_' + String(lotNo || '').replace(/[^a-zA-Z0-9]/g, '_')
    }

    function palPartPsId(key) {
        return 'palpps_' + String(key || '').replace(/[^a-zA-Z0-9]/g, '_')
    }

    // สรุป Print Status รวมของทุก lot ใน part group นี้ — โชว์ที่แถว Part เอง เหมือน _rprWoPartPrintStatusCell() ใน
    // _Reprint.cshtml (ใช้ _rprPrintStatusCache/_rprFetchLatestPrintStatus/_rprPsBadgeHtml ตัวเดียวกันข้ามไฟล์ ไม่ต้อง
    // เขียนซ้ำ/ยิง API ซ้ำถ้า lot เดิมเคยถูกเช็คไปแล้วจากฝั่ง Search W/O)
    function palPartPrintStatusCell(lots) {
        const withLot = (lots || []).filter(l => l.lotNo)
        if (!withLot.length) return '<span style="color:var(--t3)">—</span>'
        const statuses = withLot.map(l => _rprPrintStatusCache[l.lotNo])
        if (statuses.some(d => !d)) return '<span style="color:var(--t3);font-size:11px">⏳</span>'
        const failed     = statuses.filter(d => d.status === 'failed').length
        const notPrinted = statuses.filter(d => d.status === 'none').length
        if (failed > 0)
            return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:var(--red-lt);color:var(--red);white-space:nowrap">✗ Failed (${failed})</span>`
        if (notPrinted > 0)
            return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:#f0f2f5;color:#6b7280;white-space:nowrap">${notPrinted} Not Printed</span>`
        return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:var(--green-lt);color:var(--green);white-space:nowrap">✓ Printed</span>`
    }

    // ยิงทีละ Lot ด้วย /printer/histories?lotNo=... (เหมือน _rprFetchLatestPrintStatus เดิม) พบว่าช้ามาก/ไม่ตอบเลยกับบาง
    // lot — เปลี่ยนมายิงทีละ Work Order แทน (ดู palLoadPrintStatusesForWo ด้านล่าง) เก็บฟังก์ชันนี้ไว้เป็น fallback สำหรับ lot
    // ที่ไม่มี W/O ผูกอยู่เท่านั้น (filter ตาม workOrder ไม่ได้)
    //
    // ดึง /printer/histories ทั้งก้อนของ Work Order เดียว (รองรับ query param "workOrder" ตรงๆ ตามที่ทดสอบเจอจาก DevTools —
    // เร็วกว่ายิงทีละ Lot มาก) เรียง sortBy=PrintedAt&sortDesc=true แล้วไล่หา record แรกที่เจอของแต่ละ lotNo = ล่าสุดของ lot นั้น
    // (ไม่ต้องเทียบวันที่เองอีกชั้นเพราะ sort มาให้แล้ว) ต้อง paginate ให้ครบ totalCount ไม่งั้น lot ที่พิมพ์ล่าสุดนานแล้วอาจตกหล่น
    async function _palFetchPrintHistoriesByWorkOrder(workOrder) {
        const PAGE_SIZE = 200
        let all = []
        try {
            const qs    = extra => `workOrder=${encodeURIComponent(workOrder)}&sortBy=PrintedAt&sortDesc=true&page=${extra}&pageSize=${PAGE_SIZE}`
            const first = await api(`/printer/histories?${qs(1)}`, 'GET')
            all         = first?.data || []
            const total = first?.totalCount ?? all.length
            const pages = Math.ceil(total / PAGE_SIZE) || 1
            if (pages > 1) {
                const rest = await Promise.all(
                    Array.from({ length: pages - 1 }, (_, i) => api(`/printer/histories?${qs(i + 2)}`, 'GET'))
                )
                rest.forEach(r => { all = all.concat(r?.data || []) })
            }
        } catch (_) {}
        return all
    }

    // ยิงเช็คของ "ทุก lot ที่แสดงอยู่ในตารางตอนนี้" (ไม่ใช่แค่ part ที่ expand) เพราะคอลัมน์ Print Status ที่แถว Part ต้องสรุปรวมเสมอ
    // partGroupsFlat = [{ key, lots }] ของ Work Order นี้เท่านั้น ใช้ patch คอลัมน์สรุปที่แถว Part หลัง fetch เสร็จ
    async function palLoadPrintStatusesForWo(workOrder, lots, partGroupsFlat) {
        const uncached = lots.filter(l => l.lotNo && !(l.lotNo in _rprPrintStatusCache))
        if (uncached.length) {
            if (workOrder && workOrder !== '—') {
                const rows = await _palFetchPrintHistoriesByWorkOrder(workOrder)
                const seen = new Set()
                rows.forEach(r => {
                    if (!r.lotNo || seen.has(r.lotNo)) return   // sort PrintedAt desc มาแล้ว — เจอ record แรกของแต่ละ lot = ล่าสุด
                    seen.add(r.lotNo)
                    _rprPrintStatusCache[r.lotNo] = { status: r.success ? 'success' : 'failed', errorMessage: r.errorMessage || '' }
                })
                uncached.forEach(l => {
                    if (!(l.lotNo in _rprPrintStatusCache)) _rprPrintStatusCache[l.lotNo] = { status: 'none' }
                })
            } else {
                // lot ที่ไม่มี W/O ผูกอยู่ — filter ตาม workOrder ไม่ได้ fallback ไปยิงทีละ Lot แทน (ปกติมีน้อยมาก)
                await Promise.all(uncached.map(async l => {
                    _rprPrintStatusCache[l.lotNo] = await _rprFetchLatestPrintStatus(l.lotNo)
                }))
            }
        }
        lots.forEach(l => {
            if (!l.lotNo) return
            const el = document.getElementById(palPsId(l.lotNo))
            const d  = _rprPrintStatusCache[l.lotNo]
            if (el && d) el.innerHTML = _rprPsBadgeHtml(d)
        })
        partGroupsFlat.forEach(pg => {
            const el = document.getElementById(palPartPsId(pg.key))
            if (el) el.innerHTML = palPartPrintStatusCell(pg.lots)
        })
    }

    // แยกกลุ่ม lot ของ part นี้เป็น 2 ชั้นเหมือนหน้า Search W/O ใน _Reprint.cshtml: ชั้นนอกตาม Location Type ชั้นในตาม Location จริง
    // แต่ละจุด (ปกติ lot ในพาเลทเดียวกันจะอยู่ location เดียวกับตัวพาเลทเองอยู่แล้ว แต่ทำเผื่อไว้เกิดข้อมูลไม่ sync ให้เห็นได้ตรงๆ)
    function palLotGroupsHtml(lots) {
        const byLoc = {}
        lots.forEach(l => {
            const loc = l.location || 'UNKNOWN'
            if (!byLoc[loc]) byLoc[loc] = []
            byLoc[loc].push(l)
        })
        // แค่เรียง location ให้ type เดียวกันอยู่ติดกัน (ตามลำดับที่เจอ type นั้นครั้งแรก) ไม่ครอบด้วย band ของ type ซ้อนอีกชั้น
        // เพราะเปลืองพื้นที่ (ซ้ำซ้อนเวลามี location เดียวในกลุ่มนั้น) — แค่ปะติดกันให้ดูเป็นกลุ่มเดียวกันก็พอ
        const typeOrder = []
        const byType    = {}
        Object.entries(byLoc).forEach(([loc, locLots]) => {
            const type = (locLots[0]?.locationType || '').trim() || 'Unknown'
            if (!byType[type]) { byType[type] = []; typeOrder.push(type) }
            byType[type].push([loc, locLots])
        })
        const sortedLocEntries = typeOrder.flatMap(type => byType[type])
        return sortedLocEntries.map(([locCode, locLots]) => palLocBoxHtml(locCode, locLots)).join('')
    }

    // กล่องของ location จริงหนึ่งจุด (ชั้นในของ palLotGroupsHtml) — 1 กล่องต่อ 1 location พร้อมตาราง lot ของจุดนั้น
    // ใช้ rprLocBadge(code) จาก _Reprint.cshtml ตรงๆ (icon+สีตาม type, label = ชื่อ location จริง) ไม่ต้องเขียนซ้ำ
    function palLocBoxHtml(locCode, locLots) {
        const onHandSum = locLots.reduce((s, l) => s + Number(l.onHandQty || 0), 0)
        const rows = locLots.map(l => {
            const reserved = Number(l.reservedQty || 0)
            return `<tr>
                <td style="padding:7px 12px;border-bottom:1px solid #eef0f5;font-family:ui-monospace,monospace;font-weight:700;color:var(--navy);font-size:12px">${escHtml(l.lotNo || '—')}</td>
                <td style="padding:7px 12px;border-bottom:1px solid #eef0f5;color:var(--text)">${Number(l.onHandQty || 0).toLocaleString()}</td>
                <td style="padding:7px 12px;border-bottom:1px solid #eef0f5"><span style="color:${reserved > 0 ? '#d97706' : 'var(--text)'};font-weight:${reserved > 0 ? 700 : 400}">${reserved.toLocaleString()}</span></td>
                <td style="padding:7px 12px;border-bottom:1px solid #eef0f5"><span style="color:var(--green);font-weight:700">${Number(l.available || 0).toLocaleString()}</span></td>
                <td style="padding:7px 12px;border-bottom:1px solid #eef0f5"><span id="${palPsId(l.lotNo)}">${_rprPsBadgeHtml(_rprPrintStatusCache[l.lotNo])}</span></td>
                <td style="padding:7px 12px;border-bottom:1px solid #eef0f5;text-align:center;position:relative">
                    <button type="button" class="pal-lot-action-btn" onclick="togglePalLotActionMenu(event, '${String(l.lotNo || '').replace(/'/g, "\\'")}')"><i class="bi bi-three-dots"></i></button>
                </td>
            </tr>`
        }).join('')

        return `<div style="background:#fff;border:1px solid var(--border);border-radius:9px;overflow:hidden;margin:8px 10px">
            <div style="display:flex;align-items:center;gap:10px;padding:7px 12px;background:#f6f8ff;border-bottom:1px solid var(--border)">
                ${rprLocBadge(locCode)}
                <span style="margin-left:auto;font-size:11.5px;color:var(--t2);font-weight:600;white-space:nowrap">${onHandSum.toLocaleString()} on hand · ${locLots.length} lot${locLots.length === 1 ? '' : 's'}</span>
            </div>
            <div style="max-height:220px;overflow-y:auto">
                <table style="width:100%;border-collapse:collapse;font-size:13px">
                    <thead>
                        <tr>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Lot No.</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">On Hand</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Reserved</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Available</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Print Status</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:center;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border);width:50px">Action</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>
        </div>`
    }

    // ── Action menu (⋯ ต่อแถว lot) — ตอนนี้มีแค่ Delete (From Pallet) แต่ทำ dropdown ไว้เผื่อเพิ่ม action อื่นทีหลัง
    // append ไปที่ <body> ตรงๆ (position:fixed) กัน overflow-y:auto ของ .pal-detail-inner/กล่อง location บัง เหมือน
    // pattern เดียวกับ toggleMrActionMenu ใน Order.cshtml ──
    function closePalLotActionMenu() {
        document.getElementById('palLotActionMenu')?.remove()
        document.querySelector('.pal-lot-action-btn.active')?.classList.remove('active')
    }
    document.addEventListener('click', closePalLotActionMenu)

    function togglePalLotActionMenu(e, lotNo) {
        e.stopPropagation()
        const btn = e.currentTarget
        const wasOpen = btn.classList.contains('active')
        closePalLotActionMenu()
        if (wasOpen) return

        const rect = btn.getBoundingClientRect()
        const menu = document.createElement('div')
        menu.id        = 'palLotActionMenu'
        menu.className = 'pal-lot-action-menu'
        menu.style.top   = (rect.bottom + 4) + 'px'
        menu.style.right = (window.innerWidth - rect.right) + 'px'
        menu.innerHTML   = `<div class="pal-lot-action-item danger" onclick="closePalLotActionMenu();palOpenDeleteLotConfirm('${lotNo.replace(/'/g, "\\'")}')">
            <i class="bi bi-trash3"></i> Remove
        </div>`
        menu.addEventListener('click', ev => ev.stopPropagation())
        document.body.appendChild(menu)
        btn.classList.add('active')
    }

    // ── Delete Lot from Pallet — DELETE /mat-pallets/{MatPalletNo}/lots/{LotNo} (ลบแค่ความสัมพันธ์กับพาเลทนี้ ไม่ได้ลบ lot จริง) ──
    let _palDeleteLotTarget = null
    function palOpenDeleteLotConfirm(lotNo) {
        _palDeleteLotTarget = lotNo
        document.getElementById('palDeleteLotNo').textContent = lotNo
        document.getElementById('palDeleteLotConfirmBtn').disabled = false
        document.getElementById('palDeleteLotConfirmBtn').textContent = 'Remove'
        document.getElementById('palDeleteLotError').style.display = 'none'
        document.getElementById('palDeleteLotModal').style.display = 'flex'
    }
    function palCloseDeleteLotConfirm() {
        _palDeleteLotTarget = null
        document.getElementById('palDeleteLotModal').style.display = 'none'
    }
    async function palConfirmDeleteLot() {
        if (!_palDeleteLotTarget || !_palCurrentPalletNo) return
        const btn = document.getElementById('palDeleteLotConfirmBtn')
        const errEl = document.getElementById('palDeleteLotError')
        errEl.style.display = 'none'
        btn.disabled = true
        btn.textContent = 'Removing…'
        try {
            await api(`/mat-pallets/${encodeURIComponent(_palCurrentPalletNo)}/lots/${encodeURIComponent(_palDeleteLotTarget)}`, 'DELETE')
            palCloseDeleteLotConfirm()
            await palReloadCurrentLots()
        } catch (err) {
            btn.disabled = false
            btn.textContent = 'Remove'
            errEl.textContent = 'Remove ไม่สำเร็จ: ' + err.message
            errEl.style.display = 'block'
        }
    }

    // ขยายได้ทีละ Part เท่านั้น (ข้าม W/O group ได้ด้วย key = "workOrder|partNo") — เปิด Part ใหม่ = หุบตัวที่เปิดค้างไว้ก่อนหน้า
    let _palExpandedKey = null
    function palToggleExpand(key) {
        _palExpandedKey = _palExpandedKey === key ? null : key
        palRenderStack(_palCurrentLots)
    }

    // โครงสร้าง 2 ชั้น: W/O -> ตาราง Part No. (Part/Locations/Lots/Print Status) กด expand แต่ละแถวดู lot ย่อยได้ — ปรับจาก
    // box-grid เดิมเป็น row-table style เดียวกับ Lot Summary ของ Search W/O ใน _Reprint.cshtml (ไม่มี OnHand vs Target เพราะ
    // พาเลทไม่มี BOM/target ให้เทียบ)
    function palWoBodyId(workOrder) {
        return 'palWoBody_' + String(workOrder || '').replace(/[^a-zA-Z0-9]/g, '_')
    }

    // ยุบ/ขยายแถว Part ทั้งหมดของ W/O นั้น (เก็บ state ไว้ที่ class บน tbody เอง ไม่ต้อง re-render ทั้งก้อนใหม่)
    function palToggleWoCollapse(woBodyId) {
        const tbody = document.getElementById(woBodyId)
        if (!tbody) return
        const collapsed = tbody.classList.toggle('pal-wo-collapsed')
        const icon = tbody.querySelector('.pal-wo-header-row i.bi-chevron-down, .pal-wo-header-row i.bi-chevron-right')
        if (icon) {
            icon.classList.toggle('bi-chevron-down', !collapsed)
            icon.classList.toggle('bi-chevron-right', collapsed)
        }
    }

    function palRenderStack(lots) {
        const stack = document.getElementById('palStack')
        if (!lots.length) { stack.innerHTML = `<div class="pal-empty">No lots on this pallet</div>`; return }

        const woGroups = palGroupByWo(lots)
        const wgPartGroups = []   // [{ workOrder, lots, partGroupsFlat }] ต่อ W/O — ใช้ยิงเช็ค Print Status แยกทีละ W/O ทีหลัง

        // ตารางเดียวทั้ง .pal-stack — thead โผล่แค่ครั้งเดียวบนสุด แต่ละ W/O เป็นแค่ <tbody> แยก (ไม่ใช่ <table> แยกทั้งก้อนเหมือนเดิม
        // ที่ทำให้ thead ซ้ำทุก W/O) — แถวแรกของแต่ละ tbody คือ header ของ W/O นั้น (ย้ายมาจาก #palSummary เดิม) กดแล้วยุบ/ขยาย
        // แถว Part ที่เหลือใน tbody เดียวกันได้ (.pal-wo-collapsed ซ่อนทุกแถวยกเว้นแถว header เอง)
        const woBody = woGroups.map(wg => {
            const partGroups     = palGroupByPart(wg.lots)
            const partGroupsFlat = []   // เก็บ { key, lots } ของทุก part ใน W/O นี้ไว้แบน — ใช้ตอน patch Print Status cell ทีหลัง
            wgPartGroups.push({ workOrder: wg.workOrder, lots: wg.lots, partGroupsFlat })
            const woBodyId = palWoBodyId(wg.workOrder)
            return `<tbody id="${woBodyId}">
                        <tr class="pal-wo-header-row" onclick="palToggleWoCollapse('${woBodyId}')">
                            <td colspan="8" style="padding:10px 12px">
                                <div style="display:flex;align-items:center;gap:10px">
                                    <i class="bi bi-chevron-down" style="font-size:11px;color:var(--t2);transition:transform .15s;flex-shrink:0"></i>
                                    <span style="font-weight:800;font-size:13px;color:var(--navy);display:flex;align-items:center;gap:6px;white-space:nowrap"><i class="bi bi-file-earmark-text" style="color:var(--t2)"></i> ${escHtml(wg.workOrder)}</span>
                                    <div style="margin-left:auto;display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end">
                                        ${[...wg.locTypes].map(t => locTypeBadge(t)).join('')}
                                        <span style="font-size:11px;color:var(--t3);font-weight:700;white-space:nowrap">${wg.lots.length} Lot${wg.lots.length === 1 ? '' : 's'}</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        ${partGroups.map(pg => {
                            const key = `${wg.workOrder}|${pg.partNo}`
                            partGroupsFlat.push({ key, lots: pg.lots })
                            const open      = _palExpandedKey === key
                            const locTypes  = [...new Set(pg.lots.map(l => (l.locationType || '').trim()).filter(Boolean))]
                            const locBadges = locTypes.map(t => locTypeBadge(t)).join('')
                            return `<tr style="cursor:pointer" onclick="palToggleExpand('${key.replace(/'/g, "\\'")}')">
                                    <td style="padding:8px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                                        <button type="button" style="width:22px;height:22px;border-radius:6px;border:1.5px solid var(--border);background:#fff;display:flex;align-items:center;justify-content:center;transition:transform .15s;${open ? 'transform:rotate(90deg);background:var(--blue);border-color:var(--blue);color:#fff' : 'color:var(--t2)'}">
                                            <i class="bi bi-chevron-right" style="font-size:10px"></i>
                                        </button>
                                    </td>
                                    <td style="padding:8px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                                        <div style="font-family:ui-monospace,monospace;font-weight:700;font-size:12.5px;color:var(--navy)">${escHtml(pg.partNo)}</div>
                                        ${pg.description ? `<div style="font-size:11px;color:var(--t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px" title="${escHtml(pg.description)}">${escHtml(pg.description)}</div>` : ''}
                                    </td>
                                    <td style="padding:8px;border-bottom:1px solid #f4f4f7;vertical-align:middle"><div style="display:flex;flex-wrap:wrap;gap:4px">${locBadges}</div></td>
                                    ${(() => {
                                        // กลุ่มตาม onHandQty ที่เท่ากัน — หลายกลุ่มในแถวเดียวกันของ Part นี้ก็เรียงเป็นบรรทัดซ้อนกันได้
                                        // ใน 4 cell (Qty/×/Lots/Total) พร้อมกัน ให้ตรงแถวกันเป็นคู่ๆ (line-height/gap เท่ากันทุก cell)
                                        const groups = palQtyGroups(pg)
                                        const lineStyle = 'display:flex;flex-direction:column;gap:5px'
                                        return `
                                    <td style="padding:8px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                                        <div style="${lineStyle}">${groups.map(g => `<span style="font-weight:700;font-size:12.5px;color:var(--navy);white-space:nowrap;line-height:20px">${g.qty.toLocaleString()}</span>`).join('')}</div>
                                    </td>
                                    <td style="padding:8px 0;border-bottom:1px solid #f4f4f7;vertical-align:middle;text-align:center;color:var(--t3);font-size:11px">
                                        <div style="${lineStyle}">${groups.map(() => `<span style="line-height:20px">×</span>`).join('')}</div>
                                    </td>
                                    <td style="padding:8px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                                        <div style="${lineStyle}">${groups.map(g => `<span style="background:#f0f2f5;color:#475569;padding:2px 8px;border-radius:5px;font-size:11px;font-weight:600;white-space:nowrap;align-self:flex-start">${g.count}</span>`).join('')}</div>
                                    </td>
                                    <td style="padding:8px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                                        <div style="${lineStyle}">${groups.map(g => `<span style="font-weight:700;font-size:12.5px;color:var(--navy);white-space:nowrap;line-height:20px">${g.total.toLocaleString()}</span>`).join('')}</div>
                                    </td>`
                                    })()}
                                    <td style="padding:8px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                                        <span id="${palPartPsId(key)}">${palPartPrintStatusCell(pg.lots)}</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="8" style="padding:0;border-bottom:${open ? '1px solid var(--border)' : 'none'}">
                                        <div style="${open ? '' : 'display:none'};background:#f8faff;padding:2px 0">${open ? palLotGroupsHtml(pg.lots) : ''}</div>
                                    </td>
                                </tr>`
                        }).join('')}
                    </tbody>`
        }).join('')

        stack.innerHTML = `<table style="width:100%;border-collapse:collapse">
            <thead>
                <tr>
                    <th style="width:26px;padding:6px 8px;border-bottom:1px solid var(--border)"></th>
                    <th style="text-align:left;padding:6px 8px;font-size:10.5px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Part</th>
                    <th style="text-align:left;padding:6px 8px;font-size:10.5px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Locations</th>
                    <th style="text-align:left;padding:6px 8px;font-size:10.5px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border);width:70px">Qty</th>
                    <th style="width:18px;padding:6px 0;border-bottom:1px solid var(--border)"></th>
                    <th style="text-align:left;padding:6px 8px;font-size:10.5px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border);width:60px">Lots</th>
                    <th style="text-align:left;padding:6px 8px;font-size:10.5px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border);width:70px">Total</th>
                    <th style="text-align:left;padding:6px 8px;font-size:10.5px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border);width:120px">Print Status</th>
                </tr>
            </thead>
            ${woBody}
        </table>`

        // ยิงเช็ค Print Status แยกทีละ Work Order (ไม่ใช่ทีละ Lot) — /printer/histories รองรับกรองด้วย workOrder โดยตรงและตอบเร็ว
        // กว่ายิงทีละ Lot มาก (ดู palLoadPrintStatusesForWo/_palFetchPrintHistoriesByWorkOrder ด้านบน)
        wgPartGroups.forEach(w => palLoadPrintStatusesForWo(w.workOrder, w.lots, w.partGroupsFlat))
    }

    function palCloseDetail() {
        palCollapseAddLot()
        document.getElementById('palDetailModal').style.display = 'none'
    }

    // ── Add Lot: 3 วิธี (Manual/Camera/Scanner) — POST /mat-pallets/{MatPalletNo}/lots { lotNos: [...] } ──
    // instance ของกล้อง/hw scanner แยกเป็นของตัวเองไม่ยุ่งกับ rpScanner/rpHwScanner ของแท็บ Receive/Re-Print/Assembly
    // (คนละ DOM element, คนละ state machine) เปิด/ปิดแค่ตอน modal นี้เปิดอยู่เท่านั้น
    let _palAddOpen = false
    let _palAddMode = 'manual'
    let _palAddBusy = false
    let _palCamScanner = null
    let _palHwScanner  = null
    let _palLastScanCode = null, _palLastScanAt = 0

    function palToggleAddLot() {
        _palAddOpen = document.getElementById('palAddPanel').style.display === 'none'
        document.getElementById('palAddPanel').style.display = _palAddOpen ? '' : 'none'
        document.getElementById('palAddLotBtn').classList.toggle('active', _palAddOpen)
        if (_palAddOpen) palSetAddMode(_palAddMode)
        else palStopAddScanners()
    }

    function palCollapseAddLot() {
        _palAddOpen = false
        palStopAddScanners()
        const panel = document.getElementById('palAddPanel')
        const btn   = document.getElementById('palAddLotBtn')
        if (panel) panel.style.display = 'none'
        if (btn)   btn.classList.remove('active')
        const result = document.getElementById('palAddResult')
        if (result) { result.textContent = ''; result.className = 'pal-add-result' }
        const manualInput = document.getElementById('palManualInput')
        if (manualInput) manualInput.value = ''
        palHideManualDropdown()
    }

    function palSetAddMode(mode) {
        palStopAddScanners()   // ปิดของโหมดก่อนหน้าเสมอ กันกล้อง/hw ค้างทำงานซ้อนกัน
        palShowAddResult('', null)   // เคลียร์ error/สถานะของโหมดก่อนหน้า (เช่น "ไม่รองรับ BarcodeDetector" จาก Camera) ไม่ให้ค้างข้ามแท็บ
        _palAddMode = mode
        document.querySelectorAll('.pal-add-tab').forEach(t => t.classList.toggle('active', t.dataset.mode === mode))
        document.getElementById('palAddManual').style.display  = mode === 'manual'  ? '' : 'none'
        document.getElementById('palAddCamera').style.display  = mode === 'camera'  ? '' : 'none'
        document.getElementById('palAddScanner').style.display = mode === 'scanner' ? '' : 'none'
        if (mode !== 'manual') palHideManualDropdown()

        if (mode === 'manual')       document.getElementById('palManualInput')?.focus()
        else if (mode === 'camera')  palStartCamera()
        else if (mode === 'scanner') palStartHwScanner()
    }

    async function palStartCamera() {
        if (!('BarcodeDetector' in window)) {
            palShowAddResult('เบราว์เซอร์นี้ไม่รองรับ BarcodeDetector', 'error')
            return
        }
        if (!_palCamScanner) {
            _palCamScanner = createBarcodeScanner({
                videoId: 'palCamVideo', canvasId: 'palCamCanvas', labelId: 'palCamLabel',
                onDetect: code => palHandleScanned(code),
                idleText: '— กำลังค้นหา barcode —'
            })
        }
        try {
            await _palCamScanner.start()
        } catch (err) {
            palShowAddResult('เปิดกล้องไม่สำเร็จ: ' + err.message, 'error')
        }
    }

    function palStartHwScanner() {
        if (!_palHwScanner) {
            _palHwScanner = createHwScanner({
                inputId: 'palHwInput', statusId: 'palHwStatus',
                onScan: code => palHandleScanned(code)
            })
        }
        _palHwScanner.open()
    }

    function palStopAddScanners() {
        if (_palCamScanner?.running) _palCamScanner.stop()
        if (_palHwScanner?.active)   _palHwScanner.close()
    }

    // QR ของเราเอง (ที่ print จากหน้านี้/Re-Print) เก็บเป็น JSON { lotNo, uniqueId } ไม่ใช่ lotNo ดิบๆ — ถ้าส่ง raw ทั้งก้อน
    // เข้า /mat-pallets/{no}/lots ตรงๆ จะ error เพราะ backend มองว่าไม่ใช่ lotNo ที่มีอยู่จริงเลย ต้องแกะ .lotNo ออกมาก่อนเสมอ
    // (เหมือน mode 'ours' ใน scanPipeline.js ที่หน้าอื่นใช้ — ตัดส่วน vendor-barcode lookup ที่ซับซ้อนออกเพราะหน้านี้ไม่ต้องใช้)
    function palExtractLotNo(raw) {
        try {
            const obj = JSON.parse(raw)
            if (obj?.lotNo) return String(obj.lotNo).trim()
        } catch (_) { /* ไม่ใช่ JSON — แปลว่าเป็น lotNo ดิบอยู่แล้ว (เช่น พิมพ์เอง/บาร์โค้ด 1D ทั่วไป) ใช้ raw ตรงๆ */ }
        return raw
    }

    // กล้องยิง onDetect ซ้ำได้ทุก frame ตราบใดที่ code เดิมยังอยู่ในเฟรม — กันยิง add ซ้ำด้วย cooldown สั้นๆ ต่อ code เดิม
    function palHandleScanned(rawCode) {
        const raw = (rawCode || '').trim()
        if (!raw) return
        const now = Date.now()
        if (raw === _palLastScanCode && now - _palLastScanAt < 1500) return
        _palLastScanCode = raw; _palLastScanAt = now
        const lotNo = palExtractLotNo(raw)
        if (!lotNo) return
        palAddLot(lotNo)
    }

    function palSubmitManualLot() {
        const inp = document.getElementById('palManualInput')
        const code = inp.value.trim()
        if (!code) return
        inp.value = ''
        palHideManualDropdown()
        palAddLot(code)
    }

    // ── Autocomplete ช่อง Manual — ค้นหา Lot จริงจาก POST /inventory/lots { lotNo } (pattern เดียวกับ rprFetchAndAddByLotNo
    // ในแท็บ Re-Print) reuse .wo-autocomplete/.wo-dropdown/.wo-item ของ printqr.css เดิม ไม่ต้องเพิ่ม CSS ใหม่ ──
    let _palManualResults = []
    let _palManualSearchTimer = null
    let _palManualFetchToken = 0

    function palManualLotSearch() {
        clearTimeout(_palManualSearchTimer)
        const q = document.getElementById('palManualInput').value.trim()
        if (!q) { palHideManualDropdown(); _palManualResults = []; return }
        _palManualSearchTimer = setTimeout(() => palFetchManualLots(q), 300)
    }

    async function palFetchManualLots(q) {
        const token = ++_palManualFetchToken   // กัน response เก่ามาถึงช้าแล้วทับผลของคำค้นใหม่กว่า
        const dd = document.getElementById('palManualDropdown')
        dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default">
            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
        </div>`
        dd.style.display = 'block'
        try {
            const res = await api('/inventory/lots', 'POST', { lotNo: q, page: 1, pageSize: 10 })
            if (token !== _palManualFetchToken) return
            _palManualResults = Array.isArray(res) ? res : (res?.data ?? [])
            palRenderManualDropdown()
        } catch (err) {
            if (token !== _palManualFetchToken) return
            dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default"><i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ</div>`
        }
    }

    function palRenderManualDropdown() {
        const dd = document.getElementById('palManualDropdown')
        if (!_palManualResults.length) {
            dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>ไม่พบ Lot</div>`
            return
        }
        dd.innerHTML = _palManualResults.map((l, i) => `
            <div class="wo-item" data-idx="${i}" onmousedown="event.preventDefault();palPickManualLot(${i})">
                <i class="bi bi-upc" style="color:var(--blue);flex-shrink:0"></i>
                <span style="min-width:0">
                    <strong>${escHtml(l.lotNo ?? '—')}</strong>
                    ${l.partNo ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${escHtml(l.partNo)}</span>` : ''}
                </span>
                ${l.onHandQty != null ? `<span class="wo-item-line" style="margin-left:auto">Qty ${l.onHandQty.toLocaleString()}</span>` : ''}
            </div>`).join('')
    }

    function palPickManualLot(i) {
        const lot = _palManualResults[i]
        if (!lot) return
        document.getElementById('palManualInput').value = lot.lotNo ?? ''
        palHideManualDropdown()
    }

    function palHideManualDropdown() {
        const dd = document.getElementById('palManualDropdown')
        if (dd) dd.style.display = 'none'
    }

    function palManualLotKeydown(e) {
        if (e.key !== 'Enter') return
        e.preventDefault()
        // มีผลค้นหาโชว์อยู่ + ยังไม่ได้เลือก — Enter = เอาตัวแรกในลิสต์เข้าช่องเลย (เหมือน WO/Location autocomplete อื่นในระบบ)
        if (_palManualResults.length) document.getElementById('palManualInput').value = _palManualResults[0].lotNo ?? document.getElementById('palManualInput').value
        palHideManualDropdown()
        palSubmitManualLot()
    }

    async function palAddLot(lotNo) {
        if (_palAddBusy || !_palCurrentPalletNo) return
        _palAddBusy = true
        palShowAddResult(`กำลังเพิ่ม ${lotNo}…`, 'info')
        try {
            await api(`/mat-pallets/${encodeURIComponent(_palCurrentPalletNo)}/lots`, 'POST', { lotNos: [lotNo] })
            palShowAddResult(`✅ เพิ่ม ${lotNo} แล้ว`, 'success')
            await palReloadCurrentLots()
        } catch (err) {
            palShowAddResult(`❌ เพิ่ม ${lotNo} ไม่สำเร็จ: ${err.message}`, 'error')
        } finally {
            _palAddBusy = false
        }
    }

    // รีเฟรช Lot ของ pallet ที่เปิด modal อยู่ (หลัง Add Lot สำเร็จ) — อัปเดตทั้งภาพ Grid ใน modal และการ์ดใน list หลัก
    // ให้ตรงกันทันที ไม่ต้องปิด modal แล้วรอ list โหลดใหม่ทั้งหน้า
    async function palReloadCurrentLots() {
        if (!_palCurrentPalletNo) return
        let rawLots = []
        try {
            const res = await api(`/mat-pallets/${encodeURIComponent(_palCurrentPalletNo)}/lots`, 'GET')
            rawLots = Array.isArray(res) ? res : (res?.data ?? [])
        } catch (_) {
            return
        }
        document.getElementById('palDetailLotCount').textContent = rawLots.length.toLocaleString()
        _palCurrentLots = rawLots.length ? await palEnrichLots(rawLots) : []
        palRenderStack(_palCurrentLots)
        palUpdateListCard(_palCurrentPalletNo, _palCurrentLots)
    }

    // อัปเดตการ์ดใน list หลัก (ถ้ายังอยู่ในหน้าปัจจุบัน) โดยหาจาก data-no แทน idx เพราะ idx ผูกกับรอบ render ของ loadPallets()
    // เท่านั้น ไม่ได้แปลว่าตรงกับ pallet ที่กำลังเปิด modal อยู่เสมอไป (เช่น เปลี่ยนหน้า/ค้นหาไปแล้วระหว่างเปิด modal ค้างไว้)
    // รับ lots ที่ enrich มาแล้วจาก detail modal ตรงๆ (มี workOrder ติดมาด้วย) — ไม่ต้อง enrich ซ้ำ แถม print status ส่วนใหญ่
    // cache ไว้แล้วจาก palRenderStack() ที่รันไปก่อนหน้านี้ กล่องเลยขึ้นสีถูกต้องได้ทันทีไม่ต้องรอ
    function palUpdateListCard(matPalletNo, lots) {
        const card = document.querySelector(`.pal-card[data-no="${CSS.escape(matPalletNo)}"]`)
        if (!card) return
        const count = lots.length
        const lotsEl = card.querySelector('.pal-card-lots')
        if (lotsEl) lotsEl.innerHTML = `<i class="bi bi-box-seam"></i> ${count.toLocaleString()} Lot${count === 1 ? '' : 's'}`
        const boxesEl = card.querySelector('.pal-illust-stack')
        if (boxesEl) boxesEl.innerHTML = palBuildBoxesHtml(lots)
        const moreEl = card.querySelector('.pal-illust-more')
        if (moreEl) {
            if (count > PAL_ILLUST_MAX_N) { moreEl.textContent = `+${count - PAL_ILLUST_MAX_N}`; moreEl.style.display = '' }
            else moreEl.style.display = 'none'
        }
    }

    function palShowAddResult(msg, type) {
        const el = document.getElementById('palAddResult')
        if (!el) return
        el.textContent = msg
        el.className = 'pal-add-result pal-add-result-' + (type || 'info')
    }

    // ── Create Pallet: POST /mat-pallets { currentLocationId, currentLocationCode } — matPalletNo auto-gen ฝั่ง backend ──
    // เรียกใช้ได้จากทุกแท็บของ PrintQR (เช่น ปุ่ม + ข้าง Pallet No. ใน _Receive.cshtml) เพราะ partial ทุกตัวอยู่ใน DOM
    // เดียวกันหมด แค่ซ่อน/โชว์ด้วย tab — ไม่ต้องก็อปโมดัลซ้ำ เรียก palOpenCreateModal() ตรงๆ ได้เลย
    let _palCreateLoc       = null   // { id, locationCode } ของ location ที่เลือกไว้ในโมดัล
    let _palCreateLocAuto   = null   // instance ของ createLocationAutocomplete — สร้างครั้งเดียว (lazy) แล้ว reuse ทุกครั้งที่เปิดโมดัล
    let _palCreateOnSuccess = null   // callback(matPalletNo) เผื่อ caller (เช่น _Receive.cshtml) อยากเอาเลข pallet ที่เพิ่งสร้างไปใช้ต่อทันที

    // prefillLoc = { id, locationCode, displayName } ไม่ใส่ก็ได้ (เปิดว่างๆ ให้เลือกเอง) — onCreated(matPalletNo) เรียกหลังสร้างสำเร็จ
    async function palOpenCreateModal(prefillLoc, onCreated) {
        document.getElementById('palCreateModal').style.display = 'flex'
        document.getElementById('palCreateSubmitBtn').disabled = true
        _palCreateLoc       = null
        _palCreateOnSuccess = typeof onCreated === 'function' ? onCreated : null
        palShowCreateResult('', null)

        await window._printQrLocationsReady   // รอ myLocations + locationTypeMeta พร้อมก่อน (เหมือน rcInitLocation ใน _Receive.cshtml)
        if (!_palCreateLocAuto) {
            _palCreateLocAuto = createLocationAutocomplete({
                inputId: 'palCreateLocInput', dropdownId: 'palCreateLocDropdown',
                locations: myLocations,
                emptyText: 'ไม่พบ Location',
                renderItem: (loc, i) => `<div class="wo-item" style="align-items:flex-start" data-idx="${i}">
                    <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0;margin-top:2px"></i>
                    <div style="display:flex;align-items:center;gap:10px;row-gap:2px;flex-wrap:wrap;min-width:0">
                        <span style="font-weight:700">${escHtml(loc.displayName || loc.locationCode)}</span>
                        ${loc.typeName ? locTypeBadge(loc.typeName) : ''}
                    </div>
                </div>`,
                onSelect: loc => {
                    _palCreateLoc = loc ? { id: loc.id, locationCode: loc.locationCode } : null
                    document.getElementById('palCreateSubmitBtn').disabled = !_palCreateLoc
                }
            })
        }

        if (prefillLoc?.id && prefillLoc?.locationCode) {
            _palCreateLoc = { id: prefillLoc.id, locationCode: prefillLoc.locationCode }
            document.getElementById('palCreateLocInput').value = prefillLoc.displayName || prefillLoc.locationCode
            document.getElementById('palCreateSubmitBtn').disabled = false
        } else {
            document.getElementById('palCreateLocInput').value = ''
        }
    }

    function palCloseCreateModal() {
        document.getElementById('palCreateModal').style.display = 'none'
    }

    // เดิมพอกด Create เสร็จ modal จะค้างโชว์ข้อความในกรอบ (banner) อยู่ 900ms ก่อนปิดเอง ระหว่างนั้นปุ่ม Create แม้จะ disabled
    // อยู่จริง แต่ดูจากภายนอกไม่ชัดว่ากดซ้ำไม่ได้ ทำให้ user กลัวว่ากดไม่ติดแล้วกด Create ซ้ำ — เปลี่ยนเป็นปิด modal ทันทีที่รู้ผล
    // (ทั้ง success/error) แล้วแจ้งผลผ่าน Toast แทน ให้ modal ไม่ค้างรอเลย (banner ในกรอบเหลือไว้แค่ตอนกำลังส่ง request เท่านั้น)
    async function palSubmitCreatePallet() {
        if (!_palCreateLoc) return
        const btn = document.getElementById('palCreateSubmitBtn')
        btn.disabled = true
        palShowCreateResult('กำลังสร้าง Pallet…', 'info')
        try {
            const res = await api('/mat-pallets', 'POST', {
                currentLocationId:   _palCreateLoc.id,
                currentLocationCode: _palCreateLoc.locationCode
            })
            const newNo = res?.matPalletNo ?? res?.data?.matPalletNo ?? null
            _palDateCache = { date: null, rows: [] }   // pallet ใหม่อาจตกวันที่ที่ cache ไว้อยู่ (ปกติคือวันนี้) — ล้าง cache กันเห็นไม่ครบ
            if (typeof loadPallets === 'function') loadPallets(1)   // รีเฟรช list ให้เห็น pallet ใหม่ทันที (ขึ้นหน้าแรกเสมอ)
            _palCreateOnSuccess?.(newNo)
            palCloseCreateModal()
            showToast(`สร้าง Pallet สำเร็จ${newNo ? ` — ${newNo}` : ''}`, 'success')
        } catch (err) {
            palCloseCreateModal()
            showToast(`สร้าง Pallet ไม่สำเร็จ: ${err.message}`, 'error')
        }
    }

    function palShowCreateResult(msg, type) {
        const el = document.getElementById('palCreateResult')
        if (!el) return
        el.textContent = msg
        el.className = 'pal-create-result pal-create-result-' + (type || 'info')
    }
</script>
