@{
    ViewData["Title"] = "Print QR";
}
<link rel="stylesheet" href="/css/master-shared.css"/>
<link rel="stylesheet" href="/css/printqr.css"/>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2 style="display:flex;align-items:center;gap:10px">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
                <path d="M6 9V2h12v7"/>
                <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
                <rect x="6" y="14" width="12" height="8"/>
                <rect x="9" y="17" width="2" height="2" fill="#fff" stroke="none"/>
                <rect x="13" y="17" width="2" height="2" fill="#fff" stroke="none"/>
            </svg>
            Print QR
        </h2>
    </div>
</div>

<!-- TAB PILLS -->
<script>
function switchTab(name, el) {
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'))
    document.querySelectorAll('.tab-pill').forEach(b => b.classList.remove('active'))
    document.getElementById('tab-' + name).classList.add('active')
    el.classList.add('active')
    if (typeof stopScan === 'function') stopScan()
    if (typeof rpCloseHwScan === 'function') rpCloseHwScan()
    if (name === 'history' && typeof loadHistory === 'function') { loadHistory(1) }
    if ((name === 'receive' || name === 'reprint' || name === 'assembly') && typeof loadLayoutsIntoSelect === 'function') {
        loadLayoutsIntoSelect()
    }
    if (name === 'receive' && typeof rcLayoutChange === 'function') {
        const prevRp = document.getElementById('rcLayout')?.value
        if (prevRp) rcLayoutChange()
    }
    if (name === 'reprint' && typeof rprLayoutChange === 'function') {
        const prevRpr = document.getElementById('rprLayout')?.value
        if (prevRpr) rprLayoutChange()
    }
    if ((name === 'reprint' || name === 'assembly') && typeof rpLoadPrinters === 'function') {
        rpLoadPrinters()
    }
    if (name === 'assembly' && typeof asmLoadBoms === 'function') {
        asmLoadBoms()
    }
}
</script>
<div class="tab-pills">
    <button class="tab-pill active" onclick="switchTab('receive', this)">Receive</button>
    <button class="tab-pill"        onclick="switchTab('reprint', this)">Re-Print</button>
    <button class="tab-pill"        onclick="switchTab('design', this)">Design Layout</button>
    <button class="tab-pill"        onclick="switchTab('history', this)">Print History</button>
    @* <button class="tab-pill"        onclick="switchTab('assembly', this)">Assembly</button> *@
</div>

<!-- Toast container -->
<div class="sf-toast-container" id="toastContainer"></div>

