    async function rpStartScan() {
        if (_rpScanActive) return
        if (!('BarcodeDetector' in window)) {
            showToast('This browser does not support BarcodeDetector', 'error'); return
        }
        const _scanSection = document.getElementById('rpScannerSection')
        if (_rpScanMode === 'reprint') {
            const anchor = document.getElementById('rprScanAnchor')
            if (anchor && _scanSection) {
                if (!_rpScannerOrigParent) _rpScannerOrigParent = _scanSection.parentNode
                anchor.appendChild(_scanSection)
            }
        } else if (_rpScanMode === 'receive') {
            const anchor = document.getElementById('rpScanAnchor')
            if (anchor && _scanSection) {
                if (!_rpScannerOrigParent) _rpScannerOrigParent = _scanSection.parentNode
                anchor.appendChild(_scanSection)
            }
        }
        _scanSection.style.display = ''
        document.getElementById('rpScanStatus').textContent = 'Scanning…'
        if (_rpScanMode === 'receive') {
            const body = document.getElementById('rpWoCardBody')
            if (body) body.style.display = 'none'
        } else if (_rpScanMode === 'assemble') {
            const body = document.getElementById('asmOutputCardBody')
            if (body) body.style.display = 'none'
        }
        _rpUpdateCamBtn(true)
        try {
            _rpStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: _rpFacingMode, width: { ideal: 1280 }, height: { ideal: 720 } }
            })
        } catch {
            try {
                _rpStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } })
                _rpFacingMode = 'user'
            } catch (e2) {
                showToast('Failed to open camera: ' + e2.message, 'error')
                document.getElementById('rpScannerSection').style.display = 'none'
                _rpUpdateCamBtn(false)
                return
            }
        }
        const video = document.getElementById('rpScanVideo')
        video.srcObject = _rpStream
        await video.play()
        const formats = await BarcodeDetector.getSupportedFormats()
        _rpDetector = new BarcodeDetector({ formats })
        _rpScanActive = true
        _rpDetectLoop()
    }

    function _rpDetectLoop() {
        if (!_rpScanActive) return
        const video  = document.getElementById('rpScanVideo')
        const canvas = document.getElementById('rpScanCanvas')
        const label  = document.getElementById('rpScanLabel')
        const ctx    = canvas.getContext('2d')
        const dw = canvas.offsetWidth, dh = canvas.offsetHeight
        if (canvas.width !== dw || canvas.height !== dh) { canvas.width = dw; canvas.height = dh }
        if (video.readyState < 2) { _rpRafId = requestAnimationFrame(_rpDetectLoop); return }
        _rpDetector.detect(video).then(results => {
            ctx.clearRect(0, 0, canvas.width, canvas.height)
            if (results.length > 0) {
                const scaleX = canvas.width  / (video.videoWidth  || canvas.width)
                const scaleY = canvas.height / (video.videoHeight || canvas.height)
                results.forEach(b => {
                    const x = b.boundingBox.x * scaleX, y = b.boundingBox.y * scaleY
                    const w = b.boundingBox.width * scaleX, h = b.boundingBox.height * scaleY
                    ctx.strokeStyle = '#60a5fa'; ctx.lineWidth = 3
                    ctx.strokeRect(x, y, w, h)
                    const tagY = y > 24 ? y - 4 : y + h + 16
                    ctx.fillStyle = 'rgba(26,111,255,.88)'
                    ctx.fillRect(x, tagY - 16, Math.min(w, 180), 18)
                    ctx.fillStyle = '#fff'; ctx.font = 'bold 11px sans-serif'
                    ctx.fillText(b.format.replace('_', ' ').toUpperCase(), x + 4, tagY)
                })
                const first = results[0]
                label.textContent = first.format + ': ' + first.rawValue
                _rpHandleScan(first.rawValue)
            } else {
                label.textContent = '— Scanning for barcode —'
            }
            if (_rpScanActive) _rpRafId = requestAnimationFrame(_rpDetectLoop)
        }).catch(() => {
            if (_rpScanActive) _rpRafId = requestAnimationFrame(_rpDetectLoop)
        })
    }

    function _rpHandleScan(text) {
        const now = Date.now()
        if (now - _rpLastScanTime < _RP_COOLDOWN) return
        _rpLastScanTime = now
        document.getElementById('rpScanStatus').textContent = '⏳ Processing...'
        rpOnScanSuccess(text)
        setTimeout(() => {
            const el = document.getElementById('rpScanStatus')
            if (el) el.textContent = 'Scanning…'
        }, 2000)
    }

    async function rpStopScan() {
        _rpScanActive = false
        cancelAnimationFrame(_rpRafId)
        if (_rpStream) { _rpStream.getTracks().forEach(t => t.stop()); _rpStream = null }
        const video = document.getElementById('rpScanVideo')
        if (video) video.srcObject = null
        const canvas = document.getElementById('rpScanCanvas')
        if (canvas) canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height)
        const label = document.getElementById('rpScanLabel')
        if (label) label.textContent = '— Scanning for barcode —'
        const _scanSection2 = document.getElementById('rpScannerSection')
        _scanSection2.style.display = 'none'
        if (_rpScannerOrigParent && _scanSection2.parentNode !== _rpScannerOrigParent) {
            _rpScannerOrigParent.appendChild(_scanSection2)
        }
        const woBody = document.getElementById('rpWoCardBody')
        if (woBody) woBody.style.display = ''
        const asmBody = document.getElementById('asmOutputCardBody')
        if (asmBody) asmBody.style.display = ''
        _rpUpdateCamBtn(false)
    }

    async function rpSwitchCamera() {
        if (!_rpScanActive) return
        _rpFacingMode = _rpFacingMode === 'environment' ? 'user' : 'environment'
        _rpScanActive = false
        cancelAnimationFrame(_rpRafId)
        if (_rpStream) { _rpStream.getTracks().forEach(t => t.stop()); _rpStream = null }
        document.getElementById('rpScannerSection').style.display = ''
        await rpStartScan()
    }

    function rpSetCamFooter(msg) {
        const el = document.getElementById('rpScanStatus')
        if (el) el.textContent = msg
    }

    async function rpOnScanSuccess(text) {
        try {
            const res = await api('/scan', 'POST', { barcode: text, mode: 0 })

            if (_rpScanMode === 'assemble') {
                const lotNo = res.wH_TraceId || res.lotNo || res.traceId || text
                const ok = asmAddLot(lotNo, res.partNo || null)
                const filled = asmMaterials.filter(m => m.lotNo).length
                rpSetCamFooter(ok
                    ? '✅ Lot added (' + filled + '/' + asmMaterials.length + ')'
                    : '⚠️ Unable to add Lot')
                return
            }

            if (_rpScanMode === 'reprint') {
                const lotNo = res.wH_TraceId || res.lotNo || res.traceId || text
                rprAddFromScan(lotNo).then(ok => {
                    rpSetCamFooter(ok
                        ? '✅ LOT added (' + rprItems.length + '/10)'
                        : '⚠️ Unable to add LOT')
                }).catch(err => rpSetCamFooter('❌ ' + (err?.message || String(err))))
                return
            }

            const traceKey = text
            if (rpScannedTrace.has(traceKey)) {
                showToast('สแกนซ้ำ', 'error')
                rpSetCamFooter('⚠️ สแกนซ้ำ')
                return
            }
            const data = mapScanResponse(res)
            if (!data) {
                showToast('⚠️ No data received from barcode', 'error')
                rpSetCamFooter('⚠️ No data received from barcode')
                return
            }
            data._barcode = traceKey
            const ok = await rpAddItem(data)
            if (ok) rpScannedTrace.add(traceKey)
            if (!ok) showToast('⚠️ Unable to add item', 'error')
            rpSetCamFooter(ok
                ? '✅ Added ' + (data.partNo || 'item') + ' (' + rpItems.length + '/10)'
                : '⚠️ Unable to add item')
        } catch (err) {
            if (_rpScanMode === 'reprint') {
                const lotNo = rprExtractLotNoFromRaw(text)
                if (lotNo) {
                    rprFetchAndAddByLotNo(lotNo).then(ok => {
                        rpSetCamFooter(ok
                            ? '✅ LOT added (' + rprItems.length + '/10)'
                            : '⚠️ Unable to add LOT')
                    }).catch(e => rpSetCamFooter('❌ ' + (e?.message || String(e))))
                    return
                }
            }
            if (_rpScanMode === 'receive') showToast('❌ ' + (err?.message || String(err)), 'error')
            rpSetCamFooter('❌ ' + (err?.message || String(err)))
        }
    }

    const AUTO_GEN_KEYS  = new Set(['lotNo'])
    const EDITABLE_KEYS  = new Set(['partNo', 'unit', 'vendor', 'dateCode', 'tradingCode', 'po', 'inventoryNo', 'traceId'])

    let _rpPnTimer = null, _rpPnResults = []

    function rpHidePnDropdown() {
        const dd = document.getElementById('rpPnDropdown')
        if (dd) dd.style.display = 'none'
    }

    function rpPnAutocomplete(text) {
        const dd = document.getElementById('rpPnDropdown')
        if (!dd) return
        const q = (text || '').trim()
        if (!q) { dd.style.display = 'none'; return }
        dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default">
            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
        </div>`
        dd.style.display = 'block'
        clearTimeout(_rpPnTimer)
        _rpPnTimer = setTimeout(async () => {
            try {
                const res = await api(`/master/items?search=${encodeURIComponent(q)}&page=1&pageSize=20`, 'GET')
                _rpPnResults = res.data || []
                if (!_rpPnResults.length) {
                    dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>ไม่พบรายการ</div>`
                    return
                }
                dd.innerHTML = _rpPnResults.map((x, i) => `
                    <div class="wo-item" onmousedown="rpSelectPn(${i})">
                        <span>
                            <strong>${escHtml(x.partNo)}</strong>
                            ${x.itemName ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${escHtml(x.itemName)}</span>` : ''}
                        </span>
                        ${x.baseUnit ? `<span class="wo-item-line">${escHtml(x.baseUnit)}</span>` : ''}
                    </div>`).join('')
            } catch {
                dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default"><i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ</div>`
            }
        }, 300)
    }

    function rpSelectPn(i) {
        const x = _rpPnResults[i]
        if (!x) return
        rpHidePnDropdown()
        const inp = document.getElementById('rpm_partNo')
        if (inp) { inp.value = x.partNo; inp.style.borderColor = '' }
        const unitEl = document.getElementById('rpm_unit')
        if (unitEl && !unitEl.value && x.baseUnit) unitEl.value = x.baseUnit
    }

    function rpOpenManualModal() {
        const colHdr = document.getElementById('rpManualColHeaders')
        if (colHdr) colHdr.style.display = 'grid'
        const cfg        = rpLayoutConfig ?? {}
        const qrFields   = Array.isArray(cfg.qrFields)    ? cfg.qrFields    : []
        const lblFields  = Array.isArray(cfg.labelFields) ? cfg.labelFields : []

        const container = document.getElementById('rpManualFields')
        container.innerHTML = ALL_FIELD_KEYS.map(k => {
            const inQr  = qrFields.find(f => f.key === k)?.inQr   ?? false
            const inLbl = lblFields.find(f => f.key === k)?.show   ?? false
            const isAuto = AUTO_GEN_KEYS.has(k)
            const prefill = k === 'workOrder'      ? (rpCurrentWo      ?? '')
                          : k === 'line'           ? (rpCurrentLine    ?? '')
                          : k === 'productionArea' ? (rpProductionArea ?? '')
                          : ''
            const isReq = REQUIRED_KEYS.has(k)
            const inputEl = isAuto
                ? `<div style="padding:7px 10px;background:#f0f2f5;border:1.5px solid var(--border);border-radius:8px;font-size:12px;color:var(--t2);font-style:italic">Auto-Gen after add item</div>`
                : k === 'partNo'
                ? `<div style="position:relative">
                       <input id="rpm_partNo" class="form-input" value="${escHtml(prefill)}"
                           style="font-size:13px;padding:7px 10px;width:100%"
                           oninput="this.style.borderColor='';rpPnAutocomplete(this.value)"
                           onblur="setTimeout(rpHidePnDropdown, 180)"
                           placeholder="${escHtml(FIELD_PLACEHOLDERS['partNo'] ?? FIELD_LABELS['partNo'])}">
                       <div id="rpPnDropdown" class="wo-dropdown" style="display:none"></div>
                   </div>`
                : k === 'quantity'
                ? `<input id="rpm_quantity" class="form-input" inputmode="decimal"
                       value="${escHtml(prefill || '1')}"
                       style="font-size:13px;padding:7px 10px"
                       oninput="this.style.borderColor=''"
                       placeholder="${escHtml(FIELD_PLACEHOLDERS['quantity'] ?? FIELD_LABELS['quantity'])}">`
                : `<input id="rpm_${cid(k)}" class="form-input" value="${escHtml(prefill)}"
                       style="font-size:13px;padding:7px 10px"
                       ${k === 'workOrder' || k === 'productionArea' || k === 'line' ? 'readonly style="font-size:13px;padding:7px 10px;background:#f8f9fc"' : ''}
                       oninput="this.style.borderColor=''"
                       placeholder="${escHtml(FIELD_PLACEHOLDERS[k] ?? FIELD_LABELS[k])}">`
            return `<div style="display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px 16px;align-items:center;padding:6px 16px;border-bottom:1px solid var(--border)">
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inQr ? 'var(--blue)' : 'var(--border)'};background:${inQr ? 'var(--blue)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inQr ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inLbl ? 'var(--purple,#7c3aed)' : 'var(--border)'};background:${inLbl ? 'var(--purple,#7c3aed)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inLbl ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="font-size:13px;font-weight:600;color:var(--navy)">
                    ${escHtml(FIELD_LABELS[k])}${isReq ? ' <span style="color:var(--red)">*</span>' : ''}
                </div>
                ${inputEl}
            </div>`
        }).join('')

        document.getElementById('rpManualModalTitle').textContent = '⌨ Manual Entry'
        document.getElementById('rpManualModalFooter').innerHTML =
            `<button onclick="document.getElementById('rpManualModal').style.display='none'"
                style="flex:1;padding:12px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">
                Cancel
            </button>
            <button onclick="rpSubmitManual()"
                style="flex:2;padding:12px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit">
                + Add Item
            </button>`
        document.getElementById('rpManualModal').style.display = 'flex'
    }

    function rpSubmitManual() {
        const data = {}
        ALL_FIELD_KEYS.forEach(k => {
            if (AUTO_GEN_KEYS.has(k)) { data[k] = ''; return }
            const el = document.getElementById(`rpm_${cid(k)}`)
            data[k] = el ? el.value.trim() : ''
        })
        for (const k of REQUIRED_KEYS) {
            if (!data[k]) {
                showToast(`Please fill in ${FIELD_LABELS[k]}`, 'error')
                const el = document.getElementById(`rpm_${cid(k)}`)
                if (el) { el.style.borderColor = 'var(--red)'; el.focus() }
                return
            }
        }
        document.getElementById('rpManualModal').style.display = 'none'
        rpAddItem(data).then(ok => { if (ok) showToast('✅ Added ' + data.partNo, 'success') })
    }

    const _RP_BRACE_FIELDS = ['partNo','quantity','unit','vendor','dateCode','tradingCode','po','inventoryNo','traceId']
    function rpDecodeBrace(raw) {
        const parts = raw.split(' {').map(s => s.trim())
        if (parts.length < 2 || !parts[0]) return null
        const obj = {}
        _RP_BRACE_FIELDS.forEach((k, i) => { obj[k] = parts[i] ?? '' })
        if (!obj.partNo) return null
        return obj
    }

    async function rpParseScan(raw) {
        try {
            const obj = JSON.parse(raw)
            if (obj && typeof obj === 'object' && obj.partNo) {
                return {
                    partNo:   obj.partNo  ?? '',
                    quantity: String(obj.quantity ?? ''),
                    unit:     obj.unit    ?? '',
                    workOrder: obj.workOrder ?? rpCurrentWo ?? '',
                    line:     obj.line    ?? rpCurrentLine ?? '',
                    lotNo:    obj.lotNo   ?? '',
                    vendor:   obj.vendor  ?? '',
                    dateCode: obj.dateCode ?? '',
                    tradingCode: obj.tradingCode ?? '',
                    po:       obj.po      ?? '',
                    inventoryNo: obj.inventoryNo ?? '',
                    traceId:  obj.traceId ?? '',
                    uniqueId: obj.uniqueId ?? '',
                    productionArea: obj.productionArea ?? '',
                }
            }
        } catch (_) {}

        const brace = rpDecodeBrace(raw)
        if (brace) {
            return {
                partNo:      brace.partNo,
                quantity:    brace.quantity,
                unit:        brace.unit,
                workOrder:   rpCurrentWo  ?? '',
                line:        rpCurrentLine ?? '',
                lotNo:       '',
                vendor:      brace.vendor,
                dateCode:    brace.dateCode,
                tradingCode: brace.tradingCode,
                po:          brace.po,
                inventoryNo: brace.inventoryNo,
                traceId:     brace.traceId,
                uniqueId:    '',
                productionArea: '',
            }
        }

        const res = await api('/scan', 'POST', { barcode: raw, mode: 0 })
        return {
            partNo:   res.partNo   ?? '',
            quantity: String(res.quantity ?? ''),
            unit:     res.unit     ?? '',
            workOrder: res.workOrder ?? rpCurrentWo ?? '',
            line:     res.line     ?? rpCurrentLine ?? '',
            lotNo:    '',
            vendor:   res.vendor   ?? '',
            dateCode: res.dateCode ?? '',
            tradingCode: res.tradingCode ?? '',
            po:       res.po       ?? '',
            inventoryNo: res.inventoryNo ?? '',
            traceId:  res.wH_TraceId || res.traceId || '',
            uniqueId: res.uniqueId ?? res.unique_id ?? '',
            productionArea: res.productionArea ?? '',
        }
    }

    async function rpAddItem(data) {
        try {
        if (rpItems.length >= 10) {
            showToast('Maximum 10 items per batch', 'error')
            return
        }
        if (rpCurrentWo)      data.workOrder      = rpCurrentWo
        if (rpCurrentLine)    data.line            = rpCurrentLine
        if (rpProductionArea) data.productionArea  = rpProductionArea

        if (data.traceId) {
            const dup = rpItems.find(i => i.data.traceId === data.traceId)
            if (dup) {
                showToast('⚠️ traceId already in list: ' + data.traceId, 'error')
                return
            }
        }

        try {
            const trRes = await api('/inventory/new-lotNo', 'GET')
            data.lotNo  = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? String(trRes) ?? null
        } catch (_) {
            data.lotNo = null
        }
        data.createdAt = new Date().toISOString()

        const cfg = rpLayoutConfig ?? {}
        const sliders = {
            qrX:       cfg.qrX       ?? 30,
            qrY:       cfg.qrY       ?? 40,
            qrSize:    cfg.qrSize    ?? 5,
            dataX:     cfg.dataX     ?? 373,
            dataY:     cfg.dataY     ?? 58,
            fontSize:  cfg.fontSize  ?? 22,
            lineHeight: cfg.lineHeight ?? 33,
            valOffset:  cfg.valOffset  ?? 151,
        }
        const labelFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : null
        const textFields = labelFields
            ? labelFields.filter(f => f.show).map(f => ({
                label: f.label ?? FIELD_LABELS[f.key] ?? f.key,
                value: f.key === 'createdAt' ? fmtCreatedAt(data[f.key]) : (data[f.key] ?? ''),
              }))
            : Object.keys(FIELD_LABELS).filter(k => data[k]).map(k => ({
                label: FIELD_LABELS[k],
                value: k === 'createdAt' ? fmtCreatedAt(data[k]) : data[k],
              }))
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        rpItems.push({ data, zpl, previewSrc: null, reviewed: false })
        rpRenderList()
        const idx = rpItems.length - 1
        const dpi = cfg.dpi ?? '8dpmm'
        const w   = cfg.width  ?? 4
        const h   = cfg.height ?? 3
        renderZplClient(zpl, dpi, w, h).then(src => {
            if (rpItems[idx]) { rpItems[idx].previewSrc = src }
        }).catch(() => {})
        return true
        } catch(e) { showToast('Failed to add item: ' + e.message, 'error'); return false }
    }

    function rpConfirmDelete(idx) {
        const item = rpItems[idx]
        if (!item) return
        const desc = document.getElementById('rpConfirmModalDesc')
        if (desc) desc.textContent = item.data.partNo ? `P/N: ${item.data.partNo}` : `Item #${idx + 1}`
        const btn = document.getElementById('rpConfirmDeleteBtn')
        if (btn) btn.onclick = () => {
            document.getElementById('rpConfirmModal').style.display = 'none'
            rpRemoveItem(idx)
        }
        document.getElementById('rpConfirmModal').style.display = 'flex'
    }

    function rpRemoveItem(idx) {
        const barcode = rpItems[idx]?.data?._barcode
        if (barcode) rpScannedTrace.delete(barcode)
        rpItems.splice(idx, 1)
        rpRenderList()
    }

    function rpRenderList() {
        const container = document.getElementById('rpItemList')
        const badge     = document.getElementById('rpCounter')
        const n         = rpItems.length
        const reviewed  = rpItems.filter(i => i.reviewed).length
        badge.textContent = `${n}/10`
        badge.className   = 'rp-counter-badge' + (n >= 10 ? ' full' : '')

        const allReviewed = n > 0 && reviewed === n
        const canPrint    = n > 0 && !_rpPrinting
        ;['rpPrintBtn', 'rpPrintBtnMobile'].forEach(id => {
            const btn = document.getElementById(id)
            if (!btn) return
            btn.disabled      = !canPrint
            btn.style.opacity = canPrint ? '1' : '0.45'
            btn.style.cursor  = canPrint ? 'pointer' : 'not-allowed'
            btn.innerHTML     = '<i class="bi bi-printer"></i> Print'
            btn.title = _rpPrinting ? 'Printing in progress…' : n === 0 ? 'Add items first' : ''
        })
        if (_rpShowUnreviewed && allReviewed) _rpShowUnreviewed = false
        if (document.getElementById('rpPrinterSelect')?.value) rpShowError('rpPrinterTrigger', false)

        if (n === 0) {
            container.innerHTML = '<div class="rp-empty-state">No items yet — scan or type to add</div>'
            return
        }

        const cols = `font-size:13px;font-weight:600;color:var(--t2);font-family:monospace;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;padding:0 8px`
        container.innerHTML = rpItems.map((item, idx) => {
            const d       = item.data
            const err     = item.receiveError || item.printError
            const errType = item.receiveError ? 'Receive' : item.printError ? 'Print' : null

            if (item.processing) {
                const rxBadge = item.isReceived
                    ? `<span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#15803d;background:#f0fdf4;border:1px solid #86efac;border-radius:4px;padding:1px 7px;white-space:nowrap"><i class="bi bi-check2"></i> Received</span>`
                    : ''
                return `<div class="rp-item-row" style="opacity:0.65">
                    <div class="rp-item-info"><div class="rp-item-pn">${escHtml(d.partNo || '—')}</div></div>
                    <div style="${cols}">${escHtml(d.lotNo || '')}</div>
                    <div style="font-size:13px;font-weight:700;color:var(--text);flex:1;min-width:0;text-align:right">${escHtml(String(d.quantity || ''))}</div>
                    <div style="font-size:12px;font-weight:600;color:var(--t2);flex:1;min-width:0;text-align:right">${escHtml(d.unit || '')}</div>
                    <div style="width:160px;display:flex;justify-content:flex-end;align-items:center;gap:8px">
                        ${rxBadge}
                        <span style="font-size:13px;color:var(--t2)">⏳</span>
                    </div>
                </div>`
            }

            if (err) {
                const ok = item.reviewed
                const badge = errType === 'Receive'
                    ? `<span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#c2410c;background:#fff7ed;border:1px solid #fed7aa;border-radius:4px;padding:1px 6px;white-space:nowrap"><i class="bi bi-inbox"></i> Receive</span>`
                    : `<span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;border-radius:4px;padding:1px 6px;white-space:nowrap"><i class="bi bi-printer"></i> Print</span>`
                return `<div class="rp-item-row" style="flex-direction:column;gap:0;border-left:3px solid var(--red);background:#fff5f5;padding:0;align-items:stretch">
                    <div style="display:flex;align-items:center;gap:16px;padding:8px 14px">
                        <div class="rp-item-info"><div class="rp-item-pn">${escHtml(d.partNo || '—')}</div></div>
                        <div style="${cols}">${escHtml(d.lotNo || '')}</div>
                        <div style="font-size:13px;font-weight:700;color:var(--text);flex:1;min-width:0;text-align:right">${escHtml(String(d.quantity || ''))}</div>
                        <div style="font-size:12px;font-weight:600;color:var(--t2);flex:1;min-width:0;text-align:right">${escHtml(d.unit || '')}</div>
                        <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;width:160px;justify-content:flex-end">
                            <button onclick="rpViewItemData(${idx})"
                                style="background:${ok ? 'var(--green-lt)' : '#fffbeb'};border:1.5px solid ${ok ? 'var(--green)' : '#f59e0b'};border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;color:${ok ? 'var(--green)' : '#d97706'};cursor:pointer;white-space:nowrap;font-family:inherit;min-width:88px;text-align:center">
                                ${ok ? '✓ Reviewed' : '📋 View Data'}
                            </button>
                            <button class="rp-remove-btn" onclick="rpConfirmDelete(${idx})" title="Remove" style="border-color:var(--red);color:var(--red)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:6px;padding:4px 14px 7px;border-top:1px solid #fecaca">
                        ${item.isReceived && errType === 'Print' ? `<span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#15803d;background:#f0fdf4;border:1px solid #86efac;border-radius:4px;padding:1px 7px;white-space:nowrap"><i class="bi bi-check2"></i> Received</span>` : ''}
                        ${badge}
                        <span style="font-size:11px;color:var(--red);font-weight:600;line-height:1.4">${escHtml(err)}</span>
                    </div>
                </div>`
            }

            const ok = item.reviewed
            const needsReview = _rpShowUnreviewed && !ok
            return `<div class="rp-item-row" style="${needsReview ? 'border-left:3px solid var(--amber);background:#fffbf0' : ''}">
                <div class="rp-item-info"><div class="rp-item-pn">${escHtml(d.partNo || '—')}</div></div>
                <div style="${cols}">${escHtml(d.lotNo || '')}</div>
                <div style="font-size:13px;font-weight:700;color:var(--text);flex:1;min-width:0;text-align:right">${escHtml(String(d.quantity || ''))}</div>
                <div style="font-size:12px;font-weight:600;color:var(--t2);flex:1;min-width:0;text-align:right">${escHtml(d.unit || '')}</div>
                <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;width:160px;justify-content:flex-end">
                    <button onclick="rpViewItemData(${idx})"
                        style="background:${ok ? 'var(--green-lt)' : '#fffbeb'};border:1.5px solid ${ok ? 'var(--green)' : '#f59e0b'};border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;color:${ok ? 'var(--green)' : '#d97706'};cursor:pointer;white-space:nowrap;font-family:inherit;min-width:88px;text-align:center">
                        ${ok ? '✓ Reviewed' : '📋 View Data'}
                    </button>
                    <button class="rp-remove-btn" onclick="rpConfirmDelete(${idx})" title="Remove">✕</button>
                </div>
            </div>`
        }).join('')
    }

    async function rpShowPreview(idx) {
        const modal = document.getElementById('rpPreviewModal')
        const wrap  = document.getElementById('rpPreviewContent')
        modal.style.display = 'flex'
        wrap.innerHTML = '<div style="color:var(--t3);font-size:13px">Rendering…</div>'
        const item = rpItems[idx]
        if (!item) { wrap.innerHTML = '<div style="color:var(--red)">Item not found</div>'; return }
        try {
            let src = item.previewSrc
            if (!src) {
                const cfg = rpLayoutConfig ?? {}
                src = await renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
                if (item) item.previewSrc = src
            }
            wrap.innerHTML = src
                ? `<img src="${escHtml(src)}" style="max-width:100%;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
                : '<div style="color:var(--amber);font-size:13px">Preview not available</div>'
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
    }

    function rpClosePreview() {
        document.getElementById('rpPreviewModal').style.display = 'none'
    }

    function rpShowPrintModal() {
        if (rpItems.length === 0 || _rpPrinting) return

        // Validate: Work Order
        if (!rpCurrentWo) {
            rpShowError('rpWoInput', true)
            document.getElementById('rpWoInput').scrollIntoView({ behavior: 'smooth', block: 'center' })
            setTimeout(() => document.getElementById('rpWoInput').focus(), 300)
            showToast('กรุณาเลือก Work Order', 'error')
            return
        }
        // Validate: Layout Template
        if (!document.getElementById('rpLayout')?.value) {
            rpShowError('rpLayout', true)
            document.getElementById('rpLayout').scrollIntoView({ behavior: 'smooth', block: 'center' })
            setTimeout(() => document.getElementById('rpLayout').focus(), 300)
            showToast('กรุณาเลือก Layout Template', 'error')
            return
        }
        // Validate: Receive Location
        if (!rpReceiveLocationCode) {
            rpShowError('rpLocSearch', true)
            document.getElementById('rpLocSearch').scrollIntoView({ behavior: 'smooth', block: 'center' })
            setTimeout(() => document.getElementById('rpLocSearch').focus(), 300)
            showToast('กรุณาเลือก Receive Location', 'error')
            return
        }
        // Validate: Printer
        if (!document.getElementById('rpPrinterSelect')?.value) {
            rpShowError('rpPrinterTrigger', true)
            document.getElementById('rpPrinterTrigger').scrollIntoView({ behavior: 'smooth', block: 'nearest' })
            document.getElementById('rpPrinterTrigger').focus()
            showToast('กรุณาเลือก Printer', 'error')
            return
        }
        // Validate: unreviewed items
        const unreviewed = rpItems.filter(i => !i.reviewed).length
        if (unreviewed > 0) {
            _rpShowUnreviewed = true
            rpRenderList()
            showToast(`กรุณา View Data ก่อน Print (${unreviewed} item ยังไม่ได้ตรวจสอบ)`, 'error')
            return
        }
        _rpShowUnreviewed = false
        rpPrint('receive')
    }

    async function rpPrint(mode) {
        if (rpItems.length === 0) return
        const printerIp = document.getElementById('rpPrinterSelect')?.value
        if (!printerIp) { showToast('Please select a printer', 'error'); return }

        if (mode === 'receive' && !document.getElementById('rpOptSkipGps')?.checked) {
            if (!navigator.geolocation) {
                showToast('Browser ไม่รองรับ GPS', 'error'); return
            }
            // skip fetch if GPS already cached for this location
            if (_rpGpsCachedForLocation !== rpReceiveLocationCode) {
                const btns = ['rpPrintBtn', 'rpPrintBtnMobile'].map(id => document.getElementById(id)).filter(Boolean)
                const prevHtmls = btns.map(b => b.innerHTML)
                btns.forEach(b => b.innerHTML = '<i class="bi bi-geo-alt"></i> Getting GPS…')
                try {
                    let pos
                    try {
                        pos = await new Promise((res, rej) =>
                            navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
                        )
                    } catch (e) {
                        if (e.code !== e.TIMEOUT) throw e
                        console.warn('[rpPrint] high-accuracy GPS timed out, retrying with enableHighAccuracy:false')
                        btns.forEach(b => b.innerHTML = '<i class="bi bi-geo-alt"></i> Retrying GPS…')
                        pos = await new Promise((res, rej) =>
                            navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: false, timeout: 8000 })
                        )
                    }
                    rpReceiveLat = pos.coords.latitude
                    rpReceiveLng = pos.coords.longitude
                    console.log('[rpPrint] GPS lat:', rpReceiveLat, 'lng:', rpReceiveLng)
                } catch (e) {
                    btns.forEach((b, i) => b.innerHTML = prevHtmls[i])
                    let msg
                    switch (e.code) {
                        case e.PERMISSION_DENIED:
                            msg = 'ไม่ได้รับอนุญาตให้เข้าถึงตำแหน่ง — กรุณาอนุญาต Location ใน browser และตรวจสอบว่าเข้าผ่าน HTTPS'
                            break
                        case e.POSITION_UNAVAILABLE:
                            msg = 'ไม่สามารถระบุตำแหน่งได้ — ตรวจสอบว่าเปิด GPS/Location Services บนอุปกรณ์แล้ว'
                            break
                        case e.TIMEOUT:
                            msg = 'หมดเวลาในการระบุตำแหน่ง — ลองใหม่อีกครั้ง หรือไปยังที่โล่งแจ้ง'
                            break
                        default:
                            msg = e.message || 'Unknown error'
                    }
                    showToast('GPS error: ' + msg, 'error'); return
                }
                btns.forEach((b, i) => b.innerHTML = prevHtmls[i])
            }
        }

        _rpPrinting = true
        rpRenderList()

        for (const item of [...rpItems]) {
            await _rpProcessItem(item, printerIp, mode)
        }

        _rpPrinting = false
        if (rpItems.length === 0) {
            showToast(`🖨️ All items printed${mode === 'receive' ? ' & received' : ''} successfully`, 'success')
        }
        rpRenderList()
    }

    function _rpBuildReceivePayload(item) {
        return {
            lotNo:        item.data.lotNo        ?? '',
            partNo:       item.data.partNo       ?? '',
            description:  item.data.description  ?? '',
            workOrderNo:  item.data.workOrder    ?? item.data.workOrderNo ?? '',
            locationCode: rpReceiveLocationCode  ?? '',
            quantity:     +item.data.quantity    || 0,
            unit:         item.data.unit         ?? '',
            traceId:      item.data.traceId      ?? item.data._barcode   ?? '',
            vendor:       item.data.vendor       ?? '',
            dateCode:     item.data.dateCode     ?? '',
            tradingCode:  item.data.tradingCode  ?? '',
            po:           item.data.po           ?? '',
            inventoryNo:  item.data.inventoryNo  ?? '',
            itemType:     item.data.itemType     ?? 1,
            latitude:     rpReceiveLat,
            longitude:    rpReceiveLng,
        }
    }

    function _rpGetOptions() {
        return {
            skipGpsValidation:          document.getElementById('rpOptSkipGps')?.checked     ?? false,
            skipPrintedValidation:      document.getElementById('rpOptSkipPrinted')?.checked ?? false,
            skipWorkOrderValidation:    document.getElementById('rpOptSkipWO')?.checked      ?? false,
            skipLocationValidation:     document.getElementById('rpOptSkipLoc')?.checked     ?? false,
            skipLotDuplicateValidation: document.getElementById('rpOptSkipDup')?.checked     ?? false,
            skipReservedLotValidation:  document.getElementById('rpOptSkipRes')?.checked     ?? false,
            skipManualLotValidation:    document.getElementById('rpOptSkipManual')?.checked  ?? false,
        }
    }

    async function _rpProcessItem(item, printerIp, mode) {
        item.processing   = true
        item.receiveError = null
        item.printError   = null
        rpRenderList()

        if (mode === 'receive' && !item.isReceived) {
            try {
                const receivePayload = { command: { items: [_rpBuildReceivePayload(item)] }, options: _rpGetOptions() }
                console.log('[Receive] payload →', JSON.stringify(receivePayload, null, 2))
                const res    = await api('/inventory/receive', 'POST', receivePayload)
                console.log('[Receive] response →', res)
                const data   = Array.isArray(res?.data) ? res.data : []
                const result = data[0]
                if (result && !result.sucess && !result.success) {
                    item.receiveError = [result.errorCode, result.message].filter(Boolean).join(': ') || 'Receive failed'
                    item.reviewed     = false
                    item.processing   = false
                    showToast(`❌ ${item.data.lotNo || ''}: ${item.receiveError}`, 'error')
                    rpRenderList()
                    return
                }
                item.isReceived = true
                // cache GPS coords for this location after first successful receive
                if (_rpGpsCachedForLocation !== rpReceiveLocationCode) {
                    _rpGpsCachedForLocation = rpReceiveLocationCode
                }
            } catch (err) {
                item.receiveError = err.message || 'Receive failed'
                item.reviewed     = false
                item.processing   = false
                showToast(`❌ ${item.data.lotNo || ''}: ${item.receiveError}`, 'error')
                rpRenderList()
                return
            }
        }

        try {
            const payload = {
                printerIp,
                lotNo: item.data.lotNo ?? '',
                zpl:   applyPrintOffset(item.zpl, rpLayoutConfig),
            }
            if (item.printAttempted) {
                payload.isReprint     = true
                payload.reprintReason = 'Re-Print in PrintReceive'
            }
            item.printAttempted = true
            console.log('[Print] payload →', JSON.stringify(payload, null, 2))
            const res = await api('/printer/send', 'POST', payload)
            console.log('[Print] response →', res)
            const pd  = res?.problemDetails
            if (pd || (res?.statusCode && res.statusCode >= 400)) {
                const msg = [pd?.title, pd?.detail].filter(Boolean).join(': ') || res?.message || 'Print failed'
                item.printError  = msg
                item.reviewed    = false
                item.processing  = false
                showToast(`❌ ${item.data.lotNo || ''}: ${msg}`, 'error')
                rpRenderList()
            } else {
                const i = rpItems.indexOf(item)
                if (i !== -1) {
                    if (item.data._barcode) rpScannedTrace.delete(item.data._barcode)
                    rpItems.splice(i, 1)
                }
                rpRenderList()
            }
        } catch (err) {
            item.printError  = err.message || 'Print error'
            item.reviewed    = false
            item.processing  = false
            showToast(`❌ ${item.data.lotNo || ''}: ${item.printError}`, 'error')
            rpRenderList()
        }
    }

    async function rpRetryItem(idx) {
        if (_rpPrinting) return
        const item = rpItems[idx]
        if (!item) return
        const printerIp = document.getElementById('rpPrinterSelect')?.value
        if (!printerIp) { showToast('Please select a printer', 'error'); return }

        _rpPrinting = true
        await _rpProcessItem(item, printerIp, 'receive')
        _rpPrinting = false

        if (rpItems.length === 0) showToast('🖨️ All items completed!', 'success')
        rpRenderList()
    }
</script>
