                        <li class="nav-item" id="OpDashboardNav"><a class="nav-link px-3"
                                                                        href="/Inventory/OpDashboard">OpDashboard</a></li>
                            <li class="nav-item"><a class="nav-link px-3" href="/Inventory/Lots">Lots</a></li>
                            <li class="nav-item"><a class="nav-link px-3" href="/Inventory/WorkOrders">WorkOrders</a></li>
                            <li class="nav-item"><a class="nav-link px-3" href="/Inventory/Receive">Receive</a></li>
                            <li class="nav-item"><a class="nav-link px-3" href="/Inventory/Move">Move</a></li>
                            @* <li class="nav-item"><a class="nav-link px-3" href="/Inventory/Reserve">Reserve</a></li> *@
                            <li class="nav-item"><a class="nav-link px-3" href="/Inventory/Transactions">Transactions</a></li>
                            <li class="nav-item"><a class="nav-link px-3" href="/Inventory/MasterManagement">Master</a></li>
                            <li class="nav-item"><a class="nav-link px-3" href="/Inventory/PrintQR">Print QR</a></li>
                        </ul>
 
                        <div class="d-flex align-items-center gap-2 gap-md-3">

                            <span id="onlineCount"
                                  class="badge rounded-pill bg-success-light text-success d-none d-md-inline-block px-3 py-2">
                                Online: 0
                            </span>

                            <!-- Theme Toggle -->
                            <button id="themeToggleBtn" onclick="toggleTheme()" title="Toggle Dark/Light Mode"
