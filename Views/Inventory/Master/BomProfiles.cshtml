    async function beSave() {
        const isWo = _beMode === 'workorder'
        if (isWo && document.getElementById('beWoPreview').style.display === 'none') {
            showToast('กรุณา Fetch Work Order ก่อน', 'error'); return
        }
        if (!isWo) {
            const unresolved = _beComponents.filter(c => !c.componentItemId)
            if (unresolved.length) {
                showToast('ไม่พบ Item ID ของ: ' + unresolved.map(c => c.partNo).join(', ') + ' — ลองปิดแล้วเปิด Edit ใหม่อีกครั้ง', 'error')
                return
            }
        }
        const outputQuantity = isWo ? parseFloat(document.getElementById('beWoQty').textContent) || 0 : parseFloat(document.getElementById('beQty').value) || 0
        const qtyPerFG        = parseFloat(document.getElementById('beQtyPerFG').value) || 0
        // PUT /master/bom-profiles/{id} ไม่รับ outputPartNo/components — schema จริงคือ outputQuantity/qtyPerFG/isActive/details[{componentPartId,quantity}]
        // (ตัวระบุ output part ผูกกับ {id} ใน URL อยู่แล้ว แก้ไม่ได้ผ่าน endpoint นี้)
        const payload = {
            outputQuantity,
            qtyPerFG,
            isActive: document.getElementById('beIsActive').checked,
            details: _beComponents.map(c => ({ componentPartId: c.componentItemId, quantity: c.quantity }))
        }
        console.log('[beSave] PUT /master/bom-profiles/' + _beBomId, 'payload:', payload)
        try {
            const res = await api(`/master/bom-profiles/${_beBomId}`, 'PUT', payload)
            console.log('[beSave] response:', res)
            showToast('อัปเดต BOM Profile สำเร็จ')
            closeModal('bomEditModal')
            await loadBoms()
        } catch (err) {
            console.log('[beSave] error:', err)
            showToast('บันทึกไม่สำเร็จ: ' + err.message, 'error')
        }
    }

    loadBoms()
</script>
}
