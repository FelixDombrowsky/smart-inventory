    <header class="bg-white shadow-sm mb-4">
        <div class="container-fluid px-4 py-3">
            <div class="d-flex align-items-center justify-content-between">
            
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white p-2 rounded-3 me-3 d-flex align-items-center justify-content-center"
                         style="width: 45px; height: 45px;">
                        <i class="bi bi-package fs-4"></i>
                    </div>
                    <div class="d-none d-sm-block">
                        <h5 class="mb-0 fw-bold text-dark">Smart Factory Inventory</h5>
                        <p class="mb-0 text-muted small">ระบบจัดการคลังสินค้า</p>
                    </div>
                </div>

                <ul class="nav d-none d-xl-flex mx-auto custom-nav">
                    <li class="nav-item"><a class="nav-link px-3" href="/Inventory/Dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="/Inventory/Lots">Lots</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="/Inventory/WorkOrders">WorkOrders</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="/Inventory/Receive">Receive</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="/Inventory/Reserve">Reserve</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="/Inventory/MasterManagement">Master</a></li>
                </ul>

                <div class="d-flex align-items-center gap-2 gap-md-3">
                
                    <button class="btn btn-light rounded-circle position-relative p-2">
