@model string?
@{
    var p = Model ?? "pc";
}
<style>
.pc-modal { display:none; position:fixed; inset:0; z-index:2000; align-items:center; justify-content:center; }
.pc-modal-backdrop { position:absolute; inset:0; background:rgba(15,23,42,.55); }
.pc-modal-card { position:relative; background:#fff; border-radius:16px; width:min(640px, 92vw); max-height:90vh; overflow-y:auto; padding:18px; box-shadow:0 12px 40px rgba(0,0,0,.25); display:flex; flex-direction:column; }
.pc-head { display:flex; align-items:center; gap:8px; font-size:14px; font-weight:700; color:var(--navy); margin-bottom:12px; flex-shrink:0; }
.pc-count { margin-left:auto; background:var(--blue-lt); color:var(--blue); font-size:12px; font-weight:700; padding:2px 10px; border-radius:10px; }
.pc-body { display:flex; flex-direction:column; }
.pc-camera { margin-bottom:12px; }
.pc-camera video { width:100%; border-radius:10px; background:#000; aspect-ratio:1/1; object-fit:cover; }
.pc-thumbs { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; min-height:64px; }
.pc-thumb { position:relative; width:64px; height:64px; border-radius:8px; overflow:hidden; border:1px solid var(--border); flex-shrink:0; }
.pc-thumb img { width:100%; height:100%; object-fit:cover; display:block; cursor:pointer; }
.pc-thumb-del { position:absolute; top:2px; right:2px; width:18px; height:18px; border:none; border-radius:50%; background:rgba(0,0,0,.55); color:#fff; font-size:12px; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0; }
.pc-thumb-scan { border-color:var(--blue); }
.pc-scan-badge { position:absolute; bottom:2px; left:50%; transform:translateX(-50%); font-size:9px; font-weight:700; background:rgba(26,111,255,.8); color:#fff; padding:1px 5px; border-radius:3px; white-space:nowrap; pointer-events:none; }
.pc-preview { display:none; position:fixed; inset:0; z-index:2200; align-items:center; justify-content:center; background:rgba(0,0,0,.85); }
.pc-preview img { max-width:92vw; max-height:92vh; border-radius:8px; }
.pc-preview-close { position:absolute; top:16px; right:16px; width:36px; height:36px; border:none; border-radius:50%; background:rgba(255,255,255,.15); color:#fff; font-size:20px; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0; }
.pc-preview-nav { position:absolute; top:50%; transform:translateY(-50%); width:44px; height:44px; border:none; border-radius:50%; background:rgba(255,255,255,.15); color:#fff; font-size:22px; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0; }
.pc-preview-nav:hover { background:rgba(255,255,255,.25); }
.pc-preview-prev { left:16px; }
.pc-preview-next { right:16px; }
.pc-side { display:flex; flex-direction:column; min-width:0; }
.pc-actions { display:flex; gap:8px; flex-wrap:wrap; align-items:center; justify-content:center; margin-bottom:14px; }
.pc-btn {
    padding:9px 14px; border-radius:9px; font-size:12px; font-weight:700; font-family:inherit;
    cursor:pointer; border:1.5px solid var(--border); background:#fff; color:var(--text);
    display:inline-flex; align-items:center; gap:6px; transition:.15s; margin:0;
}
.pc-btn:hover { background:#f8f9fc; }
.pc-btn:disabled { opacity:.45; cursor:not-allowed; }
.pc-btn-on { background:var(--blue); border-color:var(--blue); color:#fff; }
.pc-btn-on:hover { background:var(--blue-dk); }
.pc-btn-on:disabled { background:#e5e7eb; border-color:#e5e7eb; color:#9ca3af; opacity:1; }
.pc-btn-shot { width:100%; justify-content:center; padding:12px 14px; font-size:13px; }
.pc-btn-shot i { font-size:22px; }
.pc-footer { display:flex; gap:8px; justify-content:flex-end; }

@@media (orientation: landscape) and (max-height: 600px) {
    .pc-modal-card { width:min(900px, 94vw); height:90vh; }
    .pc-head { margin-bottom:8px; }
    .pc-body {
        flex:1; min-height:0;
        display:grid;
        grid-template-columns: 1fr 110px;
        grid-template-rows: 1fr auto;
        grid-template-areas: "camera side" "thumbs thumbs";
        gap:10px;
    }
    .pc-camera { grid-area:camera; margin-bottom:0; min-height:0; }
    .pc-camera video { width:100%; height:100%; aspect-ratio:auto; }
    .pc-thumbs { grid-area:thumbs; margin-bottom:0; flex-wrap:nowrap; overflow-x:auto; }
    .pc-side { grid-area:side; align-items:center; }
    .pc-actions { flex:1; margin-bottom:0; }
    .pc-btn-shot { width:64px; height:64px; border-radius:50%; padding:0; font-size:20px; }
    .pc-btn-shot .pc-btn-label { display:none; }
    .pc-footer { flex-direction:column; width:100%; }
    .pc-footer .pc-btn { width:100%; justify-content:center; }
}
</style>

<div class="pc-modal" id="@(p)PcModal">
    <div class="pc-modal-backdrop"></div>
    <div class="pc-modal-card">
        <div class="pc-head">
            <i class="bi bi-camera"></i>
            <span>Confirm Images</span>
            <span class="pc-count" id="@(p)PcCount">0/10</span>
        </div>
        <div class="pc-body">
            <div class="pc-camera">
                <video id="@(p)PcVideo" autoplay playsinline muted></video>
            </div>
            <div class="pc-thumbs" id="@(p)PcThumbs"></div>
            <div class="pc-side">
                <div class="pc-actions">
                    <button type="button" class="pc-btn pc-btn-on pc-btn-shot" id="@(p)PcShotBtn"><i class="bi bi-camera-fill"></i></button>
                </div>
                <input type="file" id="@(p)PcFileInput" accept="image/*" capture="environment" multiple style="display:none">
                <div class="pc-footer">
                    <button type="button" class="pc-btn" id="@(p)PcCancelBtn">ยกเลิก</button>
                    <button type="button" class="pc-btn pc-btn-on" id="@(p)PcSendBtn" disabled>Send</button>
                </div>
            </div>
        </div>
        <canvas id="@(p)PcCanvas" style="display:none"></canvas>
    </div>
</div>

<div class="pc-preview" id="@(p)PcPreview">
    <button type="button" class="pc-preview-close" id="@(p)PcPreviewClose">&times;</button>
    <button type="button" class="pc-preview-nav pc-preview-prev" id="@(p)PcPreviewPrev"><i class="bi bi-chevron-left"></i></button>
    <img id="@(p)PcPreviewImg">
    <button type="button" class="pc-preview-nav pc-preview-next" id="@(p)PcPreviewNext"><i class="bi bi-chevron-right"></i></button>
</div>
