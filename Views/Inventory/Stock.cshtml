@model List<dynamic>

<h2>Inventory Stock</h2>

<table class="table table-bordered">

<thead>
<tr>
<th>Item</th>
<th>Location</th>
<th>Quantity</th>
</tr>
</thead>

<tbody>

@foreach(var item in Model)
{
<tr>
<td>@item.itemCode</td>
<td>@item.locationCode</td>
<td>@item.quantity</td>
</tr>
}

</tbody>

</table>