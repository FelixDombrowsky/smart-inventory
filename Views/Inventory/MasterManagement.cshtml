    async function bnFetchWorkOrder() {
        const wo  = document.getElementById('bnWoInput').value.trim()
        if (!wo) { showToast('กรุณากรอก Work Order No.', 'error'); return }
        const btn = document.getElementById('bnWoFetchBtn')
        btn.disabled = true; btn.textContent = '⏳ Loading…'
        try {
            const res = await api(`/workorder/${encodeURIComponent(wo)}/detail`)
            document.getElementById('bnWoMo').textContent    = res.moNumber  ?? '—'
            document.getElementById('bnWoModel').textContent = res.modelName ?? '—'
            document.getElementById('bnWoQty').textContent   = res.targetQty ?? '—'
            document.getElementById('bnWoLine').textContent  = res.lineName  ?? '—'
            _bnComponents = (res.items || [])
                .filter(it => (it.planQty ?? 0) > 0)
                .map(it => ({ componentItemId: it.itemId, partNo: it.partNo ?? String(it.itemId), quantity: it.planQty }))
            document.getElementById('bnWoItems').textContent = _bnComponents.length + ' items'
            document.getElementById('bnWoPreview').style.display = ''
            showToast(`โหลด Work Order สำเร็จ — ${_bnComponents.length} items`, 'success')
        } catch (err) {
            showToast('ไม่พบ Work Order: ' + err.message, 'error')
            document.getElementById('bnWoPreview').style.display = 'none'
        } finally {
            btn.disabled = false; btn.textContent = 'Fetch'
        }
    }

