    <!-- ── FORM ── -->
    <div class="form-side">
        <div class="form-header">
            <img src="/image/packaging_icon.png" class="form-logo" alt="logo">
            <span class="form-brand">SmartFactory</span>
            <button class="theme-toggle" onclick="toggleTheme()" id="themeBtn" title="Toggle theme">
                <i class="bi bi-moon-fill" id="themeIcon"></i>
            </button>
        </div>

        <div class="form-body">
            <div class="form-title">Sign In</div>
            

            <div class="field">
                <label>Username</label>
                <input id="username" type="text" placeholder="Enter your ID" autocomplete="username"
                    onkeydown="if(event.key==='Enter')document.getElementById('password').focus()">
            </div>

            <div class="field">
                <label>Password</label>
                <div class="field-password">
                    <input id="password" type="password" placeholder="••••••••" autocomplete="current-password"
                        onkeydown="if(event.key==='Enter')login()">
                    <button class="toggle-pw" type="button" onclick="togglePw()" tabindex="-1">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            

            <button class="btn-signin" id="signinBtn" onclick="login()">
                <span>Sign In</span>
                <span class="arrow">›</span>
            </button>
            <div class="signin-err" id="signinErr"></div>

            <div class="form-switch">ยังไม่มีบัญชี? <a href="https://10.204.212.22:8443/" target="_blank" rel="noopener noreferrer">Create Account</a></div>
        </div>

        <div class="form-footer">© 2026 SmartFactory Inc.</div>
    </div>

    <script src="/js/config.js"></script>
    <script>
        // ── Theme ──
        const THEME_KEY = 'sf_theme'   // ใช้ key เดียวกับหน้า Inventory (_Layout.cshtml) เพื่อให้ theme sync กันข้ามหน้า
        const html      = document.documentElement

        function applyTheme(t) {
            html.setAttribute('data-theme', t)
            document.getElementById('themeIcon').className =
                t === 'dark' ? 'bi bi-moon-fill' : 'bi bi-sun-fill'
            localStorage.setItem(THEME_KEY, t)
        }

        function toggleTheme() {
            applyTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark')
        }

        // Restore saved preference
        applyTheme(localStorage.getItem(THEME_KEY) || 'light')

        // ── Password toggle ──
        function togglePw() {
            const inp  = document.getElementById('password')
            const icon = document.getElementById('eyeIcon')
            inp.type = inp.type === 'password' ? 'text' : 'password'
            icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash'
        }

        // ── Landing page (ต้อง sync กับ FULL_ACCESS_ROLES / PAGE_PERMISSIONS / goHome() ใน _Layout.cshtml) ──
        const FULL_ACCESS_ROLES = ['Admin']
        const PAGE_PERMISSIONS = [
            { perm: 'WMS.UI.Page.Dashboard',    url: '/Inventory/Dashboard'        },
            { perm: 'WMS.UI.Page.OpDashboard',  url: '/Inventory/OpDashboard'      },
            { perm: 'WMS.UI.Page.Lots',         url: '/Inventory/Lots'             },
            { perm: 'WMS.UI.Page.WorkOrders',   url: '/Inventory/WorkOrders'       },
            { perm: 'WMS.UI.Page.Receive',      url: '/Inventory/Receive'          },
            { perm: 'WMS.UI.Page.Move',         url: '/Inventory/Move'             },
            { perm: 'WMS.UI.Page.Transactions', url: '/Inventory/Transactions'     },
            { perm: 'WMS.UI.Page.Master',       url: '/Inventory/MasterManagement' },
            { perm: 'WMS.UI.Page.Print',        url: '/Inventory/PrintQR'          },
        ]

        function resolveLandingPage(user) {
            const roles = Array.isArray(user.roles) ? user.roles : []
            if (roles.some(r => FULL_ACCESS_ROLES.includes(r))) return '/Inventory/Dashboard'

            const perms   = Array.isArray(user.permissions) ? user.permissions : []
            const hasPerm = p => perms.includes(p)

            if      (hasPerm('WMS.UI.Page.Dashboard'))   return '/Inventory/Dashboard'
            else if (hasPerm('WMS.UI.Page.OpDashboard')) return '/Inventory/OpDashboard'
            else if (hasPerm('WMS.UI.Page.Print'))       return '/Inventory/PrintQR'

            return PAGE_PERMISSIONS.find(p => hasPerm(p.perm))?.url || '/Inventory/Dashboard'
        }

        // ── Login ──
        function showErr(msg) {
            const el = document.getElementById('signinErr')
            el.textContent = msg; el.style.display = 'block'
        }

        async function login() {
            const btn      = document.getElementById('signinBtn')
            const username = document.getElementById('username').value.trim()
            const password = document.getElementById('password').value
            document.getElementById('signinErr').style.display = 'none'
            if (!username || !password) { showErr('Please enter username and password.'); return }

            btn.disabled = true
            btn.innerHTML = '<span>Signing in…</span>'
            try {
                const res = await fetch(CONFIG.AUTH_API + '/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                })
                if (!res.ok) { showErr('Login failed: ' + (await res.text() || res.statusText)); return }
                const data = await res.json()
                data.username = username
                localStorage.setItem('token', data.token)
                localStorage.setItem('user', JSON.stringify(data))
                window.location = resolveLandingPage(data)
            } catch (e) {
                showErr('Connection error: ' + e.message)
            } finally {
                btn.disabled = false
                btn.innerHTML = '<span>Sign In</span><span class="arrow">›</span>'
            }
        }
    </script>
</body>
</html>
