@{
    ViewData["Title"] = "Merge Lot";
}
<!-- @@font-face ของ ZebraFont (ใช้ตอน render ZPL ผ่าน renderZplClient) — ประกาศไว้ที่ printqr.css ไฟล์เดียวกับ PrintQR.cshtml
     ยังไม่มี preview canvas ในหน้านี้ตอนนี้ แต่ include ไว้กันปัญหา font ไม่ตรงถ้าเพิ่ม Label Preview ในอนาคต -->
<link rel="stylesheet" href="css/printqr.css"/>
<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --green:#059669; --green-lt:#ecfdf5;
    --red:#dc2626; --red-lt:#fef2f2; --amber:#d97706; --amber-lt:#fffbeb;
}

.page-header {
    background:linear-gradient(135deg,var(--navy) 0%,#1e3a6e 60%,#1a6fff 100%);
    border-radius:16px; padding:20px 28px; margin-bottom:20px;
    position:relative; overflow:hidden;
}
.page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04); }
.page-header h2 { font-size:22px; font-weight:700; color:#fff; margin-bottom:4px; }

.rp-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.rp-card-head {
    padding:12px 18px; border-bottom:1px solid var(--border);
    font-size:13px; font-weight:700; color:var(--navy);
    display:flex; align-items:center; gap:8px; justify-content:flex-start;
}
.rp-card-body { padding:18px 20px; }

.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:10px 12px 10px 38px;
    border:1.5px solid var(--border); border-radius:10px;
    font-size:14px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item { padding:10px 14px; font-size:13px; cursor:pointer; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; transition:.12s; }
.loc-item:last-child  { border-bottom:none; }
.loc-item:hover       { background:var(--blue-lt); }

.icon-btn {
    width:34px; height:34px; border-radius:9px; border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:16px;
    transition:.15s; flex-shrink:0;
}
.icon-btn:disabled { opacity:.35; cursor:not-allowed; }

/* Barcode-type toggle (Our vs Vendor) — pill segmented control */
.bc-mode-group {
    display:flex; align-items:center; gap:2px; flex-shrink:0;
    height:44px; padding:3px; box-sizing:border-box;
    background:#eef1f6; border-radius:11px;
}
.bc-mode-btn {
    display:flex; align-items:center; gap:6px;
    height:100%; padding:0 14px; border:none; border-radius:8px;
    background:transparent; color:var(--t2); font-size:13px; font-weight:600;
    font-family:inherit; cursor:pointer; transition:.15s; white-space:nowrap;
}
.bc-mode-btn i { font-size:15px; }
.bc-mode-btn:hover:not(.active) { color:var(--navy); }
.bc-mode-btn.active { background:#fff; color:var(--navy); box-shadow:0 1px 3px rgba(0,0,0,.12); }
.bc-mode-btn.active i { color:var(--blue); }

.count-badge {
    font-size:11px; font-weight:700; padding:2px 9px;
    border-radius:20px; background:var(--blue-lt); color:var(--blue);
}

.rx-table { width:100%; border-collapse:collapse; font-size:13px; }
.rx-table th {
    background:#f8f9fc; color:var(--t2); font-weight:700; font-size:11px;
    letter-spacing:.04em; text-transform:uppercase;
    padding:10px 16px; border-bottom:2px solid var(--border); text-align:left;
}
.rx-table td { padding:9px 16px; border-bottom:1px solid var(--border); vertical-align:middle; }
.rx-table tr:last-child td { border-bottom:none; }
.rx-table tbody tr:hover td { background:#fafbff; }
.rx-table tbody tr.row-err td { background:var(--red-lt); }
.rx-table tbody tr.row-err td:first-child { border-left:3px solid var(--red); }
.rx-table tbody tr.row-err-detail td { background:var(--red-lt); border-top:1px solid #fecaca; border-left:3px solid var(--red); padding:4px 14px 7px; }
.rx-table tbody tr.row-warn td { background:var(--amber-lt); }
.rx-table tbody tr.row-warn td:first-child { border-left:3px solid var(--amber); }
.del-btn { width:30px; height:30px; border:none; border-radius:7px; background:#fef2f2; color:var(--red); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.del-btn:hover { background:var(--red); color:#fff; }
.row-processing td { opacity:.5; pointer-events:none; }
.empty-state { padding:36px; text-align:center; color:var(--t3); font-size:13px; }

.merge-warn-banner {
    display:none; padding:10px 16px; background:var(--amber-lt); border-bottom:1px solid #fde68a;
    color:var(--amber); font-size:12px; font-weight:600; align-items:center; gap:8px;
}

.merge-result-banner {
    display:none; padding:14px 18px; background:var(--green-lt); border:1px solid #a7f3d0; border-radius:12px;
    margin-bottom:16px; font-size:13px; color:var(--green); font-weight:600; align-items:center; gap:10px;
}

.merge-grid { display:grid; grid-template-columns:1fr 40px 1fr; gap:12px; align-items:start; margin-bottom:16px; }
/* grid item ปกติจะไม่ยอมหดเล็กกว่า min-content ของลูก (ตาราง) ทำให้ grid ดันกว้างเกิน viewport แทนที่จะ scroll ในการ์ดตัวเอง
   ต้องบังคับ min-width:0 ให้ยอมหดตาม track จริง แล้วให้ overflow-x:auto ของ div ครอบตารางทำงานแทน */
.merge-grid > .rp-card { min-width:0; }
.merge-arrow { display:flex; align-items:center; justify-content:center; min-height:140px; color:var(--blue); font-size:24px; }
@@media (max-width:900px) {
    .merge-grid { grid-template-columns:1fr; }
    .merge-arrow { min-height:auto; padding:4px 0; transform:rotate(90deg); }
}
.new-lot-qty { color:var(--blue); }

/* ── Print Panel (Layout Template + Label Preview + Printer) — แสดงทุก orientation ── */
.mg-right { margin-bottom:16px; }
.mg-preview-box {
    display:flex; align-items:center; justify-content:center; background:#f8f9fc;
    border:1px solid var(--border); border-radius:10px; min-height:180px; padding:12px; margin-bottom:14px;
}
.mg-preview-box img { max-width:100%; max-height:220px; border-radius:6px; box-shadow:0 2px 8px rgba(0,0,0,.1); }
.mg-divider { display:block; border-top:1px solid var(--border); margin:4px 0 16px; }

/* ── 2-column layout (Merge List/New-Lot+Options ซ้าย, Print Panel ขวา) — เฉพาะ tablet แนวนอนที่จอกว้างพอ
     แนวตั้ง/จอแคบ: mg-left กับ mg-right แค่เรียงต่อกันปกติ (block) — เนื้อหา Print Panel ยังโชว์เหมือนกันแค่คนละตำแหน่ง ── */
.mg-two-col { display:block; }
@@media (orientation:landscape) and (min-width:900px) {
    .mg-two-col { display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start; }
    .mg-two-col > .mg-left, .mg-two-col > .mg-right { min-width:0; }
    .mg-left .merge-grid { grid-template-columns:1fr; }
    .mg-left .merge-arrow { min-height:auto; padding:4px 0; transform:rotate(90deg); }
}

.merge-btn {
    width:100%; padding:14px; border:none; border-radius:12px;
    font-size:15px; font-weight:700; font-family:inherit; cursor:pointer;
    transition:.2s; background:var(--blue); color:#fff; margin-top:4px;
}
.merge-btn:disabled { background:#e5e7eb; color:#9ca3af; cursor:not-allowed; }
.merge-btn:not(:disabled):hover { background:var(--blue-dk); }

.toast-wrap { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; max-width:min(90vw,380px); }
.toast-item { padding:11px 20px; border-radius:10px; font-size:13px; font-weight:600; color:#fff; box-shadow:0 4px 16px rgba(0,0,0,.18); animation:tIn .25s ease; min-width:160px; }
.toast-ok   { background:var(--green); }
.toast-err  { background:var(--red); }
.toast-warn { background:var(--amber); }
.toast-item.toast-mono {
    max-height:40vh; overflow-y:auto; pointer-events:auto; cursor:text;
    background:#1e293b; font-family:ui-monospace,monospace; font-size:11px; font-weight:400;
    line-height:1.5; white-space:pre-wrap; word-break:break-word;
}
@@keyframes tIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:none} }
</style>

<div class="toast-wrap" id="toastWrap"></div>

<!-- ── Header ── -->
<div class="page-header">
    <h2 style="display:flex;align-items:center;gap:10px;margin:0">
        Merge Lot
        <i class="bi bi-union" style="opacity:.85;font-size:22px"></i>
    </h2>
</div>

<!-- ── Result banner (แสดง Lot ใหม่หลัง Merge สำเร็จ) ── -->
<div class="merge-result-banner" id="mgResultBanner">
    <i class="bi bi-check-circle-fill" style="font-size:20px"></i>
    <div>Merge สำเร็จ — Lot ใหม่: <strong id="mgResultLotNo">—</strong></div>
</div>

<!-- ── 1. Scan / Search Lots ── -->
<div class="rp-card" style="overflow:visible">
    <div class="rp-card-body">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
            <div style="flex:1;min-width:180px">
                <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                    <i class="bi bi-upc-scan me-1" style="color:var(--blue)"></i>เพิ่ม Lot ที่ต้องการ Merge
                </div>
                <div class="loc-wrap">
                    <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                    <input id="mgManualInput" class="loc-input"
                           placeholder="พิมพ์ Lot No เพื่อค้นหา…"
                           autocomplete="off"
                           oninput="mgManualAutocomplete()"
                           onkeydown="if(event.key==='Enter'){event.preventDefault();mgManualEnter();}"
                           onblur="setTimeout(mgHideLotDd,200)">
                    <div id="mgManualDd" class="loc-dd"></div>
                </div>
            </div>
            <!-- Barcode type: Our (QR) vs Vendor -->
            <div class="bc-mode-group" id="mgBcModeGroup" title="เลือกประเภท Barcode ที่จะอ่าน">
                <button type="button" class="bc-mode-btn active" data-mode="our" onclick="setMgBarcodeMode('our')" title="Our Barcode">
                    <i class="bi bi-qr-code-scan"></i><span>Our</span>
                </button>
                <button type="button" class="bc-mode-btn" data-mode="vendor" onclick="setMgBarcodeMode('vendor')" title="Vendor Barcode">
                    <i class="bi bi-upc"></i><span>Vendor</span>
                </button>
            </div>
            <button id="mgCamBtn" class="icon-btn" title="Camera scan"
                    style="background:var(--blue);color:#fff;width:44px;height:44px;font-size:20px;flex-shrink:0"
                    onclick="mgToggleCam()">
                <i class="bi bi-camera-fill"></i>
            </button>
            <button id="mgHwBtn" class="icon-btn" title="HW scanner"
                    style="background:#6b7280;color:#fff;width:44px;height:44px;font-size:20px;flex-shrink:0"
                    onclick="mgToggleHwScan()">
                <i class="bi bi-upc-scan"></i>
            </button>
        </div>
    </div>
</div>

<!-- ── Camera section ── -->
<partial name="_BarcodeScannerSection" />

<!-- ── HW Scanner Section (inline) ── -->
<partial name="_HwScannerSection" />

<!-- ── 2. Merge List → New-Lot Preview + Print Panel ── -->
<!-- mg-two-col เป็น block ปกติตอน portrait (แค่ mg-left แล้ว mg-right เรียงต่อกันตามลำดับ DOM)
     พอเป็น landscape+tablet กว้าง ถึงกลายเป็น 2 คอลัมน์จริง (ดู @@media ด้านบน) -->
<div class="mg-two-col">
    <div class="mg-left">
        <div class="merge-grid">
            <div class="rp-card" style="overflow:visible;margin-bottom:0">
                <div class="rp-card-head">
                    <i class="bi bi-union" style="color:var(--blue)"></i>
                    <span>Merge List</span>
                    <span class="count-badge" id="mgCountBadge">0/10</span>
                </div>

                <div class="merge-warn-banner" id="mgWarnBanner">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Lot ใน list มี Part No ไม่ตรงกัน — ตรวจสอบก่อน Merge</span>
                </div>

                <div style="overflow-x:auto">
                    <table class="rx-table">
                        <thead>
                            <tr>
                                <th>Part No</th>
                                <th>Lot No</th>
                                <th>W/O</th>
                                <th>Location</th>
                                <th style="text-align:right">QTY</th>
                                <th style="width:46px"></th>
                            </tr>
                        </thead>
                        <tbody id="mgTable">
                            <tr id="mgEmptyRow">
                                <td colspan="6" class="empty-state">
                                    <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                                    ยังไม่มีรายการ — สแกน QR หรือค้นหา Lot No
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="merge-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="rp-card" style="overflow:visible;margin-bottom:0">
                <div class="rp-card-head">
                    <i class="bi bi-box-seam" style="color:var(--blue)"></i>
                    <span>New-Lot</span>
                </div>
                <div style="overflow-x:auto">
                    <table class="rx-table">
                        <thead>
                            <tr>
                                <th>Part No</th>
                                <th>Lot No</th>
                                <th>W/O</th>
                                <th>Location</th>
                                <th style="text-align:right">QTY</th>
                                <th style="width:46px"></th>
                            </tr>
                        </thead>
                        <tbody id="mgNewLotTable">
                            <tr id="mgNewLotEmptyRow">
                                <td colspan="6" class="empty-state">รอเพิ่ม Lot เข้า Merge List</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Advanced Options -->
        <partial name="_AdvancedOptions" />
    </div>

    <div class="mg-right rp-card">
        <div class="rp-card-head">
            <i class="bi bi-printer" style="color:var(--blue)"></i>
            <span>Print Settings</span>
        </div>
        <div class="rp-card-body">
            <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:6px">
                Layout Template <span style="color:var(--red)">*</span>
            </div>
            <select id="mgLayoutSelect" class="loc-input" style="padding-left:12px;margin-bottom:16px" onchange="mgLayoutChanged()"><option value="">Loading…</option></select>

            <div class="mg-preview-box" id="mgPreviewImgBox"><div class="empty-state" style="padding:0">No items yet</div></div>

            <div class="mg-divider"></div>

            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                <span style="font-size:12px;font-weight:700;color:var(--t2)">Printer</span>
                <button type="button" class="rp-pd-refresh-btn" title="Refresh Printer" onclick="printerPickerManualRefresh(mgPrinterPicker, this)">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
            </div>
            <div class="rp-pd-wrap" style="margin-bottom:16px">
                <div class="rp-pd-trigger" id="mgPrinterTrigger" tabindex="0">
                    <div class="rp-pd-val">
                        <span class="rp-pd-dot" id="mgPrinterDot" style="display:none"></span>
                        <div>
                            <div class="rp-pd-sel-name" id="mgPrinterName" style="color:var(--t2);font-weight:400">-- Select Printer --</div>
                            <div class="rp-pd-sel-ip" id="mgPrinterIp" style="display:none"></div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-down rp-pd-chevron"></i>
                </div>
                <div class="rp-pd-menu" id="mgPrinterMenu" style="display:none">
                    <div class="rp-pd-msg">⏳ Loading…</div>
                </div>
                <input type="hidden" id="mgPrinterSelect">
            </div>

            <button class="merge-btn" id="mgMergeBtn" onclick="submitMerge()" disabled>Merge</button>
        </div>
    </div>
</div>

<!-- ── Action choice modal (เฉพาะ user ที่มีสิทธิ์ WMS.UI.Merge.SkipPrint) ── -->
<div id="mgActionModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1150;align-items:center;justify-content:center" onclick="if(event.target===this)mgCloseActionModal()">
    <div style="background:#fff;border-radius:16px;width:92%;max-width:340px;padding:20px;box-shadow:0 12px 40px rgba(0,0,0,.2);text-align:center">
        <div style="font-size:15px;font-weight:700;color:var(--navy);margin-bottom:16px">เลือกการทำงาน</div>
        <button onclick="mgChooseAction('printMerge')" style="width:100%;padding:13px;margin-bottom:10px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit">
            🖨️ Print &amp; Merge
        </button>
        <button onclick="mgChooseAction('mergeOnly')" style="width:100%;padding:13px;margin-bottom:10px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit">
            Merge Only
        </button>
        <button onclick="mgCloseActionModal()" style="width:100%;padding:10px;background:none;border:none;color:var(--t2);font-size:13px;cursor:pointer;font-family:inherit">ยกเลิก</button>
    </div>
</div>

<partial name="_PhotoCapture" model="@("mg")" />

<!-- ── Pick Lot modal (raw barcode เดียวกันผูกกับหลาย lot ให้เลือก) ── -->
<div id="mgPickLotModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)closeMgPickLot()">
    <div style="background:#fff;border-radius:14px;width:90%;max-width:360px;max-height:70vh;display:flex;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.2)">
        <div style="padding:16px 18px 10px;font-size:15px;font-weight:700;color:var(--navy);flex-shrink:0">เลือก Lot ที่ต้องการ (<span id="mgPickLotCount">0</span> รายการ)</div>
        <div id="mgPickLotList" style="overflow-y:auto;padding:0 10px 10px"></div>
        <div style="padding:10px 18px 16px;flex-shrink:0">
            <button onclick="closeMgPickLot()" style="width:100%;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">ยกเลิก</button>
        </div>
    </div>
</div>

<!-- ── Confirm Delete modal ── -->
<div id="mgConfirmDeleteModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)mgCancelDeleteRow()">
    <div style="background:#fff;border-radius:14px;width:90%;max-width:320px;padding:24px 20px 16px;box-shadow:0 12px 40px rgba(0,0,0,.2);text-align:center">
        <i class="bi bi-trash3" style="font-size:36px;color:var(--red);display:block;margin-bottom:12px"></i>
        <p style="font-size:14px;font-weight:700;color:var(--navy);margin:0 0 4px">ลบรายการนี้?</p>
        <p id="mgDeletePartLabel" style="font-size:12px;color:var(--t2);margin:0 0 16px;word-break:break-all"></p>
        <div style="display:flex;gap:8px">
            <button onclick="mgCancelDeleteRow()" style="flex:1;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">ยกเลิก</button>
            <button onclick="mgConfirmDeleteRow()" style="flex:1;padding:11px;background:var(--red);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">ลบ</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/zplBuilder.js"></script>
<script src="js/printerPicker.js"></script>
<script src="js/apiForm.js"></script>
<script src="js/photoCapture.js"></script>
<script src="js/barcodeScanner.js"></script>
<script src="js/hwScanner.js"></script>
<script src="js/scanPipeline.js"></script>
<script src="js/loadLocation.js"></script>
<script src="lib/html5-qrcode/html5-qrcode.min.js"></script>
<script>
    // ── State ─────────────────────────────────────────
    let mgScannedLots = new Set()
    let _mgMerging = false

    function toast(msg, type, opts) {
        const wrap = document.getElementById('toastWrap');
        const el   = document.createElement('div');
        el.className = 'toast-item ' + (type === 'ok' ? 'toast-ok' : type === 'warn' ? 'toast-warn' : 'toast-err');
        if (opts?.mono) el.classList.add('toast-mono')
        el.textContent = msg;
        wrap.appendChild(el);
        const duration = opts?.duration ?? (type === 'warn' ? 5000 : 3000)
        setTimeout(() => el.remove(), duration);
        return el
    }

    // toast payload เป็น JSON อ่านง่าย — ใช้ตอนดู payload จริงบน tablet ที่เปิด console ไม่ได้
    function toastPayload(label, payload) {
        toast(`${label}\n${JSON.stringify(payload, null, 2)}`, 'ok', { mono: true, duration: 12000 })
    }

    function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    // ── Manual Search ─────────────────────────────────
    let _mgManualTimer = null, _mgManualResults = []

    function mgHideLotDd() {
        document.getElementById('mgManualDd').style.display = 'none'
    }

    function mgManualAutocomplete() {
        const inp  = document.getElementById('mgManualInput')
        const dd   = document.getElementById('mgManualDd')
        const text = inp.value.trim()
        if (!text) { dd.style.display = 'none'; return }

        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <i class="bi bi-hourglass-split me-2"></i>กำลังค้นหา…</div>`
        dd.style.display = 'block'

        clearTimeout(_mgManualTimer)
        _mgManualTimer = setTimeout(async () => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: text })
                const list = Array.isArray(res) ? res : (res?.data || [])
                if (!list.length) {
                    _mgManualResults = []
                    dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                        <i class="bi bi-search me-2"></i>ไม่พบ Lot No</div>`
                    return
                }
                _mgManualResults = list
                dd.innerHTML = list.map((l, i) => `
                    <div class="loc-item" onmousedown="mgManualSelect(${i})">
                        <div>
                            <div style="font-weight:700;font-size:13px">${esc(l.lotNo || '')}</div>
                            ${l.partNo ? `<div style="font-size:11px;color:var(--t3)">${esc(l.partNo)}</div>` : ''}
                        </div>
                        <span style="margin-left:auto;font-size:11px;color:var(--t2)">${esc(locName(l.location ?? l.locationCode ?? ''))}</span>
                    </div>`).join('')
                dd.style.display = 'block'
            } catch (err) {
                _mgManualResults = []
                dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                    <i class="bi bi-exclamation-circle me-2"></i>${esc(err.message || 'Error')}</div>`
            }
        }, 300)
    }

    // ── Validate: lot ที่จะ add ต้อง W/O + Part No ตรงกับ lot แรกในลิสต์ทุกตัว (merge ข้าม W/O หรือ Part กันไม่ได้) ──
    // เช็คเฉพาะตอนลิสต์มี lot อยู่แล้วอย่างน้อย 1 ตัว — lot แรกสุดผ่านได้เสมอ (ยังไม่มีอะไรให้เทียบ)
    function _mgValidateLotMatch(lot) {
        const firstRow = document.querySelector('#mgTable tr[data-lot-no]')
        if (!firstRow) return true
        const wo      = (lot.workOrder ?? '').trim()
        const partNo  = (lot.partNo ?? '').trim()
        const firstWo = firstRow.dataset.wo ?? ''
        const firstPn = firstRow.dataset.partNo ?? ''
        if (wo !== firstWo || partNo !== firstPn) {
            toast(`Scan ไม่ผ่าน: W/O・Part No ต้องตรงกับ Lot แรก (W/O "${firstWo || '—'}" / Part "${firstPn || '—'}")`, 'err')
            return false
        }
        return true
    }

    // ── จุดเดียวที่ add lot เข้าลิสต์จริง — ผ่าน dedupe + validate W/O・Part No ก่อนเสมอ ──
    function _mgTryAddLot(lot) {
        if (mgScannedLots.has(lot.lotNo)) { toast('ซ้ำ: ' + lot.lotNo, 'warn'); return false }
        if (!_mgValidateLotMatch(lot)) return false
        mgScannedLots.add(lot.lotNo)
        mgAddRow(lot)
        toast('✓ ' + lot.lotNo, 'ok')
        return true
    }

    function mgManualSelect(i) {
        const lot = _mgManualResults[i]
        if (!lot) return
        mgHideLotDd()
        document.getElementById('mgManualInput').value = ''
        _mgTryAddLot(lot)
    }

    async function mgManualEnter() {
        const val = document.getElementById('mgManualInput').value.trim()
        if (!val) return
        const dd = document.getElementById('mgManualDd')
        clearTimeout(_mgManualTimer)
        if (dd.style.display !== 'none' && _mgManualResults.length) {
            mgManualSelect(0)
            return
        }
        mgHideLotDd()
        document.getElementById('mgManualInput').value = ''
        try {
            const res  = await api('/inventory/lots', 'POST', { lotNo: val })
            const list = Array.isArray(res) ? res : (res?.data || [])
            const match = list.find(l => (l.lotNo || '').toLowerCase() === val.toLowerCase()) ?? list[0]
            if (!match) { toast('ไม่พบ Lot: ' + val, 'err'); return }
            _mgTryAddLot(match)
        } catch (err) {
            toast('ค้นหาไม่สำเร็จ: ' + err.message, 'err')
        }
    }

    // ── Scan pipeline ──────────────────────────────────
    function mgScanSetStatus(t) {
        const statusCam = document.getElementById('bcStatus')
        const statusHw  = document.getElementById('hwStatus')
        if (statusCam) statusCam.textContent = t
        if (statusHw)  statusHw.textContent  = t
    }

    async function mgAddScannedLot(lotNo) {
        if (!lotNo) { toast('No Lot, Please Receive first.', 'err'); return }
        if (mgScannedLots.has(lotNo)) { toast('ซ้ำ: ' + lotNo, 'warn'); return }
        const res  = await api('/inventory/lots', 'POST', { lotNo, page: 1, pageSize: 1 })
        const list = Array.isArray(res) ? res : (res?.data ?? [])
        const lot  = list[0]
        if (!lot) { toast('ไม่พบ Lot: ' + lotNo, 'err'); return }
        _mgTryAddLot(lot)
    }

    // ── Barcode type toggle (Our QR vs Vendor label) ──
    let mgBarcodeMode = 'our'
    function setMgBarcodeMode(m) {
        mgBarcodeMode = m
        document.querySelectorAll('#mgBcModeGroup .bc-mode-btn').forEach(btn =>
            btn.classList.toggle('active', btn.dataset.mode === m))
        toast('โหมดสแกน: ' + (m === 'our' ? 'Our Barcode' : 'Vendor Barcode'), 'ok')
    }

    const mgScan = createScanPipeline({
        mode: 'ours',
        barcodeFilter: () => mgBarcodeMode,
        onResult: async ({ lotNo, matches, notOurFormat, wrongModeOur }) => {
            mgScanSetStatus('กำลังประมวลผล…')
            try {
                if (wrongModeOur || notOurFormat) return // สแกนผิดโหมด — เงียบไว้ ไม่ต้องแจ้งอะไร
                if (Array.isArray(matches) && matches.length > 1) {
                    await openMgPickLot(matches)
                    return
                }
                await mgAddScannedLot(lotNo)
            } finally {
                mgScanSetStatus('พร้อมสแกน…')
            }
        }
    })

    let _mgPickLots = []

    async function openMgPickLot(matches) {
        document.getElementById('mgPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px"><span class="spinner-border spinner-border-sm me-2"></span>กำลังโหลดข้อมูล…</div>`
        document.getElementById('mgPickLotModal').style.display = 'flex'

        // บังคับ availableOnly เสมอ — lot ที่ของหมด/ไม่ available จะไม่ถูกคืนมาจาก API เลย (lot: null) กรองทิ้งไม่ให้ขึ้นในลิสต์ให้เลือก
        const fetched = await Promise.all((matches || []).map(async m => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: m.lotNo, page: 1, pageSize: 1, availableOnly: true })
                const list = Array.isArray(res) ? res : (res?.data ?? [])
                return { lotNo: m.lotNo, lot: list[0] ?? null }
            } catch (_) {
                return { lotNo: m.lotNo, lot: null }
            }
        }))
        _mgPickLots = fetched.filter(m => m.lot)
        document.getElementById('mgPickLotCount').textContent = _mgPickLots.length

        if (!_mgPickLots.length) {
            document.getElementById('mgPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px">ไม่พบ Lot ที่ Available</div>`
            return
        }

        document.getElementById('mgPickLotList').innerHTML = _mgPickLots.map((m, i) => {
            const lot = m.lot || {}
            return `<button onclick="mgPickLotSelect(${i})" style="width:100%;text-align:left;padding:11px 10px;border:none;border-bottom:1px solid #eee;background:#fff;cursor:pointer;font-family:inherit">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:3px">
                    <span style="font-weight:700;color:var(--navy);font-family:ui-monospace,monospace;font-size:13px">${m.lotNo ?? '—'}</span>
                    <span style="font-size:13px;font-weight:700;color:var(--blue)">${lot.onHandQty ?? '—'} ${lot.unit ?? ''}</span>
                </div>
                <div style="font-size:12px;color:var(--t2);display:flex;gap:12px;flex-wrap:wrap">
                    <span>W/O: ${lot.workOrder || '—'}</span>
                    <span>Part: ${lot.partNo || '—'}</span>
                </div>
            </button>`
        }).join('')
    }

    function closeMgPickLot() {
        document.getElementById('mgPickLotModal').style.display = 'none'
        _mgPickLots = []
    }

    function mgPickLotSelect(i) {
        const m = _mgPickLots[i]
        closeMgPickLot()
        if (!m || !m.lot) { toast('ไม่พบ LOT: ' + (m?.lotNo || ''), 'err'); return }
        _mgTryAddLot(m.lot)
    }

    // ── Camera ────────────────────────────────────────
    const mgScanner = createBarcodeScanner({
        videoId: 'bcVideo', canvasId: 'bcCanvas', labelId: 'bcLabel',
        onDetect: raw => mgScan.submit(raw)
    })

    function mgToggleCam() { if (mgScanner.running) stopScan(); else mgStartCam() }

    function setCamBtn(running) {
        const btn = document.getElementById('mgCamBtn')
        btn.style.background = running ? '#dc2626' : 'var(--blue)'
    }

    async function mgStartCam() {
        const hwSection = document.getElementById('hwSection')
        if (hwSection.style.display !== 'none') mgToggleHwScan()

        document.getElementById('bcSection').style.display = ''
        document.getElementById('bcStatus').textContent = 'กำลังสแกน…'
        setCamBtn(true)

        try {
            await mgScanner.start()
            setTorchBtn(mgScanner.hasTorch())
        } catch (err) {
            toast(err.message.includes('BarcodeDetector') ? err.message : 'ไม่สามารถเข้าถึงกล้อง: ' + err.message, 'err')
            document.getElementById('bcSection').style.display = 'none'
            setCamBtn(false)
        }
    }

    function stopScan() {
        mgScanner.stop()
        document.getElementById('bcSection').style.display = 'none'
        setCamBtn(false)
        setTorchBtn(false)
    }

    async function switchCamera() {
        await mgScanner.switchCamera()
        setTorchBtn(mgScanner.hasTorch())
    }

    function setTorchBtn(visible) {
        const btn = document.getElementById('bcTorchBtn')
        btn.style.display = visible ? 'flex' : 'none'
        btn.classList.remove('active')
    }

    async function toggleTorch() {
        const on = await mgScanner.toggleTorch()
        document.getElementById('bcTorchBtn').classList.toggle('active', on)
    }

    // ── HW Scanner ────────────────────────────────────
    const mgHwScanner = createHwScanner({
        inputId: 'hwInput', statusId: 'hwStatus',
        onScan: raw => mgScan.submit(raw)
    })

    function mgToggleHwScan() {
        const section = document.getElementById('hwSection')
        const btn     = document.getElementById('mgHwBtn')
        if (mgHwScanner.active) {
            mgHwScanner.close()
            section.style.display = 'none'
            btn.style.background  = '#6b7280'
        } else {
            section.style.display = ''
            btn.style.background  = 'var(--red)'
            if (mgScanner.running) mgToggleCam()
            mgHwScanner.open()
        }
    }

    // ── Table ─────────────────────────────────────────
    function mgAddRow(lot) {
        if (document.querySelectorAll('#mgTable tr[data-lot-no]').length >= 10) {
            toast('ครบ 10 รายการแล้ว', 'warn'); return
        }
        if (navigator.vibrate) navigator.vibrate(120)
        const empty = document.getElementById('mgEmptyRow')
        if (empty) empty.remove()

        const loc = lot.location ?? lot.locationCode ?? '—'
        const qty = lot.onHandQty ?? lot.available ?? 0

        // เก็บ field อื่นๆ ที่มีประโยชน์ตอน print label ไว้ด้วย (เผื่อ merge แล้วใช้ค่าจาก lot ต้นทางได้ — ดู _mgCommonOrMixed/mgPrintMergedLabel)
        // อันไหน lot ไม่มีค่ามาก็ปล่อยว่างไว้ (ไม่ throw ไม่ block การ add row)
        document.getElementById('mgTable').insertAdjacentHTML('beforeend', `
            <tr data-lot-no="${esc(lot.lotNo)}" data-part-no="${esc(lot.partNo ?? '')}" data-qty="${qty}"
                data-wo="${esc(lot.workOrder ?? '')}" data-loc="${esc(loc)}" data-unit="${esc(lot.unit ?? '')}"
                data-item-type="${esc(lot.itemType ?? '')}" data-description="${esc(lot.description ?? '')}"
                data-vendor="${esc(lot.vendorCode ?? lot.vendor ?? '')}" data-date-code="${esc(lot.dateCode ?? '')}"
                data-trading-code="${esc(lot.tradingCode ?? '')}" data-po="${esc(lot.po ?? '')}"
                data-inventory-no="${esc(lot.inventoryNo ?? '')}" data-trace-id="${esc(lot.traceId ?? '')}"
                data-raw-bar-code="${esc(lot.rawBarCode ?? '')}" data-line="${esc(lot.lineName ?? lot.line ?? '')}">
                <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${esc(lot.partNo ?? '—')}</td>
                <td style="color:var(--blue);font-weight:600;font-size:12px">${esc(lot.lotNo)}</td>
                <td style="font-size:12px;color:var(--t2)">${esc(lot.workOrder || '—')}</td>
                <td><span style="background:#f0f2f5;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--t2)">${esc(locName(loc))}</span></td>
                <td style="text-align:right;font-weight:700;color:var(--navy)">${qty.toLocaleString()} ${esc(lot.unit ?? '')}</td>
                <td>
                    <button class="del-btn" onclick="mgRemoveRow(this)" title="Remove"><i class="bi bi-trash3"></i></button>
                </td>
            </tr>`)

        mgUpdateState()
    }

    let _mgPendingDeleteRow = null

    function mgRemoveRow(btn) {
        _mgPendingDeleteRow = btn.closest('tr')
        document.getElementById('mgDeletePartLabel').textContent = _mgPendingDeleteRow.dataset.lotNo || ''
        document.getElementById('mgConfirmDeleteModal').style.display = 'flex'
    }

    function mgCancelDeleteRow() {
        _mgPendingDeleteRow = null
        document.getElementById('mgConfirmDeleteModal').style.display = 'none'
    }

    function mgConfirmDeleteRow() {
        if (!_mgPendingDeleteRow) return
        mgScannedLots.delete(_mgPendingDeleteRow.dataset.lotNo)
        const errDetail = _mgPendingDeleteRow.nextElementSibling
        if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
        _mgPendingDeleteRow.remove()
        _mgPendingDeleteRow = null
        document.getElementById('mgConfirmDeleteModal').style.display = 'none'
        mgCheckEmpty()
        mgUpdateState()
    }

    function mgCheckEmpty() {
        if (!document.querySelectorAll('#mgTable tr[data-lot-no]').length) {
            document.getElementById('mgTable').insertAdjacentHTML('beforeend', `
                <tr id="mgEmptyRow">
                    <td colspan="6" class="empty-state">
                        <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                        ยังไม่มีรายการ — สแกน QR หรือค้นหา Lot No
                    </td>
                </tr>`)
        }
    }

    function mgUpdateState() {
        const rows  = [...document.querySelectorAll('#mgTable tr[data-lot-no]')]
        document.getElementById('mgCountBadge').textContent = rows.length + '/10'

        // เตือนถ้า Part No ในลิสต์ไม่ตรงกันหมด (ไม่ block — backend เป็นคนตัดสินใจสุดท้าย)
        const partNos = new Set(rows.map(r => r.dataset.partNo).filter(Boolean))
        document.getElementById('mgWarnBanner').style.display = partNos.size > 1 ? 'flex' : 'none'

        const enabled = rows.length >= 2 && !_mgMerging
        const btn = document.getElementById('mgMergeBtn')
        btn.disabled = !enabled

        mgRefreshPreview(rows)
    }

    // ── Preview: New-Lot (Lot No + รวมข้อมูล) ก่อน Merge จริง ─────
    // ดึง /inventory/new-lotNo ตั้งแต่ item แรกที่เข้า list แล้ว cache ไว้ใช้ตอน submit จริง
    // (กันเลข Lot ที่ preview ให้ดู กับเลขที่ส่งไปจริงไม่ตรงกัน)
    let mgPreviewLotNo = null
    let _mgPreviewFetching = false

    // ถ้าทุกแถวมีค่าตรงกันหมด (เช่น Part No/W-O/Location เดียวกัน) ให้แสดงค่านั้น ถ้าไม่ตรงกันให้โชว์ "Mixed"
    function _mgCommonOrMixed(rows, key) {
        const vals = new Set(rows.map(r => r.dataset[key]).filter(Boolean))
        if (vals.size === 0) return '—'
        if (vals.size === 1) return [...vals][0]
        return 'Mixed'
    }

    async function mgRefreshPreview(rows) {
        const tbody = document.getElementById('mgNewLotTable')
        if (rows.length < 1) {
            mgPreviewLotNo = null
            tbody.innerHTML = `<tr id="mgNewLotEmptyRow"><td colspan="6" class="empty-state">รอเพิ่ม Lot เข้า Merge List</td></tr>`
            mgRenderPreviewPanel()
            return
        }

        const totalQty = rows.reduce((sum, r) => sum + (parseFloat(r.dataset.qty) || 0), 0)
        const partNo   = _mgCommonOrMixed(rows, 'partNo')
        const wo       = _mgCommonOrMixed(rows, 'wo')
        const locRaw   = _mgCommonOrMixed(rows, 'loc')
        const loc      = locRaw === 'Mixed' || locRaw === '—' ? locRaw : locName(locRaw)
        const unit     = _mgCommonOrMixed(rows, 'unit')

        tbody.innerHTML = `
            <tr>
                <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${esc(partNo)}</td>
                <td style="color:var(--blue);font-weight:600;font-size:12px" id="mgNewLotNoCell">${mgPreviewLotNo ? esc(mgPreviewLotNo) : '…'}</td>
                <td style="font-size:12px;color:var(--t2)">${esc(wo)}</td>
                <td><span style="background:#f0f2f5;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--t2)">${esc(loc)}</span></td>
                <td style="text-align:right;font-weight:700;color:var(--navy)" class="new-lot-qty">${totalQty.toLocaleString()} ${unit !== 'Mixed' && unit !== '—' ? esc(unit) : ''}</td>
                <td></td>
            </tr>`

        if (!mgPreviewLotNo && !_mgPreviewFetching) {
            _mgPreviewFetching = true
            try {
                const trRes = await api('/inventory/new-lotNo', 'GET')
                mgPreviewLotNo = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? null
            } catch (_) {
                mgPreviewLotNo = null
            } finally {
                _mgPreviewFetching = false
            }
            const cell = document.getElementById('mgNewLotNoCell')
            if (cell) cell.textContent = mgPreviewLotNo || '—'
        }
        mgRenderPreviewPanel()
    }

    function mgLayoutChanged() {
        mgRenderPreviewPanel()
    }

    // Production Area สำหรับพิมพ์ label — ลำดับความสำคัญ: 1) productionPlant จาก /workorder/{wo}/detail (ถ้ามี workOrder และหาเจอ)
    // 2) เดาจากชื่อ Layout Template ที่เลือก (ขึ้นต้น "FAN1_...", "FAN_2..." ฯลฯ) 3) default Fan_1 ถ้าไม่เข้า pattern ไหนเลย
    async function mgResolveProductionArea(workOrder) {
        if (!_locNameMap.size) await loadLocation()
        if (workOrder) {
            try {
                const detail = await api(`/workorder/${encodeURIComponent(workOrder)}/detail`, 'GET')
                const plant  = (detail?.productionPlant || '').trim()
                if (plant) {
                    const pm       = plant.match(/(\d+)\s*$/)
                    const areaCode = pm ? `Fan_${pm[1]}` : plant
                    const match    = Array.from(_locNameMap.values())
                        .filter(loc => (loc.typeName || '').toLowerCase() === 'factory')
                        .find(loc =>
                            (loc.locationCode || '').toLowerCase() === areaCode.toLowerCase() ||
                            (loc.displayName  || '').toLowerCase() === areaCode.toLowerCase())
                    return { code: match?.locationCode ?? areaCode, name: match?.displayName ?? areaCode }
                }
            } catch (_) { /* fall through ไป guess จาก Layout Template แทน */ }
        }
        const layoutId = document.getElementById('mgLayoutSelect')?.value
        const layout   = _mgLayouts.find(l => String(l.id) === String(layoutId))
        const tplName  = (layout?.templateName || '').trim()
        const m        = tplName.match(/^FAN_?(\d+)/i)
        const areaCode = m ? `Fan_${m[1]}` : 'Fan_1'
        const match    = Array.from(_locNameMap.values()).find(loc =>
            (loc.locationCode || '').toLowerCase() === areaCode.toLowerCase() ||
            (loc.displayName  || '').toLowerCase() === areaCode.toLowerCase())
        return { code: match?.locationCode ?? areaCode, name: match?.displayName ?? areaCode }
    }

    // Label Preview ของ New-Lot (ก้อนเดียว ไม่มี pager เหมือนหน้า Split เพราะ Merge พิมพ์แค่ label เดียวเสมอ — Lot ใหม่ที่รวมมา)
    async function mgRenderPreviewPanel() {
        const box = document.getElementById('mgPreviewImgBox')
        if (!box) return

        const rows = [...document.querySelectorAll('#mgTable tr[data-lot-no]')]
        if (rows.length < 1) {
            box.innerHTML = '<div class="empty-state" style="padding:0">No items yet</div>'
            return
        }

        const layoutId = document.getElementById('mgLayoutSelect')?.value
        if (!layoutId) {
            box.innerHTML = '<div class="empty-state" style="padding:0">เลือก Layout Template ก่อน</div>'
            return
        }
        const layout = _mgLayouts.find(l => String(l.id) === String(layoutId))
        if (!layout) {
            box.innerHTML = '<div class="empty-state" style="padding:0">ไม่พบ Layout</div>'
            return
        }

        const cfg = parseZplDataJson(layout)
        const totalQty = rows.reduce((sum, r) => sum + (parseFloat(r.dataset.qty) || 0), 0)
        const partNo       = _mgCommonOrMixed(rows, 'partNo')
        const wo           = _mgCommonOrMixed(rows, 'wo')
        const unit         = _mgCommonOrMixed(rows, 'unit')
        const itemType     = _mgCommonOrMixed(rows, 'itemType')
        const description  = _mgCommonOrMixed(rows, 'description')
        const vendor       = _mgCommonOrMixed(rows, 'vendor')
        const dateCode     = _mgCommonOrMixed(rows, 'dateCode')
        const tradingCode  = _mgCommonOrMixed(rows, 'tradingCode')
        const po           = _mgCommonOrMixed(rows, 'po')
        const inventoryNo  = _mgCommonOrMixed(rows, 'inventoryNo')
        const traceId      = _mgCommonOrMixed(rows, 'traceId')
        const rawBarCode   = _mgCommonOrMixed(rows, 'rawBarCode')
        const line         = _mgCommonOrMixed(rows, 'line')
        const clean  = v => (v === 'Mixed' || v === '—') ? '' : v
        const area   = await mgResolveProductionArea(clean(wo))

        const data = {
            partNo:              clean(partNo),
            quantity:            String(totalQty),
            unit:                clean(unit),
            itemType:            clean(itemType) || 1,
            description:         clean(description),
            vendor:              clean(vendor),
            dateCode:            clean(dateCode),
            tradingCode:         clean(tradingCode),
            po:                  clean(po),
            inventoryNo:         clean(inventoryNo),
            traceId:             clean(traceId),
            rawBarCode:          clean(rawBarCode),
            lotNo:               mgPreviewLotNo || '(Auto-Gen)',
            uniqueId:            '(Auto-Gen)',   // Preview เท่านั้น — uniqueId จริงจะ fetch สดตอน print จริง (ไม่ fetch ตอน preview กันยิง API ถี่เกิน)
            workOrder:           clean(wo),
            line:                clean(line),
            productionArea:      area.code,
            _productionAreaName: area.name,
            createdAt:           new Date().toISOString(),
        }

        const sliders = {
            qrX: cfg.qrX ?? 30, qrY: cfg.qrY ?? 40, qrSize: cfg.qrSize ?? 5,
            dataX: cfg.dataX ?? 373, dataY: cfg.dataY ?? 58,
            fontSize: cfg.fontSize ?? 22, lineHeight: cfg.lineHeight ?? 33, valOffset: cfg.valOffset ?? 151,
        }
        const textFields = buildLabelTextFields(cfg.labelFields, data)
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        box.innerHTML = '<div class="empty-state" style="padding:0">Rendering…</div>'
        try {
            const src = await renderZplClient(zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
            box.innerHTML = src ? `<img src="${src}">` : '<div class="empty-state" style="padding:0">No preview</div>'
        } catch (_) {
            box.innerHTML = '<div class="empty-state" style="padding:0">Preview failed</div>'
        }
    }

    // ── Submit (photo confirmation + GPS) ─────────────
    // 'printMerge' = Print & Merge (บังคับถ้าไม่มีสิทธิ์ WMS.UI.Merge.SkipPrint), 'mergeOnly' = ไม่พิมพ์
    let mgActionMode = 'printMerge'

    function submitMerge() {
        const rows = [...document.querySelectorAll('#mgTable tr[data-lot-no]')]
        if (rows.length < 2 || _mgMerging) { toast('กรุณาเพิ่มอย่างน้อย 2 Lot', 'err'); return }

        document.getElementById('mgResultBanner').style.display = 'none'

        if (mgCanSkipPrint) {
            document.getElementById('mgActionModal').style.display = 'flex'
        } else {
            mgActionMode = 'printMerge'
            mgContinueSubmit()
        }
    }

    function mgCloseActionModal() {
        document.getElementById('mgActionModal').style.display = 'none'
    }

    function mgChooseAction(mode) {
        mgActionMode = mode
        mgCloseActionModal()
        mgContinueSubmit()
    }

    function mgContinueSubmit() {
        if (mgActionMode === 'printMerge') {
            if (!document.getElementById('mgLayoutSelect')?.value)  { toast('กรุณาเลือก Layout Template ก่อน Print', 'err'); return }
            if (!document.getElementById('mgPrinterSelect')?.value) { toast('กรุณาเลือก Printer ก่อน Print', 'err'); return }
        }
        if (document.getElementById('advSkipImg')?.checked) {
            doMerge()
        } else {
            mgPhoto.open()
        }
    }

    // พิมพ์ label ของ Lot ใหม่หลัง Merge สำเร็จ — ใช้ Layout/Printer ที่เลือกไว้ + ค่าที่ common กันของทุก lot ที่ merge เข้าด้วยกัน
    async function mgPrintMergedLabel(newLotNo, totalQty, rows) {
        const layoutId    = document.getElementById('mgLayoutSelect')?.value
        const printerSel  = document.getElementById('mgPrinterSelect')
        const printerIp   = printerSel?.value
        const printerPort = printerSel?.dataset.port || 9100
        const layout = _mgLayouts.find(l => String(l.id) === String(layoutId))
        if (!layout) throw new Error('ไม่พบ Layout ที่เลือก')
        const cfg = parseZplDataJson(layout)

        const uniqueId = await _fetchUniqueId()

        // Merge เพิ่งสำเร็จ — ดึง lot ใหม่ที่เพิ่งสร้างจาก /inventory/lots มาเอา createdAt จริงจาก server
        // (แม่นกว่าใช้เวลาฝั่ง client เอง เพราะกว่าจะมาถึงจุดนี้ก็ผ่านการยิง /inventory/merge + geolocation ไปแล้ว อาจต่างจากเวลาที่ server บันทึกจริง)
        let mergedLot = null
        try {
            const res = await api('/inventory/lots', 'POST', { lotNo: newLotNo, page: 1, pageSize: 1 })
            mergedLot = res.data?.[0] ?? null
        } catch (_) {}

        const partNo       = _mgCommonOrMixed(rows, 'partNo')
        const wo           = _mgCommonOrMixed(rows, 'wo')
        const unit         = _mgCommonOrMixed(rows, 'unit')
        const itemType     = _mgCommonOrMixed(rows, 'itemType')
        const description  = _mgCommonOrMixed(rows, 'description')
        const vendor       = _mgCommonOrMixed(rows, 'vendor')
        const dateCode     = _mgCommonOrMixed(rows, 'dateCode')
        const tradingCode  = _mgCommonOrMixed(rows, 'tradingCode')
        const po           = _mgCommonOrMixed(rows, 'po')
        const inventoryNo  = _mgCommonOrMixed(rows, 'inventoryNo')
        const traceId      = _mgCommonOrMixed(rows, 'traceId')
        const rawBarCode   = _mgCommonOrMixed(rows, 'rawBarCode')
        const line         = _mgCommonOrMixed(rows, 'line')
        const clean  = v => (v === 'Mixed' || v === '—') ? '' : v
        const area   = await mgResolveProductionArea(clean(wo))

        // createdAt ของ lot ใหม่ที่เพิ่ง merge เสร็จ — เอาจาก /inventory/lots (mergedLot) ที่ fetch มาด้านบนก่อน
        // ถ้า fetch ไม่สำเร็จ/ไม่เจอ (เช่น backend ยัง index ไม่ทัน) fallback เป็นเวลาปัจจุบันฝั่ง client แทน
        const data = {
            partNo:              clean(partNo),
            quantity:            String(totalQty),
            unit:                clean(unit),
            itemType:            clean(itemType) || 1,
            description:         clean(description),
            vendor:              clean(vendor),
            dateCode:            clean(dateCode),
            tradingCode:         clean(tradingCode),
            po:                  clean(po),
            inventoryNo:         clean(inventoryNo),
            traceId:             clean(traceId),
            rawBarCode:          clean(rawBarCode),
            lotNo:               newLotNo,
            uniqueId,
            workOrder:           clean(wo),
            line:                clean(line),
            productionArea:      area.code,
            _productionAreaName: area.name,
            createdAt:           mergedLot?.createdAt ?? new Date().toISOString(),
        }

        const sliders = {
            qrX: cfg.qrX ?? 30, qrY: cfg.qrY ?? 40, qrSize: cfg.qrSize ?? 5,
            dataX: cfg.dataX ?? 373, dataY: cfg.dataY ?? 58,
            fontSize: cfg.fontSize ?? 22, lineHeight: cfg.lineHeight ?? 33, valOffset: cfg.valOffset ?? 151,
        }
        const textFields = buildLabelTextFields(cfg.labelFields, data)
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        const payload = { printerIp, printerPort, lotNo: newLotNo, uniqueId, zpl: applyPrintOffset(zpl, cfg) }
        const res = await api('/printer/send', 'POST', payload, 10000)
        const pd  = res?.problemDetails
        if (pd || (res?.statusCode && res.statusCode >= 400)) {
            throw new Error([pd?.title, pd?.detail].filter(Boolean).join(': ') || res?.message || 'Print failed')
        }
    }

    function _setRowAction(row, html) {
        const lastTd = row.cells[row.cells.length - 1]
        if (lastTd) lastTd.innerHTML = html
    }

    function _setRowError(row, errMsg) {
        row.classList.add('row-err')
        _setRowAction(row, `<button class="del-btn" onclick="mgRemoveRow(this)" title="Remove"><i class="bi bi-trash3"></i></button>`)
        const existing = row.nextElementSibling
        if (existing?.classList.contains('row-err-detail')) existing.remove()
        row.insertAdjacentHTML('afterend', `
            <tr class="row-err-detail">
                <td colspan="6"><span style="font-size:11px;color:var(--red);font-weight:600">${esc(errMsg)}</span></td>
            </tr>`)
    }

    async function doMerge() {
        if (_mgMerging) return
        _mgMerging = true
        mgUpdateState()

        const sendBtn = document.getElementById('mgPcSendBtn')
        sendBtn.disabled = true

        try {
            let latitude = null, longitude = null, heigth = null
            if (!document.getElementById('advSkipGps')?.checked) {
                if (!navigator.geolocation) { toast('Browser ไม่รองรับ GPS', 'err'); return }
                sendBtn.innerHTML = '<i class="bi bi-geo-alt"></i> Getting GPS…'
                try {
                    const pos = await new Promise((res, rej) =>
                        navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
                    )
                    latitude  = pos.coords.latitude
                    longitude = pos.coords.longitude
                    heigth    = pos.coords.altitude
                } catch (e) {
                    toast('GPS error: ' + e.message, 'err'); return
                }
            }
            sendBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลัง Merge…'

            const rows = [...document.querySelectorAll('#mgTable tr[data-lot-no]')]
            if (rows.length < 2) { toast('กรุณาเพิ่มอย่างน้อย 2 Lot', 'err'); return }

            // ใช้เลข Lot เดียวกับที่ preview ให้ user เห็นไว้แล้ว ไม่ fetch ใหม่ (กันเลขไม่ตรงกับที่โชว์)
            // เผื่อกรณี preview ยัง fetch ไม่เสร็จ/fail ไว้ก่อนหน้า ค่อย fetch สำรองตรงนี้
            let newLotNo = mgPreviewLotNo
            if (!newLotNo) {
                const trRes = await api('/inventory/new-lotNo', 'GET')
                newLotNo = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? null
            }
            const lotNos   = rows.map(r => r.dataset.lotNo)
            const options  = getAdvancedOptions()
            // backend สะกด "longitude" ผิดเป็น "longtitude" (ยืนยันจาก Swagger request จริงของ /inventory/split ที่ทดสอบสำเร็จ) ต้องส่งตามนี้เป๊ะๆ
            const payload  = { lotNos, newLotNo, latitude, longtitude: longitude, heigth, options }

            console.log('[Merge] payload →', payload)
            // toastPayload('[Merge] payload', payload)

            rows.forEach(row => {
                const errDetail = row.nextElementSibling
                if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
                row.classList.remove('row-err', 'row-ok')
                row.classList.add('row-processing')
            })

            try {
                const res = await apiForm('/inventory/merge', payload, mgPhoto.getBlobs(), 10000, 'POST', 'files')
                console.log('[Merge] response →', res)

                // สำเร็จ (call ไม่ throw) → ถือว่า merge ทั้งก้อนสำเร็จ เคลียร์ list ทิ้งทั้งหมด
                rows.forEach(row => mgScannedLots.delete(row.dataset.lotNo))
                document.getElementById('mgTable').innerHTML = ''
                mgCheckEmpty()
                document.getElementById('mgResultLotNo').textContent = newLotNo || '—'
                document.getElementById('mgResultBanner').style.display = 'flex'
                toast(`Merge สำเร็จ ${rows.length} Lot ✓`, 'ok')

                // Merge สำเร็จแล้ว — ถ้าเลือกโหมด Print & Merge ให้พิมพ์ label ของ Lot ใหม่ต่อ
                if (mgActionMode === 'printMerge') {
                    const totalQty = rows.reduce((sum, r) => sum + (parseFloat(r.dataset.qty) || 0), 0)
                    try {
                        await mgPrintMergedLabel(newLotNo, totalQty, rows)
                        toast('🖨️ พิมพ์ label สำเร็จ', 'ok')
                    } catch (printErr) {
                        toast(`⚠️ Merge สำเร็จ แต่ Print ล้มเหลว: ${printErr.message || 'Print failed'}`, 'warn')
                    }
                }
            } catch (err) {
                // Merge เป็น call เดียวรวมทั้งก้อน — fail ทีเดียวกระทบทุก lot ใน list เลย ใส่ inline error ให้ทุกแถว
                const msg    = err.message || 'Merge failed'
                const tagged = err.status ? `HTTP ${err.status}: ${msg}` : msg
                rows.forEach(row => {
                    row.classList.remove('row-processing')
                    _setRowError(row, `Merge lot failed: ${tagged}`)
                })
                toast('❌ ' + tagged, 'err', { duration: 7000 })
            }
        } finally {
            _mgMerging = false
            mgUpdateState()
            sendBtn.innerHTML = 'Send'
            sendBtn.disabled = false
            mgPhoto.close()
        }
    }

    const mgPhoto = createPhotoCapture({ prefix: "mg", maxDimension: 1920 })
    document.getElementById('mgPcSendBtn').addEventListener('click', doMerge)
    document.getElementById('mgPcCancelBtn').addEventListener('click', () => mgPhoto.close())

    window.addEventListener('beforeunload', (e) => {
        if (mgScanner.running) stopScan()
        if (document.querySelectorAll('#mgTable tr[data-lot-no]').length > 0) {
            e.preventDefault()
            e.returnValue = ''
        }
    })

    // ── Fallback keyboard HW scanner (ใช้เมื่อ focus อยู่นอก input ใดๆ) ──
    ;(function() {
        let _buf = '', _timer = null
        const THRESHOLD = 150, MIN = 4
        function commit() {
            const c = _buf; _buf = ''
            if (c.length >= MIN) mgScan.submit(c)
        }
        document.addEventListener('keydown', e => {
            if (mgScanner.running) return
            const active = document.activeElement
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) return
            if (e.key === 'Enter') { clearTimeout(_timer); commit(); return }
            if (e.key.length === 1) { _buf += e.key; clearTimeout(_timer); _timer = setTimeout(commit, THRESHOLD) }
        })
    })()

    // ── Role: Advanced Options + Print permission gating ──────
    // WMS.UI.Merge.SkipPrint = สิทธิ์ให้เลือก "Merge Only" ได้ (ไม่มีสิทธิ์นี้ → บังคับ Print & Merge เสมอ)
    let mgCanSkipPrint = false
    let mgIsAdmin = false
    ;(function() {
        const adminRoles = ['Admin']
        try {
            const user       = JSON.parse(localStorage.getItem('user') || '{}')
            const userRoles  = Array.isArray(user.roles) ? user.roles : []
            const userPermis = Array.isArray(user.permissions) ? user.permissions : []
            mgIsAdmin      = userRoles.some(r => adminRoles.includes(r))
            mgCanSkipPrint = mgIsAdmin || userPermis.includes('WMS.UI.Merge.SkipPrint')
            applyAdvancedOptionsPermissions(userPermis, mgIsAdmin)

            // ปุ่มสลับ Scan Mode (Our/Vendor) — ต้องมี permission นี้ถึงจะเห็น ไม่งั้นซ่อนแล้วใช้ Our เป็น default เสมอ
            const canReadBarcodeVendor = mgIsAdmin || userPermis.includes('WMS.UI.ReadBarcodeVendor')
            document.getElementById('mgBcModeGroup').style.display = canReadBarcodeVendor ? '' : 'none'
        } catch (_) {}
    })()

    let _mgLayouts = []

    const mgPrinterPicker = createPrinterPicker({
        triggerId: 'mgPrinterTrigger', menuId: 'mgPrinterMenu', hiddenId: 'mgPrinterSelect',
        dotId: 'mgPrinterDot', nameId: 'mgPrinterName', ipId: 'mgPrinterIp',
        isAdmin: mgIsAdmin,
    })

    async function init() {
        await loadLocation()
        _mgLayouts = await loadLayoutOptions(document.getElementById('mgLayoutSelect'), mgIsAdmin)
        await mgPrinterPicker.load()
    }
    init()
</script>
}
