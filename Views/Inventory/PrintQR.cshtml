    function rpSwitchViewTab(tab) {
        const dataPane    = document.getElementById('rpViewPaneData')
        const previewPane = document.getElementById('rpViewPanePreview')
        const dataBtn     = document.getElementById('rpViewTabData')
        const previewBtn  = document.getElementById('rpViewTabPreview')
        if (!dataPane) return
        if (tab === 'data') {
            dataPane.style.display    = ''
            previewPane.style.display = 'none'
            dataBtn.style.color       = 'var(--blue)';  dataBtn.style.borderBottom    = '2px solid var(--blue)'
            previewBtn.style.color    = 'var(--t2)';    previewBtn.style.borderBottom = '2px solid transparent'
        } else {
            dataPane.style.display    = 'none'
            previewPane.style.display = 'flex'
            dataBtn.style.color       = 'var(--t2)';    dataBtn.style.borderBottom    = '2px solid transparent'
            previewBtn.style.color    = 'var(--blue)';  previewBtn.style.borderBottom = '2px solid var(--blue)'
            const item    = rpItems[_rpViewIdx]
            const content = document.getElementById('rpViewPreviewContent')
            if (!item || !content) return
            content.innerHTML = '<div style="color:var(--t3);font-size:13px">⏳ Loading…</div>';
            (async () => {
                try {
                    let src = item.previewSrc
                    if (!src) {
                        const cfg = rpLayoutConfig ?? {}
                        src = await renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
                        if (item) item.previewSrc = src
                    }
                    content.innerHTML = src
                        ? `<img src="${escHtml(src)}" style="max-width:100%;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.12)">`
                        : '<div style="color:var(--amber);font-size:13px">Preview not available</div>'
                } catch (err) {
                    content.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
                }
            })()
        }
    }

    function rpSaveAndClose() {
        const qWrap = document.getElementById('rpQtyEditWrap')
        if (qWrap && qWrap.style.display !== 'none') rpSaveQtyEdit()
        const lWrap = document.getElementById('rpLineEditWrap')
        if (lWrap && lWrap.style.display !== 'none') rpSaveLineEdit()

        // Flush any open field edits, then regen ZPL
        for (const k of EDITABLE_KEYS) {
            const wrap = document.getElementById(`rpFldWrap_${k}`)
            if (wrap && wrap.style.display !== 'none') rpSaveFldEdit(k)
        }
        const item = rpItems[_rpViewIdx]
        if (item) {
            const cfg        = rpLayoutConfig ?? {}
            const sliders    = { qrX: cfg.qrX ?? 30, qrY: cfg.qrY ?? 40, qrSize: cfg.qrSize ?? 5, dataX: cfg.dataX ?? 373, dataY: cfg.dataY ?? 58, fontSize: cfg.fontSize ?? 22, lineHeight: cfg.lineHeight ?? 33, valOffset: cfg.valOffset ?? 151 }
            const labelFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : null
            const textFields  = labelFields
                ? labelFields.filter(f => f.show).map(f => ({ label: f.label ?? FIELD_LABELS[f.key] ?? f.key, value: f.key === 'createdAt' ? fmtCreatedAt(item.data[f.key]) : (item.data[f.key] ?? '') }))
                : Object.keys(FIELD_LABELS).filter(k => item.data[k]).map(k => ({ label: FIELD_LABELS[k], value: k === 'createdAt' ? fmtCreatedAt(item.data[k]) : item.data[k] }))
            item.zpl        = buildZpl({ qrContent: buildQrContent(item.data, cfg.qrFields ?? null), textFields, ...sliders })
            item.previewSrc = null
            rpRenderList()
        }

        document.getElementById('rpManualModal').style.display = 'none'
        showToast('✅ Saved', 'success')
    }

    function rpStartQtyEdit() {
        document.getElementById('rpQtyDisplay').style.display = 'none'
        document.getElementById('rpQtyEditBtn').style.display = 'none'
        const wrap = document.getElementById('rpQtyEditWrap')
        wrap.style.display = 'flex'
        const inp = document.getElementById('rpQtyEditInput')
        inp.focus(); inp.select()
    }

    function rpSaveQtyEdit() {
        const wrap = document.getElementById('rpQtyEditWrap')
        if (!wrap || wrap.style.display === 'none') return
        const inp    = document.getElementById('rpQtyEditInput')
        const newVal = inp.value.trim()
        if (!newVal) { rpCancelQtyEdit(); return }

        const item = rpItems[_rpViewIdx]
        if (item) {
            item.data.quantity = newVal
            item.previewSrc    = null
            // rebuild ZPL for this item
            const cfg     = rpLayoutConfig ?? {}
            const sliders = { qrX: cfg.qrX??30, qrY: cfg.qrY??40, qrSize: cfg.qrSize??5, dataX: cfg.dataX??373, dataY: cfg.dataY??58, fontSize: cfg.fontSize??22, lineHeight: cfg.lineHeight??33, valOffset: cfg.valOffset??151 }
            const lblFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : null
            const d = item.data
            const textFields = lblFields
                ? lblFields.filter(f => f.show).map(f => ({ label: f.label ?? FIELD_LABELS[f.key] ?? f.key, value: f.key === 'createdAt' ? fmtCreatedAt(d[f.key]) : (d[f.key] ?? '') }))
                : Object.keys(FIELD_LABELS).filter(k => d[k]).map(k => ({ label: FIELD_LABELS[k], value: k === 'createdAt' ? fmtCreatedAt(d[k]) : d[k] }))
            item.zpl = buildZpl({ qrContent: buildQrContent(d, cfg.qrFields ?? null), textFields, ...sliders })
        }

        document.getElementById('rpQtyDisplay').textContent = newVal
        document.getElementById('rpQtyDisplay').style.display = ''
        document.getElementById('rpQtyEditBtn').style.display = ''
        wrap.style.display = 'none'
    }

    function rpCancelQtyEdit() {
        document.getElementById('rpQtyDisplay').style.display = ''
        document.getElementById('rpQtyEditBtn').style.display = ''
        document.getElementById('rpQtyEditWrap').style.display = 'none'
    }

