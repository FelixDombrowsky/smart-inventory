@{
    ViewData["Title"] = "Lot Detail";
}

<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --card:#fff;
    --green:#059669; --green-lt:#ecfdf5;
    --amber:#d97706; --amber-lt:#fffbeb;
    --red:#dc2626; --red-lt:#fef2f2;
    --purple:#7c3aed; --purple-lt:#f5f3ff;
    --cyan:#0891b2; --cyan-lt:#ecfeff;
}

/* ── PAGE HEADER ── */
.lot-header {
    background: linear-gradient(135deg, var(--navy) 0%, #1e3a6e 60%, #1a6fff 100%);
    border-radius:16px; padding:22px 28px; margin-bottom:22px;
    display:flex; align-items:center; justify-content:space-between;
    position:relative; overflow:hidden;
}
.lot-header::before {
    content:''; position:absolute; right:-40px; top:-40px;
    width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04);
}
.lot-header-left h2 { font-size:18px; font-weight:700; color:#fff; margin-bottom:0px; }
.lot-header-left p  { font-size:14px; color:rgba(255,255,255,.75); margin:0; }
.back-btn {
    padding:8px 18px; border-radius:10px; border:1.5px solid rgba(255,255,255,.3);
    background:rgba(255,255,255,.08); color:#fff; font-size:13px; font-weight:600;
    cursor:pointer; transition:.15s; text-decoration:none;
    display:flex; align-items:center; gap:6px; position:relative; z-index:1;
}
.back-btn:hover { background:rgba(255,255,255,.18); color:#fff; }

/* ── STAT CARDS ── */
.stat-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:22px; }
.stat-card {
    background:var(--card); border:1px solid var(--border); border-radius:14px; padding:18px 20px;
    display:flex; align-items:center; gap:14px; box-shadow:0 1px 4px rgba(0,0,0,.04);
}
.stat-icon { width:42px; height:42px; border-radius:11px; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; flex-shrink:0; }
.stat-num { font-size:20px; font-weight:700; color:var(--navy); line-height:1; }
.stat-lbl { font-size:11px; color:var(--t2); margin-top:3px; }

/* ── MAIN LAYOUT ── */
.main-layout { display:grid; grid-template-columns:minmax(300px, 26%) 1fr; gap:20px; align-items:start; }

/* ── LOT INFO CARD ── */
.info-card {
    background:var(--card); border:1px solid var(--border); border-radius:14px;
    overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,.04);
}
.info-img { width:100%; aspect-ratio:1; object-fit:cover; background:#f8f9fc; display:block; }
.info-body { padding:18px; }
.info-row { display:flex; justify-content:space-between; align-items:flex-start; padding:8px 0; border-bottom:1px solid #f4f4f7; }
.info-row:last-child { border-bottom:none; }
.info-label { font-size:12px; color:var(--t2); font-weight:600; }
.info-val   { font-size:13px; color:var(--navy); font-weight:600; text-align:right; max-width:180px; word-break:break-all; }
.status-badge { padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700; }

/* ── TIMELINE ── */
.timeline-card {
    background:var(--card); border:1px solid var(--border); border-radius:14px;
    overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,.04);
}
.timeline-head {
    padding:14px 20px; border-bottom:1px solid var(--border);
    display:flex; align-items:center; justify-content:space-between;
}
.timeline-title { font-size:13px; font-weight:700; color:var(--navy); display:flex; align-items:center; gap:8px; }
.timeline-body  { padding:24px 24px 24px 20px; }

.timeline { position:relative; }
.tl-item  { display:flex; gap:16px; position:relative; padding-bottom:28px; }
.tl-item:last-child { padding-bottom:0; }

/* vertical line */
.tl-item:not(:last-child)::after {
    content:''; position:absolute; left:19px; top:40px;
    width:2px; bottom:0;
    background:linear-gradient(to bottom, #e5e7eb 0%, #e5e7eb 100%);
}
.tl-item.active:not(:last-child)::after { background:linear-gradient(to bottom, var(--blue) 0%, #e5e7eb 80%); }

/* dot */
.tl-dot {
    width:40px; height:40px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-size:16px; border:3px solid #fff; box-shadow:0 0 0 2px #e5e7eb;
    position:relative; z-index:1; background:#f8f9fc;
    transition:transform .2s;
}
.tl-item.active .tl-dot {
    box-shadow:0 0 0 3px var(--blue); background:var(--blue-lt);
    transform:scale(1.1);
}
.tl-item.current .tl-dot {
    box-shadow:0 0 0 3px var(--green); background:var(--green-lt);
    animation: pulse-dot 2s infinite;
}
@@keyframes pulse-dot {
    0%,100% { box-shadow:0 0 0 3px var(--green); }
    50%      { box-shadow:0 0 0 6px rgba(5,150,105,.2); }
}

/* content */
.tl-content { flex:1; padding-top:4px; }
.tl-type {
    display:flex; align-items:center; gap:8px; margin-bottom:6px; flex-wrap:wrap;
}
.tl-badge {
    padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700;
}
.tl-receive  { background:var(--green-lt);  color:var(--green); }
.tl-reserve  { background:var(--amber-lt);  color:var(--amber); }
.tl-transfer { background:var(--blue-lt);   color:var(--blue); }
.tl-consume  { background:var(--red-lt);    color:var(--red); }
.tl-adjust   { background:var(--purple-lt); color:var(--purple); }
.tl-move     { background:var(--cyan-lt);   color:var(--cyan); }
.tl-void     { background:var(--red-lt);    color:var(--red); }
.tl-default  { background:#f0f2f5; color:#475569; }

.tl-time { font-size:11px; color:var(--t3); font-weight:500; }
.tl-current-label {
    font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;
    background:var(--green-lt); color:var(--green);
}

.tl-detail {
    background:#f8f9fc; border-radius:10px; padding:12px 14px; margin-top:6px;
    display:flex; align-items:center; justify-content:space-between; gap:12px;
}
.tl-detail-rows { flex:1; min-width:0; }
.tl-detail-row {
    display:flex; align-items:center; gap:8px; font-size:12px;
    color:var(--t2); margin-bottom:4px;
}
.tl-detail-row:last-child { margin-bottom:0; }
.tl-detail-row strong { color:var(--navy); }
.tl-arrow { color:var(--t3); font-size:10px; }
.loc-type-badge {
    display:inline-flex; align-items:center; gap:4px;
    padding:2px 9px 2px 7px; border-radius:20px; font-size:11px; font-weight:700;
    white-space:nowrap; line-height:1.6;
}
.tl-qty-up   { color:var(--green); font-weight:700; font-size:13px; }
.tl-qty-down { color:var(--red);   font-weight:700; font-size:13px; }
.tl-qty-neu  { color:var(--navy);  font-weight:700; font-size:13px; }

.tl-empty { text-align:center; padding:48px; color:var(--t3); }

/* ── PROOF PHOTO / LIGHTBOX (เหมือนหน้า Transaction) ── */
.proof-thumb {
    width:40px; height:40px; object-fit:cover; border-radius:6px;
    border:1.5px solid var(--border); cursor:zoom-in;
    transition:transform .15s, box-shadow .15s; flex-shrink:0;
}
.proof-thumb:hover { transform:scale(1.1); box-shadow:0 4px 12px rgba(0,0,0,.15); }
.no-photo { color:var(--t3); font-size:18px; }

.thumb-wrap { position:relative; display:inline-block; line-height:0; flex-shrink:0; }
.thumb-badge {
    position:absolute; top:-6px; right:-6px;
    background:var(--blue); color:#fff; font-size:10px; font-weight:800; line-height:1.4;
    border-radius:9px; padding:1px 5px; min-width:16px; text-align:center;
    box-shadow:0 1px 4px rgba(0,0,0,.3); border:1.5px solid #fff; pointer-events:none;
}

.lightbox {
    position:fixed; inset:0; background:rgba(10,10,20,.85); backdrop-filter:blur(6px);
    z-index:3000; display:flex; align-items:center; justify-content:center;
    opacity:0; pointer-events:none; transition:opacity .2s;
}
.lightbox.show { opacity:1; pointer-events:all; }
.lightbox-inner {
    position:relative; max-width:90vw; max-height:90vh;
    transform:scale(.92); transition:transform .2s;
}
.lightbox.show .lightbox-inner { transform:scale(1); }
.lightbox-img {
    max-width:90vw; max-height:85vh; border-radius:12px;
    box-shadow:0 24px 60px rgba(0,0,0,.5); display:block;
}
.lightbox-close {
    position:absolute; top:-14px; right:-14px;
    width:32px; height:32px; border-radius:50%; border:none;
    background:#fff; color:var(--navy); font-size:16px; font-weight:700;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    box-shadow:0 2px 8px rgba(0,0,0,.2); line-height:1;
}
.lightbox-caption {
    text-align:center; color:rgba(255,255,255,.7); font-size:12px; margin-top:10px;
}
.lightbox-nav {
    position:fixed; top:50%; transform:translateY(-50%);
    width:44px; height:44px; border:none; border-radius:50%;
    background:rgba(255,255,255,.12); color:#fff; font-size:22px;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    padding:0; z-index:3001; transition:.15s;
}
.lightbox-nav:hover { background:rgba(255,255,255,.25); }
.lightbox-prev { left:24px; }
.lightbox-next { right:24px; }

.count-badge { font-size:11px; background:var(--blue-lt); color:var(--blue); padding:2px 8px; border-radius:20px; font-weight:700; }

/* ── DARK MODE ── */
[data-theme="dark"] {
    --navy:     #f1f5f9;
    --text:     #cbd5e1;
    --t2:       #94a3b8;
    --t3:       #64748b;
    --border:   #334155;
    --card:     #1e293b;
    --blue-lt:  #1e3553;
    --green-lt: #052e1c;
    --amber-lt: #2d1a00;
    --red-lt:   #2d0a0a;
    --purple-lt:#2a1e4e;
    --cyan-lt:  #0e3040;
}
[data-theme="dark"] body                          { background: #0f172a !important; }
[data-theme="dark"] .lot-header h2                { color: #0f172a; }
[data-theme="dark"] .lot-header p                 { color: #334155; }
[data-theme="dark"] .info-img                     { background: #162032; }
[data-theme="dark"] .info-row                     { border-bottom-color: #253347; }
[data-theme="dark"] .tl-dot                       { background: #162032; border-color: #1e293b; box-shadow: 0 0 0 2px #334155; }
[data-theme="dark"] .tl-item:not(:last-child)::after { background: linear-gradient(to bottom, #334155 0%, #334155 100%); }
[data-theme="dark"] .tl-item.active:not(:last-child)::after { background: linear-gradient(to bottom, var(--blue) 0%, #334155 80%); }
[data-theme="dark"] .tl-detail                    { background: #162032; }
[data-theme="dark"] .tl-default                   { background: #253347; color: #94a3b8; }
[data-theme="dark"] select option                 { background: #1e293b; color: var(--text); }
</style>

<!-- PAGE HEADER -->
<div class="lot-header">
    <div class="lot-header-left">
        <h2 id="lotTitle">Loading…</h2>
        @* <p id="lotSubtitle">—</p> *@
    </div>
    <a href="/Inventory/Lots" class="back-btn">← Back to Lots</a>
</div>

<!-- STAT CARDS -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--blue-lt);color:var(--blue)">OH</div>
        <div><div class="stat-num" id="sOnHand">—</div><div class="stat-lbl">On Hand</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--amber-lt);color:var(--amber)">RS</div>
        <div><div class="stat-num" id="sReserved">—</div><div class="stat-lbl">Reserved</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--green-lt);color:var(--green)">AV</div>
        <div><div class="stat-num" id="sAvailable">—</div><div class="stat-lbl">Available</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--red-lt);color:var(--red)">CS</div>
        <div><div class="stat-num" id="sConsumed">—</div><div class="stat-lbl">Consumed</div></div>
    </div>
</div>

<!-- MAIN LAYOUT -->
<div class="main-layout">

    <!-- LEFT: LOT INFO -->
    <div class="info-card">
        <img id="lotImg" class="info-img" src="" alt="">
        <div class="info-body">
            <div class="info-row">
                <span class="info-label">Lot No.</span>
                <span class="info-val" id="infoLotNo" style="font-family:ui-monospace,monospace;color:var(--blue)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Part No.</span>
                <span class="info-val" id="infoPartNo">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Description</span>
                <span class="info-val" id="infoDesc">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Work Order</span>
                <span class="info-val" id="infoWO">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Location</span>
                <span class="info-val" id="infoLoc">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Location Type</span>
                <span class="info-val" id="infoLocType">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Unit</span>
                <span class="info-val" id="infoUnit">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Status</span>
                <span class="info-val" id="infoStatus">—</span>
            </div>
        </div>
    </div>

    <!-- RIGHT: TIMELINE -->
    <div class="timeline-card">
        <div class="timeline-head">
            <div class="timeline-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                Lot History
                <span id="txCountBadge" class="count-badge"></span>
            </div>
        </div>
        <div class="timeline-body">
            <div class="timeline" id="timeline">
                <div class="tl-empty">Loading…</div>
            </div>
        </div>
    </div>

</div>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox">
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" onclick="lightboxStep(-1)"><i class="bi bi-chevron-left"></i></button>
    <div class="lightbox-inner">
        <button class="lightbox-close" onclick="closeLightbox()">✕</button>
        <img class="lightbox-img" id="lightboxImg" src="">
        <div class="lightbox-caption" id="lightboxCaption"></div>
    </div>
    <button class="lightbox-nav lightbox-next" id="lightboxNext" onclick="lightboxStep(1)"><i class="bi bi-chevron-right"></i></button>
</div>

@section Scripts {
<script src="/js/api.js"></script>
<script src="/js/locationTypeMeta.js"></script>
<script>
    const LOT = new URL(location.href).searchParams.get('lot') || ''

    function fmt(n) { return (n ?? 0).toLocaleString() }

    // badge ชื่อ Location พร้อม icon+สีตาม type (locationTypeMeta.js) — เหมือนหน้า Transaction
    function locTypeBadge(code, locMap) {
        if (!code) return ''
        const found = locMap.get(code)
        const name  = found?.displayName ?? code
        const type  = found?.typeName ?? found?.type ?? ''
        return `<span class="loc-type-badge" style="${locTypeBadgeStyle(type)}">${locHierTypeIcon(type)}${name}</span>`
    }

    // ── Lightbox (เหมือนหน้า Transaction) ──
    let lbImages = [], lbIndex = 0, lbCaption = ''
    let txImagesMap = {}   // transactionId → { images:[...], caption }

    function openLightbox(images, index, caption) {
        lbImages  = images
        lbIndex   = ((index || 0) % images.length + images.length) % images.length
        lbCaption = caption || ''
        renderLightbox()
        document.getElementById('lightbox').classList.add('show')
    }
    function openLightboxFor(txId, index) {
        const entry = txImagesMap[txId]
        if (!entry || !entry.images.length) return
        openLightbox(entry.images, index, entry.caption)
    }
    function renderLightbox() {
        const multi = lbImages.length > 1
        document.getElementById('lightboxImg').src = lbImages[lbIndex]
        document.getElementById('lightboxCaption').textContent =
            lbCaption + (multi ? ` · ${lbIndex + 1}/${lbImages.length}` : '')
        document.getElementById('lightboxPrev').style.display = multi ? 'flex' : 'none'
        document.getElementById('lightboxNext').style.display = multi ? 'flex' : 'none'
    }
    function lightboxStep(delta) {
        if (lbImages.length < 2) return
        lbIndex = (lbIndex + delta + lbImages.length) % lbImages.length
        renderLightbox()
    }
    function closeLightbox() {
        document.getElementById('lightbox').classList.remove('show')
        document.getElementById('lightboxImg').src = ''
        lbImages = []
    }
    document.addEventListener('keydown', e => {
        if (!document.getElementById('lightbox').classList.contains('show')) return
        if (e.key === 'Escape')     closeLightbox()
        if (e.key === 'ArrowLeft')  lightboxStep(-1)
        if (e.key === 'ArrowRight') lightboxStep(1)
    })

    // โหลดรายชื่อ Location ทั้งหมดมา cache ครั้งเดียว (ไว้ join locationCode → location object ทั้งตัว เอา displayName/typeName มาใช้)
    let _locNameMapPromise = null
    function _ensureLocNameMap() {
        if (_locNameMapPromise) return _locNameMapPromise
        _locNameMapPromise = (async () => {
            const map = new Map()
            try {
                const res = await api('/location?pageSize=500', 'GET')
                const arr = Array.isArray(res) ? res : (res?.data || [])
                arr.forEach(loc => map.set(loc.locationCode, loc))
            } catch (_) {}
            return map
        })()
        return _locNameMapPromise
    }

    function fmtDate(d) {
        if (!d) return '—'
        const dt = new Date(d)
        const date = dt.toLocaleDateString('th-TH', { day:'2-digit', month:'short', year:'numeric' })
        const time = dt.toLocaleTimeString('th-TH', { hour:'2-digit', minute:'2-digit' })
        return { date, time, full: date + ' · ' + time }
    }

    function txIcon(t) {
        const map = { receive:'📥', reserve:'🔒', transfer:'🚚', consume:'⚡', adjust:'⚖️', move:'📦', void:'🗑️' }
        return map[t?.toLowerCase()] || '🔄'
    }

    function txCls(t) {
        if (!t) return 'tl-default'
        const map = { receive:'tl-receive', reserve:'tl-reserve', transfer:'tl-transfer', consume:'tl-consume', adjust:'tl-adjust', move:'tl-move', void:'tl-void' }
        return map[t.toLowerCase()] || 'tl-default'
    }

    function qtyDisplay(qty, type) {
        if (!type) return `<span class="tl-qty-neu">${qty}</span>`
        const t = type.toLowerCase()
        if (['receive','move'].includes(t))   return `<span class="tl-qty-up">+${qty}</span>`
        if (['consume','void'].includes(t))   return `<span class="tl-qty-down">-${qty}</span>`
        return `<span class="tl-qty-neu">${qty}</span>`
    }

    // ── Load Lot Info ──
    async function loadLotInfo() {
        try {
            const [data, locMap] = await Promise.all([
                api('/inventory/lots', 'POST', { lotNo: LOT, page: 1, pageSize: 1 }),
                _ensureLocNameMap()
            ])
            const lot  = data?.data?.[0]
            if (!lot) return
            const locName = lot.location ? (locMap.get(lot.location)?.displayName || lot.location) : ''

            document.getElementById('lotTitle').textContent    = LOT
            @* document.getElementById('lotSubtitle').textContent = `${lot.partNo ?? ''} · ${lot.description ?? ''} · ${locName}` *@

            document.getElementById('sOnHand').textContent    = fmt(lot.onHandQty)
            document.getElementById('sReserved').textContent  = fmt(lot.reservedQty)
            document.getElementById('sAvailable').textContent = fmt(lot.available)
            document.getElementById('sConsumed').textContent  = fmt(lot.consumedQty)

            document.getElementById('infoLotNo').textContent  = lot.lotNo   ?? '—'
            document.getElementById('infoPartNo').textContent = lot.partNo  ?? '—'
            document.getElementById('infoDesc').textContent   = lot.description ?? '—'
            document.getElementById('infoWO').textContent     = lot.workOrder   ?? '—'
            document.getElementById('infoLoc').textContent    = locName || '—'
            document.getElementById('infoUnit').textContent   = lot.unit ?? lot.baseUnit ?? '—'

            const locType = lot.locationType || '—'
            const ltBg = locType === 'Warehouse' ? 'var(--blue-lt)' : 'var(--green-lt)'
            const ltCl = locType === 'Warehouse' ? 'var(--blue)'    : 'var(--green)'
            document.getElementById('infoLocType').innerHTML =
                `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;background:${ltBg};color:${ltCl}">${locType}</span>`

            const isVoid = lot.isVoided === true || lot.status?.toLowerCase() === 'void'
            document.getElementById('infoStatus').innerHTML = isVoid
                ? `<span class="status-badge" style="background:#f0f2f5;color:#9ca3af">Voided</span>`
                : `<span class="status-badge" style="background:var(--green-lt);color:var(--green)">Active</span>`

            const imgPath = lot.imagePath
            const img = document.getElementById('lotImg')
            if (imgPath) {
                img.src = CONFIG.INVENTORY_API + imgPath
                img.onerror = () => { img.style.display = 'none' }
            } else {
                img.style.display = 'none'
            }
        } catch (err) { console.error('loadLotInfo:', err) }
    }

    // ── Load Transactions (timeline) ──
    async function loadTimeline() {
        try {
            const body   = { lotNo: LOT, page: 1, pageSize: 50, sortBy: 'createdAt', desc: false }
            const [first, locMap] = await Promise.all([
                api('/transaction/get', 'POST', body),
                _ensureLocNameMap()
            ])
            let rows     = first.data || []
            const total  = first.totalPages || 1

            if (total > 1) {
                const rest = await Promise.all(
                    Array.from({ length: total - 1 }, (_, i) =>
                        api('/transaction/get', 'POST', { ...body, page: i + 2 })
                    )
                )
                rest.forEach(r => { rows = rows.concat(r.data || []) })
            }

            document.getElementById('txCountBadge').textContent = rows.length + ' events'

            if (rows.length === 0) {
                document.getElementById('timeline').innerHTML =
                    `<div class="tl-empty">ไม่พบ Transaction สำหรับ Lot นี้</div>`
                return
            }

            // Sort oldest → newest, then reverse for display (newest at top)
            rows.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))

            txImagesMap = {}
            const html = rows.map((x, idx) => {
                const dt   = fmtDate(x.createdAt)
                const isCurrent = idx === 0
                const isActive  = idx <= 1

                const fromBadge = locTypeBadge(x.fromLocation, locMap)
                const toBadge   = locTypeBadge(x.toLocation, locMap)
                const locationLine = (fromBadge || toBadge)
                    ? `<div class="tl-detail-row">
                        ${fromBadge}
                        ${fromBadge && toBadge ? `<i class="bi bi-arrow-right tl-arrow"></i>` : ''}
                        ${toBadge}
                       </div>`
                    : ''

                // ── Confirm Image (thumbnail แรก + badge จำนวนรูปที่เหลือ, กดเพื่อเปิด lightbox carousel) ──
                const confirmImages = (x.images || []).map(im => CONFIG.INVENTORY_API + im.imageUrl)
                txImagesMap[x.id] = {
                    images: confirmImages,
                    caption: `${x.transactionType ?? ''} · ${x.performedBy ?? ''} · ${dt.full}`
                }
                const imgCell = confirmImages.length
                    ? `<div class="thumb-wrap">
                           <img src="${confirmImages[0]}" class="proof-thumb" onclick="openLightboxFor(${x.id}, 0)"
                                onerror="this.closest('.thumb-wrap').innerHTML='<span class=no-photo>—</span>'">
                           ${confirmImages.length > 1 ? `<span class="thumb-badge">+${confirmImages.length - 1}</span>` : ''}
                       </div>`
                    : `<span class="no-photo">—</span>`

                return `
                <div class="tl-item ${isCurrent ? 'current' : isActive ? 'active' : ''}">
                    <div class="tl-dot">${txIcon(x.transactionType)}</div>
                    <div class="tl-content">
                        <div class="tl-type">
                            <span class="tl-badge ${txCls(x.transactionType)}">${x.transactionType ?? '—'}</span>
                            ${isCurrent ? '<span class="tl-current-label">● Current</span>' : ''}
                            <span class="tl-time">${dt.date}</span>
                            <span class="tl-time">${dt.time}</span>
                        </div>
                        <div class="tl-detail">
                            <div class="tl-detail-rows">
                                <div class="tl-detail-row">
                                    @* <i class="bi bi-123" style="font-size:13px"></i> *@
                                    <span>QTY :</span>
                                    ${qtyDisplay(fmt(x.quantity), x.transactionType)}
                                </div>
                                ${locationLine}
                                <div class="tl-detail-row">
                                    <i class="bi bi-person-fill" style="font-size:12px"></i>
                                    @* <span>BY :</span> *@
                                    <strong>${x.performedBy ?? '—'}</strong>
                                </div>
                            </div>
                            ${imgCell}
                        </div>
                    </div>
                </div>`
            }).join('')

            document.getElementById('timeline').innerHTML = html
        } catch (err) {
            console.error('loadTimeline:', err)
            document.getElementById('timeline').innerHTML =
                `<div class="tl-empty" style="color:var(--red)">โหลดข้อมูลไม่สำเร็จ: ${err.message}</div>`
        }
    }

    loadLotInfo()
    loadTimeline()
</script>
}
