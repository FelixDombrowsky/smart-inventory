</div>

<!-- ── ITEM MODAL ── -->
<div class="modal-overlay" id="itemModal">
    <div class="modal-box" style="max-width:520px">
        <div class="modal-title" id="itemModalTitle">New Item</div>
        <input type="hidden" id="itemId">
