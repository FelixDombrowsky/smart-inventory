                    </button>
                </div>
            </div>

            <div class="collapse d-xl-none mt-3" id="mobileMenu">
                <div class="list-group list-group-flush border-top pt-2">
                    <a href="/Inventory/Dashboard" class="list-group-item list-group-item-action border-0">Dashboard</a>
                    <a href="/Inventory/Lots" class="list-group-item list-group-item-action border-0">Lots</a>
                    <a href="/Inventory/MasterManagement" class="list-group-item list-group-item-action border-0">Master
                        Management</a>
                    </div>
                </div>
            </div>
        </header>



        <div class="container-fluid px-3">

            <main role="main" class="pb-3">

                @RenderBody()

            </main>

        </div>



        <footer class="border-top footer text-muted">

            <div class="container-fluid px-3">

                &copy; 2026 SmartFactory

            </div>

        </footer>



        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/js/config.js"></script>


        <script>

            let lastActivity = Date.now();
            //============================================================//
            document.addEventListener("mousemove", () => lastActivity = Date.now());
            document.addEventListener("keydown", () => lastActivity = Date.now());
            document.addEventListener("click", () => lastActivity = Date.now());

    
            //=============================================================//

            async function sendHeartbeat() {
            const token = localStorage.getItem("token");

            if (!token) return;

            try {
            const res = await fetch("/session/heartbeat", {
            method: "POST",
            headers: {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token
            },
            body: JSON.stringify({
            service: "Inventory"
            })
            });

            if (res.status === 401) {
            logout();
            }

            } catch (err) {
            console.warn("Heartbeat failed", err);
            }
            }
            async function loadOnlineCount() {
            const token = localStorage.getItem("token");

            if (!token) return;

            try {
            const res = await fetch("/session/online-users?service=Inventory", {
            headers: {
            "Authorization": "Bearer " + token
            }
            });

            if (!res.ok) return;

            const data = await res.json();

            document.getElementById("onlineCount").innerText =
            "Online: " + data.length;

            } catch (err) {
            console.warn("Load online users failed", err);
            }
            }

            function getToken() {
            return localStorage.getItem("token")
            }

            let isLoggingOut = false;

            async function logout() {

            if (isLoggingOut) return;
            isLoggingOut = true;

            const token = localStorage.getItem("token");

            try {
            if (token) {
            await fetch("/session/end", {
            method: "POST",
            headers: {
            "Authorization": "Bearer " + token
            }
            });
            }
            } catch (err) {
            console.warn("Failed to end session", err);
            }

            localStorage.removeItem("user");
            localStorage.removeItem("token");

            window.location = "/login";
            }

            function checkLogin() {

            let token = getToken()

            if (!token && window.location.pathname !== "/login") {
            window.location = "/login"
            }
            }
            function loadUser() {

            const allowedRoles = ["Admin", "Inventory_Admin", "Admin_WH", "Supervisor"];
            let user = localStorage.getItem("user")

            if (!user) return

            user = JSON.parse(user)

            document.getElementById("userInfo").innerText =
            user.displayName + " (" + user.role + ")"

            if (user.thumbnailPhoto) {

            document.getElementById("userPhoto").src =
            "data:image/jpeg;base64," + user.thumbnailPhoto
            }

            if (!allowedRoles.includes(user.role)) {
            document.getElementById("reserveNav").style.display = "none"
            document.getElementById("transferNav").style.display = "none"
            document.getElementById("TransactionsNav").style.display = "none"
            document.getElementById("MasterManagementNav").style.display = "none"
            }
            }
            //=======================================
            checkLogin()
            loadUser()
            sendHeartbeat()
            loadOnlineCount()

            //====================================


            setInterval(() => {
            loadOnlineCount();
            }, 10000);

            setInterval(() => {
            if (Date.now() - lastActivity > 60 * 60 * 1000) { // 60 นาที
            logout();
            }
            }, 10000);

            setInterval(() => {
            if (Date.now() - lastActivity < 60000) {
            sendHeartbeat();
            }
            }, 30000);

        </script>



        @await RenderSectionAsync("Scripts", required: false)

    </body>

</html>