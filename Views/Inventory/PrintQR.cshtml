    // ──────────────────────────────────────────────────

    async function loadLayoutsIntoSelect() {
        const sel    = document.getElementById('fLayout')
        const rpSel  = document.getElementById('rpLayout')
        const rprSel = document.getElementById('rprLayout')
        const asmSel = document.getElementById('asmLayout')
        // Save current selections before rebuilding
        const prev = {
            fLayout:   sel?.value    || '',
            rpLayout:  rpSel?.value  || '',
            rprLayout: rprSel?.value || '',
            asmLayout: asmSel?.value || '',
        }
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const arr = Array.isArray(layouts) ? layouts : (layouts?.data || [])
            const opts = '<option value="">-- Select Layout --</option>' +
                arr.map(l => `<option value="${l.id}">${escHtml(l.templateName ?? 'Untitled')}</option>`).join('')
            if (sel)    { sel.innerHTML = opts;    sel._layoutsData = arr;    if (prev.fLayout)   sel.value    = prev.fLayout   }
            if (rpSel)  { rpSel.innerHTML = opts;  rpSel._layoutsData = arr;  if (prev.rpLayout)  rpSel.value  = prev.rpLayout  }
            if (rprSel) { rprSel.innerHTML = opts; rprSel._layoutsData = arr; if (prev.rprLayout) rprSel.value = prev.rprLayout }
            if (asmSel) { asmSel.innerHTML = opts; asmSel._layoutsData = arr; if (prev.asmLayout) asmSel.value = prev.asmLayout }
        } catch (_) {
            const err = '<option value="">-- (Unable to load Layouts) --</option>'
            if (sel)    sel.innerHTML = err
            if (rpSel)  rpSel.innerHTML = err
            if (rprSel) rprSel.innerHTML = err
            if (asmSel) asmSel.innerHTML = err
        }
    }

    function applyLayoutToSliders(layout) {
        const c = parseZplDataJson(layout)
        printState.layoutSliders = {
            qrX:       c.qrX       ?? 30,
            qrY:       c.qrY       ?? 40,
            qrSize:    c.qrSize    ?? 5,
            dataX:     c.dataX     ?? 373,
            dataY:     c.dataY     ?? 58,
            fontSize:  c.fontSize  ?? 22,
            valOffset: c.valOffset ?? 151,
        }
        printState.layoutQrFields = c.qrFields ?? null
        if (c.dpi)    document.getElementById('fDpi').value    = c.dpi.includes('12') ? '300' : '203'
        if (c.width)  document.getElementById('fWidth').value  = c.width
        if (c.height) document.getElementById('fHeight').value = c.height
    }

    function onLayoutChange() {
        const sel = document.getElementById('fLayout')
        const id  = sel.value
        if (!id) {
            printState.selectedLayoutId    = null
            printState.activeLayoutFields  = null
            printState.layoutSliders       = null
            renderChecklist(null)
            return
        }
        const layouts = sel._layoutsData || []
        const layout  = layouts.find(l => String(l.id) === String(id))
        if (!layout) return
        printState.selectedLayoutId   = layout.id
        applyLayoutToSliders(layout)
        const fields = parseLayoutFields(layout)
        printState.activeLayoutFields = fields
        renderChecklist(fields)
    }

    // ──────────────────────────────────────────────────
    // STEP 2 — Field Checklist
    // ──────────────────────────────────────────────────

    function renderChecklist(layoutFields) {
        const container = document.getElementById('step2Checklist')
        if (!container) return
        const d = printState.parsedQrData || {}
        container.innerHTML = ALL_FIELD_KEYS.map(k => {
            const lf      = layoutFields?.find(f => f.key === k)
            const label   = lf?.label ?? FIELD_LABELS[k]
            const checked = layoutFields ? (lf?.show ?? false) : false
            const value   = printState.formOverrides[k] ?? d[k] ?? ''
            const isReq     = REQUIRED_KEYS.has(k)
            const isAutoGen = k === 'lotNo'
            return `<div class="field-item" id="fci_row_${cid(k)}" onclick="toggleFci('${k}')">
                <input type="checkbox" id="fci_chk_${cid(k)}" ${checked ? 'checked' : ''}
                    onclick="event.stopPropagation()" onchange="updateFciRow('${k}')">
                <span class="field-name">${escHtml(label)}</span>
                ${isReq ? '<span class="req-star">*</span>' : ''}
                <span class="field-token">{${k}}</span>
                <input type="text" class="field-val-input" id="fci_val_${cid(k)}"
                    value="${escHtml(String(value))}"
                    placeholder="${isAutoGen ? '(auto-generate)' : isReq ? 'required' : ''}"
                    ${isAutoGen ? 'readonly style="margin-left:auto;width:130px;padding:4px 8px;font-size:12px;font-family:inherit;border:1.5px solid var(--border);border-radius:6px;color:var(--t2);background:#f8f9fc;cursor:default"' : ''}
                    onclick="event.stopPropagation()"
                    ${isAutoGen ? '' : 'onfocus="this.style.borderColor=\'var(--blue)\'" onblur="this.style.borderColor=\'var(--border)\'"'}
                    >
            </div>`
        }).join('')
        ALL_FIELD_KEYS.forEach(k => updateFciRow(k))
    }

    function toggleFci(k) {
        const cb = document.getElementById(`fci_chk_${cid(k)}`)
        if (cb) { cb.checked = !cb.checked; updateFciRow(k) }
    }

    function updateFciRow(k) {
        const row = document.getElementById(`fci_row_${cid(k)}`)
        const cb  = document.getElementById(`fci_chk_${cid(k)}`)
        if (!row || !cb) return
        row.style.borderColor = cb.checked ? 'var(--blue)' : 'var(--border)'
        row.style.background  = cb.checked ? 'var(--blue-lt)' : ''
    }

    function getCheckedFields() {
        return ALL_FIELD_KEYS
            .filter(k => document.getElementById(`fci_chk_${cid(k)}`)?.checked)
            .map(k => {
                const label = document.getElementById(`fci_row_${cid(k)}`)?.querySelector('.field-name')?.textContent
                    ?? FIELD_LABELS[k]
                const value = document.getElementById(`fci_val_${cid(k)}`)?.value ?? ''
                return { label, value }
            })
    }

    // ──────────────────────────────────────────────────
    // STEP 2 → STEP 3: doPreview
    // ──────────────────────────────────────────────────

    function genUlid() {
        const B32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ'
        let n = Date.now(), ts = ''
        for (let i = 9; i >= 0; i--) { ts = B32[n % 32] + ts; n = Math.floor(n / 32) }
        let rand = ''
        for (let i = 0; i < 16; i++) rand += B32[Math.floor(Math.random() * 32)]
        return ts + rand
    }

    async function doPreview() {
        // Validate required
        for (const k of REQUIRED_KEYS) {
            const val = (document.getElementById(`fci_val_${cid(k)}`)?.value ?? '').trim()
            if (!val) {
                showToast(`Please fill in ${FIELD_LABELS[k]}`, 'error')
                document.getElementById(`fci_val_${cid(k)}`)?.focus()
                return
            }
        }

        // Build fullData from form inputs
        const fullData = { ...printState.parsedQrData }
        ALL_FIELD_KEYS.forEach(k => {
            const el = document.getElementById(`fci_val_${cid(k)}`)
            if (el) fullData[k] = el.value
        })

        // Fetch new traceId from API — leave null if fails, backend will handle it
        try {
            const trRes = await api('/printer/new-traceId', 'GET')
            fullData.lotNo = trRes?.traceId ?? trRes?.id ?? trRes ?? null
        } catch (_) {
            fullData.lotNo = null
        }
        // Sync auto-gen lotNo back to input
        const intEl = document.getElementById(`fci_val_${cid('lotNo')}`)
        if (intEl && !intEl.value) intEl.value = fullData.lotNo

        // Layout params
        const sliders = printState.layoutSliders ?? { qrX:30,qrY:40,qrSize:5,dataX:373,dataY:58,fontSize:22,valOffset:151 }
        const dpiVal  = document.getElementById('fDpi').value
        const dpiStr  = dpiVal === '300' ? '12dpmm' : '8dpmm'
        const width   = +document.getElementById('fWidth').value  || 4
        const height  = +document.getElementById('fHeight').value || 3

        // Build ZPL
        const checkedFields = getCheckedFields()
        const zpl = buildZpl({ qrContent: buildQrContent(fullData, printState.layoutQrFields), textFields: checkedFields, ...sliders })

        printState.previewZpl      = zpl
        printState.previewFullData = fullData
        printState.previewImgSrc   = null

        // Call preview API (returns PNG blob)
        try {
            printState.previewImgSrc = await callZplPreview(zpl, dpiStr, width, height)
        } catch (_) {}

        goStep(3)
    }

