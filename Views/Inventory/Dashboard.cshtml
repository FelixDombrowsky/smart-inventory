        <div class="l3d-resizer" id="l3dResizer" title="Drag to resize · double-click to reset"></div>
        <aside class="l3d-panel" id="l3dPanel"></aside>
    </div>
</div>
</div>
</div>

<!-- ── TRANSACTION TREND (ดีไซน์ vault "Revenue") — /transaction/stock-transactions/summary ดู loadTrend() ──
     กราฟ: จำนวน transaction ทั้งหมด vs Receive รายวัน / แผง By Type อยู่ "ในการ์ดเดียวกัน" หุบไว้ก่อน กดปุ่ม By Type
     แล้วเลื่อนออกมาทางขวาของกราฟ (toggleTrendSide; การ์ดแคบ → ลงใต้กราฟ) — แถวนี้: Trend | Top Users | Real-time
     -->
<div class="trend-row">
    <div class="section-card trend-card" id="trendCard">
        <div class="trend-head">
            <div>
                <div class="sc-title" data-i18n="trendTitle">Transaction Trend</div>
                <div class="trend-total">
                    <span class="trend-total-num" id="trendTotal">—</span>
                    <span class="wb-stat-delta" id="trendDelta"></span>
                    <span class="trend-vs" data-i18n="trendVsPrev">vs previous period</span>
                </div>
            </div>
            <div class="trend-ctrl">
                <div class="trend-seg" role="group" aria-label="Range">
                    <button type="button" class="active" data-days="7" onclick="setTrendDays(7)" data-i18n="days7">7 Days</button>
                    <button type="button" data-days="30" onclick="setTrendDays(30)" data-i18n="days30">30 Days</button>
                </div>
                <button type="button" class="trend-side-btn" id="trendSideBtn" onclick="toggleTrendSide()"
                        aria-expanded="false" aria-controls="trendSide" aria-label="By Type" data-i18n-title="trendByType" title="By Type">
                    <i class="bi bi-chevron-right trend-side-chev"></i>
                </button>
            </div>
        </div>
        <div class="trend-legend">
            <span><i class="tr-lg tr-lg-all"></i><span data-i18n="trendAll">All transactions</span></span>
            <span><i class="tr-lg tr-lg-rcv"></i><span id="trendS2Label" data-i18n="trendReceive">Receive</span></span>
            <span class="trend-note" id="trendNote"></span>
        </div>
        <div class="trend-body">
            <div class="trend-chart" id="trendChart"><div class="trend-empty" id="trendMsg">Loading…</div></div>
            <aside class="trend-side" id="trendSide" aria-label="By Type">
                <div class="trend-side-inner">
                    <div class="trend-side-head">
                        <span class="trend-side-title" data-i18n="trendByType">By Type</span>
                        <span class="trend-vs" id="trendRangeLbl"></span>
                    </div>
                    <div class="tt-list" id="trendTypeList"><div class="trend-empty" style="height:120px">Loading…</div></div>
                </div>
            </aside>
        </div>
    </div>

    <!-- ── TOP USERS — GET /transaction/ranking?from&to[&transactionType] ช่วงเดียวกับกราฟ (7/30 วัน) ดู loadRanking() ── -->
    <div class="section-card rank-card">
        <div class="rank-head">
            <div style="min-width:0">
                <div class="sc-title" data-i18n="rankTitle">Top Users</div>
                <div class="trend-vs" id="rankRangeLbl"></div>
            </div>
            <select id="rankType" class="rank-sel" onchange="loadRanking()" aria-label="Transaction type">
                <option value="" data-i18n="allTypes">All Types</option>
            </select>
        </div>
        <div class="rank-cols"><span>#</span><span data-i18n="rankUser">User</span><span data-i18n="rankTxns">Transactions</span></div>
        <div class="rank-list" id="rankList"><div class="trend-empty" style="height:160px">Loading…</div></div>
    </div>

    <!-- ── REAL-TIME Transactions / Work Orders — ย้ายมาจากแถว Stock Summary มาต่อท้าย Top Users
         สูงเท่าการ์ดกราฟ (contain:size) เลื่อนดูในกล่อง -->
<div class="dash-split-live">
    <!-- Real-time Transaction Table — 6 คอลัมน์ (Line/WO ย้ายไปบรรทัดล่างของ Location, ชื่อ part ใต้ Part No., เวลาใต้ By) ดู sessionRowHtml() -->
    <div class="section-card live-card" id="rtCardTx">
        <div class="sc-head live-head">
            <div class="live-seg" role="group" aria-label="Live view">
                <button type="button" class="live-seg-btn active" data-live="tx" onclick="switchLiveView('tx')">Transactions</button>
                <button type="button" class="live-seg-btn" data-live="wo" onclick="switchLiveView('wo')">Work Orders</button>
            </div>
            <span class="live-badge"><span class="live-dot"></span>Live</span>
            <span class="rt-updated" id="rtTxUpdated">Waiting for connection…</span>
        </div>
        <div class="rt-table-wrap">
            <table class="inv-table live-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Part</th>
                        <th>Location</th>
                        <th>By</th>
                        <th style="width:44px"></th>
                        <th style="text-align:right">Txns</th>
                    </tr>
                </thead>
                <tbody id="rtTxBody">
                    <tr><td colspan="6" class="rt-empty">Waiting for real-time data…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Real-time WorkOrder Table -->
    <div class="section-card live-card" id="rtCardWo" style="display:none">
        <div class="sc-head live-head">
            <div class="live-seg" role="group" aria-label="Live view">
                <button type="button" class="live-seg-btn" data-live="tx" onclick="switchLiveView('tx')">Transactions</button>
                <button type="button" class="live-seg-btn active" data-live="wo" onclick="switchLiveView('wo')">Work Orders</button>
            </div>
            <span class="live-badge"><span class="live-dot"></span>Live</span>
            <span class="rt-updated" id="rtWoUpdated">Waiting for connection…</span>
        </div>
        <div class="rt-table-wrap">
            <table class="inv-table">
                <thead>
                    <tr>
                        <th>MO Number</th>
                        <th>Line</th>
                        <th>% On Hand</th>
                        <th>% FG Output</th>
                        <th>Updated At</th>
                    </tr>
                </thead>
                <tbody id="rtWoBody">
                    <tr><td colspan="5" class="rt-empty">Waiting for real-time data…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
</div>





