                    <th style="width:36px"></th>
                    <th class="sortable" onclick="sort('ItemPartNo')"><span data-i18n="colPartNo">Part No.</span> ⇅</th>
                    <th class="sortable" style="text-align:right;width:130px" onclick="sort('TotalOnHand')"><span data-i18n="colOnHand">On Hand</span> ⇅</th>
                    <th class="sortable" style="text-align:right;width:140px" onclick="sort('Available')"><span data-i18n="colAvailable">Available</span> ⇅</th>
                    <th class="sortable" style="text-align:right;width:90px" onclick="sort('LotCount')"><span data-i18n="colLots">Lots</span> ⇅</th>
                </tr>
            </thead>
            <tbody id="stockTable"></tbody>
