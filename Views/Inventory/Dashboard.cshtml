[data-theme="dark"] .badge-default              { background: #253347; border-color: #334155; color: #94a3b8; }
[data-theme="dark"] select option               { background: #1e293b; color: var(--text); }
[data-theme="dark"] .welcome-banner h2          { color: #0f172a; }
[data-theme="dark"] .welcome-banner p           { color: #334155; }
