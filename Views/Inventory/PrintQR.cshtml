@section Scripts {
<script src="lib/html5-qrcode/html5-qrcode.min.js"></script>
<script src="js/api.js"></script>
<script src="js/zplBuilder.js"></script>
<script src="js/printerPicker.js"></script>
<script src="js/apiForm.js"></script>
<script src="js/PhotoCapture.js"></script>
<script src="js/dateRangePicker.js"></script>
<script src="js/barcodeScanner.js"></script>
<script src="js/hwScanner.js"></script>
<script src="js/scanPipeline.js"></script>
<script src="js/locationTypeMeta.js"></script>
<script src="js/locationAutocomplete.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/workOrderAutocomplete.js"></script>
<script>
    // FIELD_LABELS, ALL_FIELD_KEYS, REQUIRED_KEYS, QR_REQUIRED_KEYS, buildZpl, buildLabelTextFields ฯลฯ
    // ย้ายไปอยู่ js/zplBuilder.js แล้ว (ใช้ร่วมกับ Split.cshtml/Merge.cshtml ได้โดยไม่ต้อง copy โค้ดซ้ำ)

    // ── Toast ──
    function showToast(msg, type) {
        const tc = document.getElementById('toastContainer')
        const t  = document.createElement('div')
        t.className = `sf-toast sf-toast-${type || 'info'}`
        t.textContent = msg
        tc.appendChild(t)
        setTimeout(() => t.remove(), 3200)
    }

    // ── Map API response → 13-field schema ──
    function mapScanResponse(res) {
        console.log("Response From Scan : ", res)
        return {
            partNo:          res.partNo                                    ?? '',
            quantity:        String(res.qty ?? res.quantity                ?? ''),
            unit:            res.unit                                      ?? '',
            description:     res.description                               ?? '',
            vendor:          res.vendor                                    ?? '',
            dateCode:        res.dateCode                                  ?? '',
            tradingCode:     res.tradingCode                               ?? '',
            po:              res.po                                        ?? '',
            inventoryNo:     res.invoiceNo  ?? res.inventoryNo             ?? '',
            traceId:         res.barcodeSerial || res.wH_TraceId || res.traceId || '',
            workOrder:       res.workOrder                                 ?? '',
            line:            res.line                                      ?? '',
            lotNo:           '',
            uniqueId:        '',
            productionArea:  res.productionArea ?? ''                           ?? '',
        }
    }

    function goToDesignLayout(layoutId) {
        const designPill = document.querySelectorAll('.tab-pill')[2]
        switchTab('design', designPill)
        const id = layoutId || document.getElementById('fLayout')?.value
        if (id) {
            openEditMode(id)
        } else {
            showListMode()
        }
    }

    async function loadLayoutsIntoSelect() {
        const sel     = document.getElementById('fLayout')
        const rcSel   = document.getElementById('rcLayout')
        const rprSel  = document.getElementById('rprLayout')
        const asmSel  = document.getElementById('asmLayout')
        const histSel = document.getElementById('histLayoutSelect')
        // Save current selections before rebuilding
        const prev = {
            fLayout:   sel?.value    || '',
            rcLayout:  rcSel?.value  || '',
            rprLayout: rprSel?.value || '',
            asmLayout: asmSel?.value || '',
            histLayoutSelect: histSel?.value || '',
        }
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const all = Array.isArray(layouts) ? layouts : (layouts?.data || [])
            const arr = filterLayoutsByPermission(all, isAdmin)
            const opts = '<option value="">-- Select Layout --</option>' +
                arr.map(l => `<option value="${l.id}" style="color:var(--text)">${escHtml(l.templateName ?? 'Untitled')}</option>`).join('')
            const histOpts = '<option value="">-- Default (8dpmm, 3.2x1.2 in) --</option>' +
                arr.map(l => {
                    const c = parseZplDataJson(l)
                    const dims = `${c.dpi ?? '8dpmm'}, ${c.width ?? 3.2}x${c.height ?? 1.2} in`
                    return `<option value="${l.id}">${escHtml(l.templateName ?? 'Untitled')} (${dims})</option>`
                }).join('')
            if (sel)    { sel.innerHTML = opts;    sel._layoutsData = arr;    if (prev.fLayout)   sel.value    = prev.fLayout   }
            if (histSel) { histSel.innerHTML = histOpts; histSel._layoutsData = arr; if (prev.histLayoutSelect) histSel.value = prev.histLayoutSelect }

            // rc/rpr/asm ใช้คู่กับ Printer select เสมอ (Receive/Reprint/Assembly) — ถ้ายังไม่เคยเลือกไว้ ให้ auto-select
            // ตัวแรกในลิสต์แทนที่จะปล่อยเป็น placeholder ว่างๆ (ผู้ใช้ไม่ต้องมาเลือกเองทุกครั้งถ้ามี Layout เดียว/ใช้ตัวแรกบ่อยสุด)
            // มีค่าเดิมอยู่แล้วก็แค่ restore ตามปกติ (การ re-trigger onchange ของ path นั้นทำอยู่แล้วที่ switchTab())
            const _autoSelectFirst = (selEl, prevVal) => {
                if (!selEl) return
                selEl.innerHTML = opts
                selEl._layoutsData = arr
                if (prevVal) { selEl.value = prevVal; return }
                if (arr.length) { selEl.value = arr[0].id; selEl.dispatchEvent(new Event('change')) }
            }
            _autoSelectFirst(rcSel,  prev.rcLayout)
            _autoSelectFirst(rprSel, prev.rprLayout)
            _autoSelectFirst(asmSel, prev.asmLayout)
            if (rcSel) rcSel.style.color = rcSel.value ? 'var(--text)' : 'var(--t3)'
        } catch (_) {
            const err = '<option value="">-- (Unable to load Layouts) --</option>'
            if (sel)    sel.innerHTML = err
            if (rcSel)  rcSel.innerHTML = err
            if (rprSel) rprSel.innerHTML = err
            if (asmSel) asmSel.innerHTML = err
            if (histSel) histSel.innerHTML = err
        }
    }

    // genUniqueId, _fetchUniqueId, buildQrContent, parseZplDataJson, parseLayoutFields, buildZpl
    // ย้ายไปอยู่ js/zplBuilder.js แล้ว — buildZplTemplate ยังอยู่ที่นี่เพราะผูกกับ DOM ของ Design tab โดยเฉพาะ
    function buildZplTemplate(fields) {
        const qrX      = +document.getElementById('slQrX').value
        const qrY      = +document.getElementById('slQrY').value
        const qrSize   = +document.getElementById('slQrSize').value
        const dataX    = +document.getElementById('slDataX').value
        const dataY    = +document.getElementById('slDataY').value
        const fontSize = +document.getElementById('slFontSize').value
        const valOffset= +document.getElementById('slValOffset').value
        const lineH    = Math.round(fontSize * 1.5)
        let zpl = `^XA\n^CI28\n`
        zpl += `^FO${qrX},${qrY}^BQN,2,${qrSize}^FDMA,{qrContent}^FS\n`
        fields.filter(f => f.show).forEach(({ key, label }, i) => {
            const y = dataY + i * lineH
            zpl += `^FO${dataX},${y}^A0N,${fontSize},${fontSize}^FD${label}:^FS\n`
            zpl += `^FO${dataX + valOffset},${y}^A0N,${fontSize},${fontSize}^FD{${key}}^FS\n`
        })
        zpl += `^XZ`
        return zpl
    }

    // callZplPreview, ZPL_DPI, _zebraFontReady, renderZplClient ย้ายไปอยู่ js/zplBuilder.js แล้ว

    // ── Hardware Barcode Scanner (dedicated input — same approach as Receive page) ──
    let _rpHwScanActive = false

    function _rpHwScanSetBtns(active) {
        const ids = ['rcHwScanBtn', 'rprHwScanBtn', 'asmHwScanBtn']
        ids.forEach(id => {
            const b = document.getElementById(id)
            if (!b) return
            if (active) {
                b.style.background = '#dc2626'
                b.onmouseover = () => b.style.background = '#b91c1c'
                b.onmouseout  = () => b.style.background = '#dc2626'
            } else {
                b.style.background = '#6b7280'
                b.onmouseover = () => b.style.background = '#4b5563'
                b.onmouseout  = () => b.style.background = '#6b7280'
            }
        })
    }

    const rpHwScanner = createHwScanner({
        inputId: 'hwInput', statusId: 'hwStatus',
        onScan: onScannerInput
    })

    function rpToggleHwScan() {
        _rpHwScanActive = !_rpHwScanActive
        const section = document.getElementById('hwSection')
        if (_rpHwScanActive) {
            // Move section to after rp-card-head of the relevant item list card
            const tabId = document.querySelector('.tab-pane.active')?.id
            if (tabId === 'tab-reprint') {
                const anchor = document.getElementById('rprScanAnchor')
                if (anchor) anchor.appendChild(section)
            } else if (tabId === 'tab-assembly') {
                const head = document.getElementById('asmMaterialsList')?.closest('.rp-card')?.querySelector('.rp-card-head')
                if (head) head.after(section)
            } else {
                // Receive tab — insert after rp-card-head inside the item list card
                const head = document.getElementById('rcItemList')?.closest('.rp-card')?.querySelector('.rp-card-head')
                if (head) head.after(section)
            }
            section.style.display = ''
            _rpHwScanSetBtns(true)
            setTimeout(() => rpHwScanner.open(), 80)
        } else {
            rpHwScanner.close()
            section.style.display = 'none'
            _rpHwScanSetBtns(false)
        }
    }

    function rpCloseHwScan() {
        if (!_rpHwScanActive) return
        _rpHwScanActive = false
        rpHwScanner.close()
        const section = document.getElementById('hwSection')
        if (section) section.style.display = 'none'
        _rpHwScanSetBtns(false)
    }

    function logScannerInput(code) {
        const tbody = document.getElementById('scannerLogBody')
        if (!tbody) return
        const now = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
        tbody.innerHTML = `
            <tr>
                <td style="padding:8px 14px;color:var(--t3);white-space:nowrap">${now}</td>
                <td style="padding:8px 14px;font-family:ui-monospace,monospace;word-break:break-all">${escHtml(code)}</td>
                <td style="padding:8px 14px;color:var(--t2)">${code.length} chars</td>
            </tr>`
    }

    function rpSetCamFooter(msg) {
        const el = document.getElementById('bcStatus')
        if (el) el.textContent = msg
    }

   
    // Scan หน้า Receive    

    const rpReceiveScan = createScanPipeline({
        mode: 'vendor', cooldownMs: 1500,
        onDuplicate: async (raw) => {
            if (!canCheckReceiveAlready) {
                showToast('This Barcode Already Receive', 'error');
                return false;
            }
            return await confirmDuplicate();
        },
        onResult: async (scanData, rawCode) => {
            if (scanData?.ourBarcode) {
                showToast('นี่คือ Our Barcode — เคย Receive ไปแล้ว ไม่ต้อง Receive ซ้ำ', 'error')
                rpSetCamFooter('⚠️ Our Barcode — ไม่สามารถ Receive')
                return
            }
            // ตรรกะเช็คซ้ำขั้นแรกให้ตรงกับ Receive.cshtml: ใช้ parsed identifier ก่อน ไม่ใช่ rawCode ตรงๆ
            const uniqueCheck = scanData.barcodeSerial || scanData.rawData || scanData.partNo
            if (!uniqueCheck) {
                showToast('Barcode no traceId or RawBarCode', 'error')
                rpSetCamFooter('⚠️ Barcode no traceId or RawBarCode')
                return
            }
            if (rcScannedTrace.has(uniqueCheck)) {
                if (canCheckScanDuplicate) {
                    const ok = await confirmDuplicate({
                        title:   'สแกนซ้ำ',
                        body:    'บาร์โค้ดนี้ถูกสแกนไปแล้วในรอบนี้<br>ต้องการเพิ่มเข้ารายการอีกครั้งหรือไม่?',
                        okLabel: 'Add to List'
                    })
                    if (!ok) { rpSetCamFooter('สแกนซ้ำ — ยกเลิก'); return }
                } else {
                    showToast('Scan Duplicate', 'error')
                    rpSetCamFooter('Scan Duplicate')
                    return
                }
            }
            const data = mapScanResponse(scanData)
            data._barcode   = rawCode
            data.rawBarCode = scanData.rawData || rawCode
            data._scanKey   = uniqueCheck
            const ok = await rcAddItem(data)
            if (ok) {
                rcScannedTrace.add(uniqueCheck)
                // snapshot กล้องตอนสแกนได้ → ผูกไว้กับ item เพื่อลบตามกันได้ (เหมือน Receive.cshtml)
                const snap = await rpScanner.snapshot()
                if (snap) {
                    rcPhoto.addScanBlob(snap)
                    const newItem = rcItems[rcItems.length - 1]
                    if (newItem) newItem.data._scanBlob = snap
                }
                showToast('✅ Added ' + (data.partNo || rawCode) + ' (' + rcItems.length + '/10)', 'success')
                rpSetCamFooter('✅ Added ' + (data.partNo || 'item') + ' (' + rcItems.length + '/10)')
            } else {
                rpSetCamFooter('⚠️ Unable to add item')
            }
        },
        onError: err => {
            showToast('❌ ' + (err?.message || String(err)), 'error')
            rpSetCamFooter('❌ ' + (err?.message || String(err)))
        }
    })

    const rpAssembleScan = createScanPipeline({
        mode: 'vendor', cooldownMs: 1500,
        onResult: async (scanData, rawCode) => {
            const lotNo = scanData.wH_TraceId || scanData.lotNo || scanData.traceId || rawCode
            const ok = asmAddLot(lotNo, scanData.partNo || null)
            const filled = asmMaterials.filter(m => m.lotNo).length
            if (ok) {
                showToast('✅ Lot added (' + filled + '/' + asmMaterials.length + ')', 'success')
                rpSetCamFooter('✅ Lot added (' + filled + '/' + asmMaterials.length + ')')
            } else {
                rpSetCamFooter('⚠️ Unable to add Lot')
            }
        },
        onError: err => {
            showToast('❌ ' + (err?.message || String(err)), 'error')
            rpSetCamFooter('❌ ' + (err?.message || String(err)))
        }
    })

    // ── Barcode type toggle (Our QR vs Vendor label) — เฉพาะแท็บ Re-Print ──
    let rprBarcodeMode = 'our'
    function setRprBarcodeMode(m) {
        rprBarcodeMode = m
        document.querySelectorAll('#rprBcModeGroup .bc-mode-btn').forEach(btn =>
            btn.classList.toggle('active', btn.dataset.mode === m))
        showToast('โหมดสแกน: ' + (m === 'our' ? 'Our Barcode' : 'Vendor Barcode'), 'success')
    }

    // Scan หน้า Re-Print
    const rpReprintScan = createScanPipeline({
        mode: 'ours', cooldownMs: 1500,
        barcodeFilter: () => rprBarcodeMode,
        onResult: async ({ lotNo, matches, notOurFormat, wrongModeOur }, rawCode) => {
            if (wrongModeOur || notOurFormat) return // สแกนผิดโหมด — เงียบไว้ ไม่ต้องแจ้งอะไร
            if (Array.isArray(matches) && matches.length > 1) {
                // raw barcode เดียวกัน match หลาย lot — ให้ผู้ใช้เลือกเองว่าจะ Re-Print lot ไหน
                await openRprPickLot(matches)
                return
            }
            lotNo = lotNo || rawCode
            const ok = await rprFetchAndAddByLotNo(lotNo)
            if (ok) {
                showToast('✅ LOT added (' + rprItems.length + '/10)', 'success')
                rpSetCamFooter('✅ LOT added (' + rprItems.length + '/10)')
            } else {
                rpSetCamFooter('⚠️ Unable to add LOT')
            }
        },
        onError: err => {
            showToast('❌ ' + (err?.message || String(err)), 'error')
            rpSetCamFooter('❌ ' + (err?.message || String(err)))
        }
    })

    function onScannerInput(code) {
        logScannerInput(code)
        const isAssembly = document.getElementById('tab-assembly')?.classList.contains('active')
        const isReprint  = document.getElementById('tab-reprint')?.classList.contains('active')
        if (isReprint) rpReprintScan.submit(code)
        else if (isAssembly) rpAssembleScan.submit(code)
        else rpReceiveScan.submit(code)
    }

    // ── Camera Barcode Scanner (shared across Receive, Reprint, Assembly tabs) ──
    let _rpScanMode = 'receive'
    let _rpScannerOrigParent = null

    const rpScanner = createBarcodeScanner({
        videoId: 'bcVideo', canvasId: 'bcCanvas', labelId: 'bcLabel',
        onDetect: _rpHandleScan, idleText: '— Scanning for barcode —'
    })

    window.addEventListener('beforeunload', (e) => {
        stopScan()
        const hasPending = (rcItems?.length > 0) || (rprItems?.length > 0) || (asmMaterials?.some(m => m.lotNo))
        if (hasPending) {
            e.preventDefault()
            e.returnValue = ''
        }
    })

    function rcToggleCam() {
        _rpScanMode = 'receive'
        if (rpScanner.running) stopScan(); else rpStartScan()
    }

    function rprToggleCam() {
        _rpScanMode = 'reprint'
        if (rpScanner.running) stopScan(); else rpStartScan()
    }

    function asmToggleCam() {
        _rpScanMode = 'assemble'
        if (rpScanner.running) stopScan(); else rpStartScan()
    }

    function _rpUpdateCamBtn(open) {
        const id = _rpScanMode === 'reprint'  ? 'rprBtnCam'
                 : _rpScanMode === 'assemble' ? 'asmBtnCam'
                 : 'rcBtnCam'
        const b = document.getElementById(id)
        if (!b) return
        const iconSize = id === 'rcBtnCam' ? '22px' : (id === 'rprBtnCam' ? '18px' : '16px')
        if (open) {
            b.innerHTML = `<i class="bi bi-x-circle" style="font-size:${iconSize}"></i>`
            b.style.background = '#dc2626'
        } else {
            b.innerHTML = `<i class="bi bi-camera" style="font-size:${iconSize}"></i>`
            b.style.background = 'var(--blue)'
        }
    }

    async function rpStartScan() {
        if (rpScanner.running) return
        if (!('BarcodeDetector' in window)) {
            showToast('This browser does not support BarcodeDetector', 'error'); return
        }
        const _scanSection = document.getElementById('bcSection')
        if (_rpScanMode === 'reprint') {
            const anchor = document.getElementById('rprScanAnchor')
            if (anchor && _scanSection) {
                if (!_rpScannerOrigParent) _rpScannerOrigParent = _scanSection.parentNode
                anchor.appendChild(_scanSection)
            }
        } else if (_rpScanMode === 'receive') {
            const anchor = document.getElementById('rcScanAnchor')
            if (anchor && _scanSection) {
                if (!_rpScannerOrigParent) _rpScannerOrigParent = _scanSection.parentNode
                anchor.appendChild(_scanSection)
            }
        }
        _scanSection.style.display = ''
        document.getElementById('bcStatus').textContent = 'Scanning…'
        if (_rpScanMode === 'receive') {
            const body = document.getElementById('rcWoCardBody')
            if (body) body.style.display = 'none'
        } else if (_rpScanMode === 'assemble') {
            const body = document.getElementById('asmOutputCardBody')
            if (body) body.style.display = 'none'
        }
        _rpUpdateCamBtn(true)
        try {
            await rpScanner.start()
            setTorchBtn(rpScanner.hasTorch())
        } catch (err) {
            showToast(err.message.includes('BarcodeDetector') ? err.message : 'Failed to open camera: ' + err.message, 'error')
            _scanSection.style.display = 'none'
            _rpUpdateCamBtn(false)
        }
    }

    function _rpHandleScan(text) {
        rpSetCamFooter('⏳ Processing...')
        if (_rpScanMode === 'reprint') rpReprintScan.submit(text)
        else if (_rpScanMode === 'assemble') rpAssembleScan.submit(text)
        else rpReceiveScan.submit(text)
        setTimeout(() => rpSetCamFooter('Scanning…'), 2000)
    }

    function stopScan() {
        rpScanner.stop()
        const _scanSection = document.getElementById('bcSection')
        _scanSection.style.display = 'none'
        if (_rpScannerOrigParent && _scanSection.parentNode !== _rpScannerOrigParent) {
            _rpScannerOrigParent.appendChild(_scanSection)
        }
        const woBody = document.getElementById('rcWoCardBody')
        if (woBody) woBody.style.display = ''
        const asmBody = document.getElementById('asmOutputCardBody')
        if (asmBody) asmBody.style.display = ''
        _rpUpdateCamBtn(false)
        setTorchBtn(false)
    }

    async function switchCamera() {
        await rpScanner.switchCamera()
        setTorchBtn(rpScanner.hasTorch())
    }

    function setTorchBtn(visible) {
        const btn = document.getElementById('bcTorchBtn')
        btn.style.display = visible ? 'flex' : 'none'
        btn.classList.remove('active')
    }

    async function toggleTorch() {
        const on = await rpScanner.toggleTorch()
        document.getElementById('bcTorchBtn').classList.toggle('active', on)
    }

    // ── Printer dropdown (shared across Receive, Reprint, Assembly) ──
    const _RP_PD = [
        { ns: 'rc',        menuId: 'rcPrinterMenu',       hiddenId: 'rcPrinterSelect'       },
        { ns: 'rpReprint', menuId: 'rpReprintPrinterMenu', hiddenId: 'rpReprintPrinterSelect' },
        { ns: 'asm',       menuId: 'asmPrinterMenu',       hiddenId: 'asmPrinterSelect'      },
    ]
    // status: undefined = ยังไม่โหลด (⏳), null = โหลดแล้ว fail, object = ผลจริง (มี isReady)
    // ต้องอยู่ scope นอก rpLoadPrinters เพราะ _rpPatchPrinterStatus (ถูกเรียกจาก .then() หลัง rpLoadPrinters return แล้ว) ก็ต้องอ่าน/เขียนตัวเดียวกันได้
    let statusMap = {}

    function rpPrinterDdToggle(ns) {
        const menu    = document.getElementById(ns + 'PrinterMenu')
        const trigger = document.getElementById(ns + 'PrinterTrigger')
        if (!menu) return
        const opening = menu.style.display === 'none'
        rpPrinterDdCloseAll()
        if (opening) {
            menu.style.display = ''
            trigger?.classList.add('open')
        }
    }

    // ปุ่มกด Refresh Printer — ยิงทั้ง /printer/all (ให้ isActive ล่าสุด) และ /printer/status (online/battery) ผ่าน rpLoadPrinters()
    // ไม่ auto-refresh ตอนเปิด dropdown แล้ว (ถี่เกินไป) ต้องกดปุ่มนี้เองเท่านั้น พร้อม spin animation สั้นๆ ให้รู้ว่ากดติด
    function rpManualRefreshPrinters(ns, btn) {
        btn?.classList.add('spinning')
        rpLoadPrinters()
        setTimeout(() => btn?.classList.remove('spinning'), 650)
    }

    function rpPrinterDdCloseAll() {
        document.querySelectorAll('.rp-pd-menu').forEach(m => m.style.display = 'none')
        document.querySelectorAll('.rp-pd-trigger').forEach(t => t.classList.remove('open'))
    }

    document.addEventListener('click', e => {
        if (!e.target.closest('.rp-pd-wrap')) rpPrinterDdCloseAll()
    })

    function rpPrinterPickFromEl(el) {
        rpPrinterPick(el.dataset.ns, el.dataset.ip, el.dataset.name, el.dataset.online === 'true', el.dataset.port)
    }

    function rpPrinterPick(ns, ip, name, online, port) {
        const hidden = document.getElementById(ns + 'PrinterSelect')
        if (hidden) { hidden.value = ip; hidden.dataset.port = port || 9100 }

        const dot = document.getElementById(ns + 'PrinterDot')
        if (dot) { dot.className = 'rp-pd-dot' + (online ? ' online' : ''); dot.style.display = '' }
        const nameEl = document.getElementById(ns + 'PrinterName')
        if (nameEl) { nameEl.textContent = name; nameEl.style.color = ''; nameEl.style.fontWeight = '600' }
        const ipEl = document.getElementById(ns + 'PrinterIp')
        if (ipEl) { ipEl.textContent = ip; ipEl.style.display = '' }

        document.getElementById(ns + 'PrinterMenu')?.querySelectorAll('.rp-pd-item').forEach(item => {
            const sel = item.dataset.ip === ip
            item.classList.toggle('active', sel)
            const chk = item.querySelector('.rp-pd-check')
            if (chk) chk.style.display = sel ? '' : 'none'
        })
        rpPrinterDdCloseAll()
        if (ns === 'rpReprint') rprSyncPrintBtn()
    }

    // ── Filter printer list ตาม permission ──
    // WMS.UI.Printer.All            => เห็นทุก Printer (ไม่ filter)
    // WMS.UI.Printer.<PREFIX>       => เห็นเฉพาะ printer ที่ชื่อขึ้นต้นด้วย <PREFIX>_ (แบ่งด้วย "_" เอาส่วนหน้า)
    //   เช่น WMS.UI.Printer.CH   -> CH_Printer_01
    //        WMS.UI.Printer.F1BR -> F1BR_Printer_01
    // Admin เห็นทุก Printer เสมอ, ถ้าไม่มี permission ที่ match เลยจะไม่เห็น printer ใดๆ
    function _rpFilterPrintersByPermission(printers) {
        if (isAdmin) return printers

        let permis = []
        try {
            const user = JSON.parse(localStorage.getItem('user') || '{}')
            permis = Array.isArray(user.permissions) ? user.permissions : []
        } catch (_) {}

        if (permis.includes('WMS.UI.Printer.All')) return printers

        const prefixTag = 'WMS.UI.Printer.'
        const allowedPrefixes = permis
            .filter(p => p.startsWith(prefixTag) && p.length > prefixTag.length)
            .map(p => p.slice(prefixTag.length))

        if (!allowedPrefixes.length) return []

        return printers.filter(p => {
            const namePrefix = (p.printerName || '').trim().split('_')[0]
            return allowedPrefixes.includes(namePrefix)
        })
    }

    async function rpLoadPrinters() {
        _RP_PD.forEach(c => {
            const m = document.getElementById(c.menuId)
            if (m) m.innerHTML = '<div class="rp-pd-msg"><span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>Loading…</div>'
        })

        let allPrinters = []
        try {
            const res = await api('/printer/all', 'GET')
            allPrinters = Array.isArray(res) ? res : (res?.data ?? [])
        } catch (err) {
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (m) m.innerHTML = '<div class="rp-pd-msg" style="color:var(--red)">⚠️ Load failed</div>'
            })
            showToast('Failed to load printers: ' + err.message, 'error')
            return
        }

        const activePrinters = allPrinters.filter(p => p.isActive !== false)
        if (activePrinters.length === 0) {
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (m) m.innerHTML = '<div class="rp-pd-msg">No printers found</div>'
            })
            return
        }

        statusMap = {}

        // rc (Receive) และ rpReprint (Reprint) ถูก filter ตาม permission, asm (Assembly) เห็นทุกตัวเหมือนเดิม
        const filteredPrinters = _rpFilterPrintersByPermission(activePrinters)
        const printersFor = ns => ns === 'asm' ? activePrinters : filteredPrinters

        const buildItems = (ns, printers, prevIp) =>
            printers.map(p => {
                const st       = statusMap[p.printerIp]
                const online   = st?.isReady === true
                const selected = p.printerIp === prevIp
                return `<div class="rp-pd-item${selected ? ' active' : ''}"
                             data-ns="${escHtml(ns)}"
                             data-ip="${escHtml(p.printerIp)}"
                             data-port="${p.printerPort || 9100}"
                             data-name="${escHtml(p.printerName.replace(/[\r\n]+/g,' ').trim())}"
                             data-online="${online}"
                             onclick="rpPrinterPickFromEl(this)">
                    ${printerRowHtml(p, { online, batteryPercent: st?.batteryPercent, isHeadOpen: st?.isHeadOpen, isPaperOut: st?.isPaperOut, selected })}
                </div>`
            }).join('')

        // แสดง dropdown ทันทีจาก /printer/all — สถานะ online/battery ยังไม่รู้ (dot เทาไว้ก่อน)
        _RP_PD.forEach(c => {
            const m = document.getElementById(c.menuId)
            if (!m) return
            const printers = printersFor(c.ns)
            if (!printers.length) { m.innerHTML = '<div class="rp-pd-msg">No printers found</div>'; return }
            const prevIp = document.getElementById(c.hiddenId)?.value
            m.innerHTML = buildItems(c.ns, printers, prevIp)
            // ยังไม่เคยเลือก printer ไว้ — auto-select ตัวแรกในลิสต์แทนที่จะปล่อยเป็น "-- Select Printer --"
            // ยกเว้น Admin ที่เห็นเครื่องพิมพ์ทุกเครื่อง — ไม่ auto-select ให้ บังคับให้เลือกเองกัน human error (มือลั่นกด print เครื่องแรกที่ auto มาให้)
            if (!isAdmin && !prevIp) {
                const p = printers[0]
                rpPrinterPick(c.ns, p.printerIp, p.printerName.replace(/[\r\n]+/g, ' ').trim(), false, p.printerPort)
            }
        })

        // ยิง /printer/status ทีละตัวแบบ background — พอผลกลับมาก็ patch แค่ row นั้น (ไม่ re-render ทั้ง list)
        activePrinters.forEach(p => {
            fetchPrinterStatus(p.printerIp, p.printerPort).then(st => _rpPatchPrinterStatus(p, st))
        })
    }

    function _rpPatchPrinterStatus(p, status) {
        statusMap[p.printerIp] = status || {}
        const online = status?.isReady === true
        document.querySelectorAll(`.rp-pd-item[data-ip="${p.printerIp}"]`).forEach(item => {
            item.dataset.online = online
            const selected = item.classList.contains('active')
            item.innerHTML = printerRowHtml(p, { online, batteryPercent: status?.batteryPercent, isHeadOpen: status?.isHeadOpen, isPaperOut: status?.isPaperOut, selected })
        })
        // sync จุดสถานะที่ trigger ด้วย ถ้า printer นี้ถูกเลือกอยู่
        _RP_PD.forEach(c => {
            const hidden = document.getElementById(c.hiddenId)
            if (hidden?.value !== p.printerIp) return
            const dot = document.getElementById(c.ns + 'PrinterDot')
            if (dot) dot.className = 'rp-pd-dot' + (online ? ' online' : '')
        })
    }

    // ── Admin check ──
    let isAdmin = false
    let canCheckReceiveAlready = false
    let canCheckScanDuplicate  = false
    ;(function() {
        const adminRoles = ['Admin', 'Inventory_Admin', 'Admin_WH', 'Supervisor']
        try {
            const user  = JSON.parse(localStorage.getItem('user') || '{}')
            const roles = Array.isArray(user.roles) ? user.roles : []
            const perms = Array.isArray(user.permissions) ? user.permissions : []
            if (roles.some(r => adminRoles.includes(r))) isAdmin = true
            canCheckReceiveAlready = isAdmin || perms.includes('WMS.UI.Check.Receive.Already')
            canCheckScanDuplicate  = isAdmin || perms.includes('WMS.UI.Check.Scan.Duplicate')

            const canReprint = isAdmin || perms.includes('WMS.UI.Print.Reprint')
            const reprintPill = document.getElementById('reprintTabPill')
            if (reprintPill) reprintPill.style.display = canReprint ? '' : 'none'

            // ปุ่มสลับ Scan Mode (Our/Vendor) ในแท็บ Re-Print — ต้องมี permission นี้ถึงจะเห็น ไม่งั้นซ่อนแล้วใช้ Our เป็น default เสมอ
            const canReadBarcodeVendor = isAdmin || perms.includes('WMS.UI.ReadBarcodeVendor')
            const rprBcModeGroup = document.getElementById('rprBcModeGroup')
            if (rprBcModeGroup) rprBcModeGroup.style.display = canReadBarcodeVendor ? '' : 'none'
        } catch (_) {}
    })()

    // ── Duplicate Receive confirm (Promise-based) ──
    let _rpDupResolve = null
    document.getElementById('rpDupOkBtn').addEventListener('click', () => {
        document.getElementById('rpDupModal').style.display = 'none'
        _rpDupResolve?.(true)
        _rpDupResolve = null
    })
    document.getElementById('rpDupCancelBtn').addEventListener('click', () => {
        document.getElementById('rpDupModal').style.display = 'none'
        _rpDupResolve?.(false)
        _rpDupResolve = null
    })
    function confirmDuplicate(opts = {}) {
        const {
            title   = 'Lot Duplicate',
            body    = 'Barcode นี้เคยถูก Receive ไปแล้ว<br>ต้องการ Receive อีกครั้งหรือไม่?',
            okLabel = 'Receive'
        } = opts
        document.getElementById('rpDupModalTitle').textContent = title
        document.getElementById('rpDupModalBody').innerHTML    = body
        document.getElementById('rpDupOkBtn').textContent      = okLabel
        return new Promise(resolve => {
            _rpDupResolve = resolve
            document.getElementById('rpDupModal').style.display = 'flex'
        })
    }

    // ── Init ──
    loadLayoutsIntoSelect()
    loadLayoutList()
    rpLoadPrinters()
    loadLocation()
    loadPerLocation()

    // Deep-link จากหน้าอื่น (เช่น WorkOrderLots) — ?tab=reprint&lot=XXX เปิดแท็บ Re-Print แล้วดึง lot นั้นเข้าลิสต์ให้เลย
    ;(function () {
        const params = new URLSearchParams(window.location.search)
        if (params.get('tab') !== 'reprint') return
        const reprBtn = [...document.querySelectorAll('.tab-pill')].find(b => b.textContent.includes('Re-Print'))
        if (reprBtn) reprBtn.click()
        const lot = params.get('lot')
        if (lot && typeof rprFetchAndAddByLotNo === 'function') rprFetchAndAddByLotNo(lot)
    })()
</script>
}


