@{
    ViewData["Title"] = "Move Materials";
}
<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --green:#059669; --green-lt:#ecfdf5;
    --red:#dc2626; --amber:#d97706;

}

.page-header {
    background:linear-gradient(135deg,var(--navy) 0%,#1e3a6e 60%,#1a6fff 100%);
    border-radius:16px; padding:20px 28px; margin-bottom:20px;
    position:relative; overflow:hidden;
}
.page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04); }
.page-header h2 { font-size:22px; font-weight:700; color:#fff; margin-bottom:4px; }
.page-header p  { font-size:13px; color:rgba(255,255,255,.65); margin:0; }

.rx-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.rx-card-body { padding:22px 24px; }

/* Scanner */
.scanner-box {
    width:100%; height:50vh; max-height:520px; border:3px solid var(--blue);
    border-radius:16px; position:relative; overflow:hidden; background:#000; margin:0 auto;
}
.scanner-box video  { position:absolute;inset:0;width:100%;height:100%;object-fit:cover; }
.scanner-box canvas { position:absolute;inset:0;width:100%;height:100%;pointer-events:none; }
.mv-detected-label {
    position:absolute; bottom:0; left:0; right:0;
    background:rgba(0,0,0,.65); color:#fff;
    font-size:12px; font-weight:600; padding:6px 10px;
    text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}

/* Location */
.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:10px 12px 10px 38px;
    border:1.5px solid var(--border); border-radius:10px;
    font-size:14px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item {
    padding:10px 14px; font-size:13px; cursor:pointer;
    border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; transition:.12s;
}
.loc-item:last-child { border-bottom:none; }
.loc-item:hover { background:var(--blue-lt); }
.loc-item:first-child { border-radius:8px 8px 0 0; }
.loc-item:last-child  { border-radius:0 0 8px 8px; }

/* Move badge */
.move-badge {
    display:flex; align-items:center; gap:10px; padding:11px 16px;
    background:var(--blue-lt); border:1.5px solid #93c5fd;
    border-radius:10px; font-size:13px; font-weight:700; color:var(--blue);
    margin-bottom:16px;
}

/* Table */
.rx-table { width:100%; border-collapse:collapse; font-size:13px; }
.rx-table th {
    background:#f8f9fc; color:var(--t2); font-weight:700; font-size:11px;
    letter-spacing:.04em; text-transform:uppercase;
    padding:10px 16px; border-bottom:2px solid var(--border); text-align:left;
}
.rx-table td { padding:9px 16px; border-bottom:1px solid var(--border); vertical-align:middle; }
.rx-table tr:last-child td { border-bottom:none; }
.rx-table tbody tr:hover td { background:#fafbff; }
.rx-table tbody tr.row-err td { background:#fef2f2; }
.rx-input { width:100%; padding:6px 9px; border:1.5px solid var(--border); border-radius:7px; font-size:13px; font-family:inherit; outline:none; box-sizing:border-box; }
.rx-input:focus { border-color:var(--blue); }
.del-btn { width:30px; height:30px; border:none; border-radius:7px; background:#fef2f2; color:var(--red); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.del-btn:hover { background:var(--red); color:#fff; }

/* Move button */
.move-btn {
    width:100%; padding:14px; border:none; border-radius:12px;
    font-size:15px; font-weight:700; font-family:inherit; cursor:pointer;
    transition:.2s; background:var(--blue); color:#fff; margin-top:16px;
}
.move-btn:disabled { background:#e5e7eb; color:#9ca3af; cursor:not-allowed; }
.move-btn:not(:disabled):hover { background:var(--blue-dk); }

/* Toast */
.toast-wrap { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.toast-item { padding:11px 20px; border-radius:10px; font-size:13px; font-weight:600; color:#fff; box-shadow:0 4px 16px rgba(0,0,0,.18); animation:tIn .25s ease; min-width:160px; }
.toast-ok   { background:var(--green); }
.toast-err  { background:var(--red); }
.toast-warn { background:var(--amber); }
@@keyframes tIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:none} }
</style>

<div class="toast-wrap" id="toastWrap"></div>

<!-- Header -->
<div class="page-header">
    <div>
        <h2 style="display:flex;align-items:center;gap:10px">
            Move Materials
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="opacity:.85">
                <line x1="2" y1="9" x2="22" y2="9"/>
                <polyline points="18 5 22 9 18 13"/>
                <line x1="22" y1="15" x2="2" y2="15"/>
                <polyline points="6 11 2 15 6 19"/>
            </svg>
        </h2>
    </div>
</div>

<!-- Destination Location + Camera button -->
<div class="rx-card">
    <div class="rx-card-body">
        <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
            <i class="bi bi-geo-alt-fill me-1" style="color:var(--blue)"></i>Destination Location <span style="color:var(--red)">*</span>
        </div>
        <div style="display:flex;gap:8px;align-items:flex-start">
            <div class="loc-wrap" style="flex:1">
                <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                <input id="locationSearch" class="loc-input"
                       placeholder="ค้นหา Destination Location..."
                       autocomplete="off"
                       oninput="searchLocation()"
                       onblur="setTimeout(hideLocationDropdown, 200)">
                <input type="hidden" id="locationId">
                <div id="locationDropdown" class="loc-dd"></div>
            </div>
<button id="mvCameraBtn" onclick="mvToggleScan()"
                    style="flex-shrink:0;height:42px;padding:0 16px;background:var(--blue);color:#fff;
                           border:none;border-radius:10px;font-size:13px;font-weight:700;
                           cursor:pointer;font-family:inherit;transition:.15s;display:flex;
                           align-items:center;gap:6px;white-space:nowrap"
                    onmouseover="this.style.background='var(--blue-dk)'"
                    onmouseout="this.style.background=scannerRunning?'var(--blue-dk)':'var(--blue)'">
                <i class="bi bi-camera-fill"></i><span id="mvCameraBtnTxt">Open Camera</span>
            </button>
        </div>
    </div>
</div>

<!-- Scanner (hidden until open) -->
<div id="scannerSection" style="display:none" class="rx-card">
    <div class="rx-card-body" style="padding-top:16px;padding-bottom:16px">
        <div class="scanner-box">
            <video id="mvVideo" autoplay playsinline muted></video>
            <canvas id="mvCanvas"></canvas>
            <div class="mv-detected-label" id="mvLabel">— ยังไม่พบ barcode —</div>
        </div>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:14px">
            <button onclick="switchCamera()"
                    style="padding:9px 20px;border:1.5px solid var(--border);border-radius:9px;
                           background:#fff;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s"
                    onmouseover="this.style.borderColor='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)'">
                <i class="bi bi-arrow-repeat me-1"></i>สลับกล้อง
            </button>
            <button onclick="stopScan()"
                    style="padding:9px 20px;border:none;border-radius:9px;background:#fee2e2;
                           color:var(--red);font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                ⏹ หยุด
            </button>
        </div>
        <div id="scanStatus" style="text-align:center;font-size:13px;color:var(--t2);margin-top:10px;min-height:18px">
            กำลังสแกน…
        </div>
    </div>
</div>

<!-- Result section (hidden until scan) -->
<div id="scanResultSection" style="display:none">

    <!-- Badge -->
    <div class="move-badge">
        <i class="bi bi-box-arrow-right"></i>
        <span>รายการที่จะ Move</span>
        <span id="itemCountBadge"
              style="margin-left:auto;background:var(--blue-lt);color:var(--blue);
                     padding:2px 12px;border-radius:20px;font-size:12px;font-weight:700">
            0 รายการ
        </span>
    </div>

    <!-- Items table -->
    <div class="rx-card" style="overflow:hidden">
        <table class="rx-table">
            <thead>
                <tr>
                    <th>Part No</th>
                    <th>Lot No</th>
                    <th>From Location</th>
                    <th style="width:120px">Qty</th>
                    <th style="width:46px"></th>
                </tr>
            </thead>
            <tbody id="moveTable"></tbody>
        </table>
    </div>

    <button class="move-btn" id="moveBtn" onclick="submitMove()" disabled>
        Move
    </button>

</div>

@section Scripts {
    <script src="/js/api.js"></script>
    <script src="/lib/html5-qrcode/html5-qrcode.min.js"></script>
    <script>
        let mvStream = null, mvRafId = null, mvDetector = null;
        let scannerRunning = false;
        let facingMode = "environment";
        let scannedTrace = new Set(), pendingScan = new Set();
        let lastScanTime = 0;

        window.addEventListener("beforeunload", stopScan);

        const SCAN_CFG = {
            fps: 15,
            qrbox: (w, h) => { const s = Math.min(w, h) * .72; return { width: s, height: s }; },
            aspectRatio: 1.0
        };

        // ── Camera (BarcodeDetector) ────────────────────
        function mvToggleScan() {
            if (scannerRunning) stopScan(); else startScan();
        }

        function mvSetCameraBtn(running) {
            const btn = document.getElementById("mvCameraBtn");
            const txt = document.getElementById("mvCameraBtnTxt");
            if (running) {
                btn.style.background = "#dc2626";
                btn.onmouseover = () => btn.style.background = "#b91c1c";
                btn.onmouseout  = () => btn.style.background = "#dc2626";
                txt.textContent = "ปิดกล้อง";
            } else {
                btn.style.background = "var(--blue)";
                btn.onmouseover = () => btn.style.background = "var(--blue-dk)";
                btn.onmouseout  = () => btn.style.background = "var(--blue)";
                txt.textContent = "Open Camera";
            }
        }

        async function startScan() {
            if (!('BarcodeDetector' in window)) {
                toast("เบราว์เซอร์นี้ไม่รองรับ BarcodeDetector", "err"); return;
            }
            document.getElementById("scannerSection").style.display = "";
            document.getElementById("scanStatus").textContent = "กำลังสแกน…";
            mvSetCameraBtn(true);
            try {
                mvStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode, width: { ideal: 1280 }, height: { ideal: 720 } }
                });
            } catch {
                try {
                    mvStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } });
                    facingMode = "user";
                } catch (e2) {
                    toast("ไม่สามารถเข้าถึงกล้อง: " + e2.message, "err");
                    document.getElementById("scannerSection").style.display = "none";
                    mvSetCameraBtn(false);
                    return;
                }
            }
            const video = document.getElementById("mvVideo");
            video.srcObject = mvStream;
            await video.play();
            const formats = await BarcodeDetector.getSupportedFormats();
            mvDetector = new BarcodeDetector({ formats });
            scannerRunning = true;
            mvDetectLoop();
        }

        function mvDetectLoop() {
            if (!scannerRunning) return;
            const video  = document.getElementById("mvVideo");
            const canvas = document.getElementById("mvCanvas");
            const label  = document.getElementById("mvLabel");
            const ctx    = canvas.getContext("2d");

            // ขนาด canvas ตาม displayed size เพื่อให้ scale ถูกต้อง
            const dw = canvas.offsetWidth, dh = canvas.offsetHeight;
            if (canvas.width !== dw || canvas.height !== dh) {
                canvas.width  = dw;
                canvas.height = dh;
            }

            if (video.readyState < 2) {
                mvRafId = requestAnimationFrame(mvDetectLoop);
                return;
            }

            // detect() resolve ก่อนถึง rAF ต่อไป → กรอบไม่โดนลบทันที
            mvDetector.detect(video).then(results => {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                if (results.length > 0) {
                    const scaleX = canvas.width  / (video.videoWidth  || canvas.width);
                    const scaleY = canvas.height / (video.videoHeight || canvas.height);
                    results.forEach(b => {
                        const x = b.boundingBox.x * scaleX;
                        const y = b.boundingBox.y * scaleY;
                        const w = b.boundingBox.width  * scaleX;
                        const h = b.boundingBox.height * scaleY;
                        ctx.strokeStyle = "#60a5fa";
                        ctx.lineWidth   = 3;
                        ctx.strokeRect(x, y, w, h);
                        const tagY = y > 24 ? y - 4 : y + h + 16;
                        ctx.fillStyle = "rgba(26,111,255,.88)";
                        ctx.fillRect(x, tagY - 16, Math.min(w, 180), 18);
                        ctx.fillStyle = "#fff";
                        ctx.font = "bold 11px sans-serif";
                        ctx.fillText(b.format.replace("_"," ").toUpperCase(), x + 4, tagY);
                    });
                    const first = results[0];
                    label.textContent = `${first.format}: ${first.rawValue}`;
                    scanBarcodeApi(first.rawValue);
                } else {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    label.textContent = "— กำลังค้นหา barcode —";
                }
                if (scannerRunning) mvRafId = requestAnimationFrame(mvDetectLoop);
            }).catch(() => {
                if (scannerRunning) mvRafId = requestAnimationFrame(mvDetectLoop);
            });
        }

        async function stopScan() {
            scannerRunning = false;
            cancelAnimationFrame(mvRafId);
            if (mvStream) { mvStream.getTracks().forEach(t => t.stop()); mvStream = null; }
            const video = document.getElementById("mvVideo");
            video.srcObject = null;
            const canvas = document.getElementById("mvCanvas");
            canvas.getContext("2d").clearRect(0, 0, canvas.width, canvas.height);
            document.getElementById("mvLabel").textContent = "— ยังไม่พบ barcode —";
            document.getElementById("scannerSection").style.display = "none";
            mvSetCameraBtn(false);
        }

        async function switchCamera() {
            if (!scannerRunning) return;
            facingMode = facingMode === "environment" ? "user" : "environment";
            scannerRunning = false;
            cancelAnimationFrame(mvRafId);
            if (mvStream) { mvStream.getTracks().forEach(t => t.stop()); mvStream = null; }
            // scannerSection already visible — startScan will re-use it
            document.getElementById("scannerSection").style.display = "";
            await startScan();
        }

        // ── Scan ───────────────────────────────────────
        function canScan() {
            const now = Date.now();
            if (now - lastScanTime < 1500) return false;
            lastScanTime = now;
            return true;
        }

        function scanBarcodeApi(code) {
            if (!canScan()) return;
            addLotToMoveList(code);
            document.getElementById("scanStatus").textContent = "กำลังสแกน…";
        }

        function addLotToMoveList(code) {
            code = (code || "").trim();
            if (!code) return;

            let lotNo = code, partNo = "—", qty = 1;

            // Try JSON
            try {
                const obj = JSON.parse(code);
                lotNo  = obj.lotNo ?? obj.traceId ?? obj.internalTraceId ?? code;
                partNo = obj.partNo ?? "—";
                qty    = parseInt(obj.quantity) || 1;
            } catch (_) {
                // Try {-delimited barcode
                const parsed = parseBarcode(code);
                if (parsed) {
                    lotNo  = parsed.traceId ?? code;
                    partNo = parsed.partNo  ?? "—";
                    qty    = parsed.qty     ?? 1;
                }
            }

            if (!lotNo) { toast("ไม่สามารถอ่าน Lot No ได้", "err"); return; }
            if (scannedTrace.has(lotNo)) { toast("สแกนซ้ำ: " + lotNo, "err"); return; }

            scannedTrace.add(lotNo);
            addMoveRow({ partNo, lotNo, location: "—", onHandQty: qty, traceId: lotNo }, lotNo);
            toast("✓ " + lotNo, "ok");
        }

        // ── Table ──────────────────────────────────────
        function addMoveRow(data, traceKey) {
            const onHand = data.onHandQty ?? 0;
            document.getElementById("moveTable").insertAdjacentHTML("beforeend", `
                <tr data-trace="${traceKey}">
                    <td style="font-weight:700;color:var(--navy)">${data.partNo ?? ""}</td>
                    <td style="color:var(--t2)">${data.lotNo ?? ""}</td>
                    <td>
                        <span style="background:#f0f2f5;padding:3px 10px;border-radius:6px;
                                     font-size:12px;font-weight:600;color:var(--t2)">
                            ${data.location ?? "—"}
                        </span>
                    </td>
                    <td>
                        <input class="rx-input qty" type="number"
                               value="${onHand}" min="1" max="${onHand}"
                               style="width:90px;text-align:center"
                               oninput="updateMoveBtn()">
                    </td>
                    <td style="display:none"><input class="traceId" value="${data.traceId ?? traceKey}"></td>
                    <td><button class="del-btn" onclick="removeRow(this)"><i class="bi bi-trash3"></i></button></td>
                </tr>`);
            showScanSection();
        }

        function removeRow(btn) {
            const row = btn.closest("tr");
            const traceKey = row.dataset.trace;
            if (traceKey) scannedTrace.delete(traceKey);
            row.remove();
            const count = document.querySelectorAll("#moveTable tr").length;
            if (count === 0) {
                document.getElementById("scanResultSection").style.display = "none";
            } else {
                document.getElementById("itemCountBadge").textContent = count + " รายการ";
                updateMoveBtn();
            }
        }

        function showScanSection() {
            document.getElementById("scanResultSection").style.display = "";
            const count = document.querySelectorAll("#moveTable tr").length;
            document.getElementById("itemCountBadge").textContent = count + " รายการ";
            updateMoveBtn();
        }

        function updateMoveBtn() {
            const hasLocation = !!document.getElementById("locationId").value;
            const hasItems    = document.querySelectorAll("#moveTable tr").length > 0;
            document.getElementById("moveBtn").disabled = !(hasLocation && hasItems);
        }

        // ── Submit Move ────────────────────────────────
        async function submitMove() {
            const locationCode = document.getElementById("locationSearch").value.trim();
            const locationId   = document.getElementById("locationId").value;
            if (!locationCode || !locationId) { toast("เลือก Destination Location ก่อน", "err"); return; }

            const rows    = document.querySelectorAll("#moveTable tr");
            const payload = [];
            rows.forEach(r => {
                const traceId = r.querySelector(".traceId")?.value;
                const qty     = parseInt(r.querySelector(".qty")?.value) || 0;
                if (traceId && qty > 0) payload.push({ TraceId: traceId, ToLocationCode: locationCode, quantity: qty });
            });

            if (!payload.length) { toast("ไม่มีรายการ", "err"); return; }

            const btn = document.getElementById("moveBtn");
            btn.disabled = true;
            btn.textContent = "⏳ กำลัง Move…";

            try {
                const result = await api("/inventory/move/batch", "POST", payload);
                const resultArr = Array.isArray(result) ? result : [];

                rows.forEach(r => {
                    const traceId  = r.querySelector(".traceId")?.value;
                    const traceKey = r.dataset.trace;
                    const item     = resultArr.find(x => x.traceId === traceId);
                    if (!item || item.success !== false) {
                        scannedTrace.delete(traceKey);
                        r.remove();
                    } else {
                        r.classList.add("row-err");
                    }
                });

                const remaining = document.querySelectorAll("#moveTable tr").length;
                if (remaining === 0) {
                    document.getElementById("scanResultSection").style.display = "none";
                    toast("Move สำเร็จ ✓", "ok");
                } else {
                    document.getElementById("itemCountBadge").textContent = remaining + " รายการ";
                    toast(`Move สำเร็จบางส่วน — ${remaining} รายการล้มเหลว`, "warn");
                }
            } catch (err) {
                toast(err.message || "Move ล้มเหลว", "err");
            } finally {
                btn.disabled = false;
                btn.textContent = "Move";
                updateMoveBtn();
            }
        }

        // ── Location search ────────────────────────────
        let locationSearchTimer = null;

        async function searchLocation() {
            const text = document.getElementById("locationSearch").value.trim();
            document.getElementById("locationId").value = "";
            updateMoveBtn();

            const dd = document.getElementById("locationDropdown");
            if (!text) { dd.style.display = "none"; return; }

            dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
            </div>`;
            dd.style.display = "block";

            clearTimeout(locationSearchTimer);
            locationSearchTimer = setTimeout(async () => {
                try {
                    const json = await api(`/master/locations?search=${encodeURIComponent(text)}&isActive=true&page=1&pageSize=20`, "GET");
                    const list = json.data ?? json.Data ?? [];

                    if (!list.length) {
                        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                            <i class="bi bi-search me-2"></i>ไม่พบ Location
                        </div>`;
                        return;
                    }

                    dd.innerHTML = list.map(loc => `
                        <div class="loc-item" onclick="selectLocation('${loc.locationCode}', ${loc.id})">
                            <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0"></i>
                            <span>
                                <strong>${loc.locationCode}</strong>
                                ${loc.description ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${loc.description}</span>` : ""}
                            </span>
                            ${loc.typeName ? `<span style="margin-left:auto;font-size:11px;color:var(--t3)">${loc.typeName}</span>` : ""}
                        </div>`).join("");
                } catch {
                    dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                        <i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ
                    </div>`;
                }
            }, 300);
        }

        function selectLocation(code, id) {
            document.getElementById("locationSearch").value = code;
            document.getElementById("locationId").value = id;
            document.getElementById("locationDropdown").style.display = "none";
            updateMoveBtn();
        }

        function hideLocationDropdown() {
            document.getElementById("locationDropdown").style.display = "none";
        }

        // ── Helpers ────────────────────────────────────
        function parseBarcode(raw) {
            const parts = raw.split("{").map(x => x.trim()).filter(x => x);
            if (parts.length < 9) return null;
            return {
                partNo: parts[0], qty: parseInt(parts[1]) || 1, unit: parts[2],
                vendor: parts[3], dateCode: parts[4], tradingCode: parts[5],
                po: parts[6], inventoryNo: parts[7], traceId: parts[8]
            };
        }

        function buildRawBarcode(d) {
            return [d.partNo, d.qty, d.unit, d.vendor, d.dateCode,
                    d.tradingCode || "", d.po || "", d.inventoryNo || "", d.traceId].join(" {");
        }

        // ── Bluetooth / USB HID scanner listener ──────
        ;(function initMvScannerListener() {
            let _buf = '', _timer = null;
            const THRESHOLD_MS = 150, MIN_LEN = 4;
            function commitBuf() {
                const code = _buf; _buf = '';
                if (code.length >= MIN_LEN) addLotToMoveList(code);
            }
            document.addEventListener('keydown', e => {
                if (scannerRunning) return; // กล้องเปิดอยู่ ไม่รับ keyboard
                if (e.key === 'Enter') { clearTimeout(_timer); commitBuf(); return; }
                if (e.key.length === 1) {
                    _buf += e.key;
                    clearTimeout(_timer);
                    _timer = setTimeout(commitBuf, THRESHOLD_MS);
                }
            });
        })();

        // ── Toast ──────────────────────────────────────
        function toast(msg, type) {
            const wrap = document.getElementById("toastWrap");
            const el   = document.createElement("div");
            const cls  = type === "ok" ? "toast-ok" : type === "warn" ? "toast-warn" : "toast-err";
            el.className = "toast-item " + cls;
            el.textContent = msg;
            wrap.appendChild(el);
            setTimeout(() => el.remove(), type === "warn" ? 5000 : 3000);
        }
    </script>
}
