<!-- ══════ TAB: DESIGN ══════ -->
<div class="tab-pane" id="tab-design">

    <!-- LIST MODE -->
    <div id="designList">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <div style="font-size:18px;font-weight:700;color:var(--navy)">Saved Layouts</div>
            <button class="btn-primary" onclick="openCreateMode()">+ New Layout</button>
        </div>
        <div id="layoutListContainer">
            <div style="text-align:center;color:var(--t3);padding:40px">Loading…</div>
        </div>
    </div>

    <!-- EDIT MODE -->
    <div id="designEdit" style="display:none">

        <!-- Back + Title + Name/Desc (top bar) -->
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
            <button onclick="showListMode()"
                style="display:flex;align-items:center;gap:6px;padding:8px 14px;background:#f0f2f5;border:1px solid var(--border);border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;color:var(--text);white-space:nowrap">
                ← Layouts
            </button>
            <span style="font-size:15px;font-weight:700;color:var(--navy);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" id="editModeTitle">New Layout</span>
            <button id="dsActionBtn" onclick="dsActionClick()"
                style="display:flex;align-items:center;gap:6px;padding:8px 18px;background:var(--blue);color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap">
                💾 Save
            </button>
        </div>

        <!-- Name + Description (compact 2-col) -->
        <div class="card" style="margin-bottom:14px">
            <div class="card-body" style="padding:14px">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div>
                        <label class="form-label">Template Name <span class="req">*</span></label>
                        <input class="form-input" id="dsTemplateName" placeholder="e.g. Standard Barcode 1">
                    </div>
                    <div>
                        <label class="form-label">Description</label>
                        <input class="form-input" id="dsDescription" placeholder='e.g. 3 × 1.2 "'>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2-column split: Left = Preview, Right = Data/QR/Layout tabs -->
        <div class="ds-edit-grid">

            <!-- LEFT: Preview -->
            <div class="card">
                <div class="card-body" style="padding:16px">
                    <!-- DPI / Width / Height -->
                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:14px">
                        <div>
                            <label class="form-label">DPI</label>
                            <select class="form-select" id="dsDpi" onchange="dsPreviewDebounce()">
                                <option value="8dpmm">8 dpmm</option>
                                <option value="12dpmm">12 dpmm</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Width (in)</label>
                            <input class="form-input" id="dsWidth" type="number" value="4" min="1" max="12" step="0.5" oninput="dsPreviewDebounce()">
                        </div>
                        <div>
                            <label class="form-label">Height (in)</label>
                            <input class="form-input" id="dsHeight" type="number" value="3" min="1" max="12" step="0.5" oninput="dsPreviewDebounce()">
                        </div>
                    </div>

                    <!-- Sub-tabs: Label Preview | QR Data | ZPL Code -->
                    <div class="sub-tabs" id="dsPrevTabs">
                        <div class="sub-tab active" onclick="switchDsTab('preview', this)">Label Preview</div>
                        <div class="sub-tab" onclick="switchDsTab('qrdata', this)">QR Data</div>
                        <div class="sub-tab" onclick="switchDsTab('zpl', this)">ZPL Code</div>
                    </div>

                    <div id="ds-sub-preview">
                        <div style="background:#f8f9fc;border:1px solid var(--border);border-radius:10px;min-height:240px;display:flex;align-items:center;justify-content:center;padding:16px">
                            <div id="dsPreviewImgWrap">
                                <div style="color:var(--t3);font-size:13px;text-align:center">⏳ Loading…</div>
                            </div>
                        </div>
                    </div>
                    <div id="ds-sub-qrdata" style="display:none">
                        <div class="code-box" id="dsQrDataBox"></div>
                    </div>
                    <div id="ds-sub-zpl" style="display:none">
                        <div class="code-box" id="dsZplBox"></div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: ข้อมูล Label | ข้อมูล QR | ปรับ Layout -->
            <div class="card">
                <div class="card-body" style="padding:16px">
                    <div class="sub-tabs" id="dsRightTabs">
                        <div class="sub-tab active" onclick="switchDsRight('qr', this)">🔲 QR Data</div>
                        <div class="sub-tab" onclick="switchDsRight('label', this)">✏️ Label Data</div>
                        <div class="sub-tab" onclick="switchDsRight('layout', this)">⚙️ Layout Settings</div>
                    </div>

                    <!-- Tab: ข้อมูล QR -->
                    <div id="dsr-qr" style="overflow-y:auto;max-height:520px">
                        
                        <div id="dsQrFieldList" style="display:flex;flex-direction:column;gap:2px"></div>
                    </div>

                    <!-- Tab: ข้อมูล Label -->
                    <div id="dsr-label" style="display:none;overflow-y:auto;max-height:520px">
                        <div id="dsFieldList" style="display:flex;flex-direction:column;gap:2px"></div>
                    </div>

                    <!-- Tab: ปรับ Layout -->
                    <div id="dsr-layout" style="display:none;overflow-y:auto;max-height:520px">
                        <!-- QR Component -->
                        <div style="font-size:12px;font-weight:700;color:var(--amber);margin:10px 0 8px;display:flex;align-items:center;gap:5px">
                            <span>⊞</span> QR Component
                        </div>
                        <div class="slider-row">
                            <label class="form-label">X</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slQrX" min="0" max="600" value="30" oninput="syncSlider('slQrX','vQrX');dsPreviewDebounce()">
                                <input type="number" id="vQrX" class="slider-val-input" value="30" onchange="syncInputToSlider('vQrX','slQrX');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vQrX','slQrX');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label">Y</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slQrY" min="0" max="600" value="40" oninput="syncSlider('slQrY','vQrY');dsPreviewDebounce()">
                                <input type="number" id="vQrY" class="slider-val-input" value="40" onchange="syncInputToSlider('vQrY','slQrY');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vQrY','slQrY');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label">QR Size</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slQrSize" min="2" max="15" value="5" oninput="syncSlider('slQrSize','vQrSize');dsPreviewDebounce()">
                                <input type="number" id="vQrSize" class="slider-val-input" value="5" onchange="syncInputToSlider('vQrSize','slQrSize');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vQrSize','slQrSize');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <!-- Data Component -->
                        <div style="font-size:12px;font-weight:700;color:var(--green);margin:14px 0 8px;display:flex;align-items:center;gap:5px">
                            <span>≡</span> Data Component
                        </div>
                        <div class="slider-row">
                            <label class="form-label">X</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slDataX" min="0" max="800" value="373" oninput="syncSlider('slDataX','vDataX');dsPreviewDebounce()">
                                <input type="number" id="vDataX" class="slider-val-input" value="373" onchange="syncInputToSlider('vDataX','slDataX');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vDataX','slDataX');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label">Y</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slDataY" min="0" max="600" value="58" oninput="syncSlider('slDataY','vDataY');dsPreviewDebounce()">
                                <input type="number" id="vDataY" class="slider-val-input" value="58" onchange="syncInputToSlider('vDataY','slDataY');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vDataY','slDataY');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label">Font Size</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slFontSize" min="10" max="60" value="22" oninput="syncSlider('slFontSize','vFontSize');dsPreviewDebounce()">
                                <input type="number" id="vFontSize" class="slider-val-input" value="22" onchange="syncInputToSlider('vFontSize','slFontSize');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vFontSize','slFontSize');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label"><i class="bi bi-arrow-down-up me-1"></i>Line Height</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slLineHeight" min="10" max="80" value="33" oninput="syncSlider('slLineHeight','vLineHeight');dsPreviewDebounce()">
                                <input type="number" id="vLineHeight" class="slider-val-input" value="33" onchange="syncInputToSlider('vLineHeight','slLineHeight');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vLineHeight','slLineHeight');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label"><i class="bi bi-arrow-left-right me-1"></i>Val Offset</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slValOffset" min="0" max="400" value="151" oninput="syncSlider('slValOffset','vValOffset');dsPreviewDebounce()">
                                <input type="number" id="vValOffset" class="slider-val-input" value="151" onchange="syncInputToSlider('vValOffset','slValOffset');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vValOffset','slValOffset');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <!-- Print Origin (collapsible) -->
                        <div style="border-top:1px solid var(--border);margin:8px 0 6px;padding-top:8px">
                            <div onclick="this.nextElementSibling.style.display=this.nextElementSibling.style.display==='none'?'block':'none'; this.querySelector('.po-arrow').style.transform=this.nextElementSibling.style.display==='none'?'rotate(0deg)':'rotate(180deg)'"
                                style="font-size:11px;font-weight:700;color:var(--t2);letter-spacing:.04em;text-transform:uppercase;cursor:pointer;display:flex;align-items:center;justify-content:space-between;user-select:none">
                                🖨 Printer Offset (^LH)
                                <span class="po-arrow" style="transition:transform .2s;display:inline-block">▾</span>
                            </div>
                            <div style="display:none;margin-top:6px">
                                <div class="slider-row">
                                    <label class="form-label">Offset X</label>
                                    <div style="display:flex;align-items:center;gap:6px">
                                        <input type="range" id="slPrintOffX" min="0" max="400" value="100" oninput="syncSlider('slPrintOffX','vPrintOffX')">
                                        <input type="number" id="vPrintOffX" class="slider-val-input" value="100" onchange="syncInputToSlider('vPrintOffX','slPrintOffX')" onkeydown="if(event.key==='Enter'){syncInputToSlider('vPrintOffX','slPrintOffX');this.blur()}">
                                    </div>
                                </div>
                                <div class="slider-row">
                                    <label class="form-label">Offset Y</label>
                                    <div style="display:flex;align-items:center;gap:6px">
                                        <input type="range" id="slPrintOffY" min="0" max="200" value="0" oninput="syncSlider('slPrintOffY','vPrintOffY')">
                                        <input type="number" id="vPrintOffY" class="slider-val-input" value="0" onchange="syncInputToSlider('vPrintOffY','slPrintOffY')" onkeydown="if(event.key==='Enter'){syncInputToSlider('vPrintOffY','slPrintOffY');this.blur()}">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ══════ TAB: HISTORY ══════ -->
<div class="tab-pane" id="tab-history">
    <div class="card">
        <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
            <div style="font-size:13px;font-weight:700;color:var(--navy);display:flex;align-items:center;gap:8px">
                <i class="bi bi-clock-history" style="color:var(--blue)"></i>
                Print History
                <span id="histCountBadge" class="count-badge"></span>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input id="histSearchLot" class="filter-input" placeholder="Lot No." style="width:140px"
                       onkeydown="if(event.key==='Enter') loadHistory(1)">
                <input id="histSearchUser" class="filter-input" placeholder="User" style="width:120px"
                       onkeydown="if(event.key==='Enter') loadHistory(1)">
                <select id="histFilterSuccess" class="filter-select">
                    <option value="">All</option>
                    <option value="true">Success</option>
                    <option value="false">Failed</option>
                </select>
                <select id="histFilterReprint" class="filter-select">
                    <option value="">All Types</option>
                    <option value="false">Print</option>
                    <option value="true">Re-Print</option>
                </select>
                <button class="btn-search" onclick="loadHistory(1)">Search</button>
                <button class="btn-reset"  onclick="histReset()">Reset</button>
            </div>
        </div>
        <div style="overflow-x:auto">
            <table class="hist-table">
                <thead>
                    <tr>
                        <th>Lot No.</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Printer IP</th>
                        <th>User</th>
                        <th>Reprint Reason</th>
                        <th>Error</th>
                        <th>Printed At</th>
                    </tr>
                </thead>
                <tbody id="histTable"></tbody>
            </table>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-top:1px solid var(--border);flex-wrap:wrap;gap:10px">
            <div style="display:flex;align-items:center;gap:10px">
                <select class="pag-size" id="histPageSize" onchange="loadHistory(1)">
                    <option value="20" selected>20 rows</option>
                    <option value="50">50 rows</option>
                    <option value="100">100 rows</option>
                </select>
                <span class="pag-info" id="histPageInfo"></span>
            </div>
            <div class="pag-btns">
                <button id="histBtnPrev" class="pag-btn" onclick="histPrevPage()">← Prev</button>
                <span class="pag-page"  id="histPageNum">—</span>
                <button id="histBtnNext" class="pag-btn" onclick="histNextPage()">Next →</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="/lib/html5-qrcode/html5-qrcode.min.js"></script>
<script src="/js/api.js"></script>
<script>
    let currentStep = 1
    let qrScanner   = null
    let scannerRunning = false

    // ── 13 Fixed Field Schema ──
    const FIELD_LABELS = {
        partNo:          'P/N',
        quantity:        'QTY',
        unit:            'UNIT',
        vendor:          'VENDOR',
        dateCode:        'D/C',
        tradingCode:     'T/C',
        po:              'PO',
        inventoryNo:     'I/N',
        traceId:         'TRACE ID',
        workOrder:       'W/O',
        line:            'LINE',
        lotNo:           'LOT NO',
        productionArea:  'PROD AREA',
        createdAt:       'CREATED AT',
    }
    const ALL_FIELD_KEYS    = Object.keys(FIELD_LABELS)
    const FIELD_PLACEHOLDERS = {
        tradingCode:  'Trading Code',
        dateCode:     'Date Code',
        inventoryNo:  'Inventory Number',
    }
    const REQUIRED_KEYS     = new Set(['partNo','quantity','unit','vendor','dateCode','tradingCode','po','inventoryNo','traceId','workOrder','line'])
    const QR_REQUIRED_KEYS  = new Set(['lotNo'])
    function applyPrintOffset(zpl, cfg) {
        const x = cfg?.printOffsetX ?? 100
        const y = cfg?.printOffsetY ?? 0
        if (!x && !y) return zpl
        return zpl.replace(/(\^XA\n?)/, `$1^LH${x},${y}\n`)
    }

    // ── State ──
    let printState = {
        scannedRaw:        '',
        parsedQrData:      {},
        selectedLayoutId:  null,
        activeLayoutFields: null,
        formOverrides:     {},
        layoutSliders:     null,
        previewZpl:        '',
        previewFullData:   null,
        previewImgSrc:     null,
    }

    let _woSearchTimer = null

    // ── Helpers ──
    const cid = k => k.replace(/[^a-zA-Z0-9]/g, '_')
    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    }

    // ISO Z → local display "YYYY-MM-DD HH:mm:ss"
    function fmtCreatedAt(isoZ) {
        if (!isoZ) return ''
        try {
            const d = new Date(isoZ)
            if (isNaN(d)) return isoZ
            const pad = n => String(n).padStart(2,'0')
            return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} ` +
                   `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`
        } catch (_) { return isoZ }
    }

    // Any createdAt string → ISO Z (for QR encoding)
    function toIsoZ(val) {
        if (!val) return new Date().toISOString()
        if (val.endsWith('Z') || val.includes('+')) return val  // already ISO
        try {
            // "YYYY-MM-DD HH:mm:ss" → parse as local → ISO Z
            const d = new Date(val.replace(' ', 'T'))
            return isNaN(d) ? new Date().toISOString() : d.toISOString()
        } catch (_) { return new Date().toISOString() }
    }

    // ── Toast ──
    function showToast(msg, type) {
        const tc = document.getElementById('toastContainer')
        const t  = document.createElement('div')
        t.className = `sf-toast sf-toast-${type || 'info'}`
        t.textContent = msg
        tc.appendChild(t)
        setTimeout(() => t.remove(), 3200)
    }

    // ── Map API response → 13-field schema ──
    function mapScanResponse(res) {
        return {
            partNo:          res.partNo          ?? '',
            quantity:        String(res.quantity  ?? ''),
            unit:            res.unit             ?? '',
            vendor:          res.vendor           ?? '',
            dateCode:        res.dateCode         ?? '',
            tradingCode:     res.tradingCode      ?? '',
            po:              res.po               ?? '',
            inventoryNo:     res.inventoryNo      ?? '',
            traceId:         res.wH_TraceId       || res.traceId || '',
            workOrder:       res.workOrder        ?? '',
            line:            res.line             ?? '',
            lotNo:           '',
            productionArea:  res.productionArea   ?? '',
            createdAt:       '',
        }
    }

    // ── Scan API ──
    async function callScanAPI(barcode, displayName) {
        setScanStatus('⏳ Checking...', '#1a6fff')
        try {
            const res = await api('/scan/scan', 'POST', { barcode, mode: 0 })
            printState.scannedRaw    = barcode
            printState.parsedQrData  = mapScanResponse(res)
            printState.formOverrides = {}
            await doScan(displayName)
        } catch (err) {
            setScanStatus('❌ ' + (err.message || 'An error occurred'), '#dc2626')
        }
    }

    function setScanStatus(msg, color) {
        const el = document.getElementById('scanStatus')
        el.textContent = msg
        el.style.color = color || 'var(--t2)'
    }

    // ── doScan: after scan success ──
    async function doScan(displayName) {
        await stopScan()
        setScanStatus('✓ Scan successful: ' + displayName, '#059669')
        const d = printState.parsedQrData
        // Banner: Part No. prominent + compact JSON below
        document.getElementById('qrPartNoLabel').textContent = d.partNo || '—'
        const display = Object.fromEntries(Object.entries(d).filter(([, v]) => v !== '' && v !== null && v !== undefined))
        document.getElementById('qrDataLabel').textContent = JSON.stringify(display)
        document.getElementById('fWO').value = d.workOrder || ''
        updateLineBadge(d.line || '')
        renderChecklist(printState.activeLayoutFields)
        goStep(2)
    }

    // ── Stepper ──
    function goStep(n) {
        currentStep = n
        ;[1,2,3].forEach(i => {
            const sc = document.getElementById('sc'+i)
            const sl = document.getElementById('sl'+i)
            sc.className = 'step-circle' + (i < n ? ' done' : i === n ? ' active' : '')
            sl.className = 'step-label'  + (i < n ? ' done' : i === n ? ' active' : '')
            if (i < 3) document.getElementById('line'+i).className = 'step-line' + (i < n ? ' done' : '')
            document.getElementById('step'+i).style.display = i === n ? '' : 'none'
        })
        if (n === 3) renderStep3()
    }

    // ── Camera Scan (html5-qrcode — รองรับ QR Code + Data Matrix + อื่นๆ) ──
    async function startScan() {
        if (scannerRunning) return
        setScanStatus('⏳ Opening camera...', 'var(--t2)')
        try {
            qrScanner = new Html5Qrcode('qrReader')
            await qrScanner.start(
                { facingMode: 'environment' },
                {
                    fps: 15,
                    qrbox: { width: 200, height: 200 },
                    aspectRatio: 1.0,
                },
                (decodedText) => {
                    callScanAPI(decodedText, 'Camera Scan')
                }
            )
            scannerRunning = true
            document.getElementById('scannerIdle').style.display  = 'none'
            document.getElementById('btnStartScan').style.display = 'none'
            document.getElementById('scannerBox').style.display   = ''
            document.getElementById('btnStopScan').style.display  = ''
            document.getElementById('scanLine').style.display     = ''
            setScanStatus('🎥 Scanning…', 'var(--blue)')
        } catch (e) {
            console.error('[startScan] error:', e)
            const msg = e?.message || e?.name || String(e) || 'unknown'
            setScanStatus('❌ [' + msg + ']', 'var(--red)')
        }
    }

    async function stopScan() {
        if (scannerRunning && qrScanner) {
            try { await qrScanner.stop(); qrScanner.clear() } catch (_) {}
        }
        scannerRunning = false
        qrScanner = null
        document.getElementById('scannerBox').style.display   = 'none'
        document.getElementById('scannerIdle').style.display  = ''
        document.getElementById('btnStartScan').style.display = ''
        document.getElementById('btnStopScan').style.display  = 'none'
        document.getElementById('scanLine').style.display     = 'none'
        setScanStatus('', '')
    }

    // ── Toggle manual input ──
    function toggleManualInput() {
        const area  = document.getElementById('manualInputArea')
        const label = document.getElementById('manualLabel')
        const show  = area.style.display === 'none'
        area.style.display = show ? '' : 'none'
        label.textContent  = show ? 'Close ↑' : 'Enter Barcode Manually ↓'
    }

    // ── Manual barcode/JSON input ──
    function submitBarcode() {
        const raw = document.getElementById('jsonInput').value.trim()
        if (!raw) { showToast('Please enter a barcode or JSON first', 'error'); return }
        callScanAPI(raw, 'Manual Input')
    }


    // ──────────────────────────────────────────────────
    // STEP 2 — WorkOrder Autocomplete (GET /workorder)
    // ──────────────────────────────────────────────────

    function onWoInput() {
        const q = document.getElementById('fWO').value.trim()
        const list = document.getElementById('woDropdown')
        if (!q) { list.style.display = 'none'; return }
        clearTimeout(_woSearchTimer)
        _woSearchTimer = setTimeout(() => fetchWoList(q), 280)
    }

    async function fetchWoList(q) {
        const list = document.getElementById('woDropdown')
        list.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">⏳ Searching…</div>'
        list.style.display = ''
        try {
            const res = await api(`/workorder?moNumber=${encodeURIComponent(q)}&page=1&pageSize=20&sortBy=LastSyncedAt&desc=true`, 'GET')
            const arr = res?.data ?? []
            if (arr.length === 0) {
                list.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">No Work Order found</div>'
                return
            }
            list.innerHTML = arr.map(x =>
                `<div class="wo-item" onmousedown="selectWo('${escHtml(x.moNumber)}','${escHtml(x.lineName ?? '')}')">
                    <span style="font-weight:700">${escHtml(x.moNumber)}</span>
                    <span class="wo-item-line">${escHtml(x.lineName ?? '—')} · ${escHtml(x.modelName ?? '')}</span>
                </div>`
            ).join('')
        } catch (_) {
            list.innerHTML = '<div class="wo-item" style="color:var(--red);cursor:default">Load failed</div>'
        }
    }

    function hideWoDropdown() {
        document.getElementById('woDropdown').style.display = 'none'
    }

    function updateLineBadge(line) {
        const badge = document.getElementById('lineBadge')
        document.getElementById('fLine').value = line
        if (!badge) return
        badge.textContent         = line || '—'
        badge.style.color         = line ? 'var(--blue)'   : 'var(--t3)'
        badge.style.background    = line ? 'var(--blue-lt)': '#f0f2f5'
        badge.style.borderColor   = line ? 'var(--blue)'   : 'var(--border)'
    }

    function goToDesignLayout(layoutId) {
        const designPill = document.querySelectorAll('.tab-pill')[2]
        switchTab('design', designPill)
        const id = layoutId || document.getElementById('fLayout')?.value
        if (id) {
            openEditMode(id)
        } else {
            showListMode()
        }
    }

    function toggleLabelSize() {
        const sec = document.getElementById('labelSizeSection')
        const chv = document.getElementById('labelSizeChevron')
        const show = sec.style.display === 'none'
        sec.style.display = show ? '' : 'none'
        chv.style.transform = show ? 'rotate(180deg)' : ''
    }

    function selectWo(mo, line) {
        document.getElementById('fWO').value = mo
        updateLineBadge(line)
        document.getElementById('woDropdown').style.display = 'none'
        printState.formOverrides.workOrder = mo
        printState.formOverrides.line      = line
        const woIn   = document.getElementById(`fci_val_${cid('workOrder')}`)
        const lineIn = document.getElementById(`fci_val_${cid('line')}`)
        if (woIn)   woIn.value   = mo
        if (lineIn) lineIn.value = line
    }

    // ──────────────────────────────────────────────────
    // STEP 2 — Layout Selector
    // ──────────────────────────────────────────────────

    async function loadLayoutsIntoSelect() {
        const sel    = document.getElementById('fLayout')
        const rpSel  = document.getElementById('rpLayout')
        const rprSel = document.getElementById('rprLayout')
        const asmSel = document.getElementById('asmLayout')
        // Save current selections before rebuilding
        const prev = {
            fLayout:   sel?.value    || '',
            rpLayout:  rpSel?.value  || '',
            rprLayout: rprSel?.value || '',
            asmLayout: asmSel?.value || '',
        }
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const arr = Array.isArray(layouts) ? layouts : (layouts?.data || [])
            const opts = '<option value="">-- Select Layout --</option>' +
                arr.map(l => `<option value="${l.id}">${escHtml(l.templateName ?? 'Untitled')}</option>`).join('')
            if (sel)    { sel.innerHTML = opts;    sel._layoutsData = arr;    if (prev.fLayout)   sel.value    = prev.fLayout   }
            if (rpSel)  { rpSel.innerHTML = opts;  rpSel._layoutsData = arr;  if (prev.rpLayout)  rpSel.value  = prev.rpLayout  }
            if (rprSel) { rprSel.innerHTML = opts; rprSel._layoutsData = arr; if (prev.rprLayout) rprSel.value = prev.rprLayout }
            if (asmSel) { asmSel.innerHTML = opts; asmSel._layoutsData = arr; if (prev.asmLayout) asmSel.value = prev.asmLayout }
        } catch (_) {
            const err = '<option value="">-- (Unable to load Layouts) --</option>'
            if (sel)    sel.innerHTML = err
            if (rpSel)  rpSel.innerHTML = err
            if (rprSel) rprSel.innerHTML = err
            if (asmSel) asmSel.innerHTML = err
        }
    }

    function applyLayoutToSliders(layout) {
        const c = parseZplDataJson(layout)
        printState.layoutSliders = {
            qrX:       c.qrX       ?? 30,
            qrY:       c.qrY       ?? 40,
            qrSize:    c.qrSize    ?? 5,
            dataX:     c.dataX     ?? 373,
            dataY:     c.dataY     ?? 58,
            fontSize:  c.fontSize  ?? 22,
            valOffset: c.valOffset ?? 151,
        }
        printState.layoutQrFields = c.qrFields ?? null
        if (c.dpi)    document.getElementById('fDpi').value    = c.dpi.includes('12') ? '300' : '203'
        if (c.width)  document.getElementById('fWidth').value  = c.width
        if (c.height) document.getElementById('fHeight').value = c.height
    }

    function onLayoutChange() {
        const sel = document.getElementById('fLayout')
        const id  = sel.value
        if (!id) {
            printState.selectedLayoutId    = null
            printState.activeLayoutFields  = null
            printState.layoutSliders       = null
            renderChecklist(null)
            return
        }
        const layouts = sel._layoutsData || []
        const layout  = layouts.find(l => String(l.id) === String(id))
        if (!layout) return
        printState.selectedLayoutId   = layout.id
        applyLayoutToSliders(layout)
        const fields = parseLayoutFields(layout)
        printState.activeLayoutFields = fields
        renderChecklist(fields)
    }

    // ──────────────────────────────────────────────────
    // STEP 2 — Field Checklist
    // ──────────────────────────────────────────────────

    function renderChecklist(layoutFields) {
        const container = document.getElementById('step2Checklist')
        if (!container) return
        const d = printState.parsedQrData || {}
        container.innerHTML = ALL_FIELD_KEYS.map(k => {
            const lf      = layoutFields?.find(f => f.key === k)
            const label   = lf?.label ?? FIELD_LABELS[k]
            const checked = layoutFields ? (lf?.show ?? false) : false
            const rawVal  = printState.formOverrides[k] ?? d[k] ?? ''
            // createdAt: always show as human-readable in the input
            const value   = k === 'createdAt' ? fmtCreatedAt(rawVal) : rawVal
            const isReq     = REQUIRED_KEYS.has(k)
            const isAutoGen = k === 'lotNo' || k === 'createdAt'
            return `<div class="field-item" id="fci_row_${cid(k)}" onclick="toggleFci('${k}')">
                <input type="checkbox" id="fci_chk_${cid(k)}" ${checked ? 'checked' : ''}
                    onclick="event.stopPropagation()" onchange="updateFciRow('${k}')">
                <span class="field-name">${escHtml(label)}</span>
                ${isReq ? '<span class="req-star">*</span>' : ''}
                <span class="field-token">{${k}}</span>
                <input type="text" class="field-val-input" id="fci_val_${cid(k)}"
                    value="${escHtml(String(value))}"
                    placeholder="${isAutoGen ? '(auto-generate)' : isReq ? 'required' : ''}"
                    ${isAutoGen ? 'readonly style="margin-left:auto;width:130px;padding:4px 8px;font-size:12px;font-family:inherit;border:1.5px solid var(--border);border-radius:6px;color:var(--t2);background:#f8f9fc;cursor:default"' : ''}
                    onclick="event.stopPropagation()"
                    ${isAutoGen ? '' : 'onfocus="this.style.borderColor=\'var(--blue)\'" onblur="this.style.borderColor=\'var(--border)\'"'}
                    >
            </div>`
        }).join('')
        ALL_FIELD_KEYS.forEach(k => updateFciRow(k))
    }

    function toggleFci(k) {
        const cb = document.getElementById(`fci_chk_${cid(k)}`)
        if (cb) { cb.checked = !cb.checked; updateFciRow(k) }
    }

    function updateFciRow(k) {
        const row = document.getElementById(`fci_row_${cid(k)}`)
        const cb  = document.getElementById(`fci_chk_${cid(k)}`)
        if (!row || !cb) return
        row.style.borderColor = cb.checked ? 'var(--blue)' : 'var(--border)'
        row.style.background  = cb.checked ? 'var(--blue-lt)' : ''
    }

    function getCheckedFields() {
        return ALL_FIELD_KEYS
            .filter(k => document.getElementById(`fci_chk_${cid(k)}`)?.checked)
            .map(k => {
                const label = document.getElementById(`fci_row_${cid(k)}`)?.querySelector('.field-name')?.textContent
                    ?? FIELD_LABELS[k]
                const value = document.getElementById(`fci_val_${cid(k)}`)?.value ?? ''
                return { label, value }
            })
    }

    // ──────────────────────────────────────────────────
    // STEP 2 → STEP 3: doPreview
    // ──────────────────────────────────────────────────

    function genUlid() {
        const B32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ'
        let n = Date.now(), ts = ''
        for (let i = 9; i >= 0; i--) { ts = B32[n % 32] + ts; n = Math.floor(n / 32) }
        let rand = ''
        for (let i = 0; i < 16; i++) rand += B32[Math.floor(Math.random() * 32)]
        return ts + rand
    }

    async function doPreview() {
        // Validate required
        for (const k of REQUIRED_KEYS) {
            const val = (document.getElementById(`fci_val_${cid(k)}`)?.value ?? '').trim()
            if (!val) {
                showToast(`Please fill in ${FIELD_LABELS[k]}`, 'error')
                document.getElementById(`fci_val_${cid(k)}`)?.focus()
                return
            }
        }

        // Build fullData from form inputs
        const fullData = { ...printState.parsedQrData }
        ALL_FIELD_KEYS.forEach(k => {
            const el = document.getElementById(`fci_val_${cid(k)}`)
            if (el) fullData[k] = el.value
        })

        // Fetch new traceId from API — leave null if fails, backend will handle it
        try {
            const trRes = await api('/printer/new-traceId', 'GET')
            fullData.lotNo = trRes?.traceId ?? trRes?.id ?? trRes ?? null
        } catch (_) {
            fullData.lotNo = null
        }
        fullData.createdAt = fullData.lotNo ? new Date().toISOString() : null

        // createdAt must always be ISO Z in fullData (for QR encoding)
        fullData.createdAt = toIsoZ(fullData.createdAt)

        // Sync auto-gen back to inputs:
        // - lotNo: as-is
        // - createdAt: show display format in input (label will read this)
        const intEl = document.getElementById(`fci_val_${cid('lotNo')}`)
        if (intEl && !intEl.value) intEl.value = fullData.lotNo
        const caEl = document.getElementById(`fci_val_${cid('createdAt')}`)
        if (caEl) caEl.value = fmtCreatedAt(fullData.createdAt)

        // Layout params
        const sliders = printState.layoutSliders ?? { qrX:30,qrY:40,qrSize:5,dataX:373,dataY:58,fontSize:22,valOffset:151 }
        const dpiVal  = document.getElementById('fDpi').value
        const dpiStr  = dpiVal === '300' ? '12dpmm' : '8dpmm'
        const width   = +document.getElementById('fWidth').value  || 4
        const height  = +document.getElementById('fHeight').value || 3

        // Build ZPL
        const checkedFields = getCheckedFields()
        const zpl = buildZpl({ qrContent: buildQrContent(fullData, printState.layoutQrFields), textFields: checkedFields, ...sliders })

        printState.previewZpl      = zpl
        printState.previewFullData = fullData
        printState.previewImgSrc   = null

        // Call preview API (returns PNG blob)
        try {
            printState.previewImgSrc = await callZplPreview(zpl, dpiStr, width, height)
        } catch (_) {}

        goStep(3)
    }

