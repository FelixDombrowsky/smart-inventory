.lsb-q-rank { width: 28px; height: 28px; border-radius: 50%; font-weight: 600; background: var(--card); border: 1px solid var(--border); }
.lsb-q-row.lsb-q-called .lsb-q-rank, .lsb-q-row.lsb-q-late .lsb-q-rank, .lsb-q-row.lsb-q-flag .lsb-q-rank { border-color: transparent; }
