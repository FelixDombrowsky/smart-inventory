    // STEP 3 — Render Preview
    // ──────────────────────────────────────────────────

    function switchS3Right(name, el) {
        ['data','layout'].forEach(k =>
            document.getElementById('s3r-'+k).style.display = k === name ? '' : 'none')
        document.getElementById('s3RightTabs').querySelectorAll('.sub-tab')
            .forEach(t => t.classList.remove('active'))
        el.classList.add('active')
    }

    function syncS3Slider(id, vid) {
        document.getElementById(vid).value = document.getElementById(id).value
    }

    function initS3Sliders() {
        const s = printState.layoutSliders ?? { qrX:30,qrY:40,qrSize:5,dataX:373,dataY:58,fontSize:22,valOffset:151 }
        const dpiVal = document.getElementById('fDpi').value
        document.getElementById('s3Dpi').value    = dpiVal === '300' ? '12dpmm' : '8dpmm'
        document.getElementById('s3Width').value  = document.getElementById('fWidth').value  || 4
        document.getElementById('s3Height').value = document.getElementById('fHeight').value || 3
        const pairs = [['s3SlQrX','s3vQrX',s.qrX],['s3SlQrY','s3vQrY',s.qrY],['s3SlQrSize','s3vQrSize',s.qrSize],
                       ['s3SlDataX','s3vDataX',s.dataX],['s3SlDataY','s3vDataY',s.dataY],
                       ['s3SlFontSize','s3vFontSize',s.fontSize],['s3SlValOffset','s3vValOffset',s.valOffset]]
        pairs.forEach(([sid, vid, val]) => {
            const el = document.getElementById(sid); if (el) el.value = val
            const ve = document.getElementById(vid);  if (ve) ve.value = val
        })
    }

    async function s3RePreview() {
        const sliders = {
            qrX:       +document.getElementById('s3SlQrX').value,
            qrY:       +document.getElementById('s3SlQrY').value,
            qrSize:    +document.getElementById('s3SlQrSize').value,
            dataX:     +document.getElementById('s3SlDataX').value,
            dataY:     +document.getElementById('s3SlDataY').value,
            fontSize:  +document.getElementById('s3SlFontSize').value,
            valOffset: +document.getElementById('s3SlValOffset').value,
        }
        const dpi    = document.getElementById('s3Dpi').value
        const width  = +document.getElementById('s3Width').value  || 4
        const height = +document.getElementById('s3Height').value || 3

        // Fetch new traceId
        const fullData = { ...(printState.previewFullData || {}) }
        try {
            const trRes = await api('/printer/new-traceId', 'GET')
            fullData.lotNo = trRes?.traceId ?? trRes?.id ?? trRes ?? null
        } catch (_) {
            fullData.lotNo = null
        }
        printState.previewFullData = fullData

        // Sync display values back to checklist inputs
        const intEl = document.getElementById(`fci_val_${cid('lotNo')}`)
        if (intEl) intEl.value = fullData.lotNo ?? ''

        const zpl = buildZpl({
            qrContent:  buildQrContent(fullData, printState.layoutQrFields),
            textFields: getCheckedFields(),
            ...sliders,
        })
        printState.previewZpl    = zpl
        printState.layoutSliders = sliders
        document.getElementById('zplBox').textContent = zpl.replace(/(\^FDLA,).+?(\^FS)/s, '$1{QR_DATA}$2')
        // Re-preview image
        const wrap = document.getElementById('previewImgWrap')
        wrap.innerHTML = '<div style="color:var(--t2);font-size:13px;text-align:center">⏳ Rendering…</div>'
        try {
            const imgSrc = await callZplPreview(zpl, dpi, width, height)
            wrap.innerHTML = imgSrc
                ? `<img src="${escHtml(imgSrc)}" style="max-width:100%;max-height:300px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
                : '<div style="color:var(--amber);font-size:13px">⚠️ No image received</div>'
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
        // Switch back to label preview tab
        const firstTab = document.getElementById('s3SubTabs').querySelector('.sub-tab')
        switchS3Tab('labelPrev', firstTab)
    }

    function switchS3Tab(name, el) {
        ['labelPrev','qrData','zplCode'].forEach(k => {
            document.getElementById('s3-'+k).style.display = k === name ? '' : 'none'
        })
        document.getElementById('s3SubTabs').querySelectorAll('.sub-tab')
            .forEach(t => t.classList.remove('active'))
        el.classList.add('active')
    }

    function renderStep3() {
        loadPrinters(false)
        initS3Sliders()
        const d = printState.previewFullData || printState.parsedQrData || {}
        document.getElementById('qrDataLabel3').textContent = d.partNo || 'Data'
        document.getElementById('qrDataBox').textContent    = JSON.stringify(d, null, 2)
        // ZPL display: replace embedded JSON in ^FDLA,...^FS with {QR_DATA} placeholder
        const zplDisplay = (printState.previewZpl || '—').replace(/(\^FDLA,).+?(\^FS)/s, '$1{QR_DATA}$2')
        document.getElementById('zplBox').textContent = zplDisplay

        // Label Preview
        const wrap = document.getElementById('previewImgWrap')
        if (printState.previewImgSrc) {
            wrap.innerHTML =
                `<img src="${escHtml(printState.previewImgSrc)}"
                    style="max-width:100%;max-height:300px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
        } else {
            // Fallback: mock label from checked fields
            const checked = getCheckedFields()
            const rows = checked.map(f =>
                `<div class="label-mock-row">
                    <span class="label-mock-key">${escHtml(f.label)}:</span>
                    <span class="label-mock-val">${escHtml(f.value)}</span>
                </div>`
            ).join('')
            wrap.innerHTML = checked.length === 0
                ? '<div class="label-empty-hint">No fields selected</div>'
                : `<div class="label-mock">
                        <div class="label-mock-qr">QR</div>
                        <div class="label-mock-fields">${rows}</div>
                   </div>`
        }

        // Right panel: checked fields summary
        const list    = document.getElementById('s3FieldList')
        const checked = getCheckedFields()
        list.innerHTML = checked.length === 0
            ? '<div style="color:var(--t3);font-size:13px;text-align:center;padding:16px">No fields selected</div>'
            : checked.map(f =>
                `<div class="field-item" style="cursor:default;gap:8px">
                    <span class="field-name" style="min-width:70px">${escHtml(f.label)}</span>
                    <span style="flex:1;font-size:12px;font-weight:600;color:var(--navy);word-break:break-all">${escHtml(f.value) || '<span style="color:var(--t3)">—</span>'}</span>
                </div>`
            ).join('')
    }

    // ── Printer discovery ──
    async function loadPrinters(showFeedback) {
        const sel = document.getElementById('printerSelect')
        const prevVal = sel.value
        sel.innerHTML = '<option value="">⏳ Searching…</option>'
        try {
            const res = await api('/printer/discover', 'GET')
            const arr = Array.isArray(res) ? res : (res?.data ?? res?.printers ?? [])
            if (arr.length === 0) {
                sel.innerHTML = '<option value="">No printers found</option>' +
                    '<option value="__test__">🧪 test</option>'
                if (showFeedback) showToast('No printers found on network', 'error')
                return
            }
            sel.innerHTML = '<option value="">-- Select Printer --</option>' +
                arr.map(p => {
                    const id    = p.id ?? p.ip ?? p.name
                    const label = p.name
                        ? (p.ip ? `${p.name} (${p.ip})` : p.name)
                        : (p.ip ?? String(id))
                    return `<option value="${escHtml(String(id))}">${escHtml(label)}</option>`
                }).join('') +
                '<option value="__test__">🧪 test</option>'
            // Restore previous selection if still available
            if (prevVal && [...sel.options].some(o => o.value === prevVal)) sel.value = prevVal
            if (showFeedback) showToast(`Found ${arr.length} printer(s)`, 'success')
        } catch (err) {
            sel.innerHTML = '<option value="">Load failed</option>'
            if (showFeedback) showToast('Failed to load printers: ' + err.message, 'error')
        }
    }

    // ── Print ──
    function doPrint() {
        const sel = document.getElementById('printerSelect')
        if (!sel.value) { showToast('Please select a printer', 'error'); return }
        // Show printer name (option text) in modal
        const printerLabel = sel.options[sel.selectedIndex]?.text ?? sel.value
        document.getElementById('modalPrinterName').textContent = printerLabel
        document.getElementById('printModalOverlay').style.display = 'flex'
    }

    function closePrintModal() {
        document.getElementById('printModalOverlay').style.display = 'none'
    }

    function doPrintConfirm(mode) {
        closePrintModal()
        const sel     = document.getElementById('printerSelect')
        const payload = {
            mode,
            printer:   sel.value,
            zpl:       printState.previewZpl,
            labelData: printState.previewFullData,
        }
        console.log('[PrintQR] doPrintConfirm payload:', payload)
        showToast(mode === 'print-receive'
            ? `🖨️ Print & Receive → ${sel.value}`
            : `🖨️ Print Only → ${sel.value}`, 'info')
    }

    function buildQrContent(data, qrFields) {
        if (!qrFields || !qrFields.length) return JSON.stringify(data)
        const selectedKeys = qrFields.filter(f => f.inQr).map(f => f.key)
        const obj = {}
        selectedKeys.forEach(k => { if (data[k] !== undefined && data[k] !== null && data[k] !== '') obj[k] = data[k] })
        return JSON.stringify(obj)
    }

    // Parse the JSON blob stored in zplData field
    function parseZplDataJson(layout) {
        const raw = layout.zplData
        if (!raw) return {}
        try {
            const obj = JSON.parse(raw)
            if (obj && typeof obj === 'object' && !Array.isArray(obj)) {
                // Migrate stale saved label "PROD AREA" → "AREA"
                if (Array.isArray(obj.labelFields)) {
                    obj.labelFields.forEach(f => {
                        if (f.key === 'productionArea' && f.label === 'PROD AREA') f.label = 'AREA'
                    })
                }
                return obj
            }
        } catch (_) {}
        return { zplTemplate: raw }  // legacy: plain ZPL string
    }

    function parseLayoutFields(layout) {
        const config = parseZplDataJson(layout)
        const lf = config.labelFields
        if (!lf) return null
        try {
            if (Array.isArray(lf) && lf[0]?.key) return lf
            if (Array.isArray(lf)) return lf.map(k => ({ key:k, label:FIELD_LABELS[k]??k, show:true }))
        } catch (_) {}
        return null
    }

    // ── ZPL Builder ──
    // Estimate total QR dot size (data + 8-module quiet zone) for ECL M
    function estQrDots(content, scale) {
        const n = content.length
        const ver = n <= 25 ? 2 : n <= 50 ? 4 : n <= 100 ? 7 : n <= 200 ? 11 : n <= 350 ? 16 : 20
        return (ver * 4 + 17 + 8) * scale
    }

function buildZpl({ qrContent, textFields, qrX, qrY, qrSize, dataX, dataY, fontSize, valOffset, lineHeight, printOffsetX = 0 }) {
        const lineH  = lineHeight ?? Math.round(fontSize * 1.5)
        const pqrX   = qrX   + printOffsetX
        const pdataX = dataX + printOffsetX
        let zpl = `^XA\n^CI28\n`
        zpl += `^FO${pqrX},${qrY}^BQN,2,${qrSize}^FDMA,${qrContent}^FS\n`

        textFields.forEach(({ label, value }, i) => {
            const y = dataY + i * lineH
            zpl += `^FO${pdataX},${y}^A0N,${fontSize},${fontSize}^FD${label}:^FS\n`
            zpl += `^FO${pdataX + valOffset},${y}^A0N,${fontSize},${fontSize}^FD${value}^FS\n`
        })

        // ── Logo แถบล่าง (commented out — เปิดใช้ในอนาคตได้) ──
        // if (_logoZplData) {
        //     const lastTextY = dataY + textFields.length * lineH
        //     const ly = lastTextY + 8
        //     zpl += `^FO${dataX},${ly}${_logoZplData.cmd}^FS\n`
        // }

        zpl += `^XZ`
        return zpl
    }

    function buildZplTemplate(fields) {
        const qrX      = +document.getElementById('slQrX').value
        const qrY      = +document.getElementById('slQrY').value
        const qrSize   = +document.getElementById('slQrSize').value
        const dataX    = +document.getElementById('slDataX').value
        const dataY    = +document.getElementById('slDataY').value
        const fontSize = +document.getElementById('slFontSize').value
        const valOffset= +document.getElementById('slValOffset').value
        const lineH    = Math.round(fontSize * 1.5)
        let zpl = `^XA\n^CI28\n`
        zpl += `^FO${qrX},${qrY}^BQN,2,${qrSize}^FDMA,{qrContent}^FS\n`
        fields.filter(f => f.show).forEach(({ key, label }, i) => {
            const y = dataY + i * lineH
            zpl += `^FO${dataX},${y}^A0N,${fontSize},${fontSize}^FD${label}:^FS\n`
            zpl += `^FO${dataX + valOffset},${y}^A0N,${fontSize},${fontSize}^FD{${key}}^FS\n`
        })
        zpl += `^XZ`
        return zpl
    }

    // ── ZPL Preview — client-side renderer (ไม่ต้องเน็ต ไม่ผ่าน server) ──
    async function callZplPreview(zpl, dpi, width, height) {
        return await renderZplClient(zpl, dpi, width, height)
    }

    // ── Logo → ZPL ^GF encoder ───────────────────────────────────────────
    let _logoZplData = null

    async function initLogoZpl(logoSizeDots = 80) {
        try {
            const img = new Image()
            img.src = '/image/packaging_icon.png'
            await new Promise((res, rej) => { img.onload = res; img.onerror = () => rej(new Error('logo not found')) })

            const c = document.createElement('canvas')
            c.width = c.height = logoSizeDots
            const ctx = c.getContext('2d')
            ctx.fillStyle = '#fff'
            ctx.fillRect(0, 0, logoSizeDots, logoSizeDots)
            ctx.drawImage(img, 0, 0, logoSizeDots, logoSizeDots)

            const { data } = ctx.getImageData(0, 0, logoSizeDots, logoSizeDots)
            const bytesPerRow = Math.ceil(logoSizeDots / 8)
            let hex = ''

            for (let y = 0; y < logoSizeDots; y++) {
                for (let bx = 0; bx < bytesPerRow; bx++) {
                    let byte = 0
                    for (let bit = 0; bit < 8; bit++) {
                        const x = bx * 8 + bit
                        if (x < logoSizeDots) {
                            const i = (y * logoSizeDots + x) * 4
                            const gray      = data[i]*0.299 + data[i+1]*0.587 + data[i+2]*0.114
                            const alpha     = data[i+3] / 255
                            const effective = gray * alpha + 255 * (1 - alpha)
                            if (effective < 128) byte |= (1 << (7 - bit))
                        }
                    }
                    hex += byte.toString(16).padStart(2, '0').toUpperCase()
                }
            }

            const totalBytes = bytesPerRow * logoSizeDots
            _logoZplData = {
                cmd:  `^GFA,${totalBytes},${totalBytes},${bytesPerRow},${hex}`,
                size: logoSizeDots
            }
            console.log('[ZPL] Logo GF ready:', totalBytes, 'bytes')
        } catch (e) {
            console.warn('[ZPL] Logo init error:', e.message)
        }
    }

    // initLogoZpl(45)  // 45 dots ≈ 5.6mm ที่ 203dpi — พอดีแถบล่าง (commented out)

    // ── ZPL Client Renderer ───────────────────────────────────────────────
    const ZPL_DPI = { '6dpmm':152, '8dpmm':203, '12dpmm':300, '24dpmm':600 }

    // Preload ZebraFont ให้ browser และ Canvas รู้จักก่อน render
    const _zebraFontReady = document.fonts.load('bold 20px ZebraFont')

    async function renderZplClient(zpl, dpiStr, widthInch, heightInch) {
        await _zebraFontReady  // รอให้ font โหลดเสร็จก่อน
        const dpi = ZPL_DPI[dpiStr] || 203
        const cw  = Math.round((+widthInch  || 4) * dpi)
        const ch  = Math.round((+heightInch || 3) * dpi)

        const canvas = document.createElement('canvas')
        canvas.width  = cw
        canvas.height = ch
        const ctx = canvas.getContext('2d')
        ctx.fillStyle = '#fff'
        ctx.fillRect(0, 0, cw, ch)

        // ── Parse ZPL by splitting on '^' ──────────────────────────────
        // แต่ละ segment หลัง ^ คือ: 2 chars = command, ส่วนที่เหลือ = params/data
        // เช่น 'A0N,22,22' → cmd='A0', rest='N,22,22'
        //       'BQN,2,5'  → cmd='BQ', rest='N,2,5'
        //       'FDVENDOR:' → cmd='FD', rest='VENDOR:'
        const segs = zpl.split('^').slice(1)

        let fo           = { x:0, y:0 }
        let fontH        = 20
        let pendingBQ    = null
        let qrDrawBounds = null

        for (const seg of segs) {
            const cmd  = seg.slice(0, 2)
            const rest = seg.slice(2).replace(/[\r\n]+$/, '') // trim trailing newline

            switch (cmd) {
                case 'FO': {
                    const p = rest.split(',')
                    fo = { x: +p[0]||0, y: +p[1]||0 }
                    break
                }
                case 'A0': {
                    // rest = 'N,22,22' → strip orientation letter prefix
                    const p = rest.replace(/^[A-Z],/, '').split(',')
                    fontH = +p[0] || 20
                    break
                }
                case 'BQ': {
                    const p = rest.split(',')
                    pendingBQ = { mag: +p[2] || 3 }
                    break
                }
                case 'GF': {
                    // ^GFA,totalBytes,totalBytes,bytesPerRow,hexData
                    const parts = rest.split(',')
                    if (parts.length < 5) break
                    const bytesPerRow = parseInt(parts[3])
                    const hexStr = parts.slice(4).join('')
                    if (!bytesPerRow || !hexStr.trim()) break

                    const rows     = Math.floor(hexStr.length / (bytesPerRow * 2))
                    const imgWidth = bytesPerRow * 8
                    const imgData  = ctx.createImageData(imgWidth, rows)
                    const d = imgData.data

                    for (let r = 0; r < rows; r++) {
                        for (let b = 0; b < bytesPerRow; b++) {
                            const ho   = (r * bytesPerRow + b) * 2
                            const byte = parseInt(hexStr.slice(ho, ho + 2), 16)
                            for (let bit = 0; bit < 8; bit++) {
                                const dark  = (byte >> (7 - bit)) & 1
                                const pxOff = (r * imgWidth + b * 8 + bit) * 4
                                d[pxOff]     = dark ? 0   : 255
                                d[pxOff + 1] = dark ? 0   : 255
                                d[pxOff + 2] = dark ? 0   : 255
                                d[pxOff + 3] = dark ? 255 : 0    // white = transparent
                            }
                        }
                    }
                    ctx.putImageData(imgData, fo.x, fo.y)
                    break
                }
                case 'FD': {
                    if (pendingBQ) {
                        // ── QR Code — ใช้ server endpoint (ไม่ต้องเน็ต) ──
                        let data = rest
                        let ecl  = 'M' // default
                        // ^FDLA,{data} → L=ECL Low, M=Medium, Q=Quartile, H=High
                        const eclMatch = data.match(/^([LMQH])A,/)
                        if (eclMatch) { ecl = eclMatch[1]; data = data.slice(3) }
                        try {
                            const img = new Image()
                            img.src = `/api/qr/image?data=${encodeURIComponent(data)}&scale=${pendingBQ.mag}&ecl=M`
                            await new Promise((resolve, reject) => {
                                img.onload  = resolve
                                img.onerror = () => reject(new Error('QR image load failed'))
                            })
                            // QRCoder ใส่ quiet zone 4 modules ไว้ใน PNG เสมอ
                            // X: ลบ qz ออกทั้งหมด → ชิดขอบซ้าย
                            // Y: ลบ qz แต่คืน 2 modules → เว้นขอบบนนิดหน่อย
                            const qz  = 4 * pendingBQ.mag
                            const dx  = fo.x - qz
                            const dy  = fo.y - qz + pendingBQ.mag * 2
                            ctx.drawImage(img, dx, dy)
                            qrDrawBounds = { x: dx, y: dy, w: img.naturalWidth, h: img.naturalHeight, qz }
                        } catch (e) {
                            console.warn('[ZPL] QR error:', e.message)
                            ctx.strokeStyle = '#aaa'
                            ctx.lineWidth   = 2
                            ctx.strokeRect(fo.x, fo.y, 80, 80)
                            ctx.fillStyle = '#aaa'
                            ctx.font = '11px sans-serif'
                            ctx.fillText('QR', fo.x + 32, fo.y + 44)
                        }
                        pendingBQ = null
                    } else if (rest) {
                        // ── Text ──
                        ctx.fillStyle = '#000'
                        ctx.font = `bold ${fontH}px ZebraFont, "Arial Narrow", sans-serif`
                        ctx.fillText(rest, fo.x, fo.y + fontH * 0.85)
                    }
                    break
                }
            }
        }


        return canvas.toDataURL('image/png')
    }

    // ── Hardware Barcode Scanner (dedicated input — same approach as Receive page) ──
    let _rpHwScanActive = false, _rpHwAutoTimer = null

    function _rpHwScanSetBtns(active) {
        const ids = ['rpHwScanBtn', 'rprHwScanBtn', 'asmHwScanBtn']
        ids.forEach(id => {
            const b = document.getElementById(id)
            if (!b) return
            if (active) {
                b.style.background = '#dc2626'
                b.onmouseover = () => b.style.background = '#b91c1c'
                b.onmouseout  = () => b.style.background = '#dc2626'
            } else {
                b.style.background = '#6b7280'
                b.onmouseover = () => b.style.background = '#4b5563'
                b.onmouseout  = () => b.style.background = '#6b7280'
            }
        })
    }

    function rpToggleHwScan() {
        _rpHwScanActive = !_rpHwScanActive
        const section = document.getElementById('rpHwScanSection')
        if (_rpHwScanActive) {
            // Move section to after rp-card-head of the relevant item list card
            const tabId = document.querySelector('.tab-pane.active')?.id
            if (tabId === 'tab-reprint') {
                const anchor = document.getElementById('rprScanAnchor')
                if (anchor) anchor.appendChild(section)
            } else if (tabId === 'tab-assembly') {
                const head = document.getElementById('asmMaterialsList')?.closest('.rp-card')?.querySelector('.rp-card-head')
                if (head) head.after(section)
            } else {
                // Receive tab — insert after rp-card-head inside the item list card
                const head = document.getElementById('rpItemList')?.closest('.rp-card')?.querySelector('.rp-card-head')
                if (head) head.after(section)
            }
            section.style.display = ''
            _rpHwScanSetBtns(true)
            setTimeout(() => document.getElementById('rpHwScanInput').focus(), 80)
        } else {
            section.style.display = 'none'
            _rpHwScanSetBtns(false)
        }
    }

    function rpCloseHwScan() {
        if (!_rpHwScanActive) return
        _rpHwScanActive = false
        const section = document.getElementById('rpHwScanSection')
        if (section) section.style.display = 'none'
        _rpHwScanSetBtns(false)
    }

    function onRpHwScanKey(e) {
        if (e.key === 'Enter') {
            e.preventDefault()
            clearTimeout(_rpHwAutoTimer)
            const input = document.getElementById('rpHwScanInput')
            const code  = input.value.trim()
            input.value = ''
            if (code.length > 0) {
                onScannerInput(code).then(() => {
                    if (_rpHwScanActive) setTimeout(() => document.getElementById('rpHwScanInput').focus(), 100)
                })
            }
        }
    }

    function onRpHwScanInput() {
        clearTimeout(_rpHwAutoTimer)
        _rpHwAutoTimer = setTimeout(() => {
            const input = document.getElementById('rpHwScanInput')
            const code  = input.value.trim()
            if (code.length > 3) {
                input.value = ''
                onScannerInput(code).then(() => {
                    if (_rpHwScanActive) setTimeout(() => input.focus(), 100)
                })
            }
        }, 300)
    }

    function logScannerInput(code) {
        const tbody = document.getElementById('scannerLogBody')
        if (!tbody) return
        const now = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
        tbody.innerHTML = `
            <tr>
                <td style="padding:8px 14px;color:var(--t3);white-space:nowrap">${now}</td>
                <td style="padding:8px 14px;font-family:ui-monospace,monospace;word-break:break-all">${escHtml(code)}</td>
                <td style="padding:8px 14px;color:var(--t2)">${code.length} chars</td>
            </tr>`
    }

    async function onScannerInput(code) {
        logScannerInput(code)
        const isAssembly = document.getElementById('tab-assembly')?.classList.contains('active')
        const isReprint  = document.getElementById('tab-reprint')?.classList.contains('active')
        const statusEl = document.getElementById('rpHwScanStatus')
        if (statusEl) statusEl.textContent = '⏳ กำลังตรวจสอบ…'
        try {
            const res = await api('/scan', 'POST', { barcode: code, mode: 0 })
            if (isAssembly) {
                const lotNo = res.wH_TraceId || res.lotNo || res.traceId || code
                const ok = asmAddLot(lotNo, res.partNo || null)
                const filled = asmMaterials.filter(m => m.lotNo).length
                if (ok) showToast('✅ Lot added (' + filled + '/' + asmMaterials.length + ')', 'success')
            } else if (isReprint) {
                const lotNo = res.wH_TraceId || res.lotNo || res.traceId || code
                const ok = await rprAddFromScan(lotNo)
                if (ok) showToast('✅ LOT added (' + rprItems.length + '/10)', 'success')
            } else {
                const traceKey = code
                if (rpScannedTrace.has(traceKey)) {
                    showToast('⚠️ สแกนซ้ำ', 'error')
                } else {
                    const data = mapScanResponse(res)
                    data._barcode = traceKey
                    const ok = await rpAddItem(data)
                    if (ok) {
                        rpScannedTrace.add(traceKey)
                        showToast('✅ Added ' + (data.partNo || code) + ' (' + rpItems.length + '/10)', 'success')
                    }
                }
            }
        } catch (err) {
            if (isReprint) {
                const lotNo = rprExtractLotNoFromRaw(code)
                if (lotNo) {
                    try {
                        const ok = await rprFetchAndAddByLotNo(lotNo)
                        if (ok) showToast('✅ LOT added (' + rprItems.length + '/10)', 'success')
                        else showToast('⚠️ ไม่พบ LOT: ' + lotNo, 'error')
                    } catch (e2) {
                        showToast('❌ ' + (e2?.message || String(e2)), 'error')
                    }
                    return
                }
            }
            showToast('❌ ' + (err?.message || String(err)), 'error')
        } finally {
            if (statusEl) setTimeout(() => { statusEl.textContent = 'พร้อมสแกน…' }, 1500)
        }
    }

    // ── Printer dropdown (shared across Receive, Reprint, Assembly) ──
    const _RP_PD = [
        { ns: 'rp',        menuId: 'rpPrinterMenu',       hiddenId: 'rpPrinterSelect'       },
        { ns: 'rpReprint', menuId: 'rpReprintPrinterMenu', hiddenId: 'rpReprintPrinterSelect' },
        { ns: 'asm',       menuId: 'asmPrinterMenu',       hiddenId: 'asmPrinterSelect'      },
    ]

    function rpPrinterDdToggle(ns) {
        const menu    = document.getElementById(ns + 'PrinterMenu')
        const trigger = document.getElementById(ns + 'PrinterTrigger')
        if (!menu) return
        const opening = menu.style.display === 'none'
        rpPrinterDdCloseAll()
        if (opening) {
            menu.style.display = ''
            trigger?.classList.add('open')
        }
    }

    function rpPrinterDdCloseAll() {
        document.querySelectorAll('.rp-pd-menu').forEach(m => m.style.display = 'none')
        document.querySelectorAll('.rp-pd-trigger').forEach(t => t.classList.remove('open'))
    }

    document.addEventListener('click', e => {
        if (!e.target.closest('.rp-pd-wrap')) rpPrinterDdCloseAll()
    })

    function rpPrinterPickFromEl(el) {
        rpPrinterPick(el.dataset.ns, el.dataset.ip, el.dataset.name, el.dataset.online === 'true')
    }

    function rpPrinterPick(ns, ip, name, online) {
        const hidden = document.getElementById(ns + 'PrinterSelect')
        if (hidden) hidden.value = ip

        const dot = document.getElementById(ns + 'PrinterDot')
        if (dot) { dot.className = 'rp-pd-dot' + (online ? ' online' : ''); dot.style.display = '' }
        const nameEl = document.getElementById(ns + 'PrinterName')
        if (nameEl) { nameEl.textContent = name; nameEl.style.color = ''; nameEl.style.fontWeight = '600' }
        const ipEl = document.getElementById(ns + 'PrinterIp')
        if (ipEl) { ipEl.textContent = ip; ipEl.style.display = '' }

        document.getElementById(ns + 'PrinterMenu')?.querySelectorAll('.rp-pd-item').forEach(item => {
            const sel = item.dataset.ip === ip
            item.classList.toggle('active', sel)
            const chk = item.querySelector('.rp-pd-check')
            if (chk) chk.style.display = sel ? '' : 'none'
        })
        rpPrinterDdCloseAll()
        if (ns === 'rpReprint') rprSyncPrintBtn()
    }

    async function rpLoadPrinters() {
        _RP_PD.forEach(c => {
            const m = document.getElementById(c.menuId)
            if (m) m.innerHTML = '<div class="rp-pd-msg"><span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>Loading…</div>'
        })

        let allPrinters = []
        try {
            const res = await api('/printer/all', 'GET')
            allPrinters = Array.isArray(res) ? res : (res?.data ?? [])
        } catch (err) {
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (m) m.innerHTML = '<div class="rp-pd-msg" style="color:var(--red)">⚠️ Load failed</div>'
            })
            showToast('Failed to load printers: ' + err.message, 'error')
            return
        }

        if (allPrinters.length === 0) {
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (m) m.innerHTML = '<div class="rp-pd-msg">No printers found</div>'
            })
            return
        }

        const buildItems = (ns, onlineIps) =>
            allPrinters.filter(p => p.isActive !== false).map(p => {
                const online = onlineIps.has(p.printerIp)
                return `<div class="rp-pd-item"
                             data-ns="${escHtml(ns)}"
                             data-ip="${escHtml(p.printerIp)}"
                             data-name="${escHtml(p.printerName.replace(/[\r\n]+/g,' ').trim())}"
                             data-online="${online}"
                             onclick="rpPrinterPickFromEl(this)">
                    <span class="rp-pd-dot${online ? ' online' : ''}"></span>
                    <div class="rp-pd-info">
                        <span class="rp-pd-item-name">${escHtml(p.printerName.replace(/[\r\n]+/g,' ').trim())}</span>
                        <span class="rp-pd-item-ip">${escHtml(p.printerIp)}</span>
                    </div>
                    <i class="bi bi-check2 rp-pd-check" style="display:none"></i>
                </div>`
            }).join('')

        _RP_PD.forEach(c => {
            const m = document.getElementById(c.menuId)
            if (m) m.innerHTML = buildItems(c.ns, new Set())
        })

        try {
            const disc      = await api('/printer/discover', 'GET')
            const discArr   = Array.isArray(disc) ? disc : (disc?.data ?? disc?.printers ?? [])
            const onlineIps = new Set(discArr.map(p => p.printerIp || p.ip || '').filter(Boolean))
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (!m) return
                const prevIp = document.getElementById(c.hiddenId)?.value
                m.innerHTML = buildItems(c.ns, onlineIps)
                if (prevIp) {
                    m.querySelectorAll('.rp-pd-item').forEach(item => {
                        const sel = item.dataset.ip === prevIp
                        item.classList.toggle('active', sel)
                        const chk = item.querySelector('.rp-pd-check')
                        if (chk) chk.style.display = sel ? '' : 'none'
                    })
                    const dot = document.getElementById(c.ns + 'PrinterDot')
                    if (dot) dot.className = 'rp-pd-dot' + (onlineIps.has(prevIp) ? ' online' : '')
                }
            })
        } catch { /* keep without online indicator */ }
    }

    // ── Init ──
    renderChecklist(null)
    loadLayoutsIntoSelect()
    loadLayoutList()
    loadPrinters(false)
    rpLoadPrinters()
</script>
}

