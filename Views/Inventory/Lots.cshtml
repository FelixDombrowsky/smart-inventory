@{
    ViewData["Title"] = "Lots";
}

<div class="card">
    <div class="card-body">

        <h2 class="mb-4">Inventory Lots</h2>

        <!-- Filter Section -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <input id="filterPartNo" class="form-control" placeholder="PartNo"
                       onkeypress="if(event.key==='Enter') loadLots()">
            </div>
            <div class="col-md-3 col-sm-6">
                <input id="filterWO" class="form-control" placeholder="WorkOrder"
                       onkeypress="if(event.key==='Enter') loadLots()">
            </div>
            <div class="col-md-3 col-sm-6">
                <input id="filterLocation" class="form-control" placeholder="Location"
                       onkeypress="if(event.key==='Enter') loadLots()">
            </div>
            <div class="col-md-3 col-sm-6">
                <input id="filterLine" class="form-control" placeholder="Line"
                       onkeypress="if(event.key==='Enter') loadLots()">
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="filterAvailable">
                    <label class="form-check-label" for="filterAvailable">
                        Available Only
                    </label>
                </div>
            </div>

            <div class="col-md-2 col-sm-6">
                <button onclick="searchLots()" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th onclick="sort('LotNo')" style="cursor:pointer;">LotNo</th>
                        <th onclick="sort('PartNo')" style="cursor:pointer;">PartNo</th>
                        <th onclick="sort('WorkOrder')" style="cursor:pointer;">WorkOrder</th>
                        <th onclick="sort('ModelName')" style="cursor:pointer;">Model</th>
                        <th onclick="sort('LineName')" style="cursor:pointer;">Line</th>
                        <th onclick="sort('Location')" style="cursor:pointer;">Location</th>
                        <th onclick="sort('OnHandQty')" style="cursor:pointer;" class="text-end">OnHand</th>
                        <th onclick="sort('ReservedQty')" style="cursor:pointer;" class="text-end">Reserved</th>
                        <th onclick="sort('ConsumedQty')" style="cursor:pointer;" class="text-end">Consumed</th>
                        <th onclick="sort('Available')" style="cursor:pointer;" class="text-end">Available</th>
                        <th id="adjustBtn" class="text-center">Adjust</th>
                        <th id="voidBtn" class="text-center">Void</th>
                    </tr>
                </thead>
                <tbody id="lotTable"></tbody>
            </table>
        </div>

        <!-- Pagination & Page Size -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mt-4">
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 text-nowrap">Rows per page:</label>
                <select id="pageSize" class="form-select" style="width:100px" onchange="changePageSize()">
                    <option value="10">10</option>
                    <option value="20" selected>20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-secondary" onclick="prevPage()">
                    <i class="bi bi-chevron-left"></i> Prev
                </button>
                <span id="pageInfo" class="mx-3 fw-bold"></span>
                <button class="btn btn-secondary" onclick="nextPage()">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>

    </div>
</div>

@section Scripts {
   
    <script src="/js/api.js"></script>

    <script>

        //=================Script_Variables=================//       
        let page = 1;
        let totalPages = 1;
        let sortBy = "CreatedAt";
        let desc = true;
        //=================Script_Functions=================//
       
        async function loadLots() {

            const partNo = document.getElementById("filterPartNo").value.trim();
            const workOrder = document.getElementById("filterWO").value.trim();
            const location = document.getElementById("filterLocation").value.trim();
            const line = document.getElementById("filterLine").value.trim();
            const availableOnly = document.getElementById("filterAvailable").checked;
            const pageSize = parseInt(document.getElementById("pageSize").value);

            // 🔥 เปลี่ยนเป็น body
            const body = {
                partNo: partNo || null,
                workOrder: workOrder || null,
                location: location || null,
                line: line || null,
                availableOnly: availableOnly || null,
                page: page,
                pageSize: pageSize,
                sortBy: sortBy,
                desc: desc
            };

            try {

                const res = await api("/inventory/lots", "POST", body);

                if (!res.ok) throw new Error("API error");

                const json = await res.json();

                const list = json.data ?? json.Data ?? [];

                let html = "";

                list.forEach(x => {

                    const available = x.available ?? 0;

                    html += `
                    <tr>
                        <td><strong>${x.lotNo ?? ""}</strong></td>
                        <td>${x.partNo ?? ""}</td>
                        <td>${x.workOrder ?? ""}</td>
                        <td>${x.modelName ?? ""}</td>
                        <td>${x.lineName ?? ""}</td>
                        <td>${x.location ?? ""}</td>

                        <td class="text-end">${(x.onHandQty ?? 0).toLocaleString()}</td>
                        <td class="text-end">${(x.reservedQty ?? 0).toLocaleString()}</td>
                        <td class="text-end">${(x.consumedQty ?? 0).toLocaleString()}</td>

                        <td class="text-end fw-bold ${available < 50 ? 'text-danger' : 'text-success'}">
                            ${available.toLocaleString()}
                        </td>

                        <td class="text-center">
                            <button class="btn btn-warning btn-sm" 
                                onclick="adjustLot('${x.lotNo}', ${x.onHandQty ?? 0})">
                                Adjust
                            </button>
                        </td>

                        <td class="text-center">
                            <button class="btn btn-danger btn-sm" 
                                onclick="voidLot('${x.lotNo}')">
                                Void
                            </button>
                        </td>
                    </tr>`;
                });

                document.getElementById("lotTable").innerHTML =
                    html || `<tr><td colspan="12" class="text-center py-4 text-muted">No lots found</td></tr>`;

                // 🔥 pagination
                const total = json.total ?? json.Total ?? 0;
                totalPages = Math.ceil(total / pageSize);

                document.getElementById("pageInfo").innerText =
                    `Page ${json.page ?? json.Page} / ${totalPages}`;

            } catch (err) {
                console.error(err);

                document.getElementById("lotTable").innerHTML =
                    `<tr><td colspan="12" class="text-center text-danger">Load failed</td></tr>`;
            }
        }


        //=========================================
        function searchLots() {
        page = 1;
        loadLots();
        }
        function changePageSize() {
        page = 1;
        loadLots();
        }
        function sort(column) {
        if (sortBy === column) {
        desc = !desc;
        } else {
        sortBy = column;
        desc = true;
        }
        loadLots();
        }
        function applyRoleUI() {

        let user = JSON.parse(localStorage.getItem("user") || "{}");

        const allowedRoles = ["Admin", "Inventory_Admin", "Admin_WH", "Supervisor"];

        if (!allowedRoles.includes(user.role)) {

        document.getElementById("adjustBtn").style.display = "none";
        document.getElementById("voidBtn").style.display = "none";

        }
        }
        async function voidLot(lotNo) {
        let reason = prompt("กรุณาระบุเหตุผลในการ Void Lot:");
        if (!reason || reason.trim() === "") return;

        if (!confirm(`ยืนยันการ Void Lot ${lotNo} ?`)) return;

        try {
        let res = await api(`/inventory/void-lot/${lotNo}`, "POST", { reason: reason.trim() });

        if (res.ok) {
        alert("Void Lot สำเร็จ");
        loadLots();
        } else {
        alert(await res.text());
        }
        } catch (err) {
        alert("เกิดข้อผิดพลาด");
        }
        }

        async function adjustLot(lotNo, currentQty) {
        let qty = prompt(`ปรับจำนวนสำหรับ Lot: ${lotNo}\n\nจำนวนปัจจุบัน (OnHand) = ${currentQty}\n\nระบุจำนวนใหม่:`);

        if (qty === null) return;

        qty = parseFloat(qty);
        if (isNaN(qty)) {
        alert("กรุณาระบุตัวเลขที่ถูกต้อง");
        return;
        }

        if (!confirm(`ยืนยันการปรับจำนวน Lot ${lotNo} เป็น ${qty} ?`)) return;

        try {
        let res = await api("/inventory/adjust", "POST", {
        lotNo: lotNo,
        adjustQty: qty
        });

        if (res.ok) {
        alert("ปรับสต็อกสำเร็จ");
        loadLots();
        } else {
        alert(await res.text());
        }
        } catch (err) {
        alert("เกิดข้อผิดพลาด");
        }
        }

        function nextPage() {
        if (page < totalPages) {
        page++;
        loadLots();
        }
        }

        function prevPage() {
        if (page > 1) {
        page--;
        loadLots();
        }
        }
        ///=================Script_Run================////
        // โหลดข้อมูลเมื่อเปิดหน้า
        window.onload = loadLots;
        applyRoleUI()
    </script>
}