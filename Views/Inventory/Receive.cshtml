                currentWO = wo;
                document.getElementById("woSearch").value = wo;
            }

            const extras = {
                description:  document.getElementById("meDesc").value.trim(),
                vendor:       document.getElementById("meVendor").value.trim(),
                dateCode:     document.getElementById("meDc").value.trim(),
                tradingCode:  document.getElementById("meTc").value.trim(),
                po:           document.getElementById("mePo").value.trim(),
                inventoryNo:  document.getElementById("meIn").value.trim(),
