/* การ์ด line — มุมโค้ง 14, พื้นอ่อนตามสถานะ (ผสมกับพื้นการ์ด) ขอบบางลง */
.lsb-card-grid { grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: 12px; }
