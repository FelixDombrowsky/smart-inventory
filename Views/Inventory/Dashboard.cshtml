            <!-- ปุ่มมุมมองผัง (ภาพรวม / มุมบน / RE PR BR / ซูม / เต็มจอ) — ย้ายจากมุมซ้ายบนของผังมาอยู่แถวเดียวกับ > 1 day
                 (คลิกยังผ่าน data-act="view" ของ layout3d.js เหมือนเดิม) -->
            <div class="l3d-toolbar">
                <button data-act="view" data-view="all"><i class="bi bi-house"></i></button>
                <button data-act="view" data-view="top"><i class="bi bi-grid-3x3"></i></button>
                <span class="l3d-tb-sep"></span>
