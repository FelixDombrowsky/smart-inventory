                    <span id="bePartNoChip" style="font-family:ui-monospace,monospace;font-size:13px;font-weight:700;color:var(--blue);background:var(--blue-lt);padding:4px 12px;border-radius:20px;border:1.5px solid var(--blue)">—</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px">
                    <span style="font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.06em;white-space:nowrap">Output Qty</span>
                    <input id="beQty" class="modal-input" type="number" min="0" step="any"
