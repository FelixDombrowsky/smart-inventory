        </div>`
        dd.style.display = 'block'
        clearTimeout(_rpPnTimer)
        _rpPnTimer = setTimeout(async () => {
            try {
                const res = await api(`/master/items?search=${encodeURIComponent(q)}&page=1&pageSize=20`, 'GET')
                _rpPnResults = res.data || []
                if (!_rpPnResults.length) {
                    dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>ไม่พบรายการ</div>`
                    return
                }
                dd.innerHTML = _rpPnResults.map((x, i) => `
                    <div class="wo-item" onmousedown="rpSelectPn(${i})">
                        <span>
                            <strong>${escHtml(x.partNo)}</strong>
                            ${x.itemName ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${escHtml(x.itemName)}</span>` : ''}
                        </span>
                        ${x.baseUnit ? `<span class="wo-item-line">${escHtml(x.baseUnit)}</span>` : ''}
                    </div>`).join('')
            } catch {
                dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default"><i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ</div>`
            }
        }, 300)
    }

    function rpSelectPn(i) {
        const x = _rpPnResults[i]
        if (!x) return
        rpHidePnDropdown()
        const inp = document.getElementById('rpm_partNo')
        if (inp) { inp.value = x.partNo; inp.style.borderColor = '' }
        const unitEl = document.getElementById('rpm_unit')
        if (unitEl && !unitEl.value && x.baseUnit) unitEl.value = x.baseUnit
    }

    function rpOpenManualModal() {
        const colHdr = document.getElementById('rpManualColHeaders')
        if (colHdr) colHdr.style.display = 'grid'
        const cfg        = rpLayoutConfig ?? {}
        const qrFields   = Array.isArray(cfg.qrFields)    ? cfg.qrFields    : []
        const lblFields  = Array.isArray(cfg.labelFields) ? cfg.labelFields : []

        const container = document.getElementById('rpManualFields')
        container.innerHTML = ALL_FIELD_KEYS.filter(k => k !== 'createdAt').map(k => {
            const inQr  = qrFields.find(f => f.key === k)?.inQr   ?? false
            const inLbl = lblFields.find(f => f.key === k)?.show   ?? false
            const isAuto = AUTO_GEN_KEYS.has(k)
            const prefill = k === 'workOrder'      ? (rpCurrentWo      ?? '')
                          : k === 'line'           ? (rpCurrentLine    ?? '')
                          : k === 'productionArea' ? (rpProductionArea ?? '')
                          : ''
            const isReq = REQUIRED_KEYS.has(k)
            const inputEl = isAuto
                ? `<div style="padding:7px 10px;background:#f0f2f5;border:1.5px solid var(--border);border-radius:8px;font-size:12px;color:var(--t2);font-style:italic">Auto-Gen after add item</div>`
                : k === 'partNo'
                ? `<div style="position:relative">
                       <input id="rpm_partNo" class="form-input" value="${escHtml(prefill)}"
                           style="font-size:13px;padding:7px 10px;width:100%"
                           oninput="this.style.borderColor='';rpPnAutocomplete(this.value)"
                           onblur="setTimeout(rpHidePnDropdown, 180)"
                           placeholder="${escHtml(FIELD_PLACEHOLDERS['partNo'] ?? FIELD_LABELS['partNo'])}">
                       <div id="rpPnDropdown" class="wo-dropdown" style="display:none"></div>
                   </div>`
                : `<input id="rpm_${cid(k)}" class="form-input" value="${escHtml(prefill)}"
                       style="font-size:13px;padding:7px 10px"
                       ${k === 'workOrder' || k === 'productionArea' || k === 'line' ? 'readonly style="font-size:13px;padding:7px 10px;background:#f8f9fc"' : ''}
                       oninput="this.style.borderColor=''"
                       placeholder="${escHtml(FIELD_PLACEHOLDERS[k] ?? FIELD_LABELS[k])}">`
            return `<div style="display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px 16px;align-items:center;padding:6px 16px;border-bottom:1px solid var(--border)">
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inQr ? 'var(--blue)' : 'var(--border)'};background:${inQr ? 'var(--blue)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inQr ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inLbl ? 'var(--purple,#7c3aed)' : 'var(--border)'};background:${inLbl ? 'var(--purple,#7c3aed)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inLbl ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="font-size:13px;font-weight:600;color:var(--navy)">
                    ${escHtml(FIELD_LABELS[k])}${isReq ? ' <span style="color:var(--red)">*</span>' : ''}
                </div>
                ${inputEl}
            </div>`
        }).join('')

        document.getElementById('rpManualModalTitle').textContent = '⌨ Manual Entry'
        document.getElementById('rpManualModalFooter').innerHTML =
            `<button onclick="document.getElementById('rpManualModal').style.display='none'"
                style="flex:1;padding:12px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">
                Cancel
            </button>
            <button onclick="rpSubmitManual()"
                style="flex:2;padding:12px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit">
                + Add Item
            </button>`
        document.getElementById('rpManualModal').style.display = 'flex'
    }

    function rpSubmitManual() {
        const data = {}
        ALL_FIELD_KEYS.forEach(k => {
            if (AUTO_GEN_KEYS.has(k)) { data[k] = ''; return }
            const el = document.getElementById(`rpm_${cid(k)}`)
            data[k] = el ? el.value.trim() : ''
        })
        for (const k of REQUIRED_KEYS) {
            if (!data[k]) {
                showToast(`Please fill in ${FIELD_LABELS[k]}`, 'error')
                const el = document.getElementById(`rpm_${cid(k)}`)
                if (el) { el.style.borderColor = 'var(--red)'; el.focus() }
                return
            }
        }
        document.getElementById('rpManualModal').style.display = 'none'
        rpAddItem(data).then(ok => { if (ok) showToast('✅ Added ' + data.partNo, 'success') })
    }

    const _RP_BRACE_FIELDS = ['partNo','quantity','unit','vendor','dateCode','tradingCode','po','inventoryNo','traceId']
    function rpDecodeBrace(raw) {
        const parts = raw.split(' {').map(s => s.trim())
        if (parts.length < 2 || !parts[0]) return null
        const obj = {}
        _RP_BRACE_FIELDS.forEach((k, i) => { obj[k] = parts[i] ?? '' })
        if (!obj.partNo) return null
        return obj
    }

    async function rpParseScan(raw) {
        try {
            const obj = JSON.parse(raw)
            if (obj && typeof obj === 'object' && obj.partNo) {
                return {
                    partNo:   obj.partNo  ?? '',
                    quantity: String(obj.quantity ?? ''),
                    unit:     obj.unit    ?? '',
                    workOrder: obj.workOrder ?? rpCurrentWo ?? '',
                    line:     obj.line    ?? rpCurrentLine ?? '',
                    lotNo:    obj.lotNo   ?? '',
                    vendor:   obj.vendor  ?? '',
                    dateCode: obj.dateCode ?? '',
                    tradingCode: obj.tradingCode ?? '',
                    po:       obj.po      ?? '',
                    inventoryNo: obj.inventoryNo ?? '',
                    traceId:  obj.traceId ?? '',
                    productionArea: obj.productionArea ?? '',
                    createdAt: obj.createdAt ?? '',
                }
            }
        } catch (_) {}

        const brace = rpDecodeBrace(raw)
        if (brace) {
            return {
                partNo:      brace.partNo,
                quantity:    brace.quantity,
                unit:        brace.unit,
                workOrder:   rpCurrentWo  ?? '',
                line:        rpCurrentLine ?? '',
                lotNo:       '',
                vendor:      brace.vendor,
                dateCode:    brace.dateCode,
                tradingCode: brace.tradingCode,
                po:          brace.po,
                inventoryNo: brace.inventoryNo,
                traceId:     brace.traceId,
                productionArea: '',
                createdAt:   '',
            }
        }

        const res = await api('/scan/scan', 'POST', { barcode: raw, mode: 0 })
        return {
            partNo:   res.partNo   ?? '',
            quantity: String(res.quantity ?? ''),
            unit:     res.unit     ?? '',
            workOrder: res.workOrder ?? rpCurrentWo ?? '',
            line:     res.line     ?? rpCurrentLine ?? '',
            lotNo:    '',
            vendor:   res.vendor   ?? '',
            dateCode: res.dateCode ?? '',
            tradingCode: res.tradingCode ?? '',
            po:       res.po       ?? '',
            inventoryNo: res.inventoryNo ?? '',
            traceId:  res.wH_TraceId || res.traceId || '',
            productionArea: res.productionArea ?? '',
            createdAt: '',
        }
    }

    async function rpAddItem(data) {
        try {
        if (rpItems.length >= 10) {
            showToast('Maximum 10 items per batch', 'error')
            return
        }
        if (rpCurrentWo)      data.workOrder      = rpCurrentWo
        if (rpCurrentLine)    data.line            = rpCurrentLine
        if (rpProductionArea) data.productionArea  = rpProductionArea

        if (data.traceId) {
            const dup = rpItems.find(i => i.data.traceId === data.traceId)
            if (dup) {
                showToast('⚠️ traceId already in list: ' + data.traceId, 'error')
                return
            }
        }

        try {
            const trRes = await api('/inventory/new-lotNo', 'GET')
            data.lotNo  = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? String(trRes) ?? null
        } catch (_) {
            data.lotNo = null
        }
        data.createdAt = new Date().toISOString()

        const cfg = rpLayoutConfig ?? {}
        const sliders = {
            qrX:       cfg.qrX       ?? 30,
            qrY:       cfg.qrY       ?? 40,
            qrSize:    cfg.qrSize    ?? 5,
            dataX:     cfg.dataX     ?? 373,
            dataY:     cfg.dataY     ?? 58,
            fontSize:  cfg.fontSize  ?? 22,
            lineHeight: cfg.lineHeight ?? 33,
            valOffset:  cfg.valOffset  ?? 151,
        }
        const labelFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : null
        const textFields = labelFields
            ? labelFields.filter(f => f.show).map(f => ({
                label: f.label ?? FIELD_LABELS[f.key] ?? f.key,
                value: f.key === 'createdAt' ? fmtCreatedAt(data[f.key]) : (data[f.key] ?? ''),
              }))
            : Object.keys(FIELD_LABELS).filter(k => data[k]).map(k => ({
                label: FIELD_LABELS[k],
                value: k === 'createdAt' ? fmtCreatedAt(data[k]) : data[k],
              }))
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        rpItems.push({ data, zpl, previewSrc: null, reviewed: false })
        rpRenderList()
        const idx = rpItems.length - 1
        const dpi = cfg.dpi ?? '8dpmm'
        const w   = cfg.width  ?? 4
        const h   = cfg.height ?? 3
        renderZplClient(zpl, dpi, w, h).then(src => {
            if (rpItems[idx]) { rpItems[idx].previewSrc = src }
        }).catch(() => {})
        return true
        } catch(e) { showToast('Failed to add item: ' + e.message, 'error'); return false }
    }

    function rpConfirmDelete(idx) {
        const item = rpItems[idx]
        if (!item) return
        const desc = document.getElementById('rpConfirmModalDesc')
        if (desc) desc.textContent = item.data.partNo ? `P/N: ${item.data.partNo}` : `Item #${idx + 1}`
        const btn = document.getElementById('rpConfirmDeleteBtn')
        if (btn) btn.onclick = () => {
            document.getElementById('rpConfirmModal').style.display = 'none'
            rpRemoveItem(idx)
        }
        document.getElementById('rpConfirmModal').style.display = 'flex'
    }

    function rpRemoveItem(idx) {
        const barcode = rpItems[idx]?.data?._barcode
        if (barcode) rpScannedTrace.delete(barcode)
        rpItems.splice(idx, 1)
        rpRenderList()
    }

    function rpRenderList() {
        const container = document.getElementById('rpItemList')
        const badge     = document.getElementById('rpCounter')
        const n         = rpItems.length
        const reviewed  = rpItems.filter(i => i.reviewed).length
        badge.textContent = `${n}/10`
        badge.className   = 'rp-counter-badge' + (n >= 10 ? ' full' : '')

        const allReviewed = n > 0 && reviewed === n
        const canPrint    = !_rpPrinting && allReviewed
        ;['rpPrintBtn', 'rpPrintBtnMobile'].forEach(id => {
            const btn = document.getElementById(id)
            if (!btn) return
            btn.disabled      = !canPrint
            btn.style.opacity = canPrint ? '1' : '0.45'
            btn.style.cursor  = canPrint ? 'pointer' : 'not-allowed'
            btn.textContent   = '🖨 Print'
            btn.title = _rpPrinting        ? 'Printing in progress…'
                      : !allReviewed       ? `Review all items first (${reviewed}/${n} reviewed)` : ''
        })

        if (n === 0) {
            container.innerHTML = '<div class="rp-empty-state">No items yet — scan or type to add</div>'
            return
        }

        const cols = `font-size:13px;font-weight:600;color:var(--t2);font-family:monospace;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;padding:0 8px`
        container.innerHTML = rpItems.map((item, idx) => {
            const d   = item.data
            const err = item.receiveError || item.printError

            if (item.processing) {
                return `<div class="rp-item-row" style="opacity:0.55">
                    <div class="rp-item-info"><div class="rp-item-pn">${escHtml(d.partNo || '—')}</div></div>
                    <div style="${cols}">${escHtml(d.lotNo || '')}</div>
                    <div style="font-size:13px;font-weight:700;color:var(--text);flex:1;min-width:0;text-align:right">${escHtml(String(d.quantity || ''))}</div>
                    <div style="font-size:12px;font-weight:600;color:var(--t2);flex:1;min-width:0;text-align:right">${escHtml(d.unit || '')}</div>
                    <div style="width:130px;display:flex;justify-content:flex-end;align-items:center">
                        <span style="font-size:13px;color:var(--t2)">⏳</span>
                    </div>
                </div>`
            }

            if (err) {
                return `<div class="rp-item-row" style="flex-direction:column;gap:4px;border-left:3px solid var(--red);background:#fff5f5;align-items:stretch">
                    <div style="display:flex;align-items:center;gap:16px">
                        <div class="rp-item-info"><div class="rp-item-pn">${escHtml(d.partNo || '—')}</div></div>
                        <div style="${cols}">${escHtml(d.lotNo || '')}</div>
                        <div style="font-size:13px;font-weight:700;color:var(--text);flex:1;min-width:0;text-align:right">${escHtml(String(d.quantity || ''))}</div>
                        <div style="font-size:12px;font-weight:600;color:var(--t2);flex:1;min-width:0;text-align:right">${escHtml(d.unit || '')}</div>
                        <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;width:160px;justify-content:flex-end">
                            <button onclick="rpViewItemData(${idx})"
                                style="background:var(--blue);border:none;border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;color:#fff;cursor:pointer;white-space:nowrap;font-family:inherit">
                                ✏️ Edit
                            </button>
                            <button onclick="rpRetryItem(${idx})"
                                style="background:#f59e0b;border:none;border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;color:#fff;cursor:pointer;white-space:nowrap;font-family:inherit">
                                🔄 Retry
                            </button>
                            <button class="rp-remove-btn" onclick="rpConfirmDelete(${idx})" title="Remove">✕</button>
                        </div>
                    </div>
                    <div style="font-size:11px;color:var(--red);font-weight:600;padding:0 2px">❌ ${escHtml(err)}</div>
                </div>`
            }

            const ok = item.reviewed
            return `<div class="rp-item-row">
                <div class="rp-item-info"><div class="rp-item-pn">${escHtml(d.partNo || '—')}</div></div>
                <div style="${cols}">${escHtml(d.lotNo || '')}</div>
                <div style="font-size:13px;font-weight:700;color:var(--text);flex:1;min-width:0;text-align:right">${escHtml(String(d.quantity || ''))}</div>
                <div style="font-size:12px;font-weight:600;color:var(--t2);flex:1;min-width:0;text-align:right">${escHtml(d.unit || '')}</div>
                <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;width:130px;justify-content:flex-end">
                    <button onclick="rpViewItemData(${idx})"
                        style="background:${ok ? 'var(--green-lt)' : '#fffbeb'};border:1.5px solid ${ok ? 'var(--green)' : '#f59e0b'};border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;color:${ok ? 'var(--green)' : '#d97706'};cursor:pointer;white-space:nowrap;font-family:inherit;min-width:88px;text-align:center">
                        ${ok ? '✓ Reviewed' : '📋 View Data'}
                    </button>
                    <button class="rp-remove-btn" onclick="rpConfirmDelete(${idx})" title="Remove">✕</button>
                </div>
            </div>`
        }).join('')
    }

    async function rpShowPreview(idx) {
        const modal = document.getElementById('rpPreviewModal')
        const wrap  = document.getElementById('rpPreviewContent')
        modal.style.display = 'flex'
        wrap.innerHTML = '<div style="color:var(--t3);font-size:13px">Rendering…</div>'
        const item = rpItems[idx]
        if (!item) { wrap.innerHTML = '<div style="color:var(--red)">Item not found</div>'; return }
        try {
            let src = item.previewSrc
            if (!src) {
                const cfg = rpLayoutConfig ?? {}
                src = await renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
                if (item) item.previewSrc = src
            }
            wrap.innerHTML = src
                ? `<img src="${escHtml(src)}" style="max-width:100%;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
                : '<div style="color:var(--amber);font-size:13px">Preview not available</div>'
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
    }

    function rpClosePreview() {
        document.getElementById('rpPreviewModal').style.display = 'none'
    }

    function rpShowPrintModal() {
        if (rpItems.length === 0) { showToast('No items in list', 'error'); return }
        if (_rpPrinting) return
        if (!document.getElementById('rpPrinterSelect')?.value) {
            showToast('กรุณาเลือก Printer ก่อน', 'error')
            const trigger = document.getElementById('rpPrinterTrigger')
            trigger?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
            trigger?.focus()
            return
        }
        const unreviewed = rpItems.filter(i => !i.reviewed).length
        if (unreviewed > 0) {
            showToast(`Please review all items first (${rpItems.length - unreviewed}/${rpItems.length} reviewed)`, 'error')
            return
        }
        rpPrint('receive')
    }

    async function rpPrint(mode) {
        if (rpItems.length === 0) return
        if (mode === 'receive' && !rpReceiveLocationCode) {
            showToast('Please select a Receive Location first', 'error'); return
        }
        const printerIp = document.getElementById('rpPrinterSelect')?.value
        if (!printerIp) { showToast('Please select a printer', 'error'); return }

        _rpPrinting = true
        rpRenderList()

        for (const item of [...rpItems]) {
            await _rpProcessItem(item, printerIp, mode)
        }

        _rpPrinting = false
        if (rpItems.length === 0) {
            showToast(`🖨️ All items printed${mode === 'receive' ? ' & received' : ''} successfully`, 'success')
        }
        rpRenderList()
    }

    function _rpBuildReceivePayload(item) {
        return {
            lotNo:        item.data.lotNo        ?? '',
            partNo:       item.data.partNo       ?? '',
            description:  item.data.description  ?? '',
            workOrderNo:  item.data.workOrder    ?? item.data.workOrderNo ?? '',
            locationCode: rpReceiveLocationCode  ?? '',
            quantity:     +item.data.quantity    || 0,
            unit:         item.data.unit         ?? '',
            traceId:      item.data.traceId      ?? item.data._barcode   ?? '',
            vendor:       item.data.vendor       ?? '',
            dateCode:     item.data.dateCode     ?? '',
            tradingCode:  item.data.tradingCode  ?? '',
            po:           item.data.po           ?? '',
            inventoryNo:  item.data.inventoryNo  ?? '',
            itemType:     item.data.itemType     ?? 1,
            latitude:     rpReceiveLat           ?? 0,
            longitude:    rpReceiveLng           ?? 0,
        }
    }

    async function _rpProcessItem(item, printerIp, mode) {
        item.processing   = true
        item.receiveError = null
        item.printError   = null
        rpRenderList()

        if (mode === 'receive' && !item.isReceived) {
            try {
                const res    = await api('/inventory/receive', 'POST', {
                    command: { items: [_rpBuildReceivePayload(item)] },
                    options: { skipManualLotValidation: true }
                })
                const data   = Array.isArray(res?.data) ? res.data : []
                const result = data[0]
                if (result && !result.sucess && !result.success) {
                    item.receiveError = result.message || result.errorCode || 'Receive failed'
                    item.processing   = false
                    showToast(`❌ ${item.data.lotNo || ''}: ${item.receiveError}`, 'error')
                    rpRenderList()
                    return
                }
                item.isReceived = true
            } catch (err) {
                item.receiveError = err.message || 'Receive failed'
                item.processing   = false
                showToast(`❌ ${item.data.lotNo || ''}: ${item.receiveError}`, 'error')
                rpRenderList()
                return
            }
        }

        try {
            const payload = {
                printerIp,
                lotNo: item.data.lotNo ?? '',
                zpl:   applyPrintOffset(item.zpl, rpLayoutConfig),
            }
            if (item.printAttempted) {
                payload.isReprint     = true
                payload.reprintReason = 'Re-Print in PrintReceive'
            }
            item.printAttempted = true
            const res = await api('/printer/send', 'POST', payload)
            const pd  = res?.problemDetails
            if (pd || (res?.statusCode && res.statusCode >= 400)) {
                const msg = [pd?.title, pd?.detail].filter(Boolean).join(': ') || res?.message || 'Print failed'
                item.printError = msg
                item.processing = false
                showToast(`❌ ${item.data.lotNo || ''}: ${msg}`, 'error')
                rpRenderList()
            } else {
                const i = rpItems.indexOf(item)
                if (i !== -1) {
                    if (item.data._barcode) rpScannedTrace.delete(item.data._barcode)
                    rpItems.splice(i, 1)
                }
                rpRenderList()
            }
        } catch (err) {
            item.printError = err.message || 'Print error'
            item.processing = false
            showToast(`❌ ${item.data.lotNo || ''}: ${item.printError}`, 'error')
            rpRenderList()
        }
    }

    async function rpRetryItem(idx) {
        if (_rpPrinting) return
        const item = rpItems[idx]
        if (!item) return
        const printerIp = document.getElementById('rpPrinterSelect')?.value
        if (!printerIp) { showToast('Please select a printer', 'error'); return }

        _rpPrinting = true
        await _rpProcessItem(item, printerIp, 'receive')
        _rpPrinting = false

        if (rpItems.length === 0) showToast('🖨️ All items completed!', 'success')
        rpRenderList()
    }
</script>
