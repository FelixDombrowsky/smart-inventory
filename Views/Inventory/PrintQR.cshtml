    function populateDsQrFieldList(savedQrFields, allChecked) {
        const container = document.getElementById('dsQrFieldList')
        if (!container) return
        container.innerHTML = ALL_FIELD_KEYS.map(k => {
            const isReq   = QR_REQUIRED_KEYS.has(k)
            const sf      = savedQrFields ? savedQrFields.find(f => f.key === k) : null
            const checked = isReq || (allChecked ? true : (sf ? Boolean(sf.inQr) : false))
            return `<div style="display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid var(--border)">
                <input type="checkbox" id="qrcb_${cid(k)}" class="ds-qr-cb"
                    ${checked ? 'checked' : ''} ${isReq ? 'disabled' : ''}
                    onchange="dsPreviewDebounce()" style="width:16px;height:16px;flex-shrink:0">
                <span style="font-size:13px;font-weight:600;flex:1">${escHtml(FIELD_LABELS[k])}</span>
                ${isReq ? '<span style="font-size:10px;background:#fee2e2;color:#dc2626;border-radius:4px;padding:1px 6px;font-weight:600;white-space:nowrap">required</span>' : ''}
                <span style="font-size:12px;color:var(--blue);font-weight:600;font-family:monospace;white-space:nowrap">{${k}}</span>
            </div>`
        }).join('')
        // Ensure required fields always checked
        QR_REQUIRED_KEYS.forEach(k => {
            const el = document.getElementById(`qrcb_${cid(k)}`)
            if (el) el.checked = true
        })
    }

    function getDsQrFields() {
        return ALL_FIELD_KEYS.map(k => ({
            key:  k,
            inQr: QR_REQUIRED_KEYS.has(k) || Boolean(document.getElementById(`qrcb_${cid(k)}`)?.checked),
        }))
    }

    function buildQrContent(data, qrFields) {
        if (!qrFields || !qrFields.length) return JSON.stringify(data)
        const selectedKeys = qrFields.filter(f => f.inQr).map(f => f.key)
        const obj = {}
        selectedKeys.forEach(k => { if (data[k] !== undefined && data[k] !== null && data[k] !== '') obj[k] = data[k] })
        return JSON.stringify(obj)
    }

    function editDsLabel(k) {
        const span  = document.getElementById(`dflabel_${cid(k)}`)
        const input = document.getElementById(`dfinput_${cid(k)}`)
        input.value = span.textContent
        span.style.display  = 'none'
        input.style.display = ''
        input.focus()
        input.onblur = () => confirmDsLabel(k)
    }
    function confirmDsLabel(k) {
        const span  = document.getElementById(`dflabel_${cid(k)}`)
        const input = document.getElementById(`dfinput_${cid(k)}`)
        span.textContent = input.value || FIELD_LABELS[k]
        span.style.display  = ''
        input.style.display = 'none'
        dsPreviewDebounce()
    }

    // Parse the JSON blob stored in zplData field
    function parseZplDataJson(layout) {
        const raw = layout.zplData
        if (!raw) return {}
        try {
            const obj = JSON.parse(raw)
            if (obj && typeof obj === 'object' && !Array.isArray(obj)) return obj
        } catch (_) {}
        return { zplTemplate: raw }  // legacy: plain ZPL string
    }

    function parseLayoutFields(layout) {
        const config = parseZplDataJson(layout)
        const lf = config.labelFields
        if (!lf) return null
        try {
            if (Array.isArray(lf) && lf[0]?.key) return lf
            if (Array.isArray(lf)) return lf.map(k => ({ key:k, label:FIELD_LABELS[k]??k, show:true }))
        } catch (_) {}
        return null
    }

    function getDsFields() {
        return ALL_FIELD_KEYS.map(k => ({
            key:   k,
            label: document.getElementById(`dflabel_${cid(k)}`)?.value ?? FIELD_LABELS[k],
            show:  document.getElementById(`dfcb_${cid(k)}`)?.checked ?? false,
        }))
    }

    // ── ZPL Builder ──
    // Estimate total QR dot size (data + 8-module quiet zone) for ECL M
    function estQrDots(content, scale) {
        const n = content.length
        const ver = n <= 25 ? 2 : n <= 50 ? 4 : n <= 100 ? 7 : n <= 200 ? 11 : n <= 350 ? 16 : 20
        return (ver * 4 + 17 + 8) * scale
    }

function buildZpl({ qrContent, textFields, qrX, qrY, qrSize, dataX, dataY, fontSize, valOffset, lineHeight, printOffsetX = 0 }) {
        const lineH  = lineHeight ?? Math.round(fontSize * 1.5)
        const pqrX   = qrX   + printOffsetX
        const pdataX = dataX + printOffsetX
        let zpl = `^XA\n^CI28\n`
        zpl += `^FO${pqrX},${qrY}^BQN,2,${qrSize}^FDMA,${qrContent}^FS\n`

        textFields.forEach(({ label, value }, i) => {
            const y = dataY + i * lineH
            zpl += `^FO${pdataX},${y}^A0N,${fontSize},${fontSize}^FD${label}:^FS\n`
            zpl += `^FO${pdataX + valOffset},${y}^A0N,${fontSize},${fontSize}^FD${value}^FS\n`
        })

        // ── Logo แถบล่าง (commented out — เปิดใช้ในอนาคตได้) ──
        // if (_logoZplData) {
        //     const lastTextY = dataY + textFields.length * lineH
        //     const ly = lastTextY + 8
        //     zpl += `^FO${dataX},${ly}${_logoZplData.cmd}^FS\n`
        // }

        zpl += `^XZ`
        return zpl
    }

    function buildZplTemplate(fields) {
        const qrX      = +document.getElementById('slQrX').value
        const qrY      = +document.getElementById('slQrY').value
        const qrSize   = +document.getElementById('slQrSize').value
        const dataX    = +document.getElementById('slDataX').value
        const dataY    = +document.getElementById('slDataY').value
        const fontSize = +document.getElementById('slFontSize').value
        const valOffset= +document.getElementById('slValOffset').value
        const lineH    = Math.round(fontSize * 1.5)
        let zpl = `^XA\n^CI28\n`
        zpl += `^FO${qrX},${qrY}^BQN,2,${qrSize}^FDMA,{qrContent}^FS\n`
        fields.filter(f => f.show).forEach(({ key, label }, i) => {
            const y = dataY + i * lineH
            zpl += `^FO${dataX},${y}^A0N,${fontSize},${fontSize}^FD${label}:^FS\n`
            zpl += `^FO${dataX + valOffset},${y}^A0N,${fontSize},${fontSize}^FD{${key}}^FS\n`
        })
        zpl += `^XZ`
        return zpl
    }

    // ── ZPL Preview — client-side renderer (ไม่ต้องเน็ต ไม่ผ่าน server) ──
    async function callZplPreview(zpl, dpi, width, height) {
        return await renderZplClient(zpl, dpi, width, height)
    }

    // ── Logo → ZPL ^GF encoder ───────────────────────────────────────────
    let _logoZplData = null

    async function initLogoZpl(logoSizeDots = 80) {
        try {
            const img = new Image()
            img.src = '/image/packaging_icon.png'
            await new Promise((res, rej) => { img.onload = res; img.onerror = () => rej(new Error('logo not found')) })

            const c = document.createElement('canvas')
            c.width = c.height = logoSizeDots
            const ctx = c.getContext('2d')
            ctx.fillStyle = '#fff'
            ctx.fillRect(0, 0, logoSizeDots, logoSizeDots)
            ctx.drawImage(img, 0, 0, logoSizeDots, logoSizeDots)

            const { data } = ctx.getImageData(0, 0, logoSizeDots, logoSizeDots)
            const bytesPerRow = Math.ceil(logoSizeDots / 8)
            let hex = ''

            for (let y = 0; y < logoSizeDots; y++) {
                for (let bx = 0; bx < bytesPerRow; bx++) {
                    let byte = 0
                    for (let bit = 0; bit < 8; bit++) {
                        const x = bx * 8 + bit
                        if (x < logoSizeDots) {
                            const i = (y * logoSizeDots + x) * 4
                            const gray      = data[i]*0.299 + data[i+1]*0.587 + data[i+2]*0.114
                            const alpha     = data[i+3] / 255
                            const effective = gray * alpha + 255 * (1 - alpha)
                            if (effective < 128) byte |= (1 << (7 - bit))
                        }
                    }
                    hex += byte.toString(16).padStart(2, '0').toUpperCase()
                }
            }

            const totalBytes = bytesPerRow * logoSizeDots
            _logoZplData = {
                cmd:  `^GFA,${totalBytes},${totalBytes},${bytesPerRow},${hex}`,
                size: logoSizeDots
            }
            console.log('[ZPL] Logo GF ready:', totalBytes, 'bytes')
        } catch (e) {
            console.warn('[ZPL] Logo init error:', e.message)
        }
    }

    // initLogoZpl(45)  // 45 dots ≈ 5.6mm ที่ 203dpi — พอดีแถบล่าง (commented out)

    // ── ZPL Client Renderer ───────────────────────────────────────────────
    const ZPL_DPI = { '6dpmm':152, '8dpmm':203, '12dpmm':300, '24dpmm':600 }

    // Preload ZebraFont ให้ browser และ Canvas รู้จักก่อน render
    const _zebraFontReady = document.fonts.load('bold 20px ZebraFont')

    async function renderZplClient(zpl, dpiStr, widthInch, heightInch) {
        await _zebraFontReady  // รอให้ font โหลดเสร็จก่อน
        const dpi = ZPL_DPI[dpiStr] || 203
        const cw  = Math.round((+widthInch  || 4) * dpi)
        const ch  = Math.round((+heightInch || 3) * dpi)

        const canvas = document.createElement('canvas')
        canvas.width  = cw
        canvas.height = ch
        const ctx = canvas.getContext('2d')
        ctx.fillStyle = '#fff'
        ctx.fillRect(0, 0, cw, ch)

        // ── Parse ZPL by splitting on '^' ──────────────────────────────
        // แต่ละ segment หลัง ^ คือ: 2 chars = command, ส่วนที่เหลือ = params/data
        // เช่น 'A0N,22,22' → cmd='A0', rest='N,22,22'
        //       'BQN,2,5'  → cmd='BQ', rest='N,2,5'
        //       'FDVENDOR:' → cmd='FD', rest='VENDOR:'
        const segs = zpl.split('^').slice(1)

        let fo           = { x:0, y:0 }
        let fontH        = 20
        let pendingBQ    = null
        let qrDrawBounds = null

        for (const seg of segs) {
            const cmd  = seg.slice(0, 2)
            const rest = seg.slice(2).replace(/[\r\n]+$/, '') // trim trailing newline

            switch (cmd) {
                case 'FO': {
                    const p = rest.split(',')
                    fo = { x: +p[0]||0, y: +p[1]||0 }
                    break
                }
                case 'A0': {
                    // rest = 'N,22,22' → strip orientation letter prefix
                    const p = rest.replace(/^[A-Z],/, '').split(',')
                    fontH = +p[0] || 20
                    break
                }
                case 'BQ': {
                    const p = rest.split(',')
                    pendingBQ = { mag: +p[2] || 3 }
                    break
                }
                case 'GF': {
                    // ^GFA,totalBytes,totalBytes,bytesPerRow,hexData
                    const parts = rest.split(',')
                    if (parts.length < 5) break
                    const bytesPerRow = parseInt(parts[3])
                    const hexStr = parts.slice(4).join('')
                    if (!bytesPerRow || !hexStr.trim()) break

                    const rows     = Math.floor(hexStr.length / (bytesPerRow * 2))
                    const imgWidth = bytesPerRow * 8
                    const imgData  = ctx.createImageData(imgWidth, rows)
                    const d = imgData.data

                    for (let r = 0; r < rows; r++) {
                        for (let b = 0; b < bytesPerRow; b++) {
                            const ho   = (r * bytesPerRow + b) * 2
                            const byte = parseInt(hexStr.slice(ho, ho + 2), 16)
                            for (let bit = 0; bit < 8; bit++) {
                                const dark  = (byte >> (7 - bit)) & 1
                                const pxOff = (r * imgWidth + b * 8 + bit) * 4
                                d[pxOff]     = dark ? 0   : 255
                                d[pxOff + 1] = dark ? 0   : 255
                                d[pxOff + 2] = dark ? 0   : 255
                                d[pxOff + 3] = dark ? 255 : 0    // white = transparent
                            }
                        }
                    }
                    ctx.putImageData(imgData, fo.x, fo.y)
                    break
                }
                case 'FD': {
                    if (pendingBQ) {
                        // ── QR Code — ใช้ server endpoint (ไม่ต้องเน็ต) ──
                        let data = rest
                        let ecl  = 'M' // default
                        // ^FDLA,{data} → L=ECL Low, M=Medium, Q=Quartile, H=High
                        const eclMatch = data.match(/^([LMQH])A,/)
                        if (eclMatch) { ecl = eclMatch[1]; data = data.slice(3) }
                        try {
                            const img = new Image()
                            img.src = `/api/qr/image?data=${encodeURIComponent(data)}&scale=${pendingBQ.mag}&ecl=M`
                            await new Promise((resolve, reject) => {
                                img.onload  = resolve
                                img.onerror = () => reject(new Error('QR image load failed'))
                            })
                            // QRCoder ใส่ quiet zone 4 modules ไว้ใน PNG เสมอ
                            // X: ลบ qz ออกทั้งหมด → ชิดขอบซ้าย
                            // Y: ลบ qz แต่คืน 2 modules → เว้นขอบบนนิดหน่อย
                            const qz  = 4 * pendingBQ.mag
                            const dx  = fo.x - qz
                            const dy  = fo.y - qz + pendingBQ.mag * 2
                            ctx.drawImage(img, dx, dy)
                            qrDrawBounds = { x: dx, y: dy, w: img.naturalWidth, h: img.naturalHeight, qz }
                        } catch (e) {
                            console.warn('[ZPL] QR error:', e.message)
                            ctx.strokeStyle = '#aaa'
                            ctx.lineWidth   = 2
                            ctx.strokeRect(fo.x, fo.y, 80, 80)
                            ctx.fillStyle = '#aaa'
                            ctx.font = '11px sans-serif'
                            ctx.fillText('QR', fo.x + 32, fo.y + 44)
                        }
                        pendingBQ = null
                    } else if (rest) {
                        // ── Text ──
                        ctx.fillStyle = '#000'
                        ctx.font = `bold ${fontH}px ZebraFont, "Arial Narrow", sans-serif`
                        ctx.fillText(rest, fo.x, fo.y + fontH * 0.85)
                    }
                    break
                }
            }
        }


        return canvas.toDataURL('image/png')
    }

    let dsPreviewTimer = null
    function dsPreviewDebounce() {
        clearTimeout(dsPreviewTimer)
        dsPreviewTimer = setTimeout(() => { dsUpdateQrData(); dsDoPreview() }, 600)
    }

    function dsUpdateQrData() {
        const qrFields  = getDsQrFields()
        const selKeys   = qrFields.filter(f => f.inQr).map(f => f.key)
        const QR_SCHEMA = JSON.stringify(Object.fromEntries(selKeys.map(k => [k, `{${k}}`])), null, 2)
        document.getElementById('dsQrDataBox').textContent = QR_SCHEMA
        document.getElementById('dsZplBox').textContent    = buildZplTemplate(getDsFields())
    }

    async function dsDoPreview() {
        const fields     = getDsFields()
        const textFields = fields.filter(f => f.show).map(f => ({
            label: f.label,
            value: f.key === 'createdAt' ? fmtCreatedAt(DESIGN_SAMPLE[f.key]) : (DESIGN_SAMPLE[f.key] ?? ''),
        }))
        const sliders    = {
            qrX:       +document.getElementById('slQrX').value,
            qrY:       +document.getElementById('slQrY').value,
            qrSize:    +document.getElementById('slQrSize').value,
            dataX:     +document.getElementById('slDataX').value,
            dataY:     +document.getElementById('slDataY').value,
            fontSize:   +document.getElementById('slFontSize').value,
            lineHeight: +document.getElementById('slLineHeight').value,
            valOffset:  +document.getElementById('slValOffset').value,
        }
        const zpl = buildZpl({ qrContent: buildQrContent(DESIGN_SAMPLE, getDsQrFields()), textFields, ...sliders })
        document.getElementById('dsZplBox').textContent = zpl
        const wrap = document.getElementById('dsPreviewImgWrap')
        wrap.innerHTML = '<div style="color:var(--t2);font-size:13px">⏳ Rendering…</div>'
        try {
            const dpi    = document.getElementById('dsDpi').value
            const width  = +document.getElementById('dsWidth').value  || 4
            const height = +document.getElementById('dsHeight').value || 3
            const imgSrc = await callZplPreview(zpl, dpi, width, height)
            if (imgSrc) {
                wrap.innerHTML = `<img src="${escHtml(imgSrc)}"
                    style="max-width:100%;max-height:300px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
            } else {
                wrap.innerHTML = '<div style="color:var(--amber);font-size:13px">⚠️ No image received</div>'
            }
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
    }

    async function dsDoSave() {
        const name = document.getElementById('dsTemplateName').value.trim()
        if (!name) { showToast('Please enter a Template Name', 'error'); return }
        const fields = getDsFields()
        // Embed all config in zplData as JSON so it survives round-trips
        const config = {
            zplTemplate: buildZplTemplate(fields),
            dpi:         document.getElementById('dsDpi').value,
            width:       +document.getElementById('dsWidth').value,
            height:      +document.getElementById('dsHeight').value,
            qrX:         +document.getElementById('slQrX').value,
            qrY:         +document.getElementById('slQrY').value,
            qrSize:      +document.getElementById('slQrSize').value,
            dataX:       +document.getElementById('slDataX').value,
            dataY:       +document.getElementById('slDataY').value,
            fontSize:    +document.getElementById('slFontSize').value,
            lineHeight:    +document.getElementById('slLineHeight').value,
            valOffset:     +document.getElementById('slValOffset').value,
            printOffsetX:  +document.getElementById('slPrintOffX').value,
            printOffsetY:  +document.getElementById('slPrintOffY').value,
            labelFields: fields,
            qrFields:    getDsQrFields(),
        }
        const body = {
            templateName: name,
            description:  document.getElementById('dsDescription').value.trim(),
            zplData:      JSON.stringify(config),
        }
        try {
            if (dsEditLayoutId) {
                await api(`/printer/template/${dsEditLayoutId}`, 'PUT', { id: dsEditLayoutId, ...body })
            } else {
                await api('/printer/save-template', 'POST', body)
            }
            showToast('Layout saved', 'success')
            showListMode()
            loadLayoutsIntoSelect()
        } catch (err) { showToast('Save failed: ' + err.message, 'error') }
    }

    // ══════════════════════════════════════════════════
    // RP — RECEIVE & PRINT / RE-PRINT (new print flow)
    // ══════════════════════════════════════════════════

    // ── State ──
    let rpItems        = []        // max 10 items [{data,zpl,previewSrc,reviewed,isReceived,printAttempted,receiveError,printError,processing}]
    let rpScannedTrace = new Set() // traceId dedup
    let _rpPrinting    = false     // guard against double-submit
    let rpCurrentWo      = null
    let rpCurrentLine    = null
    let rpProductionArea = 'FAN_01'
    let rpLayoutConfig = null      // parsed config from selected template
    let _rpScanActive        = false
    let _rpFacingMode        = 'environment'
    let _rpStream            = null
    let _rpRafId             = null
    let _rpDetector          = null
    let _rpScannerOrigParent = null
    let _rpLastScanTime = 0
    const _RP_COOLDOWN = 1500
    let _rpFoundLot    = null      // result of GET /printer/lot/{lotNo}

    // ── W/O Autocomplete ──
    let _rpWoTimer = null
    function rpWoInputHandler() {
        const q = document.getElementById('rpWoInput').value.trim()
        const dd = document.getElementById('rpWoDropdown')
        if (!q) { dd.style.display = 'none'; return }
        clearTimeout(_rpWoTimer)
        _rpWoTimer = setTimeout(() => rpFetchWo(q), 280)
    }

    async function rpFetchWo(q) {
        const dd = document.getElementById('rpWoDropdown')
        dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">⏳ Searching…</div>'
        dd.style.display = ''
        try {
            const res = await api(`/workorder?Page=1&PageSize=20&Search=${encodeURIComponent(q)}&SortBy=LastSyncedAt&SortDir=desc`, 'GET')
            const arr = res?.data?.data ?? []
            if (arr.length === 0) {
                dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">No Work Order found</div>'
                return
            }
            dd.innerHTML = arr.map(x =>
                `<div class="wo-item" onmousedown="rpSelectWo('${escHtml(x.moNumber)}','${escHtml(x.lineName ?? '')}')">
                    <span style="font-weight:700">${escHtml(x.moNumber)}</span>
                    <span class="wo-item-line">${escHtml(x.lineName ?? '—')} · ${escHtml(x.modelName ?? '')}</span>
                </div>`
            ).join('')
        } catch (err) {
            console.error('[rpFetchWo]', err)
            dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default">❌ ${escHtml(err.message || 'Load failed')}</div>`
        }
    }

    function rpCheckScanReady() {
        const ready = !!rpCurrentWo && !!rpLayoutConfig && !!rpReceiveLocationCode
        const ids   = ['rpManualBtn', 'rpBtnCam', 'rpHwScanBtn']
        const tip   = ready ? '' : (() => {
            const m = []
            if (!rpCurrentWo)           m.push('Work Order')
            if (!rpLayoutConfig)        m.push('Layout Template')
            if (!rpReceiveLocationCode) m.push('Receive Location')
            return 'Required: ' + m.join(', ')
        })()
        ids.forEach(id => {
            const b = document.getElementById(id)
            if (!b) return
            b.disabled       = !ready
            b.style.opacity  = ready ? '1'           : '0.4'
            b.style.cursor   = ready ? 'pointer'     : 'not-allowed'
            b.title          = tip
        })
    }

    function rpSelectWo(mo, line) {
        document.getElementById('rpWoInput').value = mo
        rpCurrentWo   = mo
        rpCurrentLine = line
        const ld = document.getElementById('rpLineDisplay')
        ld.textContent = line || '—'
        ld.style.color = line ? 'var(--blue)' : 'var(--t3)'
        ld.style.background  = line ? 'var(--blue-lt)' : '#f0f2f5'
        ld.style.borderColor = line ? 'var(--blue)'    : 'var(--border)'
        rpHideWoDropdown()
        rpCheckScanReady()
    }

    function rpHideWoDropdown() {
        document.getElementById('rpWoDropdown').style.display = 'none'
    }

    // ── Layout ──
    async function rpLoadLayouts() {
        const sel = document.getElementById('rpLayout')
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const arr = Array.isArray(layouts) ? layouts : (layouts?.data || [])
            sel.innerHTML = '<option value="">-- Select Layout --</option>' +
                arr.map(l => `<option value="${l.id}" data-cfg='${escHtml(l.zplData ?? "")}'>${escHtml(l.templateName ?? 'Untitled')}</option>`).join('')
            sel._layoutsData = arr
        } catch (_) {
            sel.innerHTML = '<option value="">-- (Unable to load Layouts) --</option>'
        }
    }

    function rpLayoutChange() {
        const sel = document.getElementById('rpLayout')
        const id  = sel.value
        if (!id) { rpLayoutConfig = null; rpCheckScanReady(); return }
        const arr  = sel._layoutsData || []
        const tmpl = arr.find(l => String(l.id) === String(id))
        if (!tmpl) { rpLayoutConfig = null; rpCheckScanReady(); return }
        rpLayoutConfig = parseZplDataJson(tmpl)
        rpRebuildAllZpl()
        rpCheckScanReady()
    }

    let _rpViewIdx = null

    function rpViewItemData(idx) {
        const item = rpItems[idx]
        if (!item) return
        item.reviewed = true
        _rpViewIdx = idx
        rpRenderList()
        rpRenderViewModal(idx)
        document.getElementById('rpManualModal').style.display = 'flex'
    }

    function rpRenderViewModal(idx) {
        const item = rpItems[idx]
        if (!item) return
        const d   = item.data
        const cfg = rpLayoutConfig ?? {}
        const qrFields  = Array.isArray(cfg.qrFields)    ? cfg.qrFields    : []
        const lblFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : []

        // Hide QR/Label/Field/Value header row (used only for manual entry)
        const colHdr = document.getElementById('rpManualColHeaders')
        if (colHdr) colHdr.style.display = 'none'

        // Build field rows HTML
        const fieldRowsHtml = ALL_FIELD_KEYS.filter(k => k !== 'createdAt').map(k => {
