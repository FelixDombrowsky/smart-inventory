                <rect x="276" y="130" width="28" height="40" fill="rgba(0,212,170,.12)" stroke="rgba(0,212,170,.25)" stroke-width="1"/>
                <rect x="200" y="185" width="28" height="40" fill="rgba(0,212,170,.08)" stroke="rgba(0,212,170,.15)" stroke-width="1"/>
                <rect x="238" y="185" width="28" height="40" fill="rgba(0,212,170,.08)" stroke="rgba(0,212,170,.15)" stroke-width="1"/>
                <rect x="276" y="185" width="28" height="40" fill="rgba(0,212,170,.08)" stroke="rgba(0,212,170,.15)" stroke-width="1"/>
                <rect x="242" y="245" width="36" height="55" fill="rgba(255,255,255,.04)" stroke="rgba(255,255,255,.12)" stroke-width="1"/>
