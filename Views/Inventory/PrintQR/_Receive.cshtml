    let rpReceiveLocationCode = null
    let rpReceiveLat = 0, rpReceiveLng = 0
    let _rpGpsCachedForLocation = null   // set after first successful receive; null = must re-fetch
    let rpLocResults = [], _rpLocTimer = null

    async function rpSearchLocation() {
        const q = document.getElementById('rpLocSearch').value.trim()
        rpReceiveLocationCode = null
        const dd = document.getElementById('rpLocDropdown')
        if (!q) { dd.style.display = 'none'; return }

        dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">⏳ Searching…</div>'
        dd.style.display = ''
        clearTimeout(_rpLocTimer)
        _rpLocTimer = setTimeout(async () => {
            try {
                const res = await api(`/location?search=${encodeURIComponent(q)}&page=1&pageSize=20`, 'GET')
                rpLocResults = res?.data?.data ?? res?.data ?? []
                if (!rpLocResults.length) {
                    dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">ไม่พบ Location</div>'
                    return
                }
                dd.innerHTML = rpLocResults.map((l, i) =>
                    `<div class="wo-item" style="gap:10px" onmousedown="rpLocSelect(${i})">
                        <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0"></i>
                        <span style="font-weight:700">${escHtml(l.locationCode)}</span>
                        ${l.description ? `<span style="font-size:12px;color:var(--t2)">${escHtml(l.description)}</span>` : ''}
                        ${l.typeName ? `<span style="font-size:11px;background:var(--blue-lt);color:var(--blue);border-radius:4px;padding:1px 6px;font-weight:600;margin-left:auto;white-space:nowrap">${escHtml(l.typeName)}</span>` : ''}
                    </div>`
                ).join('')
            } catch (e) {
                dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default">❌ ${escHtml(e.message)}</div>`
            }
        }, 280)
    }

    function rpLocSelect(i) {
        const loc = rpLocResults[i]
        if (rpReceiveLocationCode !== loc.locationCode) _rpGpsCachedForLocation = null
        document.getElementById('rpLocSearch').value = loc.locationCode
        rpReceiveLocationCode = loc.locationCode
        rpHideLocDropdown()
        rpShowError('rpLocSearch', false)
        rpCheckScanReady()
    }

    async function rpLocKeyDown(e) {
        if (e.key !== 'Enter') return
        e.preventDefault()
        const q = document.getElementById('rpLocSearch').value.trim()
        if (!q) return

        // 1. check already-loaded autocomplete results first
        if (rpLocResults.length > 0) {
            const exact = rpLocResults.find(l => l.locationCode?.toLowerCase() === q.toLowerCase())
            rpLocSelect(exact ? rpLocResults.indexOf(exact) : 0)
            return
        }

        // 2. fetch from API
        try {
            const res = await api(`/location?search=${encodeURIComponent(q)}&page=1&pageSize=20`, 'GET')
            rpLocResults = res?.data?.data ?? res?.data ?? []
            if (rpLocResults.length > 0) {
                const exact = rpLocResults.find(l => l.locationCode?.toLowerCase() === q.toLowerCase())
                rpLocSelect(exact ? rpLocResults.indexOf(exact) : 0)
                return
            }
        } catch {}

        // 3. fallback: use typed text directly
        if (rpReceiveLocationCode !== q) _rpGpsCachedForLocation = null
        rpReceiveLocationCode = q
        rpHideLocDropdown()
        rpShowError('rpLocSearch', false)
    }

    function rpHideLocDropdown() {
        document.getElementById('rpLocDropdown').style.display = 'none'
