    <header class="bg-white shadow-sm mb-4">
        <div class="container-fluid px-4 py-3">
            <div class="d-flex align-items-center justify-content-between">

                <div class="d-flex align-items-center">
                    <button class="btn btn-light d-xl-none me-2" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mobileMenu">
                        <i class="bi bi-list fs-4"></i>
                    </button>

                    <a href="#" onclick="goHome();return false" class="d-flex align-items-center text-decoration-none">
                        <div class="rounded-3 me-3 d-flex align-items-center justify-content-center"
                             style="width: 45px; height: 45px;">
                            <img src="/image/packaging_icon.png" style="width:40px;height:40px;object-fit:contain;">
                        </div>
                        <div class="d-none d-sm-block">
                            <h5 class="mb-0 fw-bold text-dark">Smart Factory Inventory</h5>
                            <p class="mb-0 text-muted small">ระบบจัดการคลังสินค้า</p>
                        </div>
                    </a>
                </div>

                <ul class="nav d-none d-xl-flex mx-auto custom-nav">
                    <li class="nav-item" id="dashboardNav"><a class="nav-link px-3"
