<!-- TAB PILLS -->
<script>
function switchTab(name, el) {
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'))
    document.querySelectorAll('.tab-pill').forEach(b => b.classList.remove('active'))
    document.getElementById('tab-' + name).classList.add('active')
    el.classList.add('active')
    if (name === 'print' && typeof loadLayoutsIntoSelect === 'function') {
        const prevRp = document.getElementById('rpLayout')?.value
        loadLayoutsIntoSelect().then(() => {
            const sel = document.getElementById('rpLayout')
            if (prevRp && sel && sel.querySelector(`option[value="${prevRp}"]`)) {
                sel.value = prevRp
                if (typeof rpLayoutChange === 'function') rpLayoutChange()
            }
        })
    }
}
</script>
<div class="tab-pills">
    <button class="tab-pill active" onclick="switchTab('print', this)">🖨️ Print QR-Code</button>
    <button class="tab-pill"        onclick="switchTab('design', this)">🎨 Design Layout</button>
    <button class="tab-pill"        onclick="switchTab('history', this)">📋 Print History</button>
</div>

