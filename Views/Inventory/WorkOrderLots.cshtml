@{
    ViewData["Title"] = "WorkOrder Lots";
}

<h2 class="mb-1">WorkOrder Lots</h2>
<h4 id="moTitle" class="text-muted mb-4"></h4>

<!-- Dashboard Cards -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3 mb-4">

    <div class="col">
        <div class="card text-bg-primary h-100 shadow-sm">
            <div class="card-body text-center">
                <h6 class="card-title">Total OnHand</h6>
                <h4 id="dashOnHand" class="mb-0">0</h4>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card text-bg-warning h-100 shadow-sm">
            <div class="card-body text-center">
                <h6 class="card-title">Total Reserved</h6>
                <h4 id="dashReserved" class="mb-0">0</h4>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card text-bg-success h-100 shadow-sm">
            <div class="card-body text-center">
                <h6 class="card-title">Total Available</h6>
                <h4 id="dashAvailable" class="mb-0">0</h4>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card text-bg-secondary h-100 shadow-sm">
            <div class="card-body text-center">
                <h6 class="card-title">Total Lots</h6>
                <h4 id="dashLots" class="mb-0">0</h4>
            </div>
        </div>
    </div>

</div>

<!-- Tabs -->
<ul class="nav nav-tabs nav-fill mb-3" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="lot-tab" data-bs-toggle="tab" data-bs-target="#lotTab" type="button" role="tab">
            Lot Detail
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="summary-tab" data-bs-toggle="tab" data-bs-target="#summaryTab" type="button" role="tab">
            Lot Summary
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="transaction-tab" data-bs-toggle="tab" data-bs-target="#transactionTab" type="button" role="tab">
            Transactions
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- Lot Detail -->
    <div class="tab-pane fade show active" id="lotTab" role="tabpanel">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>LotNo</th>
                        <th>PartNo</th>
                        <th>Location</th>
                        <th>OnHand</th>
                        <th>Reserved</th>
                        <th>Available</th>
                    </tr>
                </thead>
                <tbody id="lotTable"></tbody>
            </table>
        </div>
    </div>

    <!-- Lot Summary -->
    <div class="tab-pane fade" id="summaryTab" role="tabpanel">
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Location</th>
                        <th>PartNo</th>
                        <th>Total OnHand</th>
                        <th>Total Reserved</th>
                        <th>Total Available</th>
                        <th>Lot Count</th>
                    </tr>
                </thead>
                <tbody id="summaryTable"></tbody>
            </table>
        </div>
    </div>

    <!-- Transactions -->
    <div class="tab-pane fade" id="transactionTab" role="tabpanel">
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Type</th>
                        <th>PartNo</th>
                        <th>Lot</th>
                        <th>Qty</th>
                        <th>From</th>
                        <th>To</th>
                        <th>By</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody id="transactionTable"></tbody>
            </table>
        </div>
    </div>
</div>



@section Scripts{


<script src="/js/api.js"></script>

<script>

function getMo(){

let url = new URL(window.location.href)
return url.searchParams.get("mo")

}



async function loadLots(){

let mo = getMo()

document.getElementById("moTitle").innerText = "MO : " + mo

const lots = await api(`/workorder/workorders/${mo}/lots`, "GET")

// ======================
// Dashboard
// ======================

let totalOnHand = 0, totalReserved = 0, totalAvailable = 0

lots.forEach(x => {
    totalOnHand    += Number(x.onHandQty   || 0)
    totalReserved  += Number(x.reservedQty || 0)
    totalAvailable += Number(x.onHandQty   || 0) - Number(x.reservedQty || 0)
})

document.getElementById("dashOnHand").innerText    = totalOnHand
document.getElementById("dashReserved").innerText  = totalReserved
document.getElementById("dashAvailable").innerText = totalAvailable
document.getElementById("dashLots").innerText      = lots.length

// ======================
// Lot Detail
// ======================

let html = ""
lots.forEach(x => {
    const available = (x.onHandQty || 0) - (x.reservedQty || 0)
    html += `<tr>
        <td>${x.lotNo}</td>
        <td>${x.partNo ?? "-"}</td>
        <td>${x.location ?? "-"}</td>
        <td>${x.onHandQty ?? 0}</td>
        <td>${x.reservedQty ?? 0}</td>
        <td>${available}</td>
    </tr>`
})
document.getElementById("lotTable").innerHTML = html || `<tr><td colspan="6" class="text-center text-muted">No lots found</td></tr>`

// ======================
// Location + Part Summary
// ======================

const map = {}
lots.forEach(l => {
    const loc = l.location || "UNKNOWN"
    const key = loc + "_" + (l.partNo || "UNKNOWN")
    if (!map[key]) map[key] = { location: loc, partNo: l.partNo || "-", onHand: 0, reserved: 0, available: 0, lots: 0 }
    map[key].onHand    += Number(l.onHandQty   || 0)
    map[key].reserved  += Number(l.reservedQty || 0)
    map[key].available += Number(l.onHandQty   || 0) - Number(l.reservedQty || 0)
    map[key].lots++
})

let sumHtml = ""
Object.values(map)
    .sort((a, b) => a.location === b.location ? a.partNo.localeCompare(b.partNo) : a.location.localeCompare(b.location))
    .forEach(s => {
        sumHtml += `<tr>
            <td>${s.location}</td>
            <td>${s.partNo}</td>
            <td>${s.onHand}</td>
            <td>${s.reserved}</td>
            <td class="fw-bold">${s.available}</td>
            <td>${s.lots}</td>
        </tr>`
    })
document.getElementById("summaryTable").innerHTML = sumHtml || `<tr><td colspan="6" class="text-center text-muted">No data</td></tr>`

}



async function loadTransactions(){

let mo = getMo()

const result = await api(`/inventory/transactions?workOrder=${mo}&pageSize=50`, "GET")

let html=""

result.data.forEach(x=>{

html+=`
<tr>

<td>${x.transactionType}</td>
<td>${x.itemPartNo}</td>
<td>${x.lotNo}</td>
<td>${x.quantity}</td>
<td>${x.fromLocation ?? ""}</td>
<td>${x.toLocation ?? ""}</td>
<td>${x.performedBy}</td>
<td>${new Date(x.createdAt).toLocaleString()}</td>

</tr>
`

})

document.getElementById("transactionTable").innerHTML = html

}



loadLots()
loadTransactions()

</script>

}