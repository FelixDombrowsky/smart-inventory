        background-color: #8da9ff; /* สีฟ้าอ่อนตามรูป */
        border-radius: 10px;
    }

    /* ── Location Type filter: custom dropdown, icon+color จาก locationTypeMeta.js ── */
    .loc-filter-dd-wrap { position:relative; }
    .loc-filter-dd-trigger {
        display:flex; align-items:center; gap:6px; min-width:130px;
        padding:6px 11px; border:1px solid #dee2e6; border-radius:8px;
        font-size:12px; font-weight:600; font-family:inherit; background:#fff; color:var(--text);
        cursor:pointer; user-select:none; outline:none; transition:border-color .15s;
    }
    .loc-filter-dd-trigger:hover, .loc-filter-dd-trigger.open { border-color:var(--blue); }
    .loc-filter-dd-menu {
        position:fixed; min-width:180px; z-index:9999;
        background:#fff; border:1.5px solid #dee2e6; border-radius:9px;
        box-shadow:0 4px 16px rgba(0,0,0,.12); max-height:280px; overflow-y:auto;
    }
    .loc-filter-dd-item {
        display:flex; align-items:center; gap:8px; padding:8px 12px;
        font-size:13px; cursor:pointer; transition:background .1s;
    }
    .loc-filter-dd-item svg     { flex-shrink:0; }
    .loc-filter-dd-item:hover   { background:#f1f5ff; }
    .loc-filter-dd-item.active  { background:#eff6ff; }

    /* ── RANK / GAMIFICATION (My Tasks Today) ── */
    .rank-card { position:relative; overflow:hidden; }
    .rank-pill {
        display:inline-flex; align-items:center; gap:5px;
        padding:3px 11px 3px 8px; border-radius:20px; font-size:10.5px; font-weight:800;
        letter-spacing:.05em; text-transform:uppercase; white-space:nowrap;
        background:rgba(255,255,255,.12); border:1.5px solid rgba(255,255,255,.3);
        color:#fff; transition:border-color .35s, color .35s;
    }
    .rank-bar-track {
        position:relative; height:11px; background:rgba(255,255,255,.16);
        border-radius:10px; overflow:hidden;
    }
    .rank-bar-fill {
        height:100%; border-radius:10px; width:0%; position:relative; overflow:hidden;
        transition:width .85s cubic-bezier(.22,1,.36,1), background .4s;
    }
    .rank-bar-shimmer {
        position:absolute; inset:0;
        background:linear-gradient(110deg, transparent 35%, rgba(255,255,255,.55) 50%, transparent 65%);
        background-size:250% 100%; animation:rankShimmer 2.6s linear infinite;
    }
    @@keyframes rankShimmer { 0% { background-position:220% 0; } 100% { background-position:-60% 0; } }

    .rank-levelup-banner {
        position:absolute; top:12px; right:16px; z-index:5;
        font-size:11px; font-weight:800; letter-spacing:.04em;
        padding:5px 13px; border-radius:20px; color:#3a2a00;
        background:linear-gradient(135deg,#fff3c4,#ffd76a);
        box-shadow:0 6px 18px rgba(255,205,80,.55);
        opacity:0; pointer-events:none; transform:translateY(-10px) scale(.85);
        transition:opacity .35s, transform .35s;
    }
    .rank-card.level-up .rank-levelup-banner { opacity:1; transform:translateY(0) scale(1); }
    .rank-card.level-up { animation:rankCardPulse 1.7s ease; }
    @@keyframes rankCardPulse {
        0%   { box-shadow:0 0 0 0 rgba(255,255,255,0); }
        18%  { box-shadow:0 0 0 8px rgba(255,255,255,.18), 0 0 46px 12px var(--rank-glow, rgba(255,255,255,.4)); }
        100% { box-shadow:0 0 0 0 rgba(255,255,255,0); }
    }
    .rank-card.level-up .rank-pill { animation:rankPillBounce .65s ease; }
    @@keyframes rankPillBounce {
        0%,100% { transform:scale(1) rotate(0); }
        28% { transform:scale(1.35) rotate(-6deg); }
        55% { transform:scale(.92) rotate(3deg); }
        78% { transform:scale(1.08) rotate(0); }
    }
    .rank-card.level-up #dashTaskCount { animation:rankCountPop .65s ease; }
    @@keyframes rankCountPop {
        0%,100% { transform:scale(1); }
        40% { transform:scale(1.18); }
    }

    /* ตกแต่ง List Item ให้เหมือนในรูป */
    .wo-item {
        transition: all 0.2s;
        border-bottom: 1px solid #f0f0f0 !important;
    }
    .wo-item:hover { background-color: #fcfcfc; }
    /* ── Check Modal ── */
    .chk-overlay { display:none; position:fixed; inset:0; z-index:1500; align-items:flex-end; justify-content:center; }
    .chk-overlay.open { display:flex; }
    .chk-backdrop { position:absolute; inset:0; background:rgba(10,15,30,.55); backdrop-filter:blur(3px); }
    .chk-card {
        position:relative; width:min(520px,100vw); max-height:92vh;
        background:#fff; border-radius:20px 20px 0 0;
        box-shadow:0 -8px 40px rgba(0,0,0,.2);
        display:flex; flex-direction:column; overflow:hidden;
        transform:translateY(100%); transition:transform .3s cubic-bezier(.22,1,.36,1);
    }
    .chk-overlay.open .chk-card { transform:translateY(0); }
    .chk-handle { width:40px; height:4px; background:#e2e8f0; border-radius:2px; margin:10px auto 4px; flex-shrink:0; }
    .chk-head { display:flex; align-items:center; padding:4px 16px 10px; flex-shrink:0; }
    .chk-title { font-size:15px; font-weight:700; color:var(--ink); flex:1; }
    .chk-close-btn { width:32px; height:32px; border:none; border-radius:50%; background:#f1f5f9; color:#64748b; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
    .chk-mode-select {
        padding:6px 10px; border:1px solid #e2e8f0; border-radius:8px; background:#fff;
        font-size:12px; font-weight:600; color:var(--ink); outline:none; cursor:pointer;
        font-family:inherit; margin-right:8px; flex-shrink:0;
    }
    /* ── Parse mode result (ตาราง field ทั้งหมดที่ /label/parse อ่านได้ — ใช้เช็ค barcode vendor แบบละเอียด) ── */
    .chk-parse-hdr { font-size:11px; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin:0 0 6px; }
    .chk-parse-raw {
        font-family:ui-monospace,monospace; font-size:11.5px; color:#475569; background:#f8fafc;
        border:1px solid #e2e8f0; border-radius:8px; padding:8px 10px; margin-bottom:12px; word-break:break-all;
    }
    /* body = scrollable area below the header */
    .chk-body { display:flex; flex-direction:column; flex:1; min-height:0; overflow-y:auto; }
    .chk-left { display:flex; flex-direction:column; }
    .chk-right { display:flex; flex-direction:column; }
    .chk-camera-wrap { position:relative; width:100%; background:#000; flex-shrink:0; }
    .chk-camera-wrap video { width:100%; display:block; aspect-ratio:4/3; object-fit:cover; }
    .chk-camera-wrap canvas { position:absolute; inset:0; width:100%; height:100%; }
    .chk-label { font-size:11px; color:#94a3b8; text-align:center; padding:6px 12px 4px; min-height:24px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; flex-shrink:0; }
    .chk-cam-actions { display:flex; justify-content:center; gap:14px; padding:6px 0 10px; flex-shrink:0; }
    .chk-cam-btn { width:40px; height:40px; border:none; border-radius:50%; background:#f1f5f9; color:#475569; font-size:18px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:.15s; }
    .chk-cam-btn:hover { background:#e2e8f0; }
    .chk-result { padding:16px 20px 24px; }
    .chk-result-idle { text-align:center; color:#94a3b8; font-size:13px; padding:8px 0; }
    /* ── Landscape tablet: camera left, info right ── */
    @@media (orientation: landscape) {
        .chk-overlay { align-items:center; }
        .chk-card {
            width:min(900px,96vw); height:min(92vh,560px);
            max-height:none; border-radius:20px;
            box-shadow:0 8px 48px rgba(0,0,0,.25);
            transform:scale(.94); opacity:0;
            transition:transform .3s cubic-bezier(.22,1,.36,1), opacity .25s ease;
        }
        .chk-overlay.open .chk-card { transform:scale(1); opacity:1; }
        .chk-handle { display:none; }
        .chk-head { padding:12px 20px; border-bottom:1px solid #f1f5f9; }
        .chk-body { flex-direction:row; overflow:hidden; }
        .chk-left {
            width:52%; flex-shrink:0;
            border-right:1px solid #e5e7eb;
            overflow:hidden;
            background:#000;
        }
        .chk-camera-wrap { flex:1; min-height:0; }
        .chk-camera-wrap video { aspect-ratio:unset; height:100%; width:100%; object-fit:cover; }
        .chk-label { background:#000; color:#94a3b8; padding:4px 12px; }
        .chk-cam-actions { background:#000; padding:8px 0; }
        .chk-cam-btn { background:rgba(255,255,255,.15); color:#fff; }
        .chk-cam-btn:hover { background:rgba(255,255,255,.25); }
        .chk-hw-section { background:#111; }
        .chk-hw-input { background:#1e293b; border-color:#334155; color:#e2e8f0; }
        .chk-hw-status { color:#94a3b8; }
        .chk-right { flex:1; min-width:0; overflow-y:auto; }
        .chk-result { flex:1; padding:16px 20px; }
    }
    .chk-info-row { display:flex; align-items:baseline; gap:6px; padding:4px 0; font-size:14px; }
    .chk-info-label { color:#94a3b8; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; min-width:60px; }
    .chk-info-val { color:var(--ink); font-weight:600; }
    .chk-loc-row { display:flex; align-items:center; gap:6px; padding:4px 0; }
    .chk-loc-far  { color:#ef4444; font-weight:700; font-size:14px; }
    .chk-loc-near { color:#16a34a; font-weight:700; font-size:14px; }
    .chk-err-msg { color:#ef4444; font-size:14px; font-weight:600; text-align:center; padding:12px 0 8px; }
    .chk-action-row { display:flex; gap:10px; margin-top:14px; }
    .chk-btn { flex:1; padding:13px; border:none; border-radius:12px; font-size:14px; font-weight:700; font-family:inherit; cursor:pointer; transition:.15s; }
    .chk-btn-move    { background:linear-gradient(135deg,var(--tint),var(--tint-press)); color:#fff; box-shadow:0 4px 14px rgba(26,111,255,.35); }
    .chk-btn-receive { background:linear-gradient(135deg,#10b981,#059669); color:#fff; box-shadow:0 4px 14px rgba(16,185,129,.35); }
    .chk-btn-move:active, .chk-btn-receive:active, .chk-btn-nav:active { opacity:.85; transform:scale(.98); }
    .chk-btn-nav { background:#fff; border:1.5px solid var(--tint); color:var(--tint); box-shadow:0 2px 8px rgba(26,111,255,.15); }
    .chk-hw-section { padding:14px 20px 4px; flex-shrink:0; }
    .chk-hw-wrap { position:relative; }
    .chk-hw-wrap > i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--tint); font-size:16px; pointer-events:none; }
    .chk-hw-input { width:100%; padding:11px 12px 11px 38px; border:1.5px solid var(--tint); border-radius:10px; font-size:14px; font-family:inherit; color:var(--text); outline:none; box-sizing:border-box; }
    .chk-hw-status { text-align:center; font-size:12px; color:#94a3b8; margin-top:6px; min-height:18px; }
    .chk-mode-btn.hw-active { background:var(--tint); color:#fff; }
    .chk-dist { display:flex; align-items:center; gap:8px; padding:8px 0; font-size:13px; font-weight:600; flex-wrap:wrap; }
    .chk-dist i { font-size:15px; flex-shrink:0; }
    .chk-dist-ok   { color:#15803d; }
    .chk-dist-warn  { color:#d97706; }
    .chk-dist-far   { color:#dc2626; }
