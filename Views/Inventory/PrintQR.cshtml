    async function asmShowPreview() {
        const modal = document.getElementById('rpPreviewModal')
        const wrap  = document.getElementById('rpPreviewContent')
        modal.style.display = 'flex'
        wrap.innerHTML = '<div style="color:var(--t3);font-size:13px">Rendering…</div>'
        if (!asmOutputItem) { wrap.innerHTML = '<div style="color:var(--red)">No item</div>'; return }
        try {
            let src = asmOutputItem.previewSrc
            if (!src) {
                const cfg = asmLayoutConfig ?? {}
                src = await renderZplClient(asmOutputItem.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
                if (asmOutputItem) asmOutputItem.previewSrc = src
            }
            wrap.innerHTML = src
                ? `<img src="${escHtml(src)}" style="max-width:100%;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
                : '<div style="color:var(--amber);font-size:13px">Preview not available</div>'
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
    }

    async function asmSubmit() {
        const outputPartNo = document.getElementById('asmBomSelect').value
        if (!outputPartNo) { showToast('Please select a BOM', 'error'); return }
        const outputQty = parseInt(document.getElementById('asmOutputQty').value) || 0
        if (!outputQty) { showToast('Please enter Output QTY', 'error'); return }

        const unfilled = asmMaterials.filter(m => !m.lotNo)
        if (unfilled.length > 0) {
            showToast(`Missing Lot for ${unfilled.length} material(s): ${unfilled.map(m => m.inputPartNo).join(', ')}`, 'error')
            return
        }
        if (asmMaterials.length === 0) { showToast('Please select a BOM', 'error'); return }

        if (!asmOutputItem?.reviewed) {
            showToast('Please review the item data before printing', 'error'); return
        }

        const sel = document.getElementById('asmPrinterSelect')
        if (!sel.value) { showToast('Please select a printer', 'error'); return }

        try {
            await api('/inventory/assembly', 'POST', {
                outputPartNo,
                outputQty,
                printerIp: sel.value,
                materials: asmMaterials.map(m => ({ lotNo: m.lotNo, quantity: m.requiredQty })),
            })
            showToast('✅ Assemble & Print successful', 'success')
            asmMaterials.forEach(m => { m.lotNo = null })
            asmOutputItem = null
            asmRenderGuide()
        } catch (err) {
            showToast('❌ Failed: ' + (err?.message || String(err)), 'error')
        }
    }

    // ── Print History ──
    let _histPage = 1, _histTotalPages = 1

    async function loadHistory(page = 1) {
        _histPage = page
        const lot      = document.getElementById('histSearchLot').value.trim()
        const user     = document.getElementById('histSearchUser').value.trim()
        const success  = document.getElementById('histFilterSuccess').value
        const reprint  = document.getElementById('histFilterReprint').value
        const ps       = parseInt(document.getElementById('histPageSize').value)

        let url = `/printer/print-history?page=${page}&pageSize=${ps}`
        if (lot)              url += `&lotNo=${encodeURIComponent(lot)}`
        if (user)             url += `&printUser=${encodeURIComponent(user)}`
        if (success !== '')   url += `&success=${success}`
        if (reprint !== '')   url += `&isReprint=${reprint}`

        document.getElementById('histTable').innerHTML =
            `<tr><td colspan="8" style="text-align:center;color:var(--t2);padding:32px">Loading…</td></tr>`
        try {
            const res   = await api(url, 'GET')
            const rows  = Array.isArray(res) ? res : (res?.data || [])
            const total = res?.total ?? res?.totalCount ?? rows.length
            const cp    = res?.page ?? page

            document.getElementById('histCountBadge').textContent = total.toLocaleString() + ' records'
            _histTotalPages = Math.ceil(total / ps) || 1

            document.getElementById('histPageInfo').textContent = `Page ${cp} / ${_histTotalPages}`
            document.getElementById('histPageNum').textContent  = cp
            document.getElementById('histBtnPrev').disabled = (cp <= 1)
            document.getElementById('histBtnNext').disabled = (cp >= _histTotalPages)

            document.getElementById('histTable').innerHTML = rows.length === 0
                ? `<tr><td colspan="8" style="text-align:center;color:var(--t3);padding:32px">No records found</td></tr>`
                : rows.map(x => `<tr>
                    <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${x.lotNo ?? '—'}</td>
                    <td><span class="${x.isReprint ? 'hist-reprint' : 'hist-print'}">${x.isReprint ? 'Re-Print' : 'Print'}</span></td>
                    <td><span class="${x.success ? 'hist-success' : 'hist-fail'}">${x.success ? '✓ Success' : '✗ Failed'}</span></td>
                    <td style="font-family:ui-monospace,monospace;font-size:12px;color:var(--t2)">${x.printerIp ?? '—'}</td>
                    <td style="color:var(--navy);font-weight:500">${x.printUser ?? '—'}</td>
                    <td style="color:var(--t2);font-size:12px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${x.reprintReason ?? '—'}</td>
                    <td style="color:var(--red);font-size:12px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${x.errorMessage ?? '—'}</td>
                    <td style="color:var(--t2);font-size:12px;white-space:nowrap">${x.printedAt ? new Date(x.printedAt).toLocaleString('th-TH',{dateStyle:'short',timeStyle:'short'}) : '—'}</td>
                </tr>`).join('')
        } catch (err) {
            document.getElementById('histTable').innerHTML =
                `<tr><td colspan="8" style="text-align:center;color:var(--red);padding:32px">Load failed: ${err.message}</td></tr>`
        }
    }

    function histPrevPage() { if (_histPage > 1) loadHistory(_histPage - 1) }
    function histNextPage() { if (_histPage < _histTotalPages) loadHistory(_histPage + 1) }
    function histReset() {
        document.getElementById('histSearchLot').value    = ''
        document.getElementById('histSearchUser').value   = ''
        document.getElementById('histFilterSuccess').value = ''
        document.getElementById('histFilterReprint').value = ''
        loadHistory(1)
    }

    // ── Init ──
    renderChecklist(null)
    loadLayoutsIntoSelect()
    loadLayoutList()
    loadPrinters(false)
    rpLoadPrinters()
</script>
}

