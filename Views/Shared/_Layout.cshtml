<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SmartFactory Inventory</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />

    <style>
            /* ปรับแต่ง Font และพื้นหลัง */
            body {
                background-color: #f8f9fa;
                font-family: 'Inter', -apple-system, sans-serif;
            }

            /* สไตล์เมนูหลัก */
            .custom-nav .nav-link {
                color: #6c757d;
                font-weight: 500;
                font-size: 0.95rem;
                transition: all 0.2s;
            }

            .custom-nav .nav-link:hover {
                color: #0d6efd;
            }

            .custom-nav .nav-link.active {
                color: #1a4fc4 !important;
                font-weight: 700;
                position: relative;
            }

            .custom-nav .nav-link.active::after {
                content: '';
                position: absolute;
                bottom: -4px;
                left: 12px;
                right: 12px;
                height: 2.5px;
                background: #1a4fc4;
                border-radius: 2px;
            }

            /* Badge สีอ่อนแบบ Modern */
            .bg-success-light {
                background-color: #e6f9ef !important;
            }

            /* ปุ่มแบบมี Hover effect */
            .btn-light {
                background-color: #f3f4f6;
                border: none;
            }

            .btn-light:hover {
                background-color: #e5e7eb;
            }

            /* จัดการเส้นขอบเบาๆ */
            .border-bottom {
                border-color: #e5e7eb !important;
            }

            /* ── Global Dark Mode ── */
            html[data-theme="dark"] body                  { background-color:#0f172a !important; color:#cbd5e1; }
            html[data-theme="dark"] header.bg-white       { background-color:#1e293b !important; box-shadow:0 1px 0 #334155 !important; }
            html[data-theme="dark"] .custom-nav .nav-link { color:#94a3b8 !important; }
            html[data-theme="dark"] .custom-nav .nav-link:hover { color:#60a5fa !important; }
            html[data-theme="dark"] .custom-nav .nav-link.active { color:#60a5fa !important; }
            html[data-theme="dark"] .custom-nav .nav-link.active::after { background:#60a5fa; }
            html[data-theme="dark"] h5.text-dark, html[data-theme="dark"] .text-dark { color:#f1f5f9 !important; }
            html[data-theme="dark"] .text-muted           { color:#64748b !important; }
            html[data-theme="dark"] .btn-light            { background-color:#253347 !important; border-color:#334155; color:#94a3b8; }
            html[data-theme="dark"] .list-group-item      { background-color:#1e293b; border-color:#334155; color:#cbd5e1; }
            html[data-theme="dark"] .list-group-item:hover { background-color:#253347 !important; }
            html[data-theme="dark"] .list-group-item-action:focus { background-color:#253347 !important; color:#f1f5f9; }
            html[data-theme="dark"] .dropdown-menu        { background-color:#1e293b; border-color:#334155; }
            html[data-theme="dark"] .dropdown-item        { color:#cbd5e1; }
            html[data-theme="dark"] .dropdown-item:hover  { background-color:#253347; color:#f1f5f9; }
            html[data-theme="dark"] .dropdown-divider     { border-color:#334155; }
            html[data-theme="dark"] .border-top           { border-color:#334155 !important; }
            html[data-theme="dark"] footer                { background-color:#1e293b; color:#64748b; }
            #themeToggleBtn { transition:background .15s; }

            /* ── Mobile menu as overlay (don't push/reflow page content when toggled) ── */
            header.bg-white { position: relative; }
            @@media (max-width: 1199.98px) {
                #mobileMenu {
                    position: absolute;
                    top: 100%;
                    left: 0;
                    right: 0;
                    margin-top: 0 !important;
                    background: #fff;
                    box-shadow: 0 8px 24px rgba(0,0,0,.15);
                    z-index: 1050;
                    max-height: calc(100vh - 70px);
                    overflow-y: auto;
                }
                #mobileMenu .list-group { padding: 8px 16px 16px; }
            }
            html[data-theme="dark"] #mobileMenu { background:#1e293b; }
    </style>

</head>

<body>

