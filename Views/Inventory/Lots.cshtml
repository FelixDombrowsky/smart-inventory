@{
    ViewData["Title"] = "Lots";
}

<link rel="stylesheet" href="css/lots.css"/>

<!-- TOAST CONTAINER -->
<div class="toast-stack" id="toastStack"></div>

<!-- VOID MODAL -->
<div class="modal-overlay" id="voidModal">
    <div class="modal-box">
        @* <div class="modal-icon" style="background:var(--red-lt)">🗑️</div> *@
        @* <div class="modal-title">Void Lot</div> *@
        <div class="modal-lot">Lot No. &nbsp;<span id="voidLotNo">—</span></div>
        <div class="modal-field">
            <div class="modal-label"><span data-i18n="reasonForVoid">Reason for Void</span> <span style="color:var(--red)">*</span></div>
            <textarea class="modal-textarea" id="voidReason" placeholder="Enter reason..." data-i18n-placeholder="reasonPlaceholder"></textarea>
        </div>
        <div class="modal-error" id="voidError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="closeModal('voidModal')">Cancel</button>
            <button class="modal-btn modal-btn-red" data-i18n="voidLotTitle" onclick="confirmVoid()">Void Lot</button>
        </div>
    </div>
</div>

<!-- CHANGE STATUS MODAL — POST /inventory/lot/change-status { lotNo, newStatus: <id ของสถานะ> } -->
<div class="modal-overlay" id="changeStatusModal">
    <div class="modal-box">
        <div class="modal-title" data-i18n="changeStatusTitle">Change Lot Status</div>
        <div class="modal-lot">Lot No. &nbsp;<span id="csLotNo">—</span></div>
        <div class="modal-info-row">
            <span data-i18n="currentStatus">Current Status</span>
            <strong id="csCurrentStatus">—</strong>
        </div>
        <div class="modal-field">
            <div class="modal-label"><span data-i18n="newStatus">New Status</span> <span style="color:var(--red)">*</span></div>
            <select class="modal-input" id="csNewStatus" onchange="clearModalError('csError')"></select>
        </div>
        <div class="modal-error" id="csError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="closeModal('changeStatusModal')">Cancel</button>
            <button class="modal-btn modal-btn-amber" id="csConfirmBtn" onclick="confirmChangeStatus()"><span data-i18n="changeStatus">Change Status</span></button>
        </div>
    </div>
</div>

<!-- ADJUST MODAL -->
<div class="modal-overlay" id="adjustModal">
    <div class="modal-box">
        @* <div class="modal-icon" style="background:var(--amber-lt)">⚖️</div> *@
        @* <div class="modal-title">Adjust Lot</div> *@
        <div class="modal-lot">Lot No. &nbsp;<span id="adjustLotNo">—</span></div>
        <div class="modal-info-row">
            <span data-i18n="currentOnHand">Current On Hand</span>
            <strong id="adjustCurrentQty">—</strong>
        </div>
        <div class="modal-field">
            <div class="modal-label"><span data-i18n="newQuantity">New Quantity</span> <span style="color:var(--red)">*</span></div>
            <input class="modal-input" id="adjustNewQty" type="number" min="0" placeholder="0">
        </div>
        <div class="modal-error" id="adjustError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="closeModal('adjustModal')">Cancel</button>
            <button class="modal-btn modal-btn-amber" data-i18n="adjust" onclick="confirmAdjust()">Adjust</button>
        </div>
    </div>
</div>

<!-- VISUALIZE: 1) CONFIRM — สรุป filter ปัจจุบัน + จำนวน lot ก่อนโหลด (ข้อมูลเยอะ ต้องให้ user ยืนยันก่อน) -->
<div class="modal-overlay" id="vizConfirmModal">
    <div class="modal-box" style="max-width:460px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
            <div class="modal-icon" style="background:var(--blue-lt);color:var(--blue);margin:0;flex-shrink:0"><i class="bi bi-bar-chart-line"></i></div>
            <div class="modal-title" style="margin:0" data-i18n="vizConfirmTitle">Visualize Lots</div>
        </div>
        <div id="vizMacroBox" style="display:none"></div>
        <div id="vizConfirmFilters" class="viz-chips"></div>
        <div class="modal-info-row">
            <span data-i18n="vizRowCount">Lots to load</span>
            <strong id="vizRowCountVal">—</strong>
        </div>
        <div id="vizConfirmWarn" class="viz-warn" style="display:none"></div>
        <!-- ยังไม่ได้เลือก filter → ปุ่ม Visualize กดไม่ได้ ต้องเลือก filter (หรือใช้ filter แนะนำ) ก่อน -->
        <div id="vizBlankHint" class="viz-warn" style="display:none"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="closeModal('vizConfirmModal')">Cancel</button>
            <button class="modal-btn viz-btn-primary" id="vizGoBtn" onclick="vizStart()"><i class="bi bi-bar-chart-line"></i> <span data-i18n="vizGo">Visualize</span></button>
        </div>
    </div>
</div>

<!-- VISUALIZE: 2) LOADING — โหลดทีละหน้าพร้อม progress (ยกเลิกได้) -->
<div class="modal-overlay" id="vizLoadingModal">
    <div class="modal-box" style="max-width:400px;text-align:center">
        <div class="spinner-border text-primary" style="width:2.2rem;height:2.2rem;margin:4px 0 14px"></div>
        <div class="modal-title" data-i18n="vizLoadingTitle">Loading lots…</div>
        <div class="modal-lot" id="vizLoadingText" style="margin-bottom:12px">—</div>
        <div class="viz-progress"><div id="vizLoadingBar"></div></div>
        <div class="modal-actions" style="justify-content:center">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="vizCancel()">Cancel</button>
        </div>
    </div>
</div>

<!-- VISUALIZE: 3) RESULT — KPI + กราฟแท่ง (คลิกเพื่อเจาะลึก) + ตาราง drill-down Line → W/O → Lot -->
<div class="modal-overlay" id="vizModal">
    <div class="modal-box viz-box">
        <div class="viz-head">
            <!-- ย้อนกลับขึ้นไป 1 ระดับ (Part → W/O → Line → All Lines) — ซ่อนเมื่ออยู่ระดับบนสุด -->
            <button type="button" class="viz-close" id="vizBackBtn" onclick="vizBack()" title="Back" style="display:none"><i class="bi bi-arrow-left"></i></button>
            <div style="min-width:0">
                <div class="modal-title" style="margin:0" data-i18n="vizTitle">Lots Visualization</div>
                <div id="vizCrumbs" class="viz-crumbs"></div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;margin-left:auto">
                <div class="viz-toggle" id="vizMetricToggle">
                    <button type="button" data-metric="lots" class="active" onclick="vizSetMetric('lots')" data-i18n="vizMetricLots">Lots</button>
                    <button type="button" data-metric="qty" onclick="vizSetMetric('qty')" data-i18n="vizMetricQty">On Hand</button>
                </div>
                <button type="button" class="viz-close" onclick="closeModal('vizModal')" title="Close"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div class="viz-body">
            <div id="vizFilterNote" class="viz-chips" style="margin-bottom:10px"></div>
            <div id="vizKpis" class="viz-kpis"></div>
            <div class="viz-card">
                <div class="viz-card-head">
                    <span id="vizChartTitle">—</span>
                    <!-- Pareto 80/20 — เปิดแล้วลากเส้นตัดใต้กลุ่มแท่งที่รวมกันได้ 80% ของทั้งหมด แท่งที่เหลือเป็นสีจาง -->
                    <button type="button" class="viz-pareto-btn" id="vizParetoBtn" onclick="vizTogglePareto()" data-i18n-title="vizParetoTip"
                            title="Highlight the few items that make up 80% of the total">
                        <i class="bi bi-graph-up"></i> 80/20
                    </button>
                    <!-- เลือกระบายสีแท่งกราฟตาม เวลาใน Location / Delay — legend ด้านขวาเปลี่ยนตาม -->
                    <label class="viz-colorby" style="margin-left:auto">
                        <span data-i18n="vizColorBy">Color by</span>
                        <select id="vizColorBy" onchange="vizSetColorBy(this.value)">
                            <option value="inloc" data-i18n="vizColorInLoc">Time in location</option>
                            <option value="delay" data-i18n="vizColorDelay">Delay (vs PD Deadline)</option>
                        </select>
                    </label>
                    <span id="vizLegend" class="viz-legend" style="margin-left:0"></span>
                    <!-- Download PDF ของ scope ที่ดูอยู่ (KPI + กราฟแท่งครบทุกแถว + Pareto 80/20) -->
                    <button type="button" class="viz-pdf-btn" onclick="vizExportPdf(this)" data-i18n-title="vizPdfTip" title="Download PDF">
                        <i class="bi bi-file-earmark-arrow-down"></i> PDF
                    </button>
                </div>
                <div id="vizChart" class="viz-chart"></div>
            </div>
            <div class="viz-card">
                <div class="viz-card-head"><span id="vizTableTitle">—</span></div>
                <div id="vizTable" style="overflow-x:auto"></div>
            </div>
        </div>
    </div>
</div>

<!-- EXPORT CONFIRM MODAL -->
<div class="modal-overlay" id="exportConfirmModal">
    <div class="modal-box">
        <div class="modal-title" data-i18n="exportConfirmTitle">Export to Excel</div>
        <div class="modal-lot" data-i18n="exportConfirmSub">This will export every lot matching your current filters.</div>
        <div class="modal-info-row">
            <span data-i18n="exportRowCount">Rows to export</span>
            <strong id="exportRowCountVal">—</strong>
        </div>
        <!-- ไม่ได้เลือก filter อะไรเลย = ข้อมูลทั้งระบบ (หลักแสนแถว) — ห้าม Export ต้องเลือก filter ก่อน -->
        <div id="exportBlankWarn" class="viz-warn" style="display:none">
            <i class="bi bi-exclamation-triangle"></i> <span data-i18n="exportBlankWarn">No filter selected — too much data to export. Please select at least one filter first.</span>
        </div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="closeModal('exportConfirmModal')">Cancel</button>
            <button class="modal-btn modal-btn-green" id="exportConfirmBtn" data-i18n="exportExcel" onclick="confirmExportLots()">Export Excel</button>
        </div>
    </div>
</div>

<!-- EXPORT PROGRESS — โหลดข้อมูลทีละหน้า (จำกัดจำนวน request พร้อมกัน) พร้อมแถบ progress + ยกเลิกได้ -->
<div class="modal-overlay" id="exportProgressModal">
    <div class="modal-box" style="max-width:400px;text-align:center">
        <div class="spinner-border text-success" style="width:2.2rem;height:2.2rem;margin:4px 0 14px"></div>
        <div class="modal-title" data-i18n="exportLoadingTitle">Preparing Excel…</div>
        <div class="modal-lot" id="exportProgressText" style="margin-bottom:12px">—</div>
        <div class="viz-progress"><div id="exportProgressBar" style="background:var(--green)"></div></div>
        <div class="modal-actions" style="justify-content:center">
            <button class="modal-btn modal-btn-cancel" data-i18n="cancel" onclick="cancelExportLots()">Cancel</button>
        </div>
    </div>
</div>

<!-- TABLE SECTION — เอา banner หัวหน้า (Inventory Lots + Total Lots) ออกแล้ว: ชื่อหน้าอยู่ที่แถบบนของ layout,
     จำนวน Total Lots ย้ายมาเป็น badge ข้างหัวตาราง (#lotsTotal — loadLots เติมค่าเหมือนเดิม) -->
<div class="section-card">
    <div class="sc-head">
        <div class="sc-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" style="stroke:var(--blue)" stroke-width="2.5">
                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
            </svg>
            <span data-i18n="lots">Lots</span>
            <span class="count-badge" title="Total Lots" data-i18n-title="totalLots"><span id="lotsTotal">—</span></span>
        </div>
        <!-- Visualize / Export Excel — บรรทัดเดียวกับหัวตาราง ชิดขวา (filter อยู่แถวล่างเต็มความกว้าง) -->
        <div class="sc-actions">
            <button type="button" class="btn-visualize" id="btnVisualize" onclick="vizOpenConfirm()">
                <i class="bi bi-bar-chart-line"></i><span data-i18n="vizGo">Visualize</span>
            </button>
            <button type="button" class="btn-export" id="btnExportExcel" onclick="openExportConfirm()">
                <i class="bi bi-file-earmark-excel"></i><span data-i18n="exportExcel">Export Excel</span>
            </button>
        </div>
        <div class="filter-bar">
            <input id="filterPartNo"   class="filter-input" placeholder="Part No." data-i18n-placeholder="partNoPlaceholder"
                   oninput="lotsDebouncedSearch()">
            <input id="filterWO"       class="filter-input" placeholder="Work Order" data-i18n-placeholder="woPlaceholder"
                   oninput="lotsDebouncedSearch()">
            <input id="filterLotNo" class="filter-input" placeholder="Lot No." data-i18n-placeholder="lotNoPlaceholder"
                   oninput="lotsDebouncedSearch()">
            <input id="filterLine"     class="filter-input" placeholder="Line" data-i18n-placeholder="linePlaceholder" style="width:110px"
                   oninput="lotsDebouncedSearch()">
            <label class="avail-toggle">
                <input type="checkbox" id="filterAvailable" onchange="searchLots()">
                <span data-i18n="available">Available</span>
            </label>
            <!-- Delay / In Location — ปุ่มเดียวต่อ filter เปิด popover เลือกด่วน + กำหนดช่วงเองพร้อมหน่วย นาที/ชม./วัน (js/lotsRangeFilter.js)
                 ค่าจริงเก็บเป็น "นาที" ใน hidden input ด้านล่าง — _buildLotsFilterBody() อ่านจากตรงนี้ -->
            <div class="rng-wrap">
                <button type="button" class="rng-btn" id="rngBtn_delay" onclick="rngToggle('delay', event)">
                    <i class="bi bi-alarm"></i><span class="rng-lbl">Delay</span><i class="bi bi-chevron-down rng-chev"></i>
                </button>
                <div class="rng-pop" id="rngPop_delay" style="display:none"></div>
                <input type="hidden" id="filterDelayMin"><input type="hidden" id="filterDelayMax">
            </div>
            <div class="rng-wrap">
                <button type="button" class="rng-btn" id="rngBtn_inloc" onclick="rngToggle('inloc', event)">
                    <i class="bi bi-hourglass-split"></i><span class="rng-lbl">In Location</span><i class="bi bi-chevron-down rng-chev"></i>
                </button>
                <div class="rng-pop" id="rngPop_inloc" style="display:none"></div>
                <input type="hidden" id="filterInLocMin"><input type="hidden" id="filterInLocMax">
            </div>
            <!-- Location picker — รวม Location + Location Type เป็นช่องเดียว (แบบเดียวกับ Dashboard, CSS .locpick ใน site.css)
                 กดแล้วเปิดแผง: ค้นหา / chip ประเภท / รายชื่อ location — ดู lotLocPick* ในสคริปต์
                 element เดิม (#filterLocation, #filterLocationDd, #filterLocationType, #filterLocationTypeLabel, #filterLocationTypeMenu)
                 คงไว้แบบซ่อน: locAcPick / filterLocationTypeDdPick / _applyUrlFilters / filter แนะนำของ Visualize (lotsVisualize.js) ยังใช้อยู่ -->
            <div class="locpick" id="lotLocPick">
                <button type="button" class="locpick-trigger" id="lotLocPickTrigger" onclick="lotLocPickToggle()"
                        aria-haspopup="dialog" aria-expanded="false" aria-controls="lotLocPickPanel">
                    <span class="locpick-ico"><i class="bi bi-geo-alt"></i></span>
                    <span class="locpick-label" id="lotLocPickLabel">All Locations</span>
                    <i class="bi bi-chevron-down locpick-chev"></i>
                </button>
                <button type="button" class="locpick-clear" id="lotLocPickClear" onclick="lotLocPickClear()" aria-label="Clear location filter" hidden>
                    <i class="bi bi-x-lg"></i>
                </button>
                <div class="locpick-panel" id="lotLocPickPanel" role="dialog" aria-label="Location filter" hidden>
                    <div class="locpick-search">
                        <i class="bi bi-search"></i>
                        <input id="lotLocPickSearch" placeholder="Search location name or code…" data-i18n-placeholder="locSearchPlaceholder" autocomplete="off"
                               oninput="lotLocPickRenderList()" onkeydown="lotLocPickKey(event)" aria-label="Search location">
                    </div>
                    <div class="locpick-types" id="lotLocPickTypes" role="group" aria-label="Location type"></div>
                    <div class="locpick-list" id="lotLocPickList" role="listbox"></div>
                </div>
                <input type="hidden" id="filterLocation">
                <div id="filterLocationDd" hidden></div>
                <input type="hidden" id="filterLocationType" value="">
                <span id="filterLocationTypeLabel" hidden>All Locations</span>
                <div id="filterLocationTypeMenu" hidden style="display:none"></div>
            </div>
            <div class="loc-filter-dd-wrap">
                <div class="loc-filter-dd-trigger" id="filterLotStatusTrigger" tabindex="0" onclick="toggleFilterDd('filterLotStatusTrigger','filterLotStatusMenu')">
                    <span id="filterLotStatusLabel">Available</span>
                    <i class="bi bi-chevron-down" style="font-size:11px;margin-left:auto;color:var(--t2)"></i>
                </div>
                <div class="loc-filter-dd-menu" id="filterLotStatusMenu" style="display:none">
                    <div class="loc-filter-dd-item active" data-val="" data-i18n="allStatus" onclick="filterLotStatusDdPick('', 'All Status')">All Status</div>
                </div>
                <!-- ค่าเริ่มต้น = Available (เลือก All Status เพื่อดูทุกสถานะ) -->
                <input type="hidden" id="filterLotStatus" value="Available">
            </div>
            <div class="loc-filter-dd-wrap">
                <div class="loc-filter-dd-trigger" id="filterItemTypeTrigger" tabindex="0" onclick="toggleFilterDd('filterItemTypeTrigger','filterItemTypeMenu')">
                    <span id="filterItemTypeLabel">All Item Types</span>
                    <i class="bi bi-chevron-down" style="font-size:11px;margin-left:auto;color:var(--t2)"></i>
                </div>
                <div class="loc-filter-dd-menu" id="filterItemTypeMenu" style="display:none">
                    <div class="loc-filter-dd-item active" data-val="" data-i18n="allItemTypes" onclick="filterItemTypeDdPick('')">All Item Types</div>
                </div>
                <input type="hidden" id="filterItemType" value="">
            </div>
            <partial name="_DateRangePicker" model="@("lot")" />
        </div>
    </div>

    <div style="overflow-x:auto">
        <table class="inv-table">
            <thead>
                <tr>
                    <th id="th-LotNo"       data-i18n="colLotNo"       onclick="sort('LotNo')">Lot No.</th>
                    <th id="th-PartNo"      data-i18n="colPartNo"      onclick="sort('PartNo')">Part No.</th>
                    <th class="no-sort"     data-i18n="colDescription">Description</th>
                    <th id="th-WorkOrder"   data-i18n-title="colWorkOrder" title="Work Order" onclick="sort('WorkOrder')" data-i18n="colWO">W/O</th>
                    <th id="th-LineName"    data-i18n="colLine"        onclick="sort('LineName')">Line</th>
                    <th id="th-Location"    data-i18n="colLocation"    onclick="sort('Location')">Location</th>
                    <th id="th-Status"      data-i18n="colStatus">Status</th>
                    <th id="th-OnHandQty" data-i18n-title="colOnHand" title="On Hand" onclick="sort('OnHandQty')" data-i18n="colOH">OH</th>
                    <th id="th-ReservedQty" data-i18n-title="colReserved" title="Reserved" onclick="sort('ReservedQty')" data-i18n="colRS">RS</th>
                    <th id="th-ConsumedQty" data-i18n-title="colConsumed" title="Consumed" onclick="sort('ConsumedQty')" data-i18n="colCS">CS</th>
                    <th id="th-Available" data-i18n-title="colAvailable" title="Available" onclick="sort('Available')" class="sort-desc" data-i18n="colAV">AV</th>
                    <th id="th-CreatedAt"data-i18n="colCreatedAt"   onclick="sort('CreatedAt')">Created At</th>
                    <th id="th-LocationEnteredAt" data-i18n-title="colLocationEnteredAt" title="Location Entered At" onclick="sort('LocationEnteredAt')" data-i18n="colLocEnterShort">Loc Enter</th>
                    <th id="th-ProductionDeadlineAt" data-i18n-title="colProductionDeadlineAt" title="Production Deadline At" onclick="sort('ProductionDeadlineAt')" data-i18n="colPdDeadlineShort">PD Deadline</th>
                    <th id="th-DelayTimeMinutes" data-i18n-title="colDelayMinutes" title="Delay Time (minutes)" onclick="sort('DelayTimeMinutes')" data-i18n="colDelayShort">Delay</th>
                    <th id="th-InLocationDurationMinutes" data-i18n-title="colInLocMinutes" title="In Location Duration (minutes)" onclick="sort('InLocationDurationMinutes')" data-i18n="colInLocShort">In Loc</th>
                    <th class="no-sort" style="text-align:center" data-i18n="colAction">Action</th>
                </tr>
            </thead>
            <tbody id="lotTable"></tbody>
        </table>
    </div>

    <div class="pag-bar">
        <div style="display:flex;align-items:center;gap:10px">
            <select class="pag-size" id="pageSize" onchange="changePageSize()">
                <option value="10" selected>10 rows</option>
                <option value="20">20 rows</option>
                <option value="50">50 rows</option>
                <option value="100">100 rows</option>
            </select>
            <span class="pag-info"><span data-i18n="showingPage">Showing page</span> <span id="pageInfo">—</span></span>
        </div>
        <div class="pag-btns">
            <button id="btnPrev" class="pag-btn" onclick="prevPage()">← <span data-i18n="prev">Prev</span></button>
            <span class="pag-nums" id="pageNumberBtns"></span>
            <button id="btnNext" class="pag-btn" onclick="nextPage()"><span data-i18n="next">Next</span> →</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/pager.js"></script>
<script src="js/locationTypeMeta.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/lotStatusTypeMeta.js"></script>
<script src="js/itemTypeMeta.js"></script>
<script src="js/dateRangePicker.js"></script>
<script src="js/lotsVisualize.js"></script>
<script src="js/lotsRangeFilter.js"></script>
<script>
    let page = 1, totalPages = 1
    let sortBy = "CreatedAt", desc = true
    var _lastLotRows = []   // แถวในหน้าตารางปัจจุบัน — modal Change Status ใช้หาสถานะเดิมของ lot
    let canAdjust = false
    let canVoid   = false
    let canExportExcel = false
    let _lastTotalLot = 0   // totalLot ล่าสุดจาก loadLots() — ใช้โชว์ preview จำนวนแถวใน modal ยืนยัน Export (กันกดพลาด)

    // คำแปลของหน้านี้ (LOTS_LABELS มาจาก js/i18n.js) — เรียก lotsDict() สดทุกจุดที่สร้างข้อความแทน hardcode
    function lotsDict() { return LOTS_LABELS[getCurrentLang()] || LOTS_LABELS.en }

    // รูปแบบสากล ISO 8601-ish (YYYY-MM-DD HH:mm) — เลี่ยง locale th-TH เพราะได้ปี พ.ศ. ที่สับสนตอนสื่อสารข้ามระบบ/ประเทศ (เหมือน LotDetail.cshtml)
    // PD Deadline = สีแดง เมื่อ Late:
    //  - อยู่ใน Location type Production แล้ว → Late ถ้า Loc Enter เลย PD Deadline (เข้าช้ากว่ากำหนด)
    //  - ยังไม่อยู่ใน Production → Late ถ้าเวลาปัจจุบันเลย PD Deadline แล้ว
    // คืนจำนวน ms ที่ Late (0 = ไม่ Late)
    function lateMs(x) {
        if (!x.productionDeadlineAt) return 0
        const deadline = new Date(x.productionDeadlineAt).getTime()
        if (isNaN(deadline)) return 0
        const inProduction = (_locNameMap.get(x.location)?.typeName || '').toLowerCase() === 'production'
        let ref = Date.now()
        if (inProduction) {
            ref = x.locationEnteredAt ? new Date(x.locationEnteredAt).getTime() : NaN
            if (isNaN(ref)) return 0
        }
        return ref > deadline ? ref - deadline : 0
    }
    function isLocEnterLate(x) { return lateMs(x) > 0 }

    // "3d 4h 25m" — วัน/ชั่วโมง/นาที (ข้ามหน่วยที่เป็น 0 ด้านหน้า)
    function fmtLate(ms) {
        const mins = Math.max(1, Math.floor(ms / 60000))
        const d = Math.floor(mins / 1440), h = Math.floor((mins % 1440) / 60), m = mins % 60
        return d ? `${d}d ${h}h ${m}m` : h ? `${h}h ${m}m` : `${m}m`
    }

    // Part No. + badge Item Type — ถ้า /inventory/lots ไม่ส่ง itemType มา จะ fallback ไปดึงจาก /master/items/{partNo} (cache ต่อ partNo)
    const _escHtml = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
    let _partTypeCache = {}   // partNo → item type name ('' = ไม่มี type)
    function partNoBadge(partNo, itemType) {
        const label = _escHtml(partNo || '')
        const type  = itemType || _partTypeCache[partNo]
        if (!type) return `<span style="font-weight:600;color:var(--navy)">${label}</span>`
        return `<span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:700;padding:2px 9px;border-radius:6px;font-family:ui-monospace,monospace;${itemTypeBadgeStyle(type)}" title="${_escHtml(String(type))}">${itemTypeIcon(type)}${label}</span>`
    }
    // Item Type / Location Type ไม่มีคอลัมน์ในตารางแล้ว — ใช้เฉพาะตอน Export
    // คอลัมน์นาทีจาก API (delayTimeMinutes / inLocationDurationMinutes) — น้อยกว่า 1 วันแสดงเป็นนาที (m), ตั้งแต่ 1 วันขึ้นไปแสดงเป็นวัน (d)
    // tooltip บอกค่าเต็มเป็น วัน/ชม./นาที + จำนวนนาทีจริง; delay: ค่าบวก = ล่าช้า (แดง) / ค่าลบ = ยังไม่ล่าช้า (เขียว)
    function minutesCell(v, isDelay) {
        if (v == null || isNaN(Number(v))) return `<td style="color:var(--t3);font-size:12px">—</td>`
        const n = Number(v), abs = Math.abs(n), sign = n < 0 ? '-' : ''
        const d = Math.floor(abs / 1440), h = Math.floor((abs % 1440) / 60), m = Math.floor(abs % 60)
        const full = `${sign}${d ? d + 'd ' : ''}${d || h ? h + 'h ' : ''}${m}m  (${n.toLocaleString(undefined, { maximumFractionDigits: 2 })} min)`
        const text = abs >= 1440
            ? `${sign}${(abs / 1440).toLocaleString(undefined, { maximumFractionDigits: 1 })} d`
            : `${sign}${Math.round(abs).toLocaleString()} m`
        const color = !isDelay ? 'var(--t2)' : n > 0 ? 'var(--red)' : n < 0 ? 'var(--green)' : 'var(--t2)'
        return `<td style="color:${color};font-weight:${isDelay && n !== 0 ? 700 : 400};font-size:12px;white-space:nowrap" title="${full}">${isDelay && n > 0 ? '+' : ''}${text}</td>`
    }
    function lotLocType(x) { return x.locationTypeName ?? x.locationType ?? _locNameMap.get(x.location)?.typeName ?? '' }
    async function loadPartTypes(rows) {
        const need = [...new Set(rows.filter(x => x.partNo && !(x.itemTypeName ?? x.itemType) && !(x.partNo in _partTypeCache)).map(x => x.partNo))]
        await Promise.all(need.map(async p => {
            try {
                const item = await api(`/master/items/${encodeURIComponent(p)}`, 'GET')
                _partTypeCache[p] = String(item?.itemTypeName ?? item?.itemType ?? '')
            } catch { _partTypeCache[p] = '' }
            document.querySelectorAll('#lotTable td.lot-part-cell').forEach(td => {
                if (td.dataset.part === p) td.innerHTML = partNoBadge(p)
            })
        }))
    }

    // ช่อง Line — ถ้าได้มาจาก W/O (Lot ไม่มี Line เอง) ใส่ขอบประ + tooltip บอกที่มา
    function lotLineCell(x) {
        const v = x.lineName || '—'
        return x._lineFromWo
            ? `<span title="Line from W/O ${_escHtml(x.workOrder)}" style="background:#f0f2f5;color:#475569;padding:1px 7px;border-radius:5px;font-size:11px;font-weight:600;border:1px dashed #94a3b8">${_escHtml(v)}</span>`
            : `<span style="background:#f0f2f5;color:#475569;padding:2px 8px;border-radius:5px;font-size:11px;font-weight:600">${_escHtml(v)}</span>`
    }

    function fmtDate(d) {
        if (!d) return "—"
        const dt  = new Date(d)
        const pad = n => String(n).padStart(2, "0")
        return `${pad(dt.getDate())}/${pad(dt.getMonth() + 1)}/${dt.getFullYear()} ${pad(dt.getHours())}:${pad(dt.getMinutes())}`
    }

    // badge ชื่อ Location พร้อม icon+สีตาม type (join เอา type จาก _locNameMap เหมือนหน้า WorkOrderLots/Printers)
    function locBadgeForCode(code) {
        if (!code) return '—'
        const loc = _locNameMap.get(code)
        const name = loc?.displayName || code
        const type = loc?.typeName || ''
        if (!type) return name
        return `<span style="font-size:11px;font-weight:700;padding:2px 9px;border-radius:20px;${locTypeBadgeStyle(type)};white-space:nowrap;display:inline-flex;align-items:center;gap:5px">${locHierTypeIcon(type)}${name}</span>`
    }

    async function loadLocationTypes() {
        try {
            const types = await api('/location/types', 'GET')
            const arr = Array.isArray(types) ? types : (types?.data ?? [])
            _lotLocTypes = arr   // chip ประเภทใน Location picker
            const menu = document.getElementById('filterLocationTypeMenu')
            menu.innerHTML = `<div class="loc-filter-dd-item active" data-val="" data-i18n="allLocations" onclick="filterLocationTypeDdPick('', 'All Locations')">${lotsDict().allLocations}</div>` +
                arr.map(t => {
                    const label = t.displayName ?? t.name
                    return `<div class="loc-filter-dd-item" data-val="${t.name}" onclick="filterLocationTypeDdPick('${t.name}', '${label}')">
                        ${locHierTypeIcon(label)} <span style="color:${locTypeMeta(label).color};font-weight:600">${label}</span>
                    </div>`
                }).join('')
            // sync ป้าย/ไฮไลต์ของค่าที่ตั้งไว้ก่อนเมนูโหลดเสร็จ (เช่นมาจาก URL ?locationType= — _applyUrlFilters) — silent ไม่สั่งค้นหาซ้ำ
            const cur = document.getElementById('filterLocationType').value
            const hit = arr.find(t => (t.name || '').toLowerCase() === cur.toLowerCase())
            if (cur) filterLocationTypeDdPick(hit ? hit.name : cur, hit ? (hit.displayName ?? hit.name) : cur, true)
            lotLocPickRenderLabel()
        } catch (err) {
            console.error('loadLocationTypes:', err)
        }
    }

    // ── Custom filter dropdowns (Location Type / Lot Status) — trigger+menu ใช้ CSS .loc-filter-dd-* ร่วมกัน ──
    const _FILTER_DD_IDS = [
        { trigger: 'filterLocationTypeTrigger', menu: 'filterLocationTypeMenu' },
        { trigger: 'filterLotStatusTrigger',    menu: 'filterLotStatusMenu' },
        { trigger: 'filterItemTypeTrigger',     menu: 'filterItemTypeMenu' },
    ]
    function closeAllFilterDd() {
        _FILTER_DD_IDS.forEach(({ trigger, menu }) => {
            const menuEl = document.getElementById(menu)
            const trgEl  = document.getElementById(trigger)
            if (menuEl) menuEl.style.display = 'none'
            if (trgEl)  trgEl.classList.remove('open')
        })
    }
    function toggleFilterDd(triggerId, menuId) {
        const menu    = document.getElementById(menuId)
        const trigger = document.getElementById(triggerId)
        const opening = menu.style.display === 'none'
        closeAllFilterDd()
        if (opening) {
            const r = trigger.getBoundingClientRect()
            menu.style.left     = r.left + 'px'
            menu.style.top      = (r.bottom + 4) + 'px'
            menu.style.minWidth = r.width + 'px'
            menu.style.display  = ''
            trigger.classList.add('open')
        }
    }
    window.addEventListener('scroll', e => {
        _FILTER_DD_IDS.forEach(({ menu }) => {
            const el = document.getElementById(menu)
            if (el && el.style.display !== 'none' && !el.contains(e.target)) el.style.display = 'none'
        })
    }, true)
    window.addEventListener('resize', closeAllFilterDd)
    document.addEventListener('click', e => {
        if (!e.target.closest('.loc-filter-dd-wrap')) closeAllFilterDd()
    })

    // silent = ตั้งค่าอย่างเดียว ไม่สั่งค้นหา (ใช้ตอน macro ตั้งหลาย filter พร้อมกันแล้วโหลดครั้งเดียว — ดู lotsVisualize.js)
    function filterLocationTypeDdPick(val, label, silent) {
        document.getElementById('filterLocationType').value = val
        document.getElementById('filterLocationTypeLabel').innerHTML = val
            ? `${locHierTypeIcon(label)} <span style="color:${locTypeMeta(label).color};font-weight:600">${label}</span>`
            : lotsDict().allLocations
        document.querySelectorAll('#filterLocationTypeMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        closeAllFilterDd()
        if (!silent) searchLots()
    }

    // ── Lot Status filter dropdown (รายชื่อ status ดึงจาก API, icon+color จาก lotStatusTypeMeta.js) ──
    async function loadLotStatusOptions() {
        try {
            const res  = await api('/inventory/lot/status-type', 'GET')
            const arr  = Array.isArray(res) ? res : (res?.data ?? [])
            _lotStatusTypes = arr.filter(s => s && s.id != null && s.name)   // ใช้กับ modal Change Status (ส่ง id)
            const menu = document.getElementById('filterLotStatusMenu')
            menu.innerHTML = `<div class="loc-filter-dd-item active" data-val="" data-i18n="allStatus" onclick="filterLotStatusDdPick('', 'All Status')">${lotsDict().allStatus}</div>` +
                arr.map(s => {
                    const name = s.name
                    return `<div class="loc-filter-dd-item" data-val="${name}" onclick="filterLotStatusDdPick('${name}', '${name}')">
                        ${lotStatusIcon(name)} <span class="lot-status-name" style="color:${lotStatusMeta(name).color};font-weight:600">${lotStatusLabel(name)}</span>
                    </div>`
                }).join('')
            // sync ป้าย/ไฮไลต์ของค่าที่เลือกอยู่ (ค่าเริ่มต้น Available) ให้ตรงกับชื่อจริงจาก API — silent ไม่สั่งค้นหาซ้ำ
            const cur = document.getElementById('filterLotStatus').value
            const hit = arr.find(s => (s.name || '').toLowerCase() === cur.toLowerCase())
            if (cur) filterLotStatusDdPick(hit ? hit.name : cur, hit ? hit.name : cur, true)
        } catch (err) {
            console.error('loadLotStatusOptions:', err)
        }
    }
    function filterLotStatusDdPick(val, label, silent) {
        document.getElementById('filterLotStatus').value = val
        document.getElementById('filterLotStatusLabel').innerHTML = val
            ? `${lotStatusIcon(val)} <span style="color:${lotStatusMeta(val).color};font-weight:600">${lotStatusLabel(label)}</span>`
            : lotsDict().allStatus
        document.querySelectorAll('#filterLotStatusMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        closeAllFilterDd()
        if (!silent) searchLots()
    }

    // ── Location autocomplete — ค้นจาก locations ที่ loadLocation() โหลดไว้แล้ว (locationCode หรือ displayName) ──
    let _locFilterCode = '', _locFilterLabel = ''   // code = ค่าที่ส่ง filter / label = ชื่อที่ user เห็นในช่อง
    function locAcClose() { document.getElementById('filterLocationDd').style.display = 'none' }
    function locAcInput(q) {
        const dd = document.getElementById('filterLocationDd')
        const val = q.trim()
        // พิมพ์แก้เองหลังเลือก = ล้าง filter เดิม ต้องเลือกจากรายการใหม่ (ล้างช่องจนว่าง = เอา filter ออก)
        if (_locFilterCode && val.toLowerCase() !== _locFilterLabel.toLowerCase()) {
            _locFilterCode = ''; _locFilterLabel = ''
            if (!val) searchLots()
        }
        if (!val) { locAcClose(); return }
        const needle = val.toLowerCase()
        const hits = (typeof locations !== 'undefined' ? locations : [])
            .filter(l => l.isActive !== false && l.locationCode &&
                ((l.locationCode || '').toLowerCase().includes(needle) || (l.displayName || '').toLowerCase().includes(needle)))
            .sort((a, b) => {
                // ขึ้นต้นด้วยคำที่พิมพ์ก่อน แล้วค่อยเรียงตามรหัส
                const ap = a.locationCode.toLowerCase().startsWith(needle) ? 0 : 1
                const bp = b.locationCode.toLowerCase().startsWith(needle) ? 0 : 1
                return ap - bp || a.locationCode.localeCompare(b.locationCode)
            })
            .slice(0, 20)
        const r = document.getElementById('filterLocation').getBoundingClientRect()
        dd.style.left = r.left + 'px'
        dd.style.top  = (r.bottom + 4) + 'px'
        dd.innerHTML = hits.length === 0
            ? `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">No locations found</div>`
            : hits.map(l => `<div class="loc-ac-item" data-code="${_escHtml(l.locationCode)}"
                    style="padding:8px 12px;font-size:13px;cursor:pointer;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px"
                    onmouseover="this.style.background='var(--blue-lt)'" onmouseout="this.style.background=''">
                    <span style="font-size:13px;font-weight:700;color:var(--navy)">${_escHtml(l.displayName || l.locationCode)}</span>
                    ${l.displayName && l.displayName !== l.locationCode ? `<span style="flex:1;min-width:0;text-align:right;font-family:ui-monospace,monospace;color:var(--t3);font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${_escHtml(l.locationCode)}</span>` : ''}
                </div>`).join('')
        dd.style.display = 'block'
    }
    function locAcPick(code) {
        _locFilterCode  = code
        _locFilterLabel = locName(code)   // แสดงชื่อ (displayName) ให้ user เห็น แต่ filter ด้วย locationCode
        document.getElementById('filterLocation').value = _locFilterLabel
        locAcClose()
        searchLots()
    }
    document.getElementById('filterLocationDd').addEventListener('mousedown', e => {
        const it = e.target.closest('.loc-ac-item')
        if (it) { e.preventDefault(); locAcPick(it.dataset.code) }
    })
    document.addEventListener('click', e => { if (!e.target.closest('#filterLocation, #filterLocationDd')) locAcClose() })
    window.addEventListener('scroll', e => { if (!e.target.closest?.('#filterLocationDd')) locAcClose() }, true)
    window.addEventListener('resize', locAcClose)

    // ── LOCATION PICKER (#lotLocPick) — ช่องเดียวคุม Location Type + Location เจาะจง (แบบเดียวกับ Dashboard) ──
    // เลือกผ่านฟังก์ชันเดิมทั้งหมด: ประเภท → filterLocationTypeDdPick() / location → locAcPick() (ทั้งคู่สั่ง searchLots เอง)
    // ป้ายบนปุ่มวาดใหม่ทุกครั้งที่สองฟังก์ชันนั้นถูกเรียก (รวมตอน filter แนะนำของ Visualize / URL filter ตั้งค่าให้)
    const LOT_LOCPICK_MAX = 120
    let _lotLocTypes = [], _lotLocPickRows = [], _lotLocPickAct = -1
    function _lotLocTypeOf(l) { return l?.typeName ?? l?.locationTypeName ?? l?.type ?? '' }
    function _lotLocTypeLabel(name) {
        const t = _lotLocTypes.find(x => x.name === name || (x.displayName || '').toLowerCase() === String(name).toLowerCase())
        return t ? (t.displayName || t.name) : name
    }
    // location อยู่ใน Location Type ที่เลือกไหม (เทียบได้ทั้ง name และ displayName ของ type)
    function _lotLocMatchesType(l) {
        const type = document.getElementById('filterLocationType').value
        if (!type) return true
        const t = _lotLocTypes.find(x => x.name === type)
        const lt = _lotLocTypeOf(l).toLowerCase()
        return [type, t?.displayName].filter(Boolean).some(n => n.toLowerCase() === lt)
    }
    function lotLocPickRenderLabel() {
        const lbl = document.getElementById('lotLocPickLabel')
        if (!lbl) return
        const type = document.getElementById('filterLocationType').value
        if (_locFilterCode) {
            const l = (typeof locations !== 'undefined' ? locations : []).find(x => x.locationCode === _locFilterCode)
            const lt = _lotLocTypeOf(l) || type
            lbl.innerHTML = `${lt ? locHierTypeIcon(lt) : ''} <b>${_escHtml(l?.displayName || _locFilterCode)}</b>` +
                            (lt ? ` <small>${_escHtml(_lotLocTypeLabel(lt))}</small>` : '')
        } else if (type) {
            const label = _lotLocTypeLabel(type)
            lbl.innerHTML = `${locHierTypeIcon(label)} <b style="color:${locTypeMeta(label).color}">${_escHtml(label)}</b>`
        } else {
            lbl.textContent = lotsDict().allLocations || 'All Locations'
        }
        document.getElementById('lotLocPickClear').hidden = !(type || _locFilterCode)
    }
    function lotLocPickRenderTypes() {
        const cur = document.getElementById('filterLocationType').value
        const chip = (val, inner) => `<button type="button" class="locpick-chip${cur === val ? ' on' : ''}" aria-pressed="${cur === val}"
            data-val="${_escHtml(val)}" onclick="lotLocPickSetType(this.dataset.val)">${inner}</button>`
        document.getElementById('lotLocPickTypes').innerHTML = chip('', _escHtml(lotsDict().allLocations || 'All Locations')) +
            _lotLocTypes.map(t => {
                const label = t.displayName || t.name
                return chip(t.name, `${locHierTypeIcon(label)}<span style="color:${locTypeMeta(label).color}">${_escHtml(label)}</span>`)
            }).join('')
    }
    function lotLocPickRenderList() {
        const q = (document.getElementById('lotLocPickSearch').value || '').trim().toLowerCase()
        const all = (typeof locations !== 'undefined' ? locations : [])
            .filter(l => l.isActive !== false && l.locationCode && _lotLocMatchesType(l) &&
                (!q || (l.displayName || '').toLowerCase().includes(q) || l.locationCode.toLowerCase().includes(q)))
            .sort((a, b) => (a.displayName || a.locationCode).localeCompare(b.displayName || b.locationCode))
        const type = document.getElementById('filterLocationType').value
        _lotLocPickRows = (q ? [] : [{ code: '', all: true }]).concat(all.slice(0, LOT_LOCPICK_MAX).map(l => ({ code: l.locationCode, loc: l })))
        _lotLocPickAct = -1
        const allTxt = type ? (lotsDict().allOfType || 'All {type}').replace('{type}', _lotLocTypeLabel(type)) : (lotsDict().allLocations || 'All Locations')
        const rows = _lotLocPickRows.map((r, i) => {
            const on = r.code === _locFilterCode
            if (r.all) return `<div class="locpick-row locpick-all${on ? ' on' : ''}" role="option" aria-selected="${on}" data-i="${i}">
                <i class="bi bi-grid-3x3-gap"></i><span>${_escHtml(allTxt)}</span>${on ? '<i class="bi bi-check2 locpick-check"></i>' : ''}</div>`
            const lt = _lotLocTypeOf(r.loc)
            return `<div class="locpick-row${on ? ' on' : ''}" role="option" aria-selected="${on}" data-i="${i}">
                <span class="loc-type-badge" style="${locTypeBadgeStyle(lt)}">${locHierTypeIcon(lt)}${_escHtml(r.loc.displayName || r.code)}</span>
                <small>${_escHtml(r.code)}</small>${on ? '<i class="bi bi-check2 locpick-check"></i>' : ''}</div>`
        }).join('')
        const more = all.length > LOT_LOCPICK_MAX ? `<div class="locpick-more">${(lotsDict().locMore || '+{n} more — type to search').replace('{n}', (all.length - LOT_LOCPICK_MAX).toLocaleString())}</div>` : ''
        document.getElementById('lotLocPickList').innerHTML = _lotLocPickRows.length ? rows + more : `<div class="locpick-more">${lotsDict().noLocationsFound || 'No locations found'}</div>`
    }
    function lotLocPickToggle(force) {
        const panel = document.getElementById('lotLocPickPanel')
        const open = force ?? panel.hidden
        panel.hidden = !open
        document.getElementById('lotLocPickTrigger').setAttribute('aria-expanded', String(open))
        document.getElementById('lotLocPick').classList.toggle('open', open)
        if (open) {
            const s = document.getElementById('lotLocPickSearch')
            s.value = ''
            lotLocPickRenderTypes()
            lotLocPickRenderList()
            setTimeout(() => s.focus(), 0)
        }
    }
    function lotLocPickSetType(val) {
        if (val === document.getElementById('filterLocationType').value) return
        // location ที่เลือกอยู่ไม่ใช่ type ใหม่ → ล้างก่อน (ไม่งั้นได้ผลว่างเพราะ 2 filter ขัดกัน)
        if (_locFilterCode) {
            const l = (typeof locations !== 'undefined' ? locations : []).find(x => x.locationCode === _locFilterCode)
            document.getElementById('filterLocationType').value = val
            if (l && !_lotLocMatchesType(l)) { _locFilterCode = ''; _locFilterLabel = ''; document.getElementById('filterLocation').value = '' }
        }
        const t = _lotLocTypes.find(x => x.name === val)
        filterLocationTypeDdPick(val, t ? (t.displayName || t.name) : '')   // → searchLots
        lotLocPickRenderTypes()
        lotLocPickRenderList()
        document.getElementById('lotLocPickSearch').focus()
    }
    function lotLocPickPick(i) {
        const r = _lotLocPickRows[i]
        if (!r) return
        lotLocPickToggle(false)
        if (r.code) locAcPick(r.code)   // → searchLots
        else if (_locFilterCode) { _locFilterCode = ''; _locFilterLabel = ''; document.getElementById('filterLocation').value = ''; lotLocPickRenderLabel(); searchLots() }
    }
    function lotLocPickClear() {
        _locFilterCode = ''; _locFilterLabel = ''; document.getElementById('filterLocation').value = ''
        filterLocationTypeDdPick('', '')   // → searchLots + วาดป้ายใหม่
    }
    function lotLocPickKey(e) {
        const rows = document.querySelectorAll('#lotLocPickList .locpick-row')
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            if (!rows.length) return
            e.preventDefault()
            _lotLocPickAct = (_lotLocPickAct + (e.key === 'ArrowDown' ? 1 : -1) + rows.length) % rows.length
            rows.forEach((el, i) => el.classList.toggle('act', i === _lotLocPickAct))
            rows[_lotLocPickAct].scrollIntoView({ block: 'nearest' })
        } else if (e.key === 'Enter') {
            e.preventDefault()
            lotLocPickPick(_lotLocPickAct >= 0 ? _lotLocPickAct : 0)
        } else if (e.key === 'Escape') {
            lotLocPickToggle(false)
            document.getElementById('lotLocPickTrigger').focus()
        }
    }
    document.getElementById('lotLocPickList').addEventListener('mousedown', e => {
        const el = e.target.closest('.locpick-row')
        if (el) { e.preventDefault(); lotLocPickPick(+el.dataset.i) }
    })
    document.addEventListener('click', e => {
        if (!e.target.isConnected || e.target.closest('#lotLocPick')) return
        if (!document.getElementById('lotLocPickPanel').hidden) lotLocPickToggle(false)
    })
    // ป้ายบนปุ่มตามทุกการเปลี่ยนแปลง — ห่อฟังก์ชันเดิม (ถูกเรียกจาก filter แนะนำ Visualize / URL filter / ตัว picker เอง)
    ;(function () {
        const _typePick = filterLocationTypeDdPick, _locPick = locAcPick
        filterLocationTypeDdPick = function (...a) { _typePick.apply(this, a); lotLocPickRenderLabel() }
        locAcPick = function (...a) { _locPick.apply(this, a); lotLocPickRenderLabel() }
    })()

    // ── Item Type filter dropdown (รายชื่อ type ดึงจาก /master/items/item-type, icon+color จาก itemTypeMeta.js) ──
    async function loadItemTypeOptions() {
        try {
            const res  = await api('/master/items/item-type', 'GET')
            const arr  = (Array.isArray(res) ? res : (res?.data ?? [])).map(t => t.name || t).filter(Boolean)
            const menu = document.getElementById('filterItemTypeMenu')
            menu.innerHTML = `<div class="loc-filter-dd-item active" data-val="" data-i18n="allItemTypes" onclick="filterItemTypeDdPick('')">${lotsDict().allItemTypes}</div>` +
                arr.map(name => `<div class="loc-filter-dd-item" data-val="${name}" onclick="filterItemTypeDdPick('${name}')">
                        ${itemTypeIcon(name)} <span style="color:${itemTypeMeta(name).color};font-weight:600">${name}</span>
                    </div>`).join('')
        } catch (err) {
            console.error('loadItemTypeOptions:', err)
        }
    }
    function filterItemTypeDdPick(val) {
        document.getElementById('filterItemType').value = val
        document.getElementById('filterItemTypeLabel').innerHTML = val
            ? `${itemTypeIcon(val)} <span style="color:${itemTypeMeta(val).color};font-weight:600">${val}</span>`
            : lotsDict().allItemTypes
        document.querySelectorAll('#filterItemTypeMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        closeAllFilterDd()
        searchLots()
    }

    // ── Date Range Picker (Created At) — component ใช้ร่วมกับหน้าอื่นได้ ดู dateRangePicker.js ──
    const lotDateRange = createDateRangePicker({ prefix: 'lot', onApply: () => searchLots() })

    function updateSortHeaders() {
        document.querySelectorAll('.inv-table th[id^="th-"]').forEach(th => {
            th.classList.remove('sort-asc', 'sort-desc')
            if (th.id === 'th-' + sortBy)
                th.classList.add(desc ? 'sort-desc' : 'sort-asc')
        })
    }

    // อ่าน filter ปัจจุบันทั้งหมดจากหน้าจอ ใช้ร่วมกันทั้ง loadLots() (โหลดทีละหน้า) และ exportLotsToExcel() (โหลดทุกหน้า) —
    // กัน logic การอ่าน filter เพี้ยนไม่ตรงกันระหว่าง 2 จุด (page/pageSize/sortBy/desc ไม่รวมอยู่ในนี้ ผู้เรียกใส่เองทีหลัง)
    function _buildLotsFilterBody() {
        const partNo      = document.getElementById("filterPartNo").value.trim()
        const workOrder   = document.getElementById("filterWO").value.trim()
        const lotNo       = document.getElementById("filterLotNo").value.trim()
        const line        = document.getElementById("filterLine").value.trim()
        const availableOnly = document.getElementById("filterAvailable").checked
        const locationType = document.getElementById("filterLocationType").value
        const locationCode = _locFilterCode
        // ใส่ได้เฉพาะเลขจำนวนเต็ม (ติดลบได้) — ช่องว่าง/ไม่ใช่ตัวเลข = ไม่ส่ง; 0 ถือว่าส่ง
        const _int = id => { const v = document.getElementById(id).value.trim(); return v !== '' && Number.isFinite(Number(v)) ? Math.trunc(Number(v)) : null }
        const minDelay = _int("filterDelayMin"), maxDelay = _int("filterDelayMax")
        const minInLoc = _int("filterInLocMin"), maxInLoc = _int("filterInLocMax")
        const lotStatus    = document.getElementById("filterLotStatus").value
        const itemType     = document.getElementById("filterItemType").value
        const createdAfter  = lotDateRange.getFrom()
        const createdBefore = lotDateRange.getTo()

        const body = {}
        if (partNo)       body.partNo       = partNo
        if (workOrder)    body.workOrder    = workOrder
        if (lotNo)        body.lotNo        = lotNo
        if (line)         body.line         = line
        if (locationType) body.locationType = locationType
        if (locationCode) body.locationCode = locationCode
        if (minDelay !== null) body.minDelayMinutes = minDelay
        if (maxDelay !== null) body.maxDelayMinutes = maxDelay
        if (minInLoc !== null) body.minInLocationDurationMinutes = minInLoc
        if (maxInLoc !== null) body.maxInLocationDurationMinutes = maxInLoc
        if (availableOnly) body.availableOnly = true
        if (lotStatus)      body.lotStatus      = lotStatus
        if (itemType)       body.itemType       = itemType
        if (createdAfter)   body.createdAfter   = new Date(createdAfter  + 'T00:00:00').toISOString()
        if (createdBefore)  body.createdBefore  = new Date(createdBefore + 'T23:59:59.999').toISOString()
        return body
    }

    async function loadLots() {
        const pageSize = parseInt(document.getElementById("pageSize").value)
        const body = { ..._buildLotsFilterBody(), page, pageSize, sortBy, desc }

        try {
            const json = await api("/inventory/lots", "POST", body)
            const list = json.data || []
            _lastLotRows = list

            _lastTotalLot = json.totalLot ?? 0
            document.getElementById("lotsTotal").textContent = _lastTotalLot.toLocaleString()

            const html = list.map(x => {
                const av = x.available ?? 0
                const onHand = x.onHandQty ?? 0
                const pct = onHand > 0 ? (av / onHand * 100) : 0
                const avCls = pct >= 30 ? 'num-ok' : 'num-bad'
                return `<tr>
                    <td><a href="Inventory/LotDetail?lot=${encodeURIComponent(x.lotNo ?? '')}" class="mono" style="text-decoration:none;color:var(--blue)">${x.lotNo ?? ""}</a></td>
                    <td class="lot-part-cell" data-part="${x.partNo ?? ""}">${partNoBadge(x.partNo, x.itemTypeName ?? x.itemType)}</td>
                    <td><div class="lot-desc-cell" title="${String(x.description ?? "").replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;")}">${x.description ?? "—"}</div></td>
                    <td style="color:var(--t2);font-size:12px">${x.workOrder ?? "—"}</td>
                    <td class="lot-line-cell" data-wo="${x.workOrder ?? ""}">${lotLineCell(x)}</td>
                    <td>${locBadgeForCode(x.location)}</td>
                    <td>${lotStatusBadge(x.status)}</td>
                    <td style="font-weight:600">${(x.onHandQty ?? 0).toLocaleString()}</td>
                    <td style="color:var(--amber);font-weight:600">${(x.reservedQty ?? 0).toLocaleString()}</td>
                    <td style="color:var(--t2)">${(x.consumedQty ?? 0).toLocaleString()}</td>
                    <td class="${avCls}">${av.toLocaleString()}</td>
                    <td style="color:var(--t2);font-size:12px;white-space:nowrap">${fmtDate(x.createdAt)}</td>
                    <td style="color:var(--t2);font-size:12px;white-space:nowrap">${x.locationEnteredAt ? fmtDate(x.locationEnteredAt) : "—"}</td>
                    <td style="${isLocEnterLate(x) ? 'color:var(--red);font-weight:700' : 'color:var(--t2)'};font-size:12px;white-space:nowrap">${x.productionDeadlineAt ? fmtDate(x.productionDeadlineAt) : "—"}</td>
                    ${/* คอลัมน์ Late เอาออกแล้ว — PD Deadline ที่เลยแล้วยังแสดงเป็นสีแดงในช่องของตัวเอง */''}
                    ${minutesCell(x.delayTimeMinutes, true)}
                    ${minutesCell(x.inLocationDurationMinutes, false)}
                    <td style="text-align:center">
                        <button type="button" class="btn-action-menu" onclick="toggleLotActionMenu(event, '${x.lotNo}', ${x.onHandQty ?? 0}, ${x.isVoided === true || x.status?.toLowerCase() === 'void' || x.status?.toLowerCase() === 'voided'})" title="${lotsDict().colAction}">
                            <i class="bi bi-three-dots"></i>
                        </button>
                    </td>
                </tr>`
            }).join("")

            document.getElementById("lotTable").innerHTML = html ||
                `<tr><td colspan="17" style="text-align:center;color:var(--t3);padding:32px">${lotsDict().noLotsFound}</td></tr>`

            totalPages = json.totalPages || Math.ceil((json.totalLot || 0) / pageSize) || 1
            document.getElementById("pageInfo").textContent = `${json.page} / ${totalPages}`
            renderPageNumbers("pageNumberBtns", page, totalPages, "goToPage")
            document.getElementById("btnPrev").disabled = (page <= 1)
            document.getElementById("btnNext").disabled = (page >= totalPages)

            updateSortHeaders()
            loadPartTypes(list)   // ไม่ await — ดึง Item Type ของ part ที่ API ไม่ส่งมา แล้ว patch badge ทีหลัง
            // ไม่ await — Lot ที่ไม่มี Line หา Line จาก W/O แล้ว patch ช่อง Line ทีหลัง
            resolveLotLines(list).then(() => list.forEach(x => {
                if (!x._lineFromWo) return
                document.querySelectorAll('#lotTable td.lot-line-cell').forEach(td => { if (td.dataset.wo === x.workOrder) td.innerHTML = lotLineCell(x) })
            }))

        } catch (err) {
            console.error(err)
            document.getElementById("lotTable").innerHTML =
                `<tr><td colspan="17" style="text-align:center;color:var(--red);padding:32px">${lotsDict().loadFailed}: ${err.message}</td></tr>`
        }
    }

    // Export Excel — ดึง Lot "ทุกแถวที่ตรงกับ filter ปัจจุบัน" (ไม่ใช่แค่หน้าที่กำลังโชว์อยู่) มาเป็นไฟล์เดียว ใช้ filter
    // เดียวกับ loadLots() ทุกอย่าง (_buildLotsFilterBody) ต่างกันแค่ page/pageSize — โหลดหน้าแรกก่อนเพื่อรู้ totalLot แล้ว
    // ค่อยยิงหน้าที่เหลือพร้อมกันทีเดียว (เหมือน pattern _fetchPrintHistoriesForWo ใน WorkOrderLots.cshtml) กัน pageSize
    // เดียวใหญ่เกินไปจนช้า/timeout ถ้า Lot มีเยอะมาก
    // onProgress(loaded, total, page, pages) — เรียกทุกครั้งที่ได้หน้าใหม่; isCancelled() = true → หยุดแล้วคืน null
    async function _fetchAllLotsForExport(onProgress, isCancelled) {
        const EXPORT_PAGE_SIZE = 500
        const CONCURRENCY      = 3    // ยิงพร้อมกันทีละ 3 หน้า (เดิมยิงทุกหน้าพร้อมกัน — หลักร้อย request ทีเดียว)
        const filterBody = _buildLotsFilterBody()
        const qs = p => ({ ...filterBody, page: p, pageSize: EXPORT_PAGE_SIZE, sortBy, desc })

        const first = await api("/inventory/lots", "POST", qs(1))
        if (isCancelled?.()) return null
        const pagesData = [first?.data || []]
        const total = first?.totalLot ?? pagesData[0].length
        // backend อาจจำกัด pageSize ให้น้อยกว่าที่ขอ — คำนวณจำนวนหน้าจากขนาดหน้าแรกที่ได้จริง ไม่ใช่จาก EXPORT_PAGE_SIZE
        const pages = first?.totalPages ?? (Math.ceil(total / (pagesData[0].length || EXPORT_PAGE_SIZE)) || 1)
        let loaded = pagesData[0].length, done = 1
        onProgress?.(loaded, total, done, pages)
        for (let p = 2; p <= pages; p += CONCURRENCY) {
            const batch = Array.from({ length: Math.min(CONCURRENCY, pages - p + 1) }, (_, i) => p + i)
            const res = await Promise.all(batch.map(pg => api("/inventory/lots", "POST", qs(pg))))
            if (isCancelled?.()) return null
            res.forEach((r, i) => { pagesData[batch[i] - 1] = r?.data || []; loaded += pagesData[batch[i] - 1].length })
            done += batch.length
            onProgress?.(loaded, total, done, pages)
        }
        return pagesData.flat()
    }

    // แปลงค่าหนึ่ง field ให้ปลอดภัยกับ CSV — ตัวเลข (On Hand/Reserved/Consumed/Available) ปล่อยไม่ครอบ "" เพื่อให้ Excel
    // มองเป็นตัวเลขจริง (sum/sort ได้) ส่วนข้อความครอบด้วย "" เสมอ (กัน comma/newline เช่น Description) พร้อม escape
    // เครื่องหมาย " ที่อยู่ข้างในด้วยการเพิ่มเป็น "" ตามสเปก CSV มาตรฐาน
    function _csvCell(v) {
        if (typeof v === "number") return String(v)
        return `"${String(v ?? "").replace(/"/g, '""')}"`
    }

    // เด้ง modal ให้ preview จำนวนแถวก่อน Export จริง กันมือลั่นกดโดนปุ่ม Export เฉยๆ (ไอคอนเดียว ไม่มีข้อความ อาจกดพลาดง่าย)
    // ไม่ได้เลือก filter อะไรเลย (Available อย่างเดียวไม่นับ — ยังกว้างเกินไป) = ห้าม Export
    // Status = Available เป็นค่าเริ่มต้น ไม่นับว่าเป็น filter (ยังได้ข้อมูลเกือบทั้งระบบ)
    function _exportIsBlank() {
        const b = { ..._buildLotsFilterBody() }
        delete b.availableOnly
        if ((b.lotStatus || '').toLowerCase() === 'available') delete b.lotStatus
        return Object.keys(b).length === 0
    }
    function openExportConfirm() {
        if (!canExportExcel) { alert("You don't have permission please contact admin"); return }
        const blank = _exportIsBlank()
        document.getElementById("exportRowCountVal").textContent = _lastTotalLot.toLocaleString()
        document.getElementById("exportBlankWarn").style.display = blank ? "" : "none"
        const btn = document.getElementById("exportConfirmBtn")
        btn.disabled      = blank
        btn.style.opacity = blank ? ".45" : ""
        btn.style.cursor  = blank ? "not-allowed" : ""
        openModal("exportConfirmModal")
    }
    function confirmExportLots() {
        if (_exportIsBlank()) return
        closeModal("exportConfirmModal")
        exportLotsToExcel()
    }
    let _exportCancelled = false
    function cancelExportLots() {
        _exportCancelled = true
        closeModal("exportProgressModal")
        showToast(lotsDict().exportCancelled, "error")
    }
    function _exportProgress(text, pct) {
        document.getElementById("exportProgressText").textContent = text
        if (pct != null) document.getElementById("exportProgressBar").style.width = Math.min(100, pct) + "%"
    }

    async function exportLotsToExcel() {
        const btn = document.getElementById("btnExportExcel")
        const originalHtml = btn.innerHTML
        btn.disabled = true
        btn.innerHTML = `<span class="spinner-border spinner-border-sm"></span>`
        _exportCancelled = false
        _exportProgress(lotsDict().exportStarting, 0)
        openModal("exportProgressModal")
        try {
            const d = lotsDict()
            const rows = await _fetchAllLotsForExport(
                (loaded, total, pg, pages) => _exportProgress(
                    d.exportProgress.replace('{p}', pg).replace('{t}', pages).replace('{n}', loaded.toLocaleString()).replace('{total}', total.toLocaleString()),
                    total ? loaded / total * 90 : 0),   // 90% แรก = โหลดข้อมูล ที่เหลือ = Item Type + สร้างไฟล์
                () => _exportCancelled)
            if (!rows || _exportCancelled) return
            _exportProgress(d.exportPrepItemTypes, 93)
            await loadPartTypes(rows)   // Item Type ของ part ที่ API ไม่ส่งมา — ดึงให้ครบทุกแถวก่อนสร้างไฟล์ (cache ต่อ part)
            if (_exportCancelled) return
            await resolveLotLines(rows, (n, t) => _exportProgress(d.exportResolvingLines.replace('{n}', n).replace('{t}', t), 95), () => _exportCancelled)
            if (_exportCancelled) return
            _exportProgress(d.exportBuilding, 97)
            const headers = ["Lot No.", "Part No.", "Item Type", "Description", "Work Order", "Model", "Line", "Location", "Location Type",
                              "Status", "On Hand", "Reserved", "Consumed", "Available", "Created At", "Location Entered At", "Production Deadline At", "Late By", "Delay Time (min)", "In Location Duration (min)"]
            const lines = [headers.map(_csvCell).join(",")]
            rows.forEach(x => {
                lines.push([
                    x.lotNo ?? "", x.partNo ?? "", x.itemTypeName ?? x.itemType ?? _partTypeCache[x.partNo] ?? "", x.description ?? "", x.workOrder ?? "", x.modelName ?? "",
                    x.lineName ?? "", locName(x.location) === x.location ? (x.location ?? "") : locName(x.location),
                    lotLocType(x),
                    x.status ?? "", x.onHandQty ?? 0, x.reservedQty ?? 0, x.consumedQty ?? 0, x.available ?? 0,
                    fmtDate(x.createdAt),
                    x.locationEnteredAt ? fmtDate(x.locationEnteredAt) : "",
                    x.productionDeadlineAt ? fmtDate(x.productionDeadlineAt) : "",
                    lateMs(x) > 0 ? fmtLate(lateMs(x)) : "",
                    x.delayTimeMinutes ?? "", x.inLocationDurationMinutes ?? "",
                ].map(_csvCell).join(","))
            })
            // BOM (﻿) นำหน้า — กัน Excel เปิดแล้วภาษาไทยเพี้ยนเป็นตัวอักษรมั่ว (คิดว่าเป็น ANSI ถ้าไม่มี BOM)
            const blob = new Blob(["﻿" + lines.join("\r\n")], { type: "text/csv;charset=utf-8;" })
            const url  = URL.createObjectURL(blob)
            const a    = document.createElement("a")
            const ts   = new Date()
            const pad  = n => String(n).padStart(2, "0")
            a.href     = url
            a.download = `Lots_Export_${ts.getFullYear()}${pad(ts.getMonth()+1)}${pad(ts.getDate())}_${pad(ts.getHours())}${pad(ts.getMinutes())}.csv`
            document.body.appendChild(a)
            a.click()
            a.remove()
            URL.revokeObjectURL(url)
            showToast(`${lotsDict().exportSuccess} (${rows.length.toLocaleString()} ${lotsDict().lots})`)
        } catch (err) {
            console.error(err)
            if (!_exportCancelled) showToast(`${lotsDict().exportFailed}: ${err.message}`, "error")
        } finally {
            closeModal("exportProgressModal")
            btn.disabled = false
            btn.innerHTML = originalHtml
        }
    }

    function sort(col) {
        desc = (sortBy === col) ? !desc : true
        sortBy = col
        page = 1
        loadLots()
    }

    function searchLots()    { page = 1; loadLots() }
    // พิมพ์ช่อง search แล้ว debounce รอสักครู่ค่อยยิงค้นหาเอง ไม่ต้องกดปุ่ม Search (เหมือนหน้า WorkOrders)
    let _lotsSearchTimer = null
    function lotsDebouncedSearch() {
        clearTimeout(_lotsSearchTimer)
        _lotsSearchTimer = setTimeout(searchLots, 400)
    }
    function changePageSize(){ page = 1; loadLots() }
    function nextPage()      { if (page < totalPages) { page++; loadLots() } }
    function goToPage(p)     { if (p >= 1 && p <= totalPages && p !== page) { page = p; loadLots() } }
    function prevPage()      { if (page > 1)          { page--; loadLots() } }

    // ── Action menu — รวม Re-Print/Adjust/Void เป็นปุ่ม ⋯ เดียว append เข้า <body> ตรงๆ กัน overflow ของตาราง clip dropdown ──
    // canAdjust/canVoid ใช้กรองว่าจะโชว์ตัวเลือกไหนใน dropdown
    function closeLotActionMenu() {
        document.getElementById('lotActionMenu')?.remove()
        document.querySelector('.btn-action-menu.active')?.classList.remove('active')
    }
    document.addEventListener('click', closeLotActionMenu)

    function toggleLotActionMenu(e, lotNo, onHandQty, isVoided) {
        e.stopPropagation()
        const btn = e.currentTarget
        const wasOpen = btn.classList.contains('active')
        closeLotActionMenu()
        if (wasOpen) return

        const d = lotsDict()
        const items = []
        items.push(`<div class="lot-action-item" onclick="closeLotActionMenu();location.href='Inventory/PrintQR?tab=reprint&lot='+encodeURIComponent('${lotNo}')"><i class="bi bi-printer"></i>${d.rePrint}</div>`)
        if (canAdjust) {
            items.push(isVoided
                ? `<div class="lot-action-item disabled" title="${d.alreadyVoided}"><i class="bi bi-pencil-square"></i>${d.adjust}</div>`
                : `<div class="lot-action-item amber" onclick="closeLotActionMenu();adjustLot('${lotNo}', ${onHandQty})"><i class="bi bi-pencil-square"></i>${d.adjust}</div>`)
        }
        if (canAdjust) {
            items.push(`<div class="lot-action-item amber" onclick="closeLotActionMenu();openChangeStatus('${lotNo}')"><i class="bi bi-arrow-repeat"></i>${d.changeStatus}</div>`)
        }
        if (canVoid) {
            items.push(isVoided
                ? `<div class="lot-action-item disabled"><i class="bi bi-slash-circle"></i>${d.voided}</div>`
                : `<div class="lot-action-item danger" onclick="closeLotActionMenu();voidLot('${lotNo}')"><i class="bi bi-slash-circle"></i>${d.voidAction}</div>`)
        }

        const rect = btn.getBoundingClientRect()
        const menu = document.createElement('div')
        menu.id        = 'lotActionMenu'
        menu.className = 'lot-action-menu'
        menu.style.position = 'fixed'
        menu.style.top   = (rect.bottom + 4) + 'px'
        menu.style.right = (window.innerWidth - rect.right) + 'px'
        menu.innerHTML   = items.join('')
        menu.addEventListener('click', ev => ev.stopPropagation())
        document.body.appendChild(menu)
        btn.classList.add('active')
    }

    function applyRoleUI() {
        const user       = JSON.parse(localStorage.getItem("user") || "{}")
        const userRoles  = Array.isArray(user.roles) ? user.roles : []
        const userPermis = Array.isArray(user.permissions) ? user.permissions : []
        const isAdmin    = userRoles.includes("Admin")

        canAdjust = isAdmin || userPermis.includes("WMS.Lot.Update")
        canVoid   = isAdmin || userPermis.includes("WMS.Lot.Void")
        canExportExcel = isAdmin || userPermis.includes("WMS.UI.Export.Excel")

        document.getElementById("btnExportExcel").style.display  = canExportExcel ? "" : "none"
    }

    let _voidLotNo = null
    let _adjustLotNo = null

    function showToast(message, type = "success") {
        const stack = document.getElementById("toastStack")
        const t = document.createElement("div")
        t.className = `toast toast-${type}`
        t.innerHTML = `<span>${type === "success" ? "✓" : "✕"}</span>${message}`
        stack.appendChild(t)
        setTimeout(() => { t.style.opacity = "0"; t.style.transform = "translateX(28px)"; t.style.transition = ".2s" }, 2800)
        setTimeout(() => t.remove(), 3100)
    }

    function showModalError(errorId, message) {
        const el = document.getElementById(errorId)
        el.textContent = message
        el.classList.add("show")
    }

    function clearModalError(errorId) {
        const el = document.getElementById(errorId)
        el.textContent = ""
        el.classList.remove("show")
    }

    function openModal(id)  { document.getElementById(id).classList.add("show") }
    function closeModal(id) { document.getElementById(id).classList.remove("show") }

    function voidLot(lotNo) {
        _voidLotNo = lotNo
        document.getElementById("voidLotNo").textContent = lotNo
        document.getElementById("voidReason").value = ""
        clearModalError("voidError")
        openModal("voidModal")
    }

    async function confirmVoid() {
        const reason = document.getElementById("voidReason").value.trim()
        if (!reason) { document.getElementById("voidReason").focus(); return }
        clearModalError("voidError")
        try {
            await api(`/inventory/void-lot/${_voidLotNo}`, "POST", { reason })
            closeModal("voidModal")
            showToast(`Lot ${_voidLotNo} ${lotsDict().wasVoided}`)
            loadLots()
        } catch (err) {
            showModalError("voidError", err.message || lotsDict().errorOccurred)
        }
    }

    function adjustLot(lotNo, currentQty) {
        _adjustLotNo = lotNo
        document.getElementById("adjustLotNo").textContent       = lotNo
        document.getElementById("adjustCurrentQty").textContent  = currentQty.toLocaleString()
        document.getElementById("adjustNewQty").value = ""
        clearModalError("adjustError")
        openModal("adjustModal")
    }

    // ── Change Status ── เลือกสถานะใหม่จากรายการ /inventory/lot/status-type แล้วยิง POST /inventory/lot/change-status
    var _lotStatusTypes = [], _csLotNo = null
    function openChangeStatus(lotNo) {
        const lot = (_lastLotRows || []).find(x => x.lotNo === lotNo) || {}
        const cur = String(lot.status ?? '')
        _csLotNo = lotNo
        document.getElementById('csLotNo').textContent = lotNo
        document.getElementById('csCurrentStatus').innerHTML = cur ? lotStatusBadge(cur) : '—'
        const sel = document.getElementById('csNewStatus')
        const d = lotsDict()
        sel.innerHTML = `<option value="">${d.selectStatus}</option>` + _lotStatusTypes
            .filter(s => s.name.toLowerCase() !== cur.toLowerCase() && String(s.id) !== cur)   // ไม่ให้เลือกสถานะเดิม
            .map(s => `<option value="${s.id}">${s.name}</option>`).join('')
        clearModalError('csError')
        openModal('changeStatusModal')
        if (!_lotStatusTypes.length) showModalError('csError', d.statusListUnavailable)
    }
    async function confirmChangeStatus() {
        const sel = document.getElementById('csNewStatus')
        const newStatus = parseInt(sel.value, 10)
        if (!(newStatus >= 0)) { showModalError('csError', lotsDict().pleaseSelectStatus); sel.focus(); return }
        const name = sel.options[sel.selectedIndex]?.text || newStatus
        const btn = document.getElementById('csConfirmBtn')
        btn.disabled = true
        clearModalError('csError')
        try {
            await api('/inventory/lot/change-status', 'POST', { lotNo: _csLotNo, newStatus })
            closeModal('changeStatusModal')
            showToast(`Lot ${_csLotNo} → ${name}`)
            loadLots()
        } catch (err) {
            showModalError('csError', err.message || lotsDict().errorOccurred)
        } finally {
            btn.disabled = false
        }
    }

    async function confirmAdjust() {
        const qty = parseFloat(document.getElementById("adjustNewQty").value)
        if (isNaN(qty) || qty < 0) { document.getElementById("adjustNewQty").focus(); return }
        clearModalError("adjustError")
        try {
            await api("/inventory/adjust", "POST", { lotNo: _adjustLotNo, adjustQty: qty })
            closeModal("adjustModal")
            showToast(`Lot ${_adjustLotNo} ${lotsDict().wasAdjusted}`)
            loadLots()
        } catch (err) {
            showModalError("adjustError", err.message || lotsDict().errorOccurred)
        }
    }

    // คลิกพื้นหลังเพื่อปิด modal — ยกเว้น modal Loading ของ Visualize (ต้องกด Cancel เพื่อหยุดโหลดจริงๆ)
    document.querySelectorAll(".modal-overlay:not(#vizLoadingModal):not(#exportProgressModal)").forEach(el =>
        el.addEventListener("click", e => { if (e.target === el) closeModal(el.id) })
    )

    // แปลภาษาหน้านี้ทั้งหมด — เรียกตอน init และทุกครั้งที่กดสลับภาษา (ผูกผ่าน window.onLangChange ที่ _Layout.cshtml เรียกให้)
    function applyLotsLang() {
        applyDataI18n(lotsDict())
        rngSyncAll()   // ป้ายปุ่ม Delay / In Location ตามภาษา
        if (!document.getElementById('filterLocationType').value)
            document.getElementById('filterLocationTypeLabel').textContent = lotsDict().allLocations
        lotLocPickRenderLabel()   // ป้าย Location picker ตามภาษา
        // ชื่อ Lot Status (ป้ายปุ่ม + รายการ) ตามภาษา — ค่า filter ยังเป็นชื่ออังกฤษเดิม
        document.querySelectorAll('#filterLotStatusMenu .loc-filter-dd-item[data-val] .lot-status-name').forEach(el => {
            el.textContent = lotStatusLabel(el.closest('[data-val]').dataset.val)
        })
        const _st = document.getElementById('filterLotStatus').value
        if (_st) filterLotStatusDdPick(_st, _st, true)
        if (!document.getElementById('filterLotStatus').value)
            document.getElementById('filterLotStatusLabel').textContent = lotsDict().allStatus
        if (!document.getElementById('filterItemType').value)
            document.getElementById('filterItemTypeLabel').textContent = lotsDict().allItemTypes
        loadLots()
    }
    window.onLangChange = applyLotsLang

    // filter จาก URL — หน้าอื่นลิงก์มาพร้อม filter ได้ เช่น Dashboard การ์ด "Lots in Location > 1 Day":
    // Inventory/Lots?inLocMin=1440&lotStatus=Available&locationType=Busrun
    // ตั้งแค่ค่าใน hidden input ก่อน loadLots() รอบแรก — ป้ายปุ่ม In Location (rngSyncAll ใน applyLotsLang) และ dropdown
    // Location Type / Lot Status (loadLocationTypes / loadLotStatusOptions) sync ตามค่าที่ตั้งไว้เองตอนโหลดเสร็จ
    function _applyUrlFilters() {
        const q = new URLSearchParams(location.search)
        const int = k => { const v = q.get(k); return v !== null && v.trim() !== '' && Number.isFinite(Number(v)) ? String(Math.trunc(Number(v))) : null }
        const inLocMin = int('inLocMin'), inLocMax = int('inLocMax')
        if (inLocMin !== null) document.getElementById('filterInLocMin').value = inLocMin
        if (inLocMax !== null) document.getElementById('filterInLocMax').value = inLocMax
        if (q.has('lotStatus'))    document.getElementById('filterLotStatus').value    = q.get('lotStatus')
        if (q.has('locationType')) document.getElementById('filterLocationType').value = q.get('locationType')
    }

    async function _init(){
        _applyUrlFilters()
        await loadLocation()
        applyRoleUI()
        loadLocationTypes()
        loadLotStatusOptions()
        loadItemTypeOptions()
        applyLotsLang()
    }

    _init()

</script>
}
