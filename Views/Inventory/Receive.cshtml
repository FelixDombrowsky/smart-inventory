        // ── P/N autocomplete ───────────────────────────
        let pnResults = [], pnSearchTimer = null;

        function searchManualPn() {
            const input = document.getElementById("mePn");
            const text  = input.value.trim();
            const dd    = document.getElementById("pnDropdown");

            if (!text) { dd.style.display = "none"; return; }

            const rect = input.getBoundingClientRect();
            dd.style.top   = (rect.bottom + 4) + "px";
            dd.style.left  = rect.left + "px";
            dd.style.width = rect.width + "px";

            dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
            </div>`;
            dd.style.display = "block";

            clearTimeout(pnSearchTimer);
            pnSearchTimer = setTimeout(async () => {
                try {
                    const json = await api(`/master/items?search=${encodeURIComponent(text)}&page=1&pageSize=20`, "GET");
                    pnResults = json.data || [];
                    if (!pnResults.length) {
                        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                            <i class="bi bi-search me-2"></i>ไม่พบรายการ
                        </div>`;
                        return;
                    }
                    dd.innerHTML = pnResults.map((x, i) => `
                        <div class="loc-item" onmousedown="selectManualItem(${i})">
                            <i class="bi bi-box" style="color:var(--blue);flex-shrink:0"></i>
                            <span>
                                <strong>${x.partNo}</strong>
                                <span style="color:var(--t2);font-size:12px;margin-left:6px">${x.itemName || ''}</span>
                            </span>
                            ${x.baseUnit ? `<span style="margin-left:auto;font-size:11px;color:var(--t3)">${x.baseUnit}</span>` : ''}
                        </div>`).join("");
                } catch {
                    dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                        <i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ
                    </div>`;
                }
            }, 300);
        }

        function selectManualItem(i) {
            const x = pnResults[i];
            document.getElementById("mePn").value   = x.partNo;
            document.getElementById("meDesc").value = x.itemName || "";
            if (x.baseUnit) document.getElementById("meUnit").value = x.baseUnit;
            document.getElementById("mePn").classList.remove("err");
            hidePnDropdown();
        }

        function hidePnDropdown() {
            document.getElementById("pnDropdown").style.display = "none";
            // auto-fill desc/unit if the typed P/N exactly matches a cached result
            const partNo = document.getElementById("mePn").value.trim();
            if (!partNo) return;
            const match = pnResults.find(x => x.partNo === partNo);
            if (match) {
                if (!document.getElementById("meDesc").value) document.getElementById("meDesc").value = match.itemName || "";
                if (match.baseUnit) document.getElementById("meUnit").value = match.baseUnit;
            }
        }

