@section Scripts {
<script src="/lib/html5-qrcode/html5-qrcode.min.js"></script>
<script src="/js/api.js"></script>
<script src="/js/apiForm.js"></script>
<script src="/js/PhotoCapture.js"></script>
<script src="/js/barcodeScanner.js"></script>
<script src="/js/hwScanner.js"></script>
<script src="/js/locationAutocomplete.js"></script>
<script src="/js/workOrderAutocomplete.js"></script>
<script>
    // ── 13 Fixed Field Schema ──
    const FIELD_LABELS = {
        partNo:          'P/N',
        quantity:        'QTY',
        unit:            'UNIT',
        vendor:          'VENDOR',
        dateCode:        'D/C',
        tradingCode:     'T/C',
        po:              'PO',
        inventoryNo:     'I/N',
        traceId:         'TRACE ID',
        workOrder:       'W/O',
        line:            'LINE',
        lotNo:           'LOT NO',
        uniqueId:        'UNIQUE ID',
        productionArea:  'AREA',
    }
    const ALL_FIELD_KEYS    = Object.keys(FIELD_LABELS)
    const FIELD_PLACEHOLDERS = {
        tradingCode:  'Trading Code',
        dateCode:     'Date Code',
        inventoryNo:  'Inventory Number',
    }
    const REQUIRED_KEYS     = new Set(['partNo','quantity','unit'])
    const QR_REQUIRED_KEYS  = new Set(['lotNo','uniqueId'])
    function applyPrintOffset(zpl, cfg) {
        const x = cfg?.printOffsetX ?? 100
        const y = cfg?.printOffsetY ?? 0
        if (!x && !y) return zpl
        return zpl.replace(/(\^XA\n?)/, `$1^LH${x},${y}\n`)
    }

    // ── Helpers ──
    const cid = k => k.replace(/[^a-zA-Z0-9]/g, '_')
    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    }

    // ISO Z → local display "YYYY-MM-DD HH:mm:ss"
    function fmtCreatedAt(isoZ) {
        if (!isoZ) return ''
        try {
            const d = new Date(isoZ)
            if (isNaN(d)) return isoZ
            const pad = n => String(n).padStart(2,'0')
            return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} ` +
                   `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`
        } catch (_) { return isoZ }
    }

    // ── Toast ──
    function showToast(msg, type) {
        const tc = document.getElementById('toastContainer')
        const t  = document.createElement('div')
        t.className = `sf-toast sf-toast-${type || 'info'}`
        t.textContent = msg
        tc.appendChild(t)
        setTimeout(() => t.remove(), 3200)
    }

    // ── Map API response → 13-field schema ──
    function mapScanResponse(res) {
        return {
            partNo:          res.partNo          ?? '',
            quantity:        String(res.quantity  ?? ''),
            unit:            res.unit             ?? '',
            vendor:          res.vendor           ?? '',
            dateCode:        res.dateCode         ?? '',
            tradingCode:     res.tradingCode      ?? '',
            po:              res.po               ?? '',
            inventoryNo:     res.inventoryNo      ?? '',
            traceId:         res.wH_TraceId       || res.traceId || '',
            workOrder:       res.workOrder        ?? '',
            line:            res.line             ?? '',
            lotNo:           '',
            uniqueId:        '',
            productionArea:  res.productionArea   ?? '',
        }
    }

    function goToDesignLayout(layoutId) {
        const designPill = document.querySelectorAll('.tab-pill')[2]
        switchTab('design', designPill)
        const id = layoutId || document.getElementById('fLayout')?.value
        if (id) {
            openEditMode(id)
        } else {
            showListMode()
        }
    }

    async function loadLayoutsIntoSelect() {
        const sel     = document.getElementById('fLayout')
        const rcSel   = document.getElementById('rcLayout')
        const rprSel  = document.getElementById('rprLayout')
        const asmSel  = document.getElementById('asmLayout')
        const histSel = document.getElementById('histLayoutSelect')
        // Save current selections before rebuilding
        const prev = {
            fLayout:   sel?.value    || '',
            rcLayout:  rcSel?.value  || '',
            rprLayout: rprSel?.value || '',
            asmLayout: asmSel?.value || '',
            histLayoutSelect: histSel?.value || '',
        }
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const arr = Array.isArray(layouts) ? layouts : (layouts?.data || [])
            const opts = '<option value="">-- Select Layout --</option>' +
                arr.map(l => `<option value="${l.id}">${escHtml(l.templateName ?? 'Untitled')}</option>`).join('')
            const histOpts = '<option value="">-- Default (8dpmm, 3.2x1.2 in) --</option>' +
                arr.map(l => {
                    const c = parseZplDataJson(l)
                    const dims = `${c.dpi ?? '8dpmm'}, ${c.width ?? 3.2}x${c.height ?? 1.2} in`
                    return `<option value="${l.id}">${escHtml(l.templateName ?? 'Untitled')} (${dims})</option>`
                }).join('')
            if (sel)    { sel.innerHTML = opts;    sel._layoutsData = arr;    if (prev.fLayout)   sel.value    = prev.fLayout   }
            if (rcSel)  { rcSel.innerHTML = opts;  rcSel._layoutsData = arr;  if (prev.rcLayout)  rcSel.value  = prev.rcLayout  }
            if (rprSel) { rprSel.innerHTML = opts; rprSel._layoutsData = arr; if (prev.rprLayout) rprSel.value = prev.rprLayout }
            if (asmSel) { asmSel.innerHTML = opts; asmSel._layoutsData = arr; if (prev.asmLayout) asmSel.value = prev.asmLayout }
            if (histSel) { histSel.innerHTML = histOpts; histSel._layoutsData = arr; if (prev.histLayoutSelect) histSel.value = prev.histLayoutSelect }
        } catch (_) {
            const err = '<option value="">-- (Unable to load Layouts) --</option>'
            if (sel)    sel.innerHTML = err
            if (rcSel)  rcSel.innerHTML = err
            if (rprSel) rprSel.innerHTML = err
            if (asmSel) asmSel.innerHTML = err
            if (histSel) histSel.innerHTML = err
        }
    }

    // Client-generated print identifier — never calls the API, must be unique per print attempt
    function genUniqueId() {
        const B32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ'
        let id = ''
        for (let i = 0; i < 10; i++) id += B32[Math.floor(Math.random() * 32)]
        return 'PRT_' + id
    }

    function buildQrContent(data, qrFields) {
        if (!qrFields || !qrFields.length) return JSON.stringify(data)
        const selectedKeys = qrFields.filter(f => f.inQr).map(f => f.key)
        const obj = {}
        selectedKeys.forEach(k => { if (data[k] !== undefined && data[k] !== null && data[k] !== '') obj[k] = data[k] })
        return JSON.stringify(obj)
    }

    // Parse the JSON blob stored in zplData field
    function parseZplDataJson(layout) {
        const raw = layout.zplData
        if (!raw) return {}
        try {
            const obj = JSON.parse(raw)
            if (obj && typeof obj === 'object' && !Array.isArray(obj)) {
                // Migrate stale saved label "PROD AREA" → "AREA"
                if (Array.isArray(obj.labelFields)) {
                    obj.labelFields.forEach(f => {
                        if (f.key === 'productionArea' && f.label === 'PROD AREA') f.label = 'AREA'
                    })
                }
                return obj
            }
        } catch (_) {}
        return { zplTemplate: raw }  // legacy: plain ZPL string
    }

    function parseLayoutFields(layout) {
        const config = parseZplDataJson(layout)
        const lf = config.labelFields
        if (!lf) return null
        try {
            if (Array.isArray(lf) && lf[0]?.key) return lf
            if (Array.isArray(lf)) return lf.map(k => ({ key:k, label:FIELD_LABELS[k]??k, show:true }))
        } catch (_) {}
        return null
    }

    // ── ZPL Builder ──
function buildZpl({ qrContent, textFields, qrX, qrY, qrSize, dataX, dataY, fontSize, valOffset, lineHeight, printOffsetX = 0 }) {
        const lineH  = lineHeight ?? Math.round(fontSize * 1.5)
        const pqrX   = qrX   + printOffsetX
        const pdataX = dataX + printOffsetX
        let zpl = `^XA\n^CI28\n`
        zpl += `^FO${pqrX},${qrY}^BQN,2,${qrSize}^FDMA,${qrContent}^FS\n`

        textFields.forEach(({ label, value }, i) => {
            const y = dataY + i * lineH
            zpl += `^FO${pdataX},${y}^A0N,${fontSize},${fontSize}^FD${label}:^FS\n`
            zpl += `^FO${pdataX + valOffset},${y}^A0N,${fontSize},${fontSize}^FD${value}^FS\n`
        })

        zpl += `^XZ`
        return zpl
    }

    function buildZplTemplate(fields) {
        const qrX      = +document.getElementById('slQrX').value
        const qrY      = +document.getElementById('slQrY').value
        const qrSize   = +document.getElementById('slQrSize').value
        const dataX    = +document.getElementById('slDataX').value
        const dataY    = +document.getElementById('slDataY').value
        const fontSize = +document.getElementById('slFontSize').value
        const valOffset= +document.getElementById('slValOffset').value
        const lineH    = Math.round(fontSize * 1.5)
        let zpl = `^XA\n^CI28\n`
        zpl += `^FO${qrX},${qrY}^BQN,2,${qrSize}^FDMA,{qrContent}^FS\n`
        fields.filter(f => f.show).forEach(({ key, label }, i) => {
            const y = dataY + i * lineH
            zpl += `^FO${dataX},${y}^A0N,${fontSize},${fontSize}^FD${label}:^FS\n`
            zpl += `^FO${dataX + valOffset},${y}^A0N,${fontSize},${fontSize}^FD{${key}}^FS\n`
        })
        zpl += `^XZ`
        return zpl
    }

    // ── ZPL Preview — client-side renderer (ไม่ต้องเน็ต ไม่ผ่าน server) ──
    async function callZplPreview(zpl, dpi, width, height) {
        return await renderZplClient(zpl, dpi, width, height)
    }

    // ── ZPL Client Renderer ───────────────────────────────────────────────
    const ZPL_DPI = { '6dpmm':152, '8dpmm':203, '12dpmm':300, '24dpmm':600 }

    // Preload ZebraFont ให้ browser และ Canvas รู้จักก่อน render
    const _zebraFontReady = document.fonts.load('bold 20px ZebraFont')

    async function renderZplClient(zpl, dpiStr, widthInch, heightInch) {
        await _zebraFontReady  // รอให้ font โหลดเสร็จก่อน
        const dpi = ZPL_DPI[dpiStr] || 203
        const cw  = Math.round((+widthInch  || 4) * dpi)
        const ch  = Math.round((+heightInch || 3) * dpi)

        const canvas = document.createElement('canvas')
        canvas.width  = cw
        canvas.height = ch
        const ctx = canvas.getContext('2d')
        ctx.fillStyle = '#fff'
        ctx.fillRect(0, 0, cw, ch)

        // ── Parse ZPL by splitting on '^' ──────────────────────────────
        // แต่ละ segment หลัง ^ คือ: 2 chars = command, ส่วนที่เหลือ = params/data
        // เช่น 'A0N,22,22' → cmd='A0', rest='N,22,22'
        //       'BQN,2,5'  → cmd='BQ', rest='N,2,5'
        //       'FDVENDOR:' → cmd='FD', rest='VENDOR:'
        const segs = zpl.split('^').slice(1)

        let fo           = { x:0, y:0 }
        let fontH        = 20
        let pendingBQ    = null
        let qrDrawBounds = null

        for (const seg of segs) {
            const cmd  = seg.slice(0, 2)
            const rest = seg.slice(2).replace(/[\r\n]+$/, '') // trim trailing newline

            switch (cmd) {
                case 'FO': {
                    const p = rest.split(',')
                    fo = { x: +p[0]||0, y: +p[1]||0 }
                    break
                }
                case 'A0': {
                    // rest = 'N,22,22' → strip orientation letter prefix
                    const p = rest.replace(/^[A-Z],/, '').split(',')
                    fontH = +p[0] || 20
                    break
                }
                case 'BQ': {
                    const p = rest.split(',')
                    pendingBQ = { mag: +p[2] || 3 }
                    break
                }
                case 'GF': {
                    // ^GFA,totalBytes,totalBytes,bytesPerRow,hexData
                    const parts = rest.split(',')
                    if (parts.length < 5) break
                    const bytesPerRow = parseInt(parts[3])
                    const hexStr = parts.slice(4).join('')
                    if (!bytesPerRow || !hexStr.trim()) break

                    const rows     = Math.floor(hexStr.length / (bytesPerRow * 2))
                    const imgWidth = bytesPerRow * 8
                    const imgData  = ctx.createImageData(imgWidth, rows)
                    const d = imgData.data

                    for (let r = 0; r < rows; r++) {
                        for (let b = 0; b < bytesPerRow; b++) {
                            const ho   = (r * bytesPerRow + b) * 2
                            const byte = parseInt(hexStr.slice(ho, ho + 2), 16)
                            for (let bit = 0; bit < 8; bit++) {
                                const dark  = (byte >> (7 - bit)) & 1
                                const pxOff = (r * imgWidth + b * 8 + bit) * 4
                                d[pxOff]     = dark ? 0   : 255
                                d[pxOff + 1] = dark ? 0   : 255
                                d[pxOff + 2] = dark ? 0   : 255
                                d[pxOff + 3] = dark ? 255 : 0    // white = transparent
                            }
                        }
                    }
                    ctx.putImageData(imgData, fo.x, fo.y)
                    break
                }
                case 'FD': {
                    if (pendingBQ) {
                        // ── QR Code — ใช้ server endpoint (ไม่ต้องเน็ต) ──
                        let data = rest
                        let ecl  = 'M' // default
                        // ^FDLA,{data} → L=ECL Low, M=Medium, Q=Quartile, H=High
                        const eclMatch = data.match(/^([LMQH])A,/)
                        if (eclMatch) { ecl = eclMatch[1]; data = data.slice(3) }
                        try {
                            const img = new Image()
                            img.src = `/api/qr/image?data=${encodeURIComponent(data)}&scale=${pendingBQ.mag}&ecl=M`
                            await new Promise((resolve, reject) => {
                                img.onload  = resolve
                                img.onerror = () => reject(new Error('QR image load failed'))
                            })
                            // QRCoder ใส่ quiet zone 4 modules ไว้ใน PNG เสมอ
                            // X: ลบ qz ออกทั้งหมด → ชิดขอบซ้าย
                            // Y: ลบ qz แต่คืน 2 modules → เว้นขอบบนนิดหน่อย
                            const qz  = 4 * pendingBQ.mag
                            const dx  = fo.x - qz
                            const dy  = fo.y - qz + pendingBQ.mag * 2
                            ctx.drawImage(img, dx, dy)
                            qrDrawBounds = { x: dx, y: dy, w: img.naturalWidth, h: img.naturalHeight, qz }
                        } catch (e) {
                            console.warn('[ZPL] QR error:', e.message)
                            ctx.strokeStyle = '#aaa'
                            ctx.lineWidth   = 2
                            ctx.strokeRect(fo.x, fo.y, 80, 80)
                            ctx.fillStyle = '#aaa'
                            ctx.font = '11px sans-serif'
                            ctx.fillText('QR', fo.x + 32, fo.y + 44)
                        }
                        pendingBQ = null
                    } else if (rest) {
                        // ── Text ──
                        ctx.fillStyle = '#000'
                        ctx.font = `bold ${fontH}px ZebraFont, "Arial Narrow", sans-serif`
                        ctx.fillText(rest, fo.x, fo.y + fontH * 0.85)
                    }
                    break
                }
            }
        }


        return canvas.toDataURL('image/png')
    }

    // ── Hardware Barcode Scanner (dedicated input — same approach as Receive page) ──
    let _rpHwScanActive = false

    function _rpHwScanSetBtns(active) {
        const ids = ['rcHwScanBtn', 'rprHwScanBtn', 'asmHwScanBtn']
        ids.forEach(id => {
            const b = document.getElementById(id)
            if (!b) return
            if (active) {
                b.style.background = '#dc2626'
                b.onmouseover = () => b.style.background = '#b91c1c'
                b.onmouseout  = () => b.style.background = '#dc2626'
            } else {
                b.style.background = '#6b7280'
                b.onmouseover = () => b.style.background = '#4b5563'
                b.onmouseout  = () => b.style.background = '#6b7280'
            }
        })
    }

    const rpHwScanner = createHwScanner({
        inputId: 'hwInput', statusId: 'hwStatus',
        onScan: onScannerInput
    })

    function rpToggleHwScan() {
        _rpHwScanActive = !_rpHwScanActive
        const section = document.getElementById('hwSection')
        if (_rpHwScanActive) {
            // Move section to after rp-card-head of the relevant item list card
            const tabId = document.querySelector('.tab-pane.active')?.id
            if (tabId === 'tab-reprint') {
                const anchor = document.getElementById('rprScanAnchor')
                if (anchor) anchor.appendChild(section)
            } else if (tabId === 'tab-assembly') {
                const head = document.getElementById('asmMaterialsList')?.closest('.rp-card')?.querySelector('.rp-card-head')
                if (head) head.after(section)
            } else {
                // Receive tab — insert after rp-card-head inside the item list card
                const head = document.getElementById('rcItemList')?.closest('.rp-card')?.querySelector('.rp-card-head')
                if (head) head.after(section)
            }
            section.style.display = ''
            _rpHwScanSetBtns(true)
            setTimeout(() => rpHwScanner.open(), 80)
        } else {
            rpHwScanner.close()
            section.style.display = 'none'
            _rpHwScanSetBtns(false)
        }
    }

    function rpCloseHwScan() {
        if (!_rpHwScanActive) return
        _rpHwScanActive = false
        rpHwScanner.close()
        const section = document.getElementById('hwSection')
        if (section) section.style.display = 'none'
        _rpHwScanSetBtns(false)
    }

    function logScannerInput(code) {
        const tbody = document.getElementById('scannerLogBody')
        if (!tbody) return
        const now = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
        tbody.innerHTML = `
            <tr>
                <td style="padding:8px 14px;color:var(--t3);white-space:nowrap">${now}</td>
                <td style="padding:8px 14px;font-family:ui-monospace,monospace;word-break:break-all">${escHtml(code)}</td>
                <td style="padding:8px 14px;color:var(--t2)">${code.length} chars</td>
            </tr>`
    }

    async function onScannerInput(code) {
        logScannerInput(code)
        const isAssembly = document.getElementById('tab-assembly')?.classList.contains('active')
        const isReprint  = document.getElementById('tab-reprint')?.classList.contains('active')
        try {
            if (isReprint) {
                const lotNo = rprExtractLotNoFromRaw(code) || (code || '').trim()
                const ok = await rprFetchAndAddByLotNo(lotNo)
                if (ok) showToast('✅ LOT added (' + rprItems.length + '/10)', 'success')
                return
            }
            const res = await api('/scan', 'POST', { barcode: code, mode: 0 })
            if (isAssembly) {
                const lotNo = res.wH_TraceId || res.lotNo || res.traceId || code
                const ok = asmAddLot(lotNo, res.partNo || null)
                const filled = asmMaterials.filter(m => m.lotNo).length
                if (ok) showToast('✅ Lot added (' + filled + '/' + asmMaterials.length + ')', 'success')
            } else {
                const traceKey = code
                if (rcScannedTrace.has(traceKey)) {
                    showToast('⚠️ สแกนซ้ำ', 'error')
                } else {
                    const data = mapScanResponse(res)
                    data._barcode = traceKey
                    const ok = await rcAddItem(data)
                    if (ok) {
                        rcScannedTrace.add(traceKey)
                        showToast('✅ Added ' + (data.partNo || code) + ' (' + rcItems.length + '/10)', 'success')
                    }
                }
            }
        } catch (err) {
            showToast('❌ ' + (err?.message || String(err)), 'error')
        }
    }

    // ── Camera Barcode Scanner (shared across Receive, Reprint, Assembly tabs) ──
    let _rpScanMode = 'receive'
    let _rpScannerOrigParent = null
    let _rpLastScanTime = 0
    const _RP_COOLDOWN = 1500

    const rpScanner = createBarcodeScanner({
        videoId: 'bcVideo', canvasId: 'bcCanvas', labelId: 'bcLabel',
        onDetect: _rpHandleScan, idleText: '— Scanning for barcode —'
    })

    window.addEventListener('beforeunload', () => stopScan())

    function rcToggleCam() {
        _rpScanMode = 'receive'
        if (rpScanner.running) stopScan(); else rpStartScan()
    }

    function rprToggleCam() {
        _rpScanMode = 'reprint'
        if (rpScanner.running) stopScan(); else rpStartScan()
    }

    function asmToggleCam() {
        _rpScanMode = 'assemble'
        if (rpScanner.running) stopScan(); else rpStartScan()
    }

    function _rpUpdateCamBtn(open) {
        const id = _rpScanMode === 'reprint'  ? 'rprBtnCam'
                 : _rpScanMode === 'assemble' ? 'asmBtnCam'
                 : 'rcBtnCam'
        const b = document.getElementById(id)
        if (!b) return
        const iconSize = id === 'rcBtnCam' ? '22px' : (id === 'rprBtnCam' ? '18px' : '16px')
        if (open) {
            b.innerHTML = `<i class="bi bi-x-circle" style="font-size:${iconSize}"></i>`
            b.style.background = '#dc2626'
        } else {
            b.innerHTML = `<i class="bi bi-camera" style="font-size:${iconSize}"></i>`
            b.style.background = 'var(--blue)'
        }
    }

    async function rpStartScan() {
        if (rpScanner.running) return
        if (!('BarcodeDetector' in window)) {
            showToast('This browser does not support BarcodeDetector', 'error'); return
        }
        const _scanSection = document.getElementById('bcSection')
        if (_rpScanMode === 'reprint') {
            const anchor = document.getElementById('rprScanAnchor')
            if (anchor && _scanSection) {
                if (!_rpScannerOrigParent) _rpScannerOrigParent = _scanSection.parentNode
                anchor.appendChild(_scanSection)
            }
        } else if (_rpScanMode === 'receive') {
            const anchor = document.getElementById('rcScanAnchor')
            if (anchor && _scanSection) {
                if (!_rpScannerOrigParent) _rpScannerOrigParent = _scanSection.parentNode
                anchor.appendChild(_scanSection)
            }
        }
        _scanSection.style.display = ''
        document.getElementById('bcStatus').textContent = 'Scanning…'
        if (_rpScanMode === 'receive') {
            const body = document.getElementById('rcWoCardBody')
            if (body) body.style.display = 'none'
        } else if (_rpScanMode === 'assemble') {
            const body = document.getElementById('asmOutputCardBody')
            if (body) body.style.display = 'none'
        }
        _rpUpdateCamBtn(true)
        try {
            await rpScanner.start()
        } catch (err) {
            showToast(err.message.includes('BarcodeDetector') ? err.message : 'Failed to open camera: ' + err.message, 'error')
            _scanSection.style.display = 'none'
            _rpUpdateCamBtn(false)
        }
    }

    function _rpHandleScan(text) {
        const now = Date.now()
        if (now - _rpLastScanTime < _RP_COOLDOWN) return
        _rpLastScanTime = now
        document.getElementById('bcStatus').textContent = '⏳ Processing...'
        rpOnScanSuccess(text)
        setTimeout(() => {
            const el = document.getElementById('bcStatus')
            if (el) el.textContent = 'Scanning…'
        }, 2000)
    }

    function stopScan() {
        rpScanner.stop()
        const _scanSection = document.getElementById('bcSection')
        _scanSection.style.display = 'none'
        if (_rpScannerOrigParent && _scanSection.parentNode !== _rpScannerOrigParent) {
            _rpScannerOrigParent.appendChild(_scanSection)
        }
        const woBody = document.getElementById('rcWoCardBody')
        if (woBody) woBody.style.display = ''
        const asmBody = document.getElementById('asmOutputCardBody')
        if (asmBody) asmBody.style.display = ''
        _rpUpdateCamBtn(false)
    }

    async function switchCamera() {
        await rpScanner.switchCamera()
    }

    function rpSetCamFooter(msg) {
        const el = document.getElementById('bcStatus')
        if (el) el.textContent = msg
    }

    async function rpOnScanSuccess(text) {
        if (_rpScanMode === 'reprint') {
            const lotNo = rprExtractLotNoFromRaw(text) || (text || '').trim()
            try {
                const ok = await rprFetchAndAddByLotNo(lotNo)
                rpSetCamFooter(ok
                    ? '✅ LOT added (' + rprItems.length + '/10)'
                    : '⚠️ Unable to add LOT')
            } catch (err) {
                rpSetCamFooter('❌ ' + (err?.message || String(err)))
            }
            return
        }

        try {
            const res = await api('/scan', 'POST', { barcode: text, mode: 0 })

            if (_rpScanMode === 'assemble') {
                const lotNo = res.wH_TraceId || res.lotNo || res.traceId || text
                const ok = asmAddLot(lotNo, res.partNo || null)
                const filled = asmMaterials.filter(m => m.lotNo).length
                rpSetCamFooter(ok
                    ? '✅ Lot added (' + filled + '/' + asmMaterials.length + ')'
                    : '⚠️ Unable to add Lot')
                return
            }

            const traceKey = text
            if (rcScannedTrace.has(traceKey)) {
                showToast('สแกนซ้ำ', 'error')
                rpSetCamFooter('⚠️ สแกนซ้ำ')
                return
            }
            const data = mapScanResponse(res)
            if (!data) {
                showToast('⚠️ No data received from barcode', 'error')
                rpSetCamFooter('⚠️ No data received from barcode')
                return
            }
            data._barcode = traceKey
            const ok = await rcAddItem(data)
            if (ok) rcScannedTrace.add(traceKey)
            if (!ok) showToast('⚠️ Unable to add item', 'error')
            rpSetCamFooter(ok
                ? '✅ Added ' + (data.partNo || 'item') + ' (' + rcItems.length + '/10)'
                : '⚠️ Unable to add item')
        } catch (err) {
            if (_rpScanMode === 'receive') showToast('❌ ' + (err?.message || String(err)), 'error')
            rpSetCamFooter('❌ ' + (err?.message || String(err)))
        }
    }

    // ── Printer dropdown (shared across Receive, Reprint, Assembly) ──
    const _RP_PD = [
        { ns: 'rc',        menuId: 'rcPrinterMenu',       hiddenId: 'rcPrinterSelect'       },
        { ns: 'rpReprint', menuId: 'rpReprintPrinterMenu', hiddenId: 'rpReprintPrinterSelect' },
        { ns: 'asm',       menuId: 'asmPrinterMenu',       hiddenId: 'asmPrinterSelect'      },
    ]

    function rpPrinterDdToggle(ns) {
        const menu    = document.getElementById(ns + 'PrinterMenu')
        const trigger = document.getElementById(ns + 'PrinterTrigger')
        if (!menu) return
        const opening = menu.style.display === 'none'
        rpPrinterDdCloseAll()
        if (opening) {
            menu.style.display = ''
            trigger?.classList.add('open')
        }
    }

    function rpPrinterDdCloseAll() {
        document.querySelectorAll('.rp-pd-menu').forEach(m => m.style.display = 'none')
        document.querySelectorAll('.rp-pd-trigger').forEach(t => t.classList.remove('open'))
    }

    document.addEventListener('click', e => {
        if (!e.target.closest('.rp-pd-wrap')) rpPrinterDdCloseAll()
    })

    function rpPrinterPickFromEl(el) {
        rpPrinterPick(el.dataset.ns, el.dataset.ip, el.dataset.name, el.dataset.online === 'true', el.dataset.port)
    }

    function rpPrinterPick(ns, ip, name, online, port) {
        const hidden = document.getElementById(ns + 'PrinterSelect')
        if (hidden) { hidden.value = ip; hidden.dataset.port = port || 9100 }

        const dot = document.getElementById(ns + 'PrinterDot')
        if (dot) { dot.className = 'rp-pd-dot' + (online ? ' online' : ''); dot.style.display = '' }
        const nameEl = document.getElementById(ns + 'PrinterName')
        if (nameEl) { nameEl.textContent = name; nameEl.style.color = ''; nameEl.style.fontWeight = '600' }
        const ipEl = document.getElementById(ns + 'PrinterIp')
        if (ipEl) { ipEl.textContent = ip; ipEl.style.display = '' }

        document.getElementById(ns + 'PrinterMenu')?.querySelectorAll('.rp-pd-item').forEach(item => {
            const sel = item.dataset.ip === ip
            item.classList.toggle('active', sel)
            const chk = item.querySelector('.rp-pd-check')
            if (chk) chk.style.display = sel ? '' : 'none'
        })
        rpPrinterDdCloseAll()
        if (ns === 'rpReprint') rprSyncPrintBtn()
    }

    async function rpLoadPrinters() {
        _RP_PD.forEach(c => {
            const m = document.getElementById(c.menuId)
            if (m) m.innerHTML = '<div class="rp-pd-msg"><span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>Loading…</div>'
        })

        let allPrinters = []
        try {
            const res = await api('/printer/all', 'GET')
            allPrinters = Array.isArray(res) ? res : (res?.data ?? [])
        } catch (err) {
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (m) m.innerHTML = '<div class="rp-pd-msg" style="color:var(--red)">⚠️ Load failed</div>'
            })
            showToast('Failed to load printers: ' + err.message, 'error')
            return
        }

        const activePrinters = allPrinters.filter(p => p.isActive !== false)
        if (activePrinters.length === 0) {
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (m) m.innerHTML = '<div class="rp-pd-msg">No printers found</div>'
            })
            return
        }

        // status: undefined = ยังไม่โหลด (⏳), null = โหลดแล้ว fail, object = ผลจริง (มี isReady)
        const statusMap = {}

        const buildItems = ns =>
            activePrinters.map(p => {
                const st     = statusMap[p.printerIp]
                const online = st?.isReady === true
                return `<div class="rp-pd-item"
                             data-ns="${escHtml(ns)}"
                             data-ip="${escHtml(p.printerIp)}"
                             data-port="${p.printerPort || 9100}"
                             data-name="${escHtml(p.printerName.replace(/[\r\n]+/g,' ').trim())}"
                             data-online="${online}"
                             onclick="rpPrinterPickFromEl(this)">
                    <span class="rp-pd-dot${online ? ' online' : ''}"></span>
                    <div class="rp-pd-info">
                        <span class="rp-pd-item-name">${escHtml(p.printerName.replace(/[\r\n]+/g,' ').trim())}</span>
                        <span class="rp-pd-item-ip">${escHtml(p.printerIp)}</span>
                    </div>
                    <i class="bi bi-check2 rp-pd-check" style="display:none"></i>
                </div>`
            }).join('')

        // แสดง dropdown ทันทีจาก /printer/all — สถานะ online ยังไม่รู้ (dot เทาไว้ก่อน)
        _RP_PD.forEach(c => {
            const m = document.getElementById(c.menuId)
            if (!m) return
            const prevIp = document.getElementById(c.hiddenId)?.value
            m.innerHTML = buildItems(c.ns)
            if (prevIp) {
                m.querySelectorAll('.rp-pd-item').forEach(item => {
                    const sel = item.dataset.ip === prevIp
                    item.classList.toggle('active', sel)
                    const chk = item.querySelector('.rp-pd-check')
                    if (chk) chk.style.display = sel ? '' : 'none'
                })
            }
        })

        // ยิง /printer/status ทีละตัวแบบ background — พอผลกลับมาก็ patch แค่ row นั้น (ไม่ re-render ทั้ง list)
        activePrinters.forEach(p => {
            api(`/printer/status/${encodeURIComponent(p.printerIp)}/${p.printerPort || 9100}`, 'GET')
                .then(st => _rpPatchPrinterStatus(p.printerIp, st))
                .catch(() => _rpPatchPrinterStatus(p.printerIp, null))
        })
    }

    function _rpPatchPrinterStatus(ip, status) {
        const online = status?.isReady === true
        document.querySelectorAll(`.rp-pd-item[data-ip="${ip}"]`).forEach(item => {
            item.dataset.online = online
            const dot = item.querySelector('.rp-pd-dot')
            if (dot) dot.className = 'rp-pd-dot' + (online ? ' online' : '')
        })
        // sync จุดสถานะที่ trigger ด้วย ถ้า printer นี้ถูกเลือกอยู่
        _RP_PD.forEach(c => {
            const hidden = document.getElementById(c.hiddenId)
            if (hidden?.value !== ip) return
            const dot = document.getElementById(c.ns + 'PrinterDot')
            if (dot) dot.className = 'rp-pd-dot' + (online ? ' online' : '')
        })
    }

    // ── Init ──
    loadLayoutsIntoSelect()
    loadLayoutList()
    rpLoadPrinters()
</script>
}


