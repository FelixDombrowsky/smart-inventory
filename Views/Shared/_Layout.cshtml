                <a class="sf-link" id="transactionsNav" href="Inventory/Transactions"><i class="bi bi-arrow-left-right"></i><span class="sf-nav-label nav-label">Transactions</span></a>
            </div>
            <div class="sf-nav-group" id="navGroupOperations">
                <div class="sf-nav-head pill-group-title">Operations</div>
                <a class="sf-link" id="receiveNav" href="Inventory/Receive"><i class="bi bi-box-arrow-in-down"></i><span class="sf-nav-label nav-label">Receive</span></a>
                <a class="sf-link" id="moveNav" href="Inventory/Move"><i class="bi bi-arrows-move"></i><span class="sf-nav-label nav-label">Move</span></a>
                <a class="sf-link" id="splitNav" href="Inventory/Split"><i class="bi bi-scissors"></i><span class="sf-nav-label nav-label">Split</span></a>
                <a class="sf-link" id="mergeNav" href="Inventory/Merge"><i class="bi bi-layers"></i><span class="sf-nav-label nav-label">Merge</span></a>
