    --bg:       #0f172a;
    --blue-lt:  #1e3553;
    --green-lt: #052e1c;
    --amber-lt: #2d1a00;
    --red-lt:   #2d0a0a;
    --purple-lt:#2e1065;
}
[data-theme="dark"] body                        { background: #0f172a !important; }
