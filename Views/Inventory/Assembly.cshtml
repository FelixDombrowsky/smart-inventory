@section Scripts {
<script src="js/api.js"></script>
<script src="js/zplBuilder.js"></script>
<script src="js/printerPicker.js"></script>
<script src="js/apiForm.js"></script>
<script src="js/photoCapture.js"></script>
<script src="js/barcodeScanner.js"></script>
<script src="js/hwScanner.js"></script>
<script src="js/scanPipeline.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/loadPrinter.js"></script>
<script src="js/locationTypeMeta.js"></script>
<script src="js/itemTypeMeta.js"></script>
<script src="js/workOrderAutocomplete.js"></script>
<script src="lib/html5-qrcode/html5-qrcode.min.js"></script>
<script>
    // ── State ─────────────────────────────────────────
    let asmScannedLots = new Set()
    let _asmSubmitting = false

    // คำแปลของหน้านี้ (ASSEMBLY_LABELS มาจาก js/i18n.js) — เรียก asmDict() สดทุกจุดที่สร้างข้อความแทน hardcode
    function asmDict() { return ASSEMBLY_LABELS[getCurrentLang()] || ASSEMBLY_LABELS.en }

    // ── Draft (auto-save ลง sessionStorage กันข้อมูลหายตอน Refresh/ปิดแท็บพลาด) ─────────────────────
    // เช็คตั้งแต่บรรทัดแรกๆ ของสคริปต์เลย (ก่อนโค้ดอื่นมีโอกาสรัน) ว่ามี draft ค้างจากรอบก่อนไหม แล้วตั้ง flag กันไว้ก่อน —
    // ถ้าไปเช็คทีหลังใน init() เฉยๆ เสี่ยงมี asmUpdateState() ตัวอื่นทำงานแทรกระหว่างนั้นแล้ว auto-save ทับ draft เดิมทิ้งไป
    // ก่อน user จะได้เห็นตัวเลือกกู้คืนด้วยซ้ำ — flag นี้เคลียร์ก็ต่อเมื่อ user กด "กู้คืน"/"ทิ้งไป" เท่านั้น (ดู asmRestoreDraft/asmDiscardDraft)
    const ASM_DRAFT_KEY = 'asmDraft'
    let _asmDraftPending = false
    try { _asmDraftPending = !!sessionStorage.getItem(ASM_DRAFT_KEY) } catch (_) {}

    function asmSaveDraft() {
        if (_asmDraftPending) return   // ยังมี draft เดิมค้างรอ user ตัดสินใจอยู่ — ห้าม auto-save ทับ
        try {
            const rows = [...document.querySelectorAll('#asmTable tr[data-lot-no]')].map(row => ({
                lotNo:     row.dataset.lotNo,
                partNo:    row.dataset.partNo,
                avail:     row.dataset.avail,
                workOrder: row.dataset.wo,
                location:  row.dataset.loc,
                unit:      row.dataset.unit,
                line:      row.dataset.line,
                qty:       row.querySelector('[data-qty-input]')?.value ?? '',
            }))
            const outputPartNo = document.getElementById('asmOutputPartInput')?.value.trim() || ''
            const outputQty    = document.getElementById('asmOutputQty')?.value || ''
            // เก็บ W/O + Location Type ที่กำลังค้นหาอยู่ในแผง "Find Lot by Work Order" ไว้ด้วย (แยกจากตาราง Materials หลัก)
            // กันต้องมาพิมพ์ค้นหา W/O ซ้ำในแผงนี้อีกรอบหลัง Restore
            const lfWorkOrder = _asmLfCurrentWo || ''
            const lfLocType   = _asmLfSelectedLocType || ''
            if (!rows.length && !outputPartNo && !outputQty && !lfWorkOrder) { sessionStorage.removeItem(ASM_DRAFT_KEY); return }
            sessionStorage.setItem(ASM_DRAFT_KEY, JSON.stringify({
                outputPartNo, outputQty, outputQtyManual: _asmOutputQtyManual, rows, lfWorkOrder, lfLocType,
            }))
        } catch (_) { /* sessionStorage เต็ม/ถูกปิดไว้ — เงียบไว้ ไม่ให้กระทบการทำงานปกติของหน้า */ }
    }

    function asmClearDraft() {
        try { sessionStorage.removeItem(ASM_DRAFT_KEY) } catch (_) {}
    }

    // เรียกจาก init() — โชว์ banner ถามกู้คืนถ้ามี draft ค้างอยู่ (ไม่ auto-restore เอง กันข้อมูลเก่าโผล่มาแทนโดย user ไม่ทันตั้งตัว)
    function asmShowDraftBannerIfAny() {
        if (_asmDraftPending) document.getElementById('asmDraftBanner').style.display = 'flex'
    }

    function asmDiscardDraft() {
        _asmDraftPending = false
        asmClearDraft()
        document.getElementById('asmDraftBanner').style.display = 'none'
    }

    // กู้คืน draft — ใส่ lot ที่เคยสแกนไว้กลับเข้าตารางก่อน (เหมือนสแกนก่อนเลือก Output Part ตาม flow ปกติของหน้านี้) แล้วค่อยหา
    // BOM profile ของ Output Part เดิม (ถ้ามี) มา apply ซึ่ง asmApplyBomProfile() จะดึง lot ที่เพิ่งใส่กลับไปด้านบน มา
    // revalidate/จัดกลุ่มใหม่ให้เองอัตโนมัติอยู่แล้ว (ใช้ path เดียวกับตอนสแกนก่อนแล้วค่อยเลือก Output Part ทีหลัง ไม่ต้องเขียนซ้ำ)
    async function asmRestoreDraft() {
        _asmDraftPending = false
        document.getElementById('asmDraftBanner').style.display = 'none'

        let draft
        try { draft = JSON.parse(sessionStorage.getItem(ASM_DRAFT_KEY) || 'null') } catch (_) { draft = null }
        if (!draft) return

        ;(draft.rows || []).forEach(r => {
            if (!r.lotNo || asmScannedLots.has(r.lotNo)) return
            asmScannedLots.add(r.lotNo)
            asmAddRow({
                lotNo: r.lotNo, partNo: r.partNo, onHandQty: parseFloat(r.avail) || 0,
                workOrder: r.workOrder, location: r.location, unit: r.unit, lineName: r.line,
            })
        })

        if (draft.outputPartNo) {
            document.getElementById('asmOutputPartInput').value = draft.outputPartNo
            try {
                const res     = await api(`/master/bom-profiles?Search=${encodeURIComponent(draft.outputPartNo)}&IsActive=true&page=1&pageSize=20`, 'GET')
                const list    = Array.isArray(res) ? res : (res?.items || [])
                const profile = list.find(x => x.outputPartNo === draft.outputPartNo)
                if (profile) {
                    document.getElementById('asmOutputPartNo').value = profile.outputPartNo
                    asmApplyBomProfile(profile)
                    if (draft.outputQtyManual && draft.outputQty) {
                        document.getElementById('asmOutputQty').value = draft.outputQty
                        _asmOutputQtyManual = true
                    }
                }
            } catch (_) { /* หา BOM profile เดิมไม่เจอ — lot ที่กู้คืนมายังอยู่ในตารางแบบยังไม่ผูก Output Part ใช้งานต่อได้ปกติ */ }
        }

        // กู้คืนแผง "Find Lot by Work Order" ด้วย — ไม่ต้องมาพิมพ์ค้นหา W/O ซ้ำอีกรอบ (เปิดแผงให้ + โหลดผลลัพธ์เดิมกลับมาเลย)
        if (draft.lfWorkOrder) {
            document.getElementById('asmLotFinderSection').style.display = ''
            document.getElementById('asmLfBtn').style.background = '#5b21b6'
            await asmLfInit()
            document.getElementById('asmLfWoInput').value = draft.lfWorkOrder
            await asmLfLoadWorkOrder(draft.lfWorkOrder)   // เลือก Location Type default (PreAssembly) ให้เองแล้วด้านในนี้
            if (draft.lfLocType) asmLfPickLocType(draft.lfLocType)   // ทับด้วยตัวที่เคยเลือกไว้จริง (ถ้าต่างจาก default)
        }

        asmUpdateState()
        toast(asmDict().draftRestored, 'ok')
    }

    function toast(msg, type, opts) {
        const wrap = document.getElementById('toastWrap');
        const el   = document.createElement('div');
        el.className = 'toast-item ' + (type === 'ok' ? 'toast-ok' : type === 'warn' ? 'toast-warn' : 'toast-err');
        if (opts?.mono) el.classList.add('toast-mono')
        el.textContent = msg;
        wrap.appendChild(el);
        const duration = opts?.duration ?? (type === 'warn' ? 5000 : 3000)
        setTimeout(() => el.remove(), duration);
        return el
    }

    // toast payload เป็น JSON อ่านง่าย — ใช้ตอนดู payload จริงบน tablet ที่เปิด console ไม่ได้
    function toastPayload(label, payload) {
        toast(`${label}\n${JSON.stringify(payload, null, 2)}`, 'ok', { mono: true, duration: 12000 })
    }

    function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    // ใช้ escape ค่าที่ฝังเป็น string literal ใน onclick="..." (ต่างจาก esc() ที่ escape HTML entity เฉยๆ ไม่พอสำหรับใน JS string)
    function escJs(s) { return String(s ?? '').replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }

    // ── รูป + ชื่อของแต่ละ Part (Output/Component) — /master/bom-profiles ไม่ได้ส่งรูปมาด้วย ต้องดึงทีละ part ผ่าน /master/items/{partNo} เอง ──
    const ASM_NO_IMG = `data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2740%27 height=%2740%27 viewBox=%270 0 40 40%27%3E%3Crect width=%2740%27 height=%2740%27 rx=%276%27 fill=%27%23f0f2f5%27/%3E%3Cpath d=%27M14 26l5-6 4 5 3-3 4 4H10z%27 fill=%27%23d1d5db%27/%3E%3Ccircle cx=%2726%27 cy=%2716%27 r=%273%27 fill=%27%23d1d5db%27/%3E%3C/svg%3E`
    let _asmItemInfoCache = {}   // partNo → { itemName, imagePath } (imagePath ว่าง = confirmed ไม่มีรูป)
    let _asmImgCacheBust  = Date.now()

    function asmImgSrc(partNo) {
        const info = _asmItemInfoCache[partNo]
        return info?.imagePath ? (CONFIG.INVENTORY_API + info.imagePath + '?t=' + _asmImgCacheBust) : ASM_NO_IMG
    }
    function asmItemName(partNo) {
        return _asmItemInfoCache[partNo]?.itemName || ''
    }
    function asmOpenImg(src, caption) {
        document.getElementById('asmImgEl').src = src
        document.getElementById('asmImgCaption').textContent = caption || ''
        document.getElementById('asmImgOverlay').style.display = 'flex'
    }
    function asmCloseImg() {
        document.getElementById('asmImgOverlay').style.display = 'none'
        document.getElementById('asmImgEl').src = ''
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') asmCloseImg() })

    // ยิงหลังบ้าน (ไม่ await ตอนเรียก) — โหลดชื่อ+รูปของแต่ละ part ที่ยังไม่เคย fetch แล้ว patch DOM ของ part นั้นเมื่อเสร็จ ไม่บล็อกการ render
    async function asmLoadPartsInfo(partNos, onEach) {
        const uncached = [...new Set(partNos)].filter(p => p && !(p in _asmItemInfoCache))
        await Promise.all(uncached.map(async partNo => {
            try {
                const item = await api(`/master/items/${encodeURIComponent(partNo)}`, 'GET')
                _asmItemInfoCache[partNo] = { itemName: item?.itemName || '', imagePath: item?.imagePath || '' }
            } catch {
                _asmItemInfoCache[partNo] = { itemName: '', imagePath: '' }
            }
            onEach?.(partNo)
        }))
    }

    // ── Output Part autocomplete (ค้นจาก GET /master/bom-profiles?Search=...&IsActive=true — โชว์เฉพาะ outputPartNo ที่มี BOM Active อยู่แล้ว) ─────
    let _asmPnResults = []
    let _asmOutputSearchTimer = null
    let _asmOutputSearchToken = 0   // กัน race: พิมพ์เร็ว ๆ แล้ว response ของ query เก่ามาถึงช้ากว่า query ใหม่ จะได้ไม่ทับผลลัพธ์ที่ถูกต้อง

    // Render dropdown item ของแต่ละ Output Part พร้อมสูตร BOM (component part No. + ชื่อ + จำนวน) ใต้ชื่อ output part เลย
    // ใช้ร่วมกันทั้ง _asmDoSearchOutputPart() (พิมพ์ค้นหา) และ asmOutputPartFocus() (เดาจาก lot ที่สแกนไว้)
    // isStale (ถ้าส่งมา) เช็คก่อนเขียน DOM หลัง await โหลดชื่อ component เสร็จ — กัน query เก่าที่ยังโหลดชื่อไม่เสร็จมาทับผลลัพธ์ของ query ใหม่กว่าที่ resolve ไปก่อนแล้ว
    async function asmRenderOutputPartDd(dd, results, isStale) {
        // โหลดรูป+ชื่อของ output part เองและทุก component part No. ที่ปรากฏใน results มาก่อน (cache เดียวกับ asmImgSrc/asmItemName — no-op ถ้าเคย fetch แล้ว)
        const compPartNos   = results.flatMap(x => (Array.isArray(x.components) ? x.components : []).map(c => c.componentPartNo).filter(Boolean))
        const outputPartNos = results.map(x => x.outputPartNo).filter(Boolean)
        const allPartNos    = [...outputPartNos, ...compPartNos]
        if (allPartNos.length) await asmLoadPartsInfo(allPartNos)
        if (isStale && isStale()) return

        dd.innerHTML = results.map((x, i) => {
            const comps = (Array.isArray(x.components) ? x.components : []).map(c => `
                <div style="display:flex;align-items:center;gap:8px;padding-left:22px;font-size:13px;color:var(--t2)">
                    <span style="color:var(--t3)">└</span>
                    <img src="${asmImgSrc(c.componentPartNo)}" onerror="this.src='${ASM_NO_IMG}'"
                         style="width:28px;height:28px;object-fit:cover;border-radius:6px;border:1px solid var(--border);flex-shrink:0">
                    <span style="font-family:ui-monospace,monospace;font-weight:600;color:var(--navy)">${esc(c.componentPartNo ?? '—')}</span>
                    <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">${esc(asmItemName(c.componentPartNo) || '')}</span>
                    <span style="color:var(--blue);font-weight:700;flex-shrink:0">x ${(c.quantity ?? 0).toLocaleString()}</span>
                </div>`).join('')
            return `
                <div class="loc-item" onmousedown="asmSelectOutputPart(${i})" style="flex-direction:column;align-items:stretch;gap:4px">
                    <div style="display:flex;align-items:center;gap:10px">
                        <img src="${asmImgSrc(x.outputPartNo)}" onerror="this.src='${ASM_NO_IMG}'"
                             style="width:28px;height:28px;object-fit:cover;border-radius:6px;border:1px solid var(--border);flex-shrink:0">
                        <strong style="flex-shrink:0">${esc(x.outputPartNo)}</strong>
                        ${x.outputItemName ? `<span style="color:var(--t2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(x.outputItemName)}</span>` : ''}
                    </div>
                    ${comps}
                </div>`
        }).join('')
    }

    // debounce กันยิง API รัวทุกตัวอักษรที่พิมพ์ — เคลียร์/ซ่อน dropdown ทันทีถ้าลบข้อความจนว่าง ไม่ต้องรอ debounce
    function asmSearchOutputPart() {
        document.getElementById('asmOutputPartNo').value = ''
        clearTimeout(_asmOutputSearchTimer)
        const text = document.getElementById('asmOutputPartInput').value.trim()
        if (!text) {
            document.getElementById('asmOutputPartDd').style.display = 'none'
            asmUpdateState()
            return
        }
        _asmOutputSearchTimer = setTimeout(_asmDoSearchOutputPart, 300)
    }

    async function _asmDoSearchOutputPart() {
        const dd    = document.getElementById('asmOutputPartDd')
        const text  = document.getElementById('asmOutputPartInput').value.trim()
        if (!text) { dd.style.display = 'none'; asmUpdateState(); return }

        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>${asmDict().searching}</div>`
        dd.style.display = 'block'

        const myToken = ++_asmOutputSearchToken
        try {
            const res = await api(`/master/bom-profiles?Search=${encodeURIComponent(text)}&IsActive=true&page=1&pageSize=20`, 'GET')
            if (myToken !== _asmOutputSearchToken) return   // มี query ใหม่กว่าแซงไปแล้ว ทิ้งผลลัพธ์นี้
            _asmPnResults = Array.isArray(res) ? res : (res?.items || [])
            if (!_asmPnResults.length) {
                dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>${asmDict().noItemsFound}</div>`
                return
            }
            await asmRenderOutputPartDd(dd, _asmPnResults, () => myToken !== _asmOutputSearchToken)
        } catch (err) {
            if (myToken !== _asmOutputSearchToken) return
            dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default"><i class="bi bi-exclamation-circle me-2"></i>${esc(err.message || asmDict().errorGeneric)}</div>`
        }
    }

    function asmSelectOutputPart(i) {
        const x = _asmPnResults[i]
        if (!x) return
        document.getElementById('asmOutputPartInput').value = x.outputPartNo
        document.getElementById('asmOutputPartNo').value    = x.outputPartNo
        document.getElementById('asmOutputPartDd').style.display = 'none'
        asmApplyBomProfile(x)
        asmUpdateState()
    }

    // Enter ในช่องค้นหา Output Part No = เลือกตัวแรกใน list ทันที (ถ้า dropdown กำลังเปิดอยู่)
    function asmOutputPartEnter() {
        const dd = document.getElementById('asmOutputPartDd')
        if (dd.style.display !== 'none' && _asmPnResults.length) asmSelectOutputPart(0)
    }

    function asmHideOutputPartDd() {
        document.getElementById('asmOutputPartDd').style.display = 'none'
        const text  = document.getElementById('asmOutputPartInput').value.trim()
        const match = _asmPnResults.find(x => x.outputPartNo === text)
        document.getElementById('asmOutputPartNo').value = match ? match.outputPartNo : ''
        if (match) asmApplyBomProfile(match)
        asmUpdateState()
    }

    // คลิก/focus ช่องค้นหา Output Part No ตอนที่ยังไม่พิมพ์อะไร + มี lot ที่สแกนเก็บไว้ก่อนแล้ว (ยังไม่ได้เลือก Output Part No)
    // → เดา Output Part No ให้เลย โดยยิง /master/bom-profiles?ComponentPartNo=... ทีละ part No. ที่สแกนไว้ (ตัวที่ไม่ซ้ำกัน)
    // แล้ว intersect เอาเฉพาะ Output Part ที่ BOM มีครบทุก component ที่สแกนไว้จริง (ไม่ใช่แค่ตัวใดตัวหนึ่ง)
    async function asmOutputPartFocus() {
        if (_asmBomProfile) return   // เลือก Output Part ไปแล้ว ไม่ต้องเดาซ้ำ
        if (document.getElementById('asmOutputPartInput').value.trim()) return   // มีข้อความอยู่แล้ว ปล่อยให้ oninput (asmSearchOutputPart) จัดการตามปกติ

        const partNos = [...new Set(
            [...document.querySelectorAll('#asmTable tr[data-lot-no]')].map(row => row.dataset.partNo).filter(Boolean)
        )]
        if (!partNos.length) return   // ยังไม่มี lot ที่สแกนไว้เลย ไม่มีอะไรให้เดา

        const dd = document.getElementById('asmOutputPartDd')
        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>${asmDict().searchingOutputPartMatch}</div>`
        dd.style.display = 'block'

        const myToken = ++_asmOutputSearchToken
        try {
            const resultSets = await Promise.all(partNos.map(async partNo => {
                try {
                    const res = await api(`/master/bom-profiles?ComponentPartNo=${encodeURIComponent(partNo)}&IsActive=true&page=1&pageSize=50`, 'GET')
                    const arr = Array.isArray(res) ? res : (res?.items || [])
                    return new Map(arr.map(x => [x.outputPartNo, x]))
                } catch (_) {
                    return new Map()
                }
            }))
            if (myToken !== _asmOutputSearchToken) return

            // intersect — เอาเฉพาะ Output Part ที่ปรากฏในผลลัพธ์ของ "ทุก" component part No. ที่สแกนไว้ (ต้องมีครบทุกตัว ไม่ใช่แค่ตัวใดตัวหนึ่ง)
            let common = resultSets[0] ?? new Map()
            for (let i = 1; i < resultSets.length; i++) {
                const next = resultSets[i]
                common = new Map([...common].filter(([k]) => next.has(k)))
            }

            if (myToken !== _asmOutputSearchToken) return
            _asmPnResults = [...common.values()]
            if (!_asmPnResults.length) {
                dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>${asmDict().noOutputPartMatchAllComponentsPrefix}${esc(partNos.join(', '))}</div>`
                return
            }
            await asmRenderOutputPartDd(dd, _asmPnResults, () => myToken !== _asmOutputSearchToken)
        } catch (err) {
            if (myToken !== _asmOutputSearchToken) return
            dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default"><i class="bi bi-exclamation-circle me-2"></i>${esc(err.message || asmDict().errorGeneric)}</div>`
        }
    }

    // ── Recipe (BOM) ของ Output Part ที่เลือก — ใช้ทำ checklist material ที่ต้องสแกน ─────
    let _asmBomProfile    = null          // profile ของ output part ปัจจุบัน {outputPartNo, outputQuantity, components}
    let _asmRequiredParts = new Map()     // partNo -> { quantity, fulfilled }
    // false = ยังไม่เคยพิมพ์ Output Qty เอง → auto-bump ตามที่สแกนไปเรื่อยๆ (พฤติกรรมเดิม)
    // true  = เคยพิมพ์เองแล้วอย่างน้อย 1 ครั้ง → เป้าหมาย fix ไว้ตามค่านั้น สแกนเกินแค่โชว์หลอดแดง ไม่ไปดัน Output Qty ขึ้นอีก
    let _asmOutputQtyManual = false
    // true = เพิ่งเลือก Output Part ใหม่ ยังไม่มีอะไรสแกนเลยสักตัว — กัน asmRecomputeGroups() auto-fill Output Qty เป็น "1 batch ของสูตร"
    // ทันทีที่เลือก Output Part (ตามที่ขอให้เริ่มที่ 0 เสมอ) จนกว่าจะเริ่มสแกนจริง (maxRatio > 0) ถึงจะกลับไป auto-bump ตามปกติ
    let _asmSuppressAutoQtyFill = false

    function asmApplyBomProfile(profile) {
        if (_asmBomProfile && _asmBomProfile.outputPartNo === profile.outputPartNo) return // เลือก part เดิมซ้ำ ไม่ต้อง reset ของที่สแกนไว้แล้ว

        // ถ้าสแกน lot ไว้ก่อนเลือก Output Part No เลย (_asmBomProfile ยังไม่เคยถูกตั้งค่ามาก่อน) — เก็บไว้ revalidate กับสูตรที่เพิ่งเลือกด้านล่าง
        // ต่างจากตอน "สลับ" ไป Output Part คนละตัวหลังเลือกไปแล้วครั้งนึง (มี _asmBomProfile เดิมอยู่) ซึ่งยังคง wipe list ทิ้งทั้งหมดเหมือนพฤติกรรมเดิม
        const preScanned = !_asmBomProfile
            ? [...document.querySelectorAll('#asmTable tr[data-lot-no]')].map(row => ({
                  lotNo:     row.dataset.lotNo,
                  partNo:    row.dataset.partNo,
                  onHandQty: parseFloat(row.dataset.avail) || 0,
                  workOrder: row.dataset.wo,
                  location:  row.dataset.loc,
                  unit:      row.dataset.unit,
                  lineName:  row.dataset.line,
              }))
            : []

        // เริ่มต้น Output Qty = 0 เสมอตอนเพิ่งเลือก Output Part (ไม่ auto-fill จาก outputQuantity ของสูตรอีกต่อไป) — บังคับให้ user
        // ต้องพิมพ์ Output Qty เองก่อน ถึงจะกด + เพิ่ม Lot จากแผง Find Lot by Work Order ได้ (ดู asmLfAddLot()) ส่วนตอนสแกนผ่าน
        // ช่องปกติยัง auto-bump ตามที่สแกนได้เหมือนเดิม (ดู asmRecomputeGroups()) แค่ค่าเริ่มต้นตอนยังไม่สแกนอะไรเลยเป็น 0 แทน — ใช้
        // _asmSuppressAutoQtyFill กันไว้เพราะ caller ของ asmApplyBomProfile() มักเรียก asmUpdateState() ซ้ำอีกทีทันทีหลังจากนี้
        // (เช่น asmSelectOutputPart()) ถ้าแค่ set ค่าตรงๆ ตรงนี้ จะโดน asmRecomputeGroups() ทับกลับเป็น 1 batch ทันที
        document.getElementById('asmOutputQty').value = 0
        _asmOutputQtyManual = false   // เลือก output part ใหม่ → กลับไป auto-bump ตามสแกนก่อน จนกว่าจะพิมพ์ Output Qty เองอีกครั้ง
        _asmSuppressAutoQtyFill = !preScanned.length   // ไม่มี lot เก่าให้เอากลับเข้ามาเลย = ยังไม่ได้เริ่มสแกนอะไรจริงๆ ต้องกันไว้
        _asmBomProfile    = profile
        _asmRequiredParts = new Map()
        ;(Array.isArray(profile.components) ? profile.components : []).forEach(c => {
            if (c.componentPartNo) _asmRequiredParts.set(c.componentPartNo, { quantity: c.quantity ?? 0, fulfilled: false })
        })
        asmScannedLots = new Set()
        document.getElementById('asmTable').innerHTML = ''
        asmShowOutputPreview(profile)
        if (_asmRequiredParts.size) {
            asmRenderRequiredRows()
        } else {
            toast(asmDict().noComponentInBom, 'warn')
            asmCheckEmpty()
        }

        // เอา lot ที่สแกนไว้ก่อนเลือก Output Part กลับเข้า list ใหม่ — เฉพาะตัวที่ part No. ตรงกับสูตรของ Output Part ที่เพิ่งเลือก
        // ตัวที่ไม่ตรง (part No. ไม่อยู่ในสูตร) เตือนแล้วตัดทิ้งไปเลย กัน user Assembly ผิดสูตรโดยไม่รู้ตัว
        if (preScanned.length) {
            const rejected = []
            preScanned.forEach(lot => {
                if (_asmRequiredParts.has(lot.partNo)) {
                    asmScannedLots.add(lot.lotNo)
                    asmAddRow(lot)
                } else {
                    rejected.push(`${lot.partNo} (${lot.lotNo})`)
                }
            })
            if (rejected.length) {
                toast(`${asmDict().rejectedLotsPrefix}${profile.outputPartNo}${asmDict().rejectedLotsMiddle}${rejected.join(', ')}`, 'warn', { duration: 8000 })
            }
            asmUpdateState()
        }
    }

    // โชว์รูป+ชื่อของ Output Part ที่เลือกไว้ในการ์ด Output Part — ชื่อได้จาก profile.outputItemName เลย (มีอยู่แล้วจาก /master/bom-profiles)
    // ส่วนรูปต้องดึงเพิ่มจาก /master/items/{partNo} (endpoint นี้ไม่มีรูปมาให้)
    function asmShowOutputPreview(profile) {
        const partNo = profile.outputPartNo
        document.getElementById('asmOutputPreview').style.display = 'flex'
        document.getElementById('asmOutputPreviewPartNo').textContent = partNo || '—'
        document.getElementById('asmOutputPreviewName').textContent   = profile.outputItemName || '—'
        const img = document.getElementById('asmOutputPreviewImg')
        img.src = asmImgSrc(partNo)
        img.onerror = () => { img.src = ASM_NO_IMG }
        if (!(partNo in _asmItemInfoCache)) {
            asmLoadPartsInfo([partNo], () => {
                img.src = asmImgSrc(partNo)
                // ใช้ itemName จาก /master/items เป็น fallback เฉยๆ เผื่อ profile.outputItemName ว่าง — ไม่ทับถ้ามีอยู่แล้ว
                if (!profile.outputItemName) document.getElementById('asmOutputPreviewName').textContent = asmItemName(partNo) || '—'
            })
        }
    }

    // หัวกลุ่มของแต่ละ part — อยู่ถาวรตลอด (ไม่ใช่ placeholder ที่หายไปตอนสแกน) โชว์ ammo tube วิ่งตาม asmRenderTubes()
    // Default หุบ (เห็นแค่ part + หลอด progress) กดปุ่ม chevron เพื่อขยายดู lot row แต่ละใบ
    function asmGroupHeadHtml(partNo, req) {
        return `<tr class="asm-group-head" data-group="${esc(partNo)}" onclick="asmToggleGroup('${escJs(partNo)}')">
            <td colspan="6">
                <div class="ammo-row">
                    <button type="button" class="ammo-toggle" onclick="event.stopPropagation();asmToggleGroup('${escJs(partNo)}')" title="แสดง/ซ่อน Lot">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 6 15 12 9 18"/></svg>
                    </button>
                    <div class="ammo-part">
                        <img class="ammo-img" src="${asmImgSrc(partNo)}" onerror="this.src='${ASM_NO_IMG}'"
                             onclick="event.stopPropagation();asmOpenImg(asmImgSrc('${escJs(partNo)}'),'${escJs(partNo)}')">
                        <div class="ammo-part-text">
                            <span class="ammo-part-no">${esc(partNo)}</span>
                            <span class="ammo-part-name">${esc(asmItemName(partNo)) || '—'}</span>
                        </div>
                    </div>
                    <div class="ammo-tube-wrap">
                        <div class="ammo-tube"><div class="ammo-tube-fill"></div></div>
                        <span class="ammo-frac">0/${Number(req.quantity).toLocaleString()}</span>
                    </div>
                </div>
            </td>
        </tr>`
    }

    // เปิด/ปิดกลุ่มของ part นั้น (open=true → โชว์ lot row, false → หุบ) — เรียกตรงๆ (ไม่ toggle) เผื่อ caller รู้ target state ชัดเจนอยู่แล้ว เช่นตอน error
    function asmSetGroupOpen(partNo, open) {
        const head = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(partNo)}"]`)
        if (!head) return
        head.classList.toggle('open', open)
        document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(partNo)}"]`).forEach(r => {
            r.style.display = open ? '' : 'none'
        })
    }

    function asmToggleGroup(partNo) {
        const head = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(partNo)}"]`)
        if (head) asmSetGroupOpen(partNo, !head.classList.contains('open'))
    }

    function asmRenderRequiredRows() {
        const empty = document.getElementById('asmEmptyRow')
        if (empty) empty.remove()
        document.getElementById('asmTable').innerHTML =
            [..._asmRequiredParts.entries()].map(([partNo, req]) => asmGroupHeadHtml(partNo, req)).join('')
        asmUpdateState()
        // ยิงหลังบ้าน โหลดรูป+ชื่อของทุก component แล้ว patch หัวกลุ่มของ part นั้นๆ เมื่อเสร็จ ไม่บล็อกการ render ตาราง
        asmLoadPartsInfo([..._asmRequiredParts.keys()], partNo => {
            const head = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(partNo)}"]`)
            if (!head) return
            const img  = head.querySelector('.ammo-img')
            const name = head.querySelector('.ammo-part-name')
            if (img)  img.src = asmImgSrc(partNo)
            if (name) name.textContent = asmItemName(partNo) || '—'
        })
    }

    // เช็คว่า partNo ของ lot ที่กำลังจะเพิ่ม ตรงกับ component ในสูตร BOM ของ output part ที่เลือกไว้หรือไม่
    // ยังไม่ได้เลือก Output Part No เลย → อนุญาตให้สแกนเก็บไว้ก่อนได้เสมอ (ไม่รู้สูตรจะเช็คได้ยังไง) — พอเลือก Output Part
    // ทีหลัง asmApplyBomProfile() จะ revalidate lot ที่สแกนไว้ก่อนหน้ากับสูตรที่เพิ่งเลือกเองอีกที ตัวที่ไม่ตรงจะถูกตัดออก
    function asmValidatePartAllowed(partNo) {
        if (!partNo) { toast(asmDict().noPartNoForLot, 'err'); return false }
        if (!_asmBomProfile) return true
        if (!_asmRequiredParts.size) { toast(asmDict().noRecipeForOutputPart, 'err'); return false }
        if (!_asmRequiredParts.has(partNo)) {
            toast(`${asmDict().partNotMatchingRecipePrefix}${partNo}${asmDict().partNotMatchingRecipeSuffix}${_asmBomProfile.outputPartNo}`, 'err')
            return false
        }
        return true
    }

    // ── Manual Search (Material Lot) ─────────────────────────────────
    let _asmManualTimer = null, _asmManualResults = []

    function asmHideLotDd() {
        document.getElementById('asmManualDd').style.display = 'none'
    }

    function asmManualAutocomplete() {
        const inp  = document.getElementById('asmManualInput')
        const dd   = document.getElementById('asmManualDd')
        const text = inp.value.trim()
        if (!text) { dd.style.display = 'none'; return }

        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <i class="bi bi-hourglass-split me-2"></i>${asmDict().searching}</div>`
        dd.style.display = 'block'

        clearTimeout(_asmManualTimer)
        _asmManualTimer = setTimeout(async () => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: text })
                const list = Array.isArray(res) ? res : (res?.data || [])
                if (!list.length) {
                    _asmManualResults = []
                    dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                        <i class="bi bi-search me-2"></i>${asmDict().noLotFound}</div>`
                    return
                }
                _asmManualResults = list
                dd.innerHTML = list.map((l, i) => `
                    <div class="loc-item" onmousedown="asmManualSelect(${i})">
                        <div>
                            <div style="font-weight:700;font-size:13px">${esc(l.lotNo || '')}</div>
                            ${l.partNo ? `<div style="font-size:11px;color:var(--t3)">${esc(l.partNo)}</div>` : ''}
                        </div>
                        <span style="margin-left:auto;font-size:11px;color:var(--t2)">${esc(locName(l.location ?? l.locationCode ?? ''))}</span>
                    </div>`).join('')
                dd.style.display = 'block'
            } catch (err) {
                _asmManualResults = []
                dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                    <i class="bi bi-exclamation-circle me-2"></i>${esc(err.message || asmDict().errorGeneric)}</div>`
            }
        }, 300)
    }

    function asmManualSelect(i) {
        const lot = _asmManualResults[i]
        if (!lot) return
        asmHideLotDd()
        document.getElementById('asmManualInput').value = ''
        if (asmScannedLots.has(lot.lotNo)) { toast(asmDict().duplicateScan + lot.lotNo, 'warn'); return }
        if (!asmValidatePartAllowed(lot.partNo)) return
        asmScannedLots.add(lot.lotNo)
        asmAddRow(lot)
        toast('✓ ' + lot.lotNo, 'ok')
    }

    async function asmManualEnter() {
        const val = document.getElementById('asmManualInput').value.trim()
        if (!val) return
        const dd = document.getElementById('asmManualDd')
        clearTimeout(_asmManualTimer)
        if (dd.style.display !== 'none' && _asmManualResults.length) {
            asmManualSelect(0)
            return
        }
        asmHideLotDd()
        document.getElementById('asmManualInput').value = ''
        try {
            const res  = await api('/inventory/lots', 'POST', { lotNo: val })
            const list = Array.isArray(res) ? res : (res?.data || [])
            const match = list.find(l => (l.lotNo || '').toLowerCase() === val.toLowerCase()) ?? list[0]
            if (!match) { toast(asmDict().lotNotFound + val, 'err'); return }
            if (asmScannedLots.has(match.lotNo)) { toast(asmDict().duplicateScan + match.lotNo, 'warn'); return }
            if (!asmValidatePartAllowed(match.partNo)) return
            asmScannedLots.add(match.lotNo)
            asmAddRow(match)
            toast('✓ ' + match.lotNo, 'ok')
        } catch (err) {
            toast(asmDict().searchFailed + err.message, 'err')
        }
    }

    // ── Scan pipeline ──────────────────────────────────
    function asmScanSetStatus(t) {
        const statusCam = document.getElementById('bcStatus')
        const statusHw  = document.getElementById('hwStatus')
        if (statusCam) statusCam.textContent = t
        if (statusHw)  statusHw.textContent  = t
    }

    async function asmAddScannedLot(lotNo) {
        if (!lotNo) { toast(asmDict().noLotPleaseReceive, 'err'); return }
        if (asmScannedLots.has(lotNo)) { toast(asmDict().duplicateScan + lotNo, 'warn'); return }
        const res  = await api('/inventory/lots', 'POST', { lotNo, page: 1, pageSize: 1 })
        const list = Array.isArray(res) ? res : (res?.data ?? [])
        const lot  = list[0]
        if (!lot) { toast(asmDict().lotNotFound + lotNo, 'err'); return }
        if (!asmValidatePartAllowed(lot.partNo)) return

        // Lot นี้มีจำนวนเกินที่ยังขาดอยู่จริงของ part นี้ (ตามสูตร BOM × สัดส่วน Output Qty ปัจจุบัน หักลบที่สแกนไปแล้ว) — เด้งถาม
        // ก่อนเสมอว่าจะ Split ไปใช้เท่าที่จำเป็นไหม ไม่เพิ่มทั้ง lot ตรงๆ (asmConfirmAutoSplit()/asmCancelAutoSplit() จัดการต่อ)
        const avail     = lot.onHandQty ?? lot.available ?? 0
        const remaining = asmRemainingNeededForPart(lot.partNo)
        if (remaining !== null && remaining > 1e-9 && avail > remaining + 1e-9) {
            _asmPendingAutoSplit = { lot, remaining }
            document.getElementById('asmAutoSplitLotLabel').textContent = lot.lotNo
            document.getElementById('asmAutoSplitDetail').textContent   = `${asmFmtNum(avail)} → ${asmFmtNum(remaining)} ${lot.unit || ''}`
            document.getElementById('asmConfirmAutoSplitModal').style.display = 'flex'
            return
        }

        asmScannedLots.add(lotNo)
        asmAddRow(lot)
        toast('✓ ' + lotNo, 'ok')
    }

    // จำนวนที่ "ยังขาด" ของ part นี้ (ตามสูตร BOM × สัดส่วน Output Qty ปัจจุบัน) หักลบกับที่สแกนไปแล้วในตาราง — คืน null ถ้า part
    // นี้ไม่มีในสูตรเลย (ยังไม่ได้เลือก Output Part เลย) ซึ่งกรณีนั้นไม่ต้องเช็ค Split เพราะไม่รู้ "ที่ตั้งไว้" คือเท่าไหร่
    function asmRemainingNeededForPart(partNo) {
        const req = _asmRequiredParts.get(partNo)
        if (!req) return null
        const outputQty     = parseFloat(document.getElementById('asmOutputQty')?.value) || 0
        const baseOutputQty = _asmBomProfile?.outputQuantity || 1
        const neededTotal   = req.quantity * (outputQty / baseOutputQty)
        const inputs = document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(partNo)}"] [data-qty-input]`)
        const alreadyScanned = [...inputs].reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0)
        return neededTotal - alreadyScanned
    }

    let _asmPendingAutoSplit = null   // { lot, remaining } ที่รอ user ยืนยัน Split อยู่

    function asmCancelAutoSplit() {
        _asmPendingAutoSplit = null
        document.getElementById('asmConfirmAutoSplitModal').style.display = 'none'
        if (_asmLfCurrentWo) asmLfRenderResults()   // sync ปุ่ม Lot Finder กลับเป็น "Add" ปกติ (เผื่อ re-render ตอนเปิด modal ทับค้าง disabled ไว้)
    }

    // Split ทันทีตรงนี้เลย (ต่างจาก flow แก้ Qty เดิมที่รอถึงตอนกด Assembly) — ขอเลข Lot ใหม่ → ยิง /inventory/split จริง →
    // เพิ่ม Lot ลูกที่เพิ่งแบ่งเข้าตาราง Materials → refresh แผง Find Lot by Work Order ให้ตรงกับของจริง (On Hand เปลี่ยนไปแล้ว)
    // แค่ "จอง" เลข Lot ลูกไว้ก่อน (ขอเลขจาก /inventory/new-lotNo เฉยๆ ไม่ใช่ transaction จริง) แล้วเพิ่มแถวลง Materials พร้อม mark
    // needsSplit ไว้ — ไม่ยิง /inventory/split จริงตรงนี้เลย รอไปรวมกับแถว split อื่นๆ (ถ้ามี) ยิงพร้อมกันตอนกด Assembly ที่เดียว
    // (loop splitRows เดิมใน doAssembly() ด้านล่างจัดการต่อเอง — ใช้ GPS/Advanced Options ชุดเดียวกับตอน Assembly เลย ไม่ต้องขอซ้ำ)
    async function asmConfirmAutoSplit() {
        const pending = _asmPendingAutoSplit
        if (!pending) return
        const confirmBtn = document.getElementById('asmAutoSplitConfirmBtn')
        confirmBtn.disabled = true
        confirmBtn.innerHTML = `<i class="bi bi-hourglass-split"></i> ${asmDict().requestingLotNo}`
        try {
            const trRes = await api('/inventory/new-lotNo', 'GET')
            const childLotNo = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? null
            if (!childLotNo) throw new Error(asmDict().noNewLotReceived)

            const childLot = { ...pending.lot, lotNo: childLotNo, onHandQty: pending.remaining }
            asmScannedLots.add(childLotNo)
            asmScannedLots.add(pending.lot.lotNo)   // mark lot ต้นทางว่า "ใช้ไปแล้ว" ด้วย ไม่ใช่แค่ lot ลูกที่เพิ่งแบ่งออกมา — ไม่งั้นปุ่ม +
                                                     // ของ lot ต้นทางในแผง Find Lot by Work Order จะไม่ขึ้น ✓ ทั้งที่ Split ไปแล้วจริง
            asmAddRow(childLot)

            // mark แถวที่เพิ่งเพิ่มว่ายัง pending split อยู่ (เหมือนที่ asmConfirmSplitEdit() ทำกับ flow แก้ Qty เดิม)
            const row = document.querySelector(`#asmTable tr[data-lot-no="${CSS.escape(childLotNo)}"]`)
            if (row) {
                row.dataset.parentLotNo = pending.lot.lotNo
                row.dataset.needsSplit  = 'true'
                row.classList.add('row-split')
                const lotCell = row.querySelector('[data-lotno-cell]')
                if (lotCell) lotCell.innerHTML = `${esc(childLotNo)}<div style="font-size:9px;color:#8b5cf6;font-weight:600;margin-top:1px">From ${esc(pending.lot.lotNo)}</div>`
            }

            toast(`${asmDict().preparedSplitPrefix}${childLotNo}${asmDict().preparedSplitSuffix}`, 'ok')
            document.getElementById('asmConfirmAutoSplitModal').style.display = 'none'
            _asmPendingAutoSplit = null
            if (_asmLfCurrentWo) asmLfRenderResults()   // re-render แผง Find Lot by Work Order ให้ปุ่ม + ของ lot ต้นทางเปลี่ยนเป็น ✓ ทันที
        } catch (err) {
            toast(asmDict().requestNewLotFailedPrefix + (err.message || ''), 'err')
        } finally {
            confirmBtn.disabled = false
            confirmBtn.innerHTML = asmDict().confirmSplitBtn
        }
    }

    // ── Barcode type toggle (Our QR vs Vendor label) ──
    let asmBarcodeMode = 'our'
    function setAsmBarcodeMode(m) {
        asmBarcodeMode = m
        document.querySelectorAll('#asmBcModeGroup .bc-mode-btn').forEach(btn =>
            btn.classList.toggle('active', btn.dataset.mode === m))
        toast(asmDict().scanModeLabel + (m === 'our' ? asmDict().ourBarcode : asmDict().vendorBarcode), 'ok')
    }

    const asmScan = createScanPipeline({
        mode: 'ours',
        barcodeFilter: () => asmBarcodeMode,
        onResult: async ({ lotNo, matches, notOurFormat, wrongModeOur }) => {
            asmScanSetStatus(asmDict().processing)
            try {
                if (wrongModeOur || notOurFormat) return // สแกนผิดโหมด — เงียบไว้ ไม่ต้องแจ้งอะไร
                if (Array.isArray(matches) && matches.length > 1) {
                    await openAsmPickLot(matches)
                    return
                }
                await asmAddScannedLot(lotNo)
            } finally {
                asmScanSetStatus(asmDict().readyToScan)
            }
        }
    })

    let _asmPickLots = []

    async function openAsmPickLot(matches) {
        document.getElementById('asmPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px"><span class="spinner-border spinner-border-sm me-2"></span>${asmDict().loadingData}</div>`
        document.getElementById('asmPickLotModal').style.display = 'flex'

        // บังคับ availableOnly เสมอ — lot ที่ของหมด/ไม่ available จะไม่ถูกคืนมาจาก API เลย (lot: null) กรองทิ้งไม่ให้ขึ้นในลิสต์ให้เลือก
        const fetched = await Promise.all((matches || []).map(async m => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: m.lotNo, page: 1, pageSize: 1, availableOnly: true })
                const list = Array.isArray(res) ? res : (res?.data ?? [])
                return { lotNo: m.lotNo, lot: list[0] ?? null }
            } catch (_) {
                return { lotNo: m.lotNo, lot: null }
            }
        }))
        _asmPickLots = fetched.filter(m => m.lot)
        document.getElementById('asmPickLotCount').textContent = _asmPickLots.length

        if (!_asmPickLots.length) {
            document.getElementById('asmPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px">${asmDict().noAvailableLot}</div>`
            return
        }

        document.getElementById('asmPickLotList').innerHTML = _asmPickLots.map((m, i) => {
            const lot = m.lot || {}
            return `<button onclick="asmPickLotSelect(${i})" style="width:100%;text-align:left;padding:11px 10px;border:none;border-bottom:1px solid #eee;background:#fff;cursor:pointer;font-family:inherit">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:3px">
                    <span style="font-weight:700;color:var(--navy);font-family:ui-monospace,monospace;font-size:13px">${m.lotNo ?? '—'}</span>
                    <span style="font-size:13px;font-weight:700;color:var(--blue)">${lot.onHandQty ?? '—'} ${lot.unit ?? ''}</span>
                </div>
                <div style="font-size:12px;color:var(--t2);display:flex;gap:12px;flex-wrap:wrap">
                    <span>W/O: ${lot.workOrder || '—'}</span>
                    <span>Part: ${lot.partNo || '—'}</span>
                </div>
            </button>`
        }).join('')
    }

    function closeAsmPickLot() {
        document.getElementById('asmPickLotModal').style.display = 'none'
        _asmPickLots = []
    }

    function asmPickLotSelect(i) {
        const m = _asmPickLots[i]
        closeAsmPickLot()
        if (!m || !m.lot) { toast(asmDict().lotNotFoundShort + (m?.lotNo || ''), 'err'); return }
        if (asmScannedLots.has(m.lotNo)) { toast(asmDict().duplicateScan + m.lotNo, 'warn'); return }
        if (!asmValidatePartAllowed(m.lot.partNo)) return
        asmScannedLots.add(m.lotNo)
        asmAddRow(m.lot)
        toast('✓ ' + m.lotNo, 'ok')
    }

    // ── Camera ────────────────────────────────────────
    const asmScanner = createBarcodeScanner({
        videoId: 'bcVideo', canvasId: 'bcCanvas', labelId: 'bcLabel',
        onDetect: raw => asmScan.submit(raw)
    })

    function asmToggleCam() { if (asmScanner.running) stopScan(); else asmStartCam() }

    function setCamBtn(running) {
        const btn = document.getElementById('asmCamBtn')
        btn.style.background = running ? '#dc2626' : 'var(--blue)'
    }

    async function asmStartCam() {
        const hwSection = document.getElementById('hwSection')
        if (hwSection.style.display !== 'none') asmToggleHwScan()

        document.getElementById('bcSection').style.display = ''
        document.getElementById('bcStatus').textContent = asmDict().scanningInProgress
        setCamBtn(true)

        try {
            await asmScanner.start()
            setTorchBtn(asmScanner.hasTorch())
        } catch (err) {
            toast(err.message.includes('BarcodeDetector') ? err.message : asmDict().cameraAccessError + err.message, 'err')
            document.getElementById('bcSection').style.display = 'none'
            setCamBtn(false)
        }
    }

    function stopScan() {
        asmScanner.stop()
        document.getElementById('bcSection').style.display = 'none'
        setCamBtn(false)
        setTorchBtn(false)
    }

    async function switchCamera() {
        await asmScanner.switchCamera()
        setTorchBtn(asmScanner.hasTorch())
    }

    function setTorchBtn(visible) {
        const btn = document.getElementById('bcTorchBtn')
        btn.style.display = visible ? 'flex' : 'none'
        btn.classList.remove('active')
    }

    async function toggleTorch() {
        const on = await asmScanner.toggleTorch()
        document.getElementById('bcTorchBtn').classList.toggle('active', on)
    }

    // ── HW Scanner ────────────────────────────────────
    const asmHwScanner = createHwScanner({
        inputId: 'hwInput', statusId: 'hwStatus',
        onScan: raw => asmScan.submit(raw)
    })

    function asmToggleHwScan() {
        const section = document.getElementById('hwSection')
        const btn     = document.getElementById('asmHwBtn')
        if (asmHwScanner.active) {
            asmHwScanner.close()
            section.style.display = 'none'
            btn.style.background  = '#6b7280'
        } else {
            section.style.display = ''
            btn.style.background  = 'var(--red)'
            if (asmScanner.running) asmToggleCam()
            asmHwScanner.open()
        }
    }

    // ── Lot Finder — ค้นหา Lot ตาม Work Order + Location Type (default Pre-Assembly) กด Lot แล้วเพิ่มเข้า scan list ได้เลย ──
    function asmToggleLotFinder() {
        const section = document.getElementById('asmLotFinderSection')
        const btn     = document.getElementById('asmLfBtn')
        const opening = section.style.display === 'none'
        if (opening) {
            // ปิด mode สแกนอื่นก่อนเสมอ (เหมือน asmToggleCam()/asmToggleHwScan() ทำกันเอง) กัน UI เปิดซ้อนกันหลาย mode
            if (asmScanner.running) asmToggleCam()
            if (asmHwScanner.active) asmToggleHwScan()
            section.style.display = ''
            btn.style.background  = '#5b21b6'
            asmLfInit()
        } else {
            section.style.display = 'none'
            btn.style.background  = '#7c3aed'
        }
    }

    let _asmLfInited         = false
    let _asmLfCurrentWo      = null
    let _asmLfAllLots        = []      // flat lot ของ W/O ที่เลือกอยู่ (ทุก location) — กรองตาม Location Type ตอน render อีกที
    let _asmLfSelectedLocType = null   // Location Type ที่เลือกกรองอยู่ตอนนี้ (มาจาก dropdown custom — ดู asmLfPickLocType)
    let _asmLfAvailableOnly  = true    // true = กรองเอาแต่ lot ที่ onHandQty ไม่เท่ากับ 0 เท่านั้น (default เปิดไว้)

    function asmLfToggleAvailableOnly() {
        _asmLfAvailableOnly = document.getElementById('asmLfAvailableOnlyChk').checked
        asmLfRenderResults()
    }

    async function asmLfInit() {
        if (_asmLfInited) return
        _asmLfInited = true

        if (!_locNameMap.size) await loadLocation()   // ยังต้องมี location ทั้งหมดไว้ให้ asmLfLocBadge() หา type/ชื่อของ location code แต่ละจุด

        createWorkOrderAutocomplete({
            inputId: 'asmLfWoInput', dropdownId: 'asmLfWoDd',
            loadingText: asmDict().searching, emptyText: asmDict().noWorkOrderFound,
            renderItem: (x, i) => `<div class="loc-item" data-idx="${i}">
                <i class="bi bi-box-seam" style="color:var(--blue);flex-shrink:0"></i>
                <span><strong>${esc(x.moNumber)}</strong></span>
                ${x.lineName ? `<span style="margin-left:auto;font-size:11px;color:var(--t3)">${esc(x.lineName)}</span>` : ''}
            </div>`,
            onSelect: x => { if (x?.moNumber) asmLfLoadWorkOrder(x.moNumber) }
        })
    }

    function asmLfToggleLocTypeDd() {
        const dd = document.getElementById('asmLfLocTypeDd')
        dd.style.display = dd.style.display === 'block' ? 'none' : 'block'
    }
    function asmLfHideLocTypeDd() {
        document.getElementById('asmLfLocTypeDd').style.display = 'none'
    }

    // เติม option ของ dropdown Location Type เฉพาะ type ที่มีจริงใน W/O ปัจจุบันเท่านั้น (ไม่ใช่ทุก type ในระบบ) พร้อม badge
    // icon+สีจริงต่อ type (locTypeBadge จาก js/locationTypeMeta.js) — <option> ธรรมดาใส่ badge ไม่ได้ เลยต้องทำ dropdown เอง
    function asmLfRenderLocTypeOptions(types) {
        const dd = document.getElementById('asmLfLocTypeDd')
        dd.innerHTML = types.map(t => `<div class="loc-item" onmousedown="event.preventDefault();asmLfPickLocType('${escJs(t)}')">${locTypeBadge(t)}</div>`).join('')
    }

    function asmLfPickLocType(type) {
        _asmLfSelectedLocType = type
        document.getElementById('asmLfLocTypeLabel').innerHTML = locTypeBadge(type)
        asmLfHideLocTypeDd()
        asmLfRenderResults()
        asmSaveDraft()
    }

    // ปุ่ม Refresh บนหัวการ์ด — เผื่อ user อยากอัปเดตข้อมูล Lot เองเมื่อไหร่ก็ได้ ไม่ต้องรอ auto-refresh หลัง Assembly สำเร็จอย่างเดียว
    async function asmLfRefresh() {
        if (!_asmLfCurrentWo) return
        const btn = document.getElementById('asmLfRefreshBtn')
        if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:14px;height:14px;border-width:2px"></span>' }
        await asmLfLoadWorkOrder(_asmLfCurrentWo)
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise"></i>' }
    }

    async function asmLfLoadWorkOrder(workOrder) {
        _asmLfCurrentWo      = workOrder
        _asmLfExpandedPart   = null   // W/O ใหม่ — เริ่มหุบทุก Part ใหม่หมด
        const box = document.getElementById('asmLfResults')
        box.innerHTML = `<div class="empty-state"><span class="spinner-border spinner-border-sm me-2"></span>${asmDict().loadingData}</div>`
        try {
            const body       = { workOrder, page: 1, pageSize: 50, desc: true }
            const first      = await api('/inventory/get-stock-summary', 'POST', body)
            let items        = first?.data || []
            const totalPages = first?.totalPages || 1
            if (totalPages > 1) {
                const rest = await Promise.all(
                    Array.from({ length: totalPages - 1 }, (_, i) => api('/inventory/get-stock-summary', 'POST', { ...body, page: i + 2 }))
                )
                rest.forEach(r => { items = items.concat(r?.data || []) })
            }
            _asmLfAllLots = items.flatMap(x => (x.lotDetails || []).map(ld => ({
                ...ld,
                partNo:      x.itemPartNo,
                description: x.description || '-',
                itemType:    x.itemType || null,
            })))

            // จำกัด Location Type ในตัวเลือกให้เหลือเฉพาะที่มีจริงใน W/O นี้ — default ยังเป็น PreAssembly ถ้ามี ไม่มีก็เอาตัวแรก
            const types = [...new Set(_asmLfAllLots.map(l => (l.locationType || '').trim()).filter(Boolean))].sort()
            asmLfRenderLocTypeOptions(types)
            const preAssembly = types.find(t => t.toLowerCase().replace(/[\s-]/g, '') === 'preassembly')
            _asmLfSelectedLocType = preAssembly || types[0] || null
            document.getElementById('asmLfLocTypeLabel').innerHTML = _asmLfSelectedLocType ? locTypeBadge(_asmLfSelectedLocType) : '—'

            asmLfRenderResults()
            asmSaveDraft()
        } catch (err) {
            box.innerHTML = `<div class="empty-state" style="color:var(--red)">${asmDict().searchFailed}${esc(err.message || '')}</div>`
        }
    }

    // badge location — icon + สีตาม location type จริง (หา type จาก _locNameMap ที่ loadLocation() โหลดไว้แล้ว) label = ชื่อ
    // location จริง (เหมือน rprLocBadge() ใน _Reprint.cshtml แต่หน้านี้คนละไฟล์ ไม่ได้แชร์ scope กัน เลยต้องมีของตัวเอง)
    function asmLfLocBadge(code) {
        if (!code) return '<span style="color:var(--t3)">—</span>'
        const found = _locNameMap.get(code)
        const name  = found?.displayName ?? code
        const type  = found?.typeName ?? ''
        return `<span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;${locTypeBadgeStyle(type)};white-space:nowrap;display:inline-flex;align-items:center;gap:5px">${locHierTypeIcon(type)}${esc(name)}</span>`
    }

    // ขยายได้ทีละ Part เท่านั้น (accordion) — กด Part แถวใหม่ = หุบตัวที่เปิดค้างไว้ก่อนหน้าอัตโนมัติ
    let _asmLfExpandedPart = null
    function asmLfToggleExpand(partNo) {
        _asmLfExpandedPart = _asmLfExpandedPart === partNo ? null : partNo
        asmLfRenderResults()
    }

    // จัดกลุ่ม lot ที่กรองแล้วตาม Part No. — โชว์เป็นแถวสรุปต่อ Part (Part/Locations/Lots) กด expand ดู Lot ย่อยได้ทีละ Part
    // (อ่านง่ายกว่าโชว์ครบทุก lot ค้างไว้ตลอด) กดปุ่ม Add ที่ Lot ย่อยแล้วเรียก asmAddScannedLot() ตัวเดียวกับ flow สแกน/พิมพ์
    // ค้นหาตรงๆ (ได้ dedupe/BOM validation/max 10/toast ครบ ไม่ต้องเขียนซ้ำ)
    function asmLfRenderResults() {
        const box  = document.getElementById('asmLfResults')
        const type = _asmLfSelectedLocType
        if (!_asmLfCurrentWo) { box.innerHTML = `<div class="empty-state">${asmDict().lotFinderEmpty}</div>`; return }

        let filtered = _asmLfAllLots.filter(l => (l.locationType || '') === type)
        if (_asmLfAvailableOnly) filtered = filtered.filter(l => Number(l.onHandQty || 0) !== 0)
        if (!filtered.length) { box.innerHTML = `<div class="empty-state">${asmDict().lotFinderNoResults}</div>`; return }

        const byPart = new Map()
        filtered.forEach(l => {
            if (!byPart.has(l.partNo)) byPart.set(l.partNo, { partNo: l.partNo, description: l.description, itemType: l.itemType, lots: [] })
            byPart.get(l.partNo).lots.push(l)
        })

        box.innerHTML = `<table class="rx-table"><tbody>` + [...byPart.values()].map(pg => {
            const open      = _asmLfExpandedPart === pg.partNo
            const locCodes  = [...new Set(pg.lots.map(l => l.locationCode).filter(Boolean))]
            const locBadges = locCodes.map(c => asmLfLocBadge(c)).join('')
            const totalQty  = pg.lots.reduce((s, l) => s + Number(l.onHandQty || 0), 0)

            return `<tr style="cursor:pointer" onclick="asmLfToggleExpand('${escJs(pg.partNo)}')">
                    <td style="width:26px;padding:8px 4px 8px 8px;border-bottom:1px solid var(--border)">
                        <button type="button" style="width:22px;height:22px;border-radius:6px;border:1.5px solid var(--border);background:#fff;display:flex;align-items:center;justify-content:center;transition:transform .15s;${open ? 'transform:rotate(90deg);background:#7c3aed;border-color:#7c3aed;color:#fff' : 'color:var(--t2)'}">
                            <i class="bi bi-chevron-right" style="font-size:10px"></i>
                        </button>
                    </td>
                    <td style="width:44px;padding:8px 0 8px 8px;border-bottom:1px solid var(--border)">
                        <img class="ammo-img" data-part-no="${esc(pg.partNo)}" src="${asmImgSrc(pg.partNo)}" onerror="this.src='${ASM_NO_IMG}'"
                             onclick="event.stopPropagation();asmOpenImg(asmImgSrc('${escJs(pg.partNo)}'),'${escJs(pg.partNo)}')">
                    </td>
                    <td style="padding:8px;border-bottom:1px solid var(--border)">
                        <div style="display:flex;align-items:center;gap:6px">
                            <span style="font-family:ui-monospace,monospace;font-weight:700;font-size:13px;color:var(--navy)">${esc(pg.partNo)}</span>
                            ${itemTypeBadge(pg.itemType)}
                        </div>
                        <div style="font-size:11px;color:var(--t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px" title="${esc(pg.description)}">${esc(pg.description)}</div>
                    </td>
                    <td style="padding:8px;border-bottom:1px solid var(--border);text-align:right;white-space:nowrap">
                        <span style="font-size:13px;font-weight:700;color:var(--navy)">${totalQty.toLocaleString()}</span>
                    </td>
                    <td style="padding:8px;border-bottom:1px solid var(--border)"><div style="display:flex;flex-wrap:wrap;gap:4px">${locBadges}</div></td>
                    <td style="padding:8px;border-bottom:1px solid var(--border);text-align:right">
                        <span style="background:#f0f2f5;color:#475569;padding:2px 8px;border-radius:5px;font-size:11px;font-weight:600;white-space:nowrap">${pg.lots.length} lot${pg.lots.length === 1 ? '' : 's'}</span>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="padding:0;border-bottom:${open ? '1px solid var(--border)' : 'none'}">
                        <div style="${open ? '' : 'display:none'};background:#faf9ff">${open ? asmLfLotRowsHtml(pg.lots) : ''}</div>
                    </td>
                </tr>`
        }).join('') + `</tbody></table>`

        // โหลดรูป+ชื่อของแต่ละ part แบบ lazy (endpoint /master/items ไม่ได้อยู่ใน get-stock-summary) แล้ว patch รูปที่ยังไม่มี
        // ใน cache (_asmItemInfoCache) เมื่อโหลดเสร็จ — ตัวที่ cache ไว้แล้วจาก asmImgSrc() ด้านบน ได้รูปจริงทันทีไม่ต้องรอ
        asmLoadPartsInfo([...byPart.keys()], partNo => {
            document.querySelectorAll(`#asmLfResults img[data-part-no="${CSS.escape(partNo)}"]`).forEach(img => { img.src = asmImgSrc(partNo) })
        })
    }

    function asmLfLotRowsHtml(lots) {
        return `<table style="width:100%;border-collapse:collapse;font-size:13px">
            <thead>
                <tr>
                    <th style="text-align:left;padding:6px 12px;font-size:10.5px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Lot No.</th>
                    <th style="text-align:left;padding:6px 12px;font-size:10.5px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">On Hand</th>
                    <th style="text-align:left;padding:6px 12px;font-size:10.5px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Location</th>
                    <th style="width:60px;border-bottom:1px solid var(--border)"></th>
                </tr>
            </thead>
            <tbody>${lots.map(l => {
                const already = asmScannedLots.has(l.lotNo)
                return `<tr>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5;font-family:ui-monospace,monospace;color:var(--navy);font-weight:700;font-size:12.5px">${esc(l.lotNo)}</td>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5">${Number(l.onHandQty || 0).toLocaleString()}</td>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5">${asmLfLocBadge(l.locationCode)}</td>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5;text-align:right">
                        <button type="button" ${already ? 'disabled' : ''} onclick="asmLfAddLot('${escJs(l.lotNo)}', this)"
                            style="padding:4px 12px;border-radius:7px;border:1.5px solid ${already ? 'var(--border)' : '#7c3aed'};background:${already ? '#f0f2f5' : '#f5f3ff'};color:${already ? 'var(--t2)' : '#7c3aed'};font-size:11px;font-weight:700;cursor:${already ? 'default' : 'pointer'};font-family:inherit;white-space:nowrap">
                            ${already ? '<i class="bi bi-check2"></i>' : '<i class="bi bi-plus-lg"></i>'}
                        </button>
                    </td>
                </tr>`
            }).join('')}</tbody>
        </table>`
    }

    async function asmLfAddLot(lotNo, btn) {
        // ต้องเลือก Output Part No + กรอก Output Qty ก่อนเสมอ ถึงจะเพิ่ม Lot จากแผงนี้ได้ (ต่างจากช่องสแกน/พิมพ์ค้นหาปกติที่ยัง
        // ยอมให้สแกนเก็บไว้ก่อนเลือก Output Part ได้ — แผงนี้ตั้งใจให้เลือก Output Part ก่อนเพื่อกัน validate ผิดสูตร/ลืมกรอก Qty)
        const outputPartNo = document.getElementById('asmOutputPartInput')?.value.trim()
        const outputQty     = parseFloat(document.getElementById('asmOutputQty')?.value)
        if (!outputPartNo || !(outputQty > 0)) {   // Output Qty = "0"/ว่าง/NaN ก็ถือว่ายังไม่ผ่านทั้งนั้น (ค่าเริ่มต้นหลังเลือก Output Part คือ 0 ตามที่ตั้งใจ)
            toast(asmDict().selectOutputPartAndQtyFirst, 'warn')
            return
        }
        if (btn) btn.disabled = true
        await asmAddScannedLot(lotNo)
        asmLfRenderResults()   // sync ปุ่มตาม asmScannedLots ล่าสุด (กันกดซ้ำ)
    }

    // ── Table (Materials — แต่ละแถวมี Qty to Consume แก้ไขได้ ไม่ใช่ทั้ง lot เสมอไปเหมือน Merge) ─────
    // lot ของ part เดียวกันจะถูกแทรกให้อยู่ติดกันเสมอ (ต่อท้ายกลุ่มของ part นั้น ใต้หัวกลุ่ม asm-group-head) ไม่ว่าจะสแกนสลับ part กันแค่ไหน
    function asmAddRow(lot) {
        if (document.querySelectorAll('#asmTable tr[data-lot-no]').length >= 10) {
            toast(asmDict().reachedMax, 'warn'); return
        }
        if (navigator.vibrate) navigator.vibrate(120)
        const empty = document.getElementById('asmEmptyRow')
        if (empty) empty.remove()

        const loc   = lot.location ?? lot.locationCode ?? '—'
        const avail = lot.onHandQty ?? lot.available ?? 0
        // ไม่ cap ให้เข้ากับสูตรอีกต่อไป — ใส่จำนวนที่ scan มาได้เต็ม lot ไปเลยเสมอ ถ้าเกินที่สูตรต้องการ asmRenderTubes()
        // จะโชว์หลอดสีแดง (isOver) ให้เห็นเองว่าเกิน ผู้ใช้ค่อยกด Edit ลดจำนวนเอง ไม่ต้องเดา cap ให้ล่วงหน้า
        const defaultQty = avail

        const tmp = document.createElement('tbody')
        tmp.innerHTML = `
            <tr data-lot-no="${esc(lot.lotNo)}" data-part-no="${esc(lot.partNo ?? '')}" data-avail="${avail}"
                data-wo="${esc(lot.workOrder ?? '')}" data-loc="${esc(loc)}" data-unit="${esc(lot.unit ?? '')}"
                data-line="${esc(lot.lineName ?? lot.line ?? '')}">
                <td class="asm-lot-connector">↳</td>
                <td style="color:var(--blue);font-weight:600;font-size:12px" data-lotno-cell>${esc(lot.lotNo)}</td>
                <td style="font-size:12px;color:var(--t2)">${esc(lot.workOrder || '—')}</td>
                <td><span style="background:#f0f2f5;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--t2)">${esc(locName(loc))}</span></td>
                <td style="text-align:right">
                    <input type="number" class="qty-input" data-qty-input min="0" max="${avail}" step="any" readonly
                           value="${defaultQty}" oninput="asmUpdateState()">
                    <div style="font-size:10px;color:var(--t3);margin-top:3px" data-avail-text>/ ${Number(avail).toLocaleString()} ${esc(lot.unit ?? '')}</div>
                </td>
                <td style="white-space:nowrap">
                    <button class="del-btn" onclick="asmRemoveRow(this)" title="${asmDict().remove}"><i class="bi bi-trash3"></i></button>
                </td>
            </tr>`
        const newRow = tmp.firstElementChild

        // แทรกต่อท้าย lot ล่าสุดของ part เดียวกัน (หรือต่อจากหัวกลุ่มเลยถ้าเป็น lot แรกของ part นี้) กันกระจายไปคนละที่ในตาราง
        const groupHead = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(lot.partNo ?? '')}"]`)
        if (groupHead) {
            const siblingRows = document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(lot.partNo ?? '')}"]`)
            const lastOfGroup = siblingRows.length ? siblingRows[siblingRows.length - 1] : groupHead
            lastOfGroup.after(newRow)
            // แถวใหม่ต้องเข้าไปในสถานะหุบ/ขยายของกลุ่มปัจจุบันด้วย ไม่งั้นจะโผล่มาแม้กลุ่มหุบอยู่
            if (!groupHead.classList.contains('open')) newRow.style.display = 'none'
        } else {
            document.getElementById('asmTable').appendChild(newRow)
        }
        newRow.classList.add('asm-row-filled')
        setTimeout(() => newRow.classList.remove('asm-row-filled'), 500)

        asmUpdateState()
    }

    // สลับ Qty to Consume ของแถวนั้นระหว่างโหมดดูเฉยๆ (readonly ตัวเลขเปล่าๆ) กับโหมดแก้ไข (input จริง) — กดปุ่มเดิมซ้ำเพื่อยืนยัน (Done)
    function asmToggleRowEdit(btn) {
        const row   = btn.closest('tr')
        const input = row?.querySelector('[data-qty-input]')
        if (!input) return

        if (input.readOnly) {
            // เข้าโหมดแก้ไข — จำค่าปัจจุบันไว้เป็น "จำนวนเดิม" ห้ามแก้เกิน (ถ้าเคยแบ่งไปแล้วครั้งก่อน เพดานจะเป็นค่าที่แบ่งไว้ล่าสุด ไม่ใช่ avail ตั้งต้นเสมอไป)
            const ceiling = parseFloat(input.value) || 0
            row.dataset.qtyCeiling = input.value
            input.readOnly = false
            input.max = input.value

            // pre-fill เป็นจำนวนที่ยังขาดจริงตามสูตร (target ของ part นี้ - ยอดที่ lot อื่นของ part เดียวกันสแกนไว้แล้ว)
            // แทนที่จะปล่อยเป็นจำนวนเต็ม lot ให้ผู้ใช้พิมพ์เอง — กด edit ปุ๊บได้ตัวเลขที่ต้องแบ่งจริงเลย กด Done ต่อได้ทันที
            const partNo = row.dataset.partNo
            const req    = _asmRequiredParts.get(partNo)
            if (req) {
                const baseOutputQty  = _asmBomProfile?.outputQuantity || 1
                const outputQty      = parseFloat(document.getElementById('asmOutputQty').value) || 0
                const scaleFactor    = baseOutputQty > 0 ? outputQty / baseOutputQty : 0
                const neededForBatch = req.quantity * scaleFactor
                const otherScanned   = [...document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(partNo)}"] [data-qty-input]`)]
                    .filter(el => el !== input)
                    .reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0)
                input.value = Math.max(0, Math.min(neededForBatch - otherScanned, ceiling))
                asmUpdateState()   // set ค่าด้วย JS ตรงๆ ไม่ผ่าน oninput ของ input — ต้องเรียกเองให้หลอด progress/preview อัปเดตตาม
            }

            btn.classList.add('active')
            btn.querySelector('i').className = 'bi bi-check-lg'
            btn.title = asmDict().doneTitle
            input.focus(); input.select()
            return
        }
        asmConfirmRowEdit(row, btn, input)
    }

    function _asmLockRowEdit(row, btn) {
        const input = row.querySelector('[data-qty-input]')
        input.readOnly = true
        btn.classList.remove('active')
        btn.querySelector('i').className = 'bi bi-pencil'
        btn.title = asmDict().editQtyTitle
        asmUpdateState()
    }

    // กด Done (ยืนยันแก้ qty ของแถว) — ตรวจว่าไม่เกิน "จำนวนเดิม" ก่อน แล้วค่อยตัดสินใจว่าต้องแบ่ง Lot หรือไม่
    function asmConfirmRowEdit(row, btn, input) {
        const ceiling = parseFloat(row.dataset.qtyCeiling) || 0
        const newVal  = parseFloat(input.value)
        if (!(newVal > 0) || newVal > ceiling + 1e-9) {
            toast(`${asmDict().qtyExceedsOriginalPrefix}${asmFmtNum(ceiling)}${asmDict().qtyExceedsOriginalSuffix}`, 'err')
            input.value = ceiling
            input.focus()
            return   // ค้างอยู่ในโหมดแก้ไข จนกว่าจะกรอกค่าที่ถูกต้อง
        }

        if (Math.abs(newVal - ceiling) < 1e-9) {
            _asmLockRowEdit(row, btn)   // ไม่ได้เปลี่ยนจำนวนจริง — ไม่ต้องแบ่ง Lot
            return
        }

        if (row.dataset.needsSplit === 'true') {
            // แถวนี้ pending split อยู่แล้วจากการแก้ครั้งก่อน (ยังไม่ยิง /inventory/split จริงจนกว่าจะกด Assembly) — ปรับจำนวนต่อได้เลยโดยไม่ต้องขอเลข Lot ใหม่/ถามซ้ำ
            row.dataset.avail = newVal
            const availText = row.querySelector('[data-avail-text]')
            if (availText) availText.textContent = `/ ${asmFmtNum(newVal)} ${row.dataset.unit || ''}`
            _asmLockRowEdit(row, btn)
            return
        }

        // แก้จำนวนลงจากเดิมครั้งแรกของแถวนี้ → ต้องแบ่ง Lot ถามยืนยันก่อน
        _asmPendingSplitRow = { row, btn, input, newVal }
        document.getElementById('asmSplitLotLabel').textContent =
            `${row.dataset.lotNo}${asmDict().splitLotArrow}${asmFmtNum(newVal)} ${row.dataset.unit || ''}${asmDict().splitLotFromPrefix}${asmFmtNum(ceiling)}${asmDict().splitLotFromSuffix}`
        document.getElementById('asmConfirmSplitModal').style.display = 'flex'
    }

    let _asmPendingSplitRow = null

    function asmCancelSplitEdit() {
        document.getElementById('asmConfirmSplitModal').style.display = 'none'
        if (!_asmPendingSplitRow) return
        const { row, btn, input } = _asmPendingSplitRow
        input.value = row.dataset.qtyCeiling   // ยกเลิก = คืนค่าเดิม ไม่แบ่ง
        _asmLockRowEdit(row, btn)
        _asmPendingSplitRow = null
    }

    // ยืนยันแบ่ง Lot — ขอเลข Lot ใหม่ (child) มาแทน parent ใน list ทันที (ยังไม่ยิง /inventory/split จริง รอถึงตอนกด Assembly)
    async function asmConfirmSplitEdit() {
        if (!_asmPendingSplitRow) return
        const { row, btn, input, newVal } = _asmPendingSplitRow
        const confirmBtn = document.getElementById('asmSplitConfirmBtn')
        confirmBtn.disabled = true
        confirmBtn.innerHTML = `<i class="bi bi-hourglass-split"></i> ${asmDict().requestingLotNo}`
        try {
            const trRes = await api('/inventory/new-lotNo', 'GET')
            const childLotNo = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? null
            if (!childLotNo) throw new Error(asmDict().noNewLotReceived)

            if (!row.dataset.parentLotNo) row.dataset.parentLotNo = row.dataset.lotNo
            asmScannedLots.delete(row.dataset.lotNo)
            row.dataset.lotNo      = childLotNo
            row.dataset.avail      = newVal
            row.dataset.needsSplit = 'true'
            asmScannedLots.add(childLotNo)

            row.classList.add('row-split')
            const lotCell = row.querySelector('[data-lotno-cell]')
            if (lotCell) lotCell.innerHTML = `${esc(childLotNo)}<div style="font-size:9px;color:#8b5cf6;font-weight:600;margin-top:1px">From ${esc(row.dataset.parentLotNo)}</div>`
            const availText = row.querySelector('[data-avail-text]')
            if (availText) availText.textContent = `/ ${asmFmtNum(newVal)} ${row.dataset.unit || ''}`

            document.getElementById('asmConfirmSplitModal').style.display = 'none'
            toast(`${asmDict().preparedSplitPrefix}${childLotNo}${asmDict().preparedSplitSuffix}`, 'ok')
            _asmLockRowEdit(row, btn)
        } catch (err) {
            toast(asmDict().requestNewLotFailedPrefix + (err.message || ''), 'err')
            input.value = row.dataset.qtyCeiling
            document.getElementById('asmConfirmSplitModal').style.display = 'none'
            _asmLockRowEdit(row, btn)
        } finally {
            confirmBtn.disabled = false
            confirmBtn.innerHTML = asmDict().confirmSplitBtn
            _asmPendingSplitRow = null
        }
    }

    let _asmPendingDeleteRow = null

    function asmRemoveRow(btn) {
        _asmPendingDeleteRow = btn.closest('tr')
        document.getElementById('asmDeletePartLabel').textContent = _asmPendingDeleteRow.dataset.lotNo || ''
        document.getElementById('asmConfirmDeleteModal').style.display = 'flex'
    }

    function asmCancelDeleteRow() {
        _asmPendingDeleteRow = null
        document.getElementById('asmConfirmDeleteModal').style.display = 'none'
    }

    function asmConfirmDeleteRow() {
        if (!_asmPendingDeleteRow) return
        const row = _asmPendingDeleteRow
        asmScannedLots.delete(row.dataset.lotNo)
        if (row.dataset.parentLotNo) asmScannedLots.delete(row.dataset.parentLotNo)   // ลบแถว lot ลูกที่แบ่งมา — ปลด lot ต้นทางด้วย ให้ปุ่ม + ใน Find Lot by Work Order กลับมากดได้อีก
        const errDetail = row.nextElementSibling
        if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
        // หัวกลุ่ม (asm-group-head) อยู่ถาวรอยู่แล้ว ไม่ต้อง revert เป็น placeholder — ลบแถว lot ทิ้งแล้ว asmRecomputeGroups() จะอัปเดต tube กลับไป 0 เอง
        row.remove()
        _asmPendingDeleteRow = null
        document.getElementById('asmConfirmDeleteModal').style.display = 'none'
        asmCheckEmpty()
        asmUpdateState()
        if (_asmLfCurrentWo) asmLfRenderResults()   // sync ปุ่ม + ของ Find Lot by Work Order กลับตามสถานะล่าสุด
    }

    function asmCheckEmpty() {
        if (!document.querySelectorAll('#asmTable tr[data-lot-no], #asmTable tr.asm-group-head').length) {
            document.getElementById('asmTable').insertAdjacentHTML('beforeend', `
                <tr id="asmEmptyRow">
                    <td colspan="6" class="empty-state">
                        <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                        ${asmDict().emptyMaterials}
                    </td>
                </tr>`)
        }
    }

    function asmFmtNum(n) {
        return (Math.round((n || 0) * 1000) / 1000).toLocaleString()
    }

    // วาด ammo tube ของทุก part ตาม scaleFactor ที่กำหนด (scaleFactor = กี่เท่าของสูตรฐาน (_asmBomProfile.outputQuantity) ที่กำลังทำอยู่)
    // ใช้ร่วมกันทั้ง 2 ทาง: มาจากยอดสแกน (asmRecomputeGroups) หรือมาจากที่ user พิมพ์ Output Qty เอง (asmOutputQtyEdited)
    function asmRenderTubes(scaleFactor, scannedByPart) {
        if (!_asmRequiredParts.size) return
        if (!scannedByPart) {
            scannedByPart = {}
            _asmRequiredParts.forEach((req, partNo) => {
                const inputs = document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(partNo)}"] [data-qty-input]`)
                scannedByPart[partNo] = [...inputs].reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0)
            })
        }
        _asmRequiredParts.forEach((req, partNo) => {
            const neededForBatch = req.quantity * scaleFactor
            const scanned         = scannedByPart[partNo] || 0
            const pct              = neededForBatch > 0 ? Math.min(100, (scanned / neededForBatch) * 100) : 0
            const isOver            = neededForBatch > 0 && scanned > neededForBatch + 1e-9
            // fulfilled = ตรงเป๊ะพอดี (ไม่ขาด ไม่เกิน) — ต่างจากเดิมที่ >= ก็ถือว่า fulfilled แล้ว เพราะตอนนี้เกินไปคือปัญหา (ต้องแก้ให้พอดีก่อนถึงจะกด Assembly ได้)
            req.fulfilled            = neededForBatch > 0 && Math.abs(scanned - neededForBatch) <= 1e-9

            const head = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(partNo)}"]`)
            if (!head) return
            const fill  = head.querySelector('.ammo-tube-fill')
            const frac  = head.querySelector('.ammo-frac')
            const state = pct <= 0 ? '' : (isOver ? 'over' : (req.fulfilled ? 'full' : 'partial'))
            fill.className   = 'ammo-tube-fill' + (state ? ' ' + state : '')
            fill.style.width = pct + '%'
            frac.className   = 'ammo-frac' + (state ? ' ' + state : '')
            frac.textContent = `${asmFmtNum(scanned)}/${asmFmtNum(neededForBatch)}`
        })
    }

    // Material row เปลี่ยน (สแกนเพิ่ม/ลบ/แก้ qty ใน list) → หา part ที่สแกนไปไกลที่สุดเทียบสัดส่วนสูตร แล้วดัน Output Qty ขึ้นตามอัตโนมัติ
    // "batch" = จำนวนชุดสูตรที่กำลังทำอยู่ตอนนี้ (สแกนเกิน 1 ชุดของ part ไหนก่อน ก็ดันทั้งกลุ่มขึ้น batch ถัดไปทันที)
    // part อื่นที่ยังตามไม่ทัน batch ปัจจุบัน จะโชว์เป็นหลอดครึ่งๆ สีเหลืองแทน ให้เห็นชัดว่ายังขาดอะไรอยู่ก่อนจะครบ batch นั้น
    function asmRecomputeGroups() {
        if (!_asmRequiredParts.size) return

        const scannedByPart = {}
        _asmRequiredParts.forEach((req, partNo) => {
            const inputs = document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(partNo)}"] [data-qty-input]`)
            scannedByPart[partNo] = [...inputs].reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0)
        })

        let maxRatio = 0
        _asmRequiredParts.forEach((req, partNo) => {
            if (req.quantity > 0) maxRatio = Math.max(maxRatio, scannedByPart[partNo] / req.quantity)
        })

        // ยังไม่มีอะไรสแกนเลยตั้งแต่เพิ่งเลือก Output Part (_asmSuppressAutoQtyFill) — คง Output Qty ไว้ที่ 0 ตามที่ขอ ไม่ auto-fill
        // เป็น "1 batch ของสูตร" ให้ แต่หลอด progress ยังโชว์จำนวนที่ต้องสแกน (req.quantity) ตามปกติเหมือนเดิม (ส่ง batch=1 ไป
        // asmRenderTubes() เพื่อให้ตัวหารของหลอดถูกต้อง ไม่ใช่ 0/0 ที่ดูสับสน) — พอเริ่มสแกนจริง (maxRatio > 0) ค่อยกลับไป auto-bump ปกติ
        if (_asmSuppressAutoQtyFill && maxRatio === 0) {
            document.getElementById('asmOutputQty').value = 0
            asmRenderTubes(1, scannedByPart)
            return
        }
        _asmSuppressAutoQtyFill = false

        const batch = Math.max(1, Math.ceil(maxRatio - 1e-9))   // กัน floating point แกว่งใกล้ๆ จำนวนเต็ม (เช่น 1.9999999)

        const baseOutputQty = _asmBomProfile?.outputQuantity || 1
        document.getElementById('asmOutputQty').value = batch * baseOutputQty
        asmRenderTubes(batch, scannedByPart)
    }

    // ใช้ค่า #asmOutputQty ปัจจุบัน (fix ไว้แล้ว ไม่ auto-bump) มาคำนวณ scaleFactor แล้ว render หลอด progress ของแต่ละ part ตาม
    function _asmRenderTubesFromFixedOutputQty() {
        const baseOutputQty = _asmBomProfile?.outputQuantity || 1
        const outputQty     = parseFloat(document.getElementById('asmOutputQty').value) || 0
        const scaleFactor   = baseOutputQty > 0 ? outputQty / baseOutputQty : 0
        asmRenderTubes(scaleFactor)
    }

    // Output Qty ถูกแก้เอง (พิมพ์ในช่องตรงๆ) → ใช้ค่านั้นเป็นเป้าหมายใหม่ ปรับ target/หลอด progress ของแต่ละ part ตาม
    // และ fix เป้าหมายไว้ตรงนี้เลย (_asmOutputQtyManual = true) — สแกนเพิ่มหลังจากนี้จะไม่ไปดัน Output Qty ขึ้นอัตโนมัติอีกต่อไป (asmUpdateState เช็ค flag นี้)
    function asmOutputQtyEdited() {
        _asmOutputQtyManual = true
        _asmSuppressAutoQtyFill = false   // พิมพ์เองแล้ว — เลิกกันไม่ให้ asmRecomputeGroups() auto-fill (ปกติจะไม่ถูกเรียกอีกต่อไปตอน manual=true อยู่แล้ว แต่กันไว้เผื่อสลับกลับ)
        _asmRenderTubesFromFixedOutputQty()
        asmFinishUpdateState()
        asmSaveDraft()
    }

    // ส่วนท้ายที่ใช้ร่วมกันทั้ง 2 ทาง (material row เปลี่ยน หรือแก้ Output Qty เอง) — อัปเดต badge/validity/preview
    function asmFinishUpdateState() {
        const rows = [...document.querySelectorAll('#asmTable tr[data-lot-no]')]
        if (_asmRequiredParts.size) {
            const fulfilledCount = [..._asmRequiredParts.values()].filter(r => r.fulfilled).length
            document.getElementById('asmCountBadge').textContent = fulfilledCount + '/' + _asmRequiredParts.size
        } else {
            document.getElementById('asmCountBadge').textContent = rows.length + '/10'
        }

        let validRows = rows.length > 0
        rows.forEach(r => {
            const input = r.querySelector('[data-qty-input]')
            const avail = parseFloat(r.dataset.avail) || 0
            const val   = parseFloat(input.value) || 0
            const bad   = !(val > 0) || val > avail
            input.classList.toggle('err', bad)
            if (bad) validRows = false
        })

        const outputPartNo = document.getElementById('asmOutputPartNo').value.trim()
        const outputQty    = parseFloat(document.getElementById('asmOutputQty').value)
        // ต้องสแกนทุก Part ให้ตรงเป๊ะตามเป้าหมาย (ไม่ขาด ไม่เกิน) ก่อนถึงจะกด Assembly ได้ — ดูสถานะ fulfilled ที่ asmRenderTubes() อัปเดตไว้ล่าสุด
        const allPartsExact = _asmRequiredParts.size === 0 || [..._asmRequiredParts.values()].every(r => r.fulfilled)
        const enabled = validRows && !!outputPartNo && outputQty > 0 && !_asmSubmitting && allPartsExact
        document.getElementById('asmSubmitBtn').disabled = !enabled

        asmRenderPreviewPanel()
    }

    function asmUpdateState() {
        // ยังไม่เคยพิมพ์ Output Qty เอง → auto-bump ตามที่สแกนเหมือนเดิม (asmRecomputeGroups)
        // เคยพิมพ์เองแล้ว → เป้าหมาย fix ไว้ตามค่านั้น แค่ render หลอดใหม่ตามยอดสแกน ไม่ไปทับ Output Qty อีก
        if (_asmOutputQtyManual) _asmRenderTubesFromFixedOutputQty()
        else asmRecomputeGroups()
        asmFinishUpdateState()
        asmSaveDraft()   // sync ทุกครั้งที่ตาราง/Output Part เปลี่ยน กัน Refresh แล้วข้อมูลหาย (ดู asmShowDraftBannerIfAny ตอนโหลดหน้าใหม่)
    }

    // ── Preview: Output Part label ก่อน Assembly จริง ─────
    // ไม่ต้องยิง /inventory/new-lotNo มาโชว์ตอน preview เพราะเลขที่ได้ไม่ได้ถูกใช้จริงอยู่แล้ว (เลข lot จริงมาจาก outputLot ใน response ของ /inventory/assembly ตอน submit) — preview ใส่ placeholder ไปเลย
    const ASM_PREVIEW_LOT_PLACEHOLDER = 'ASSY_NEW-LOT'

    function asmLayoutChanged() {
        asmRenderPreviewPanel()
    }

    // ถ้าทุกแถววัตถุดิบมี workOrder ตรงกันหมดให้แสดงค่านั้น ถ้าไม่ตรงกัน (คนละ WO) ให้ถือว่าไม่รู้ (เหมือน _mgCommonOrMixed ของ Merge)
    function _asmCommonOrMixed(rows, key) {
        const vals = new Set(rows.map(r => r.dataset[key]).filter(Boolean))
        if (vals.size === 0) return '—'
        if (vals.size === 1) return [...vals][0]
        return 'Mixed'
    }

    // Production Area สำหรับพิมพ์ label — ลำดับความสำคัญ: 1) productionPlant จาก /workorder/{wo}/detail (ถ้าวัตถุดิบทุก lot
    // มี workOrder ตรงกันหมดและหาเจอ) 2) เดาจากชื่อ Layout Template ที่เลือก 3) default Fan_1 ถ้าไม่เข้า pattern ไหนเลย
    async function asmResolveProductionArea(workOrder) {
        if (!_locNameMap.size) await loadLocation()
        if (workOrder) {
            try {
                const detail = await api(`/workorder/${encodeURIComponent(workOrder)}/detail`, 'GET')
                const plant  = (detail?.productionPlant || '').trim()
                if (plant) {
                    const pm       = plant.match(/(\d+)\s*$/)
                    const areaCode = pm ? `Fan_${pm[1]}` : plant
                    const match    = Array.from(_locNameMap.values())
                        .filter(loc => (loc.typeName || '').toLowerCase() === 'factory')
                        .find(loc =>
                            (loc.locationCode || '').toLowerCase() === areaCode.toLowerCase() ||
                            (loc.displayName  || '').toLowerCase() === areaCode.toLowerCase())
                    return { code: match?.locationCode ?? areaCode, name: match?.displayName ?? areaCode }
                }
            } catch (_) { /* fall through ไป guess จาก Layout Template แทน */ }
        }
        const layoutId = document.getElementById('asmLayoutSelect')?.value
        const layout   = _asmLayouts.find(l => String(l.id) === String(layoutId))
        const tplName  = (layout?.templateName || '').trim()
        const m        = tplName.match(/^FAN_?(\d+)/i)
        const areaCode = m ? `Fan_${m[1]}` : 'Fan_1'
        const match    = Array.from(_locNameMap.values()).find(loc =>
            (loc.locationCode || '').toLowerCase() === areaCode.toLowerCase() ||
            (loc.displayName  || '').toLowerCase() === areaCode.toLowerCase())
        return { code: match?.locationCode ?? areaCode, name: match?.displayName ?? areaCode }
    }

    // W/O + Line ที่จะโชว์บน label — เอาจากวัตถุดิบทุก lot ถ้าตรงกันหมด ไม่ตรงกัน/ไม่มีเลยก็ปล่อยว่าง
    // workOrder ตัวเดียวกันนี้ยังใช้เป็น input ให้ asmResolveProductionArea() หา productionPlant ต่อด้วย
    function _asmResolveLabelWoAndLine() {
        const rows = [...document.querySelectorAll('#asmTable tr[data-lot-no]')]
        const clean = v => (v === 'Mixed' || v === '—') ? '' : v
        return {
            workOrder: clean(_asmCommonOrMixed(rows, 'wo')),
            line:      clean(_asmCommonOrMixed(rows, 'line')),
        }
    }

    async function asmRenderPreviewPanel() {
        const box = document.getElementById('asmPreviewImgBox')
        if (!box) return

        const outputPartNo = document.getElementById('asmOutputPartNo').value.trim()
        if (!outputPartNo) {
            box.innerHTML = `<div class="empty-state" style="padding:0">${asmDict().selectOutputPartFirst}</div>`
            return
        }
        const layoutId = document.getElementById('asmLayoutSelect')?.value
        if (!layoutId) {
            box.innerHTML = `<div class="empty-state" style="padding:0">${asmDict().selectLayoutBeforePreview}</div>`
            return
        }
        const layout = _asmLayouts.find(l => String(l.id) === String(layoutId))
        if (!layout) {
            box.innerHTML = `<div class="empty-state" style="padding:0">${asmDict().layoutNotFoundPreview}</div>`
            return
        }

        const cfg = parseZplDataJson(layout)
        const outputQty = document.getElementById('asmOutputQty').value
        const { workOrder, line } = _asmResolveLabelWoAndLine()
        const area = await asmResolveProductionArea(workOrder)
        await asmLoadPartsInfo([outputPartNo])   // การันตี _asmItemInfoCache มี itemName ของ output part แล้ว (no-op ถ้า cache ไว้แล้ว)

        const data = {
            partNo:              outputPartNo,
            quantity:            String(outputQty || 0),
            itemType:            1,
            description:         asmItemName(outputPartNo),   // {description}/NAME บน layout → itemName ของ output part
            workOrder,
            line,
            lotNo:               ASM_PREVIEW_LOT_PLACEHOLDER,
            uniqueId:            '(Auto-Gen)',   // Preview เท่านั้น — uniqueId จริงจะ fetch สดตอน print จริง (ไม่ fetch ตอน preview กันยิง API ถี่เกิน)
            productionArea:      area.code,
            _productionAreaName: area.name,
            createdAt:           new Date().toISOString(),
        }

        const sliders = {
            qrX: cfg.qrX ?? 30, qrY: cfg.qrY ?? 40, qrSize: cfg.qrSize ?? 5,
            dataX: cfg.dataX ?? 373, dataY: cfg.dataY ?? 58,
            fontSize: cfg.fontSize ?? 22, lineHeight: cfg.lineHeight ?? 33, valOffset: cfg.valOffset ?? 151,
        }
        const textFields = buildLabelTextFields(cfg.labelFields, data)
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        box.innerHTML = `<div class="empty-state" style="padding:0">${asmDict().rendering}</div>`
        try {
            const src = await renderZplClient(zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
            box.innerHTML = src ? `<img src="${src}">` : `<div class="empty-state" style="padding:0">${asmDict().noPreview}</div>`
        } catch (_) {
            box.innerHTML = `<div class="empty-state" style="padding:0">${asmDict().previewFailed}</div>`
        }
    }

    // ── Submit (photo confirmation + GPS) ─────────────
    // 'printAssembly' = Print & Assembly (บังคับถ้าไม่มีสิทธิ์ WMS.UI.Assembly.SkipPrint), 'assemblyOnly' = ไม่พิมพ์
    let asmActionMode = 'printAssembly'

    function submitAssembly() {
        const rows = [...document.querySelectorAll('#asmTable tr[data-lot-no]')]
        if (!rows.length || _asmSubmitting) { toast(asmDict().pleaseAddAtLeast1Material, 'err'); return }
        if (!document.getElementById('asmOutputPartNo').value.trim()) { toast(asmDict().pleaseSelectOutputPartNo, 'err'); return }
        if (!(parseFloat(document.getElementById('asmOutputQty').value) > 0)) { toast(asmDict().pleaseEnterOutputQty, 'err'); return }

        document.getElementById('asmResultBanner').style.display = 'none'
        document.getElementById('asmRetryPrintBtn').style.display = 'none'
        _asmLastFailedPrint = null

        if (asmCanSkipPrint) {
            document.getElementById('asmActionModal').style.display = 'flex'
        } else {
            asmActionMode = 'printAssembly'
            asmContinueSubmit()
        }
    }

    function asmCloseActionModal() {
        document.getElementById('asmActionModal').style.display = 'none'
    }

    function asmChooseAction(mode) {
        asmActionMode = mode
        asmCloseActionModal()
        asmContinueSubmit()
    }

    function asmContinueSubmit() {
        if (asmActionMode === 'printAssembly') {
            if (!document.getElementById('asmLayoutSelect')?.value)  { toast(asmDict().pleaseSelectLayout, 'err'); return }
            if (!document.getElementById('asmPrinterSelect')?.value) { toast(asmDict().pleaseSelectPrinter, 'err'); return }
        }
        if (document.getElementById('advSkipImg')?.checked) {
            doAssembly()
        } else {
            asmPhoto.open()
        }
    }

    // เก็บ args ของการพิมพ์ที่ fail ล่าสุดไว้ ให้ปุ่ม "Print Again" บน result banner เรียกซ้ำได้ (ดู asmRetryPrint() ด้านล่าง)
    let _asmLastFailedPrint = null

    // ปุ่ม "Print Again" บน result banner — กดซ้ำหลัง print ครั้งแรก fail เท่านั้น จึงส่ง isReprint: true เสมอ
    async function asmRetryPrint() {
        if (!_asmLastFailedPrint) return
        const { outputPartNo, lotNo, workOrder, line } = _asmLastFailedPrint
        try {
            await asmPrintOutputLabel(outputPartNo, lotNo, workOrder, line, true)
            toast('🖨️ ' + asmDict().printLabelSuccess, 'ok')
            _asmLastFailedPrint = null
            document.getElementById('asmRetryPrintBtn').style.display = 'none'
        } catch (printErr) {
            toast(`⚠️ ${asmDict().printFailedPrefix}${printErr.message || 'Print failed'}`, 'warn')
        }
    }

    // พิมพ์ label ของ Output Part หลัง Assembly สำเร็จ — ใช้ Layout/Printer ที่เลือกไว้ + Output Part/Qty ที่กรอก
    // workOrder/line ต้องรับเป็น parameter (เก็บมาจาก #asmTable ก่อนถูกเคลียร์ใน doAssembly()) — ตอนฟังก์ชันนี้ทำงาน
    // ตาราง material ถูกเคลียร์ไปแล้ว (assembly สำเร็จ) เลยอ่านจาก DOM ตรงนี้ไม่ได้อีกต่อไป
    async function asmPrintOutputLabel(outputPartNo, lotNo, workOrder, line, isReprint = false) {
        const layoutId    = document.getElementById('asmLayoutSelect')?.value
        const printerSel  = document.getElementById('asmPrinterSelect')
        const printerIp   = printerSel?.value
        const printerPort = printerSel?.dataset.port || 9100
        const layout = _asmLayouts.find(l => String(l.id) === String(layoutId))
        if (!layout) throw new Error(asmDict().layoutNotFound)
        const cfg = parseZplDataJson(layout)

        const uniqueId  = await _fetchUniqueId()
        const outputQty = document.getElementById('asmOutputQty').value
        const area      = await asmResolveProductionArea(workOrder)
        await asmLoadPartsInfo([outputPartNo])   // การันตี _asmItemInfoCache มี itemName ของ output part แล้ว (no-op ถ้า cache ไว้แล้ว)

        let finalLotNo = lotNo
        if (!finalLotNo) {
            const trRes = await api('/inventory/new-lotNo', 'GET')
            finalLotNo = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? '(Auto-Gen)'
        }

        const data = {
            partNo:              outputPartNo,
            quantity:            String(outputQty || 0),
            itemType:            1,
            description:         asmItemName(outputPartNo),   // {description}/NAME บน layout → itemName ของ output part
            workOrder,
            line,
            lotNo:               finalLotNo,
            uniqueId,
            productionArea:      area.code,
            _productionAreaName: area.name,
            createdAt:           new Date().toISOString(),
        }

        const sliders = {
            qrX: cfg.qrX ?? 30, qrY: cfg.qrY ?? 40, qrSize: cfg.qrSize ?? 5,
            dataX: cfg.dataX ?? 373, dataY: cfg.dataY ?? 58,
            fontSize: cfg.fontSize ?? 22, lineHeight: cfg.lineHeight ?? 33, valOffset: cfg.valOffset ?? 151,
        }
        const textFields = buildLabelTextFields(cfg.labelFields, data)
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        const payload = { printerIp, printerPort, lotNo: finalLotNo, uniqueId, zpl: applyPrintOffset(zpl, cfg), isReprint }
        console.log('[Assembly] /printer/send payload:', payload)
        const res = await api('/printer/send', 'POST', payload, 10000)
        const pd  = res?.problemDetails
        if (pd || (res?.statusCode && res.statusCode >= 400)) {
            throw new Error([pd?.title, pd?.detail].filter(Boolean).join(': ') || res?.message || 'Print failed')
        }
    }

    function _setRowAction(row, html) {
        const lastTd = row.cells[row.cells.length - 1]
        if (lastTd) lastTd.innerHTML = html
    }

    function _setRowError(row, errMsg) {
        row.classList.add('row-err')
        _setRowAction(row, `<button class="del-btn" onclick="asmRemoveRow(this)" title="Remove"><i class="bi bi-trash3"></i></button>`)
        const existing = row.nextElementSibling
        if (existing?.classList.contains('row-err-detail')) existing.remove()
        row.insertAdjacentHTML('afterend', `
            <tr class="row-err-detail">
                <td colspan="6"><span style="font-size:11px;color:var(--red);font-weight:600">${esc(errMsg)}</span></td>
            </tr>`)
    }

    async function doAssembly() {
        if (_asmSubmitting) return
        _asmSubmitting = true
        asmUpdateState()

        const sendBtn = document.getElementById('asmPcSendBtn')
        sendBtn.disabled = true

        try {
            let latitude = null, longitude = null, heigth = null
            if (!document.getElementById('advSkipGps')?.checked) {
                if (!navigator.geolocation) { toast(asmDict().browserNoGps, 'err'); return }
                sendBtn.innerHTML = `<i class="bi bi-geo-alt"></i> ${asmDict().gettingGps}`
                try {
                    const pos = await new Promise((res, rej) =>
                        navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
                    )
                    latitude  = pos.coords.latitude
                    longitude = pos.coords.longitude
                    heigth    = pos.coords.altitude
                } catch (e) {
                    toast(asmDict().gpsError + e.message, 'err'); return
                }
            }
            sendBtn.innerHTML = `<i class="bi bi-hourglass-split"></i> ${asmDict().assemblingInProgress}`

            const rows = [...document.querySelectorAll('#asmTable tr[data-lot-no]')]
            if (!rows.length) { toast(asmDict().pleaseAddAtLeast1Material, 'err'); return }
            const outputPartNo = document.getElementById('asmOutputPartNo').value.trim()
            if (!outputPartNo) { toast(asmDict().pleaseSelectOutputPartNo, 'err'); return }

            // เก็บ W/O + Line ไว้ตอนนี้เลย ก่อน #asmTable จะถูกเคลียร์ทิ้งหลัง assembly สำเร็จ (asmPrintOutputLabel อ่านจาก DOM ไม่ได้อีกแล้วตอนนั้น)
            const { workOrder, line } = _asmResolveLabelWoAndLine()
            // Advanced Options (Skip Permission ต่างๆ) ใช้ชุดเดียวกันทั้ง /inventory/split และ /inventory/assembly
            const options = getAdvancedOptions()

            // ── แถวที่แก้ qty ลง (pending split) ต้องยิง /inventory/split ให้สำเร็จทุกแถวก่อน ถึงจะไป Assembly ต่อได้ ──
            // ยิงทีละแถว (ไม่ parallel) แล้วหยุดทันทีถ้าแถวไหน fail — แถวที่แบ่งสำเร็จไปแล้วก่อนหน้าถือว่าสำเร็จจริงในระบบแล้ว (ไม่มี API ยกเลิก split) จึง mark ไว้ไม่ให้ยิงซ้ำถ้ากด Assembly ใหม่
            const splitRows = rows.filter(r => r.dataset.needsSplit === 'true')
            if (splitRows.length) {
                sendBtn.innerHTML = `<i class="bi bi-hourglass-split"></i> ${asmDict().splittingLotsInProgress}`
                for (const row of splitRows) {
                    row.classList.remove('row-err')
                    const errDetail = row.nextElementSibling
                    if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
                    row.classList.add('row-processing')

                    const qty = parseFloat(row.querySelector('[data-qty-input]')?.value) || 0
                    // backend สะกด "longitude" ผิดเป็น "longtitude" (ยืนยันจาก Swagger request จริงของ /inventory/split ที่ทดสอบสำเร็จ) ต้องส่งตามนี้เป๊ะๆ
                    const splitPayload = {
                        parentLotNo: row.dataset.parentLotNo,
                        childLotNo:  row.dataset.lotNo,
                        qty,
                        latitude, longtitude: longitude, heigth,
                        options,
                    }
                    console.log('[Assembly→Split] payload →', splitPayload)
                    try {
                        const splitRes = await apiForm('/inventory/split', splitPayload, asmPhoto.getBlobs(), 10000, 'POST', 'files')
                        console.log('[Assembly→Split] response →', splitRes)
                        if (splitRes && splitRes.success === false) throw new Error(splitRes.message || 'Split failed')
                        row.dataset.needsSplit = 'false'
                        row.classList.remove('row-processing')
                    } catch (splitErr) {
                        const msg    = splitErr.message || 'Split failed'
                        const tagged = splitErr.status ? `HTTP ${splitErr.status}: ${msg}` : msg
                        rows.forEach(r => r.classList.remove('row-processing'))
                        asmSetGroupOpen(row.dataset.partNo, true)
                        _setRowError(row, `${asmDict().splitFailedPrefix}${tagged}`)
                        toast('❌ ' + asmDict().splitFailedToastPrefix + tagged, 'err', { duration: 7000 })
                        return   // หยุดก่อน ไม่ไปเรียก /inventory/assembly ต่อ
                    }
                }
            }

            const materials = rows.map(r => ({
                lotNo:    r.dataset.lotNo,
                quantity: parseFloat(r.querySelector('[data-qty-input]')?.value) || 0,
            }))
            // backend สะกด "longitude" ผิดเป็น "longtitude" (ยืนยันจาก Swagger request จริงของ /inventory/split ที่ทดสอบสำเร็จ) ต้องส่งตามนี้เป๊ะๆ
            const payload = { outputPartNo, currentLongtitude: longitude, currentLatitude: latitude, heigth, materials, options }

            console.log('[Assembly] payload →', payload)
            toastPayload('[Assembly] payload', payload)

            sendBtn.innerHTML = `<i class="bi bi-hourglass-split"></i> ${asmDict().assemblingInProgress}`
            rows.forEach(row => {
                const errDetail = row.nextElementSibling
                if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
                row.classList.remove('row-err', 'row-ok')
                row.classList.add('row-processing')
            })

            try {
                const res = await apiForm('/inventory/assembly', payload, asmPhoto.getBlobs(), 10000, 'POST', 'files')
                console.log('[Assembly] response →', res)

                // backend บาง error (เช่น "Assembly only allowed in PreAssembly") ตอบกลับมาเป็น HTTP 200
                // พร้อม { success:false, message:"..." } แทนที่จะเป็น HTTP error — apiForm() เลยไม่ throw ให้เอง
                // ต้องเช็ค success flag เองตรงนี้ ไม่งั้นจะถือว่าสำเร็จทั้งที่จริงๆ ล้มเหลว
                if (res && res.success === false) throw new Error(res.message || 'Assembly failed')

                // เลข lot จริงของ output ต้องเอาจาก response (data.outputLot) เท่านั้น
                const outputLot = res?.data?.outputLot

                // สำเร็จจริง → เคลียร์ list ทิ้งทั้งหมด (รวม lot ต้นทางที่เคย mark ไว้ตอน auto-split ด้วย ไม่ใช่แค่ lot ที่อยู่ในแถวจริง)
                rows.forEach(row => {
                    asmScannedLots.delete(row.dataset.lotNo)
                    if (row.dataset.parentLotNo) asmScannedLots.delete(row.dataset.parentLotNo)
                })
                document.getElementById('asmTable').innerHTML = ''
                asmCheckEmpty()
                document.getElementById('asmResultPartNo').textContent = outputPartNo
                document.getElementById('asmResultLotNo').textContent  = outputLot || '—'
                document.getElementById('asmResultBanner').style.display = 'flex'
                toast(asmDict().assemblySuccess, 'ok')

                // Assembly สำเร็จแล้ว — ถ้าเลือกโหมด Print & Assembly ให้พิมพ์ label ของ Output Part ต่อ
                if (asmActionMode === 'printAssembly') {
                    try {
                        await asmPrintOutputLabel(outputPartNo, outputLot, workOrder, line)
                        toast('🖨️ ' + asmDict().printLabelSuccess, 'ok')
                        _asmLastFailedPrint = null
                        document.getElementById('asmRetryPrintBtn').style.display = 'none'
                    } catch (printErr) {
                        toast(`⚠️ ${asmDict().assemblySuccessPrintFailedPrefix}${printErr.message || 'Print failed'}`, 'warn')
                        // เก็บ args ไว้ให้ปุ่ม "Print Again" เรียกซ้ำได้ — ครั้งถัดไปที่พิมพ์จากหน้านี้ถือเป็น reprint แล้ว (isReprint: true)
                        _asmLastFailedPrint = { outputPartNo, lotNo: outputLot, workOrder, line }
                        document.getElementById('asmRetryPrintBtn').style.display = ''
                    }
                }

                // เก็บ Output Part No/Qty ไว้ใช้ต่อรอบถัดไป (ตามที่ขอ — งาน assembly ซ้ำๆ กันหลายรอบต่อวัน ไม่ต้องมาเลือก/พิมพ์
                // Output Part No + Output Qty ใหม่ทุกครั้ง) เคลียร์แค่ตาราง Materials อย่างเดียว — Lot เดิมถูกใช้ไปแล้วหลัง
                // Assembly สำเร็จ เก็บแถวเดิมไว้จะซ้ำ/ใช้ของที่หมดไปแล้ว ต้องสแกน Lot ใหม่ของรอบถัดไปเสมอ
                const keepOutputQty = document.getElementById('asmOutputQty').value   // เก็บไว้ก่อนเคลียร์ตาราง กัน asmRecomputeGroups()
                                                                                        // (เรียกจาก asmRenderRequiredRows() ด้านล่าง) auto-bump ทับกลับไปเป็น
                                                                                        // ค่า default ของ 1 batch เพราะยังไม่ได้สแกนอะไรเลย (0 scanned เสมอตอนนี้)
                asmScannedLots = new Set()
                if (_asmRequiredParts.size) {
                    asmRenderRequiredRows()   // สร้างหัวกลุ่มเปล่าใหม่จาก BOM เดิม (_asmBomProfile ยังอยู่) พร้อมให้สแกนรอบถัดไปได้เลย
                } else {
                    document.getElementById('asmTable').innerHTML = ''
                    asmCheckEmpty()
                }
                document.getElementById('asmOutputQty').value = keepOutputQty
                _asmOutputQtyManual = true   // fix ค่า Output Qty ไว้ตามเดิม ไม่ให้ auto-bump ทับกลับไปเป็น 1 batch ตอนยังไม่ได้สแกนอะไรเลย
                asmUpdateState()   // re-render หลอด progress ให้ตรงกับ Output Qty ที่เก็บไว้ + sync draft ใหม่

                // Assembly (และ Split ที่อาจเกิดขึ้นก่อนหน้าใน doAssembly() นี้) เปลี่ยน On Hand ของ lot ที่ใช้ไปจริงแล้ว — แผง Find Lot
                // by Work Order ที่เปิดค้างไว้ยังถือข้อมูลเก่าจากตอนโหลดครั้งก่อนอยู่ ต้อง fetch ใหม่ให้ตรงกับของจริงเสมอ ไม่พึ่งว่าจะ
                // ตรงกันเองบังเอิญ (lot ที่เพิ่งใช้ไปอาจเป็นของ W/O เดียวกับที่เปิดดูอยู่ในแผงนี้)
                if (_asmLfCurrentWo) asmLfLoadWorkOrder(_asmLfCurrentWo)
            } catch (err) {
                // Assembly เป็น call เดียวรวมทั้งก้อน — fail ทีเดียวกระทบทุก material ใน list เลย ใส่ inline error ให้ทุกแถว
                const msg    = err.message || 'Assembly failed'
                const tagged = err.status ? `HTTP ${err.status}: ${msg}` : msg
                rows.forEach(row => {
                    row.classList.remove('row-processing')
                    asmSetGroupOpen(row.dataset.partNo, true)   // ขยายกลุ่มให้เห็น error แม้กลุ่มนั้นหุบไว้อยู่
                    _setRowError(row, `${asmDict().assemblyFailedPrefix}${tagged}`)
                })
                toast('❌ ' + tagged, 'err', { duration: 7000 })
            }
        } finally {
            _asmSubmitting = false
            asmUpdateState()
            sendBtn.innerHTML = asmDict().send
            sendBtn.disabled = false
            asmPhoto.close()
        }
    }

    const asmPhoto = createPhotoCapture({ prefix: "asm", maxDimension: 1920 })
    document.getElementById('asmPcSendBtn').addEventListener('click', doAssembly)
    document.getElementById('asmPcCancelBtn').addEventListener('click', () => asmPhoto.close())

    window.addEventListener('beforeunload', (e) => {
        if (asmScanner.running) stopScan()
        const hasRows       = document.querySelectorAll('#asmTable tr[data-lot-no]').length > 0
        const hasOutputInfo = document.getElementById('asmOutputPartInput')?.value.trim() || document.getElementById('asmOutputQty')?.value
        if (hasRows || hasOutputInfo) {
            e.preventDefault()
            e.returnValue = ''
        }
    })

    // ── Fallback keyboard HW scanner (ใช้เมื่อ focus อยู่นอก input ใดๆ) ──
    ;(function() {
        let _buf = '', _timer = null
        const THRESHOLD = 150, MIN = 4
        function commit() {
            const c = _buf; _buf = ''
            if (c.length >= MIN) asmScan.submit(c)
        }
        document.addEventListener('keydown', e => {
            if (asmScanner.running) return
            const active = document.activeElement
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) return
            if (e.key === 'Enter') { clearTimeout(_timer); commit(); return }
            if (e.key.length === 1) { _buf += e.key; clearTimeout(_timer); _timer = setTimeout(commit, THRESHOLD) }
        })
    })()

    // ── Role: Advanced Options + Print permission gating ──────
    // WMS.UI.Assembly.SkipPrint = สิทธิ์ให้เลือก "Assembly Only" ได้ (ไม่มีสิทธิ์นี้ → บังคับ Print & Assembly เสมอ)
    let asmCanSkipPrint = false
    let asmIsAdmin = false
    ;(function() {
        const adminRoles = ['Admin']
        try {
            const user       = JSON.parse(localStorage.getItem('user') || '{}')
            const userRoles  = Array.isArray(user.roles) ? user.roles : []
            const userPermis = Array.isArray(user.permissions) ? user.permissions : []
            asmIsAdmin      = userRoles.some(r => adminRoles.includes(r))
            asmCanSkipPrint = asmIsAdmin || userPermis.includes('WMS.UI.Assembly.SkipPrint')
            applyAdvancedOptionsPermissions(userPermis, asmIsAdmin)

            // ปุ่มสลับ Scan Mode (Our/Vendor) — ต้องมี permission นี้ถึงจะเห็น ไม่งั้นซ่อนแล้วใช้ Our เป็น default เสมอ
            const canReadBarcodeVendor = asmIsAdmin || userPermis.includes('WMS.UI.ReadBarcodeVendor')
            document.getElementById('asmBcModeGroup').style.display = canReadBarcodeVendor ? '' : 'none'
        } catch (_) {}
    })()

    let _asmLayouts = []

    const asmPrinterPicker = createPrinterPicker({
        triggerId: 'asmPrinterTrigger', menuId: 'asmPrinterMenu', hiddenId: 'asmPrinterSelect',
        dotId: 'asmPrinterDot', nameId: 'asmPrinterName', ipId: 'asmPrinterIp',
        isAdmin: asmIsAdmin,
    })

    // แปลภาษาหน้านี้ทั้งหมด — เรียกตอน init และทุกครั้งที่กดสลับภาษา (ผูกผ่าน window.onLangChange ที่ _Layout.cshtml เรียกให้)
    function applyAssemblyLang() {
        applyDataI18n(asmDict())
        applyAdvancedOptionsLang()
    }
    window.onLangChange = applyAssemblyLang

    async function init() {
        asmShowDraftBannerIfAny()
        applyAssemblyLang()
        await loadLocation()
        await loadPerLocation()   // asmPrinterPicker.load() กรอง printer ตาม myLocations เลยต้องรอให้พร้อมก่อน
        _asmLayouts = await loadLayoutOptions(document.getElementById('asmLayoutSelect'), asmIsAdmin)
        await asmPrinterPicker.load()
    }
    init()
</script>
}
