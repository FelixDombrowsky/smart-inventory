@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersion
@{
    ViewData["Title"] = "Inventory Dashboard";
}


<style>
/* ───── ROOT ───── */
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --bg:#f1f4f9; --card:#fff;
    --green:#059669; --green-lt:#ecfdf5;
    --amber:#d97706; --amber-lt:#fffbeb;
    --red:#dc2626;   --red-lt:#fef2f2;
    --purple:#7c3aed; --purple-lt:#f5f3ff;
    --orange:#f97316;
}

/* ───── WELCOME BANNER ───── */
.welcome-banner {
    background: linear-gradient(135deg, var(--navy) 0%, #1e3a6e 60%, #1a6fff 100%);
    border-radius: 16px; padding: 24px 28px; margin-bottom: 24px;
    display: flex; align-items: center; justify-content: space-between;
    position: relative; overflow: hidden;
}
.welcome-banner::before {
    content: ''; position: absolute; right: -40px; top: -40px;
    width: 220px; height: 220px; border-radius: 50%;
    background: rgba(255,255,255,.04);
}
.welcome-banner h2 { font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 4px; }
.welcome-banner p  { font-size: 13px; color: rgba(255,255,255,.6); margin: 0; }
.wb-stats { display: flex; gap: 28px; position: relative; z-index: 1; }
.wb-divider { width: 1px; background: rgba(255,255,255,.15); }
.wb-stat { text-align: center; }
.wb-stat-num { font-size: 26px; font-weight: 700; color: #fff; line-height: 1; }
.wb-stat-lbl { font-size: 11px; color: rgba(255,255,255,.55); margin-top: 3px; white-space: nowrap; }
/* เพิ่ม/ลดเทียบกับช่วงเดียวกันของสัปดาห์ที่แล้ว (loadTodayStats) — ว่างเปล่าถ้ายังโหลดไม่เสร็จหรือคำนวณไม่ได้ */
.wb-stat-delta      { font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 1px; line-height: 1; }
.wb-stat-delta.up   { color: #86efac; }
.wb-stat-delta.down { color: #fca5a5; }
.wb-stat-delta.flat { color: rgba(255,255,255,.5); }

/* ───── STAT CARDS ───── */
.stat-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-bottom: 22px; }
.stat-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 14px; padding: 20px;
    display: flex; align-items: center; gap: 14px;
    box-shadow: 0 1px 4px rgba(0,0,0,.04);
    transition: transform .2s, box-shadow .2s;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.08); }
.stat-icon {
    width: 46px; height: 46px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 800; flex-shrink: 0;
}
.stat-num { font-size: 22px; font-weight: 700; color: var(--navy); line-height: 1; }
.stat-lbl { font-size: 11px; color: var(--t2); margin-top: 3px; }
.stat-sub { font-size: 11px; margin-top: 5px; font-weight: 600; }

/* ───── SECTION CARD ───── */
.section-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 14px; overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,.04); margin-bottom: 20px;
}
.sc-head {
    padding: 14px 18px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;
}
.sc-title {
    font-size: 13px; font-weight: 700; color: var(--navy);
    display: flex; align-items: center; gap: 8px;
}

/* ───── FILTER BAR ───── */
.filter-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.filter-input {
    padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px;
    font-size: 13px; outline: none; font-family: inherit; width: 220px; color: var(--text);
    transition: border-color .15s;
}
.filter-input:focus { border-color: var(--blue); }
.fsel {
    padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px;
    font-size: 13px; background: #fff; outline: none; cursor: pointer;
    font-family: inherit; color: var(--text);
}

/* ── Custom Location Type Dropdown (icon + badge color, native <select> ทำไม่ได้) ── */
.loc-type-dd-wrap { position:relative; }
.loc-type-dd-trigger {
    display:flex; align-items:center; gap:8px; min-width:160px;
    padding:8px 12px; border:1px solid var(--border); border-radius:8px;
    font-size:13px; font-family:inherit; background:#fff; color:var(--text);
    cursor:pointer; user-select:none; outline:none; transition:border-color .15s;
}
.loc-type-dd-trigger:hover, .loc-type-dd-trigger.open { border-color:var(--blue); }
.loc-type-dd-menu {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:200;
    background:#fff; border:1.5px solid var(--border); border-radius:9px;
    box-shadow:0 4px 16px rgba(0,0,0,.12); max-height:260px; overflow-y:auto;
}
.loc-type-dd-item {
    display:flex; align-items:center; gap:8px; padding:8px 12px;
    font-size:13px; cursor:pointer; transition:background .1s;
}
/* session ที่ไม่มี transaction เลย (ทำไม่สำเร็จ) — แถวสีจาง ยกเว้นช่อง badge */
.sum-row.sess-failed > td:not(.sess-txns-cell) { opacity: .45; }
.sum-row.sess-failed { background: repeating-linear-gradient(135deg, transparent 0 8px, rgba(148,163,184,.07) 8px 16px); }
.sess-fail-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; color: #dc2626; background: #fef2f2; border: 1px solid #fecaca; padding: 2px 8px; border-radius: 20px; white-space: nowrap; }
[data-theme="dark"] .sess-fail-badge { background: rgba(220,38,38,.12); border-color: rgba(220,38,38,.35); color: #f87171; }
.stock-card { overflow: visible; }   /* ไม่ให้ตัด dropdown Location ใน header ตอนตารางมีแถวน้อย */
/* ── Autocomplete ช่องค้นหา Stock Summary (Part No / Line / Location) ── */
.ac-wrap { position: relative; }
.ac-ico { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); font-size: 12px; color: var(--t3); pointer-events: none; }
.filter-input.ac-input { padding-left: 30px; padding-right: 26px; width: 200px; }
.filter-input.ac-input.ac-sm { width: 140px; }
.ac-wrap.has-val .ac-input { border-color: var(--blue); background: #f8fbff; }
.ac-clear { display: none; position: absolute; right: 6px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; border: none; border-radius: 50%; background: #e5e7eb; color: #475569; font-size: 13px; line-height: 16px; padding: 0; cursor: pointer; }
.ac-wrap.has-text .ac-clear { display: block; }
.ac-menu { display: none; position: absolute; top: calc(100% + 4px); left: 0; min-width: 100%; width: max-content; max-width: 340px; z-index: 210; background: #fff; border: 1.5px solid var(--border); border-radius: 9px; box-shadow: 0 6px 20px rgba(0,0,0,.12); max-height: 280px; overflow-y: auto; padding: 4px; }
.ac-menu.open { display: block; }
.ac-item { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; font-size: 13px; cursor: pointer; white-space: nowrap; }
.ac-item b { color: var(--navy); font-weight: 700; }
.ac-item small { color: var(--t2); font-size: 11.5px; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
.ac-item mark { background: #fef08a; color: inherit; padding: 0; border-radius: 2px; }
.ac-item.act, .ac-item:hover { background: #eff6ff; }
.ac-empty { padding: 8px 10px; font-size: 12.5px; color: var(--t3); }
[data-theme="dark"] .ac-menu { background: #1e293b; border-color: var(--border); }
[data-theme="dark"] .ac-item.act, [data-theme="dark"] .ac-item:hover { background: #253347; }
[data-theme="dark"] .ac-wrap.has-val .ac-input { background: #172131; }
[data-theme="dark"] .ac-clear { background: #334155; color: var(--text); }
.loc-type-dd-item:hover  { background:#f1f5ff; }
.loc-type-dd-item.active { background:#eff6ff; }
[data-theme="dark"] .loc-type-dd-trigger { background:#0f172a; border-color:var(--border); }
[data-theme="dark"] .loc-type-dd-menu    { background:#1e293b; border-color:var(--border); }
[data-theme="dark"] .loc-type-dd-item:hover  { background:#253347; }
[data-theme="dark"] .loc-type-dd-item.active { background:#162032; }

/* ── VIEW TOGGLE ── */
.view-toggle { display:flex; gap:4px; background:#f0f2f5; border-radius:8px; padding:3px; }
.view-btn {
    padding:5px 10px; border-radius:6px; border:none; background:transparent;
    cursor:pointer; color:var(--t2); transition:.15s; display:flex; align-items:center;
}
.view-btn.active { background:#fff; color:var(--blue); box-shadow:0 1px 3px rgba(0,0,0,.08); }
.view-btn:hover:not(.active) { color:var(--text); }

/* ── CARD GRID ── */
.stock-grid {
    display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
    gap:14px; padding:16px;
}
.stock-card {
    background:#fff; border:1px solid var(--border); border-radius:12px;
    overflow:hidden; transition:transform .15s, box-shadow .15s; cursor:default;
    display:flex; flex-direction:column;
}
.stock-card:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,.09); }
.stock-card-img { width:100%; aspect-ratio:1; object-fit:cover; background:#f8f9fc; display:block; cursor:zoom-in; }
.lightbox { position:fixed;inset:0;background:rgba(10,10,20,.85);backdrop-filter:blur(6px);z-index:9999;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s; }
.lightbox.show { opacity:1;pointer-events:all; }
.lightbox-inner { position:relative;max-width:90vw;max-height:90vh;transform:scale(.92);transition:transform .2s; }
.lightbox.show .lightbox-inner { transform:scale(1); }
.lightbox-img { max-width:90vw;max-height:85vh;border-radius:12px;box-shadow:0 24px 60px rgba(0,0,0,.5);display:block; }
.lightbox-close { position:absolute;top:-14px;right:-14px;width:32px;height:32px;border-radius:50%;border:none;background:#fff;color:var(--navy);font-size:16px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.2);line-height:1; }
.stock-card-body { padding:10px 12px; flex:1; display:flex; flex-direction:column; gap:6px; }
.stock-card-top { display:flex; align-items:center; justify-content:space-between; gap:6px; }
.stock-card-part { font-family:ui-monospace,monospace; font-size:11px; font-weight:700; color:var(--navy); }
.stock-card-name { font-size:12px; color:var(--t2); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.stock-card-qty-row { display:flex; align-items:baseline; gap:4px; }
.stock-card-avail { font-size:16px; font-weight:700; }
.stock-card-onhand { font-size:11px; color:var(--t2); }
.stock-card-bar { height:5px; background:#e5e7eb; border-radius:3px; overflow:hidden; }
.stock-card-fill { height:100%; border-radius:3px; }
.stock-card-pct { font-size:10px; font-weight:600; }
.stock-card-footer {
    display:flex; align-items:center; justify-content:space-between;
    padding:7px 12px; border-top:1px solid #f4f4f7;
    font-size:11px; color:var(--t2); font-weight:600;
}

/* Schedule modal (lsbOpenLineSchedule) — ตาราง GET /schedules?lineCode=... ตอนคลิก Line card */
/* พื้นหลังเบลอของ modal เอง แทน .modal-backdrop ปกติของ Bootstrap (ปิดไว้ผ่าน backdrop:false ตอนเปิด — ดู lsbOpenLineSchedule)
   เพราะ .modal-backdrop ถูก append แยกไว้ที่ document.body เอง ซึ่งจะไม่โดน render ตอนอยู่ใน fullscreen เหมือนปัญหาที่ modal
   นี้เจอมาก่อน (ย้าย modal เข้ามาอยู่ใน #lsbWrap แล้ว แต่ .modal-backdrop ที่ Bootstrap สร้างเองยังหลุดไปอยู่นอกอยู่ดี) */
#lsbLineScheduleModal.show { background: rgba(15,23,42,.45); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
.lsb-sched-empty  { text-align: center; padding: 30px 0; color: var(--t3); font-size: 13px; }
.lsb-sched-status { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; white-space: nowrap; }
.lsb-sched-status-prod { background: var(--green-lt); color: var(--green); }
.lsb-sched-status-idle { background: var(--bg); color: var(--t2); }
.lsb-sched-status-done  { background: #f1f5f9; color: var(--t3); }
.lsb-sched-status-pause { background: #eef2f7; color: #64748b; }
/* Highlight ทั้งแถวสำหรับ WO ที่กำลัง Producing อยู่ (ตาม lsbFlagInfo) ให้เห็นชัดกว่าแค่สี badge เล็กๆ ในคอลัมน์ Flag —
   :hover selector เฉพาะแยกไว้เพราะ .inv-table tbody tr:hover td (สี hover ปกติ) specificity สูงกว่าเฉยๆ .lsb-sched-row-prod td
   เฉยๆ ไม่งั้นพอเอาเมาส์ชี้แถวที่ highlight ไว้จะโดนสี hover ทับจนมองไม่เห็น highlight ระหว่างชี้อยู่ */
.lsb-sched-row-prod td { background: var(--blue-lt); }
.inv-table tbody tr.lsb-sched-row-prod:hover td { background: var(--blue-lt); }
.lsb-sched-progress    { display: flex; align-items: center; gap: 8px; min-width: 90px; }
.lsb-sched-progress-bg   { flex: 1; height: 6px; background: var(--border); border-radius: 4px; overflow: hidden; }
.lsb-sched-progress-fill { height: 100%; background: var(--blue); border-radius: 4px; }
.lsb-sched-progress span { font-size: 12px; font-weight: 700; color: var(--text); white-space: nowrap; }

/* ───── TABLE ───── */
.inv-table { width: 100%; border-collapse: collapse; }
.inv-table thead { background: #f8f9fc; }
.inv-table th {
    padding: 9px 14px; text-align: left; font-size: 11px; font-weight: 700;
    color: var(--t2); letter-spacing: .05em; text-transform: uppercase;
    border-bottom: 1px solid var(--border); white-space: nowrap;
    user-select: none;
}
.inv-table th.sortable { cursor: pointer; }
.inv-table th.sortable:hover { color: var(--blue); }
.inv-table td {
    padding: 10px 14px; border-bottom: 1px solid #f4f4f7;
    vertical-align: middle; font-size: 13px;
}
.inv-table tbody tr { transition: background .1s; cursor: default; }
.inv-table tbody tr:hover td { background: #fafbff; }
.inv-table tbody tr:last-child td { border-bottom: none; }
.mono { font-family: ui-monospace, monospace; font-size: 14px; color: var(--t2); }
.part-nm { font-weight: 600; font-size: 13px; color: var(--navy); }
.num-ok  { font-weight: 700; color: var(--green); }
.num-bad { font-weight: 700; color: var(--red); }
.text-end-td { text-align: right; }

/* ───── PAGINATION ───── */
.pag-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 18px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 10px;
}
.pag-info { font-size: 12px; color: var(--t2); }
.pag-btns { display: flex; align-items: center; gap: 6px; }
.pag-btn {
    padding: 6px 12px; border: 1px solid var(--border); border-radius: 8px;
    font-size: 12px; font-weight: 600; background: #fff; color: var(--text);
    cursor: pointer; font-family: inherit; transition: .15s; height: 32px;
}
.pag-btn:hover:not(:disabled) { background: var(--blue); color: #fff; border-color: var(--blue); }
.pag-btn:disabled { opacity: .4; cursor: not-allowed; }
.pag-num-btn {
    width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border);
    font-size: 13px; font-weight: 600; background: #fff; color: var(--text);
    cursor: pointer; font-family: inherit; transition: .15s;
    display: flex; align-items: center; justify-content: center; padding: 0;
}
.pag-num-btn:hover:not(.active) { border-color: var(--blue); color: var(--blue); }
.pag-num-btn.active { background: var(--blue); color: #fff; border-color: var(--blue); cursor: default; }

/* ───── EDIT BUTTON ───── */
.btn-edit {
    padding: 5px 12px; border: 1.5px solid var(--blue); border-radius: 7px;
    font-size: 11px; font-weight: 700; color: var(--blue); background: var(--blue-lt);
    cursor: pointer; font-family: inherit; transition: .15s;
}
.btn-edit:hover { background: var(--blue); color: #fff; }

/* ───── MODAL ───── */
.modal-content { border-radius: 14px; border: none; }
.modal-header { border-bottom: 1px solid var(--border); padding: 16px 20px; }
.modal-title { font-size: 15px; font-weight: 700; color: var(--navy); }
.modal-body  { padding: 20px; }
.modal-footer { border-top: 1px solid var(--border); padding: 12px 20px; }
.form-label-sm { font-size: 12px; font-weight: 600; color: var(--t2); margin-bottom: 5px; display: block; }
.form-ctrl {
    width: 100%; padding: 9px 12px; border: 1px solid var(--border); border-radius: 8px;
    font-size: 13px; outline: none; font-family: inherit; color: var(--text); transition: border-color .15s;
}
.form-ctrl:focus { border-color: var(--blue); }
.btn-cancel {
    padding: 8px 18px; border: 1px solid var(--border); border-radius: 8px;
    font-size: 13px; font-weight: 600; color: var(--t2); background: #fff;
    cursor: pointer; font-family: inherit; transition: .15s;
}
.btn-cancel:hover { background: #f8f9fc; }
.btn-save {
    padding: 8px 18px; background: var(--blue); color: #fff;
    border: none; border-radius: 8px; font-size: 13px; font-weight: 600;
    cursor: pointer; font-family: inherit; transition: background .15s;
}
.btn-save:hover { background: #1456d4; }

/* ───── RESPONSIVE ───── */
@@media (max-width: 768px) {
    .stat-grid { grid-template-columns: repeat(2,1fr); }
    .wb-stats  { display: none; }
}
@@media (max-width: 480px) {
    .stat-grid { grid-template-columns: 1fr; }
}

.badge-type {
    padding: 3px 9px; border-radius: 5px;
    font-size: 11px; font-weight: 600; display: inline-block; white-space: nowrap;
}
.badge-material { background: #e8f0ff; color: #1a6fff; border: 1px solid #c7d9ff; }
.badge-assembly  { background: #f5f3ff; color: #7c3aed; border: 1px solid #ddd6fe; }
.badge-figure    { background: #ecfeff; color: #0891b2; border: 1px solid #a5f3fc; }
.badge-spare     { background: #fff7ed; color: #ea580c; border: 1px solid #fed7aa; }
.badge-default   { background: #f0f2f5; color: #475569; border: 1px solid #e2e8f0; }

/* ───── TYPE FILTER BAR ───── */
.type-filter-bar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 16px; flex-wrap: wrap; gap: 10px;
}
.type-btns { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.type-btn {
    padding: 7px 15px; border: 1.5px solid var(--border); border-radius: 20px;
    font-size: 12px; font-weight: 600; color: var(--t2); background: #fff;
    cursor: pointer; font-family: inherit; transition: .15s;
    display: flex; align-items: center; gap: 6px;
}
.type-btn:hover { border-color: var(--blue); color: var(--blue); }
.type-btn.active { background: var(--blue); color: #fff; border-color: var(--blue); }
.type-btn.active .type-dot { background: rgba(255,255,255,.9) !important; }
.type-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }

/* ───── TYPE CARDS ───── */
.tc {
    background: #fff; border: 1.5px solid var(--border); border-radius: 16px;
    padding: 18px 18px 14px; position: relative; overflow: hidden;
    cursor: pointer; transition: transform .2s, box-shadow .2s, border-color .2s;
}
.tc:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,.09); z-index: 5; }
.tc.tc-selected { box-shadow: 0 4px 18px rgba(0,0,0,.1); }
.tc-corner {
    position: absolute; top: 0; right: 0; width: 80px; height: 80px;
    border-radius: 0 16px 0 80px; opacity: .09; pointer-events: none;
}
.tc-icon-wrap {
    width: 54px; height: 54px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; flex-shrink: 0; position: relative; z-index: 1;
}
.tc-label  { font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 4px; }
.tc-count  { font-size: 18px; font-weight: 700; color: #0f172a; line-height: 1; margin-bottom: 3px; }
.tc-sub    { font-size: 12px; color: #9ca3af; }
.tc-bar-bg { height: 6px; background: #f0f0f4; border-radius: 4px; overflow: hidden; margin-top: 14px; margin-bottom: 6px; }
.tc-bar-fill { height: 100%; border-radius: 4px; transition: width .5s ease; }

/* ───── STOCK LEVEL BAR ───── */
.stock-bar-wrap { display: flex; align-items: center; gap: 8px; min-width: 110px; }
.stock-bar-bg   { flex: 1; height: 6px; background: #f0f0f4; border-radius: 4px; overflow: hidden; }
.stock-bar-fill { height: 100%; border-radius: 4px; transition: width .4s ease; }
.stock-pct      { font-size: 11px; font-weight: 700; min-width: 32px; text-align: right; }

/* ───── REAL-TIME TABLES ───── */
.live-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    color: var(--green); background: var(--green-lt); border: 1px solid #a7f3d0;
    padding: 2px 8px 2px 6px; border-radius: 20px;
}
.live-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); animation: rtPulse 1.6s ease-in-out infinite; }
@@keyframes rtPulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(5,150,105,.5); }
    50%      { opacity: .6; box-shadow: 0 0 0 4px rgba(5,150,105,0); }
}
.rt-updated { font-size: 11px; color: var(--t3); }
.rt-table-wrap { max-height: 320px; overflow-y: auto; }
.rt-empty { text-align: center; padding: 32px 14px !important; color: var(--t3); font-size: 12px; }
.sess-badge {
    padding: 3px 9px; border-radius: 5px; font-size: 11px; font-weight: 600;
    display: inline-block; white-space: nowrap;
}
.sess-mono { font-family: ui-monospace, monospace; font-size: 12px; color: var(--t2); }
/* ── กดขยาย session row ดู transaction ย่อย (เอา pattern เดียวกับ Transactions.cshtml) ── */
.inv-table tbody tr.sum-row { cursor: pointer; }
.expand-btn {
    width: 24px; height: 24px; border-radius: 7px; border: 1.5px solid var(--border); background: #fff;
    display: flex; align-items: center; justify-content: center; cursor: pointer; transition: .15s;
    color: var(--t2); flex-shrink: 0;
}
.expand-btn:hover { border-color: var(--blue); color: var(--blue); background: var(--blue-lt); }
.expand-btn.open  { background: var(--blue); border-color: var(--blue); color: #fff; transform: rotate(90deg); }
.sub-row td { padding: 0 !important; border-bottom: none !important; }
.sub-content { overflow: hidden; max-height: 0; transition: max-height .3s ease; background: #f8faff; }
.sub-content.expanded { max-height: 3000px; }
.sub-inner { padding: 12px 18px 16px 44px; border-top: 1px solid var(--border); }
.sub-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.sub-table th {
    padding: 7px 12px; font-size: 10.5px; font-weight: 700; color: var(--t2); text-align: left;
    text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--border); background: #fafbfe;
}
.sub-table td { padding: 8px 12px; border-bottom: 1px solid #eef0f5; }
.sub-table tbody tr:last-child td { border-bottom: none; }
.sub-table tbody tr:hover td { background: #f5f8ff; }
/* ── LOCATION GROUP (จัดกลุ่ม lot ตาม location เดียวกันในแต่ละ part — Stock Summary expand row) เอามาจาก WorkOrderLots.cshtml ── */
.loc-group { background: #fff; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin: 10px 14px; }
.loc-group-head { display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: #f0f4ff; border-bottom: 1px solid var(--border); }
.loc-group-qty  { font-size: 11.5px; color: var(--t2); font-weight: 600; margin-left: auto; }
.loc-group-scroll { max-height: 340px; overflow-y: auto; }
.l3d-link { display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px; border-radius: 20px; border: 1px solid #c7d7fe; background: #fff; color: var(--blue); font-size: 11px; font-weight: 700; cursor: pointer; font-family: inherit; }
.l3d-link:hover { background: var(--blue-lt); }

/* ───── 3D LAYOUT ───── */
#l3dCard { --re: #d9724a; --re-lt: #f7d3c3; --pr: #2e9b58; --pr-lt: #c3ebce; --br: #3a70c6; --br-lt: #c6d9f5; }
.l3d-map-wrap { position: relative; display: inline-flex; align-items: center; }
.l3d-map-wrap > .bi-map { position: absolute; left: 9px; font-size: 11px; color: var(--blue); pointer-events: none; }
.l3d-map-sel { appearance: none; -webkit-appearance: none; border: 1px solid #c7d7fe; background: var(--blue-lt); color: var(--blue); font-size: 11.5px; font-weight: 700; font-family: inherit; padding: 3px 24px 3px 25px; border-radius: 20px; cursor: pointer; outline: none; }
.l3d-map-sel:hover, .l3d-map-sel:focus { border-color: var(--blue); }
.l3d-map-chev { position: absolute; right: 8px; font-size: 9px; color: var(--blue); pointer-events: none; }
.l3d-updated { font-size: 11px; font-weight: 500; color: var(--t3); }
.l3d-icon-btn { width: 36px; height: 36px; border: 1px solid var(--border); border-radius: 8px; background: #fff; color: var(--t2); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
.l3d-icon-btn:hover { color: var(--blue); border-color: var(--blue); }
.l3d-icon-btn.spin i { display: inline-block; animation: l3dSpin .9s linear infinite; }
@@keyframes l3dSpin { to { transform: rotate(360deg); } }
.l3d-body { display: flex; height: 600px; background: #fff; }
.l3d-body:fullscreen { height: 100vh; }
.l3d-viewport { position: relative; flex: 1; min-width: 0; overflow: hidden; background: #e8edf4; }
.l3d-canvas { display: block; touch-action: none; }
.l3d-labels { position: absolute; inset: 0; pointer-events: none; }
.l3d-toolbar { position: absolute; top: 12px; left: 12px; z-index: 3; display: flex; align-items: center; gap: 2px; padding: 4px; background: rgba(255,255,255,.92); border: 1px solid var(--border); border-radius: 10px; box-shadow: 0 2px 10px rgba(15,23,42,.08); }
.l3d-toolbar button { min-width: 30px; height: 30px; padding: 0 6px; border: none; background: transparent; border-radius: 7px; color: #334155; cursor: pointer; font-size: 14px; font-family: inherit; }
.l3d-toolbar button:hover { background: var(--blue-lt); color: var(--blue); }
.l3d-toolbar .l3d-tb-txt { font-size: 11px; font-weight: 800; }
.l3d-tb-txt[data-cat="RE"] { color: var(--re); } .l3d-tb-txt[data-cat="PR"] { color: var(--pr); } .l3d-tb-txt[data-cat="BR"] { color: var(--br); }
.l3d-tb-sep { width: 1px; height: 18px; background: var(--border); margin: 0 3px; }
.l3d-legend { position: absolute; left: 12px; bottom: 12px; z-index: 3; max-width: calc(100% - 24px); padding: 7px 10px; background: rgba(255,255,255,.92); border: 1px solid var(--border); border-radius: 10px; font-size: 11px; color: #334155; display: flex; flex-direction: column; gap: 4px; }
.l3d-legend:empty { display: none; }
.l3d-lg-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
.l3d-lg-row span { display: inline-flex; align-items: center; gap: 5px; font-weight: 600; }
.l3d-lg-row em { font-style: normal; color: var(--t2); }
.l3d-hint { position: absolute; right: 12px; bottom: 12px; z-index: 3; font-size: 11px; color: #475569; background: rgba(255,255,255,.8); padding: 4px 9px; border-radius: 8px; pointer-events: none; }
.l3d-dot { display: inline-block; width: 9px; height: 9px; border-radius: 3px; flex-shrink: 0; }
.l3d-sw { display: inline-block; width: 12px; height: 12px; border-radius: 3px; border: 1.5px solid; flex-shrink: 0; }
.l3d-sw[data-cat="RE"] { background: var(--re-lt); border-color: var(--re); }
.l3d-sw[data-cat="PR"] { background: var(--pr-lt); border-color: var(--pr); }
.l3d-sw[data-cat="BR"] { background: var(--br-lt); border-color: var(--br); }
.l3d-loading { position: absolute; inset: 0; z-index: 4; display: none; align-items: center; justify-content: center; background: rgba(232,237,244,.55); }
.l3d-msg { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 10px 16px; font-size: 13px; color: var(--t2); display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 16px rgba(15,23,42,.08); }
.l3d-viewport > .l3d-msg { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); }
.l3d-tooltip { position: absolute; z-index: 5; display: none; pointer-events: none; max-width: 280px; background: rgba(15,23,42,.94); color: #e2e8f0; font-size: 12px; line-height: 1.45; padding: 8px 11px; border-radius: 9px; box-shadow: 0 6px 18px rgba(0,0,0,.2); }
.l3d-tooltip b { color: #fff; }
.l3d-tip-lot { font-family: ui-monospace, monospace; font-weight: 700; color: #93c5fd; }
.l3d-tip-sub { color: #94a3b8; font-size: 11px; }
.l3d-tip-row { margin-top: 3px; }
.l3d-tip-cat { font-size: 10.5px; font-weight: 700; padding: 1px 6px; border-radius: 10px; background: rgba(255,255,255,.12); }
.l3d-tooltip .l3d-dot { margin: 0 3px 0 6px; }

/* ป้ายใน scene (CSS2DRenderer) */
.l3d-tag { pointer-events: auto; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; padding: 3px 4px 3px 8px; border-radius: 20px; background: #fff; border: 1.5px solid; font-size: 11px; font-weight: 800; white-space: nowrap; box-shadow: 0 2px 8px rgba(15,23,42,.15); transition: transform .12s; user-select: none; }
.l3d-tag:hover { transform: scale(1.08); }
.l3d-tag .n { min-width: 20px; text-align: center; padding: 1px 6px; border-radius: 20px; color: #fff; font-size: 10.5px; }
.l3d-tag[data-cat="RE"] { border-color: var(--re); color: var(--re); } .l3d-tag[data-cat="RE"] .n { background: var(--re); }
.l3d-tag[data-cat="PR"] { border-color: var(--pr); color: var(--pr); } .l3d-tag[data-cat="PR"] .n { background: var(--pr); }
.l3d-tag[data-cat="BR"] { border-color: var(--br); color: var(--br); } .l3d-tag[data-cat="BR"] .n { background: var(--br); }
.l3d-tag.empty { opacity: .6; } .l3d-tag.empty .n { background: #cbd5e1 !important; }
.l3d-tag.sel { background: #0f172a; color: #fff; transform: scale(1.12); }
.l3d-labels.far .l3d-tag { font-size: 9px; gap: 3px; padding: 1px 2px 1px 5px; border-width: 1px; }
.l3d-labels.far .l3d-tag .n { min-width: 14px; padding: 0 4px; font-size: 9px; }
.l3d-bub { pointer-events: none; display: flex; flex-direction: column; align-items: center; line-height: 1.1; text-shadow: 0 1px 0 #fff, 0 0 4px #fff; }
.l3d-bub b { font-size: 11px; font-weight: 800; color: #0f172a; background: rgba(255,255,255,.9); border-radius: 10px; padding: 0 6px; box-shadow: 0 1px 4px rgba(15,23,42,.15); }
.l3d-bub .pn { display: none; font-size: 9.5px; font-weight: 700; color: #334155; margin-top: 1px; white-space: nowrap; }
.l3d-bub.hov .pn, .l3d-bub.foc .pn { display: block; }
.l3d-bub.hov, .l3d-bub.foc { z-index: 2; }
.l3d-bub.foc b { background: #0f172a; color: #fff; }
.l3d-bub.dim { opacity: .35; }
.l3d-bub-ico { display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fff 0, #94a3b8 70%); border: 1px solid #64748b; }
.l3d-room { pointer-events: none; font-size: 12px; font-weight: 700; color: #334155; text-align: center; max-width: 240px; line-height: 1.3; text-shadow: 0 1px 0 #fff, 0 0 6px rgba(255,255,255,.9); }
.l3d-room-big { font-size: 18px; letter-spacing: 2px; }
.l3d-mini { pointer-events: none; font-size: 10px; font-weight: 700; color: #64748b; background: rgba(255,255,255,.75); padding: 0 5px; border-radius: 4px; white-space: nowrap; }
.l3d-agv { color: #a16207; }

/* แผงข้างขวา */
.l3d-resizer { width: 7px; flex-shrink: 0; cursor: col-resize; background: var(--border); position: relative; touch-action: none; transition: background .15s; }
.l3d-resizer::after { content: ''; position: absolute; top: 50%; left: 2px; width: 3px; height: 34px; transform: translateY(-50%); border-radius: 2px; background: #94a3b8; }
.l3d-resizer:hover, .l3d-resizer.drag { background: #bfd4ff; }
.l3d-body.resizing { cursor: col-resize; user-select: none; }
.l3d-body.resizing .l3d-viewport { pointer-events: none; }
.l3d-lots-scroll { overflow-x: auto; }
.l3d-lots td, .l3d-lots th { white-space: nowrap; }
.l3d-panel { width: 340px; flex-shrink: 0; overflow-y: auto; padding: 14px; font-size: 12.5px; background: #fafbfd; }
.l3d-p-title { font-weight: 700; color: var(--navy); margin-bottom: 8px; }
.l3d-p-hint { color: var(--t2); font-size: 11.5px; margin: 10px 0 4px; }
.l3d-p-empty { color: var(--t3); text-align: center; padding: 24px 8px; }
.l3d-p-warn { font-size: 11.5px; color: #92400e; background: var(--amber-lt); border: 1px solid #fde68a; border-radius: 8px; padding: 6px 10px; margin-bottom: 8px; }
.l3d-p-group { display: flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 700; color: var(--t2); text-transform: uppercase; letter-spacing: .3px; margin: 14px 0 6px; }
.l3d-stats { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; margin-bottom: 10px; }
.l3d-stats > div { grid-column: span 2; min-width: 0; background: #fff; border: 1px solid var(--border); border-radius: 9px; padding: 7px 8px; font-size: 10.5px; color: var(--t2); }
.l3d-stats > div.w { grid-column: span 3; }
.l3d-stats > .l3d-st-res span { color: var(--amber); }
.l3d-stats > .l3d-st-av span { color: var(--green); }
.l3d-stats span { display: block; font-size: 16px; font-weight: 700; color: var(--navy); line-height: 1.2; }
.l3d-zrow { width: 100%; display: flex; align-items: center; gap: 8px; padding: 6px 8px; border: 1px solid transparent; border-radius: 8px; background: none; cursor: pointer; font-family: inherit; text-align: left; }
.l3d-zrow:hover { background: #fff; border-color: var(--border); }
.l3d-zrow.empty { opacity: .55; }
.l3d-zcode { width: 52px; font-weight: 800; font-size: 12px; }
.l3d-zcode[data-cat="RE"] { color: var(--re); } .l3d-zcode[data-cat="PR"] { color: var(--pr); } .l3d-zcode[data-cat="BR"] { color: var(--br); }
.l3d-zbar { flex: 1; height: 6px; background: #eef0f4; border-radius: 4px; overflow: hidden; }
.l3d-zbar i { display: block; height: 100%; border-radius: 4px; }
.l3d-zbar i[data-cat="RE"] { background: var(--re); } .l3d-zbar i[data-cat="PR"] { background: var(--pr); } .l3d-zbar i[data-cat="BR"] { background: var(--br); }
.l3d-zn { width: 48px; text-align: right; font-weight: 700; color: var(--navy); font-size: 12px; }
.l3d-unmapped { margin-top: 14px; border-top: 1px dashed var(--border); padding-top: 10px; }
.l3d-unmapped summary { cursor: pointer; font-size: 11.5px; font-weight: 700; color: var(--t2); }
.l3d-unmapped summary span { background: #eef0f4; border-radius: 10px; padding: 0 7px; margin-left: 4px; }
.l3d-unm-row { display: flex; justify-content: space-between; padding: 4px 8px; font-size: 11.5px; color: var(--t2); }
.l3d-p-nav { display: flex; justify-content: space-between; margin-bottom: 10px; }
.l3d-back { border: 1px solid var(--border); background: #fff; border-radius: 8px; padding: 4px 10px; font-size: 12px; font-weight: 600; color: #334155; cursor: pointer; font-family: inherit; }
.l3d-back:hover { color: var(--blue); border-color: var(--blue); }
.l3d-zhead { border-left: 4px solid; padding: 2px 0 2px 10px; margin-bottom: 10px; }
.l3d-zhead[data-cat="RE"] { border-color: var(--re); } .l3d-zhead[data-cat="PR"] { border-color: var(--pr); } .l3d-zhead[data-cat="BR"] { border-color: var(--br); }
.l3d-zhead-code { font-size: 20px; font-weight: 800; color: var(--navy); line-height: 1.1; }
.l3d-zhead-name { font-size: 12.5px; font-weight: 600; color: #334155; }
.l3d-zhead-meta { font-size: 11.5px; color: var(--t2); margin-top: 2px; }
.l3d-part { background: #fff; border: 1px solid var(--border); border-radius: 10px; margin-bottom: 6px; overflow: hidden; }
.l3d-part.open { border-color: #a9c4ff; box-shadow: 0 2px 10px rgba(26,111,255,.08); }
.l3d-part.miss { opacity: .45; }
.l3d-part-head { width: 100%; display: flex; align-items: center; gap: 8px; padding: 8px 10px; border: none; background: none; cursor: pointer; text-align: left; font-family: inherit; }
.l3d-part-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.l3d-part-no { font-weight: 700; color: var(--navy); font-size: 12.5px; }
.l3d-part-desc { color: var(--t2); font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.l3d-part-qty { text-align: right; font-size: 11px; color: var(--t2); white-space: nowrap; }
.l3d-part-qty b { color: var(--navy); font-size: 12.5px; }
.l3d-part-qty small { display: block; font-size: 10.5px; }
.l3d-chev { color: var(--t3); font-size: 11px; transition: transform .15s; }
.l3d-part.open .l3d-chev { transform: rotate(180deg); }
.l3d-part-body { padding: 4px 10px 10px; border-top: 1px solid #eef0f4; }
.l3d-lots { width: 100%; border-collapse: collapse; font-size: 11.5px; }
.l3d-lots th { font-size: 10px; text-transform: uppercase; color: var(--t3); font-weight: 700; padding: 5px 4px; text-align: left; }
.l3d-lots td { padding: 5px 4px; border-top: 1px solid #f1f3f7; }
.l3d-lots .mono { font-family: ui-monospace, monospace; font-size: 11px; }
.l3d-lot { cursor: pointer; }
.l3d-lot:hover td { background: #f5f8ff; }
.l3d-lot.focus td { background: #e8f0ff; }
.l3d-lot.miss { opacity: .4; }
.l3d-lot-loc { color: var(--t2); font-size: 10.5px; }
.l3d-link-btn { margin-top: 8px; border: none; background: none; color: var(--blue); font-weight: 700; font-size: 12px; cursor: pointer; padding: 0; font-family: inherit; }
.l3d-link-btn:hover { text-decoration: underline; }
[data-theme="dark"] .l3d-body, [data-theme="dark"] .l3d-panel { background: #172131; }
[data-theme="dark"] .l3d-toolbar, [data-theme="dark"] .l3d-legend, [data-theme="dark"] .l3d-msg { background: rgba(30,41,59,.94); color: var(--text); }
[data-theme="dark"] .l3d-toolbar button { color: var(--text); }
[data-theme="dark"] .l3d-hint { background: rgba(30,41,59,.85); color: var(--t2); }
[data-theme="dark"] .l3d-stats > div, [data-theme="dark"] .l3d-part, [data-theme="dark"] .l3d-back,
[data-theme="dark"] .l3d-icon-btn, [data-theme="dark"] .l3d-link { background: #1e293b; color: var(--text); }
[data-theme="dark"] .l3d-zrow:hover { background: #1e293b; }
[data-theme="dark"] .l3d-map-sel { border-color: #2c4a7a; }
[data-theme="dark"] .l3d-zbar, [data-theme="dark"] .l3d-unmapped summary span { background: #253347; }
[data-theme="dark"] .l3d-part-body, [data-theme="dark"] .l3d-lots td { border-color: #253347; }
[data-theme="dark"] .l3d-lot:hover td, [data-theme="dark"] .l3d-lot.focus td { background: #1e3553; }
@@media (max-width: 992px) {
    .l3d-body { flex-direction: column; height: auto; }
    .l3d-viewport { height: 460px; flex: none; }
    .l3d-resizer { display: none; }
    .l3d-panel { width: auto !important; border-left: none; border-top: 1px solid var(--border); max-height: 420px; }
    .l3d-hint { display: none; }
}
.wo-num { font-family: ui-monospace, monospace; font-weight: 700; font-size: 13px; color: var(--navy); }
.loc-type-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 9px 2px 7px; border-radius: 20px; font-size: 11px; font-weight: 700;
    white-space: nowrap; line-height: 1.6;
}
.sess-thumb-wrap { position: relative; display: inline-block; }
.sess-thumb {
    width: 34px; height: 34px; object-fit: cover; border-radius: 6px;
    border: 1px solid var(--border); cursor: zoom-in; display: block;
}
.sess-thumb-badge {
    position: absolute; bottom: -4px; right: -4px; background: var(--blue); color: #fff;
    font-size: 9px; font-weight: 700; padding: 1px 4px; border-radius: 8px; line-height: 1.3;
}
.pct-bar-wrap  { display: flex; align-items: center; gap: 8px; }
.pct-bar-track { width: 60px; height: 7px; background: var(--border); border-radius: 20px; overflow: hidden; flex-shrink: 0; }
.pct-bar-fill  { height: 100%; border-radius: 20px; }
.pct-bar-label { font-size: 11px; font-weight: 700; white-space: nowrap; min-width: 38px; }

/* ───── DASHBOARD TABS ───── */
.dash-tabs { display: flex; gap: 8px; margin-bottom: 16px; }
.dash-tab-btn {
    padding: 9px 18px; border-radius: 10px; border: 1px solid var(--border); background: #fff;
    font-size: 13px; font-weight: 700; color: var(--t2); cursor: pointer; font-family: inherit;
    display: flex; align-items: center; gap: 7px; transition: .15s;
}
.dash-tab-btn:hover { border-color: var(--blue); color: var(--blue); }
.dash-tab-btn.active { background: var(--blue); border-color: var(--blue); color: #fff; }

/* ───── LINE STATUS BOARD (ใช้ CSS var ชุดเดียวกับทั้งหน้า — flip เอง ตาม [data-theme] ที่ตั้งไว้ที่ :root ด้านบน) ───── */
.lsb-wrap {
    background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 20px; color: var(--text);
    display: flex; flex-direction: column; height: calc(100vh - 260px); min-height: 500px; overflow: hidden;
}
.lsb-wrap:fullscreen { border-radius: 0; padding: 24px; overflow-y: auto; background: var(--bg); height: 100vh; }
.lsb-fullscreen-btn {
    flex-shrink: 0; width: 34px; height: 34px; border-radius: 8px;
    border: 1px solid var(--border); background: var(--bg); color: var(--t2); cursor: pointer;
    display: flex; align-items: center; justify-content: center; transition: .15s; font-size: 14px;
}
.lsb-fullscreen-btn:hover { border-color: var(--blue); color: var(--blue); }
.lsb-filter-bar {
    display: flex; align-items: center; gap: 8px;
    background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 5px 10px;
}
.lsb-filter-sep { width: 1px; height: 16px; background: var(--border); flex-shrink: 0; }
.lsb-mode-select {
    background: transparent; border: none; color: var(--text); font-family: inherit;
    font-size: 11px; font-weight: 700; cursor: pointer; padding: 0; outline: none;
}

.lsb-line-dd-wrap { position: relative; }
.lsb-line-dd-trigger {
    display: flex; align-items: center; gap: 6px; background: transparent; border: none;
    color: var(--text); font-family: inherit; font-size: 11px; cursor: pointer; padding: 0; white-space: nowrap;
}
.lsb-line-dd-menu {
    position: absolute; top: calc(100% + 6px); right: 0; z-index: 50; width: 210px; max-height: 280px; overflow-y: auto;
    background: var(--card); border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.25); padding: 6px;
}
.lsb-line-dd-item {
    display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 6px;
    font-size: 12px; color: var(--text); cursor: pointer;
}
.lsb-line-dd-item:hover { background: var(--bg); }
.lsb-line-dd-actions { display: flex; justify-content: space-between; padding: 6px 8px 2px; border-top: 1px solid var(--border); margin-top: 4px; }
.lsb-line-dd-action-btn { background: none; border: none; color: var(--blue); font-size: 11px; font-weight: 700; cursor: pointer; font-family: inherit; padding: 2px 4px; }
.lsb-line-dd-empty { padding: 12px; text-align: center; color: var(--t3); font-size: 11px; }
/* flex แทน grid เพราะต้องปรับสัดส่วนซ้าย/ขวาได้ด้วยการลาก — .lsb-panel ฝั่งซ้ายคุม flex-basis เอง (ตั้งค่าผ่าน JS ตอนลาก),
   ฝั่งขวาใช้ flex:1 กินพื้นที่ที่เหลือเสมอ */
.lsb-grid { display: flex; gap: 0; clear: both; flex: 1; min-height: 0; }
#lsbPanelLeft  { flex: 0 0 60%; }
#lsbPanelRight { flex: 1 1 0; }
.lsb-resizer {
    width: 6px; flex-shrink: 0; margin: 0 14px; cursor: col-resize; border-radius: 3px;
    background: var(--border); transition: background .15s;
}
.lsb-resizer:hover, .lsb-resizer.lsb-resizer-active { background: var(--blue); }
@@media (max-width: 1200px) {
    .lsb-grid { flex-direction: column; }
    #lsbPanelLeft { flex-basis: auto !important; }
    .lsb-resizer { display: none; }
    /* จอแคบ: panel ซ้าย/ขวาเรียงต่อกันแนวตั้ง (flex-basis:auto ด้านบน) เนื้อหาเลยสูงเกิน .lsb-wrap ที่ยังสูงคงที่ (calc(100vh-260px))
       + overflow:hidden จากค่า default ได้ — เนื้อหาที่เกินเลยโดนตัดทิ้งไปเฉยๆ ดูเหมือนการ์ดหายไปครึ่งนึง ไม่มีทาง scroll ดูส่วนที่เหลือ
       เปลี่ยนให้ .lsb-wrap เองเลื่อนได้แทน (auto height ตามเนื้อหา จำกัดเพดานไว้กันเกินจอ) แทนที่จะหวังพึ่ง scroll ของ .lsb-card-grid
       ข้างในอย่างเดียว (ซึ่งใช้ไม่ได้ผลตอน parent เป็น flex-basis:auto ไม่ใช่ความสูงคงที่ที่จะ "min-height:0" หดให้ได้) */
    .lsb-wrap { height: auto; max-height: calc(100vh - 140px); min-height: 0; overflow-y: auto; }
}
.lsb-panel { display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; }
.lsb-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 14px;
}
.lsb-title { font-size: 19px; font-weight: 800; letter-spacing: .03em; color: var(--navy); }
.lsb-subtitle { font-size: 11px; letter-spacing: .08em; color: var(--t3); margin-top: 3px; text-transform: uppercase; }
.lsb-clock-wrap { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: var(--green); letter-spacing: .05em; white-space: nowrap; }
.lsb-live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); animation: lsbPulse 1.6s ease-in-out infinite; }
@@keyframes lsbPulse { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }
.lsb-clock { font-family: ui-monospace, monospace; font-size: 19px; font-weight: 800; color: var(--navy); margin-left: 4px; }
.lsb-updated { font-size: 12px; color: var(--t3); white-space: nowrap; }
.lsb-refresh-countdown { font-size: 11px; font-weight: 600; color: var(--t3); white-space: nowrap; font-family: ui-monospace, monospace; }
.lsb-refresh-interval-select {
    background: #fff; border: 1px solid var(--border); border-radius: 6px; color: var(--t2);
    font-family: inherit; font-size: 11px; font-weight: 600; cursor: pointer; padding: 3px 6px; outline: none;
}

.lsb-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; font-size: 11px; font-weight: 700; letter-spacing: .04em; color: var(--t2); margin-bottom: 14px; text-transform: uppercase; }
.lsb-legend-item { display: flex; align-items: center; gap: 6px; }
.lsb-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
.lsb-legend-stat { margin-left: auto; color: var(--text); }

.lsb-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); grid-auto-rows: min-content; gap: 10px; overflow-y: auto; flex: 1; min-height: 0; padding-right: 4px; align-content: start; }
.lsb-card { border-radius: 10px; padding: 12px; border: 1.5px solid; cursor: pointer; }
.lsb-card-green { background: var(--green-lt); border-color: var(--green); }
.lsb-card-red   { background: var(--red-lt);   border-color: var(--red);   animation: lsbCardBlinkRed   1.2s ease-in-out infinite; }
.lsb-card-gray  { background: var(--bg);       border-color: var(--border); }
.lsb-card-amber { background: var(--amber-lt); border-color: var(--amber); animation: lsbCardBlinkAmber 1.2s ease-in-out infinite; }
/* Order Late/Called ต้องเด่นมองง่ายจากระยะไกล (จอ wallboard) — pulse ทั้ง box-shadow (glow วงแหวน) และความเข้มพื้นหลัง/เส้นขอบสลับกัน */
@@keyframes lsbCardBlinkRed {
    0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,.55); background: var(--red-lt); }
    50%      { box-shadow: 0 0 0 8px rgba(239,68,68,0);  background: rgba(239,68,68,.28); }
}
@@keyframes lsbCardBlinkAmber {
    0%, 100% { box-shadow: 0 0 0 0 rgba(245,158,11,.55); background: var(--amber-lt); }
    50%      { box-shadow: 0 0 0 8px rgba(245,158,11,0);  background: rgba(245,158,11,.28); }
}
.lsb-card-top { display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 800; color: var(--navy); margin-bottom: 4px; }
.lsb-card-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.lsb-card-mo { font-size: 19px; font-weight: 800; color: var(--text); font-family: ui-monospace, monospace; margin-bottom: 2px; }
.lsb-card-model { font-size: 13px; font-weight: 600; color: var(--t2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 8px; }
/* highlight เลข WO ตรงๆ (Present หรือ Next แล้วแต่ตัวไหนตรง) แทนที่จะขึ้น badge แยกบรรทัด — โชว์เฉพาะตอนมี Order (จาก
   /orders/pre-shipment, ตัดที่ยกเลิกออกแล้ว) ที่ woNo ตรงกับ WO ตัวนั้นเป๊ะ ถ้า Order เป็นของ WO อื่นที่ไม่โชว์บนบอร์ดนี้ ปล่อยไว้เหมือนเดิม */
/* พื้นทึบ ไม่ใช้ amber-lt/red-lt เพราะการ์ดที่ severity ตรงกันเองก็มีพื้นหลังโทนอ่อนของสีนั้นอยู่แล้ว ใช้สีเดียวกันจะกลืนมองไม่เห็น —
   เหลือง = order นั้นยัง Called (ไม่ late), แดง = order นั้น late แล้ว (isLateNow) ตรงกับ severity สี Order Called/Order Late */
.lsb-order-hl      { color: #fff; background: var(--amber); border-radius: 4px; padding: 0 4px; }
.lsb-order-hl-late { color: #fff; background: var(--red);   border-radius: 4px; padding: 0 4px; }
.lsb-card-ach-row { display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
.lsb-card-bar-bg { height: 5px; background: var(--border); border-radius: 4px; overflow: hidden; }
.lsb-card-bar-fill { height: 100%; border-radius: 4px; }
.lsb-card-green .lsb-card-bar-fill { background: var(--green); }
.lsb-card-red   .lsb-card-bar-fill { background: var(--red); }
.lsb-card-gray  .lsb-card-bar-fill { background: var(--t3); }
.lsb-card-amber .lsb-card-bar-fill { background: var(--amber); }

.lsb-q-colhead {
    display: grid; grid-template-columns: 30px 1fr 92px 92px 70px 70px 52px 86px; align-items: center; gap: 10px;
    padding: 0 12px 8px; font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
    color: var(--t3); flex-shrink: 0;
}
.lsb-q-colhead-hint { cursor: help; border-bottom: 1px dotted var(--t3); width: fit-content; }
.lsb-queue-wrap { display: flex; flex-direction: column; gap: 6px; overflow-y: auto; flex: 1; min-height: 0; padding-right: 4px; }
.lsb-q-row {
    display: grid; grid-template-columns: 30px 1fr 92px 92px 70px 70px 52px 86px; align-items: center; gap: 10px;
    background: var(--bg); border: 1px solid var(--border); border-left: 3px solid var(--border); border-radius: 8px; padding: 10px 12px;
    flex-shrink: 0;
}
.lsb-q-row.lsb-q-called { border-left-color: var(--amber); background: var(--amber-lt); animation: lsbCardBlinkAmber 1.2s ease-in-out infinite; }
.lsb-q-row.lsb-q-late   { border-left-color: var(--red);   background: var(--red-lt);   animation: lsbCardBlinkRed   1.2s ease-in-out infinite; }
.lsb-q-row.lsb-q-flag   { border-left-color: var(--blue);  background: var(--blue-lt); }
.lsb-q-rank {
    width: 26px; height: 26px; border-radius: 6px; background: var(--border); color: var(--t2);
    font-weight: 800; font-size: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.lsb-q-row.lsb-q-called .lsb-q-rank { background: var(--amber); color: #1a1608; }
.lsb-q-row.lsb-q-late   .lsb-q-rank { background: var(--red);   color: #fff; }
.lsb-q-row.lsb-q-flag   .lsb-q-rank { background: var(--blue);  color: #fff; }
.lsb-q-mo  { display: flex; align-items: baseline; gap: 8px; min-width: 0; }
.lsb-q-line   { font-size: 13px; font-weight: 700; color: var(--t2); white-space: nowrap; flex-shrink: 0; }
.lsb-q-mo-big { font-size: 18px; font-weight: 800; color: var(--navy); font-family: ui-monospace, monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lsb-q-late-sub { font-size: 11px; font-weight: 700; color: var(--red); margin-top: 2px; }
.lsb-q-metric { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.lsb-q-bar-bg { height: 5px; background: var(--border); border-radius: 4px; overflow: hidden; }
.lsb-q-bar-fill { height: 100%; border-radius: 4px; }
.lsb-q-pct { font-size: 11px; font-weight: 700; color: var(--text); }
.lsb-q-cycle { font-size: 13px; font-weight: 800; color: var(--navy); text-align: right; }
.lsb-q-tts { font-size: 13px; font-weight: 800; color: var(--navy); text-align: right; }
.lsb-q-tts.lsb-q-tts-stockout { color: var(--red); }
.lsb-q-stacked-tts { font-size: 13px; font-weight: 800; color: var(--navy); margin-left: auto; }
.lsb-q-stacked-tts.lsb-q-tts-stockout { color: var(--red); }

/* ── โหมด "Stacked" — เรียงแท่ง Input/Output/Production OH ทับกันเป็นแนวตั้งแทนเรียงข้างกัน ให้เทียบด้วยตาง่ายขึ้นตอนพื้นที่แคบ ── */
/* ต้องคืน align-items เป็น stretch เอง เพราะ .lsb-q-row (base class เดียวกัน) ตั้ง align-items:center ไว้ให้ layout แบบ grid เดิม —
   ถ้าไม่ override ตรงนี้ แถว metric ในโหมด column จะหด (shrink-to-fit) ตาม content แทนที่จะยืดเต็มความกว้าง ทำให้แท่ง flex:1 ไม่มีที่ให้โต */
.lsb-q-row-stacked { display: flex; flex-direction: column; align-items: stretch; gap: 10px; }
.lsb-q-stacked-top { display: flex; align-items: center; gap: 10px; }
.lsb-q-stacked-metric { display: flex; align-items: center; gap: 10px; }
.lsb-q-stacked-label {
    width: 100px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
    color: var(--text); flex-shrink: 0; white-space: nowrap;
}
.lsb-q-bar-lg { flex: 1; height: 8px; }
.lsb-q-stacked-pct { width: 52px; text-align: right; font-size: 13px; font-weight: 800; color: var(--navy); flex-shrink: 0; }

.lsb-empty { grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--t3); font-size: 12px; }

/* ── DARK MODE ── */
[data-theme="dark"] {
    --navy:     #f1f5f9;
    --text:     #cbd5e1;
    --t2:       #94a3b8;
    --t3:       #64748b;
    --border:   #334155;
    --card:     #1e293b;
    --bg:       #0f172a;
    --blue-lt:  #1e3553;
    --green-lt: #052e1c;
    --amber-lt: #2d1a00;
    --red-lt:   #2d0a0a;
    --purple-lt:#2e1065;
}
[data-theme="dark"] body                        { background: #0f172a !important; }
[data-theme="dark"] .inv-table thead            { background: #162032; }
[data-theme="dark"] .inv-table tbody tr:hover td{ background: #1a2a3e; }
[data-theme="dark"] .inv-table td               { border-bottom-color: #253347; }
[data-theme="dark"] .type-btn                   { background: #1e293b; color: var(--t2); border-color: var(--border); }
[data-theme="dark"] .tc                         { background: #1e293b; border-color: var(--border); }
[data-theme="dark"] .tc-count                   { color: var(--navy); }
[data-theme="dark"] .tc-bar-bg                  { background: #253347; }
[data-theme="dark"] .stock-bar-bg               { background: #253347; }
[data-theme="dark"] .stock-card-bar             { background: #253347; }
[data-theme="dark"] .fsel,
[data-theme="dark"] .filter-input               { background: #1e293b; color: var(--text); border-color: var(--border); }
[data-theme="dark"] .pag-btn                    { background: #1e293b; color: var(--text); border-color: var(--border); }
[data-theme="dark"] .view-toggle                { background: #162032; }
[data-theme="dark"] .view-btn.active            { background: #0f172a; }
[data-theme="dark"] .stock-card                 { background: #1e293b; border-color: var(--border); }
[data-theme="dark"] .stock-card-footer          { border-top-color: #253347; }
[data-theme="dark"] .btn-cancel                 { background: #1e293b; border-color: var(--border); }
[data-theme="dark"] .badge-material             { background: #1e3553; border-color: #2d4e8c; }
[data-theme="dark"] .badge-assembly             { background: #2a1e4e; border-color: #4c3a8c; color: #a78bfa; }
[data-theme="dark"] .badge-figure               { background: #0e3040; border-color: #1a5a7a; color: #67e8f9; }
[data-theme="dark"] .badge-spare                { background: #3d1f00; border-color: #7c3c00; color: #fb923c; }
[data-theme="dark"] .badge-default              { background: #253347; border-color: #334155; color: #94a3b8; }
[data-theme="dark"] select option               { background: #1e293b; color: var(--text); }
[data-theme="dark"] .welcome-banner h2          { color: #0f172a; }
[data-theme="dark"] .welcome-banner p           { color: #334155; }
[data-theme="dark"] .live-badge                 { background: #052e1c; border-color: #0d5c3a; }
[data-theme="dark"] .dash-tab-btn               { background: #1e293b; border-color: var(--border); color: var(--t2); }
[data-theme="dark"] .dash-tab-btn.active        { background: var(--blue); color: #fff; }

/* ── LINE STATUS BOARD: dark mode ให้เข้มกว่า dark theme ปกติของแอป (ดำสนิทแบบจอทีวีหน้าไลน์ อ่านง่ายกว่า var(--card) ที่เป็นกรมท่า) ── */
[data-theme="dark"] .lsb-wrap             { background: #0a0e17; }
[data-theme="dark"] .lsb-wrap:fullscreen  { background: #0a0e17; }
[data-theme="dark"] .lsb-fullscreen-btn   { background: #111827; border-color: #1e293b; }
[data-theme="dark"] .lsb-filter-bar       { background: #111827; border-color: #1e293b; }
[data-theme="dark"] .lsb-header           { border-bottom-color: #1e293b; }
[data-theme="dark"] .lsb-card-gray        { background: #1a1f2b; border-color: #334155; }
[data-theme="dark"] .lsb-card-bar-bg      { background: rgba(255,255,255,.08); }
[data-theme="dark"] .lsb-q-row            { background: #111827; border-color: #1e293b; border-left-color: #1e293b; }
[data-theme="dark"] .lsb-q-rank           { background: #1e293b; }
[data-theme="dark"] .lsb-q-bar-bg         { background: rgba(255,255,255,.08); }
</style>

