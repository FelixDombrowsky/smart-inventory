<!-- ══════ TAB: DESIGN ══════ -->
<div class="tab-pane" id="tab-design">

    <!-- LIST MODE -->
    <div id="designList">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <div style="font-size:18px;font-weight:700;color:var(--navy)">Saved Layouts</div>
            <button class="btn-primary" onclick="openCreateMode()" style="display:flex;align-items:center;gap:6px">
                <i class="bi bi-plus-lg"></i> New Layout
            </button>
        </div>
        <div id="layoutListContainer" class="layout-grid">
            <div style="text-align:center;color:var(--t3);padding:40px;grid-column:1/-1">
                <i class="bi bi-arrow-repeat" style="font-size:22px;display:block;margin-bottom:8px"></i>
                Loading…
            </div>
        </div>
    </div>

    <!-- EDIT MODE -->
    <div id="designEdit" style="display:none">

        <!-- Back + Title + Save/Edit -->
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
            <button onclick="showListMode()"
                style="display:flex;align-items:center;gap:5px;padding:8px 13px;background:#f0f2f5;border:1px solid var(--border);border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;color:var(--text);white-space:nowrap;flex-shrink:0">
                <i class="bi bi-chevron-left" style="font-size:12px"></i> Layouts
            </button>
            <span style="font-size:15px;font-weight:700;color:var(--navy);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" id="editModeTitle">New Layout</span>
            <button id="dsActionBtn" onclick="dsActionClick()"
                style="display:flex;align-items:center;gap:6px;padding:8px 18px;background:var(--blue);color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap;flex-shrink:0">
                <i class="bi bi-floppy2" id="dsActionIcon"></i>
                <span id="dsActionLabel">Save</span>
            </button>
        </div>

        <!-- Name + Description -->
        <div class="card" style="margin-bottom:14px">
            <div class="card-body" style="padding:14px">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div>
                        <label class="form-label">Template Name <span class="req">*</span></label>
                        <input class="form-input" id="dsTemplateName" placeholder="e.g. Standard Barcode 1">
                    </div>
                    <div>
                        <label class="form-label">Description</label>
                        <input class="form-input" id="dsDescription" placeholder='e.g. 3 × 1.2 "'>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2-column split: Left = Preview, Right = Data/QR/Layout tabs -->
        <div class="ds-edit-grid">

            <!-- LEFT: Preview -->
            <div class="card">
                <div class="card-body" style="padding:16px">
                    <!-- DPI / Width / Height -->
                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:14px">
                        <div>
                            <label class="form-label">DPI</label>
                            <select class="form-select" id="dsDpi" onchange="dsPreviewDebounce()">
                                <option value="8dpmm">8 dpmm</option>
                                <option value="12dpmm">12 dpmm</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Width (in)</label>
                            <input class="form-input" id="dsWidth" type="number" value="4" min="1" max="12" step="0.5" oninput="dsPreviewDebounce()">
                        </div>
                        <div>
                            <label class="form-label">Height (in)</label>
                            <input class="form-input" id="dsHeight" type="number" value="3" min="1" max="12" step="0.5" oninput="dsPreviewDebounce()">
                        </div>
                    </div>

                    <!-- Sub-tabs: Label Preview | QR Data | ZPL Code -->
                    <div class="sub-tabs" id="dsPrevTabs">
                        <div class="sub-tab active" onclick="switchDsTab('preview', this)">
                            <i class="bi bi-image me-1"></i>Label Preview
                        </div>
                        <div class="sub-tab" onclick="switchDsTab('qrdata', this)">
                            <i class="bi bi-qr-code me-1"></i>QR Data
                        </div>
                        <div class="sub-tab" onclick="switchDsTab('zpl', this)">
                            <i class="bi bi-code-square me-1"></i>ZPL Code
                        </div>
                    </div>

                    <div id="ds-sub-preview">
                        <div style="background:#f8f9fc;border:1px solid var(--border);border-radius:10px;min-height:240px;display:flex;align-items:center;justify-content:center;padding:16px">
                            <div id="dsPreviewImgWrap">
                                <div style="color:var(--t3);font-size:13px;text-align:center">
                                    <i class="bi bi-hourglass-split" style="font-size:20px;display:block;margin-bottom:6px"></i>
                                    Loading…
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="ds-sub-qrdata" style="display:none">
                        <div class="code-box" id="dsQrDataBox"></div>
                    </div>
                    <div id="ds-sub-zpl" style="display:none">
                        <div class="code-box" id="dsZplBox"></div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: QR Data | Label Data | Layout Settings -->
            <div class="card">
                <div class="card-body" style="padding:16px">
                    <div class="sub-tabs" id="dsRightTabs">
                        <div class="sub-tab active" onclick="switchDsRight('qr', this)">
                            <i class="bi bi-qr-code me-1"></i>QR Data
                        </div>
                        <div class="sub-tab" onclick="switchDsRight('label', this)">
                            <i class="bi bi-tag me-1"></i>Label Data
                        </div>
                        <div class="sub-tab" onclick="switchDsRight('layout', this)">
                            <i class="bi bi-sliders me-1"></i>Layout
                        </div>
                    </div>

                    <!-- Tab: QR Data -->
                    <div id="dsr-qr" style="overflow-y:auto;max-height:520px">
                        <div id="dsQrFieldList" style="display:flex;flex-direction:column;gap:2px"></div>
                    </div>

                    <!-- Tab: Label Data -->
                    <div id="dsr-label" style="display:none;overflow-y:auto;max-height:520px">
                        <div id="dsFieldList" style="display:flex;flex-direction:column;gap:2px"></div>
                    </div>

                    <!-- Tab: Layout Settings -->
                    <div id="dsr-layout" style="display:none;overflow-y:auto;max-height:520px">

                        <!-- QR Component -->
                        <div style="font-size:12px;font-weight:700;color:var(--amber);margin:10px 0 8px;display:flex;align-items:center;gap:5px">
                            <i class="bi bi-qr-code"></i> QR Component
                        </div>
                        <div class="slider-row">
                            <label class="form-label">X</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slQrX" min="0" max="600" value="30" oninput="syncSlider('slQrX','vQrX');dsPreviewDebounce()">
                                <input type="number" id="vQrX" class="slider-val-input" value="30" onchange="syncInputToSlider('vQrX','slQrX');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vQrX','slQrX');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label">Y</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slQrY" min="0" max="600" value="40" oninput="syncSlider('slQrY','vQrY');dsPreviewDebounce()">
                                <input type="number" id="vQrY" class="slider-val-input" value="40" onchange="syncInputToSlider('vQrY','slQrY');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vQrY','slQrY');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label">QR Size</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slQrSize" min="2" max="15" value="5" oninput="syncSlider('slQrSize','vQrSize');dsPreviewDebounce()">
                                <input type="number" id="vQrSize" class="slider-val-input" value="5" onchange="syncInputToSlider('vQrSize','slQrSize');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vQrSize','slQrSize');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>

                        <!-- Data Component -->
                        <div style="font-size:12px;font-weight:700;color:var(--green);margin:14px 0 8px;display:flex;align-items:center;gap:5px">
                            <i class="bi bi-list-columns-reverse"></i> Data Component
                        </div>
                        <div class="slider-row">
                            <label class="form-label">X</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slDataX" min="0" max="800" value="373" oninput="syncSlider('slDataX','vDataX');dsPreviewDebounce()">
                                <input type="number" id="vDataX" class="slider-val-input" value="373" onchange="syncInputToSlider('vDataX','slDataX');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vDataX','slDataX');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label">Y</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slDataY" min="0" max="600" value="58" oninput="syncSlider('slDataY','vDataY');dsPreviewDebounce()">
                                <input type="number" id="vDataY" class="slider-val-input" value="58" onchange="syncInputToSlider('vDataY','slDataY');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vDataY','slDataY');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label">Font Size</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slFontSize" min="10" max="60" value="22" oninput="syncSlider('slFontSize','vFontSize');dsPreviewDebounce()">
                                <input type="number" id="vFontSize" class="slider-val-input" value="22" onchange="syncInputToSlider('vFontSize','slFontSize');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vFontSize','slFontSize');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label"><i class="bi bi-arrow-down-up me-1"></i>Line Height</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slLineHeight" min="10" max="80" value="33" oninput="syncSlider('slLineHeight','vLineHeight');dsPreviewDebounce()">
                                <input type="number" id="vLineHeight" class="slider-val-input" value="33" onchange="syncInputToSlider('vLineHeight','slLineHeight');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vLineHeight','slLineHeight');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>
                        <div class="slider-row">
                            <label class="form-label"><i class="bi bi-arrow-left-right me-1"></i>Val Offset</label>
                            <div style="display:flex;align-items:center;gap:6px">
                                <input type="range" id="slValOffset" min="0" max="400" value="151" oninput="syncSlider('slValOffset','vValOffset');dsPreviewDebounce()">
                                <input type="number" id="vValOffset" class="slider-val-input" value="151" onchange="syncInputToSlider('vValOffset','slValOffset');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vValOffset','slValOffset');dsPreviewDebounce();this.blur()}">
                            </div>
                        </div>

                        <!-- Printer Offset (collapsible) -->
                        <div style="border-top:1px solid var(--border);margin:8px 0 6px;padding-top:8px">
                            <div onclick="this.nextElementSibling.style.display=this.nextElementSibling.style.display==='none'?'block':'none'; this.querySelector('.po-arrow').style.transform=this.nextElementSibling.style.display==='none'?'rotate(0deg)':'rotate(180deg)'"
                                style="font-size:11px;font-weight:700;color:var(--t2);letter-spacing:.04em;text-transform:uppercase;cursor:pointer;display:flex;align-items:center;justify-content:space-between;user-select:none">
                                <span style="display:flex;align-items:center;gap:5px"><i class="bi bi-printer"></i> Printer Offset (^LH)</span>
                                <span class="po-arrow" style="transition:transform .2s;display:inline-block"><i class="bi bi-chevron-down" style="font-size:11px"></i></span>
                            </div>
                            <div style="display:none;margin-top:6px">
                                <div class="slider-row">
                                    <label class="form-label">Offset X</label>
                                    <div style="display:flex;align-items:center;gap:6px">
                                        <input type="range" id="slPrintOffX" min="0" max="400" value="100" oninput="syncSlider('slPrintOffX','vPrintOffX')">
                                        <input type="number" id="vPrintOffX" class="slider-val-input" value="100" onchange="syncInputToSlider('vPrintOffX','slPrintOffX')" onkeydown="if(event.key==='Enter'){syncInputToSlider('vPrintOffX','slPrintOffX');this.blur()}">
                                    </div>
                                </div>
                                <div class="slider-row">
                                    <label class="form-label">Offset Y</label>
                                    <div style="display:flex;align-items:center;gap:6px">
                                        <input type="range" id="slPrintOffY" min="0" max="200" value="0" oninput="syncSlider('slPrintOffY','vPrintOffY')">
                                        <input type="number" id="vPrintOffY" class="slider-val-input" value="0" onchange="syncInputToSlider('vPrintOffY','slPrintOffY')" onkeydown="if(event.key==='Enter'){syncInputToSlider('vPrintOffY','slPrintOffY');this.blur()}">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    let dsEditLayoutId = null

    // ปุ่ม Delete layout เห็นได้แค่ role Admin เท่านั้น (user.roles เป็น array เพราะ user มีได้หลาย role)
    function isAdminUser() {
        try {
            const roles = JSON.parse(localStorage.getItem('user') || '{}').roles
            return Array.isArray(roles) && roles.includes('Admin')
        } catch (_) { return false }
    }

    const DESIGN_SAMPLE = {
        partNo:'4104097105M', quantity:'100', unit:'PCE',
        vendor:'676894', dateCode:'260309', tradingCode:'06',
        po:'T3FY261023', inventoryNo:'QQT20260251',
        traceId:'20260309000059', workOrder:'W3622502555', line:'F05',
        lotNo:'LOT_01KRWD7FAG', uniqueId:'UQ-01KRWD7FAG', productionArea:'fan_1',
    }

    function syncSlider(sliderId, valId) {
        document.getElementById(valId).value = document.getElementById(sliderId).value
    }

    function syncInputToSlider(inputId, sliderId) {
        const inp = document.getElementById(inputId)
        const sl  = document.getElementById(sliderId)
        if (!inp || !sl) return
        const val = Math.min(+sl.max, Math.max(+sl.min, +inp.value || 0))
        inp.value = val
        sl.value  = val
    }

    function switchDsTab(name, el) {
        ['preview','qrdata','zpl'].forEach(k => {
            document.getElementById('ds-sub-'+k).style.display = k === name ? '' : 'none'
        })
        document.getElementById('dsPrevTabs').querySelectorAll('.sub-tab')
            .forEach(t => t.classList.remove('active'))
        el.classList.add('active')
    }

    function switchDsRight(name, el) {
        ['label','qr','layout'].forEach(k => {
            document.getElementById('dsr-'+k).style.display = k === name ? '' : 'none'
        })
        document.getElementById('dsRightTabs').querySelectorAll('.sub-tab')
            .forEach(t => t.classList.remove('active'))
        el.classList.add('active')
    }

    function showListMode() {
        document.getElementById('designList').style.display = ''
        document.getElementById('designEdit').style.display = 'none'
        loadLayoutList()
    }

    async function loadLayoutList() {
        const container = document.getElementById('layoutListContainer')
        container.innerHTML = `<div style="text-align:center;color:var(--t3);padding:32px;grid-column:1/-1">
            <i class="bi bi-arrow-repeat" style="font-size:22px;display:block;margin-bottom:8px"></i>Loading…</div>`
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const arr = (Array.isArray(layouts) ? layouts : (layouts?.data || []))
                .sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0) - new Date(a.updatedAt ?? a.createdAt ?? 0))
            if (arr.length === 0) {
                container.innerHTML = `<div style="text-align:center;color:var(--t3);padding:40px;grid-column:1/-1">
                    <i class="bi bi-layout-text-window" style="font-size:32px;display:block;margin-bottom:10px;opacity:.4"></i>
                    <div style="font-weight:600;margin-bottom:4px">No layouts yet</div>
                    <div style="font-size:13px">Click "+ New Layout" to create one</div>
                </div>`
                return
            }
            const canDelete = isAdminUser()
            container.innerHTML = arr.map((l, i) => {
                const config     = parseZplDataJson(l)
                const fields     = Array.isArray(config.labelFields) ? config.labelFields : []
                const visCount   = fields.filter(f => f.show).length
                const fieldBadge = fields.length > 0
                    ? `<span style="font-size:11px;background:var(--blue-lt);color:var(--blue);border-radius:20px;padding:2px 8px;font-weight:600;flex-shrink:0">${visCount}/${fields.length} fields</span>`
                    : ''
                const desc = (l.description ?? '').trim()
                return `<div class="layout-card" style="--i:${i}" onclick="openViewMode(${l.id})">
                    <div class="layout-card-preview" id="layoutPrev_${l.id}">
                        <div class="layout-card-skeleton"></div>
                    </div>
                    <div class="layout-card-body">
                        <div class="layout-card-top">
                            <div class="layout-card-name">${escHtml(l.templateName ?? 'Untitled')}</div>
                            ${fieldBadge}
                        </div>
                        <div class="layout-card-desc${desc ? '' : ' empty'}">${escHtml(desc || 'No description')}</div>
                        <div class="layout-card-footer">
                            <div class="layout-card-meta">
                                <span title="Created"><i class="bi bi-calendar3"></i> ${fmtCreatedAt(l.createdAt) || '—'}</span>
                                <span title="Last updated"><i class="bi bi-pencil-square"></i> ${fmtCreatedAt(l.updatedAt) || '—'}</span>
                            </div>
                            <div class="layout-card-actions" onclick="event.stopPropagation()">
                                <button class="layout-card-btn" onclick="openEditMode(${l.id})" title="Edit"><i class="bi bi-pencil"></i></button>
                                ${canDelete ? `<button class="layout-card-btn danger" onclick="deleteLayout(${l.id})" title="Delete"><i class="bi bi-trash3"></i></button>` : ''}
                            </div>
                        </div>
                    </div>
                </div>`
            }).join('')

            // เรนเดอร์ ZPL preview ของแต่ละ layout แบบ parallel (ไม่บล็อกการแสดง card) — ใช้ DESIGN_SAMPLE
            // ข้อมูลเดียวกับตอน edit เพื่อให้เห็นหน้าตา label จริงโดยไม่ต้องพิมพ์จริง
            await Promise.all(arr.map(l => _renderLayoutCardPreview(l)))
        } catch (_) {
            container.innerHTML = `<div style="text-align:center;color:var(--t3);padding:32px;grid-column:1/-1">
                <i class="bi bi-exclamation-circle" style="font-size:22px;display:block;margin-bottom:8px;color:var(--red);opacity:.7"></i>
                Unable to load layouts</div>`
        }
    }

    async function _renderLayoutCardPreview(l) {
        const slot = document.getElementById(`layoutPrev_${l.id}`)
        if (!slot) return
        try {
            const c          = parseZplDataJson(l)
            const fields     = parseLayoutFields(l) ?? (Array.isArray(c.labelFields) ? c.labelFields : [])
            const textFields = fields.filter(f => f.show).map(f => ({ label: f.label, value: DESIGN_SAMPLE[f.key] ?? '' }))
            const zpl = buildZpl({
                qrContent: buildQrContent(DESIGN_SAMPLE, c.qrFields ?? null),
                textFields,
                qrX: c.qrX ?? 30, qrY: c.qrY ?? 40, qrSize: c.qrSize ?? 5,
                dataX: c.dataX ?? 373, dataY: c.dataY ?? 58,
                fontSize: c.fontSize ?? 22, lineHeight: c.lineHeight ?? 33, valOffset: c.valOffset ?? 151,
            })
            const src = await renderZplClient(zpl, c.dpi ?? '8dpmm', c.width ?? 4, c.height ?? 3)
            slot.innerHTML = src
                ? `<img src="${escHtml(src)}" alt="${escHtml(l.templateName ?? 'Layout preview')}">`
                : `<div class="layout-card-preview-err"><i class="bi bi-exclamation-triangle" style="display:block;margin-bottom:4px"></i>No preview</div>`
        } catch (_) {
            slot.innerHTML = `<div class="layout-card-preview-err"><i class="bi bi-x-circle" style="display:block;margin-bottom:4px"></i>Preview failed</div>`
        }
    }

    async function deleteLayout(id) {
        if (!confirm('Delete this layout?')) return
        try {
            await api(`/printer/template/${id}`, 'DELETE')
            loadLayoutList()
            loadLayoutsIntoSelect()
        } catch (err) { showToast('Delete failed: ' + err.message, 'error') }
    }

    let dsIsViewMode = false

    async function openViewMode(id) {
        document.getElementById('editModeTitle').textContent = 'Loading…'
        document.getElementById('designList').style.display = 'none'
        document.getElementById('designEdit').style.display = ''
        let layout
        try {
            layout = await api(`/printer/template/${id}`, 'GET')
        } catch (err) {
            showToast('Failed to load template: ' + err.message, 'error')
            showListMode()
            return
        }
        dsEditLayoutId = layout.id
        document.getElementById('editModeTitle').textContent = layout.templateName ?? 'Untitled'
        document.getElementById('dsTemplateName').value = layout.templateName ?? ''
        document.getElementById('dsDescription').value  = layout.description  ?? ''
        const c = parseZplDataJson(layout)
        document.getElementById('dsDpi').value    = c.dpi    ?? '8dpmm'
        document.getElementById('dsWidth').value  = c.width  ?? 4
        document.getElementById('dsHeight').value = c.height ?? 3
        setSlider('slQrX',      c.qrX       ?? 30)
        setSlider('slQrY',      c.qrY       ?? 40)
        setSlider('slQrSize',   c.qrSize    ?? 5)
        setSlider('slDataX',    c.dataX     ?? 373)
        setSlider('slDataY',    c.dataY     ?? 58)
        setSlider('slFontSize', c.fontSize  ?? 22)
        setSlider('slLineHeight',    c.lineHeight    ?? 33)
        setSlider('slValOffset',    c.valOffset     ?? 151)
        setSlider('slPrintOffX',    c.printOffsetX  ?? 100)
        setSlider('slPrintOffY',    c.printOffsetY  ?? 0)
        populateDsFieldList(parseLayoutFields(layout))
        populateDsQrFieldList(c.qrFields ?? null)
        dsIsViewMode = true
        document.getElementById('designEdit').classList.add('ds-readonly')
        const btn       = document.getElementById('dsActionBtn')
        const icon      = document.getElementById('dsActionIcon')
        const label     = document.getElementById('dsActionLabel')
        icon.className  = 'bi bi-pencil-square'
        label.textContent = 'Edit'
        btn.style.background = 'var(--t2, #6b7280)'
        showEditMode()
        dsDoPreview()
    }

    async function openEditMode(id) {
        await openViewMode(id)
        enableEditMode()
    }

    function enableEditMode() {
        dsIsViewMode = false
        document.getElementById('designEdit').classList.remove('ds-readonly')
        document.getElementById('editModeTitle').textContent =
            'Edit: ' + (document.getElementById('dsTemplateName').value || 'Untitled')
        const btn       = document.getElementById('dsActionBtn')
        const icon      = document.getElementById('dsActionIcon')
        const label     = document.getElementById('dsActionLabel')
        icon.className  = 'bi bi-floppy2'
        label.textContent = 'Save'
        btn.style.background = 'var(--blue)'
    }

    function dsActionClick() {
        if (dsIsViewMode) enableEditMode()
        else dsDoSave()
    }

    function openCreateMode() {
        dsEditLayoutId = null
        dsIsViewMode = false
        document.getElementById('designEdit').classList.remove('ds-readonly')
        document.getElementById('editModeTitle').textContent = 'New Layout'
        document.getElementById('dsTemplateName').value = ''
        document.getElementById('dsDescription').value  = ''
        const btn       = document.getElementById('dsActionBtn')
        const icon      = document.getElementById('dsActionIcon')
        const label     = document.getElementById('dsActionLabel')
        icon.className  = 'bi bi-floppy2'
        label.textContent = 'Save'
        btn.style.background = 'var(--blue)'
        setSlider('slQrX',30); setSlider('slQrY',40); setSlider('slQrSize',5)
        setSlider('slDataX',373); setSlider('slDataY',58)
        setSlider('slFontSize',22); setSlider('slLineHeight',33); setSlider('slValOffset',151)
        setSlider('slPrintOffX',100); setSlider('slPrintOffY',0)
        populateDsFieldList(null, true)
        populateDsQrFieldList(null, false)
        document.querySelectorAll('#dsFieldList .ds-field-cb').forEach(cb => { cb.checked = true })
        showEditMode()
        dsDoPreview()
    }

    function showEditMode() {
        document.getElementById('designList').style.display = 'none'
        document.getElementById('designEdit').style.display = ''
        document.getElementById('dsPreviewImgWrap').innerHTML =
            `<div style="color:var(--t2);font-size:13px;text-align:center">
                <i class="bi bi-hourglass-split" style="font-size:20px;display:block;margin-bottom:6px"></i>Rendering…
            </div>`
        dsUpdateQrData()
    }

    function setSlider(id, val) {
        const el = document.getElementById(id)
        if (!el) return
        el.value = val
        const vid = 'v' + id.replace('sl','')
        const vEl = document.getElementById(vid)
        if (vEl) vEl.value = val
    }

    function populateDsFieldList(savedFields, allChecked) {
        const container = document.getElementById('dsFieldList')
        container.innerHTML = ALL_FIELD_KEYS.map(k => {
            const sf      = savedFields ? savedFields.find(f => f.key === k) : null
            const label   = (sf && sf.label) ? sf.label : FIELD_LABELS[k]
            const checked = allChecked ? true : (sf ? Boolean(sf.show) : false)
            return `<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border)">
                <input type="checkbox" class="ds-field-cb" id="dfcb_${cid(k)}"
                    ${checked ? 'checked' : ''} onchange="dsPreviewDebounce()"
                    style="width:16px;height:16px;flex-shrink:0;accent-color:var(--blue)">
                <input type="text" id="dflabel_${cid(k)}" value="${escHtml(label)}"
                    title="คลิกเพื่อแก้ไขชื่อที่แสดงบน label"
                    style="flex:1;border:none;border-bottom:1px dashed transparent;outline:none;font-size:13px;font-weight:600;background:transparent;padding:0 0 1px;margin:0;line-height:1;color:var(--text);min-width:0;display:block;box-sizing:content-box;cursor:text;transition:border-color .12s"
                    oninput="dsPreviewDebounce()"
                    onmouseover="if(document.activeElement!==this){this.style.borderBottomColor='var(--t3)'}"
                    onmouseout="if(document.activeElement!==this){this.style.borderBottomColor='transparent'}"
                    onfocus="this.style.borderBottomStyle='solid';this.style.borderBottomColor='var(--blue)'"
                    onblur="this.style.borderBottomStyle='dashed';this.style.borderBottomColor='transparent'">
                <span style="font-size:11px;color:var(--blue);font-weight:600;font-family:monospace;white-space:nowrap;background:var(--blue-lt);padding:1px 6px;border-radius:4px">{${k}}</span>
            </div>`
        }).join('')
    }

    function populateDsQrFieldList(savedQrFields, allChecked) {
        const container = document.getElementById('dsQrFieldList')
        if (!container) return
        container.innerHTML = ALL_FIELD_KEYS.map(k => {
            const isReq   = QR_REQUIRED_KEYS.has(k)
            const sf      = savedQrFields ? savedQrFields.find(f => f.key === k) : null
            const checked = isReq || (allChecked ? true : (sf ? Boolean(sf.inQr) : false))
            return `<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border)">
                <input type="checkbox" id="qrcb_${cid(k)}" class="ds-qr-cb"
                    ${checked ? 'checked' : ''} ${isReq ? 'disabled' : ''}
                    onchange="dsPreviewDebounce()" style="width:16px;height:16px;flex-shrink:0;accent-color:var(--blue)">
                <span style="font-size:13px;font-weight:600;flex:1">${escHtml(FIELD_LABELS[k])}</span>
                ${isReq ? '<span style="font-size:10px;background:#fee2e2;color:#dc2626;border-radius:4px;padding:1px 6px;font-weight:600;white-space:nowrap">required</span>' : ''}
                <span style="font-size:11px;color:var(--blue);font-weight:600;font-family:monospace;white-space:nowrap;background:var(--blue-lt);padding:1px 6px;border-radius:4px">{${k}}</span>
            </div>`
        }).join('')
        QR_REQUIRED_KEYS.forEach(k => {
            const el = document.getElementById(`qrcb_${cid(k)}`)
            if (el) el.checked = true
        })
    }

    function getDsQrFields() {
        return ALL_FIELD_KEYS.map(k => ({
            key:  k,
            inQr: QR_REQUIRED_KEYS.has(k) || Boolean(document.getElementById(`qrcb_${cid(k)}`)?.checked),
        }))
    }

    function getDsFields() {
        return ALL_FIELD_KEYS.map(k => ({
            key:   k,
            label: document.getElementById(`dflabel_${cid(k)}`)?.value ?? FIELD_LABELS[k],
            show:  document.getElementById(`dfcb_${cid(k)}`)?.checked ?? false,
        }))
    }

    let dsPreviewTimer = null
    function dsPreviewDebounce() {
        clearTimeout(dsPreviewTimer)
        dsPreviewTimer = setTimeout(() => { dsUpdateQrData(); dsDoPreview() }, 600)
    }

    function dsUpdateQrData() {
        const qrFields  = getDsQrFields()
        const selKeys   = qrFields.filter(f => f.inQr).map(f => f.key)
        const QR_SCHEMA = JSON.stringify(Object.fromEntries(selKeys.map(k => [k, `{${k}}`])), null, 2)
        document.getElementById('dsQrDataBox').textContent = QR_SCHEMA
        document.getElementById('dsZplBox').textContent    = buildZplTemplate(getDsFields())
    }

    async function dsDoPreview() {
        const fields     = getDsFields()
        const textFields = fields.filter(f => f.show).map(f => ({
            label: f.label,
            value: DESIGN_SAMPLE[f.key] ?? '',
        }))
        const sliders    = {
            qrX:       +document.getElementById('slQrX').value,
            qrY:       +document.getElementById('slQrY').value,
            qrSize:    +document.getElementById('slQrSize').value,
            dataX:     +document.getElementById('slDataX').value,
            dataY:     +document.getElementById('slDataY').value,
            fontSize:   +document.getElementById('slFontSize').value,
            lineHeight: +document.getElementById('slLineHeight').value,
            valOffset:  +document.getElementById('slValOffset').value,
        }
        const zpl = buildZpl({ qrContent: buildQrContent(DESIGN_SAMPLE, getDsQrFields()), textFields, ...sliders })
        document.getElementById('dsZplBox').textContent = zpl
        const wrap = document.getElementById('dsPreviewImgWrap')
        wrap.innerHTML = `<div style="color:var(--t2);font-size:13px;text-align:center">
            <i class="bi bi-hourglass-split" style="font-size:20px;display:block;margin-bottom:6px"></i>Rendering…</div>`
        try {
            const dpi    = document.getElementById('dsDpi').value
            const width  = +document.getElementById('dsWidth').value  || 4
            const height = +document.getElementById('dsHeight').value || 3
            const imgSrc = await callZplPreview(zpl, dpi, width, height)
            if (imgSrc) {
                wrap.innerHTML = `<img src="${escHtml(imgSrc)}"
                    style="max-width:100%;max-height:300px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
            } else {
                wrap.innerHTML = `<div style="color:var(--amber);font-size:13px;display:flex;align-items:center;gap:6px;justify-content:center">
                    <i class="bi bi-exclamation-triangle"></i> No image received</div>`
            }
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px;display:flex;align-items:center;gap:6px;justify-content:center">
                <i class="bi bi-x-circle"></i> ${escHtml(err.message)}</div>`
        }
    }

    async function dsDoSave() {
        const name = document.getElementById('dsTemplateName').value.trim()
        if (!name) { showToast('Please enter a Template Name', 'error'); return }
        const fields = getDsFields()
        const config = {
            zplTemplate: buildZplTemplate(fields),
            dpi:         document.getElementById('dsDpi').value,
            width:       +document.getElementById('dsWidth').value,
            height:      +document.getElementById('dsHeight').value,
            qrX:         +document.getElementById('slQrX').value,
            qrY:         +document.getElementById('slQrY').value,
            qrSize:      +document.getElementById('slQrSize').value,
            dataX:       +document.getElementById('slDataX').value,
            dataY:       +document.getElementById('slDataY').value,
            fontSize:    +document.getElementById('slFontSize').value,
            lineHeight:    +document.getElementById('slLineHeight').value,
            valOffset:     +document.getElementById('slValOffset').value,
            printOffsetX:  +document.getElementById('slPrintOffX').value,
            printOffsetY:  +document.getElementById('slPrintOffY').value,
            labelFields: fields,
            qrFields:    getDsQrFields(),
        }
        const body = {
            templateName: name,
            description:  document.getElementById('dsDescription').value.trim(),
            zplData:      JSON.stringify(config),
        }
        try {
            let savedId = dsEditLayoutId
            if (dsEditLayoutId) {
                await api(`/printer/template/${dsEditLayoutId}`, 'PUT', { id: dsEditLayoutId, ...body })
            } else {
                const res = await api('/printer/save-template', 'POST', body)
                savedId = res?.id ?? res?.data?.id ?? null
            }
            showToast('Layout saved', 'success')
            loadLayoutsIntoSelect()
            // Stay on this page — reload the saved layout in view mode instead of returning to the list
            if (savedId) await openViewMode(savedId)
        } catch (err) { showToast('Save failed: ' + err.message, 'error') }
    }
</script>
