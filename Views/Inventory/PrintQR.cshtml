                + เพิ่ม Item
            </button>`
        document.getElementById('rpManualModal').style.display = 'flex'
    }

    function rpSubmitManual() {
        const data = {}
        ALL_FIELD_KEYS.forEach(k => {
            if (AUTO_GEN_KEYS.has(k)) { data[k] = ''; return }
            const el = document.getElementById(`rpm_${cid(k)}`)
            data[k] = el ? el.value.trim() : ''
        })
        for (const k of REQUIRED_KEYS) {
            if (!data[k]) {
                showToast(`กรุณากรอก ${FIELD_LABELS[k]}`, 'error')
                const el = document.getElementById(`rpm_${cid(k)}`)
                if (el) { el.style.borderColor = 'var(--red)'; el.focus() }
                return
            }
        }
        document.getElementById('rpManualModal').style.display = 'none'
        rpAddItem(data).then(ok => { if (ok) showToast('✅ เพิ่ม ' + data.partNo + ' แล้ว', 'success') })
    }

    // ── Barcode parsing ──
    async function rpParseScan(raw) {
        // Try JSON parse first
        try {
            const obj = JSON.parse(raw)
            if (obj && typeof obj === 'object' && obj.partNo) {
                return {
                    partNo:   obj.partNo  ?? '',
                    quantity: String(obj.quantity ?? ''),
                    unit:     obj.unit    ?? '',
                    workOrder: obj.workOrder ?? rpCurrentWo ?? '',
                    line:     obj.line    ?? rpCurrentLine ?? '',
                    lotNo:    obj.lotNo   ?? '',
                    vendor:   obj.vendor  ?? '',
                    dateCode: obj.dateCode ?? '',
                    tradingCode: obj.tradingCode ?? '',
                    po:       obj.po      ?? '',
                    inventoryNo: obj.inventoryNo ?? '',
                    traceId:  obj.traceId ?? '',
                    productionArea: obj.productionArea ?? '',
                    createdAt: obj.createdAt ?? '',
                }
            }
        } catch (_) {}
        // Else call scan API
        const res = await api('/inventory/scan', 'POST', { barcode: raw, mode: 0 })
        return {
            partNo:   res.partNo   ?? '',
            quantity: String(res.quantity ?? ''),
            unit:     res.unit     ?? '',
            workOrder: res.workOrder ?? rpCurrentWo ?? '',
            line:     res.line     ?? rpCurrentLine ?? '',
            lotNo:    '',
            vendor:   res.vendor   ?? '',
            dateCode: res.dateCode ?? '',
            tradingCode: res.tradingCode ?? '',
            po:       res.po       ?? '',
            inventoryNo: res.inventoryNo ?? '',
            traceId:  res.traceId  ?? '',
            productionArea: res.productionArea ?? '',
            createdAt: '',
        }
    }

    // ── Item list ──
    async function rpAddItem(data) {
        try {
        if (rpItems.length >= 10) {
            showToast('สูงสุด 10 items ต่อครั้ง', 'error')
            return
        }
        // Override W/O + Line from current selection if set
        if (rpCurrentWo)   data.workOrder = rpCurrentWo
        if (rpCurrentLine) data.line       = rpCurrentLine

        // Dedup check by traceId
        if (data.traceId) {
            const dup = rpItems.find(i => i.data.traceId === data.traceId)
            if (dup) {
                showToast('⚠️ traceId นี้มีอยู่ใน list แล้ว: ' + data.traceId, 'error')
                return
            }
        }

        // Get lotNo from server + set createdAt
        try {
            const trRes    = await api('/printer/new-traceId', 'GET')
            data.lotNo     = trRes?.traceId ?? trRes?.id ?? String(trRes) ?? null
        } catch (_) {
            data.lotNo = null
        }
        data.createdAt = new Date().toISOString()

        // Build ZPL
        const cfg = rpLayoutConfig ?? {}
        const sliders = {
            qrX:       cfg.qrX       ?? 30,
            qrY:       cfg.qrY       ?? 40,
            qrSize:    cfg.qrSize    ?? 5,
            dataX:     cfg.dataX     ?? 373,
            dataY:     cfg.dataY     ?? 58,
            fontSize:  cfg.fontSize  ?? 22,
            lineHeight: cfg.lineHeight ?? 33,
            valOffset:  cfg.valOffset  ?? 151,
        }
        const labelFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : null
        const textFields = labelFields
            ? labelFields.filter(f => f.show).map(f => ({
                label: f.label ?? FIELD_LABELS[f.key] ?? f.key,
                value: f.key === 'createdAt' ? fmtCreatedAt(data[f.key]) : (data[f.key] ?? ''),
              }))
            : Object.keys(FIELD_LABELS).filter(k => data[k]).map(k => ({
                label: FIELD_LABELS[k],
                value: k === 'createdAt' ? fmtCreatedAt(data[k]) : data[k],
              }))
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        rpItems.push({ data, zpl, previewSrc: null })
        rpRenderList()
        // Async render preview in background
        const idx = rpItems.length - 1
        const dpi = cfg.dpi ?? '8dpmm'
        const w   = cfg.width  ?? 4
        const h   = cfg.height ?? 3
        renderZplClient(zpl, dpi, w, h).then(src => {
            if (rpItems[idx]) { rpItems[idx].previewSrc = src }
        }).catch(() => {})
        return true
        } catch(e) { showToast('เพิ่ม item ไม่สำเร็จ: ' + e.message, 'error'); return false }
    }

    function rpRemoveItem(idx) {
        rpItems.splice(idx, 1)
        rpRenderList()
    }

    function rpRenderList() {
        const container = document.getElementById('rpItemList')
        const badge     = document.getElementById('rpCounter')
        const n = rpItems.length
        badge.textContent = `${n}/10`
        badge.className   = 'rp-counter-badge' + (n >= 10 ? ' full' : '')

        if (n === 0) {
            container.innerHTML = '<div class="rp-empty-state">ยังไม่มี item — สแกนหรือพิมพ์เพื่อเพิ่ม</div>'
            return
        }
        container.innerHTML = rpItems.map((item, idx) => {
            const d = item.data
            const lot = d.lotNo ? `<span class="rp-lot-badge">${escHtml(d.lotNo)}</span>` : ''
            return `<div class="rp-item-row">
                <div class="rp-item-thumb" onclick="rpShowPreview(${idx})" title="Preview label">🖼</div>
                <div class="rp-item-info">
                    <div class="rp-item-pn">${escHtml(d.partNo || '—')}</div>
                    <div class="rp-item-sub">${escHtml(d.quantity || '')} ${escHtml(d.unit || '')} · W/O: ${escHtml(d.workOrder || '—')}</div>
                </div>
                ${lot}
                <button onclick="rpViewItemData(${idx})"
                    style="background:none;border:1px solid var(--border);border-radius:7px;padding:5px 10px;font-size:11px;font-weight:600;color:var(--blue);cursor:pointer;white-space:nowrap;flex-shrink:0">
                    📋 ดูข้อมูล
                </button>
                <button class="rp-remove-btn" onclick="rpRemoveItem(${idx})" title="Remove">✕</button>
            </div>`
        }).join('')
    }

    async function rpShowPreview(idx) {
        const modal = document.getElementById('rpPreviewModal')
        const wrap  = document.getElementById('rpPreviewContent')
        modal.style.display = 'flex'
        wrap.innerHTML = '<div style="color:var(--t3);font-size:13px">Rendering…</div>'
        const item = rpItems[idx]
        if (!item) { wrap.innerHTML = '<div style="color:var(--red)">Item not found</div>'; return }
        try {
            let src = item.previewSrc
            if (!src) {
                const cfg = rpLayoutConfig ?? {}
                src = await renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
                if (item) item.previewSrc = src
            }
            wrap.innerHTML = src
                ? `<img src="${escHtml(src)}" style="max-width:100%;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
                : '<div style="color:var(--amber);font-size:13px">Preview not available</div>'
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
    }

    function rpClosePreview() {
        document.getElementById('rpPreviewModal').style.display = 'none'
    }

    // ── Printer discovery ──
    async function rpLoadPrinters() {
        const sels = [
            document.getElementById('rpPrinterSelect'),
            document.getElementById('rpReprintPrinterSelect'),
        ]
        sels.forEach(s => { if (s) s.innerHTML = '<option value="">⏳ กำลังค้นหา…</option>' })
        try {
            const res = await api('/printer/discover', 'GET')
            const arr = Array.isArray(res) ? res : (res?.data ?? res?.printers ?? [])
            const opts = (arr.length === 0
                ? '<option value="">ไม่พบเครื่องพิมพ์</option>'
                : '<option value="">-- เลือกเครื่องพิมพ์ --</option>' +
                  arr.map(p => {
                      const id    = p.id ?? p.ip ?? p.name
                      const label = p.name
                          ? (p.ip ? `${p.name} (${p.ip}:${p.port ?? 9100})` : p.name)
                          : (p.ip ?? String(id))
                      return `<option value="${escHtml(String(id))}">${escHtml(label)}</option>`
                  }).join('')
            ) + '<option value="__test__">🧪 test</option>'
            sels.forEach(s => { if (s) s.innerHTML = opts })
            if (arr.length === 0) showToast('ไม่พบเครื่องพิมพ์ในเครือข่าย', 'error')
        } catch (err) {
            sels.forEach(s => { if (s) s.innerHTML = '<option value="">โหลดไม่สำเร็จ</option>' })
            showToast('โหลดเครื่องพิมพ์ไม่สำเร็จ: ' + err.message, 'error')
        }
    }

    // ── Print modal ──
    function rpShowPrintModal() {
        if (rpItems.length === 0) { showToast('ไม่มี item ในรายการ', 'error'); return }
        document.getElementById('rpPrintModal').style.display = 'flex'
    }

    async function rpPrint(mode) {
        document.getElementById('rpPrintModal').style.display = 'none'
        if (rpItems.length === 0) { showToast('ไม่มี item ในรายการ', 'error'); return }
        if (mode === 'receive' && !rpReceiveLocationCode) {
            showToast('กรุณาเลือก Receive Location ก่อน', 'error'); return
        }
        const sel = document.getElementById('rpPrinterSelect')
        if (!sel.value) { showToast('กรุณาเลือกเครื่องพิมพ์', 'error'); return }
        const printer = sel.value
        let successCount = 0
        for (const item of rpItems) {
            try {
                const printZpl = applyPrintOffset(item.zpl, rpLayoutConfig)
                console.log('[ZPL Print] lotNo:', item.data.lotNo, '\n' + printZpl)
                const payload = {
                    printerIp: printer,
                    traceId:   item.data.lotNo ?? '',
                    zpl:       printZpl,
                    isReprint: false,
                }
                await api('/printer/send', 'POST', payload)
                if (mode === 'receive') {
                    try {
                        await api('/inventory/receive', 'POST', {
                            partNo:    item.data.partNo,
                            quantity:  +item.data.quantity || 0,
                            unit:      item.data.unit,
                            workOrder: item.data.workOrder,
                            line:      item.data.line,
                            lotNo:     item.data.lotNo,
                        })
                    } catch (re) { console.warn('[rpPrint] receive error:', re) }
                }
                successCount++
            } catch (err) {
                showToast(`Print error: ${err.message}`, 'error')
            }
        }
        if (successCount > 0) {
            showToast(`🖨️ Printed ${successCount} item(s)${mode === 'receive' ? ' & Received' : ''}`, 'success')
            rpItems = []
            rpRenderList()
        }
    }

    // ── Re-Print ──
    async function rpSearchLot() {
        const inp   = document.getElementById('rpReprintLot')
        const lotNo = inp.value.trim()
        if (!lotNo) { showToast('กรุณากรอก LOT NO', 'error'); return }
        inp.value = ''
        const ok = await rprAddFromScan(lotNo)
        if (ok) showToast('✅ เพิ่ม LOT เข้า Re-Print list แล้ว', 'success')
    }

    // lookup existing lot → push to rprItems (no new traceId)
    async function rprAddFromScan(code) {
        if (rprItems.length >= 10) { showToast('สูงสุด 10 items ต่อครั้ง', 'error'); return false }

        // extract lotNo from full JSON or plain string
        let lotNo = code.trim()
        try {
            const obj = JSON.parse(code)
            lotNo = obj.lotNo ?? obj.traceId ?? lotNo
        } catch (_) {}

        if (!lotNo) { showToast('ไม่สามารถอ่าน LOT NO ได้', 'error'); return false }

        // duplicate check
        if (rprItems.find(i => i.data.lotNo === lotNo)) {
            showToast('⚠️ LOT นี้มีอยู่ใน list แล้ว: ' + lotNo, 'error')
            return false
        }

        let data
        try {
            data = await api(`/printer/lot/${encodeURIComponent(lotNo)}`, 'GET')
        } catch (err) {
            showToast('❌ ไม่พบ LOT: ' + lotNo, 'error')
            return false
        }

        const cfg       = rprLayoutConfig ?? {}
        const sliders   = { qrX: cfg.qrX??30, qrY: cfg.qrY??40, qrSize: cfg.qrSize??5, dataX: cfg.dataX??373, dataY: cfg.dataY??58, fontSize: cfg.fontSize??22, lineHeight: cfg.lineHeight??33, valOffset: cfg.valOffset??151 }
        const lf        = Array.isArray(cfg.labelFields) ? cfg.labelFields : null
        const textFields = lf
            ? lf.filter(f => f.show).map(f => ({ label: f.label ?? FIELD_LABELS[f.key] ?? f.key, value: f.key === 'createdAt' ? fmtCreatedAt(data[f.key]) : (data[f.key] ?? '') }))
            : Object.keys(FIELD_LABELS).filter(k => data[k]).map(k => ({ label: FIELD_LABELS[k], value: k === 'createdAt' ? fmtCreatedAt(data[k]) : data[k] }))
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        rprItems.push({ data, zpl, previewSrc: null })
        rprRenderList()
        const idx = rprItems.length - 1
        renderZplClient(zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
            .then(src => { if (rprItems[idx]) rprItems[idx].previewSrc = src }).catch(() => {})
        return true
    }

    async function rpShowReprintPreview() {
        if (!_rpFoundLot) return
        const modal = document.getElementById('rpPreviewModal')
        const wrap  = document.getElementById('rpPreviewContent')
        modal.style.display = 'flex'
        wrap.innerHTML = '<div style="color:var(--t3);font-size:13px">Rendering…</div>'
        try {
            const cfg = rprLayoutConfig ?? rpLayoutConfig ?? {}
            const data = _rpFoundLot
            const sliders = { qrX:30, qrY:40, qrSize:5, dataX:373, dataY:58, fontSize:22, valOffset:151, ...cfg }
            const textFields = [
                { label:'P/N',  value: data.partNo  ?? '' },
                { label:'QTY',  value: String(data.quantity ?? '') },
                { label:'UNIT', value: data.unit    ?? '' },
                { label:'W/O',  value: data.workOrder ?? '' },
                { label:'Line', value: data.line    ?? '' },
                { label:'LOT',  value: data.lotNo   ?? '' },
            ]
            const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })
            const src = await renderZplClient(zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
            wrap.innerHTML = src
                ? `<img src="${escHtml(src)}" style="max-width:100%;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
                : '<div style="color:var(--amber)">Preview not available</div>'
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
    }

    async function rpDoReprint() {
        if (!_rpFoundLot) { showToast('ค้นหา LOT NO ก่อน', 'error'); return }
        const sel = document.getElementById('rpReprintPrinterSelect')
        if (!sel.value) { showToast('กรุณาเลือกเครื่องพิมพ์', 'error'); return }
        const cfg = rprLayoutConfig ?? rpLayoutConfig ?? {}
        const data = _rpFoundLot
        const sliders = { qrX:30, qrY:40, qrSize:5, dataX:373, dataY:58, fontSize:22, valOffset:151, ...cfg }
        const textFields = [
            { label:'P/N',  value: data.partNo  ?? '' },
            { label:'QTY',  value: String(data.quantity ?? '') },
            { label:'UNIT', value: data.unit    ?? '' },
            { label:'W/O',  value: data.workOrder ?? '' },
            { label:'Line', value: data.line    ?? '' },
            { label:'LOT',  value: data.lotNo   ?? '' },
        ]
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })
        try {
            await api('/printer/send', 'POST', {
                printerIp:    sel.value,
                traceId:      data.lotNo ?? '',
                zpl:          applyPrintOffset(zpl, rprLayoutConfig ?? rpLayoutConfig),
                isReprint:    true,
                reprintReason: 'Re-Print from LOT search',
            })
            showToast('🖨️ Re-Print สำเร็จ', 'success')
        } catch (err) {
            showToast('Re-Print ไม่สำเร็จ: ' + err.message, 'error')
        }
    }

    // ── Re-Print mode ──
    let rprItems = [], rprLayoutConfig = null

    function rprLayoutChange() {
        const sel = document.getElementById('rprLayout')
        const id  = parseInt(sel.value)
        if (!id) { rprLayoutConfig = null; return }
        const arr  = sel._layoutsData ?? []
        const tmpl = arr.find(l => l.id === id)
        if (!tmpl) { rprLayoutConfig = null; return }
        rprLayoutConfig = parseZplDataJson(tmpl)
        rprRebuildAllZpl()
    }

    function rprRebuildAllZpl() {
        const cfg = rprLayoutConfig ?? {}
        rprItems.forEach((item, idx) => {
            const sliders = { qrX: cfg.qrX??30, qrY: cfg.qrY??40, qrSize: cfg.qrSize??5, dataX: cfg.dataX??373, dataY: cfg.dataY??58, fontSize: cfg.fontSize??22, lineHeight: cfg.lineHeight??33, valOffset: cfg.valOffset??151 }
            const labelFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : null
            const textFields = labelFields
                ? labelFields.filter(f => f.show).map(f => ({ label: f.label ?? FIELD_LABELS[f.key] ?? f.key, value: f.key === 'createdAt' ? fmtCreatedAt(item.data[f.key]) : (item.data[f.key] ?? '') }))
                : Object.keys(FIELD_LABELS).filter(k => item.data[k]).map(k => ({ label: FIELD_LABELS[k], value: k === 'createdAt' ? fmtCreatedAt(item.data[k]) : item.data[k] }))
            item.zpl = buildZpl({ qrContent: buildQrContent(item.data, cfg.qrFields ?? null), textFields, ...sliders })
            item.previewSrc = null
            renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
                .then(src => { if (rprItems[idx]) rprItems[idx].previewSrc = src }).catch(() => {})
        })
    }

    async function rprAddItem(data) {
        if (rprItems.length >= 10) { showToast('สูงสุด 10 items ต่อครั้ง', 'error'); return false }
        if (data.traceId) {
            const dup = rprItems.find(i => i.data.traceId === data.traceId)
            if (dup) { showToast('⚠️ traceId นี้มีอยู่ใน list แล้ว: ' + data.traceId, 'error'); return false }
        }
        try {
            const trRes = await api('/printer/new-traceId', 'GET')
            data.lotNo = trRes?.traceId ?? trRes?.id ?? String(trRes) ?? null
        } catch (_) { data.lotNo = null }
        data.createdAt = new Date().toISOString()

        const cfg = rprLayoutConfig ?? {}
        const sliders = { qrX: cfg.qrX??30, qrY: cfg.qrY??40, qrSize: cfg.qrSize??5, dataX: cfg.dataX??373, dataY: cfg.dataY??58, fontSize: cfg.fontSize??22, lineHeight: cfg.lineHeight??33, valOffset: cfg.valOffset??151 }
        const labelFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : null
        const textFields = labelFields
            ? labelFields.filter(f => f.show).map(f => ({ label: f.label ?? FIELD_LABELS[f.key] ?? f.key, value: f.key === 'createdAt' ? fmtCreatedAt(data[f.key]) : (data[f.key] ?? '') }))
            : Object.keys(FIELD_LABELS).filter(k => data[k]).map(k => ({ label: FIELD_LABELS[k], value: k === 'createdAt' ? fmtCreatedAt(data[k]) : data[k] }))
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        rprItems.push({ data, zpl, previewSrc: null })
        rprRenderList()
        const idx = rprItems.length - 1
        renderZplClient(zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
            .then(src => { if (rprItems[idx]) rprItems[idx].previewSrc = src }).catch(() => {})
        return true
    }

    function rprRemoveItem(idx) {
        rprItems.splice(idx, 1)
        rprRenderList()
    }

    function rprRenderList() {
        const card    = document.getElementById('rprItemListCard')
        const container = document.getElementById('rprItemList')
        const badge   = document.getElementById('rprCounter')
        const n = rprItems.length
        badge.textContent = `${n}/10`
        badge.className   = 'rp-counter-badge' + (n >= 10 ? ' full' : '')
        card.style.display = n === 0 ? 'none' : ''
        container.innerHTML = rprItems.map((item, idx) => {
            const d   = item.data
            const lot = d.lotNo ? `<span class="rp-lot-badge">${escHtml(d.lotNo)}</span>` : ''
            return `<div class="rp-item-row">
                <div class="rp-item-thumb" onclick="rprShowPreview(${idx})" title="Preview label">🖼</div>
                <div class="rp-item-info">
                    <div class="rp-item-pn">${escHtml(d.partNo || '—')}</div>
                    <div class="rp-item-sub">${escHtml(d.quantity || '')} ${escHtml(d.unit || '')}</div>
                </div>
                ${lot}
                <button onclick="rprViewItemData(${idx})"
                    style="background:none;border:1px solid var(--border);border-radius:7px;padding:5px 10px;font-size:11px;font-weight:600;color:var(--blue);cursor:pointer;white-space:nowrap;flex-shrink:0">
                    📋 ดูข้อมูล
                </button>
                <button class="rp-remove-btn" onclick="rprRemoveItem(${idx})" title="Remove">✕</button>
            </div>`
        }).join('')
    }

    async function rprShowPreview(idx) {
        const modal = document.getElementById('rpPreviewModal')
        const wrap  = document.getElementById('rpPreviewContent')
        modal.style.display = 'flex'
        wrap.innerHTML = '<div style="color:var(--t3);font-size:13px">Rendering…</div>'
        const item = rprItems[idx]
        if (!item) { wrap.innerHTML = '<div style="color:var(--red)">Item not found</div>'; return }
        try {
            let src = item.previewSrc
            if (!src) {
                const cfg = rprLayoutConfig ?? {}
                src = await renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
                if (item) item.previewSrc = src
            }
            wrap.innerHTML = src
                ? `<img src="${escHtml(src)}" style="max-width:100%;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
                : '<div style="color:var(--amber);font-size:13px">Preview not available</div>'
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
    }

    function rprViewItemData(idx) {
        const item = rprItems[idx]
        if (!item) return
        const d   = item.data
        const cfg = rprLayoutConfig ?? {}
        const qrFields  = Array.isArray(cfg.qrFields)    ? cfg.qrFields    : []
        const lblFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : []
        document.getElementById('rpManualFields').innerHTML = ALL_FIELD_KEYS.map(k => {
            const inQr  = qrFields.find(f => f.key === k)?.inQr  ?? false
            const inLbl = lblFields.find(f => f.key === k)?.show  ?? false
            return `<div style="display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px;align-items:center;padding:6px 16px;border-bottom:1px solid var(--border)">
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inQr ? 'var(--blue)' : 'var(--border)'};background:${inQr ? 'var(--blue)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inQr ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inLbl ? 'var(--purple,#7c3aed)' : 'var(--border)'};background:${inLbl ? 'var(--purple,#7c3aed)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inLbl ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="font-size:13px;font-weight:600;color:var(--navy)">${escHtml(FIELD_LABELS[k])}</div>
                <div style="font-size:13px;color:var(--text);padding:7px 10px;background:#f8f9fc;border-radius:8px">${escHtml(String(d[k] ?? ''))}</div>
            </div>`
        }).join('')
        document.getElementById('rpManualModalTitle').textContent = '📋 ข้อมูล Item #' + (idx + 1)
        document.getElementById('rpManualModalFooter').innerHTML =
            `<button onclick="document.getElementById('rpManualModal').style.display='none'"
                style="flex:1;padding:12px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">
                ปิด
            </button>`
        document.getElementById('rpManualModal').style.display = 'flex'
    }

    async function rprDoPrint() {
        if (rprItems.length === 0) { showToast('ไม่มี item ในรายการ', 'error'); return }
        const sel = document.getElementById('rpReprintPrinterSelect')
        if (!sel.value) { showToast('กรุณาเลือกเครื่องพิมพ์', 'error'); return }
        let successCount = 0
        for (const item of rprItems) {
            try {
                await api('/printer/send', 'POST', {
                    printerIp:    sel.value,
                    traceId:      item.data.lotNo ?? '',
                    zpl:          applyPrintOffset(item.zpl, rprLayoutConfig),
                    isReprint:    true,
                    reprintReason: 'Re-Print',
                })
                successCount++
            } catch (err) {
                showToast('Print error: ' + err.message, 'error')
            }
        }
        if (successCount > 0) {
            showToast('🖨️ Re-Printed ' + successCount + ' item(s)', 'success')
            rprItems = []
            rprRenderList()
        }
    }

    // ── Global Bluetooth/USB Barcode Scanner listener ──
    ;(function initScannerListener() {
        let _buf = '', _timer = null
        const THRESHOLD_MS = 150   // commit after 150ms silence (no Enter needed)
        const MIN_LEN      = 4

        function commitBuf() {
            const code = _buf; _buf = ''
            if (code.length >= MIN_LEN) onScannerInput(code)
        }

        document.addEventListener('keydown', e => {
            if (_rpScanActive) return

            if (e.key === 'Enter') {
                clearTimeout(_timer)
                commitBuf()
                return
            }

            if (e.key.length === 1) {
                _buf += e.key
                clearTimeout(_timer)
                _timer = setTimeout(commitBuf, THRESHOLD_MS)
            }
        })
    })()

    function logScannerInput(code) {
        const tbody = document.getElementById('scannerLogBody')
        if (!tbody) return
        const now = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
        tbody.innerHTML = `
            <tr>
                <td style="padding:8px 14px;color:var(--t3);white-space:nowrap">${now}</td>
                <td style="padding:8px 14px;font-family:ui-monospace,monospace;word-break:break-all">${escHtml(code)}</td>
                <td style="padding:8px 14px;color:var(--t2)">${code.length} chars</td>
            </tr>`
    }

    function onScannerInput(code) {
        logScannerInput(code)
        const tab = document.querySelector('.tab-pane.active')?.id
        const subMode = document.querySelector('.sub-tab.active')?.textContent ?? ''

        if (subMode.includes('Re-Print') || tab === 'tab-reprint') {
            rprAddFromScan(code)
                .then(ok => { if (ok) showToast('🖨 Scanner: เพิ่ม LOT แล้ว (' + rprItems.length + '/10)', 'success') })
                .catch(err => showToast('❌ ' + err.message, 'error'))
        } else {
            // Receive & Print tab → ส่งผ่าน rpParseScan เหมือนกล้อง
            rpParseScan(code).then(async data => {
                if (!data) { showToast('⚠️ ไม่รู้จัก barcode: ' + code, 'error'); return }
                const ok = await rpAddItem(data)
                if (ok) showToast('📷 Scanner: เพิ่ม ' + (data.partNo || code) + ' แล้ว (' + rpItems.length + '/10)', 'success')
            }).catch(err => showToast('❌ ' + err.message, 'error'))
        }
    }

    // ── Init ──
    renderChecklist(null)
    loadLayoutsIntoSelect()
    loadLayoutList()
    loadPrinters(false)
    rpLoadPrinters()
</script>
}
