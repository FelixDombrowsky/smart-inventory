                        <td><span class="badge-status ${sCls}">${statusLabel}</span></td>
                        <td>
                            <div style="font-size:12px;color:var(--text)">${syncDate}</div>
                            ${syncAgo ? `<div style="font-size:11px;color:var(--t3)">${syncAgo}</div>` : ''}
                        </td>
                    </tr>`
                }).join('')

            renderPagination('woPagination', 'woPageInfo', cp, Math.ceil(total / ps) || 1, 'loadWorkOrders')
        } catch (err) {
            console.error('loadWorkOrders:', err)
            document.getElementById('workordersTable').innerHTML =
                `<tr><td colspan="5" style="text-align:center;color:var(--red);padding:32px">Load failed: ${err.message}</td></tr>`
        }
    }

    function timeAgo(date) {
        const s = Math.floor((Date.now() - date) / 1000)
        if (s < 60)   return `${s} วินาทีที่แล้ว`
        if (s < 3600) return `${Math.floor(s/60)} นาทีที่แล้ว`
        if (s < 86400) return `${Math.floor(s/3600)} ชั่วโมงที่แล้ว`
        return `${Math.floor(s/86400)} วันที่แล้ว`
    }

    // ── BOMs Master-Detail ──
    let _selectedBomId    = null
    let _bomProfilesCache = []

    async function loadBoms(page = 1) {
        const q  = document.getElementById('bomSearch')?.value.trim() ?? ''
        const ps = parseInt(document.getElementById('bomPageSize')?.value || 10)
        try {
            // Fetch full list once; filter/paginate client-side
            if (!_bomProfilesCache.length || page === 1) {
                const res = await api('/master/bom-profiles')
                _bomProfilesCache = Array.isArray(res) ? res : (res?.data || [])
            }
            let filtered = q
                ? _bomProfilesCache.filter(x => (x.outputPartNo ?? '').toLowerCase().includes(q.toLowerCase()))
                : _bomProfilesCache

            const total = filtered.length
            const start = (page - 1) * ps
            const items = filtered.slice(start, start + ps)

            document.getElementById('bomCount').textContent = total + ' items'
            renderPagination('bomPagination', 'bomPageInfo', page, Math.ceil(total / ps) || 1, 'loadBoms')
            document.getElementById('bomsTable').innerHTML = items.length === 0
                ? `<tr><td colspan="3" style="text-align:center;color:var(--t3);padding:32px">No BOM Profiles found</td></tr>`
                : items.map(x => `
                    <tr class="bom-master-row${_selectedBomId === x.id ? ' selected' : ''}" onclick="bomSelectRow(${x.id}, this)">
                        <td><span class="mono" style="font-size:13px">${x.outputPartNo || '—'}</span></td>
                        <td style="color:var(--blue);font-weight:700">${x.outputQuantity ?? '—'}</td>
                        <td style="text-align:center">
                            <span style="background:var(--blue-lt);color:var(--blue);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">
                                ${Array.isArray(x.components) ? x.components.length : '—'}
                            </span>
                        </td>
                    </tr>`).join('')
        } catch (err) {
            console.error('loadBoms:', err)
            document.getElementById('bomsTable').innerHTML =
                `<tr><td colspan="3" style="text-align:center;color:var(--red);padding:32px">Load failed: ${err.message}</td></tr>`
        }
    }

    async function bomSelectRow(id, rowEl) {
        _selectedBomId = id
        document.querySelectorAll('.bom-master-row').forEach(r => r.classList.remove('selected'))
        rowEl.classList.add('selected')
        await bomLoadDetail(id)
