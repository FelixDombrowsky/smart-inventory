<!-- ── LIVE ACTIVITY | STOCK SUMMARY — แบ่งครึ่ง (layout แบบ vault "Sales & Order" + "Newly Arrived Stock") ──
     ซ้าย: Stock Summary / ขวา: ตาราง real-time Transactions / Work Orders (สลับด้วยปุ่มในหัวการ์ด — switchLiveView)
     ตารางทั้งสองตัดคอลัมน์ให้พอดีครึ่งจอ (ข้อมูลรองย้ายไปเป็นบรรทัดล่างในช่องเดียวกัน) — <1200px เรียงบน-ล่าง -->
<div class="dash-split">
<div class="dash-split-stock">
<!-- ── TABLE SECTION ── -->
<div class="section-card stock-card">
    <div class="sc-head">
        <div class="sc-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" style="stroke:var(--blue)" stroke-width="2.5">
                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
            </svg>
            <span data-i18n="stockSummary">Stock Summary</span>
            <span id="parts-count" style="font-size:11px;background:var(--blue-lt);color:var(--blue);padding:2px 8px;border-radius:20px;font-weight:700"></span>
        </div>
        <div class="filter-bar">
            <!-- ช่อง Part No. ย้ายขึ้นไปอยู่หัวหน้า ข้าง Location Type (.dash-search) — กรองทั้ง KPI และตารางนี้เหมือนเดิม -->
            <div class="ac-wrap">
                <i class="bi bi-diagram-3 ac-ico"></i>
                <input id="filterLine" class="filter-input ac-input ac-sm" placeholder="Line" data-i18n-placeholder="linePlaceholder" autocomplete="off">
                <button class="ac-clear" data-for="filterLine" tabindex="-1">×</button>
                <div class="ac-menu" id="filterLineMenu"></div>
            </div>
            <!-- Lot Status — ค่าเริ่มต้น lotStatus = 1 (ส่งไป get-stock-summary เสมอ) เลือก "All Status" = ไม่ส่ง -->
            <div class="loc-type-dd-wrap">
                <div class="loc-type-dd-trigger" id="dashLotStatusDdTrigger" tabindex="0" onclick="dashLotStatusDdToggle()">
