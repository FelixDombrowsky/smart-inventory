@{
  ViewData["Title"] = "Op-Dashboard";
}
<link rel="stylesheet" href="lib/leaflet/leaflet.css"/>
<link rel="stylesheet" href="lib/leaflet/leaflet-distortable.css"/>



<div class="card card-custom shadow-sm mb-3">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                @* <small class="text-uppercase fw-bold text-muted" style="letter-spacing: 1px; font-size: 0.7rem;">Current Shift</small> *@
                <h2 class="fw-bold text-navy mt-1"><span id="displayGreeting">Good Morning</span>, <span id="displayUserName">User</span></h2>
                <p class="text-muted mb-0 d-flex align-items-center gap-2">
                    <span class="d-flex align-items-center gap-1">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        <span id="dashNearestParent">—</span>
                    </span>
                    <span style="color:#dee2e6">|</span>
                    <span class="d-flex align-items-center gap-1">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
                        <span id="dashNearestFactory">—</span>
                    </span>
                </p>
            </div>
            @* <span class="badge rounded-pill px-3 py-2" style="background-color: #e2e8f0; color: #64748b;">Active</span> *@
        </div>
    </div>
</div>

<div class="card card-custom bg-navy shadow-sm mb-3 text-white rank-card" id="rankCard">
    <div class="rank-levelup-banner" id="rankLevelUpBanner">⭐ LEVEL UP!</div>
    <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <small class="text-uppercase opacity-75 fw-bold" style="font-size:0.7rem;letter-spacing:.06em">My Tasks Today</small>
            <span class="rank-pill" id="dashRankPill">
                <svg id="dashRankIcon" width="13" height="13" viewBox="0 0 24 24"></svg>
                <span id="dashRankName">—</span>
            </span>
        </div>
        <div class="d-flex align-items-baseline gap-2 mb-2">
            <h3 class="mb-0 fw-bold" id="dashTaskCount" style="font-size:2.1rem;line-height:1">—</h3>
            <span class="opacity-75" id="dashTaskTarget" style="font-size:.9rem">/ 20</span>
        </div>
        <div class="rank-bar-track">
            <div class="rank-bar-fill" id="dashTaskBar" style="width:0%">
                <div class="rank-bar-shimmer"></div>
            </div>
        </div>
        <div class="mt-2" style="font-size:11px" id="dashRankNextWrap">
            @* <span style="opacity:.65">ถึง <strong id="dashRankNextName">Silver</strong> อีก <strong id="dashRankRemain">—</strong> งาน</span> *@
        </div>
    </div>
</div>

<div class="card card-custom shadow-sm mb-3">
    <div class="card-body p-3">
        <div class="loc-wrap">
            <i class="bi bi-search loc-icon"></i>
            <input id="dashWoSearch" class="loc-input" placeholder="ค้นหา Work Order..." autocomplete="off">
            <div id="dashWoDropdown" class="loc-dd"></div>
        </div>
    </div>
</div>

<div class="card card-custom shadow-sm mb-3" id="dashLotSummaryCard" style="display:none;overflow:hidden">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div>
                <div style="font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.05em">W/O</div>
                <div class="fw-bold text-navy" style="font-size:14px" id="dashLotSummaryWo">—</div>
            </div>
            <div style="color:#dee2e6">|</div>
            <div id="dashLotSummaryLineWrap">
                <div style="font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.05em">Line</div>
                <div class="text-muted" style="font-size:14px" id="dashLotSummaryLine">—</div>
            </div>
            <div style="color:#dee2e6">|</div>
            <div>
                <div style="font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.05em">Lots</div>
                <div class="fw-bold text-navy" style="font-size:14px" id="dashLotSummaryCount">—</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width:180px">
                <span class="input-group-text border-end-0" style="background:#fff;border-radius:8px 0 0 8px;border-color:#dee2e6">
                    <i class="bi bi-search" style="font-size:12px;color:#94a3b8"></i>
                </span>
                <input id="dashPartNoSearch" type="search" class="form-control border-start-0"
                       placeholder="Part No..."
                       oninput="_dashPartNoFilter=this.value.trim();_dashLotPage=0;_renderDashLotPage()"
                       style="border-radius:0 8px 8px 0;font-size:12px;border-color:#dee2e6">
            </div>
            <div class="loc-filter-dd-wrap">
                <div class="loc-filter-dd-trigger" id="dashLocTypeBtn" tabindex="0" onclick="dashLocTypeDdToggle()">
                    <i class="bi bi-funnel" style="font-size:11px;color:var(--t3)"></i>
                    <span id="dashLocTypeLabel">WIP</span>
                    <i class="bi bi-chevron-down" style="font-size:10px;margin-left:auto;color:var(--t3)"></i>
                </div>
                <div class="loc-filter-dd-menu" id="dashLocTypeMenu" style="display:none"></div>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Lot No.</th>
                        <th>Part No.</th>
                        <th>Location</th>
                        <th class="text-center">On Hand</th>
                        <th class="text-center">Reserved</th>
                        <th class="text-center">Available</th>
                        <th class="text-center">Image</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="dashLotTable"></tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center px-3 py-2" id="dashLotPager" style="display:none!important">
            <button class="dash-page-btn" id="dashLotPrev" onclick="dashLotPage(-1)">
                <i class="bi bi-chevron-left"></i> Prev
            </button>
            <small class="text-muted fw-semibold" id="dashLotPageInfo" style="font-size:12px"></small>
            <button class="dash-page-btn" id="dashLotNext" onclick="dashLotPage(1)">
                Next <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

<div class="card card-custom shadow-sm" style="overflow:hidden">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-navy">My Last 10 Work Orders</h6>
        
    </div>
    <div class="card-body p-0">
        <div id="woListContainer" class="list-group list-group-flush">
            </div>
    </div>
</div>

<!-- Check Modal -->
<div class="chk-overlay" id="chkOverlay">
    <div class="chk-backdrop" onclick="closeCheckModal()"></div>
    <div class="chk-card">
        <div class="chk-handle"></div>
        <div class="chk-head">
            <span class="chk-title"><i class="bi bi-qr-code-scan me-2"></i>Check Stock</span>
            <select id="chkScanModeSelect" class="chk-mode-select" onchange="chkSetScanMode(this.value)" title="โหมดสแกน">
                <option value="lot">Lot Lookup</option>
                <option value="parse">Parse Barcode (Vendor)</option>
            </select>
            <button class="chk-close-btn" onclick="closeCheckModal()">✕</button>
        </div>
        <div class="chk-body">
            <!-- Left: Camera -->
            <div class="chk-left">
                <div class="chk-camera-wrap" id="chkCameraWrap">
                    <video id="chkVideo" autoplay playsinline muted></video>
                    <canvas id="chkCanvas"></canvas>
                </div>
                <div class="chk-hw-section" id="chkHwSection" style="display:none">
                    <div class="chk-hw-wrap">
                        <i class="bi bi-upc-scan"></i>
                        <input id="chkHwInput" class="chk-hw-input" placeholder="พร้อมสแกน — สแกน barcode ได้เลย…" autocomplete="off">
                    </div>
                    <div id="chkHwStatus" class="chk-hw-status">พร้อมสแกน…</div>
                </div>
                <div class="chk-label" id="chkLabel">— กำลังค้นหา barcode —</div>
                <div class="chk-cam-actions">
                    <button class="chk-cam-btn" id="chkSwitchBtn" onclick="chkSwitchCamera()" title="สลับกล้อง">
                        <i class="bi bi-arrow-repeat"></i>
                    </button>
                    <button class="chk-cam-btn chk-mode-btn" id="chkModeBtn" onclick="chkToggleMode()" title="สลับ Camera / HW Scanner">
                        <i class="bi bi-camera-fill"></i>
                    </button>
                </div>
            </div>
            <!-- Right: Info -->
            <div class="chk-right">
                <div class="chk-result" id="chkResult">
                    <div class="chk-result-idle">สแกน barcode เพื่อดูข้อมูล Lot</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>



function toggleFab(e) {
    if (e) e.stopPropagation()
    const wrap = document.getElementById('fabWrap')
    const isOpen = wrap.classList.toggle('open')
    document.getElementById('fabIconCamera').style.display = isOpen ? 'none' : ''
    document.getElementById('fabIconClose').style.display  = isOpen ? '' : 'none'
}
document.addEventListener('click', function(e) {
    if (!e.target.closest('#fabWrap'))
        document.getElementById('fabWrap')?.classList.remove('open')
})
</script>

<!-- Speed Dial FAB -->
<div class="fab-wrap" id="fabWrap">
    <div class="fab-items" id="fabItems">
        <div class="fab-item">
            <span class="fab-item-label">Check</span>
            <button class="fab-sub-btn" title="Check" onclick="openCheckModal()">
                <i class="bi bi-qr-code-scan"></i>
            </button>
        </div>
        <div class="fab-item">
            <span class="fab-item-label">Receive</span>
            <button class="fab-sub-btn" title="Receive" onclick="location.href='Inventory/Receive'">
                <i class="bi bi-box-arrow-in-down"></i>
            </button>
        </div>
        <div class="fab-item">
            <span class="fab-item-label">Move</span>
            <button class="fab-sub-btn" title="Move" onclick="location.href='Inventory/Move?openCamera=1'">
                <i class="bi bi-arrow-left-right"></i>
            </button>
        </div>
    </div>
    <button class="fab-camera-btn" id="fabMain" onclick="toggleFab(event)" title="Scan Actions">
        <i class="bi bi-camera-fill" id="fabIconCamera"></i>
        <i class="bi bi-x-lg"        id="fabIconClose" style="display:none"></i>
    </button>
</div>

<!-- Find Location Modal -->
<!-- Lightbox -->
<div class="dash-lightbox" id="dashLightbox" onclick="if(event.target===this)dashCloseLightbox()">
    <button class="dash-lb-nav" style="left:24px" onclick="dashLbStep(-1)"><i class="bi bi-chevron-left"></i></button>
    <div class="dash-lightbox-inner">
        <button class="dash-lightbox-close" onclick="dashCloseLightbox()">✕</button>
        <img class="dash-lightbox-img" id="dashLbImg" src="">
        <div class="dash-lightbox-caption" id="dashLbCaption"></div>
    </div>
    <button class="dash-lb-nav" style="right:24px" onclick="dashLbStep(1)"><i class="bi bi-chevron-right"></i></button>
</div>

<div class="modal fade" id="findLocModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;overflow:hidden">
            <div class="modal-header border-0 pb-1">
                <div>
                    <h6 class="modal-title fw-bold mb-0" id="findLocTitle" style="color:var(--ink)">—</h6>
                    <small class="text-muted" id="findLocSubtitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4 px-3">
                <!-- Compass arrow -->
                <div class="find-nav-circle">
                    <svg id="findNavArrow" class="find-nav-arrow" viewBox="0 0 60 84" xmlns="http://www.w3.org/2000/svg">
                        <path d="M30,2 L56,40 L41,40 L41,82 L19,82 L19,40 L4,40 Z" fill="#1a6fff"/>
                    </svg>
                </div>
                <p class="text-muted small mt-2 mb-0">หมุน tablet จนลูกศรชี้ขึ้น</p>
                <p class="text-muted small mt-2 mb-0">(ใช้ได้แค่แนวตั้ง)</p>
                <!-- Distance -->
                <div class="mt-3">
                    <div id="findNavDist" class="find-nav-dist">— m</div>
                    <small class="text-muted" id="findNavAccuracy"></small>
                </div>
                <!-- Altitude diff -->
                <div id="findNavAltWrap" class="mt-2" style="display:none">
                    <span id="findNavAltBadge" class="badge rounded-pill px-3 py-2" style="font-size:12px"></span>
                </div>
                <!-- Status / error -->
                <p id="findNavStatus" class="text-muted small mt-2 mb-0"></p>
                <!-- iOS compass permission -->
                <button id="findNavPermBtn" class="btn btn-outline-primary btn-sm mt-3" style="display:none"
                        onclick="_requestCompassPermission()">
                    เข็มทิศ: แตะเพื่ออนุญาต
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    main { padding-bottom: 90px !important; }

    :root {
        /* ── Accent (tint) เดียวทั้งระบบ แบบ iOS systemBlue ── */
        --tint:#1a6fff; --tint-press:#0d4fd6; --tint-soft:#e8f0ff; --tint-border:#c7d7ff;
        /* ── Navy/ink เดียว (ใช้ทั้ง surface เข้ม + title) ── */
        --ink:#1a2744; --ink-2:#475569;
        /* ── alias เดิม (โค้ดเก่ายังเรียก --blue/--blue-lt อยู่) ── */
        --blue:var(--tint); --blue-lt:var(--tint-soft);
        --text:#1a1a2e; --t3:#9ca3af; --border:#e5e7eb;
    }
    body { background-color: #f8fafd; }

    /* Work Order search */
    .loc-wrap { position: relative; }
    .loc-input {
        width: 100%; padding: 12px 14px 12px 38px;
        border: 1.5px solid var(--border); border-radius: 10px;
        font-size: 14px; font-family: inherit; color: var(--text);
        outline: none; transition: border-color .15s; box-sizing: border-box;
    }
    .loc-input:focus { border-color: var(--blue); }
    .loc-icon { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--t3); pointer-events: none; }
    .loc-dd {
        position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 50;
        background: #fff; border: 1.5px solid var(--blue); border-radius: 10px;
        box-shadow: 0 6px 24px rgba(0,0,0,.12); max-height: 230px; overflow-y: auto; display: none;
    }
    .loc-item {
        padding: 10px 14px; font-size: 13px; cursor: pointer;
        border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px;
        transition: .12s;
    }
    .loc-item:last-child { border-bottom: none; }
    .loc-item:hover { background: var(--blue-lt); }
    .loc-item:first-child { border-radius: 8px 8px 0 0; }
    .loc-item:last-child  { border-radius: 0 0 8px 8px; }

    /* ── Lot Summary table ── */
    .lot-badge {
        font-family: ui-monospace, monospace; font-size: 11.5px;
        background: var(--tint-soft); color: var(--tint-press);
        padding: 3px 9px; border-radius: 6px; font-weight: 700;
        letter-spacing: .02em; white-space: nowrap;
        border: 1px solid var(--tint-border);
    }
    .mono { font-family: ui-monospace, monospace; font-weight: 600; font-size: 12px; color: #374151; }

    /* Table header */
    #dashLotSummaryCard .table thead th {
        background: var(--ink); color: rgba(255,255,255,.75);
        font-size: 10px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .08em; padding: 10px 12px; border: none;
        white-space: nowrap;
    }
    #dashLotSummaryCard .table thead th:first-child { border-radius: 0; }

    /* Rows */
    #dashLotTable td { padding: 14px 12px; vertical-align: middle; border-bottom: 1px solid #f1f5f9; }
    #dashLotTable tr:last-child td { border-bottom: none; }
    #dashLotTable tr { transition: background .1s; }
    #dashLotTable tr:hover td { background: #f8faff; }

    /* Quantity pills */
    .qty-pill {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 36px; padding: 3px 8px; border-radius: 20px;
        font-size: 12px; font-weight: 700; font-family: ui-monospace, monospace;
    }
    .qty-oh  { background: #f1f5f9; color: #334155; }
    .qty-rs  { background: #fef3c7; color: #92400e; }
    .qty-av-ok  { background: #dcfce7; color: #166534; }
    .qty-av-low { background: #fee2e2; color: #991b1b; }

    /* Location code */
    .loc-code {
        display: inline-flex; align-items: center; gap: 4px;
        font-family: ui-monospace, monospace; font-size: 12px; font-weight: 600;
        color: #475569; background: #f8fafc; border: 1px solid #e2e8f0;
        padding: 2px 8px; border-radius: 5px;
    }

    /* Navigate button */
    .nav-btn {
        width: 38px; height: 38px; border: none; border-radius: 10px;
        background: linear-gradient(135deg, var(--tint), var(--tint-press));
        color: #fff; cursor: pointer; display: inline-flex;
        align-items: center; justify-content: center;
        box-shadow: 0 2px 8px rgba(26,111,255,.35);
        transition: transform .12s, box-shadow .12s;
    }
    .nav-btn:hover { transform: scale(1.08); box-shadow: 0 4px 14px rgba(26,111,255,.45); }
    .nav-btn:active { transform: scale(.96); }

    /* Pagination */
    #dashLotPager { background: #f8fafc; border-top: 1px solid #e9eef5; }
    .dash-page-btn {
        border: 1.5px solid #e2e8f0; background: #fff; color: #475569;
        border-radius: 8px; padding: 5px 14px; font-size: 12px; font-weight: 600;
        cursor: pointer; transition: .12s; display: inline-flex; align-items: center; gap: 4px;
    }
    .dash-page-btn:hover:not(:disabled) { border-color: var(--tint); color: var(--tint); background: var(--tint-soft); }
    .dash-page-btn:disabled { opacity: .4; cursor: default; }

    /* ══════════════════════════════════════════════════════════════
       Lot Summary — Tablet PORTRAIT: แปลงตาราง 8 คอลัมน์เป็น card cell
       (Landscape ยังเป็นตารางปกติ). ใช้ CSS อย่างเดียว markup เดิม
       ══════════════════════════════════════════════════════════════ */
    @@media (orientation: portrait) {
        /* ไม่ต้อง scroll แนวนอนแล้ว */
        #dashLotSummaryCard .table-responsive { overflow: visible; }
        #dashLotSummaryCard thead { display: none; }
        #dashLotSummaryCard .table,
        #dashLotSummaryCard tbody { display: block; }

        /* แต่ละแถว = การ์ด */
        #dashLotTable tr {
            display: grid;
            grid-template-columns: auto auto auto minmax(64px,1fr) auto;
            grid-template-areas:
                "lot  lot  lot  loc  loc"
                "part part part loc  loc"
                "oh   rs   av   img  find";
            gap: 9px 12px; align-items: center;
            margin: 12px; padding: 15px 16px;
            background: #fff; border: 1px solid var(--border);
            border-radius: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.05);
        }
        #dashLotTable tr:hover td { background: transparent; }   /* ปิด row-hover ตอนเป็นการ์ด */
        #dashLotTable td {
            display: flex; flex-direction: column; gap: 3px;
            padding: 0; border: none; vertical-align: initial;
            align-items: flex-start; text-align: left; min-width: 0;
        }
        #dashLotTable td:nth-child(1) { grid-area: lot; }
        #dashLotTable td:nth-child(2) { grid-area: part; }
        #dashLotTable td:nth-child(3) { grid-area: loc; align-items: flex-end; }
        #dashLotTable td:nth-child(4) { grid-area: oh; }
        #dashLotTable td:nth-child(5) { grid-area: rs; }
        #dashLotTable td:nth-child(6) { grid-area: av; }
        #dashLotTable td:nth-child(7) { grid-area: img;  align-items: center; }
        #dashLotTable td:nth-child(8) { grid-area: find; align-items: center; }

        /* label เล็กๆ เหนือ qty pill (เพราะ thead ถูกซ่อน) */
        #dashLotTable td[data-label]::before {
            content: attr(data-label);
            font-size: 8.5px; font-weight: 800; letter-spacing: .06em;
            text-transform: uppercase; color: var(--t3); line-height: 1;
        }
        #dashLotTable .lot-badge { font-size: 13px; padding: 4px 11px; }
        #dashLotTable .nav-btn { width: 44px; height: 44px; }   /* touch target 44pt */
        #dashLotTable .proof-thumb { width: 44px; height: 44px; }

        /* แถว loading / empty / error (td เดียว colspan) — ให้เต็มความกว้าง ไม่เข้า grid การ์ด */
        #dashLotTable tr:has(td[colspan]) {
            display: block; grid-template-areas: none; padding: 0;
            border: none; box-shadow: none; background: transparent;
        }
        #dashLotTable td[colspan] {
            display: block; align-items: center; text-align: center; padding: 16px;
        }
    }

    /* Proof photo / lightbox */
    .proof-thumb { width:40px;height:40px;object-fit:cover;border-radius:6px;border:1.5px solid var(--border);cursor:zoom-in;transition:transform .15s,box-shadow .15s; }
    .proof-thumb:hover { transform:scale(1.1);box-shadow:0 4px 12px rgba(0,0,0,.15); }
    .no-photo { color:var(--t3);font-size:18px; }
    .thumb-wrap { position:relative;display:inline-block;line-height:0; }
    .thumb-badge { position:absolute;top:-6px;right:-6px;background:var(--blue);color:#fff;font-size:10px;font-weight:800;line-height:1.4;border-radius:9px;padding:1px 5px;min-width:16px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,.3);border:1.5px solid #fff;pointer-events:none; }
    .dash-lightbox { position:fixed;inset:0;background:rgba(10,10,20,.85);backdrop-filter:blur(6px);z-index:3000;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s; }
    .dash-lightbox.show { opacity:1;pointer-events:all; }
    .dash-lightbox-inner { position:relative;max-width:90vw;max-height:90vh;transform:scale(.92);transition:transform .2s; }
    .dash-lightbox.show .dash-lightbox-inner { transform:scale(1); }
    .dash-lightbox-img { max-width:90vw;max-height:85vh;border-radius:12px;box-shadow:0 24px 60px rgba(0,0,0,.5);display:block; }
    .dash-lightbox-close { position:absolute;top:-14px;right:-14px;width:32px;height:32px;border-radius:50%;border:none;background:#fff;color:#0f172a;font-size:16px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.2); }
    .dash-lightbox-caption { text-align:center;color:rgba(255,255,255,.7);font-size:12px;margin-top:10px; }
    .dash-lb-nav { position:fixed;top:50%;transform:translateY(-50%);width:44px;height:44px;border:none;border-radius:50%;background:rgba(255,255,255,.12);color:#fff;font-size:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:3001;transition:.15s; }
    .dash-lb-nav:hover { background:rgba(255,255,255,.25); }

    /* Find Location compass */
    .find-nav-circle {
        width: 160px; height: 160px;
        background: #eef3ff;
        border-radius: 50%;
        box-shadow: 0 0 0 8px rgba(26,111,255,.08);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto;
    }
    .find-nav-arrow {
        width: 64px; height: 90px;
        transition: transform .2s ease-out;
        filter: drop-shadow(0 4px 10px rgba(26,111,255,.45));
    }
    .find-nav-dist {
        font-size: 44px;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -1px;
        transition: color .3s;
    }
    /* ── Speed Dial FAB ── */
    .fab-wrap {
        position: fixed;
        bottom: 24px;
        right: 24px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
        z-index: 1000;
        pointer-events: none;   /* wrapper โปร่งใส ไม่บล็อค click ด้านล่าง */
    }
    .fab-items {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
        pointer-events: none;
        opacity: 0;
        transform: translateY(10px) scale(.95);
        transition: opacity .2s ease, transform .2s ease;
    }
    .fab-wrap.open .fab-items {
        pointer-events: all;
        opacity: 1;
        transform: translateY(0) scale(1);
    }
    .fab-item {
        display: flex;
        align-items: center;
        gap: 10px;
        transform: translateY(8px);
        opacity: 0;
        transition: transform .2s ease, opacity .2s ease;
    }
    .fab-wrap.open .fab-item:nth-child(3) { transition-delay: .04s; transform: translateY(0); opacity: 1; }
    .fab-wrap.open .fab-item:nth-child(2) { transition-delay: .09s; transform: translateY(0); opacity: 1; }
    .fab-wrap.open .fab-item:nth-child(1) { transition-delay: .14s; transform: translateY(0); opacity: 1; }
    .fab-item-label {
        background: rgba(20,30,55,.82);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0,0,0,.22);
        backdrop-filter: blur(6px);
        letter-spacing: .01em;
    }
    .fab-sub-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: none;
        background: #fff;
        color: var(--tint);
        font-size: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(0,0,0,.18);
        cursor: pointer;
        flex-shrink: 0;
        transition: transform .15s, box-shadow .15s;
    }
    .fab-sub-btn:hover  { transform: scale(1.1); box-shadow: 0 6px 18px rgba(0,0,0,.26); }
    .fab-sub-btn:active { transform: scale(.95); }
    .fab-camera-btn {
        pointer-events: auto;   /* ปุ่มหลักรับ click เสมอ */
    }
    /* fab-sub-btn ไม่ต้อง set — inherit pointer-events:none จาก .fab-items ตอนปิด
       และ pointer-events:all จาก .fab-wrap.open .fab-items ตอนเปิด */
    .fab-camera-btn {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(135deg, var(--tint), var(--tint-press));
        color: #fff;
        font-size: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 16px rgba(26,111,255,.45);
        cursor: pointer;
        transition: transform .2s ease, box-shadow .15s, background .2s;
        flex-shrink: 0;
    }
    .fab-wrap.open .fab-camera-btn {
        background: linear-gradient(135deg, #475569, #334155);
        box-shadow: 0 6px 16px rgba(0,0,0,.35);
    }
    .fab-camera-btn:hover  { color: #fff; transform: scale(1.06); box-shadow: 0 8px 20px rgba(26,111,255,.55); }
    .fab-camera-btn:active { transform: scale(.96); }
    .card-custom { border-radius: 12px; border: none; }
    .text-navy { color: var(--ink); }
    /* rank card: navy เข้มตัวเดียวกับ table header (เดิม #43516c ขุ่น) + ไล่เฉดให้ progress/shimmer เด้งขึ้น */
    .bg-navy { background: linear-gradient(160deg, #223457 0%, var(--ink) 100%); }
    
    /* สไตล์สำหรับ Progress Bar แบบในรูป */
    .progress-custom {
        height: 8px;
        background-color: rgba(255,255,255,0.2);
        border-radius: 10px;
    }
