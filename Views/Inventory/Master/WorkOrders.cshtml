@{
    ViewData["Title"] = "Master Management";
}
<link rel="stylesheet" href="/css/master-shared.css"/>

<div class="toast-stack" id="toastStack"></div>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2>Master Management ⚙️</h2>
    </div>
</div>

@await Html.PartialAsync("Master/_MasterManagement")

<!-- ── WORK ORDERS ── -->
<div class="section-card">
    <div class="sc-head">
        <div class="sc-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
            </svg>
            Work Orders
            <span id="woCount" class="count-badge"></span>
        </div>
        <div class="filter-bar">
            <input id="woSearch"  class="filter-input" placeholder="MO Number…"
                   oninput="loadWorkOrders(1)" style="width:160px">
            <input id="woModel"   class="filter-input" placeholder="Model…"
                   oninput="loadWorkOrders(1)" style="width:130px">
            <input id="woLine"    class="filter-input" placeholder="Line…"
                   oninput="loadWorkOrders(1)" style="width:100px">
            <select id="woStatus" class="filter-select" onchange="loadWorkOrders(1)">
                <option value="">All Status</option>
            </select>
        </div>
    </div>
    <div style="overflow-x:auto">
        <table class="inv-table">
            <thead>
                <tr>
                    <th>MO Number</th>
                    <th>Model</th>
                    <th>Line</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="workordersTable"></tbody>
        </table>
    </div>
    <div class="pag-bar">
        <div style="display:flex;align-items:center;gap:6px">
            <span class="pag-info" id="woPageInfo"></span>
            <select id="woPageSize" onchange="loadWorkOrders(1)"
                style="padding:3px 8px;border:1.5px solid var(--border);border-radius:6px;font-size:12px;font-family:inherit;color:var(--t2);background:#fff;cursor:pointer;outline:none">
                <option value="10" selected>10 row</option>
                <option value="20">20 row</option>
                <option value="50">50 row</option>
                <option value="100">100 row</option>
            </select>
        </div>
        <div class="pag-btns" id="woPagination"></div>
    </div>
</div>

<!-- ── EDIT WORK ORDER STATUS MODAL ── -->
<div class="modal-overlay" id="woEditModal">
    <div class="modal-box">
        <div class="modal-title">Edit Work Order Status</div>
        <div class="modal-field">
            <div class="modal-label">MO Number</div>
            <input class="modal-input" id="woEditMo" readonly style="background:#f8f9fc">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <div class="modal-field">
                <div class="modal-label">Model</div>
                <input class="modal-input" id="woEditModel" readonly style="background:#f8f9fc">
            </div>
            <div class="modal-field">
                <div class="modal-label">Line</div>
                <input class="modal-input" id="woEditLine" readonly style="background:#f8f9fc">
            </div>
        </div>
        <div class="modal-field">
            <div class="modal-label">Status</div>
            <div id="woStatusButtons" style="display:flex;gap:8px;flex-wrap:wrap"></div>
        </div>
        <div class="modal-error" id="woEditError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('woEditModal')">ยกเลิก</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="/js/api.js"></script>
<script src="/js/master-shared.js"></script>
<script>
    let _woPage = 1
    let _woEditMoNumber = null
    let _woStatusTypes = []

    async function loadWoStatusTypes() {
        try {
            const res = await api('/workorder/wo-status-types', 'GET')
            _woStatusTypes = Array.isArray(res) ? res : []
            const sel = document.getElementById('woStatus')
            sel.innerHTML = '<option value="">All Status</option>' +
                _woStatusTypes.map(t => `<option value="${t.id}">${t.name}</option>`).join('')
        } catch (_) {}
    }

    function woStatusBadge(statusId) {
        const found = _woStatusTypes.find(t => t.id === statusId)
        const name = found?.name ?? (statusId ?? '—')
        const nameLc = String(name).toLowerCase()
        if (nameLc === 'active')   return `<span class="badge-status badge-open">${name}</span>`
        if (nameLc === 'closed')   return `<span class="badge-status badge-closed">${name}</span>`
        if (nameLc === 'inactive') return `<span class="badge-status" style="background:var(--amber-lt);color:var(--amber)">${name}</span>`
        return `<span class="badge-status badge-closed">${name}</span>`
    }

    function renderWoStatusButtons(currentStatusId) {
        const found = _woStatusTypes.find(t => t.id === currentStatusId)
        const currentNameLc = (found?.name ?? '').toLowerCase()
        const btns = [
            { action: 'reopen',   label: 'Active',   match: 'active',   bg: 'var(--green-lt)', color: 'var(--green)' },
            { action: 'inactive', label: 'Inactive', match: 'inactive', bg: 'var(--amber-lt)', color: 'var(--amber)' },
            { action: 'close',    label: 'Closed',   match: 'closed',   bg: '#f0f2f5',          color: 'var(--t2)' },
        ]
        document.getElementById('woStatusButtons').innerHTML = btns.map(b => {
            const isCurrent = b.match === currentNameLc
            const border = isCurrent ? `2px solid ${b.color}` : '1.5px solid transparent'
            return `<button class="modal-btn" ${isCurrent ? 'disabled' : `onclick="woChangeStatus('${b.action}')"`}
                style="flex:1;background:${b.bg};color:${b.color};border:${border};${isCurrent ? 'cursor:default' : 'cursor:pointer'}">
                ${b.label}${isCurrent ? ' ✓' : ''}
            </button>`
        }).join('')
    }

    function openWoEditModal(x) {
        _woEditMoNumber = x.moNumber ?? null
        document.getElementById('woEditMo').value    = x.moNumber   ?? ''
        document.getElementById('woEditModel').value = x.modelName  ?? ''
        document.getElementById('woEditLine').value  = x.lineName   ?? ''
        renderWoStatusButtons(x.status)
        clearModalError('woEditError')
        openModal('woEditModal')
    }

    async function woChangeStatus(action) {
        if (!_woEditMoNumber) return
        const segment = { close: 'close', inactive: 'Inactive', reopen: 'reopen' }[action]
        if (!segment) return
        try {
            await api(`/workorder/workorders/${encodeURIComponent(_woEditMoNumber)}/${segment}`, 'PUT')
            closeModal('woEditModal')
            showToast(`เปลี่ยนสถานะ ${_woEditMoNumber} สำเร็จ`, 'success')
            loadWorkOrders(_woPage)
        } catch (err) {
            showModalError('woEditError', err.message)
        }
    }

    async function loadWorkOrders(page = 1) {
        _woPage = page
        const search = document.getElementById('woSearch').value.trim()
        const model  = document.getElementById('woModel').value.trim()
        const line   = document.getElementById('woLine').value.trim()
        const status = document.getElementById('woStatus').value
        const ps     = parseInt(document.getElementById('woPageSize')?.value) || 10

        let url = `/master/workorders?page=${page}&pageSize=${ps}`
        if (search) url += `&moNumber=${encodeURIComponent(search)}`
        if (model)  url += `&model=${encodeURIComponent(model)}`
        if (line)   url += `&line=${encodeURIComponent(line)}`
        if (status) url += `&status=${status}`

        try {
            const res   = await api(url)
            const items = res?.data ?? []
            const total = res?.total ?? 0
            const cp    = res?.page ?? page

            document.getElementById('woCount').textContent = total + ' items'

            document.getElementById('workordersTable').innerHTML = items.length === 0
                ? `<tr><td colspan="5" style="text-align:center;color:var(--t3);padding:32px">No work orders found</td></tr>`
                : items.map(x => {
                    const syncDate = x.lastSyncedAt
                        ? new Date(x.lastSyncedAt).toLocaleString('th-TH', { dateStyle:'short', timeStyle:'short' })
                        : '—'
                    const syncAgo = x.lastSyncedAt ? timeAgo(new Date(x.lastSyncedAt)) : ''
                    return `<tr>
                        <td><span style="font-weight:700;color:var(--navy)">${x.moNumber ?? '—'}</span></td>
                        <td>${x.modelName ?? '—'}</td>
                        <td><span style="background:#f0f2f5;color:#475569;padding:2px 8px;border-radius:5px;font-size:11px;font-weight:600">${x.lineName ?? '—'}</span></td>
                        <td>${woStatusBadge(x.status)}</td>
                        <td>
                            <button onclick="openWoEditModal(${JSON.stringify(x).replace(/"/g,'&quot;')})"
                                style="background:none;border:none;cursor:pointer;color:var(--amber);font-size:16px;padding:4px 6px;border-radius:6px"
                                title="Edit"><i class="bi bi-pencil"></i></button>
                        </td>
                    </tr>`
                }).join('')

            renderPagination('woPagination', 'woPageInfo', cp, Math.ceil(total / ps) || 1, 'loadWorkOrders')
        } catch (err) {
            console.error('loadWorkOrders:', err)
            document.getElementById('workordersTable').innerHTML =
                `<tr><td colspan="5" style="text-align:center;color:var(--red);padding:32px">Load failed: ${err.message}</td></tr>`
        }
    }

    @* function timeAgo(date) {
        const s = Math.floor((Date.now() - date) / 1000)
        if (s < 60)    return `${s} วินาทีที่แล้ว`
        if (s < 3600)  return `${Math.floor(s/60)} นาทีที่แล้ว`
        if (s < 86400) return `${Math.floor(s/3600)} ชั่วโมงที่แล้ว`
        return `${Math.floor(s/86400)} วันที่แล้ว`
    } *@

    loadWoStatusTypes().then(() => loadWorkOrders(1))
</script>
}
