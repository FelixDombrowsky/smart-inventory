@{
    ViewData["Title"] = "Move Materials";
}
<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --green:#059669; --green-lt:#ecfdf5;
    --red:#dc2626; --red-lt:#fef2f2; --amber:#d97706; --amber-lt:#fffbeb;
}

.page-header {
    background:linear-gradient(135deg,var(--navy) 0%,#1e3a6e 60%,#1a6fff 100%);
    border-radius:16px; padding:20px 28px; margin-bottom:20px;
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
    position:relative; overflow:hidden;
}
.page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04); }
.page-header h2 { font-size:22px; font-weight:700; color:#fff; margin-bottom:4px; }

/* ── Pallet recommendation ("Guide Book" checklist) — โผล่มุมขวาบนของ header ตอนสแกน lot ที่มี palletNo ผูกอยู่ +
   อยู่ที่ location type Warehouse เท่านั้น (แนะนำเฉยๆ ก่อน ต้องกดถึงจะเห็น checklist) ── */
.mv-pallet-reco-btn {
    display:flex; align-items:center; gap:8px; padding:9px 16px; border-radius:20px;
    background:var(--amber); color:#fff; border:none; font-size:13px; font-weight:700;
    cursor:pointer; font-family:inherit; box-shadow:0 2px 10px rgba(217,119,6,.4);
    transition:filter .15s; position:relative; z-index:2; flex-shrink:0;
}
.mv-pallet-reco-btn:hover { filter:brightness(1.08); }
.mv-pallet-reco-btn .bi-chevron-down { transition:transform .15s; font-size:11px; }
.mv-pallet-reco-btn.open .bi-chevron-down { transform:rotate(180deg); }
.mv-pallet-checklist {
    width:300px; max-height:360px; overflow-y:auto;
    background:#fff; border:1px solid var(--border); border-radius:12px; box-shadow:0 14px 36px rgba(0,0,0,.22);
    padding:8px;
}
.mv-pallet-checklist-head { font-size:12px; font-weight:700; color:var(--navy); padding:6px 8px 10px; border-bottom:1px solid var(--border); margin-bottom:4px; }
.mv-pallet-checklist-item { display:flex; align-items:center; gap:8px; padding:7px 8px; border-radius:8px; font-size:13px; color:var(--text); }
.mv-pallet-checklist-item.in-list { color:var(--blue); }
.mv-pallet-checklist-item.type-match { color:var(--green); }
.mv-pallet-checklist-item .chk {
    width:18px; height:18px; border-radius:5px; display:flex; align-items:center; justify-content:center;
    flex-shrink:0; border:1.5px solid var(--border); color:#fff;
}
/* ติ๊กสีฟ้า = อยู่ใน Move List แล้ว (สแกนเข้ามาแล้ว) — มาก่อนเสมอถ้าเข้าเงื่อนไขทั้งคู่ (สแกนแล้ว + type ตรงกับ Destination ด้วย) */
.mv-pallet-checklist-item.in-list .chk { background:var(--blue); border-color:var(--blue); }
/* ติ๊กสีเขียว = ยังไม่ได้สแกน แต่ Location Type ของ lot ตรงกับ Destination Location ที่เลือกไว้อยู่แล้ว */
.mv-pallet-checklist-item.type-match .chk { background:var(--green); border-color:var(--green); }

/* Group lot ตาม Part No. ใน checklist — pallet ใบเดียวอาจมีหลาย part ปนกัน */
.mv-pallet-part-group { margin-bottom:6px; }
.mv-pallet-part-group:last-child { margin-bottom:0; }
.mv-pallet-part-head {
    display:flex; align-items:center; gap:6px; padding:6px 8px;
    font-size:11px; font-weight:700; color:var(--t2); text-transform:uppercase; letter-spacing:.03em;
    background:#f8f9fc; border-radius:6px; margin-bottom:2px;
}

.rp-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.rp-card-head {
    padding:12px 18px; border-bottom:1px solid var(--border);
    font-size:13px; font-weight:700; color:var(--navy);
    display:flex; align-items:center; gap:8px;
}
.rp-card-body { padding:18px 20px; }

/* Location */
.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:10px 12px 10px 38px;
    border:1.5px solid var(--border); border-radius:10px;
    font-size:14px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item { padding:10px 14px; font-size:13px; cursor:pointer; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; transition:.12s; }
.loc-item:last-child  { border-bottom:none; }
.loc-item:hover       { background:var(--blue-lt); }
.loc-item:first-child { border-radius:8px 8px 0 0; }
.loc-item:last-child  { border-radius:0 0 8px 8px; }

/* Icon buttons */
.icon-btn {
    width:34px; height:34px; border-radius:9px; border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:16px;
    transition:.15s; flex-shrink:0;
}
.icon-btn:disabled { opacity:.35; cursor:not-allowed; }

/* Barcode-type toggle (Our vs Vendor) — pill segmented control */
.bc-mode-group {
    display:flex; align-items:center; gap:2px; flex-shrink:0;
    height:44px; padding:3px; box-sizing:border-box;
    background:#eef1f6; border-radius:11px;
}
.bc-mode-btn {
    display:flex; align-items:center; gap:6px;
    height:100%; padding:0 14px; border:none; border-radius:8px;
    background:transparent; color:var(--t2); font-size:13px; font-weight:600;
    font-family:inherit; cursor:pointer; transition:.15s; white-space:nowrap;
}
.bc-mode-btn i { font-size:15px; }
.bc-mode-btn:hover:not(.active) { color:var(--navy); }
.bc-mode-btn.active { background:#fff; color:var(--navy); box-shadow:0 1px 3px rgba(0,0,0,.12); }
.bc-mode-btn.active i { color:var(--blue); }

/* Counter badge */
.count-badge {
    font-size:11px; font-weight:700; padding:2px 9px;
    border-radius:20px; background:var(--blue-lt); color:var(--blue);
}

/* Table */
.rx-table { width:100%; border-collapse:collapse; font-size:13px; }
.rx-table th {
    background:#f8f9fc; color:var(--t2); font-weight:700; font-size:11px;
    letter-spacing:.04em; text-transform:uppercase;
    padding:10px 16px; border-bottom:2px solid var(--border); text-align:left;
}
.rx-table td { padding:9px 16px; border-bottom:1px solid var(--border); vertical-align:middle; }
.rx-table tr:last-child td { border-bottom:none; }
.rx-table tbody tr:hover td { background:#fafbff; }
.rx-table tbody tr.row-err td { background:var(--red-lt); }
.rx-table tbody tr.row-err td:first-child { border-left:3px solid var(--red); }
.rx-table tbody tr.row-err-detail td { background:var(--red-lt); border-top:1px solid #fecaca; border-left:3px solid var(--red); padding:4px 14px 7px; }
.rx-table tbody tr.row-ok  td { background:var(--green-lt); opacity:.6; transition:opacity .4s; }
.del-btn { width:30px; height:30px; border:none; border-radius:7px; background:#fef2f2; color:var(--red); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.del-btn:hover { background:var(--red); color:#fff; }
.uid-edit-btn { width:30px; height:30px; border:none; border-radius:7px; background:var(--blue-lt); color:var(--blue); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.uid-edit-btn:hover { background:var(--blue); color:#fff; }
.mv-act-btn { height:26px; padding:0 10px; border:none; border-radius:6px; font-size:11px; font-weight:700; cursor:pointer; font-family:inherit; transition:.12s; display:inline-flex; align-items:center; gap:4px; }
.mv-retry-btn { background:#fff3cd; color:#856404; }
.mv-retry-btn:hover { background:#ffc107; color:#fff; }
.mv-edit-btn  { background:#e8f0ff; color:var(--blue); }
.mv-edit-btn:hover  { background:var(--blue); color:#fff; }
.row-processing td { opacity:.5; pointer-events:none; }
.empty-state { padding:36px; text-align:center; color:var(--t3); font-size:13px; }

/* Move button */
.move-btn {
    width:100%; padding:14px; border:none; border-radius:12px;
    font-size:15px; font-weight:700; font-family:inherit; cursor:pointer;
    transition:.2s; background:var(--blue); color:#fff; margin-top:4px;
}
.move-btn:disabled { background:#e5e7eb; color:#9ca3af; cursor:not-allowed; }
.move-btn:not(:disabled):hover { background:var(--blue-dk); }

/* Toast */
.toast-wrap { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.toast-item { padding:11px 20px; border-radius:10px; font-size:13px; font-weight:600; color:#fff; box-shadow:0 4px 16px rgba(0,0,0,.18); animation:tIn .25s ease; min-width:160px; }
.toast-ok   { background:var(--green); }
.toast-err  { background:var(--red); }
.toast-warn { background:var(--amber); }
@@keyframes tIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:none} }
</style>

<div class="toast-wrap" id="toastWrap"></div>

<!-- ── Header ── -->
<div class="page-header">
    <h2 style="display:flex;align-items:center;gap:10px;margin:0">
        <span data-i18n="pageTitle">Move Materials</span>
        <i class="bi bi-box-arrow-right" style="opacity:.85;font-size:24px"></i>
    </h2>
    <!-- แนะนำ Pallet — เห็นเฉพาะตอนสแกน lot ที่มี palletNo ผูกอยู่ + อยู่ location type Warehouse (ดู mvMaybeRecommendPallet)
         กดถึงจะเห็น checklist ว่า scan lot ของ pallet นี้ไปแล้วกี่ตัว ไม่ auto-expand ตามที่ขอ -->
    <button id="mvPalletRecoBtn" class="mv-pallet-reco-btn" style="display:none" onclick="mvTogglePalletChecklist()">
        <i class="bi bi-box-seam"></i>
        <span id="mvPalletRecoLabel">—</span>
        <i class="bi bi-chevron-down"></i>
    </button>
    <div id="mvPalletChecklist" class="mv-pallet-checklist" style="display:none"></div>
</div>

<!-- ── 1. Destination Location ── -->
<div class="rp-card">
    <div class="rp-card-body">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
            <div style="flex:1;min-width:180px">
                <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                    <i class="bi bi-geo-alt-fill me-1" style="color:var(--blue)"></i><span data-i18n="destinationLocation">Destination Location</span>
                </div>
                <div class="loc-wrap">
                    <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                    <input id="locationSearch" class="loc-input"
                           placeholder="ค้นหา Destination Location…" data-i18n-placeholder="locationSearchPlaceholder"
                           autocomplete="off">
                    <input type="hidden" id="locationCode">
                    <div id="locationDropdown" class="loc-dd"></div>
                </div>
            </div>
            <!-- Barcode type: Our (QR) vs Vendor -->
            <div class="bc-mode-group" id="mvBcModeGroup" title="เลือกประเภท Barcode ที่จะอ่าน" data-i18n-title="barcodeModeTitle">
                <button type="button" class="bc-mode-btn active" data-mode="our" onclick="setMvBarcodeMode('our')" title="Our Barcode" data-i18n-title="ourBarcode">
                    <i class="bi bi-qr-code-scan"></i><span data-i18n="our">Our</span>
                </button>
                <button type="button" class="bc-mode-btn" data-mode="vendor" onclick="setMvBarcodeMode('vendor')" title="Vendor Barcode" data-i18n-title="vendorBarcode">
                    <i class="bi bi-upc"></i><span data-i18n="vendor">Vendor</span>
                </button>
            </div>
            <!-- Camera -->
            <button id="mvCamBtn" class="icon-btn" title="Camera scan" data-i18n-title="cameraScan"
                    style="background:var(--blue);color:#fff;width:44px;height:44px;font-size:20px;flex-shrink:0"
                    onclick="mvToggleCam()">
                <i class="bi bi-camera-fill"></i>
            </button>
            <!-- HW Scanner -->
            <button id="mvHwBtn" class="icon-btn" title="HW scanner" data-i18n-title="hwScanner"
                    style="background:#6b7280;color:#fff;width:44px;height:44px;font-size:20px;flex-shrink:0"
                    onclick="mvToggleHwScan()">
                <i class="bi bi-upc-scan"></i>
            </button>
        </div>
    </div>
</div>

<!-- ── Camera section ── -->
    <partial name="_BarcodeScannerSection" />

<!-- ── 2. Item List ── -->
<div class="rp-card" style="overflow:visible">
    <div class="rp-card-head">
        <i class="bi bi-box-arrow-right" style="color:var(--blue)"></i>
        <span data-i18n="moveList">Move List</span>
        <span class="count-badge" id="mvCountBadge">0</span>
        <div style="margin-left:auto">
            <button id="mvManualBtn" onclick="mvToggleManual()"
                    style="padding:5px 14px;border:1.5px solid var(--border);border-radius:7px;background:#fff;color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s;white-space:nowrap"
                    onmouseover="this.style.borderColor='var(--blue)';this.style.color='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--t2)'">
                <i class="bi bi-pencil me-1"></i><span data-i18n="manual">Manual</span>
            </button>
        </div>
    </div>

    <!-- Manual Search Section (inline) -->
    <div id="mvManualSection" style="display:none;padding:12px 16px;border-bottom:1px solid var(--border);background:#f8faff">
        <div style="position:relative">
            <i class="bi bi-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--blue);font-size:14px;pointer-events:none"></i>
            <input id="mvManualInput"
                   class="loc-input"
                   style="padding-left:38px;border-color:var(--blue);background:#fff"
                   placeholder="พิมพ์ Lot No เพื่อค้นหา…" data-i18n-placeholder="manualSearchPlaceholder"
                   autocomplete="off"
                   oninput="mvManualAutocomplete()"
                   onkeydown="if(event.key==='Escape')mvToggleManual();else if(event.key==='Enter'){event.preventDefault();mvManualEnter();}"
                   onblur="setTimeout(mvHideLotDd,200)">
            <div id="mvManualDd" class="loc-dd"></div>
        </div>
    </div>

    <!-- HW Scanner Section (inline) -->
    <partial name="_HwScannerSection" />

    

    <!-- Table -->
    <div style="overflow-x:auto">
        <table class="rx-table">
            <thead>
                <tr>
                    <th data-i18n="colPartNo">Part No</th>
                    <th data-i18n="colLotNo">Lot No</th>
                    <th data-i18n="colUniqueId">Unique ID</th>
                    <th data-i18n="colFrom">From</th>
                    <th data-i18n="colTo">To</th>
                    <th style="text-align:right" data-i18n="colQty">QTY</th>
                    <th style="width:46px"></th>
                </tr>
            </thead>
            <tbody id="moveTable">
                <tr id="mvEmptyRow">
                    <td colspan="7" class="empty-state">
                        <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                        <span data-i18n="emptyState">ยังไม่มีรายการ — สแกน QR หรือกด Manual</span>
                    </td>
                </tr>
            </tbody>

        </table>
    </div>
</div>

<!-- ── 3. Advanced Options (collapsible) ── -->
<partial name="_AdvancedOptions" />

<!-- ── Remark (optional) — ย้ายมาไว้ใต้ Advanced Options ตามที่ขอ — ส่งเป็น string เดียวใช้ร่วมกันทั้ง batch (ตาม schema ใหม่ของ /inventory/move) ── -->
<div class="rp-card">
    <div class="rp-card-body">
        <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
            <i class="bi bi-chat-left-text me-1" style="color:var(--t3)"></i><span data-i18n="remark">Remark</span>
            <span style="font-weight:400;color:var(--t3)" data-i18n="optional">(optional)</span>
        </div>
        <input id="mvRemark" class="loc-input" style="padding-left:14px" placeholder="Remark…" data-i18n-placeholder="remarkPlaceholder" maxlength="500">
    </div>
</div>

<!-- ── Move button ── -->
<button class="move-btn" id="moveBtn" onclick="submitMove()" disabled data-i18n="moveBtn">Move</button>

<partial name="_PhotoCapture" model="@("mv")" />

<!-- ── Edit Unique ID modal ── -->
<div id="editUidModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)closeEditUniqueId()">
    <div style="background:#fff;border-radius:14px;width:90%;max-width:360px;padding:20px;box-shadow:0 12px 40px rgba(0,0,0,.2)">
        <div style="font-size:15px;font-weight:700;color:var(--navy);margin-bottom:14px" data-i18n="editUniqueId">Edit Unique ID</div>
        <input id="editUidInput" class="loc-input" style="padding-left:12px" autocomplete="off">
        <div style="display:flex;gap:8px;margin-top:16px">
            <button onclick="closeEditUniqueId()" style="flex:1;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit" data-i18n="cancel">Cancel</button>
            <button onclick="saveEditUniqueId()" style="flex:1;padding:11px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit" data-i18n="save">Save</button>
        </div>
    </div>
</div>

<!-- ── Confirm Delete modal ── -->
<div id="confirmDeleteModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)cancelDeleteRow()">
    <div style="background:#fff;border-radius:14px;width:90%;max-width:320px;padding:24px 20px 16px;box-shadow:0 12px 40px rgba(0,0,0,.2);text-align:center">
        <i class="bi bi-trash3" style="font-size:36px;color:var(--red);display:block;margin-bottom:12px"></i>
        <p style="font-size:14px;font-weight:700;color:var(--navy);margin:0 0 4px" data-i18n="confirmDeleteTitle">ลบรายการนี้?</p>
        <p id="deletePartLabel" style="font-size:12px;color:var(--t2);margin:0 0 16px;word-break:break-all"></p>
        <div style="display:flex;gap:8px">
            <button onclick="cancelDeleteRow()" style="flex:1;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit" data-i18n="cancel">ยกเลิก</button>
            <button onclick="confirmDeleteRow()" style="flex:1;padding:11px;background:var(--red);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit" data-i18n="deleteAction">ลบ</button>
        </div>
    </div>
</div>

<!-- ── Pick Lot modal (raw barcode เดียวกันผูกกับหลาย lot ให้เลือก) ── -->
<div id="mvPickLotModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)closeMvPickLot()">
    <div style="background:#fff;border-radius:14px;width:90%;max-width:360px;max-height:70vh;display:flex;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.2)">
        <div style="padding:16px 18px 10px;font-size:15px;font-weight:700;color:var(--navy);flex-shrink:0"><span data-i18n="pickLotTitle">เลือก Lot ที่ต้องการ</span> (<span id="mvPickLotCount">0</span> <span data-i18n="items">รายการ</span>)</div>
        <div id="mvPickLotList" style="overflow-y:auto;padding:0 10px 10px"></div>
        <div style="padding:10px 18px 16px;flex-shrink:0">
            <button onclick="closeMvPickLot()" style="width:100%;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit" data-i18n="cancel">ยกเลิก</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/apiForm.js"></script>
<script src="js/photoCapture.js"></script>
<script src="js/barcodeScanner.js"></script>
<script src="js/hwScanner.js"></script>
<script src="js/scanPipeline.js"></script>
<script src="js/locationAutocomplete.js"></script>
<script src="lib/html5-qrcode/html5-qrcode.min.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/locationTypeMeta.js"></script>
<script>
    // ── State ─────────────────────────────────────────
    let scannedLots = new Set();

    // คำแปลของหน้านี้ (MOVE_LABELS มาจาก js/i18n.js) — เรียก mvDict() สดทุกจุดที่สร้างข้อความแทน hardcode
    function mvDict() { return MOVE_LABELS[getCurrentLang()] || MOVE_LABELS.en }

    // ── Scan pipeline (decode + cooldown + queue ใช้ร่วมกันทั้งกล้องและ HW scanner) ──
    function mvScanSetStatus(t) {
        const statusCam = document.getElementById('bcStatus');
        const statusHw  = document.getElementById('hwStatus');
        if (statusCam) statusCam.textContent = t;
        if (statusHw)  statusHw.textContent  = t;
    }

    // ดึง lot เต็มตาม lotNo แล้วเพิ่มเข้าลิสต์ Move — ใช้ร่วมกันทั้งตอนสแกนเจอ lot เดียว และตอนเลือกจาก picker modal
    async function mvAddScannedLot(lotNo, uniqueId) {
        if (!lotNo) { toast(mvDict().noLotPleaseReceive, 'err'); return; }
        if (scannedLots.has(lotNo)) { toast(mvDict().scanDuplicate + lotNo, 'warn'); return; }

        const res  = await api('/inventory/lots', 'POST', { lotNo, page: 1, pageSize: 1 });
        const list = Array.isArray(res) ? res : (res?.data ?? []);
        const lot  = list[0];

        // ไม่มี lot นี้ในระบบ
        if (!lot) { toast(mvDict().noLot + lotNo, 'err'); return; }
        console.log('[Move][Scan] lot →', lot)

        if (mvIsSameAsDestination(lot)) { mvWarnSameLocation(lot); return; }

        scannedLots.add(lotNo);
        addRow({ ...lot, uniqueId });
        toast('✓ ' + lotNo, 'ok');
    }

    // ── Barcode type toggle (Our QR vs Vendor label) ──
    // default 'our' — ตรงกับพฤติกรรมเดิมของ mode 'ours' ที่ลอง Our Barcode ก่อน
    let mvBarcodeMode = 'our'
    function setMvBarcodeMode(m) {
        mvBarcodeMode = m
        document.querySelectorAll('#mvBcModeGroup .bc-mode-btn').forEach(btn =>
            btn.classList.toggle('active', btn.dataset.mode === m))
        toast(mvDict().scanModeLabel + (m === 'our' ? mvDict().ourBarcode : mvDict().vendorBarcode), 'ok')
    }

    const mvScan = createScanPipeline({
        mode: 'ours',
        barcodeFilter: () => mvBarcodeMode,
        onResult: async ({ lotNo, uniqueId, matches, notOurFormat, wrongModeOur }) => {
            mvScanSetStatus(mvDict().processing);
            try {
                if (wrongModeOur) return; // สแกน Our Barcode ทั้งที่ตั้งโหมดเป็น Vendor — เงียบไว้ ไม่ต้องแจ้งอะไร
                if (notOurFormat) return; // สแกน Vendor Barcode ทั้งที่ตั้งโหมดเป็น Our — เงียบไว้เหมือนกัน
                if (!mvRequireDestination()) return; // ต้องเลือก Destination Location ก่อนเสมอ ถึงจะสแกนเข้า List ได้
                if (Array.isArray(matches) && matches.length > 1) {
                    // raw barcode เดียวกัน match หลาย lot — ให้ผู้ใช้เลือกเองว่าจะเอา lot ไหนเข้าลิสต์
                    await openMvPickLot(matches)
                    return
                }
                await mvAddScannedLot(lotNo, uniqueId)
            } finally {
                mvScanSetStatus(mvDict().readyToScan);
            }
        }
    });

    // ── Pick Lot modal (raw barcode ผูกกับหลาย lot) ──
    // เพื่อโชว์ Lot/W-O/Part/Qty ให้ครบตอนเลือก ต้องดึง /inventory/lots ของทุกตัวมาก่อน (ลิสต์นี้ปกติมีไม่กี่รายการ
    // ต่างจาก Check Stock ที่อาจ match หลายสิบ lot เลยดึงแบบ lazy — อันนี้โชว์ทีเดียวทั้งลิสต์ให้เทียบกันได้เลย)
    let _mvPickLots = []

    async function openMvPickLot(matches) {
        document.getElementById('mvPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px"><span class="spinner-border spinner-border-sm me-2"></span>${mvDict().loadingData}</div>`
        document.getElementById('mvPickLotModal').style.display = 'flex'

        // บังคับ availableOnly เสมอ — lot ที่ของหมด/ไม่ available จะไม่ถูกคืนมาจาก API เลย (lot: null) กรองทิ้งไม่ให้ขึ้นในลิสต์ให้เลือก
        const fetched = await Promise.all((matches || []).map(async m => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: m.lotNo, page: 1, pageSize: 1, availableOnly: true })
                const list = Array.isArray(res) ? res : (res?.data ?? [])
                return { lotNo: m.lotNo, uniqueId: m.uniqueId, lot: list[0] ?? null }
            } catch (_) {
                return { lotNo: m.lotNo, uniqueId: m.uniqueId, lot: null }
            }
        }))
        _mvPickLots = fetched.filter(m => m.lot)
        document.getElementById('mvPickLotCount').textContent = _mvPickLots.length

        if (!_mvPickLots.length) {
            document.getElementById('mvPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px">${mvDict().noAvailableLot}</div>`
            return
        }

        document.getElementById('mvPickLotList').innerHTML = _mvPickLots.map((m, i) => {
            const lot = m.lot || {}
            return `<button onclick="mvPickLotSelect(${i})" style="width:100%;text-align:left;padding:11px 10px;border:none;border-bottom:1px solid #eee;background:#fff;cursor:pointer;font-family:inherit">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:3px">
                    <span style="font-weight:700;color:var(--navy);font-family:ui-monospace,monospace;font-size:13px">${m.lotNo ?? '—'}</span>
                    <span style="font-size:13px;font-weight:700;color:var(--blue)">${lot.onHandQty ?? '—'} ${lot.unit ?? ''}</span>
                </div>
                <div style="font-size:12px;color:var(--t2);display:flex;gap:12px;flex-wrap:wrap">
                    <span>W/O: ${lot.workOrder || '—'}</span>
                    <span>Part: ${lot.partNo || '—'}</span>
                </div>
            </button>`
        }).join('')
    }

    function closeMvPickLot() {
        document.getElementById('mvPickLotModal').style.display = 'none'
        _mvPickLots = []
    }

    function mvPickLotSelect(i) {
        const m = _mvPickLots[i]
        closeMvPickLot()
        if (!m) return
        if (!m.lot) { toast(mvDict().noLot + m.lotNo, 'err'); return }
        if (scannedLots.has(m.lotNo)) { toast(mvDict().scanDuplicate + m.lotNo, 'warn'); return }
        if (mvIsSameAsDestination(m.lot)) { mvWarnSameLocation(m.lot); return }
        scannedLots.add(m.lotNo)
        addRow({ ...m.lot, uniqueId: m.uniqueId })
        toast('✓ ' + m.lotNo, 'ok')
    }
    let mvLatitude = 0, mvLongitude = 0, mvAltitude = null;
    let _mvMoving = false;

    const mvPhoto = createPhotoCapture({ prefix: "mv", maxDimension: 1920 });

    const mvScanner = createBarcodeScanner({
        videoId: 'bcVideo', canvasId: 'bcCanvas', labelId: 'bcLabel',
        onDetect: raw => mvScan.submit(raw)
    });

    function mvShowError(id, show) {
        const el = document.getElementById(id);
        if (!el) return;
        el.style.transition  = 'border-color .15s, box-shadow .15s';
        el.style.borderColor = show ? 'var(--red)' : '';
        el.style.boxShadow   = show ? '0 0 0 3px rgba(220,38,38,.15)' : '';
    }

    // ต้องเลือก Destination Location ก่อนเสมอ ถึงจะสแกน/ค้นหา Lot เข้า List ได้ — เรียกจุดนี้เดียวจากทุกทาง (scan กล้อง/HW,
    // manual select, manual Enter, submitMove) กันพลาดไม่ครบทาง ถ้ายังไม่เลือกจะโชว์กรอบแดง + เลื่อนจอไป focus ช่อง + toast
    function mvRequireDestination() {
        if (document.getElementById('locationCode').value) return true;
        mvShowError('locationSearch', true);
        document.getElementById('locationSearch').scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => document.getElementById('locationSearch').focus(), 300);
        toast(mvDict().pleaseSelectDestination, 'err');
        return false;
    }

    // กัน lot ที่ From Location ตรงกับ Destination ที่เลือกไว้อยู่แล้ว (ย้ายไปที่เดิมไม่มีประโยชน์) — เช็คก่อน scannedLots.add()
    // เสมอ ไม่งั้นถ้าปฏิเสธไปแล้วแต่ดันจำ lotNo ไว้ใน scannedLots ก่อน จะสแกนซ้ำอีกทีตอนเปลี่ยน destination ไม่ได้เลย
    function mvIsSameAsDestination(lot) {
        const fromCode = lot?.location ?? lot?.locationCode ?? null;
        const toCode   = document.getElementById('locationCode').value;
        return !!fromCode && !!toCode && fromCode === toCode;
    }
    function mvWarnSameLocation(lot) {
        const fromCode = lot?.location ?? lot?.locationCode ?? '';
        toast(`${mvDict().lotAlreadyInLocation} ${locName(fromCode) || fromCode}`, 'warn');
    }

    window.addEventListener('beforeunload', (e) => {
        if (mvScanner.running) stopScan();
        if (document.querySelectorAll('#moveTable tr[data-lot-no]').length > 0) {
            e.preventDefault();
            e.returnValue = '';
        }
    });

    // ── Role: show Advanced Options for admin only ─────
    let isAdmin = false;
    (function() {
        const adminRoles = ['Admin'];
        try {
            const user       = JSON.parse(localStorage.getItem('user') || '{}');
            const userRoles  = Array.isArray(user.roles) ? user.roles : [];
            const userPermis = Array.isArray(user.permissions) ? user.permissions : [];

            if (userRoles.some(r => adminRoles.includes(r))) {
                isAdmin = true;
            }

            applyAdvancedOptionsPermissions(userPermis, isAdmin);

            // ปุ่มสลับ Scan Mode (Our/Vendor) — ต้องมี permission นี้ถึงจะเห็น ไม่งั้นซ่อนแล้วใช้ Our เป็น default เสมอ
            const canReadBarcodeVendor = isAdmin || userPermis.includes("WMS.UI.ReadBarcodeVendor");
            document.getElementById('mvBcModeGroup').style.display = canReadBarcodeVendor ? '' : 'none';
        } catch (_) {}
    })();

    // ── Manual Search ─────────────────────────────────
    let _mvManualTimer = null, _mvManualResults = [];

    function mvToggleManual() {
        const sec = document.getElementById('mvManualSection');
        const open = sec.style.display === 'none';
        sec.style.display = open ? '' : 'none';
        if (open) setTimeout(() => document.getElementById('mvManualInput').focus(), 50);
        else mvHideLotDd();
    }

    function mvHideLotDd() {
        document.getElementById('mvManualDd').style.display = 'none';
    }

    function mvManualAutocomplete() {
        const inp  = document.getElementById('mvManualInput');
        const dd   = document.getElementById('mvManualDd');
        const text = inp.value.trim();
        if (!text) { dd.style.display = 'none'; return; }

        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <i class="bi bi-hourglass-split me-2"></i>${mvDict().searching}</div>`;
        dd.style.display = 'block';

        clearTimeout(_mvManualTimer);
        _mvManualTimer = setTimeout(async () => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: text });
                const list = Array.isArray(res) ? res : (res?.data || []);
                if (!list.length) {
                    _mvManualResults = [];
                    dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                        <i class="bi bi-search me-2"></i>${mvDict().noLotFound}</div>`;
                    return;
                }
                _mvManualResults = list;
                dd.innerHTML = list.map((l, i) => `
                    <div class="loc-item" onmousedown="mvManualSelect(${i})">
                        <div>
                            <div style="font-weight:700;font-size:13px">${esc(l.lotNo || '')}</div>
                            ${l.partNo ? `<div style="font-size:11px;color:var(--t3)">${esc(l.partNo)}</div>` : ''}
                        </div>
                        <span style="margin-left:auto;font-size:11px;color:var(--t2)">${esc(locName(l.location ?? l.locationCode ?? ''))}</span>
                    </div>`).join('');
                dd.style.display = 'block';
            } catch (err) {
                _mvManualResults = [];
                dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                    <i class="bi bi-exclamation-circle me-2"></i>${esc(err.message || mvDict().errorGeneric)}</div>`;
            }
        }, 300);
    }

    function mvManualSelect(i) {
        const lot = _mvManualResults[i];
        if (!lot) return;
        if (!mvRequireDestination()) return;
        mvHideLotDd();
        document.getElementById('mvManualInput').value = '';
        if (scannedLots.has(lot.lotNo)) { toast(mvDict().scanDuplicate + lot.lotNo, 'warn'); return; }
        if (mvIsSameAsDestination(lot)) { mvWarnSameLocation(lot); return; }
        scannedLots.add(lot.lotNo);
        addRow(lot);
        toast('✓ ' + lot.lotNo, 'ok');
    }

    function mvManualEnter() {
        const val = document.getElementById('mvManualInput').value.trim();
        if (!val) return;
        if (!mvRequireDestination()) return;
        const dd = document.getElementById('mvManualDd');
        clearTimeout(_mvManualTimer);
        // ถ้า dropdown กำลังแสดงผลลัพธ์อยู่ ให้เลือกตัวแรกในลิสต์ทันที
        if (dd.style.display !== 'none' && _mvManualResults.length) {
            mvManualSelect(0);
            return;
        }
        mvHideLotDd();
        document.getElementById('mvManualInput').value = '';
        // ไม่มีผลลัพธ์ให้เลือก — เพิ่มแถวจากค่าที่พิมพ์เป็น lotNo ตรงๆ
        if (scannedLots.has(val)) { toast(mvDict().scanDuplicate + val, 'warn'); return; }
        scannedLots.add(val);
        addRow({ lotNo: val });
        toast('✓ ' + val, 'ok');
    }

    // ── HW Scanner ────────────────────────────────────
    const mvHwScanner = createHwScanner({
        inputId: 'hwInput', statusId: 'hwStatus',
        onScan: raw => mvScan.submit(raw)
    });

    function mvToggleHwScan() {
        const section = document.getElementById('hwSection');
        const btn     = document.getElementById('mvHwBtn');
        if (mvHwScanner.active) {
            mvHwScanner.close();
            section.style.display = 'none';
            btn.style.background  = '#6b7280';
        } else {
            section.style.display = '';
            btn.style.background  = 'var(--red)';
            if (mvScanner.running) mvToggleCam();
            mvHwScanner.open();
        }
    }

    // ── Camera ────────────────────────────────────────
    function mvToggleCam() { if (mvScanner.running) stopScan(); else startCam(); }

    function setCamBtn(running) {
        const btn = document.getElementById('mvCamBtn');
        btn.style.background = running ? '#dc2626' : 'var(--blue)';
    }

    // เปิดกล้องแสกน
    async function startCam() {
        // Close HW scan if open
        const hwSection = document.getElementById('hwSection');
        if (hwSection.style.display !== 'none') mvToggleHwScan();

        // แสดง ui ของ barcode section
        document.getElementById('bcSection').style.display = '';
        document.getElementById('bcStatus').textContent = mvDict().scanningInProgress;
        // เปลี่ยนปุ่มกล้องเป็นสีแดง
        setCamBtn(true);

        try {
            // barcodeScanner.js -> ขอสิทธิ์กล้อง (getUserMedis), สร้า่ง BarcodeDetector, เริ้ม loop แสกน
            await mvScanner.start();
            setTorchBtn(mvScanner.hasTorch());
        } catch (err) {
            toast(err.message.includes('BarcodeDetector') ? err.message : mvDict().cameraAccessError + err.message, 'err');
            document.getElementById('bcSection').style.display = 'none';
            setCamBtn(false);
        }
    }

    function stopScan() {
        mvScanner.stop();
        document.getElementById('bcSection').style.display = 'none';
        setCamBtn(false);
        setTorchBtn(false);
    }

    async function switchCamera() {
        await mvScanner.switchCamera();
        setTorchBtn(mvScanner.hasTorch());
    }

    function setTorchBtn(visible) {
        const btn = document.getElementById('bcTorchBtn');
        btn.style.display = visible ? 'flex' : 'none';
        btn.classList.remove('active');
    }

    async function toggleTorch() {
        const on = await mvScanner.toggleTorch();
        document.getElementById('bcTorchBtn').classList.toggle('active', on);
    }

    // ── Table ─────────────────────────────────────────
    function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    // Location badge สีและ icon ตาม Location Type จริง (จาก _locNameMap) — ใช้ทั้งคอลัมน์ From และ To
    function _mvLocBadge(code) {
        const name = locName(code) || code || '—'
        const type = _locNameMap.get(code)?.typeName
        if (!type) return `<span style="background:#f0f2f5;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--t2)">${esc(name)}</span>`
        return `<span style="display:inline-flex;align-items:center;gap:5px;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;${locTypeBadgeStyle(type)}">${locHierTypeIcon(type)}${esc(name)}</span>`
    }

    function addRow(lot) {
        if (navigator.vibrate) navigator.vibrate(120)
        const empty = document.getElementById('mvEmptyRow');
        if (empty) empty.remove();

        //console.log("Log Data : ", lot)

        const fromLoc = lot.location ?? lot.locationCode ?? '—';
        // locationCode คือ code จริงที่ยืนยันแล้วจากการเลือกใน autocomplete (ใช้ lookup type ใน _locNameMap ได้) — locationSearch เป็นแค่ข้อความที่พิมพ์/แสดงอยู่ ใช้ fallback เฉยๆ ถ้ายังไม่เคยเลือกจริง
        const toLoc   = document.getElementById('locationCode').value || document.getElementById('locationSearch').value.trim() || '—';
        const qty     = lot.onHandQty ?? lot.available ?? 0;

        document.getElementById('moveTable').insertAdjacentHTML('beforeend', `
            <tr data-lot-no="${esc(lot.lotNo)}" data-unique-id="${esc(lot.uniqueId ?? '')}">
                <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${esc(lot.partNo ?? lot.itemPartNo ?? '—')}</td>
                <td style="color:var(--blue);font-weight:600;font-size:12px">${esc(lot.lotNo)}</td>
                <td data-uid-cell style="font-family:ui-monospace,monospace;font-size:12px;color:var(--t2);max-width:140px;white-space:normal;word-break:break-all">${esc(lot.uniqueId ?? '—')}</td>
                <td>${_mvLocBadge(fromLoc)}</td>
                <td data-to-cell>${_mvLocBadge(toLoc)}</td>
                <td style="text-align:right;font-weight:700;color:var(--navy)">${qty.toLocaleString()}</td>
                <td style="width:76px;white-space:nowrap">
                    <div style="display:flex;gap:6px;flex-wrap:nowrap">
                        ${isAdmin ? `<button class="uid-edit-btn" onclick="openEditUniqueId(this)" title="${mvDict().editUniqueId}"><i class="bi bi-pencil"></i></button>` : ''}
                        <button class="del-btn" onclick="removeRow(this)" title="${mvDict().remove}"><i class="bi bi-trash3"></i></button>
                    </div>
                </td>
            </tr>`);

        updateCounter();
        mvMaybeRecommendPallet(lot)
        if (_mvPalletChecklistOpen) mvRenderPalletChecklist()
    }

    // ── Pallet recommendation ("Guide Book" checklist) ──────────────────────────────────────────
    // สแกน lot เข้ามาแล้วเช็คจากผลลัพธ์ /inventory/lots เดิม (ไม่ยิง API เพิ่ม): 1) มี palletNo ผูกอยู่ไหม 2) locationType
    // ปัจจุบันของ lot นั้นเป็น Warehouse ไหม — ถ้าใช่ทั้งคู่ แสดงว่า lot นี้อาจเป็นแค่ส่วนหนึ่งของทั้ง pallet ที่ยังอยู่ใน
    // คลัง แนะนำ pallet นั้นขึ้นมาที่ปุ่มมุมขวาบนของ header (ไม่ auto-expand — user ต้องกดเองถึงจะเห็น checklist รายชื่อ lot
    // ทั้งหมดใน pallet พร้อมเช็คว่า scan เข้า Move List ไปแล้วกี่ตัว ใช้เป็น guide สแกนให้ครบทั้ง pallet)
    let _mvPalletNo            = null
    let _mvPalletLots          = []      // [{lotNo, ...}] จาก /mat-pallets/{no}/lots
    let _mvPalletChecklistOpen = false

    function mvMaybeRecommendPallet(lot) {
        const palletNo = lot?.palletNo
        const locType  = (lot?.locationType || '').trim().toLowerCase()
        if (!palletNo || locType !== 'warehouse') return
        if (palletNo === _mvPalletNo) return   // pallet เดิม — ไม่ต้อง fetch ซ้ำ, checklist (ถ้าเปิดอยู่) จะ refresh เองจาก addRow() ที่เรียกมา
        mvSetRecommendedPallet(palletNo)
    }

    async function mvSetRecommendedPallet(palletNo) {
        _mvPalletNo            = palletNo
        _mvPalletChecklistOpen = false
        document.getElementById('mvPalletChecklist').style.display = 'none'
        const btn = document.getElementById('mvPalletRecoBtn')
        btn.classList.remove('open')
        btn.style.display = ''
        document.getElementById('mvPalletRecoLabel').textContent = palletNo
        try {
            const res = await api(`/mat-pallets/${encodeURIComponent(palletNo)}/lots`, 'GET')
            const rawLots = Array.isArray(res) ? res : (res?.data ?? [])
            // /mat-pallets/{no}/lots เองมีแค่ lotNo/addedAt/addedBy ไม่มี location/locationType/onHandQty ให้ — ต้องยิง
            // /inventory/lots เพิ่มทีละ lot แบบขนาน (เหมือน palEnrichLots ใน _Pallet.cshtml) ถึงจะเอามาโชว์ badge+จำนวนได้
            _mvPalletLots = await Promise.all(rawLots.map(async l => {
                try {
                    const r = await api('/inventory/lots', 'POST', { lotNo: l.lotNo, page: 1, pageSize: 1 })
                    const d = (Array.isArray(r) ? r : (r?.data ?? []))[0]
                    return { ...l, partNo: d?.partNo ?? null, location: d?.location ?? null, locationType: d?.locationType ?? null, onHandQty: d?.onHandQty ?? null }
                } catch (_) {
                    return { ...l, partNo: null, location: null, locationType: null, onHandQty: null }
                }
            }))
        } catch (err) {
            console.warn('[Move] mvSetRecommendedPallet failed:', err)
            _mvPalletLots = []
        }
        mvRenderPalletChecklist()
    }

    // Location Type ของ Destination ที่เลือกไว้อยู่ตอนนี้ (locationCode = code จริงที่ยืนยันแล้วจาก autocomplete)
    function _mvDestinationLocType() {
        const code = document.getElementById('locationCode')?.value
        if (!code) return null
        return (_locNameMap.get(code)?.typeName || '').trim()
    }

    // .page-header มี overflow:hidden (ตัดขอบมุมโค้ง) ถ้าวาง checklist เป็น position:absolute ลูกของมันตรงๆ จะโดนตัดจนไม่เห็น
    // เลย (แม้ display:block ก็ตาม) — ต้องย้ายไปเป็นลูกของ body แล้ว position:fixed คำนวณพิกัดเองจากปุ่มแทน (pattern เดียวกับ
    // dropdown ค้นหาอื่นๆ ในแอปที่โดนปัญหานี้ เช่น _bomPositionDd ใน BomProfiles.cshtml)
    function _mvPositionPalletChecklist() {
        const btn = document.getElementById('mvPalletRecoBtn')
        const box = document.getElementById('mvPalletChecklist')
        if (!btn || !box) return
        if (box.parentElement !== document.body) document.body.appendChild(box)
        const r = btn.getBoundingClientRect()
        box.style.position = 'fixed'
        box.style.top      = (r.bottom + 8) + 'px'
        box.style.right    = (window.innerWidth - r.right) + 'px'
        box.style.left     = 'auto'
        box.style.zIndex   = '1200'
    }

    function mvTogglePalletChecklist() {
        if (!_mvPalletNo) return
        _mvPalletChecklistOpen = !_mvPalletChecklistOpen
        if (_mvPalletChecklistOpen) _mvPositionPalletChecklist()
        document.getElementById('mvPalletChecklist').style.display = _mvPalletChecklistOpen ? 'block' : 'none'
        document.getElementById('mvPalletRecoBtn').classList.toggle('open', _mvPalletChecklistOpen)
        if (_mvPalletChecklistOpen) mvRenderPalletChecklist()
    }

    // ติ๊กมี 2 สถานะแยกกัน ไม่ใช่ตัวเดียวเหมือนก่อนหน้านี้:
    // - ฟ้า (in-list)    = lot นี้อยู่ใน Move List แล้ว (สแกน/เพิ่มเข้ามาแล้วจริงๆ) — เช็คจาก scannedLots ตัวเดิม
    // - เขียว (type-match) = ยังไม่ได้สแกน แต่ Location Type ปัจจุบันของ lot ตรงกับ Location Type ของ Destination ที่เลือกไว้อยู่แล้ว
    // ถ้าเข้าเงื่อนไขทั้งคู่ (สแกนไปแล้ว + type ตรงด้วย) ให้ฟ้าชนะ เพราะ "อยู่ใน list แล้วจริงๆ" เป็นสถานะที่ชัดเจน/สำคัญกว่า
    function mvRenderPalletChecklist() {
        const box = document.getElementById('mvPalletChecklist')
        if (!box || !_mvPalletNo) return
        if (!_mvPalletLots.length) {
            box.innerHTML = `<div class="mv-pallet-checklist-head">Pallet ${esc(_mvPalletNo)}</div>
                <div style="padding:10px 8px;color:var(--t3);font-size:12px">ไม่พบ Lot ใน Pallet นี้</div>`
            return
        }
        const destType   = (_mvDestinationLocType() || '').toLowerCase()
        const inList     = l => scannedLots.has(l.lotNo)
        const typeMatch  = l => destType && (l.locationType || '').trim().toLowerCase() === destType
        const inListCount    = _mvPalletLots.filter(inList).length
        const typeMatchCount = _mvPalletLots.filter(l => !inList(l) && typeMatch(l)).length

        // Group by Part No. — ให้ล็อตของ part เดียวกันอยู่ด้วยกัน (pallet ใบเดียวอาจมีหลาย part ปนกัน) เรียงตามลำดับที่เจอ
        // part นั้นครั้งแรกใน _mvPalletLots (ไม่ใช่ A-Z) กัน layout กระโดดไปมาทุกครั้งที่ enrich เสร็จ
        const partOrder = []
        const byPart    = {}
        _mvPalletLots.forEach(l => {
            const p = l.partNo || '—'
            if (!byPart[p]) { byPart[p] = []; partOrder.push(p) }
            byPart[p].push(l)
        })

        const groupsHtml = partOrder.map(partNo => {
            const lots = byPart[partNo]
            const rowsHtml = lots.map(l => {
                const list  = inList(l)
                const match = !list && typeMatch(l)
                const cls   = list ? ' in-list' : (match ? ' type-match' : '')
                const qty   = l.onHandQty != null ? Number(l.onHandQty).toLocaleString() : '—'
                return `<div class="mv-pallet-checklist-item${cls}">
                    <span class="chk">${(list || match) ? '<i class="bi bi-check-lg" style="font-size:11px"></i>' : ''}</span>
                    <div style="flex:1;min-width:0">
                        <div style="font-family:ui-monospace,monospace;font-weight:600">${esc(l.lotNo)}</div>
                        <div style="margin-top:3px">${_mvLocBadge(l.location)}</div>
                    </div>
                    <div style="font-weight:700;color:var(--navy);flex-shrink:0">${qty}</div>
                </div>`
            }).join('')
            return `<div class="mv-pallet-part-group">
                <div class="mv-pallet-part-head"><i class="bi bi-upc-scan" style="font-size:11px"></i>${esc(partNo)}<span style="margin-left:auto;color:var(--t3);font-weight:600">${lots.length} lot${lots.length === 1 ? '' : 's'}</span></div>
                ${rowsHtml}
            </div>`
        }).join('')

        box.innerHTML = `<div class="mv-pallet-checklist-head">
                Pallet ${esc(_mvPalletNo)}<br>
                <span style="color:var(--blue)">● ${inListCount} in list</span> ·
                <span style="color:var(--green)">● ${typeMatchCount} same type</span>
            </div>` + groupsHtml
    }

    function mvClearPalletRecommendation() {
        _mvPalletNo            = null
        _mvPalletLots          = []
        _mvPalletChecklistOpen = false
        document.getElementById('mvPalletRecoBtn').style.display = 'none'
        document.getElementById('mvPalletChecklist').style.display = 'none'
    }

    // คลิกนอกปุ่ม/กล่อง checklist — ปิด dropdown (pattern เดียวกับ dropdown อื่นในแอป)
    document.addEventListener('click', e => {
        if (_mvPalletChecklistOpen && !e.target.closest('#mvPalletChecklist') && !e.target.closest('#mvPalletRecoBtn')) {
            mvTogglePalletChecklist()
        }
    })

    let _editUidRow = null

    function openEditUniqueId(btn) {
        _editUidRow = btn.closest('tr')
        document.getElementById('editUidInput').value = _editUidRow.dataset.uniqueId || ''
        document.getElementById('editUidModal').style.display = 'flex'
        document.getElementById('editUidInput').focus()
    }

    function closeEditUniqueId() {
        document.getElementById('editUidModal').style.display = 'none'
        _editUidRow = null
    }

    function saveEditUniqueId() {
        if (!_editUidRow) return
        const val = document.getElementById('editUidInput').value.trim()
        _editUidRow.dataset.uniqueId = val
        _editUidRow.querySelector('[data-uid-cell]').textContent = val || '—'
        closeEditUniqueId()
    }

    let _pendingDeleteRow = null

    function removeRow(btn) {
        _pendingDeleteRow = btn.closest('tr')
        document.getElementById('deletePartLabel').textContent = _pendingDeleteRow.querySelector('td:first-child').textContent.trim()
        document.getElementById('confirmDeleteModal').style.display = 'flex'
    }

    function cancelDeleteRow() {
        _pendingDeleteRow = null
        document.getElementById('confirmDeleteModal').style.display = 'none'
    }

    function confirmDeleteRow() {
        if (!_pendingDeleteRow) return
        scannedLots.delete(_pendingDeleteRow.dataset.lotNo);
        const nextRow = _pendingDeleteRow.nextElementSibling;
        if (nextRow?.classList.contains('row-err-detail')) nextRow.remove();
        _pendingDeleteRow.remove();
        _pendingDeleteRow = null
        document.getElementById('confirmDeleteModal').style.display = 'none'
        mvCheckEmpty();
        updateCounter();
        if (_mvPalletChecklistOpen) mvRenderPalletChecklist()
    }

    function mvCheckEmpty() {
        if (!document.querySelectorAll('#moveTable tr[data-lot-no]').length) {
            document.getElementById('moveTable').insertAdjacentHTML('beforeend', `
                <tr id="mvEmptyRow">
                    <td colspan="7" class="empty-state">
                        <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                        ${mvDict().emptyState}
                    </td>
                </tr>`);
            mvClearPalletRecommendation()   // list ว่างแล้ว ไม่มีอะไรให้ guide ต่อ — เคลียร์คำแนะนำ pallet ทิ้งด้วย
        }
    }

    function updateCounter() {
        const count = document.querySelectorAll('#moveTable tr[data-lot-no]').length;
        document.getElementById('mvCountBadge').textContent = count;
        const enabled = count > 0 && !_mvMoving;
        const btn = document.getElementById('moveBtn');
        btn.disabled      = !enabled;
        btn.style.opacity = enabled ? '1' : '0.45';
        btn.style.cursor  = enabled ? 'pointer' : 'not-allowed';
        if (document.getElementById('locationCode').value) mvShowError('locationSearch', false);
    }

    // ── Submit (batched + photo confirmation) ─────────
    function _setRowAction(row, html) {
        const lastTd = row.cells[row.cells.length - 1];
        if (lastTd) lastTd.innerHTML = html;
    }

    function _setRowError(row, errMsg) {
        row.classList.add('row-err');
        _setRowAction(row, `
            ${isAdmin ? `<button class="uid-edit-btn" onclick="openEditUniqueId(this)" title="${mvDict().editUniqueId}"><i class="bi bi-pencil"></i></button>` : ''}
            <button class="del-btn" onclick="removeRow(this)" title="${mvDict().remove}"><i class="bi bi-trash3"></i></button>`);
        const existing = row.nextElementSibling;
        if (existing?.classList.contains('row-err-detail')) existing.remove();
        const colspan = row.cells.length;
        row.insertAdjacentHTML('afterend', `
            <tr class="row-err-detail">
                <td colspan="${colspan}"><span style="font-size:11px;color:var(--red);font-weight:600">${esc(errMsg)}</span></td>
            </tr>`);
    }

    async function submitMove() {
        const rows = [...document.querySelectorAll('#moveTable tr[data-lot-no]')];
        if (!rows.length || _mvMoving) return;

        // Validate: Destination Location
        if (!mvRequireDestination()) return;

        // ครบแล้ว → เปิด modal ถ่ายรูปยืนยัน (ข้ามได้ถ้าติ๊ก Skip Upload Images Validation)
        if (document.getElementById('advSkipImg').checked) {
            doMove();
        } else {
            mvPhoto.open();
        }
    }

    // ── Send (กดจากปุ่ม Send ใน modal ถ่ายรูป) ───────
    async function doMove() {
        if (_mvMoving) return;
        _mvMoving = true;
        updateCounter();

        const sendBtn = document.getElementById('mvPcSendBtn');
        sendBtn.disabled = true;

        try {
            const toCode = document.getElementById('locationCode').value;

            // ── GPS ───────────────────────────────────────
            mvLatitude = 0; mvLongitude = 0; mvAltitude = null;
            if (!document.getElementById('advSkipGps').checked) {
                if (!navigator.geolocation) { toast(mvDict().browserNoGps, 'err'); return; }
                sendBtn.innerHTML = `<i class="bi bi-geo-alt"></i> ${mvDict().gettingGps}`;
                try {
                    const pos = await new Promise((res, rej) =>
                        navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
                    );
                    mvLatitude  = pos.coords.latitude;
                    mvLongitude = pos.coords.longitude;
                    mvAltitude = pos.coords.altitude;
                } catch (e) {
                    toast(mvDict().gpsError + e.message, 'err'); return;
                }
            }
            sendBtn.innerHTML = `<i class="bi bi-hourglass-split"></i> ${mvDict().movingInProgress}`;

            const rows = [...document.querySelectorAll('#moveTable tr[data-lot-no]')];

            if (!rows.length) { toast(mvDict().noItems, 'err'); return; }

            // /inventory/move (แทน /inventory/re-locate เดิม) เปลี่ยน schema payload — toLocationCode/remark/latitude/longitude/
            // zHeigth ยกออกมาเป็นค่าเดียวใช้ร่วมกันทั้ง batch (ไม่ต้องวนซ้ำต่อ lot แบบเดิม) เหลือแค่ lotNo/uniqueId ใน command[]
            const command = rows.map(row => ({
                lotNo: row.dataset.lotNo,
                uniqueId: row.dataset.uniqueId || ''
            }));
            const options = getAdvancedOptions();

            console.log('[Move] command →', command);
            console.log('[Move] advancedOptions →', options);

            // reset UI ทุกแถวก่อนยิง
            rows.forEach(row => {
                const errDetail = row.nextElementSibling;
                if (errDetail?.classList.contains('row-err-detail')) errDetail.remove();
                row.classList.remove('row-err', 'row-ok');
                row.classList.add('row-processing');
                _setRowAction(row, `<span style="font-size:12px;color:var(--t2)">⏳</span>`);
            });

            let successCount = 0, failCount = 0;
            try {
                const res  = await apiForm('/inventory/move', {
                    command, options,
                    toLocationCode: toCode,
                    remark: document.getElementById('mvRemark').value.trim(),
                    latitude: mvLatitude,
                    longitude: mvLongitude,
                    zHeigth: mvAltitude
                }, mvPhoto.getBlobs(), 10000);
                const data = Array.isArray(res) ? res : (res?.data || []);
                const globalErr = data.find(d => !d.lotNo && !(d.sucess || d.success));
                console.log("Res Data : ", data)

                for (const row of rows) {
                    const lotNo    = row.dataset.lotNo;
                    const results  = data.filter(d => d.lotNo === lotNo);
                    const failures = results.filter(d => !(d.sucess || d.success));
                    row.classList.remove('row-processing');

                    if (failures.length) {
                        failCount++;
                        const errMsgs = failures.map(d => [d.errorCode, d.message].filter(Boolean).join(': ') || 'Error');
                        _setRowError(row, errMsgs.join(', '));
                    } else {
                        successCount++;
                        row.classList.add('row-ok');
                        setTimeout(() => { row.remove(); mvCheckEmpty(); updateCounter(); }, 600);
                        scannedLots.delete(lotNo);
                    }
                }

                if (globalErr) {
                    toast(`❌ ${[globalErr.errorCode, globalErr.message].filter(Boolean).join(': ')}`, 'err');
                }
            } catch (err) {
                failCount = rows.length;
                const errMsg = err.message || 'Error';
                toast(`❌ ${errMsg}`, 'err');
                rows.forEach(row => {
                    row.classList.remove('row-processing');
                    _setRowError(row, errMsg);
                });
            }

            if (failCount === 0)       toast(`${mvDict().moveSuccess} ${successCount} ${mvDict().items} ✓`, 'ok');
            else if (successCount > 0) toast(`${mvDict().success} ${successCount} ${mvDict().items} — ${mvDict().failed} ${failCount} ${mvDict().items}`, 'warn');
            else                       toast(`${mvDict().failed} ${failCount} ${mvDict().items}`, 'err');
        } finally {
            _mvMoving = false;
            updateCounter();
            sendBtn.innerHTML = mvDict().send;
            mvPhoto.close();
            document.getElementById('mvRemark').value = '';   // เคลียร์ Remark หลังส่ง payload เสร็จทุกครั้ง (ตามที่ขอ) — ไม่ให้ค้างไปใช้ซ้ำ batch ถัดไปโดยไม่ตั้งใจ
        }
    }

    document.getElementById('mvPcSendBtn').addEventListener('click', doMove);
    document.getElementById('mvPcCancelBtn').addEventListener('click', () => mvPhoto.close());

    

    // ── Fallback keyboard HW scanner ─────────────────
    // (ใช้เมื่อ focus อยู่นอก input ใดๆ)
    ;(function() {
        let _buf = '', _timer = null;
        const THRESHOLD = 150, MIN = 4;
        function commit() {
            const c = _buf; _buf = '';
            if (c.length >= MIN) mvScan.submit(c);
        }
        document.addEventListener('keydown', e => {
            if (mvScanner.running) return;
            const active = document.activeElement;
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) return;
            if (e.key === 'Enter') { clearTimeout(_timer); commit(); return; }
            if (e.key.length === 1) { _buf += e.key; clearTimeout(_timer); _timer = setTimeout(commit, THRESHOLD); }
        });
    })();

    // ── Auto-open camera from ?openCamera=1 (sticky shortcut from OpDashboard) ──
    if (new URLSearchParams(window.location.search).get('openCamera') === '1') {
        startCam()
    }

    // ── Toast ─────────────────────────────────────────
    function toast(msg, type) {
        const wrap = document.getElementById('toastWrap');
        const el   = document.createElement('div');
        el.className = 'toast-item ' + (type === 'ok' ? 'toast-ok' : type === 'warn' ? 'toast-warn' : 'toast-err');
        el.textContent = msg;
        wrap.appendChild(el);
        setTimeout(() => el.remove(), type === 'warn' ? 5000 : 3000);
    }

    // แปลภาษาหน้านี้ทั้งหมด — เรียกตอน init และทุกครั้งที่กดสลับภาษา (ผูกผ่าน window.onLangChange ที่ _Layout.cshtml เรียกให้)
    function applyMoveLang() {
        applyDataI18n(mvDict())
        applyAdvancedOptionsLang()
    }
    window.onLangChange = applyMoveLang

    async function init(){
        applyMoveLang()
        await loadLocation()
        await loadPerLocation()

        // ── Location search ───────────────────────────────
        const mvLocAuto = createLocationAutocomplete({
            inputId:    'locationSearch',
            dropdownId: 'locationDropdown',
            locations:  myLocations,
            // เพิ่ม pin icon นำหน้าเฉพาะหน้านี้ (default renderer ของ locationAutocomplete.js เอาออกไปแล้วเพื่อหน้าอื่นๆ)
            renderItem: (loc, i) => `<div class="loc-item" data-idx="${i}">
                <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0"></i>
                <span style="min-width:0">
                    <strong>${esc(loc.displayName || '')}</strong>
                    <span style="color:var(--t2);font-size:12px;margin-left:6px">${esc(loc.locationCode)}</span>
                </span>
                <span style="margin-left:auto;flex-shrink:0">${locTypeBadge(loc.typeName)}</span>
            </div>`,
            onSelect: loc => {
                if (loc) {
                    document.getElementById('locationCode').value = loc.locationCode;
                    mvShowError('locationSearch', false);
                    const toBadge = loc.typeName
                        ? `<span style="display:inline-flex;align-items:center;gap:5px;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;${locTypeBadgeStyle(loc.typeName)}">${locHierTypeIcon(loc.typeName)}${esc(loc.displayName || loc.locationCode)}</span>`
                        : `<span style="background:#f0f2f5;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--t2)">${esc(loc.displayName || loc.locationCode)}</span>`;
                    document.querySelectorAll('#moveTable tr[data-lot-no] td[data-to-cell]').forEach(td => {
                        td.innerHTML = toBadge;
                    });
                }
                updateCounter();
                if (_mvPalletChecklistOpen) mvRenderPalletChecklist()   // เงื่อนไข checked อิง Location Type ของ Destination — เปลี่ยน Destination แล้วต้อง refresh checklist ด้วย
            },
            onClear: () => {
                document.getElementById('locationCode').value = '';
                updateCounter();
                if (_mvPalletChecklistOpen) mvRenderPalletChecklist()
            }
        });

    }

    init()
</script>
}
