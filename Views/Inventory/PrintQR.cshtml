    // ── Custom printer dropdown ──
    const _RP_PD = [
        { ns: 'rp',        menuId: 'rpPrinterMenu',       hiddenId: 'rpPrinterSelect'       },
        { ns: 'rpReprint', menuId: 'rpReprintPrinterMenu', hiddenId: 'rpReprintPrinterSelect' },
        { ns: 'asm',       menuId: 'asmPrinterMenu',       hiddenId: 'asmPrinterSelect'      },
    ]

    function rpPrinterDdToggle(ns) {
        const menu    = document.getElementById(ns + 'PrinterMenu')
        const trigger = document.getElementById(ns + 'PrinterTrigger')
        if (!menu) return
        const opening = menu.style.display === 'none'
        rpPrinterDdCloseAll()
        if (opening) {
            menu.style.display = ''
            trigger?.classList.add('open')
        }
    }

    function rpPrinterDdCloseAll() {
        document.querySelectorAll('.rp-pd-menu').forEach(m => m.style.display = 'none')
        document.querySelectorAll('.rp-pd-trigger').forEach(t => t.classList.remove('open'))
    }

    document.addEventListener('click', e => {
        if (!e.target.closest('.rp-pd-wrap')) rpPrinterDdCloseAll()
    })

    function rpPrinterPickFromEl(el) {
        rpPrinterPick(el.dataset.ns, el.dataset.ip, el.dataset.name, el.dataset.online === 'true')
    }

    function rpPrinterPick(ns, ip, name, online) {
        const hidden = document.getElementById(ns + 'PrinterSelect')
        if (hidden) hidden.value = ip

        const dot = document.getElementById(ns + 'PrinterDot')
        if (dot) { dot.className = 'rp-pd-dot' + (online ? ' online' : ''); dot.style.display = '' }
        const nameEl = document.getElementById(ns + 'PrinterName')
        if (nameEl) { nameEl.textContent = name; nameEl.style.color = ''; nameEl.style.fontWeight = '600' }
        const ipEl = document.getElementById(ns + 'PrinterIp')
        if (ipEl) { ipEl.textContent = ip; ipEl.style.display = '' }

        document.getElementById(ns + 'PrinterMenu')?.querySelectorAll('.rp-pd-item').forEach(item => {
            const sel = item.dataset.ip === ip
            item.classList.toggle('active', sel)
            const chk = item.querySelector('.rp-pd-check')
            if (chk) chk.style.display = sel ? '' : 'none'
        })
        rpPrinterDdCloseAll()
        if (ns === 'rpReprint') rprSyncPrintBtn()
    }

    // ── Printer discovery ──
    async function rpLoadPrinters() {
        _RP_PD.forEach(c => {
            const m = document.getElementById(c.menuId)
            if (m) m.innerHTML = '<div class="rp-pd-msg"><span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>Loading…</div>'
        })

        let allPrinters = []
        try {
            const res = await api('/printer/all', 'GET')
            allPrinters = Array.isArray(res) ? res : (res?.data ?? [])
        } catch (err) {
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (m) m.innerHTML = '<div class="rp-pd-msg" style="color:var(--red)">⚠️ Load failed</div>'
            })
            showToast('Failed to load printers: ' + err.message, 'error')
            return
        }

        if (allPrinters.length === 0) {
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (m) m.innerHTML = '<div class="rp-pd-msg">No printers found</div>'
            })
            return
        }

        const buildItems = (ns, onlineIps) =>
            allPrinters.filter(p => p.isActive !== false).map(p => {
                const online = onlineIps.has(p.printerIp)
                return `<div class="rp-pd-item"
                             data-ns="${escHtml(ns)}"
                             data-ip="${escHtml(p.printerIp)}"
                             data-name="${escHtml(p.printerName.replace(/[\r\n]+/g,' ').trim())}"
                             data-online="${online}"
                             data-ip="${escHtml(p.printerIp)}"
                             onclick="rpPrinterPickFromEl(this)">
                    <span class="rp-pd-dot${online ? ' online' : ''}"></span>
                    <div class="rp-pd-info">
                        <span class="rp-pd-item-name">${escHtml(p.printerName.replace(/[\r\n]+/g,' ').trim())}</span>
                        <span class="rp-pd-item-ip">${escHtml(p.printerIp)}</span>
                    </div>
                    <i class="bi bi-check2 rp-pd-check" style="display:none"></i>
                </div>`
            }).join('')

        _RP_PD.forEach(c => {
            const m = document.getElementById(c.menuId)
            if (m) m.innerHTML = buildItems(c.ns, new Set())
        })

        // discover online printers and update dots
        try {
            const disc      = await api('/printer/discover', 'GET')
            const discArr   = Array.isArray(disc) ? disc : (disc?.data ?? disc?.printers ?? [])
            const onlineIps = new Set(discArr.map(p => p.printerIp || p.ip || '').filter(Boolean))
            _RP_PD.forEach(c => {
                const m = document.getElementById(c.menuId)
                if (!m) return
                const prevIp = document.getElementById(c.hiddenId)?.value
                m.innerHTML = buildItems(c.ns, onlineIps)
                if (prevIp) {
                    m.querySelectorAll('.rp-pd-item').forEach(item => {
                        const sel = item.dataset.ip === prevIp
                        item.classList.toggle('active', sel)
                        const chk = item.querySelector('.rp-pd-check')
                        if (chk) chk.style.display = sel ? '' : 'none'
                    })
                    const dot = document.getElementById(c.ns + 'PrinterDot')
                    if (dot) dot.className = 'rp-pd-dot' + (onlineIps.has(prevIp) ? ' online' : '')
                }
            })
        } catch { /* keep without online indicator */ }
    }

    // ── Print modal ──
    function rpShowPrintModal() {
        if (rpItems.length === 0) { showToast('No items in list', 'error'); return }
        if (_rpPrinting) return
        if (!document.getElementById('rpPrinterSelect')?.value) {
            showToast('กรุณาเลือก Printer ก่อน', 'error')
            const trigger = document.getElementById('rpPrinterTrigger')
            trigger?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
            trigger?.focus()
            return
        }
        const unreviewed = rpItems.filter(i => !i.reviewed).length
        if (unreviewed > 0) {
            showToast(`Please review all items first (${rpItems.length - unreviewed}/${rpItems.length} reviewed)`, 'error')
            return
        }
        rpPrint('receive')
    }

    async function rpPrint(mode) {
        if (rpItems.length === 0) return
        if (mode === 'receive' && !rpReceiveLocationCode) {
            showToast('Please select a Receive Location first', 'error'); return
        }
        const printerIp = document.getElementById('rpPrinterSelect')?.value
        if (!printerIp) { showToast('Please select a printer', 'error'); return }

        _rpPrinting = true
        rpRenderList()

        for (const item of [...rpItems]) {
            await _rpProcessItem(item, printerIp, mode)
        }

        _rpPrinting = false
        if (rpItems.length === 0) {
            showToast(`🖨️ All items printed${mode === 'receive' ? ' & received' : ''} successfully`, 'success')
        }
        rpRenderList()
    }

    function _rpBuildReceivePayload(item) {
        return {
            lotNo:        item.data.lotNo        ?? '',
            partNo:       item.data.partNo       ?? '',
            description:  item.data.description  ?? '',
            workOrderNo:  item.data.workOrder    ?? item.data.workOrderNo ?? '',
            locationCode: rpReceiveLocationCode  ?? '',
            quantity:     +item.data.quantity    || 0,
            unit:         item.data.unit         ?? '',
            traceId:      item.data.traceId      ?? item.data._barcode   ?? '',
            vendor:       item.data.vendor       ?? '',
            dateCode:     item.data.dateCode     ?? '',
            tradingCode:  item.data.tradingCode  ?? '',
            po:           item.data.po           ?? '',
            inventoryNo:  item.data.inventoryNo  ?? '',
            itemType:     item.data.itemType     ?? 1,
            latitude:     rpReceiveLat           ?? 0,
            longitude:    rpReceiveLng           ?? 0,
        }
    }

    async function _rpProcessItem(item, printerIp, mode) {
        item.processing   = true
        item.receiveError = null
        item.printError   = null
        rpRenderList()

        // ── Receive step ──
        if (mode === 'receive' && !item.isReceived) {
            try {
                const res    = await api('/inventory/receive', 'POST', {
                    command: { items: [_rpBuildReceivePayload(item)] },
                    options: { skipManualLotValidation: true }
                })
                const data   = Array.isArray(res?.data) ? res.data : []
                const result = data[0]
                if (result && !result.sucess && !result.success) {
                    item.receiveError = result.message || result.errorCode || 'Receive failed'
                    item.processing   = false
                    showToast(`❌ ${item.data.lotNo || ''}: ${item.receiveError}`, 'error')
                    rpRenderList()
                    return
                }
                item.isReceived = true
            } catch (err) {
                item.receiveError = err.message || 'Receive failed'
                item.processing   = false
                showToast(`❌ ${item.data.lotNo || ''}: ${item.receiveError}`, 'error')
                rpRenderList()
                return
            }
        }

        // ── Print step ──
        try {
            const payload = {
                printerIp,
                lotNo: item.data.lotNo ?? '',
                zpl:   applyPrintOffset(item.zpl, rpLayoutConfig),
            }
            if (item.printAttempted) {
                payload.isReprint     = true
                payload.reprintReason = 'Re-Print in PrintReceive'
            }
            item.printAttempted = true
            const res = await api('/printer/send', 'POST', payload)
            const pd  = res?.problemDetails
            if (pd || (res?.statusCode && res.statusCode >= 400)) {
                const msg = [pd?.title, pd?.detail].filter(Boolean).join(': ') || res?.message || 'Print failed'
                item.printError = msg
                item.processing = false
                showToast(`❌ ${item.data.lotNo || ''}: ${msg}`, 'error')
                rpRenderList()
            } else {
                // Success — remove from list
                const i = rpItems.indexOf(item)
                if (i !== -1) {
                    if (item.data._barcode) rpScannedTrace.delete(item.data._barcode)
                    rpItems.splice(i, 1)
                }
                rpRenderList()
            }
        } catch (err) {
            item.printError = err.message || 'Print error'
            item.processing = false
            showToast(`❌ ${item.data.lotNo || ''}: ${item.printError}`, 'error')
            rpRenderList()
        }
    }

    async function rpRetryItem(idx) {
        if (_rpPrinting) return
        const item = rpItems[idx]
        if (!item) return
        const printerIp = document.getElementById('rpPrinterSelect')?.value
        if (!printerIp) { showToast('Please select a printer', 'error'); return }

        _rpPrinting = true
        await _rpProcessItem(item, printerIp, 'receive')
        _rpPrinting = false

        if (rpItems.length === 0) showToast('🖨️ All items completed!', 'success')
        rpRenderList()
    }

