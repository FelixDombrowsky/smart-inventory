    async function loadLayoutList() {
        const container = document.getElementById('layoutListContainer')
        container.innerHTML = '<div style="text-align:center;color:var(--t3);padding:32px">Loading…</div>'
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const arr = (Array.isArray(layouts) ? layouts : (layouts?.data || []))
                .sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0) - new Date(a.updatedAt ?? a.createdAt ?? 0))
            if (arr.length === 0) {
                container.innerHTML = '<div style="text-align:center;color:var(--t3);padding:32px">ยังไม่มี Layout — กด "+ New Layout" เพื่อสร้าง</div>'
                return
            }
            container.innerHTML = arr.map(l => {
                const config     = parseZplDataJson(l)
                const fields     = Array.isArray(config.labelFields) ? config.labelFields : []
                const visCount   = fields.filter(f => f.show).length
                const fieldBadge = fields.length > 0
                    ? `<span style="font-size:11px;background:var(--blue-lt);color:var(--blue);border-radius:20px;padding:2px 8px;font-weight:600">${visCount}/${fields.length} fields</span>`
                    : ''
                return `<div class="layout-item" onclick="openViewMode(${l.id})" style="cursor:pointer">
                    <div class="layout-item-icon">🗒️</div>
                    <div class="layout-item-info">
                        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                            <div class="layout-item-name">${escHtml(l.templateName ?? 'Untitled')}</div>
                            ${fieldBadge}
                        </div>
                        <div class="layout-item-meta">${escHtml(l.description ?? '')}</div>
                        <div style="display:flex;gap:12px;margin-top:4px;flex-wrap:wrap">
                            <span style="font-size:11px;color:var(--t3)">📅 ${fmtCreatedAt(l.createdAt) || '—'}</span>
                            <span style="font-size:11px;color:var(--t3)">✏️ ${fmtCreatedAt(l.updatedAt) || '—'}</span>
                        </div>
                    </div>
                    <button style="padding:6px 14px;border:1.5px solid var(--red);color:var(--red);background:var(--red-lt);border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap"
                            onclick="event.stopPropagation();deleteLayout(${l.id})">Delete</button>
                </div>`
            }).join('')
