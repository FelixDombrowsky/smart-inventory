<!DOCTYPE html>
<html lang="en">

<head>
    <base href="/wms/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SmartFactory Inventory</title>

    <link rel="icon" href="favicon.ico" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.min.css" />

    <script>
        // ใส่ธีม + สถานะ sidebar ย่อ ตั้งแต่ใน <head> กันจอกะพริบตอนโหลด (สีทั้งหมดอยู่ที่ css/site.css)
        (function () { try {
            document.documentElement.setAttribute('data-theme', localStorage.getItem('sf_theme') || 'light')
            if (localStorage.getItem('sf_side_collapsed') === '1') document.documentElement.classList.add('side-collapsed')
        } catch (_) {} })()

        // กันเมนูที่ไม่มีสิทธิ์โผล่แว็บตอนเปลี่ยนหน้า — ใช้รายการเมนูที่อนุญาตจากรอบก่อน (sf_nav_allowed, บันทึกใน setNavVisibility)
        // ซ่อนตั้งแต่ใน <head> ก่อน sidebar วาด / ยังไม่เคยมีค่า (เข้าครั้งแรกหลัง login) → ซ่อนเมนูทั้งก้อนจนเช็คสิทธิ์เสร็จ
        // setNavVisibility() ลบ style นี้ทิ้งเมื่อได้สิทธิ์จริงแล้ว (สิทธิ์เปลี่ยน = แก้ตามจริงทันที)
        ;(function () {
            let allowed = null
            try { allowed = JSON.parse(localStorage.getItem('sf_nav_allowed') || 'null') } catch (_) {}
            const css = Array.isArray(allowed)
                ? (allowed.length
                    ? `#mainNav a.sf-link:not(${allowed.map(id => '#' + id).join(',')}){display:none!important}` +
                      `#mainNav .sf-nav-group:not(:has(${allowed.map(id => '#' + id).join(',')})){display:none!important}`
                    : `#mainNav{visibility:hidden}`)
                : `#mainNav{visibility:hidden}`
            document.write(`<style id="navPreHide">${css}</style>`)
        })()
    </script>

</head>

<body>

    <!-- ── Page loader — คลุมทั้งหน้าระหว่างโหลด (กล่อง 3 ใบตกลงมาซ้อนกันบนพาเลท) — CSS ที่ css/site.css (.sf-loader)
         ปิดเมื่อหน้าโหลดเสร็จ + api() ชุดแรกตอบครบ (ทุกหน้าอัตโนมัติ) / กำหนดจุดปิดเองได้: SF_WAIT_READY = true + sfLoaderDone()
         หน้าที่โหลดเสร็จภายใน 1.5 วิ จะไม่เห็น loader เลย (โผล่แบบ delay — ดู .sf-loader ใน site.css) / กันค้าง: ปิดเองหลัง 10 วิเสมอ ── -->
    <div id="sfLoader" class="sf-loader" role="status" aria-live="polite">
        <div class="sf-loader-inner">
            <div class="sf-loader-boxes" aria-hidden="true"><span></span><span></span><span></span><i></i></div>
            <div class="sf-loader-brand">SmartFactory<small>Warehouse Management</small></div>
            <div class="sf-loader-bar" aria-hidden="true"><i></i></div>
            <span class="visually-hidden">Loading…</span>
        </div>
    </div>
    <script>
        ;(function () {
            const el = document.getElementById('sfLoader')
            let done = false
            // หน้าแรกหลัง login (Login.cshtml ตั้ง flag ไว้) → โชว์ทันทีไม่รอ delay + ค้างไว้อย่างน้อย 900ms ให้เห็นเป็นจังหวะเข้าระบบ
            let afterLogin = false
            try { afterLogin = sessionStorage.getItem('sf_after_login') === '1'; sessionStorage.removeItem('sf_after_login') } catch (_) {}
            // หน้าที่ตั้ง ViewData["LoaderNow"] = true → โชว์ทันทีเหมือนกัน (ค้างอย่างน้อย 400ms กันกระพริบ)
            const loaderNow = @((ViewData["LoaderNow"] as bool? ?? false) ? "true" : "false")
            const minShow   = afterLogin ? 900 : loaderNow ? 400 : 0
            const shownAt = Date.now()
            if (afterLogin || loaderNow) el.classList.add('sf-loader-now', 'sf-loader-shown')
            // จาง-เข้าเริ่มแล้ว (หลัง delay 1.5 วิ) → ตอนปิดให้จางออกนุ่มๆ + เริ่มบังการคลิก / ปิดก่อนนั้น = หายทันที ไม่เคยเห็น
            // (เช็ค target — animationstart ของกล่องข้างใน bubble ขึ้นมาด้วย ตั้งแต่ 0 วิ)
            el.addEventListener('animationstart', e => { if (e.target === el) el.classList.add('sf-loader-shown') })
            window.sfLoaderDone = function () {
                if (done) return
                const wait = minShow - (Date.now() - shownAt)
                if (wait > 0) { setTimeout(window.sfLoaderDone, wait); return }
                done = true
                el.classList.add('sf-loader-hide')
                setTimeout(() => el.remove(), 450)
            }
            // ปิดอัตโนมัติเมื่อ "หน้าโหลดเสร็จ + ไม่มี api() ค้างอยู่ต่อเนื่อง 250ms" (api.js เรียก sfNetBegin/sfNetEnd ให้ทุก request)
            // = รอข้อมูลชุดแรกของทุกหน้าโดยไม่ต้องแก้ทีละหน้า — 250ms กันปิดก่อนในจังหวะที่หน้ายิง request ต่อกันเป็นทอดๆ
            // หน้าที่อยากกำหนดจุดปิดเอง (เช่น Dashboard ปิดทันทีที่ตารางหลักมา ไม่รอกราฟ) ตั้ง SF_WAIT_READY แล้วเรียก sfLoaderDone()
            let inflight = 0, loaded = false, quietTimer = 0
            const checkIdle = () => {
                clearTimeout(quietTimer)
                if (!loaded || window.SF_WAIT_READY || inflight > 0) return
                quietTimer = setTimeout(() => { if (inflight === 0) window.sfLoaderDone() }, 250)
            }
            window.sfNetBegin = () => { inflight++; clearTimeout(quietTimer) }
            window.sfNetEnd   = () => { inflight = Math.max(0, inflight - 1); checkIdle() }
            window.addEventListener('load', () => { loaded = true; checkIdle() })
            setTimeout(window.sfLoaderDone, 10000)
        })()
    </script>

    <!-- ── Sidebar (navy) — id ของแต่ละหน้า (dashboardNav, lotsNav, ...) อยู่บน <a> — setNavVisibility() ซ่อนตามสิทธิ์ได้ตามปกติ
         กลุ่มที่ทุกหน้าในกลุ่มถูกซ่อนจะถูกซ่อนทั้งกลุ่ม (updateNavGroups()) / ≥1200px ย่อเหลือไอคอนได้, <1200px เป็น drawer ── -->
