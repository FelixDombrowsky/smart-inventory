@{
    ViewData["Title"] = "Assembly";
}
<!-- @@font-face ของ ZebraFont (ใช้ตอน render ZPL ผ่าน renderZplClient) — ประกาศไว้ที่ printqr.css ไฟล์เดียวกับ PrintQR.cshtml -->
<link rel="stylesheet" href="css/printqr.css"/>
<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --green:#059669; --green-lt:#ecfdf5;
    --red:#dc2626; --red-lt:#fef2f2; --amber:#d97706; --amber-lt:#fffbeb;
}

.page-header {
    background:linear-gradient(135deg,var(--navy) 0%,#1e3a6e 60%,#1a6fff 100%);
    border-radius:16px; padding:20px 28px; margin-bottom:20px;
    position:relative; overflow:hidden;
}
.page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04); }
.page-header h2 { font-size:22px; font-weight:700; color:#fff; margin-bottom:4px; }

.rp-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.rp-card-head {
    padding:12px 18px; border-bottom:1px solid var(--border);
    font-size:13px; font-weight:700; color:var(--navy);
    display:flex; align-items:center; gap:8px; justify-content:flex-start;
}
.rp-card-body { padding:18px 20px; }

.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:10px 12px 10px 38px;
    border:1.5px solid var(--border); border-radius:10px;
    font-size:14px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item { padding:10px 14px; font-size:13px; cursor:pointer; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; transition:.12s; }
.loc-item:last-child  { border-bottom:none; }
.loc-item:hover       { background:var(--blue-lt); }

.icon-btn {
    width:34px; height:34px; border-radius:9px; border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:16px;
    transition:.15s; flex-shrink:0;
}
.icon-btn:disabled { opacity:.35; cursor:not-allowed; }

/* Barcode-type toggle (Our vs Vendor) — pill segmented control */
.bc-mode-group {
    display:flex; align-items:center; gap:2px; flex-shrink:0;
    height:44px; padding:3px; box-sizing:border-box;
    background:#eef1f6; border-radius:11px;
}
.bc-mode-btn {
    display:flex; align-items:center; gap:6px;
    height:100%; padding:0 14px; border:none; border-radius:8px;
    background:transparent; color:var(--t2); font-size:13px; font-weight:600;
    font-family:inherit; cursor:pointer; transition:.15s; white-space:nowrap;
}
.bc-mode-btn i { font-size:15px; }
.bc-mode-btn:hover:not(.active) { color:var(--navy); }
.bc-mode-btn.active { background:#fff; color:var(--navy); box-shadow:0 1px 3px rgba(0,0,0,.12); }
.bc-mode-btn.active i { color:var(--blue); }

.count-badge {
    font-size:11px; font-weight:700; padding:2px 9px;
    border-radius:20px; background:var(--blue-lt); color:var(--blue);
}

.rx-table { width:100%; border-collapse:collapse; font-size:13px; }
.rx-table th {
    background:#f8f9fc; color:var(--t2); font-weight:700; font-size:11px;
    letter-spacing:.04em; text-transform:uppercase;
    padding:10px 16px; border-bottom:2px solid var(--border); text-align:left;
}
.rx-table td { padding:9px 16px; border-bottom:1px solid var(--border); vertical-align:middle; }
.rx-table tr:last-child td { border-bottom:none; }
.rx-table tbody tr:hover td { background:#fafbff; }
.rx-table tbody tr.row-split td:first-child { border-left:3px solid #8b5cf6; }
.rx-table tbody tr.row-split td { background:#faf5ff; }
.rx-table tbody tr.row-err td { background:var(--red-lt); }
.rx-table tbody tr.row-err td:first-child { border-left:3px solid var(--red); }
.rx-table tbody tr.row-err-detail td { background:var(--red-lt); border-top:1px solid #fecaca; border-left:3px solid var(--red); padding:4px 14px 7px; }
.del-btn { width:30px; height:30px; border:none; border-radius:7px; background:#fef2f2; color:var(--red); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.del-btn:hover { background:var(--red); color:#fff; }
.edit-btn { width:30px; height:30px; border:none; border-radius:7px; background:var(--amber-lt); color:var(--amber); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; margin-right:6px; }
.edit-btn:hover, .edit-btn.active { background:var(--amber); color:#fff; }
.row-processing td { opacity:.5; pointer-events:none; }
.empty-state { padding:36px; text-align:center; color:var(--t3); font-size:13px; }

.asm-row-filled { animation: asmFillIn .5s ease; }
@@keyframes asmFillIn { from { background:var(--blue-lt); } to { background:transparent; } }

/* ── Ammo-clip grouping: จัดกลุ่ม lot ของ part เดียวกันให้อยู่ติดกันเสมอ (ไม่ว่าจะสแกนสลับ part กันแค่ไหน)
   ใต้หัวกลุ่มมีแถบ progress ทรงหลอดกระสุน บอกว่าสแกนครบสัดส่วนตามสูตร BOM ของ "ชุดที่กำลังทำอยู่" หรือยัง
   (batch ปัจจุบันขยับตาม part ที่สแกนไปไกลที่สุด — ดู asmRecomputeGroups) ── */
.asm-group-head td { padding:12px 16px 10px; background:#fbfbfd; cursor:pointer; }
.asm-group-head:not(:first-child) td { border-top:1px solid var(--border); padding-top:16px; }
.ammo-row { display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
.ammo-toggle {
    width:22px; height:22px; border-radius:6px; border:1.5px solid var(--border); background:#fff;
    display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--t2); flex-shrink:0; padding:0; transition:.15s;
}
.ammo-toggle:hover { border-color:var(--blue); color:var(--blue); }
.ammo-toggle svg { transition:transform .15s; }
.asm-group-head.open .ammo-toggle { background:var(--blue); border-color:var(--blue); color:#fff; }
.asm-group-head.open .ammo-toggle svg { transform:rotate(90deg); }
.ammo-img {
    width:34px; height:34px; object-fit:cover; border-radius:7px; border:1px solid var(--border);
    background:#f8f9fc; cursor:zoom-in; flex-shrink:0;
}
.ammo-part { display:flex; align-items:center; gap:10px; flex-shrink:0; }
.ammo-part-text { display:flex; flex-direction:column; gap:1px; min-width:0; }
.ammo-part-no { font-family:ui-monospace,monospace; font-weight:700; font-size:13px; color:var(--navy); }
.ammo-part-name { font-size:10.5px; color:var(--t3); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:160px; }
.ammo-tube-wrap { display:flex; align-items:center; gap:9px; flex:1; min-width:140px; }
.ammo-tube {
    position:relative; flex:1; height:14px; border-radius:7px;
    background:repeating-linear-gradient(90deg, #edeef2 0 9px, #e3e5ea 9px 10px);
    overflow:hidden; border:1px solid var(--border); box-shadow:inset 0 1px 2px rgba(0,0,0,.05);
}
.ammo-tube-fill { height:100%; width:0%; border-radius:6px 2px 2px 6px; transition:width .35s cubic-bezier(.34,1.3,.64,1), background .3s; }
.ammo-tube-fill.partial { background:linear-gradient(90deg,#fbbf24,var(--amber)); }
.ammo-tube-fill.full    { background:linear-gradient(90deg,#34d399,var(--green)); box-shadow:0 0 8px rgba(5,150,105,.45); }
.ammo-tube-fill.over    { background:linear-gradient(90deg,#f87171,var(--red)); box-shadow:0 0 8px rgba(220,38,38,.45); }
.ammo-frac { font-size:11.5px; font-weight:700; color:var(--t3); white-space:nowrap; min-width:52px; text-align:right; }
.ammo-frac.partial { color:var(--amber); }
.ammo-frac.full     { color:var(--green); }
.ammo-frac.over     { color:var(--red); }

/* เซลล์แรกของแถว lot ในกลุ่ม (เดิมโชว์ Part No ซ้ำกับ header) เปลี่ยนเป็น connector บางๆ กันข้อมูลซ้ำ */
.asm-lot-connector { color:var(--border); font-size:13px; padding-left:24px !important; }

/* รูป Output Part (การ์ด Output Part ด้านบน) — ใหญ่กว่ารูปของ component ใน Materials เพราะเป็น "ตัวเอก" ของหน้านี้ */
.ammo-img-lg { width:56px; height:56px; object-fit:cover; border-radius:10px; border:1.5px solid var(--border); background:#f8f9fc; cursor:zoom-in; flex-shrink:0; }
.asm-output-preview { display:flex; align-items:center; gap:12px; margin-bottom:14px; padding-bottom:14px; border-bottom:1px solid var(--border); }
.asm-output-preview-text { display:flex; flex-direction:column; gap:2px; min-width:0; }
.asm-output-preview-text .ammo-part-no { font-size:15px; }
.asm-output-preview-text .ammo-part-name { font-size:12px; max-width:none; white-space:normal; }

.qty-input { width:100px; padding:7px 10px; border:1.5px solid var(--border); border-radius:8px; font-size:13px; font-family:inherit; text-align:right; outline:none; transition:.12s; }
.qty-input:focus { border-color:var(--blue); }
.qty-input.err { border-color:var(--red); background:#fff8f8; }
/* โหมดปกติ (ยังไม่กด Edit) — โชว์เป็นตัวเลขเฉยๆ ไม่มีกรอบ input ให้ดูรก กดปุ่ม Edit ก่อนถึงจะแก้ค่าได้ */
.qty-input[readonly] { border-color:transparent; background:transparent; color:var(--navy); font-weight:700; font-size:15px; cursor:default; padding-right:0; }
.qty-input[readonly]:focus { border-color:transparent; }

.asm-result-banner {
    display:none; padding:14px 18px; background:var(--green-lt); border:1px solid #a7f3d0; border-radius:12px;
    margin-bottom:16px; font-size:13px; color:var(--green); font-weight:600; align-items:center; gap:10px;
}

/* ── Print Panel (Layout Template + Label Preview + Printer) — แสดงทุก orientation ── */
.asm-right { margin-bottom:16px; }
.asm-preview-box {
    display:flex; align-items:center; justify-content:center; background:#f8f9fc;
    border:1px solid var(--border); border-radius:10px; min-height:180px; padding:12px; margin-bottom:14px;
}
.asm-preview-box img { max-width:100%; max-height:220px; border-radius:6px; box-shadow:0 2px 8px rgba(0,0,0,.1); }
.asm-divider { display:block; border-top:1px solid var(--border); margin:4px 0 16px; }

/* ── 2-column layout (Output Part/Materials+Options ซ้าย, Print Panel ขวา) — เฉพาะ tablet แนวนอนที่จอกว้างพอ
     แนวตั้ง/จอแคบ: asm-left กับ asm-right แค่เรียงต่อกันปกติ (block) ── */
.asm-two-col { display:block; }
@@media (orientation:landscape) and (min-width:900px) {
    .asm-two-col { display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start; }
    .asm-two-col > .asm-left, .asm-two-col > .asm-right { min-width:0; }
}

.asm-btn {
    width:100%; padding:14px; border:none; border-radius:12px;
    font-size:15px; font-weight:700; font-family:inherit; cursor:pointer;
    transition:.2s; background:var(--blue); color:#fff; margin-top:4px;
}
.asm-btn:disabled { background:#e5e7eb; color:#9ca3af; cursor:not-allowed; }
.asm-btn:not(:disabled):hover { background:var(--blue-dk); }

.toast-wrap { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; max-width:min(90vw,380px); }
.toast-item { padding:11px 20px; border-radius:10px; font-size:13px; font-weight:600; color:#fff; box-shadow:0 4px 16px rgba(0,0,0,.18); animation:tIn .25s ease; min-width:160px; }
.toast-ok   { background:var(--green); }
.toast-err  { background:var(--red); }
.toast-warn { background:var(--amber); }
.toast-item.toast-mono {
    max-height:40vh; overflow-y:auto; pointer-events:auto; cursor:text;
    background:#1e293b; font-family:ui-monospace,monospace; font-size:11px; font-weight:400;
    line-height:1.5; white-space:pre-wrap; word-break:break-word;
}
@@keyframes tIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:none} }
</style>

<div class="toast-wrap" id="toastWrap"></div>

<!-- ── Header ── -->
<div class="page-header">
    <h2 style="display:flex;align-items:center;gap:10px;margin:0">
        Assembly
        <i class="bi bi-boxes" style="opacity:.85;font-size:22px"></i>
    </h2>
</div>

<!-- ── Result banner (แสดง Output Part + Lot ใหม่หลัง Assembly สำเร็จ) ── -->
<div class="asm-result-banner" id="asmResultBanner">
    <i class="bi bi-check-circle-fill" style="font-size:20px"></i>
    <div>Assembly สำเร็จ — Output Part: <strong id="asmResultPartNo">—</strong> · Lot: <strong id="asmResultLotNo">—</strong></div>
</div>

<!-- ── 1. Scan / Search Material Lots ── -->
<div class="rp-card" style="overflow:visible">
    <div class="rp-card-body">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
            <div style="flex:1;min-width:180px">
                <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                    <i class="bi bi-upc-scan me-1" style="color:var(--blue)"></i>เพิ่ม Material Lot ที่ต้องการใช้ประกอบ
                </div>
                <div class="loc-wrap">
                    <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                    <input id="asmManualInput" class="loc-input"
                           placeholder="พิมพ์ Lot No เพื่อค้นหา…"
                           autocomplete="off"
                           oninput="asmManualAutocomplete()"
                           onkeydown="if(event.key==='Enter'){event.preventDefault();asmManualEnter();}"
                           onblur="setTimeout(asmHideLotDd,200)">
                    <div id="asmManualDd" class="loc-dd"></div>
                </div>
            </div>
            <!-- Barcode type: Our (QR) vs Vendor -->
            <div class="bc-mode-group" id="asmBcModeGroup" title="เลือกประเภท Barcode ที่จะอ่าน">
                <button type="button" class="bc-mode-btn active" data-mode="our" onclick="setAsmBarcodeMode('our')" title="Our Barcode">
                    <i class="bi bi-qr-code-scan"></i><span>Our</span>
                </button>
                <button type="button" class="bc-mode-btn" data-mode="vendor" onclick="setAsmBarcodeMode('vendor')" title="Vendor Barcode">
                    <i class="bi bi-upc"></i><span>Vendor</span>
                </button>
            </div>
            <button id="asmCamBtn" class="icon-btn" title="Camera scan"
                    style="background:var(--blue);color:#fff;width:44px;height:44px;font-size:20px;flex-shrink:0"
                    onclick="asmToggleCam()">
                <i class="bi bi-camera-fill"></i>
            </button>
            <button id="asmHwBtn" class="icon-btn" title="HW scanner"
                    style="background:#6b7280;color:#fff;width:44px;height:44px;font-size:20px;flex-shrink:0"
                    onclick="asmToggleHwScan()">
                <i class="bi bi-upc-scan"></i>
            </button>
        </div>
    </div>
</div>

<!-- ── Camera section ── -->
<partial name="_BarcodeScannerSection" />

<!-- ── HW Scanner Section (inline) ── -->
<partial name="_HwScannerSection" />

<!-- ── 2. Output Part / Materials / Advanced Options + Print Panel ── -->
<!-- asm-two-col เป็น block ปกติตอน portrait, พอเป็น landscape+tablet กว้าง ถึงกลายเป็น 2 คอลัมน์จริง (ดู @@media ด้านบน) -->
<div class="asm-two-col">
    <div class="asm-left">

        <!-- Output Part -->
        <div class="rp-card" style="overflow:visible">
            <div class="rp-card-head">
                <i class="bi bi-box-seam" style="color:var(--blue)"></i>
                <span>Output Part</span>
            </div>
            <div class="rp-card-body">
                <div class="asm-output-preview" id="asmOutputPreview" style="display:none">
                    <img class="ammo-img-lg" id="asmOutputPreviewImg" src=""
                         onclick="asmOpenImg(asmImgSrc(document.getElementById('asmOutputPartNo').value), document.getElementById('asmOutputPartNo').value)">
                    <div class="asm-output-preview-text">
                        <span class="ammo-part-no" id="asmOutputPreviewPartNo">—</span>
                        <span class="ammo-part-name" id="asmOutputPreviewName">—</span>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:2fr 1fr;gap:12px">
                <div>
                    <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                        Output Part No <span style="color:var(--red)">*</span>
                    </div>
                    <div class="loc-wrap">
                        <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                        <input id="asmOutputPartInput" class="loc-input" placeholder="ค้นหา Part No…" autocomplete="off"
                               oninput="asmSearchOutputPart()" onblur="setTimeout(asmHideOutputPartDd,200)"
                               onkeydown="if(event.key==='Enter'){event.preventDefault();asmOutputPartEnter();}">
                        <input type="hidden" id="asmOutputPartNo">
                        <div id="asmOutputPartDd" class="loc-dd"></div>
                    </div>
                </div>
                <div>
                    <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                        Output Qty <span style="color:var(--red)">*</span>
                    </div>
                    <input id="asmOutputQty" class="loc-input" style="padding-left:12px" type="number" min="0" step="any"
                           placeholder="0" oninput="asmOutputQtyEdited()">
                </div>
                </div>
            </div>
        </div>

        <!-- Materials -->
        <div class="rp-card" style="overflow:visible">
            <div class="rp-card-head">
                <i class="bi bi-boxes" style="color:var(--blue)"></i>
                <span>Materials</span>
                <span class="count-badge" id="asmCountBadge">0/10</span>
            </div>
            <div style="overflow-x:auto">
                <table class="rx-table">
                    <thead>
                        <tr>
                            <th>Part No</th>
                            <th>Lot No</th>
                            <th>W/O</th>
                            <th>Location</th>
                            <th style="text-align:right">QTY to Consume</th>
                            <th style="width:46px"></th>
                        </tr>
                    </thead>
                    <tbody id="asmTable">
                        <tr id="asmEmptyRow">
                            <td colspan="6" class="empty-state">
                                <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                                ยังไม่มีรายการ — สแกน QR หรือค้นหา Lot No
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Advanced Options -->
        <partial name="_AdvancedOptions" />
    </div>

    <div class="asm-right rp-card">
        <div class="rp-card-head">
            <i class="bi bi-printer" style="color:var(--blue)"></i>
            <span>Print Settings</span>
        </div>
        <div class="rp-card-body">
            <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:6px">
                Layout Template <span style="color:var(--red)">*</span>
            </div>
            <select id="asmLayoutSelect" class="loc-input" style="padding-left:12px;margin-bottom:16px" onchange="asmLayoutChanged()"><option value="">Loading…</option></select>

            <div class="asm-preview-box" id="asmPreviewImgBox"><div class="empty-state" style="padding:0">No items yet</div></div>

            <div class="asm-divider"></div>

            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                <span style="font-size:12px;font-weight:700;color:var(--t2)">Printer</span>
                <button type="button" class="rp-pd-refresh-btn" title="Refresh Printer" onclick="printerPickerManualRefresh(asmPrinterPicker, this)">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
            </div>
            <div class="rp-pd-wrap" style="margin-bottom:16px">
                <div class="rp-pd-trigger" id="asmPrinterTrigger" tabindex="0">
                    <div class="rp-pd-val">
                        <span class="rp-pd-dot" id="asmPrinterDot" style="display:none"></span>
                        <div>
                            <div class="rp-pd-sel-name" id="asmPrinterName" style="color:var(--t2);font-weight:400">-- Select Printer --</div>
                            <div class="rp-pd-sel-ip" id="asmPrinterIp" style="display:none"></div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-down rp-pd-chevron"></i>
                </div>
                <div class="rp-pd-menu" id="asmPrinterMenu" style="display:none">
                    <div class="rp-pd-msg">⏳ Loading…</div>
                </div>
                <input type="hidden" id="asmPrinterSelect">
            </div>

            <button class="asm-btn" id="asmSubmitBtn" onclick="submitAssembly()" disabled>Assembly</button>
        </div>
    </div>
</div>

<!-- ── Action choice modal (เฉพาะ user ที่มีสิทธิ์ WMS.UI.Assembly.SkipPrint) ── -->
<div id="asmActionModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1150;align-items:center;justify-content:center" onclick="if(event.target===this)asmCloseActionModal()">
    <div style="background:#fff;border-radius:16px;width:92%;max-width:340px;padding:20px;box-shadow:0 12px 40px rgba(0,0,0,.2);text-align:center">
        <div style="font-size:15px;font-weight:700;color:var(--navy);margin-bottom:16px">เลือกการทำงาน</div>
        <button onclick="asmChooseAction('printAssembly')" style="width:100%;padding:13px;margin-bottom:10px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit">
            🖨️ Print &amp; Assembly (Recommended)
        </button>
        <button onclick="asmChooseAction('assemblyOnly')" style="width:100%;padding:13px;margin-bottom:10px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit">
            Assembly Only
        </button>
        <button onclick="asmCloseActionModal()" style="width:100%;padding:10px;background:none;border:none;color:var(--t2);font-size:13px;cursor:pointer;font-family:inherit">ยกเลิก</button>
    </div>
</div>

<partial name="_PhotoCapture" model="@("asm")" />

<!-- ── Pick Lot modal (raw barcode เดียวกันผูกกับหลาย lot ให้เลือก) ── -->
<div id="asmPickLotModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)closeAsmPickLot()">
    <div style="background:#fff;border-radius:14px;width:90%;max-width:360px;max-height:70vh;display:flex;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.2)">
        <div style="padding:16px 18px 10px;font-size:15px;font-weight:700;color:var(--navy);flex-shrink:0">เลือก Lot ที่ต้องการ (<span id="asmPickLotCount">0</span> รายการ)</div>
        <div id="asmPickLotList" style="overflow-y:auto;padding:0 10px 10px"></div>
        <div style="padding:10px 18px 16px;flex-shrink:0">
            <button onclick="closeAsmPickLot()" style="width:100%;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">ยกเลิก</button>
        </div>
    </div>
</div>

<!-- ── Confirm Delete modal ── -->
<div id="asmConfirmDeleteModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)asmCancelDeleteRow()">
    <div style="background:#fff;border-radius:14px;width:90%;max-width:320px;padding:24px 20px 16px;box-shadow:0 12px 40px rgba(0,0,0,.2);text-align:center">
        <i class="bi bi-trash3" style="font-size:36px;color:var(--red);display:block;margin-bottom:12px"></i>
        <p style="font-size:14px;font-weight:700;color:var(--navy);margin:0 0 4px">ลบรายการนี้?</p>
        <p id="asmDeletePartLabel" style="font-size:12px;color:var(--t2);margin:0 0 16px;word-break:break-all"></p>
        <div style="display:flex;gap:8px">
            <button onclick="asmCancelDeleteRow()" style="flex:1;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">ยกเลิก</button>
            <button onclick="asmConfirmDeleteRow()" style="flex:1;padding:11px;background:var(--red);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">ลบ</button>
        </div>
    </div>
</div>

<!-- ── Confirm Split Lot modal (แก้ qty ในแถวลงจากเดิม) ── -->
<div id="asmConfirmSplitModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)asmCancelSplitEdit()">
    <div style="background:#fff;border-radius:14px;width:90%;max-width:340px;padding:24px 20px 16px;box-shadow:0 12px 40px rgba(0,0,0,.2);text-align:center">
        <i class="bi bi-signpost-split" style="font-size:36px;color:#8b5cf6;display:block;margin-bottom:12px"></i>
        <p style="font-size:14px;font-weight:700;color:var(--navy);margin:0 0 4px">ต้องการที่จะแบ่ง Lot?</p>
        <p style="font-size:12px;color:var(--t2);margin:0 0 16px;word-break:break-all">จำนวนที่แก้น้อยกว่า Lot เดิม ระบบจะขอเลข Lot ใหม่ (Lot ลูก) มาแทน แล้วค่อยแบ่งจริงตอนกด Assembly</p>
        <p id="asmSplitLotLabel" style="font-size:12px;font-weight:700;color:#8b5cf6;margin:0 0 16px;word-break:break-all"></p>
        <div style="display:flex;gap:8px">
            <button onclick="asmCancelSplitEdit()" style="flex:1;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">ยกเลิก</button>
            <button id="asmSplitConfirmBtn" onclick="asmConfirmSplitEdit()" style="flex:1;padding:11px;background:#8b5cf6;color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">ยืนยัน แบ่ง Lot</button>
        </div>
    </div>
</div>

<!-- ── Image preview lightbox (Output Part / Component Part) ── -->
<div id="asmImgOverlay" style="display:none;position:fixed;inset:0;background:rgba(10,10,20,.85);backdrop-filter:blur(6px);z-index:1200;align-items:center;justify-content:center" onclick="if(event.target===this)asmCloseImg()">
    <div style="position:relative;max-width:90vw;max-height:90vh" onclick="event.stopPropagation()">
        <button onclick="asmCloseImg()"
            style="position:absolute;top:-14px;right:-14px;width:32px;height:32px;border-radius:50%;border:none;background:#fff;font-size:16px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.2)">✕</button>
        <img id="asmImgEl" src="" style="max-width:90vw;max-height:82vh;border-radius:12px;box-shadow:0 24px 60px rgba(0,0,0,.5);display:block">
        <div id="asmImgCaption" style="text-align:center;color:rgba(255,255,255,.7);font-size:12px;margin-top:10px;font-family:ui-monospace,monospace"></div>
    </div>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/zplBuilder.js"></script>
<script src="js/printerPicker.js"></script>
<script src="js/apiForm.js"></script>
<script src="js/photoCapture.js"></script>
<script src="js/barcodeScanner.js"></script>
<script src="js/hwScanner.js"></script>
<script src="js/scanPipeline.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/loadPrinter.js"></script>
<script src="lib/html5-qrcode/html5-qrcode.min.js"></script>
<script>
    // ── State ─────────────────────────────────────────
    let asmScannedLots = new Set()
    let _asmSubmitting = false

    function toast(msg, type, opts) {
        const wrap = document.getElementById('toastWrap');
        const el   = document.createElement('div');
        el.className = 'toast-item ' + (type === 'ok' ? 'toast-ok' : type === 'warn' ? 'toast-warn' : 'toast-err');
        if (opts?.mono) el.classList.add('toast-mono')
        el.textContent = msg;
        wrap.appendChild(el);
        const duration = opts?.duration ?? (type === 'warn' ? 5000 : 3000)
        setTimeout(() => el.remove(), duration);
        return el
    }

    // toast payload เป็น JSON อ่านง่าย — ใช้ตอนดู payload จริงบน tablet ที่เปิด console ไม่ได้
    function toastPayload(label, payload) {
        toast(`${label}\n${JSON.stringify(payload, null, 2)}`, 'ok', { mono: true, duration: 12000 })
    }

    function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    // ใช้ escape ค่าที่ฝังเป็น string literal ใน onclick="..." (ต่างจาก esc() ที่ escape HTML entity เฉยๆ ไม่พอสำหรับใน JS string)
    function escJs(s) { return String(s ?? '').replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }

    // ── รูป + ชื่อของแต่ละ Part (Output/Component) — /master/bom-profiles ไม่ได้ส่งรูปมาด้วย ต้องดึงทีละ part ผ่าน /master/items/{partNo} เอง ──
    const ASM_NO_IMG = `data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2740%27 height=%2740%27 viewBox=%270 0 40 40%27%3E%3Crect width=%2740%27 height=%2740%27 rx=%276%27 fill=%27%23f0f2f5%27/%3E%3Cpath d=%27M14 26l5-6 4 5 3-3 4 4H10z%27 fill=%27%23d1d5db%27/%3E%3Ccircle cx=%2726%27 cy=%2716%27 r=%273%27 fill=%27%23d1d5db%27/%3E%3C/svg%3E`
    let _asmItemInfoCache = {}   // partNo → { itemName, imagePath } (imagePath ว่าง = confirmed ไม่มีรูป)
    let _asmImgCacheBust  = Date.now()

    function asmImgSrc(partNo) {
        const info = _asmItemInfoCache[partNo]
        return info?.imagePath ? (CONFIG.INVENTORY_API + info.imagePath + '?t=' + _asmImgCacheBust) : ASM_NO_IMG
    }
    function asmItemName(partNo) {
        return _asmItemInfoCache[partNo]?.itemName || ''
    }
    function asmOpenImg(src, caption) {
        document.getElementById('asmImgEl').src = src
        document.getElementById('asmImgCaption').textContent = caption || ''
        document.getElementById('asmImgOverlay').style.display = 'flex'
    }
    function asmCloseImg() {
        document.getElementById('asmImgOverlay').style.display = 'none'
        document.getElementById('asmImgEl').src = ''
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') asmCloseImg() })

    // ยิงหลังบ้าน (ไม่ await ตอนเรียก) — โหลดชื่อ+รูปของแต่ละ part ที่ยังไม่เคย fetch แล้ว patch DOM ของ part นั้นเมื่อเสร็จ ไม่บล็อกการ render
    async function asmLoadPartsInfo(partNos, onEach) {
        const uncached = [...new Set(partNos)].filter(p => p && !(p in _asmItemInfoCache))
        await Promise.all(uncached.map(async partNo => {
            try {
                const item = await api(`/master/items/${encodeURIComponent(partNo)}`, 'GET')
                _asmItemInfoCache[partNo] = { itemName: item?.itemName || '', imagePath: item?.imagePath || '' }
            } catch {
                _asmItemInfoCache[partNo] = { itemName: '', imagePath: '' }
            }
            onEach?.(partNo)
        }))
    }

    // ── Output Part autocomplete (ค้นจาก GET /master/bom-profiles — โชว์เฉพาะ outputPartNo ที่มี BOM อยู่แล้ว) ─────
    let _asmPnResults = [], _asmBomProfilesCache = null

    async function asmLoadBomProfiles() {
        if (_asmBomProfilesCache) return _asmBomProfilesCache
        // Desc/Page/PageSize เป็น required param ของ endpoint นี้ (เดิมไม่ส่งเลย) — response เป็น { total, page, pageSize, items }
        // ไล่ดึงทีละหน้าจนครบ ไม่งั้น autocomplete หา Output Part No เจอแค่บางส่วน
        const PAGE_SIZE = 10
        const first = await api(`/master/bom-profiles?page=1&pageSize=${PAGE_SIZE}&sortBy=id&desc=false`, 'GET')
        let arr     = Array.isArray(first) ? first : (first?.items || [])
        const total = first?.total ?? arr.length
        const pages = Math.ceil(total / PAGE_SIZE)
        if (pages > 1) {
            const rest = await Promise.all(
                Array.from({ length: pages - 1 }, (_, i) =>
                    api(`/master/bom-profiles?page=${i + 2}&pageSize=${PAGE_SIZE}&sortBy=id&desc=false`, 'GET')
                )
            )
            rest.forEach(r => { arr = arr.concat(Array.isArray(r) ? r : (r?.items || [])) })
        }
        _asmBomProfilesCache = arr
        return _asmBomProfilesCache
    }

    async function asmSearchOutputPart() {
        const input = document.getElementById('asmOutputPartInput')
        const dd    = document.getElementById('asmOutputPartDd')
        const text  = input.value.trim()
        document.getElementById('asmOutputPartNo').value = ''
        if (!text) { dd.style.display = 'none'; asmUpdateState(); return }

        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…</div>`
        dd.style.display = 'block'

        try {
            const all = await asmLoadBomProfiles()
            const q   = text.toLowerCase()
            _asmPnResults = all.filter(x => (x.outputPartNo || '').toLowerCase().includes(q)).slice(0, 20)
            if (!_asmPnResults.length) {
                dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>ไม่พบรายการ</div>`
                return
            }
            dd.innerHTML = _asmPnResults.map((x, i) => `
                <div class="loc-item" onmousedown="asmSelectOutputPart(${i})">
                    <i class="bi bi-diagram-3" style="color:var(--blue);flex-shrink:0"></i>
                    <strong style="flex-shrink:0">${esc(x.outputPartNo)}</strong>
                    ${x.outputItemName ? `<span style="color:var(--t2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(x.outputItemName)}</span>` : ''}
                </div>`).join('')
        } catch (err) {
            dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default"><i class="bi bi-exclamation-circle me-2"></i>${esc(err.message || 'Error')}</div>`
        }
    }

    function asmSelectOutputPart(i) {
        const x = _asmPnResults[i]
        if (!x) return
        document.getElementById('asmOutputPartInput').value = x.outputPartNo
        document.getElementById('asmOutputPartNo').value    = x.outputPartNo
        document.getElementById('asmOutputPartDd').style.display = 'none'
        asmApplyBomProfile(x)
        asmUpdateState()
    }

    // Enter ในช่องค้นหา Output Part No = เลือกตัวแรกใน list ทันที (ถ้า dropdown กำลังเปิดอยู่)
    function asmOutputPartEnter() {
        const dd = document.getElementById('asmOutputPartDd')
        if (dd.style.display !== 'none' && _asmPnResults.length) asmSelectOutputPart(0)
    }

    function asmHideOutputPartDd() {
        document.getElementById('asmOutputPartDd').style.display = 'none'
        const text  = document.getElementById('asmOutputPartInput').value.trim()
        const match = _asmPnResults.find(x => x.outputPartNo === text)
        document.getElementById('asmOutputPartNo').value = match ? match.outputPartNo : ''
        if (match) asmApplyBomProfile(match)
        asmUpdateState()
    }

    // ── Recipe (BOM) ของ Output Part ที่เลือก — ใช้ทำ checklist material ที่ต้องสแกน ─────
    let _asmBomProfile    = null          // profile ของ output part ปัจจุบัน {outputPartNo, outputQuantity, components}
    let _asmRequiredParts = new Map()     // partNo -> { quantity, fulfilled }

    function asmApplyBomProfile(profile) {
        if (_asmBomProfile && _asmBomProfile.outputPartNo === profile.outputPartNo) return // เลือก part เดิมซ้ำ ไม่ต้อง reset ของที่สแกนไว้แล้ว
        // auto-fill Output Qty จาก outputQuantity ของสูตร BOM ให้เลย (เฉพาะตอนเลือก part ใหม่จริงๆ ไม่ทับตอนเลือกซ้ำ)
        document.getElementById('asmOutputQty').value = profile.outputQuantity ?? ''
        _asmBomProfile    = profile
        _asmRequiredParts = new Map()
        ;(Array.isArray(profile.components) ? profile.components : []).forEach(c => {
            if (c.componentPartNo) _asmRequiredParts.set(c.componentPartNo, { quantity: c.quantity ?? 0, fulfilled: false })
        })
        asmScannedLots = new Set()
        document.getElementById('asmTable').innerHTML = ''
        asmShowOutputPreview(profile)
        if (_asmRequiredParts.size) {
            asmRenderRequiredRows()
        } else {
            toast('Part No นี้ยังไม่มี Component ในสูตร BOM', 'warn')
            asmCheckEmpty()
        }
    }

    // โชว์รูป+ชื่อของ Output Part ที่เลือกไว้ในการ์ด Output Part — ชื่อได้จาก profile.outputItemName เลย (มีอยู่แล้วจาก /master/bom-profiles)
    // ส่วนรูปต้องดึงเพิ่มจาก /master/items/{partNo} (endpoint นี้ไม่มีรูปมาให้)
    function asmShowOutputPreview(profile) {
        const partNo = profile.outputPartNo
        document.getElementById('asmOutputPreview').style.display = 'flex'
        document.getElementById('asmOutputPreviewPartNo').textContent = partNo || '—'
        document.getElementById('asmOutputPreviewName').textContent   = profile.outputItemName || '—'
        const img = document.getElementById('asmOutputPreviewImg')
        img.src = asmImgSrc(partNo)
        img.onerror = () => { img.src = ASM_NO_IMG }
        if (!(partNo in _asmItemInfoCache)) {
            asmLoadPartsInfo([partNo], () => {
                img.src = asmImgSrc(partNo)
                // ใช้ itemName จาก /master/items เป็น fallback เฉยๆ เผื่อ profile.outputItemName ว่าง — ไม่ทับถ้ามีอยู่แล้ว
                if (!profile.outputItemName) document.getElementById('asmOutputPreviewName').textContent = asmItemName(partNo) || '—'
            })
        }
    }

    // หัวกลุ่มของแต่ละ part — อยู่ถาวรตลอด (ไม่ใช่ placeholder ที่หายไปตอนสแกน) โชว์ ammo tube วิ่งตาม asmRenderTubes()
    // Default หุบ (เห็นแค่ part + หลอด progress) กดปุ่ม chevron เพื่อขยายดู lot row แต่ละใบ
    function asmGroupHeadHtml(partNo, req) {
        return `<tr class="asm-group-head" data-group="${esc(partNo)}" onclick="asmToggleGroup('${escJs(partNo)}')">
            <td colspan="6">
                <div class="ammo-row">
                    <button type="button" class="ammo-toggle" onclick="event.stopPropagation();asmToggleGroup('${escJs(partNo)}')" title="แสดง/ซ่อน Lot">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 6 15 12 9 18"/></svg>
                    </button>
                    <div class="ammo-part">
                        <img class="ammo-img" src="${asmImgSrc(partNo)}" onerror="this.src='${ASM_NO_IMG}'"
                             onclick="event.stopPropagation();asmOpenImg(asmImgSrc('${escJs(partNo)}'),'${escJs(partNo)}')">
                        <div class="ammo-part-text">
                            <span class="ammo-part-no">${esc(partNo)}</span>
                            <span class="ammo-part-name">${esc(asmItemName(partNo)) || '—'}</span>
                        </div>
                    </div>
                    <div class="ammo-tube-wrap">
                        <div class="ammo-tube"><div class="ammo-tube-fill"></div></div>
                        <span class="ammo-frac">0/${Number(req.quantity).toLocaleString()}</span>
                    </div>
                </div>
            </td>
        </tr>`
    }

    // เปิด/ปิดกลุ่มของ part นั้น (open=true → โชว์ lot row, false → หุบ) — เรียกตรงๆ (ไม่ toggle) เผื่อ caller รู้ target state ชัดเจนอยู่แล้ว เช่นตอน error
    function asmSetGroupOpen(partNo, open) {
        const head = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(partNo)}"]`)
        if (!head) return
        head.classList.toggle('open', open)
        document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(partNo)}"]`).forEach(r => {
            r.style.display = open ? '' : 'none'
        })
    }

    function asmToggleGroup(partNo) {
        const head = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(partNo)}"]`)
        if (head) asmSetGroupOpen(partNo, !head.classList.contains('open'))
    }

    function asmRenderRequiredRows() {
        const empty = document.getElementById('asmEmptyRow')
        if (empty) empty.remove()
        document.getElementById('asmTable').innerHTML =
            [..._asmRequiredParts.entries()].map(([partNo, req]) => asmGroupHeadHtml(partNo, req)).join('')
        asmUpdateState()
        // ยิงหลังบ้าน โหลดรูป+ชื่อของทุก component แล้ว patch หัวกลุ่มของ part นั้นๆ เมื่อเสร็จ ไม่บล็อกการ render ตาราง
        asmLoadPartsInfo([..._asmRequiredParts.keys()], partNo => {
            const head = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(partNo)}"]`)
            if (!head) return
            const img  = head.querySelector('.ammo-img')
            const name = head.querySelector('.ammo-part-name')
            if (img)  img.src = asmImgSrc(partNo)
            if (name) name.textContent = asmItemName(partNo) || '—'
        })
    }

    // เช็คว่า partNo ของ lot ที่กำลังจะเพิ่ม ตรงกับ component ในสูตร BOM ของ output part ที่เลือกไว้หรือไม่
    function asmValidatePartAllowed(partNo) {
        if (!_asmBomProfile) { toast('กรุณาเลือก Output Part No ก่อน', 'err'); return false }
        if (!_asmRequiredParts.size) { toast('Output Part นี้ไม่มีสูตร BOM ให้ตรวจสอบ', 'err'); return false }
        if (!_asmRequiredParts.has(partNo)) {
            toast(`Part No "${partNo}" ไม่ตรงกับสูตรของ ${_asmBomProfile.outputPartNo}`, 'err')
            return false
        }
        return true
    }

    // ── Manual Search (Material Lot) ─────────────────────────────────
    let _asmManualTimer = null, _asmManualResults = []

    function asmHideLotDd() {
        document.getElementById('asmManualDd').style.display = 'none'
    }

    function asmManualAutocomplete() {
        const inp  = document.getElementById('asmManualInput')
        const dd   = document.getElementById('asmManualDd')
        const text = inp.value.trim()
        if (!text) { dd.style.display = 'none'; return }

        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
            <i class="bi bi-hourglass-split me-2"></i>กำลังค้นหา…</div>`
        dd.style.display = 'block'

        clearTimeout(_asmManualTimer)
        _asmManualTimer = setTimeout(async () => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: text })
                const list = Array.isArray(res) ? res : (res?.data || [])
                if (!list.length) {
                    _asmManualResults = []
                    dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                        <i class="bi bi-search me-2"></i>ไม่พบ Lot No</div>`
                    return
                }
                _asmManualResults = list
                dd.innerHTML = list.map((l, i) => `
                    <div class="loc-item" onmousedown="asmManualSelect(${i})">
                        <div>
                            <div style="font-weight:700;font-size:13px">${esc(l.lotNo || '')}</div>
                            ${l.partNo ? `<div style="font-size:11px;color:var(--t3)">${esc(l.partNo)}</div>` : ''}
                        </div>
                        <span style="margin-left:auto;font-size:11px;color:var(--t2)">${esc(locName(l.location ?? l.locationCode ?? ''))}</span>
                    </div>`).join('')
                dd.style.display = 'block'
            } catch (err) {
                _asmManualResults = []
                dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                    <i class="bi bi-exclamation-circle me-2"></i>${esc(err.message || 'Error')}</div>`
            }
        }, 300)
    }

    function asmManualSelect(i) {
        const lot = _asmManualResults[i]
        if (!lot) return
        asmHideLotDd()
        document.getElementById('asmManualInput').value = ''
        if (asmScannedLots.has(lot.lotNo)) { toast('ซ้ำ: ' + lot.lotNo, 'warn'); return }
        if (!asmValidatePartAllowed(lot.partNo)) return
        asmScannedLots.add(lot.lotNo)
        asmAddRow(lot)
        toast('✓ ' + lot.lotNo, 'ok')
    }

    async function asmManualEnter() {
        const val = document.getElementById('asmManualInput').value.trim()
        if (!val) return
        const dd = document.getElementById('asmManualDd')
        clearTimeout(_asmManualTimer)
        if (dd.style.display !== 'none' && _asmManualResults.length) {
            asmManualSelect(0)
            return
        }
        asmHideLotDd()
        document.getElementById('asmManualInput').value = ''
        try {
            const res  = await api('/inventory/lots', 'POST', { lotNo: val })
            const list = Array.isArray(res) ? res : (res?.data || [])
            const match = list.find(l => (l.lotNo || '').toLowerCase() === val.toLowerCase()) ?? list[0]
            if (!match) { toast('ไม่พบ Lot: ' + val, 'err'); return }
            if (asmScannedLots.has(match.lotNo)) { toast('ซ้ำ: ' + match.lotNo, 'warn'); return }
            if (!asmValidatePartAllowed(match.partNo)) return
            asmScannedLots.add(match.lotNo)
            asmAddRow(match)
            toast('✓ ' + match.lotNo, 'ok')
        } catch (err) {
            toast('ค้นหาไม่สำเร็จ: ' + err.message, 'err')
        }
    }

    // ── Scan pipeline ──────────────────────────────────
    function asmScanSetStatus(t) {
        const statusCam = document.getElementById('bcStatus')
        const statusHw  = document.getElementById('hwStatus')
        if (statusCam) statusCam.textContent = t
        if (statusHw)  statusHw.textContent  = t
    }

    async function asmAddScannedLot(lotNo) {
        if (!lotNo) { toast('No Lot, Please Receive first.', 'err'); return }
        if (asmScannedLots.has(lotNo)) { toast('ซ้ำ: ' + lotNo, 'warn'); return }
        const res  = await api('/inventory/lots', 'POST', { lotNo, page: 1, pageSize: 1 })
        const list = Array.isArray(res) ? res : (res?.data ?? [])
        const lot  = list[0]
        if (!lot) { toast('ไม่พบ Lot: ' + lotNo, 'err'); return }
        if (!asmValidatePartAllowed(lot.partNo)) return
        asmScannedLots.add(lotNo)
        asmAddRow(lot)
        toast('✓ ' + lotNo, 'ok')
    }

    // ── Barcode type toggle (Our QR vs Vendor label) ──
    let asmBarcodeMode = 'our'
    function setAsmBarcodeMode(m) {
        asmBarcodeMode = m
        document.querySelectorAll('#asmBcModeGroup .bc-mode-btn').forEach(btn =>
            btn.classList.toggle('active', btn.dataset.mode === m))
        toast('โหมดสแกน: ' + (m === 'our' ? 'Our Barcode' : 'Vendor Barcode'), 'ok')
    }

    const asmScan = createScanPipeline({
        mode: 'ours',
        barcodeFilter: () => asmBarcodeMode,
        onResult: async ({ lotNo, matches, notOurFormat, wrongModeOur }) => {
            asmScanSetStatus('กำลังประมวลผล…')
            try {
                if (wrongModeOur || notOurFormat) return // สแกนผิดโหมด — เงียบไว้ ไม่ต้องแจ้งอะไร
                if (Array.isArray(matches) && matches.length > 1) {
                    await openAsmPickLot(matches)
                    return
                }
                await asmAddScannedLot(lotNo)
            } finally {
                asmScanSetStatus('พร้อมสแกน…')
            }
        }
    })

    let _asmPickLots = []

    async function openAsmPickLot(matches) {
        document.getElementById('asmPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px"><span class="spinner-border spinner-border-sm me-2"></span>กำลังโหลดข้อมูล…</div>`
        document.getElementById('asmPickLotModal').style.display = 'flex'

        // บังคับ availableOnly เสมอ — lot ที่ของหมด/ไม่ available จะไม่ถูกคืนมาจาก API เลย (lot: null) กรองทิ้งไม่ให้ขึ้นในลิสต์ให้เลือก
        const fetched = await Promise.all((matches || []).map(async m => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: m.lotNo, page: 1, pageSize: 1, availableOnly: true })
                const list = Array.isArray(res) ? res : (res?.data ?? [])
                return { lotNo: m.lotNo, lot: list[0] ?? null }
            } catch (_) {
                return { lotNo: m.lotNo, lot: null }
            }
        }))
        _asmPickLots = fetched.filter(m => m.lot)
        document.getElementById('asmPickLotCount').textContent = _asmPickLots.length

        if (!_asmPickLots.length) {
            document.getElementById('asmPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px">ไม่พบ Lot ที่ Available</div>`
            return
        }

        document.getElementById('asmPickLotList').innerHTML = _asmPickLots.map((m, i) => {
            const lot = m.lot || {}
            return `<button onclick="asmPickLotSelect(${i})" style="width:100%;text-align:left;padding:11px 10px;border:none;border-bottom:1px solid #eee;background:#fff;cursor:pointer;font-family:inherit">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:3px">
                    <span style="font-weight:700;color:var(--navy);font-family:ui-monospace,monospace;font-size:13px">${m.lotNo ?? '—'}</span>
                    <span style="font-size:13px;font-weight:700;color:var(--blue)">${lot.onHandQty ?? '—'} ${lot.unit ?? ''}</span>
                </div>
                <div style="font-size:12px;color:var(--t2);display:flex;gap:12px;flex-wrap:wrap">
                    <span>W/O: ${lot.workOrder || '—'}</span>
                    <span>Part: ${lot.partNo || '—'}</span>
                </div>
            </button>`
        }).join('')
    }

    function closeAsmPickLot() {
        document.getElementById('asmPickLotModal').style.display = 'none'
        _asmPickLots = []
    }

    function asmPickLotSelect(i) {
        const m = _asmPickLots[i]
        closeAsmPickLot()
        if (!m || !m.lot) { toast('ไม่พบ LOT: ' + (m?.lotNo || ''), 'err'); return }
        if (asmScannedLots.has(m.lotNo)) { toast('ซ้ำ: ' + m.lotNo, 'warn'); return }
        if (!asmValidatePartAllowed(m.lot.partNo)) return
        asmScannedLots.add(m.lotNo)
        asmAddRow(m.lot)
        toast('✓ ' + m.lotNo, 'ok')
    }

    // ── Camera ────────────────────────────────────────
    const asmScanner = createBarcodeScanner({
        videoId: 'bcVideo', canvasId: 'bcCanvas', labelId: 'bcLabel',
        onDetect: raw => asmScan.submit(raw)
    })

    function asmToggleCam() { if (asmScanner.running) stopScan(); else asmStartCam() }

    function setCamBtn(running) {
        const btn = document.getElementById('asmCamBtn')
        btn.style.background = running ? '#dc2626' : 'var(--blue)'
    }

    async function asmStartCam() {
        const hwSection = document.getElementById('hwSection')
        if (hwSection.style.display !== 'none') asmToggleHwScan()

        document.getElementById('bcSection').style.display = ''
        document.getElementById('bcStatus').textContent = 'กำลังสแกน…'
        setCamBtn(true)

        try {
            await asmScanner.start()
            setTorchBtn(asmScanner.hasTorch())
        } catch (err) {
            toast(err.message.includes('BarcodeDetector') ? err.message : 'ไม่สามารถเข้าถึงกล้อง: ' + err.message, 'err')
            document.getElementById('bcSection').style.display = 'none'
            setCamBtn(false)
        }
    }

    function stopScan() {
        asmScanner.stop()
        document.getElementById('bcSection').style.display = 'none'
        setCamBtn(false)
        setTorchBtn(false)
    }

    async function switchCamera() {
        await asmScanner.switchCamera()
        setTorchBtn(asmScanner.hasTorch())
    }

    function setTorchBtn(visible) {
        const btn = document.getElementById('bcTorchBtn')
        btn.style.display = visible ? 'flex' : 'none'
        btn.classList.remove('active')
    }

    async function toggleTorch() {
        const on = await asmScanner.toggleTorch()
        document.getElementById('bcTorchBtn').classList.toggle('active', on)
    }

    // ── HW Scanner ────────────────────────────────────
    const asmHwScanner = createHwScanner({
        inputId: 'hwInput', statusId: 'hwStatus',
        onScan: raw => asmScan.submit(raw)
    })

    function asmToggleHwScan() {
        const section = document.getElementById('hwSection')
        const btn     = document.getElementById('asmHwBtn')
        if (asmHwScanner.active) {
            asmHwScanner.close()
            section.style.display = 'none'
            btn.style.background  = '#6b7280'
        } else {
            section.style.display = ''
            btn.style.background  = 'var(--red)'
            if (asmScanner.running) asmToggleCam()
            asmHwScanner.open()
        }
    }

    // ── Table (Materials — แต่ละแถวมี Qty to Consume แก้ไขได้ ไม่ใช่ทั้ง lot เสมอไปเหมือน Merge) ─────
    // lot ของ part เดียวกันจะถูกแทรกให้อยู่ติดกันเสมอ (ต่อท้ายกลุ่มของ part นั้น ใต้หัวกลุ่ม asm-group-head) ไม่ว่าจะสแกนสลับ part กันแค่ไหน
    function asmAddRow(lot) {
        if (document.querySelectorAll('#asmTable tr[data-lot-no]').length >= 10) {
            toast('ครบ 10 รายการแล้ว', 'warn'); return
        }
        if (navigator.vibrate) navigator.vibrate(120)
        const empty = document.getElementById('asmEmptyRow')
        if (empty) empty.remove()

        const loc   = lot.location ?? lot.locationCode ?? '—'
        const avail = lot.onHandQty ?? lot.available ?? 0
        const req   = _asmRequiredParts.get(lot.partNo)
        const isFirstOfPart = !document.querySelector(`#asmTable tr[data-part-no="${CSS.escape(lot.partNo ?? '')}"]`)
        // ถ้ายังไม่เคยสแกน part นี้มาก่อน (ครั้งแรก) ให้ default qty เป็นค่าที่น้อยกว่าระหว่าง "มีในสต็อก" กับ "ต้องใช้ตามสูตร" กันสแกนแล้วดึงไปเกินสูตรโดยไม่ตั้งใจ
        const defaultQty = (req && isFirstOfPart && req.quantity > 0) ? Math.min(avail, req.quantity) : avail

        const tmp = document.createElement('tbody')
        tmp.innerHTML = `
            <tr data-lot-no="${esc(lot.lotNo)}" data-part-no="${esc(lot.partNo ?? '')}" data-avail="${avail}"
                data-wo="${esc(lot.workOrder ?? '')}" data-loc="${esc(loc)}" data-unit="${esc(lot.unit ?? '')}"
                data-line="${esc(lot.lineName ?? lot.line ?? '')}">
                <td class="asm-lot-connector">↳</td>
                <td style="color:var(--blue);font-weight:600;font-size:12px" data-lotno-cell>${esc(lot.lotNo)}</td>
                <td style="font-size:12px;color:var(--t2)">${esc(lot.workOrder || '—')}</td>
                <td><span style="background:#f0f2f5;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:600;color:var(--t2)">${esc(locName(loc))}</span></td>
                <td style="text-align:right">
                    <input type="number" class="qty-input" data-qty-input min="0" max="${avail}" step="any" readonly
                           value="${defaultQty}" oninput="asmUpdateState()">
                    <div style="font-size:10px;color:var(--t3);margin-top:3px" data-avail-text>/ ${Number(avail).toLocaleString()} ${esc(lot.unit ?? '')}</div>
                </td>
                <td style="white-space:nowrap">
                    <button class="edit-btn" onclick="asmToggleRowEdit(this)" title="Edit Qty"><i class="bi bi-pencil"></i></button>
                    <button class="del-btn" onclick="asmRemoveRow(this)" title="Remove"><i class="bi bi-trash3"></i></button>
                </td>
            </tr>`
        const newRow = tmp.firstElementChild

        // แทรกต่อท้าย lot ล่าสุดของ part เดียวกัน (หรือต่อจากหัวกลุ่มเลยถ้าเป็น lot แรกของ part นี้) กันกระจายไปคนละที่ในตาราง
        const groupHead = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(lot.partNo ?? '')}"]`)
        if (groupHead) {
            const siblingRows = document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(lot.partNo ?? '')}"]`)
            const lastOfGroup = siblingRows.length ? siblingRows[siblingRows.length - 1] : groupHead
            lastOfGroup.after(newRow)
            // แถวใหม่ต้องเข้าไปในสถานะหุบ/ขยายของกลุ่มปัจจุบันด้วย ไม่งั้นจะโผล่มาแม้กลุ่มหุบอยู่
            if (!groupHead.classList.contains('open')) newRow.style.display = 'none'
        } else {
            document.getElementById('asmTable').appendChild(newRow)
        }
        newRow.classList.add('asm-row-filled')
        setTimeout(() => newRow.classList.remove('asm-row-filled'), 500)

        asmUpdateState()
    }

    // สลับ Qty to Consume ของแถวนั้นระหว่างโหมดดูเฉยๆ (readonly ตัวเลขเปล่าๆ) กับโหมดแก้ไข (input จริง) — กดปุ่มเดิมซ้ำเพื่อยืนยัน (Done)
    function asmToggleRowEdit(btn) {
        const row   = btn.closest('tr')
        const input = row?.querySelector('[data-qty-input]')
        if (!input) return

        if (input.readOnly) {
            // เข้าโหมดแก้ไข — จำค่าปัจจุบันไว้เป็น "จำนวนเดิม" ห้ามแก้เกิน (ถ้าเคยแบ่งไปแล้วครั้งก่อน เพดานจะเป็นค่าที่แบ่งไว้ล่าสุด ไม่ใช่ avail ตั้งต้นเสมอไป)
            row.dataset.qtyCeiling = input.value
            input.readOnly = false
            input.max = input.value
            btn.classList.add('active')
            btn.querySelector('i').className = 'bi bi-check-lg'
            btn.title = 'Done'
            input.focus(); input.select()
            return
        }
        asmConfirmRowEdit(row, btn, input)
    }

    function _asmLockRowEdit(row, btn) {
        const input = row.querySelector('[data-qty-input]')
        input.readOnly = true
        btn.classList.remove('active')
        btn.querySelector('i').className = 'bi bi-pencil'
        btn.title = 'Edit Qty'
        asmUpdateState()
    }

    // กด Done (ยืนยันแก้ qty ของแถว) — ตรวจว่าไม่เกิน "จำนวนเดิม" ก่อน แล้วค่อยตัดสินใจว่าต้องแบ่ง Lot หรือไม่
    function asmConfirmRowEdit(row, btn, input) {
        const ceiling = parseFloat(row.dataset.qtyCeiling) || 0
        const newVal  = parseFloat(input.value)
        if (!(newVal > 0) || newVal > ceiling + 1e-9) {
            toast(`จำนวนที่แก้ต้องไม่เกินจำนวนเดิม (${asmFmtNum(ceiling)})`, 'err')
            input.value = ceiling
            input.focus()
            return   // ค้างอยู่ในโหมดแก้ไข จนกว่าจะกรอกค่าที่ถูกต้อง
        }

        if (Math.abs(newVal - ceiling) < 1e-9) {
            _asmLockRowEdit(row, btn)   // ไม่ได้เปลี่ยนจำนวนจริง — ไม่ต้องแบ่ง Lot
            return
        }

        if (row.dataset.needsSplit === 'true') {
            // แถวนี้ pending split อยู่แล้วจากการแก้ครั้งก่อน (ยังไม่ยิง /inventory/split จริงจนกว่าจะกด Assembly) — ปรับจำนวนต่อได้เลยโดยไม่ต้องขอเลข Lot ใหม่/ถามซ้ำ
            row.dataset.avail = newVal
            const availText = row.querySelector('[data-avail-text]')
            if (availText) availText.textContent = `/ ${asmFmtNum(newVal)} ${row.dataset.unit || ''}`
            _asmLockRowEdit(row, btn)
            return
        }

        // แก้จำนวนลงจากเดิมครั้งแรกของแถวนี้ → ต้องแบ่ง Lot ถามยืนยันก่อน
        _asmPendingSplitRow = { row, btn, input, newVal }
        document.getElementById('asmSplitLotLabel').textContent =
            `${row.dataset.lotNo} → เหลือ ${asmFmtNum(newVal)} ${row.dataset.unit || ''} (จากทั้งหมด ${asmFmtNum(ceiling)})`
        document.getElementById('asmConfirmSplitModal').style.display = 'flex'
    }

    let _asmPendingSplitRow = null

    function asmCancelSplitEdit() {
        document.getElementById('asmConfirmSplitModal').style.display = 'none'
        if (!_asmPendingSplitRow) return
        const { row, btn, input } = _asmPendingSplitRow
        input.value = row.dataset.qtyCeiling   // ยกเลิก = คืนค่าเดิม ไม่แบ่ง
        _asmLockRowEdit(row, btn)
        _asmPendingSplitRow = null
    }

    // ยืนยันแบ่ง Lot — ขอเลข Lot ใหม่ (child) มาแทน parent ใน list ทันที (ยังไม่ยิง /inventory/split จริง รอถึงตอนกด Assembly)
    async function asmConfirmSplitEdit() {
        if (!_asmPendingSplitRow) return
        const { row, btn, input, newVal } = _asmPendingSplitRow
        const confirmBtn = document.getElementById('asmSplitConfirmBtn')
        confirmBtn.disabled = true
        confirmBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลังขอเลข Lot…'
        try {
            const trRes = await api('/inventory/new-lotNo', 'GET')
            const childLotNo = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? null
            if (!childLotNo) throw new Error('ไม่ได้รับเลข Lot ใหม่จากระบบ')

            if (!row.dataset.parentLotNo) row.dataset.parentLotNo = row.dataset.lotNo
            asmScannedLots.delete(row.dataset.lotNo)
            row.dataset.lotNo      = childLotNo
            row.dataset.avail      = newVal
            row.dataset.needsSplit = 'true'
            asmScannedLots.add(childLotNo)

            row.classList.add('row-split')
            const lotCell = row.querySelector('[data-lotno-cell]')
            if (lotCell) lotCell.innerHTML = `${esc(childLotNo)}<div style="font-size:9px;color:#8b5cf6;font-weight:600;margin-top:1px">แบ่งจาก ${esc(row.dataset.parentLotNo)}</div>`
            const availText = row.querySelector('[data-avail-text]')
            if (availText) availText.textContent = `/ ${asmFmtNum(newVal)} ${row.dataset.unit || ''}`

            document.getElementById('asmConfirmSplitModal').style.display = 'none'
            toast(`เตรียมแบ่ง Lot ${childLotNo} แล้ว — จะสร้างจริงตอนกด Assembly`, 'ok')
            _asmLockRowEdit(row, btn)
        } catch (err) {
            toast('ขอเลข Lot ใหม่ไม่สำเร็จ: ' + (err.message || ''), 'err')
            input.value = row.dataset.qtyCeiling
            document.getElementById('asmConfirmSplitModal').style.display = 'none'
            _asmLockRowEdit(row, btn)
        } finally {
            confirmBtn.disabled = false
            confirmBtn.innerHTML = 'ยืนยัน แบ่ง Lot'
            _asmPendingSplitRow = null
        }
    }

    let _asmPendingDeleteRow = null

    function asmRemoveRow(btn) {
        _asmPendingDeleteRow = btn.closest('tr')
        document.getElementById('asmDeletePartLabel').textContent = _asmPendingDeleteRow.dataset.lotNo || ''
        document.getElementById('asmConfirmDeleteModal').style.display = 'flex'
    }

    function asmCancelDeleteRow() {
        _asmPendingDeleteRow = null
        document.getElementById('asmConfirmDeleteModal').style.display = 'none'
    }

    function asmConfirmDeleteRow() {
        if (!_asmPendingDeleteRow) return
        const row = _asmPendingDeleteRow
        asmScannedLots.delete(row.dataset.lotNo)
        const errDetail = row.nextElementSibling
        if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
        // หัวกลุ่ม (asm-group-head) อยู่ถาวรอยู่แล้ว ไม่ต้อง revert เป็น placeholder — ลบแถว lot ทิ้งแล้ว asmRecomputeGroups() จะอัปเดต tube กลับไป 0 เอง
        row.remove()
        _asmPendingDeleteRow = null
        document.getElementById('asmConfirmDeleteModal').style.display = 'none'
        asmCheckEmpty()
        asmUpdateState()
    }

    function asmCheckEmpty() {
        if (!document.querySelectorAll('#asmTable tr[data-lot-no], #asmTable tr.asm-group-head').length) {
            document.getElementById('asmTable').insertAdjacentHTML('beforeend', `
                <tr id="asmEmptyRow">
                    <td colspan="6" class="empty-state">
                        <i class="bi bi-upc-scan" style="font-size:24px;display:block;margin-bottom:8px;opacity:.35"></i>
                        ยังไม่มีรายการ — สแกน QR หรือค้นหา Lot No
                    </td>
                </tr>`)
        }
    }

    function asmFmtNum(n) {
        return (Math.round((n || 0) * 1000) / 1000).toLocaleString()
    }

    // วาด ammo tube ของทุก part ตาม scaleFactor ที่กำหนด (scaleFactor = กี่เท่าของสูตรฐาน (_asmBomProfile.outputQuantity) ที่กำลังทำอยู่)
    // ใช้ร่วมกันทั้ง 2 ทาง: มาจากยอดสแกน (asmRecomputeGroups) หรือมาจากที่ user พิมพ์ Output Qty เอง (asmOutputQtyEdited)
    function asmRenderTubes(scaleFactor, scannedByPart) {
        if (!_asmRequiredParts.size) return
        if (!scannedByPart) {
            scannedByPart = {}
            _asmRequiredParts.forEach((req, partNo) => {
                const inputs = document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(partNo)}"] [data-qty-input]`)
                scannedByPart[partNo] = [...inputs].reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0)
            })
        }
        _asmRequiredParts.forEach((req, partNo) => {
            const neededForBatch = req.quantity * scaleFactor
            const scanned         = scannedByPart[partNo] || 0
            const pct              = neededForBatch > 0 ? Math.min(100, (scanned / neededForBatch) * 100) : 0
            const isOver            = neededForBatch > 0 && scanned > neededForBatch + 1e-9
            // fulfilled = ตรงเป๊ะพอดี (ไม่ขาด ไม่เกิน) — ต่างจากเดิมที่ >= ก็ถือว่า fulfilled แล้ว เพราะตอนนี้เกินไปคือปัญหา (ต้องแก้ให้พอดีก่อนถึงจะกด Assembly ได้)
            req.fulfilled            = neededForBatch > 0 && Math.abs(scanned - neededForBatch) <= 1e-9

            const head = document.querySelector(`#asmTable tr.asm-group-head[data-group="${CSS.escape(partNo)}"]`)
            if (!head) return
            const fill  = head.querySelector('.ammo-tube-fill')
            const frac  = head.querySelector('.ammo-frac')
            const state = pct <= 0 ? '' : (isOver ? 'over' : (req.fulfilled ? 'full' : 'partial'))
            fill.className   = 'ammo-tube-fill' + (state ? ' ' + state : '')
            fill.style.width = pct + '%'
            frac.className   = 'ammo-frac' + (state ? ' ' + state : '')
            frac.textContent = `${asmFmtNum(scanned)}/${asmFmtNum(neededForBatch)}`
        })
    }

    // Material row เปลี่ยน (สแกนเพิ่ม/ลบ/แก้ qty ใน list) → หา part ที่สแกนไปไกลที่สุดเทียบสัดส่วนสูตร แล้วดัน Output Qty ขึ้นตามอัตโนมัติ
    // "batch" = จำนวนชุดสูตรที่กำลังทำอยู่ตอนนี้ (สแกนเกิน 1 ชุดของ part ไหนก่อน ก็ดันทั้งกลุ่มขึ้น batch ถัดไปทันที)
    // part อื่นที่ยังตามไม่ทัน batch ปัจจุบัน จะโชว์เป็นหลอดครึ่งๆ สีเหลืองแทน ให้เห็นชัดว่ายังขาดอะไรอยู่ก่อนจะครบ batch นั้น
    function asmRecomputeGroups() {
        if (!_asmRequiredParts.size) return

        const scannedByPart = {}
        _asmRequiredParts.forEach((req, partNo) => {
            const inputs = document.querySelectorAll(`#asmTable tr[data-part-no="${CSS.escape(partNo)}"] [data-qty-input]`)
            scannedByPart[partNo] = [...inputs].reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0)
        })

        let maxRatio = 0
        _asmRequiredParts.forEach((req, partNo) => {
            if (req.quantity > 0) maxRatio = Math.max(maxRatio, scannedByPart[partNo] / req.quantity)
        })
        const batch = Math.max(1, Math.ceil(maxRatio - 1e-9))   // กัน floating point แกว่งใกล้ๆ จำนวนเต็ม (เช่น 1.9999999)

        const baseOutputQty = _asmBomProfile?.outputQuantity || 1
        document.getElementById('asmOutputQty').value = batch * baseOutputQty
        asmRenderTubes(batch, scannedByPart)
    }

    // Output Qty ถูกแก้เอง (พิมพ์ในช่องตรงๆ) → ใช้ค่านั้นเป็นเป้าหมายใหม่ ปรับ target/หลอด progress ของแต่ละ part ตาม
    // ต่างจาก asmRecomputeGroups ตรงที่ไม่ทับ Output Qty กลับ (เพราะค่าที่พิมพ์คือ source เอง ไม่ใช่ผลลัพธ์ที่คำนวณจากยอดสแกน)
    function asmOutputQtyEdited() {
        const baseOutputQty = _asmBomProfile?.outputQuantity || 1
        const outputQty     = parseFloat(document.getElementById('asmOutputQty').value) || 0
        const scaleFactor   = baseOutputQty > 0 ? outputQty / baseOutputQty : 0
        asmRenderTubes(scaleFactor)
        asmFinishUpdateState()
    }

    // ส่วนท้ายที่ใช้ร่วมกันทั้ง 2 ทาง (material row เปลี่ยน หรือแก้ Output Qty เอง) — อัปเดต badge/validity/preview
    function asmFinishUpdateState() {
        const rows = [...document.querySelectorAll('#asmTable tr[data-lot-no]')]
        if (_asmRequiredParts.size) {
            const fulfilledCount = [..._asmRequiredParts.values()].filter(r => r.fulfilled).length
            document.getElementById('asmCountBadge').textContent = fulfilledCount + '/' + _asmRequiredParts.size
        } else {
            document.getElementById('asmCountBadge').textContent = rows.length + '/10'
        }

        let validRows = rows.length > 0
        rows.forEach(r => {
            const input = r.querySelector('[data-qty-input]')
            const avail = parseFloat(r.dataset.avail) || 0
            const val   = parseFloat(input.value) || 0
            const bad   = !(val > 0) || val > avail
            input.classList.toggle('err', bad)
            if (bad) validRows = false
        })

        const outputPartNo = document.getElementById('asmOutputPartNo').value.trim()
        const outputQty    = parseFloat(document.getElementById('asmOutputQty').value)
        // ต้องสแกนทุก Part ให้ตรงเป๊ะตามเป้าหมาย (ไม่ขาด ไม่เกิน) ก่อนถึงจะกด Assembly ได้ — ดูสถานะ fulfilled ที่ asmRenderTubes() อัปเดตไว้ล่าสุด
        const allPartsExact = _asmRequiredParts.size === 0 || [..._asmRequiredParts.values()].every(r => r.fulfilled)
        const enabled = validRows && !!outputPartNo && outputQty > 0 && !_asmSubmitting && allPartsExact
        document.getElementById('asmSubmitBtn').disabled = !enabled

        asmRenderPreviewPanel()
    }

    function asmUpdateState() {
        asmRecomputeGroups()   // ต้องรันก่อน — อัปเดต Output Qty ให้เสร็จก่อนค่อยเช็ค enabled/disabled ของปุ่ม submit ด้านล่าง
        asmFinishUpdateState()
    }

    // ── Preview: Output Part label ก่อน Assembly จริง ─────
    // ดึง /inventory/new-lotNo ตั้งแต่เลือก Output Part แล้ว cache ไว้ใช้ตอน submit จริง (กันเลขที่ preview กับที่ print ไม่ตรงกัน)
    let asmPreviewLotNo = null
    let _asmPreviewFetching = false

    function asmLayoutChanged() {
        asmRenderPreviewPanel()
    }

    // ถ้าทุกแถววัตถุดิบมี workOrder ตรงกันหมดให้แสดงค่านั้น ถ้าไม่ตรงกัน (คนละ WO) ให้ถือว่าไม่รู้ (เหมือน _mgCommonOrMixed ของ Merge)
    function _asmCommonOrMixed(rows, key) {
        const vals = new Set(rows.map(r => r.dataset[key]).filter(Boolean))
        if (vals.size === 0) return '—'
        if (vals.size === 1) return [...vals][0]
        return 'Mixed'
    }

    // Production Area สำหรับพิมพ์ label — ลำดับความสำคัญ: 1) productionPlant จาก /workorder/{wo}/detail (ถ้าวัตถุดิบทุก lot
    // มี workOrder ตรงกันหมดและหาเจอ) 2) เดาจากชื่อ Layout Template ที่เลือก 3) default Fan_1 ถ้าไม่เข้า pattern ไหนเลย
    async function asmResolveProductionArea(workOrder) {
        if (!_locNameMap.size) await loadLocation()
        if (workOrder) {
            try {
                const detail = await api(`/workorder/${encodeURIComponent(workOrder)}/detail`, 'GET')
                const plant  = (detail?.productionPlant || '').trim()
                if (plant) {
                    const pm       = plant.match(/(\d+)\s*$/)
                    const areaCode = pm ? `Fan_${pm[1]}` : plant
                    const match    = Array.from(_locNameMap.values())
                        .filter(loc => (loc.typeName || '').toLowerCase() === 'factory')
                        .find(loc =>
                            (loc.locationCode || '').toLowerCase() === areaCode.toLowerCase() ||
                            (loc.displayName  || '').toLowerCase() === areaCode.toLowerCase())
                    return { code: match?.locationCode ?? areaCode, name: match?.displayName ?? areaCode }
                }
            } catch (_) { /* fall through ไป guess จาก Layout Template แทน */ }
        }
        const layoutId = document.getElementById('asmLayoutSelect')?.value
        const layout   = _asmLayouts.find(l => String(l.id) === String(layoutId))
        const tplName  = (layout?.templateName || '').trim()
        const m        = tplName.match(/^FAN_?(\d+)/i)
        const areaCode = m ? `Fan_${m[1]}` : 'Fan_1'
        const match    = Array.from(_locNameMap.values()).find(loc =>
            (loc.locationCode || '').toLowerCase() === areaCode.toLowerCase() ||
            (loc.displayName  || '').toLowerCase() === areaCode.toLowerCase())
        return { code: match?.locationCode ?? areaCode, name: match?.displayName ?? areaCode }
    }

    // W/O + Line ที่จะโชว์บน label — เอาจากวัตถุดิบทุก lot ถ้าตรงกันหมด ไม่ตรงกัน/ไม่มีเลยก็ปล่อยว่าง
    // workOrder ตัวเดียวกันนี้ยังใช้เป็น input ให้ asmResolveProductionArea() หา productionPlant ต่อด้วย
    function _asmResolveLabelWoAndLine() {
        const rows = [...document.querySelectorAll('#asmTable tr[data-lot-no]')]
        const clean = v => (v === 'Mixed' || v === '—') ? '' : v
        return {
            workOrder: clean(_asmCommonOrMixed(rows, 'wo')),
            line:      clean(_asmCommonOrMixed(rows, 'line')),
        }
    }

    async function asmRenderPreviewPanel() {
        const box = document.getElementById('asmPreviewImgBox')
        if (!box) return

        const outputPartNo = document.getElementById('asmOutputPartNo').value.trim()
        if (!outputPartNo) {
            box.innerHTML = '<div class="empty-state" style="padding:0">เลือก Output Part No ก่อน</div>'
            return
        }
        const layoutId = document.getElementById('asmLayoutSelect')?.value
        if (!layoutId) {
            box.innerHTML = '<div class="empty-state" style="padding:0">เลือก Layout Template ก่อน</div>'
            return
        }
        const layout = _asmLayouts.find(l => String(l.id) === String(layoutId))
        if (!layout) {
            box.innerHTML = '<div class="empty-state" style="padding:0">ไม่พบ Layout</div>'
            return
        }

        if (!asmPreviewLotNo && !_asmPreviewFetching) {
            _asmPreviewFetching = true
            try {
                const trRes = await api('/inventory/new-lotNo', 'GET')
                asmPreviewLotNo = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? null
            } catch (_) {
                asmPreviewLotNo = null
            } finally {
                _asmPreviewFetching = false
            }
        }

        const cfg = parseZplDataJson(layout)
        const outputQty = document.getElementById('asmOutputQty').value
        const { workOrder, line } = _asmResolveLabelWoAndLine()
        const area = await asmResolveProductionArea(workOrder)

        const data = {
            partNo:              outputPartNo,
            quantity:            String(outputQty || 0),
            itemType:            1,
            workOrder,
            line,
            lotNo:               asmPreviewLotNo || '(Auto-Gen)',
            uniqueId:            '(Auto-Gen)',   // Preview เท่านั้น — uniqueId จริงจะ fetch สดตอน print จริง (ไม่ fetch ตอน preview กันยิง API ถี่เกิน)
            productionArea:      area.code,
            _productionAreaName: area.name,
            createdAt:           new Date().toISOString(),
        }

        const sliders = {
            qrX: cfg.qrX ?? 30, qrY: cfg.qrY ?? 40, qrSize: cfg.qrSize ?? 5,
            dataX: cfg.dataX ?? 373, dataY: cfg.dataY ?? 58,
            fontSize: cfg.fontSize ?? 22, lineHeight: cfg.lineHeight ?? 33, valOffset: cfg.valOffset ?? 151,
        }
        const textFields = buildLabelTextFields(cfg.labelFields, data)
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        box.innerHTML = '<div class="empty-state" style="padding:0">Rendering…</div>'
        try {
            const src = await renderZplClient(zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
            box.innerHTML = src ? `<img src="${src}">` : '<div class="empty-state" style="padding:0">No preview</div>'
        } catch (_) {
            box.innerHTML = '<div class="empty-state" style="padding:0">Preview failed</div>'
        }
    }

    // ── Submit (photo confirmation + GPS) ─────────────
    // 'printAssembly' = Print & Assembly (บังคับถ้าไม่มีสิทธิ์ WMS.UI.Assembly.SkipPrint), 'assemblyOnly' = ไม่พิมพ์
    let asmActionMode = 'printAssembly'

    function submitAssembly() {
        const rows = [...document.querySelectorAll('#asmTable tr[data-lot-no]')]
        if (!rows.length || _asmSubmitting) { toast('กรุณาเพิ่มอย่างน้อย 1 Material', 'err'); return }
        if (!document.getElementById('asmOutputPartNo').value.trim()) { toast('กรุณาเลือก Output Part No', 'err'); return }
        if (!(parseFloat(document.getElementById('asmOutputQty').value) > 0)) { toast('กรุณากรอก Output Qty', 'err'); return }

        document.getElementById('asmResultBanner').style.display = 'none'

        if (asmCanSkipPrint) {
            document.getElementById('asmActionModal').style.display = 'flex'
        } else {
            asmActionMode = 'printAssembly'
            asmContinueSubmit()
        }
    }

    function asmCloseActionModal() {
        document.getElementById('asmActionModal').style.display = 'none'
    }

    function asmChooseAction(mode) {
        asmActionMode = mode
        asmCloseActionModal()
        asmContinueSubmit()
    }

    function asmContinueSubmit() {
        if (asmActionMode === 'printAssembly') {
            if (!document.getElementById('asmLayoutSelect')?.value)  { toast('กรุณาเลือก Layout Template ก่อน Print', 'err'); return }
            if (!document.getElementById('asmPrinterSelect')?.value) { toast('กรุณาเลือก Printer ก่อน Print', 'err'); return }
        }
        if (document.getElementById('advSkipImg')?.checked) {
            doAssembly()
        } else {
            asmPhoto.open()
        }
    }

    // พิมพ์ label ของ Output Part หลัง Assembly สำเร็จ — ใช้ Layout/Printer ที่เลือกไว้ + Output Part/Qty ที่กรอก
    // workOrder/line ต้องรับเป็น parameter (เก็บมาจาก #asmTable ก่อนถูกเคลียร์ใน doAssembly()) — ตอนฟังก์ชันนี้ทำงาน
    // ตาราง material ถูกเคลียร์ไปแล้ว (assembly สำเร็จ) เลยอ่านจาก DOM ตรงนี้ไม่ได้อีกต่อไป
    async function asmPrintOutputLabel(outputPartNo, lotNo, workOrder, line) {
        const layoutId    = document.getElementById('asmLayoutSelect')?.value
        const printerSel  = document.getElementById('asmPrinterSelect')
        const printerIp   = printerSel?.value
        const printerPort = printerSel?.dataset.port || 9100
        const layout = _asmLayouts.find(l => String(l.id) === String(layoutId))
        if (!layout) throw new Error('ไม่พบ Layout ที่เลือก')
        const cfg = parseZplDataJson(layout)

        const uniqueId  = await _fetchUniqueId()
        const outputQty = document.getElementById('asmOutputQty').value
        const area      = await asmResolveProductionArea(workOrder)

        let finalLotNo = lotNo
        if (!finalLotNo) {
            const trRes = await api('/inventory/new-lotNo', 'GET')
            finalLotNo = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? '(Auto-Gen)'
        }

        const data = {
            partNo:              outputPartNo,
            quantity:            String(outputQty || 0),
            itemType:            1,
            workOrder,
            line,
            lotNo:               finalLotNo,
            uniqueId,
            productionArea:      area.code,
            _productionAreaName: area.name,
            createdAt:           new Date().toISOString(),
        }

        const sliders = {
            qrX: cfg.qrX ?? 30, qrY: cfg.qrY ?? 40, qrSize: cfg.qrSize ?? 5,
            dataX: cfg.dataX ?? 373, dataY: cfg.dataY ?? 58,
            fontSize: cfg.fontSize ?? 22, lineHeight: cfg.lineHeight ?? 33, valOffset: cfg.valOffset ?? 151,
        }
        const textFields = buildLabelTextFields(cfg.labelFields, data)
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        const payload = { printerIp, printerPort, lotNo: finalLotNo, uniqueId, zpl: applyPrintOffset(zpl, cfg) }
        const res = await api('/printer/send', 'POST', payload, 10000)
        const pd  = res?.problemDetails
        if (pd || (res?.statusCode && res.statusCode >= 400)) {
            throw new Error([pd?.title, pd?.detail].filter(Boolean).join(': ') || res?.message || 'Print failed')
        }
    }

    function _setRowAction(row, html) {
        const lastTd = row.cells[row.cells.length - 1]
        if (lastTd) lastTd.innerHTML = html
    }

    function _setRowError(row, errMsg) {
        row.classList.add('row-err')
        _setRowAction(row, `<button class="del-btn" onclick="asmRemoveRow(this)" title="Remove"><i class="bi bi-trash3"></i></button>`)
        const existing = row.nextElementSibling
        if (existing?.classList.contains('row-err-detail')) existing.remove()
        row.insertAdjacentHTML('afterend', `
            <tr class="row-err-detail">
                <td colspan="6"><span style="font-size:11px;color:var(--red);font-weight:600">${esc(errMsg)}</span></td>
            </tr>`)
    }

    async function doAssembly() {
        if (_asmSubmitting) return
        _asmSubmitting = true
        asmUpdateState()

        const sendBtn = document.getElementById('asmPcSendBtn')
        sendBtn.disabled = true

        try {
            let latitude = null, longitude = null, heigth = null
            if (!document.getElementById('advSkipGps')?.checked) {
                if (!navigator.geolocation) { toast('Browser ไม่รองรับ GPS', 'err'); return }
                sendBtn.innerHTML = '<i class="bi bi-geo-alt"></i> Getting GPS…'
                try {
                    const pos = await new Promise((res, rej) =>
                        navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
                    )
                    latitude  = pos.coords.latitude
                    longitude = pos.coords.longitude
                    heigth    = pos.coords.altitude
                } catch (e) {
                    toast('GPS error: ' + e.message, 'err'); return
                }
            }
            sendBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลัง Assembly…'

            const rows = [...document.querySelectorAll('#asmTable tr[data-lot-no]')]
            if (!rows.length) { toast('กรุณาเพิ่มอย่างน้อย 1 Material', 'err'); return }
            const outputPartNo = document.getElementById('asmOutputPartNo').value.trim()
            if (!outputPartNo) { toast('กรุณาเลือก Output Part No', 'err'); return }

            // เก็บ W/O + Line ไว้ตอนนี้เลย ก่อน #asmTable จะถูกเคลียร์ทิ้งหลัง assembly สำเร็จ (asmPrintOutputLabel อ่านจาก DOM ไม่ได้อีกแล้วตอนนั้น)
            const { workOrder, line } = _asmResolveLabelWoAndLine()
            // Advanced Options (Skip Permission ต่างๆ) ใช้ชุดเดียวกันทั้ง /inventory/split และ /inventory/assembly
            const options = getAdvancedOptions()

            // ── แถวที่แก้ qty ลง (pending split) ต้องยิง /inventory/split ให้สำเร็จทุกแถวก่อน ถึงจะไป Assembly ต่อได้ ──
            // ยิงทีละแถว (ไม่ parallel) แล้วหยุดทันทีถ้าแถวไหน fail — แถวที่แบ่งสำเร็จไปแล้วก่อนหน้าถือว่าสำเร็จจริงในระบบแล้ว (ไม่มี API ยกเลิก split) จึง mark ไว้ไม่ให้ยิงซ้ำถ้ากด Assembly ใหม่
            const splitRows = rows.filter(r => r.dataset.needsSplit === 'true')
            if (splitRows.length) {
                sendBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลังแบ่ง Lot…'
                for (const row of splitRows) {
                    row.classList.remove('row-err')
                    const errDetail = row.nextElementSibling
                    if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
                    row.classList.add('row-processing')

                    const qty = parseFloat(row.querySelector('[data-qty-input]')?.value) || 0
                    // backend สะกด "longitude" ผิดเป็น "longtitude" (ยืนยันจาก Swagger request จริงของ /inventory/split ที่ทดสอบสำเร็จ) ต้องส่งตามนี้เป๊ะๆ
                    const splitPayload = {
                        parentLotNo: row.dataset.parentLotNo,
                        childLotNo:  row.dataset.lotNo,
                        qty,
                        latitude, longtitude: longitude, heigth,
                        options,
                    }
                    console.log('[Assembly→Split] payload →', splitPayload)
                    try {
                        const splitRes = await apiForm('/inventory/split', splitPayload, asmPhoto.getBlobs(), 10000, 'POST', 'files')
                        console.log('[Assembly→Split] response →', splitRes)
                        if (splitRes && splitRes.success === false) throw new Error(splitRes.message || 'Split failed')
                        row.dataset.needsSplit = 'false'
                        row.classList.remove('row-processing')
                    } catch (splitErr) {
                        const msg    = splitErr.message || 'Split failed'
                        const tagged = splitErr.status ? `HTTP ${splitErr.status}: ${msg}` : msg
                        rows.forEach(r => r.classList.remove('row-processing'))
                        asmSetGroupOpen(row.dataset.partNo, true)
                        _setRowError(row, `Split failed: ${tagged}`)
                        toast('❌ แบ่ง Lot ไม่สำเร็จ: ' + tagged, 'err', { duration: 7000 })
                        return   // หยุดก่อน ไม่ไปเรียก /inventory/assembly ต่อ
                    }
                }
            }

            const materials = rows.map(r => ({
                lotNo:    r.dataset.lotNo,
                quantity: parseFloat(r.querySelector('[data-qty-input]')?.value) || 0,
            }))
            // backend สะกด "longitude" ผิดเป็น "longtitude" (ยืนยันจาก Swagger request จริงของ /inventory/split ที่ทดสอบสำเร็จ) ต้องส่งตามนี้เป๊ะๆ
            const payload = { outputPartNo, currentLongtitude: longitude, currentLatitude: latitude, heigth, materials, options }

            console.log('[Assembly] payload →', payload)
            toastPayload('[Assembly] payload', payload)

            sendBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลัง Assembly…'
            rows.forEach(row => {
                const errDetail = row.nextElementSibling
                if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
                row.classList.remove('row-err', 'row-ok')
                row.classList.add('row-processing')
            })

            try {
                const res = await apiForm('/inventory/assembly', payload, asmPhoto.getBlobs(), 10000, 'POST', 'files')
                console.log('[Assembly] response →', res)

                // backend บาง error (เช่น "Assembly only allowed in PreAssembly") ตอบกลับมาเป็น HTTP 200
                // พร้อม { success:false, message:"..." } แทนที่จะเป็น HTTP error — apiForm() เลยไม่ throw ให้เอง
                // ต้องเช็ค success flag เองตรงนี้ ไม่งั้นจะถือว่าสำเร็จทั้งที่จริงๆ ล้มเหลว
                if (res && res.success === false) throw new Error(res.message || 'Assembly failed')

                // สำเร็จจริง → เคลียร์ list ทิ้งทั้งหมด
                rows.forEach(row => asmScannedLots.delete(row.dataset.lotNo))
                document.getElementById('asmTable').innerHTML = ''
                asmCheckEmpty()
                document.getElementById('asmResultPartNo').textContent = outputPartNo
                document.getElementById('asmResultLotNo').textContent  = asmPreviewLotNo || '—'
                document.getElementById('asmResultBanner').style.display = 'flex'
                toast(`Assembly สำเร็จ ✓`, 'ok')

                // Assembly สำเร็จแล้ว — ถ้าเลือกโหมด Print & Assembly ให้พิมพ์ label ของ Output Part ต่อ
                if (asmActionMode === 'printAssembly') {
                    try {
                        await asmPrintOutputLabel(outputPartNo, asmPreviewLotNo, workOrder, line)
                        toast('🖨️ พิมพ์ label สำเร็จ', 'ok')
                    } catch (printErr) {
                        toast(`⚠️ Assembly สำเร็จ แต่ Print ล้มเหลว: ${printErr.message || 'Print failed'}`, 'warn')
                    }
                }

                // เคลียร์ Output Part/Qty สำหรับงาน assembly ครั้งถัดไป
                document.getElementById('asmOutputPartInput').value = ''
                document.getElementById('asmOutputPartNo').value    = ''
                document.getElementById('asmOutputQty').value       = ''
                document.getElementById('asmOutputPreview').style.display = 'none'
                _asmBomProfile    = null
                _asmRequiredParts = new Map()
                asmPreviewLotNo = null
            } catch (err) {
                // Assembly เป็น call เดียวรวมทั้งก้อน — fail ทีเดียวกระทบทุก material ใน list เลย ใส่ inline error ให้ทุกแถว
                const msg    = err.message || 'Assembly failed'
                const tagged = err.status ? `HTTP ${err.status}: ${msg}` : msg
                rows.forEach(row => {
                    row.classList.remove('row-processing')
                    asmSetGroupOpen(row.dataset.partNo, true)   // ขยายกลุ่มให้เห็น error แม้กลุ่มนั้นหุบไว้อยู่
                    _setRowError(row, `Assembly failed: ${tagged}`)
                })
                toast('❌ ' + tagged, 'err', { duration: 7000 })
            }
        } finally {
            _asmSubmitting = false
            asmUpdateState()
            sendBtn.innerHTML = 'Send'
            sendBtn.disabled = false
            asmPhoto.close()
        }
    }

    const asmPhoto = createPhotoCapture({ prefix: "asm", maxDimension: 1920 })
    document.getElementById('asmPcSendBtn').addEventListener('click', doAssembly)
    document.getElementById('asmPcCancelBtn').addEventListener('click', () => asmPhoto.close())

    window.addEventListener('beforeunload', (e) => {
        if (asmScanner.running) stopScan()
        if (document.querySelectorAll('#asmTable tr[data-lot-no]').length > 0) {
            e.preventDefault()
            e.returnValue = ''
        }
    })

    // ── Fallback keyboard HW scanner (ใช้เมื่อ focus อยู่นอก input ใดๆ) ──
    ;(function() {
        let _buf = '', _timer = null
        const THRESHOLD = 150, MIN = 4
        function commit() {
            const c = _buf; _buf = ''
            if (c.length >= MIN) asmScan.submit(c)
        }
        document.addEventListener('keydown', e => {
            if (asmScanner.running) return
            const active = document.activeElement
            if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) return
            if (e.key === 'Enter') { clearTimeout(_timer); commit(); return }
            if (e.key.length === 1) { _buf += e.key; clearTimeout(_timer); _timer = setTimeout(commit, THRESHOLD) }
        })
    })()

    // ── Role: Advanced Options + Print permission gating ──────
    // WMS.UI.Assembly.SkipPrint = สิทธิ์ให้เลือก "Assembly Only" ได้ (ไม่มีสิทธิ์นี้ → บังคับ Print & Assembly เสมอ)
    let asmCanSkipPrint = false
    let asmIsAdmin = false
    ;(function() {
        const adminRoles = ['Admin']
        try {
            const user       = JSON.parse(localStorage.getItem('user') || '{}')
            const userRoles  = Array.isArray(user.roles) ? user.roles : []
            const userPermis = Array.isArray(user.permissions) ? user.permissions : []
            asmIsAdmin      = userRoles.some(r => adminRoles.includes(r))
            asmCanSkipPrint = asmIsAdmin || userPermis.includes('WMS.UI.Assembly.SkipPrint')
            applyAdvancedOptionsPermissions(userPermis, asmIsAdmin)

            // ปุ่มสลับ Scan Mode (Our/Vendor) — ต้องมี permission นี้ถึงจะเห็น ไม่งั้นซ่อนแล้วใช้ Our เป็น default เสมอ
            const canReadBarcodeVendor = asmIsAdmin || userPermis.includes('WMS.UI.ReadBarcodeVendor')
            document.getElementById('asmBcModeGroup').style.display = canReadBarcodeVendor ? '' : 'none'
        } catch (_) {}
    })()

    let _asmLayouts = []

    const asmPrinterPicker = createPrinterPicker({
        triggerId: 'asmPrinterTrigger', menuId: 'asmPrinterMenu', hiddenId: 'asmPrinterSelect',
        dotId: 'asmPrinterDot', nameId: 'asmPrinterName', ipId: 'asmPrinterIp',
        isAdmin: asmIsAdmin,
    })

    async function init() {
        await loadLocation()
        await loadPerLocation()   // asmPrinterPicker.load() กรอง printer ตาม myLocations เลยต้องรอให้พร้อมก่อน
        _asmLayouts = await loadLayoutOptions(document.getElementById('asmLayoutSelect'), asmIsAdmin)
        await asmPrinterPicker.load()
    }
    init()
</script>
}
