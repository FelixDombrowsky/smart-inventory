@{
    ViewData["Title"] = "Lot Detail";
}

<link rel="stylesheet" href="css/lotdetail.css"/>
<!-- @@font-face ของ ZebraFont (ใช้ตอน render barcode preview ผ่าน renderZplClient) — ประกาศไว้ที่ printqr.css ไฟล์เดียวกับ PrintQR.cshtml -->
<link rel="stylesheet" href="css/printqr.css"/>

<!-- TOP: ข้อมูลหลักของล็อต (ซ้าย) + การ์ดจำนวน (ขวา, สไตล์ feature navy เหมือน Dashboard) -->
<div class="ld-top">
    <div class="ld-hero">
        <div class="ld-hero-head">
            <a href="Inventory/Lots" class="ld-back"><i class="bi bi-arrow-left"></i><span data-i18n="backToLots">Back to Lots</span></a>
            <span id="infoStatus"></span>
        </div>
        <div class="ld-hero-body">
            <div class="ld-thumb" id="lotThumb" onclick="openLotImage()">
                <i class="bi bi-box-seam"></i>
                <img id="lotImg" src="" alt="">
            </div>
            <div class="ld-hero-text">
                <div class="ld-eyebrow" data-i18n="lotNo">Lot No.</div>
                <div class="ld-lotno-row">
                    <h2 id="lotTitle">Loading…</h2>
                    <button type="button" class="ld-copy" id="ldCopyBtn" onclick="copyLotNo()" data-i18n-title="copyLotNo" title="Copy Lot No."><i class="bi bi-copy"></i></button>
                </div>
                <div class="ld-hero-desc" id="heroDesc"></div>
            </div>
        </div>
        <div class="ld-chips" id="heroChips"></div>
    </div>

    <div class="ld-qty">
        <div class="ld-qty-head">
            <span data-i18n="available">Available</span>
            <span class="ld-qty-unit" id="qtyUnit"></span>
        </div>
        <div class="ld-qty-big" id="sAvailable">—</div>
        <div class="ld-qty-bar" id="qtyBar">
            <span class="seg-av"></span><span class="seg-rs"></span><span class="seg-cs"></span>
        </div>
        <div class="ld-qty-legend">
            <div><i class="dot dot-oh"></i><span data-i18n="onHand">On Hand</span><b id="sOnHand">—</b></div>
            <div><i class="dot dot-rs"></i><span data-i18n="reserved">Reserved</span><b id="sReserved">—</b></div>
            <div><i class="dot dot-cs"></i><span data-i18n="consumed">Consumed</span><b id="sConsumed">—</b></div>
        </div>
    </div>
</div>

<!-- MAIN LAYOUT -->
<div class="main-layout">

    <!-- LEFT: LOT INFO (จัดกลุ่มเป็นหมวด) -->
    <div class="info-card">
            <div class="ld-sec">
                <div class="ld-sec-title"><i class="bi bi-box"></i><span data-i18n="secItem">Item</span></div>
                <div class="info-row"><span class="info-label" data-i18n="partNo">Part No.</span><span class="info-val flex" id="infoPartNo">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="description">Description</span><span class="info-val muted" id="infoDesc">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="model">Model</span><span class="info-val muted" id="infoModel">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="unit">Unit</span><span class="info-val muted" id="infoUnit">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="weight">Weight</span><span class="info-val muted" id="infoWeight">—</span></div>
            </div>
            <div class="ld-sec">
                <div class="ld-sec-title"><i class="bi bi-gear"></i><span data-i18n="secProduction">Production</span></div>
                <div class="info-row"><span class="info-label" data-i18n="workOrder">Work Order</span><span class="info-val mono" id="infoWO">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="line">Line</span><span class="info-val muted" id="infoLine">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="productionDeadline">Production Deadline</span><span class="info-val muted" id="infoProductionDeadline">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="productionReached">Production Reached</span><span class="info-val muted" id="infoProductionReached">—</span></div>
            </div>
            <div class="ld-sec">
                <div class="ld-sec-title"><i class="bi bi-geo-alt"></i><span data-i18n="secStorage">Location & Status</span></div>
                <div class="info-row"><span class="info-label" data-i18n="location">Location</span><span class="info-val flex" id="infoLoc">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="locationEnteredAt">Location Entered At</span><span class="info-val muted" id="infoLocationEnteredAt">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="palletNo">Pallet No.</span><span class="info-val mono" id="infoPalletNo">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="printed">Printed</span><span class="info-val" id="infoPrinted">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="createdAt">Created At</span><span class="info-val muted" id="infoCreatedAt">—</span></div>
            </div>
            <div class="ld-sec">
                <div class="ld-sec-title"><i class="bi bi-upc"></i><span data-i18n="secTrace">Traceability</span></div>
                <div class="info-row"><span class="info-label" data-i18n="vendorCode">Vendor Code</span><span class="info-val muted" id="infoVendorCode">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="dateCode">Date Code</span><span class="info-val muted" id="infoDateCode">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="tradingCode">Trading Code</span><span class="info-val muted" id="infoTradingCode">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="po">PO</span><span class="info-val muted" id="infoPO">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="inventoryNo">Inventory No.</span><span class="info-val muted" id="infoInventoryNo">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="traceId">Trace ID</span><span class="info-val mono small" id="infoTraceId">—</span></div>
                <div class="info-row"><span class="info-label" data-i18n="rawBarcode">Raw Barcode</span><span class="info-val mono small" id="infoRawBarcode">—</span></div>
            </div>
    </div>

    <!-- RIGHT: TIMELINE -->
    <div class="timeline-card">
        <div class="timeline-head">
            <div class="timeline-title">
                <span class="ld-sec-ico"><i class="bi bi-clock-history"></i></span>
                <span data-i18n="lotHistory">Lot History</span>
                <span id="txCountBadge" class="count-badge"></span>
            </div>
        </div>
        <div class="timeline-body">
            <div class="timeline" id="timeline">
                <div class="tl-empty" data-i18n="loading">Loading…</div>
            </div>
        </div>
    </div>

</div>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox">
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" onclick="lightboxStep(-1)"><i class="bi bi-chevron-left"></i></button>
    <div class="lightbox-inner">
        <button class="lightbox-close" onclick="closeLightbox()">✕</button>
        <img class="lightbox-img" id="lightboxImg" src="">
        <div class="lightbox-caption" id="lightboxCaption"></div>
    </div>
    <button class="lightbox-nav lightbox-next" id="lightboxNext" onclick="lightboxStep(1)"><i class="bi bi-chevron-right"></i></button>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/locationTypeMeta.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/lotStatusTypeMeta.js"></script>
<script src="js/itemTypeMeta.js"></script>
<script src="js/transactionTypeMeta.js"></script>
<script src="js/zplBuilder.js"></script>
<script>
    const LOT = new URL(location.href).searchParams.get('lot') || ''

    // คำแปลของหน้านี้ (LOTDETAIL_LABELS มาจาก js/i18n.js) — เรียก ldDict() สดทุกจุดที่สร้างข้อความแทน hardcode
    function ldDict() { return LOTDETAIL_LABELS[getCurrentLang()] || LOTDETAIL_LABELS.en }

    function fmt(n) { return (n ?? 0).toLocaleString() }

    function locBadgeForCode(code) {
        if (!code) return ''
        const found = _locNameMap.get(code)
        const name  = found?.displayName ?? code
        const type  = found?.typeName ?? found?.type ?? ''
        return `<span class="loc-type-badge" style="${locTypeBadgeStyle(type)}">${locHierTypeIcon(type)}${name}</span>`
    }

    // ── Lightbox (เหมือนหน้า Transaction) ──
    let lbImages = [], lbIndex = 0, lbCaption = ''
    let txImagesMap = {}   // transactionId → { images:[...], caption }
    let _printZplMap = {}  // timeline idx → zplData ดิบ (เอาไว้ render preview ตอนกด View Barcode)

    // ── ชื่อเครื่องพิมพ์ (จาก /printer/all) — โชว์คู่กับ printerIp ในการ์ด Print/Re-Print ของ Lot History ──
    let _printerNameByIp = {}
    async function loadPrinterNames() {
        try {
            const res = await api('/printer/all', 'GET')
            const printers = Array.isArray(res) ? res : (res?.data ?? [])
            printers.forEach(p => { _printerNameByIp[p.printerIp] = (p.printerName || '').replace(/[\r\n]+/g, ' ').trim() })
        } catch (_) {
            // โหลดไม่สำเร็จ — ปล่อยให้ timeline โชว์แค่ printerIp เหมือนเดิม ไม่ block การใช้งานอื่น
        }
    }

    // แปลง zplData ของ print history event เป็นรูป barcode แล้วเปิดโชว์ผ่าน lightbox เดิม (ใช้ default size 8dpmm/3.2x1.2in เหมือน _History.cshtml)
    async function lotShowBarcodePreview(idx) {
        const zpl = _printZplMap[idx]
        if (!zpl) return
        try {
            const src = await renderZplClient(zpl, '8dpmm', 3.2, 1.2)
            if (src) openLightbox([src], 0, 'Barcode Preview')
        } catch (err) {
            console.error('lotShowBarcodePreview:', err)
        }
    }

    function openLightbox(images, index, caption) {
        lbImages  = images
        lbIndex   = ((index || 0) % images.length + images.length) % images.length
        lbCaption = caption || ''
        renderLightbox()
        document.getElementById('lightbox').classList.add('show')
    }
    function openLightboxFor(txId, index) {
        const entry = txImagesMap[txId]
        if (!entry || !entry.images.length) return
        openLightbox(entry.images, index, entry.caption)
    }
    function renderLightbox() {
        const multi = lbImages.length > 1
        document.getElementById('lightboxImg').src = lbImages[lbIndex]
        document.getElementById('lightboxCaption').textContent =
            lbCaption + (multi ? ` · ${lbIndex + 1}/${lbImages.length}` : '')
        document.getElementById('lightboxPrev').style.display = multi ? 'flex' : 'none'
        document.getElementById('lightboxNext').style.display = multi ? 'flex' : 'none'
    }
    function lightboxStep(delta) {
        if (lbImages.length < 2) return
        lbIndex = (lbIndex + delta + lbImages.length) % lbImages.length
        renderLightbox()
    }
    function closeLightbox() {
        document.getElementById('lightbox').classList.remove('show')
        document.getElementById('lightboxImg').src = ''
        lbImages = []
    }
    document.addEventListener('keydown', e => {
        if (!document.getElementById('lightbox').classList.contains('show')) return
        if (e.key === 'Escape')     closeLightbox()
        if (e.key === 'ArrowLeft')  lightboxStep(-1)
        if (e.key === 'ArrowRight') lightboxStep(1)
    })

    // รูปแบบสากล ISO 8601-ish (YYYY-MM-DD HH:mm) — เลี่ยง locale เพราะ th-TH จะได้ปี พ.ศ. ที่สับสนตอนสื่อสารข้ามระบบ/ประเทศ
    function fmtDate(d) {
        if (!d) return '—'
        const dt = new Date(d)
        const pad  = n => String(n).padStart(2, '0')
        const date = `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`
        const time = `${pad(dt.getHours())}:${pad(dt.getMinutes())}:${pad(dt.getSeconds())}`
        return { date, time, full: date + ' ' + time }
    }

    function qtyDisplay(qty, type) {
        if (!type) return `<span class="tl-qty-neu">${qty}</span>`
        const t = type.toLowerCase()
        if (['receive'].includes(t))   return `<span class="tl-qty-up">+${qty}</span>`
        if (['void'].includes(t))   return `<span class="tl-qty-down">${qty}</span>`
        return `<span class="tl-qty-neu">${qty}</span>`
    }

    // แถบสัดส่วน พร้อมใช้ / จอง / ใช้ไป เทียบกับทั้งหมด (Available + Reserved + Consumed)
    function _renderQtyBar(lot) {
        const av = Math.max(0, lot.available ?? 0), rs = Math.max(0, lot.reservedQty ?? 0), cs = Math.max(0, lot.consumedQty ?? 0)
        const total = av + rs + cs
        const bar = document.getElementById('qtyBar')
        const pct = v => total ? (v / total * 100) + '%' : '0%'
        bar.querySelector('.seg-av').style.width = pct(av)
        bar.querySelector('.seg-rs').style.width = pct(rs)
        bar.querySelector('.seg-cs').style.width = pct(cs)
    }

    function copyLotNo() {
        const btn = document.getElementById('ldCopyBtn')
        const done = () => {
            btn.innerHTML = '<i class="bi bi-check2"></i>'; btn.classList.add('ok')
            setTimeout(() => { btn.innerHTML = '<i class="bi bi-copy"></i>'; btn.classList.remove('ok') }, 1200)
        }
        if (navigator.clipboard?.writeText) { navigator.clipboard.writeText(LOT).then(done).catch(() => {}); return }
        // http (ไม่ใช่ secure context) ไม่มี clipboard API — ใช้ textarea + execCommand แทน
        const t = document.createElement('textarea'); t.value = LOT; document.body.appendChild(t); t.select()
        try { document.execCommand('copy'); done() } catch (_) {}
        t.remove()
    }

    function openLotImage() {
        if (!document.getElementById('lotThumb').classList.contains('has-img')) return
        openLightbox([document.getElementById('lotImg').src], 0, LOT)
    }

    function escHtml(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
    }

    // ── Load Lot Info ──
    async function loadLotInfo() {
        try {
            const data = await api('/inventory/lots', 'POST', { lotNo: LOT, page: 1, pageSize: 1 })
            const lot  = data?.data?.[0]
            if (!lot) return

            // แยก try/catch ของตัวเอง — ถ้า /master/items ล้ม ไม่ควรดึงให้ข้อมูล lot หลักทั้งหมดพังไปด้วย
            let imgPath = null
            try {
                const itemDetail = await api(`/master/items?PartNo=${encodeURIComponent(lot.partNo)}&Page=1&PageSize=1`, 'GET')
                imgPath = itemDetail?.data?.[0]?.imagePath ?? null
            } catch (err) {
                console.error('loadLotInfo (image):', err)
            }

            const locDisplay = locName(lot.location)

            document.getElementById('lotTitle').textContent    = LOT
            @* document.getElementById('lotSubtitle').textContent = `${lot.partNo ?? ''} · ${lot.description ?? ''} · ${locDisplay}` *@

            document.getElementById('sOnHand').textContent    = fmt(lot.onHandQty)
            document.getElementById('sReserved').textContent  = fmt(lot.reservedQty)
            document.getElementById('sAvailable').textContent = fmt(lot.available)
            document.getElementById('sConsumed').textContent  = fmt(lot.consumedQty)
            document.getElementById('qtyUnit').textContent    = lot.unit ?? lot.baseUnit ?? ''
            _renderQtyBar(lot)

            document.getElementById('infoDesc').textContent   = lot.description ?? '—'
            document.getElementById('infoWO').textContent     = lot.workOrder   ?? '—'
            document.getElementById('infoLine').textContent   = lot.lineName    ?? '—'
            document.getElementById('infoModel').textContent  = lot.modelName   ?? '—'
            document.getElementById('infoPalletNo').textContent = lot.palletNo || '—'
            document.getElementById('infoUnit').textContent   = lot.unit ?? lot.baseUnit ?? '—'
            document.getElementById('infoWeight').textContent = lot.totalWeight ? `${fmt(lot.totalWeight)} ${lot.weightUnit ?? ''}`.trim() : '—'
            document.getElementById('infoVendorCode').textContent   = lot.vendorCode   || '—'
            document.getElementById('infoDateCode').textContent     = lot.dateCode     || '—'
            document.getElementById('infoTradingCode').textContent  = lot.tradingCode  || '—'
            document.getElementById('infoPO').textContent           = lot.po           || '—'
            document.getElementById('infoInventoryNo').textContent  = lot.inventoryNo  || '—'
            document.getElementById('infoTraceId').textContent      = lot.traceId      || '—'
            document.getElementById('infoRawBarcode').textContent   = lot.rawBarcode   || '—'
            document.getElementById('infoCreatedAt').textContent    = lot.createdAt ? fmtDate(lot.createdAt).full : '—'
            document.getElementById('infoLocationEnteredAt').textContent  = lot.locationEnteredAt   ? fmtDate(lot.locationEnteredAt).full   : '—'
            document.getElementById('infoProductionDeadline').textContent = lot.productionDeadlineAt ? fmtDate(lot.productionDeadlineAt).full : '—'
            document.getElementById('infoProductionReached').textContent  = lot.productionReachedAt  ? fmtDate(lot.productionReachedAt).full  : '—'

            document.getElementById('infoPartNo').innerHTML =
                `<span>${lot.partNo ?? '—'}</span>${itemTypeBadge(lot.itemTypeName)}`
            document.getElementById('infoLoc').innerHTML =
                `<span>${locDisplay || '—'}</span>${locTypeBadge(lot.locationType)}`

            // Hero: คำอธิบาย + ชิปสรุป (Part / Location / W/O / Line)
            document.getElementById('heroDesc').textContent = lot.description || ''
            const d = ldDict()
            const chip = (icon, label, val) => val
                ? `<span class="ld-chip"><i class="bi ${icon}"></i><span class="ld-chip-lbl">${label}</span><b>${escHtml(val)}</b></span>` : ''
            document.getElementById('heroChips').innerHTML =
                chip('bi-box', d.partNo, lot.partNo) +
                (lot.location ? `<span class="ld-chip ld-chip-loc">${locBadgeForCode(lot.location)}</span>` : '') +
                chip('bi-clipboard-check', d.workOrder, lot.workOrder) +
                chip('bi-diagram-3', d.line, lot.lineName)

            document.getElementById('infoStatus').innerHTML = lotStatusBadge(lot.status)

            // รูปสินค้า — ไม่มี/โหลดไม่ได้ ให้เหลือไอคอนกล่องแทน
            const img = document.getElementById('lotImg'), thumb = document.getElementById('lotThumb')
            if (imgPath) {
                img.onload  = () => thumb.classList.add('has-img')
                img.onerror = () => thumb.classList.remove('has-img')
                img.src = CONFIG.INVENTORY_API + imgPath
            } else {
                thumb.classList.remove('has-img')
            }
        } catch (err) { console.error('loadLotInfo:', err) }
    }

    // ── Skip badges (เหมือน Transactions.cshtml) — skipOptions เป็น JSON string ต่อ transaction (มีเฉพาะ transaction ที่
    // รองรับ Advanced Options เช่น Receive — อันอื่นเช่น Transfer เป็น null) โชว์เฉพาะตัวที่เป็น true เป็น badge เล็กๆ ต่อกัน
    // ชื่อ key ตรงกับ getAdvancedOptions() ใน _AdvancedOptions.cshtml เป๊ะ (แค่ต่างกันที่ตัวพิมพ์ใหญ่ตัวแรก)
    const LD_SKIP_OPTION_LABELS = {
        SkipGpsValidation:             'GPS',
        SkipPrintedValidation:         'Printed',
        SkipWorkOrderValidation:       'W/O',
        SkipLocationValidation:        'Location',
        SkipLotDuplicateValidation:    'Lot Duplicate',
        SkipReservedLotValidation:     'Reserved Lot',
        SkipManualLotValidation:       'Manual Lot',
        SkipUniquenIdValidation:       'Unique ID',
        SkipUploadImagesValidation:    'Upload Images',
        AllowToCreateNewWoItem:        'New WO Item',
        AllowToOverReceive:            'Over Receive',
        SkipWorkOrderActiveValidation: 'WO Active',
    }
    function _ldActiveSkipKeys(skipOptionsRaw) {
        if (!skipOptionsRaw) return []
        try {
            const opts = JSON.parse(skipOptionsRaw)
            return Object.keys(opts).filter(k => opts[k] === true)
        } catch (_) { return [] }
    }
    function _ldSkipRowHtml(skipOptionsRaw) {
        const keys = _ldActiveSkipKeys(skipOptionsRaw)
        if (!keys.length) return ''
        return `
                        <div class="tl-detail-row">
                            <i class="bi bi-shield-slash" style="font-size:12px"></i>
                            <div style="display:flex;flex-wrap:wrap;gap:3px">${keys.map(k =>
                                `<span class="tl-skip">${escHtml(LD_SKIP_OPTION_LABELS[k] || k)}</span>`
                            ).join('')}</div>
                        </div>`
    }

    // ── Render: transaction event (Receive/Move/Void/...) ──
    function renderTxItem(x, idx) {
        const dt   = fmtDate(x.createdAt)
        const isCurrent = idx === 0

        const fromBadge = locBadgeForCode(x.fromLocation)
        const toBadge   = locBadgeForCode(x.toLocation)
        const locationLine = (fromBadge || toBadge)
            ? `<div class="tl-detail-row">
                ${fromBadge}
                ${fromBadge && toBadge ? `<i class="bi bi-arrow-right tl-arrow"></i>` : ''}
                ${toBadge}
               </div>`
            : ''

        // ── Confirm Image (thumbnail แรก + badge จำนวนรูปที่เหลือ, กดเพื่อเปิด lightbox carousel) ──
        const confirmImages = (x.images || []).map(im => CONFIG.INVENTORY_API + im.imageUrl)
        txImagesMap['tx' + x.id] = {
            images: confirmImages,
            caption: `${x.transactionType ?? ''} · ${x.performedBy ?? ''} · ${dt.full}`
        }
        const imgCell = confirmImages.length
            ? `<div class="thumb-wrap">
                   <img src="${confirmImages[0]}" class="proof-thumb" onclick="openLightboxFor('tx${x.id}', 0)"
                        onerror="this.closest('.thumb-wrap').innerHTML='<span class=no-photo>—</span>'">
                   ${confirmImages.length > 1 ? `<span class="thumb-badge">+${confirmImages.length - 1}</span>` : ''}
               </div>`
            : `<span class="no-photo">—</span>`

        return `
        <div class="tl-item ${isCurrent ? 'current' : ''}">
            <div class="tl-dot">${txTypeIcon(x.transactionType, 18)}</div>
            <div class="tl-content">
                <div class="tl-type">
                    <span class="tl-badge" style="${txTypeBadgeStyle(x.transactionType)}">${x.transactionType ?? '—'}</span>
                    ${isCurrent ? `<span class="tl-current-label"><i></i>${ldDict().current}</span>` : ''}
                    <span class="tl-time">${dt.date} · ${dt.time}</span>
                </div>
                <div class="tl-detail">
                    <div class="tl-detail-rows">
                        <div class="tl-detail-row">
                            @* <i class="bi bi-123" style="font-size:13px"></i> *@
                            <span>${ldDict().qty}</span>
                            ${qtyDisplay(fmt(x.quantity), x.transactionType)}
                        </div>
                        ${locationLine}
                        <div class="tl-detail-row">
                            <i class="bi bi-person-fill" style="font-size:12px"></i>
                            @* <span>BY :</span> *@
                            <strong>${x.performedBy ?? '—'}</strong>
                        </div>
                        ${_ldSkipRowHtml(x.skipOptions)}
                    </div>
                    ${imgCell}
                </div>
            </div>
        </div>`
    }

    // ── Render: print history event (Print / Re-Print) ──
    function renderPrintItem(x, idx) {
        const dt        = fmtDate(x.printedAt)
        const isCurrent = idx === 0
        const typeLabel = x.isReprint ? ldDict().reprint : ldDict().print
        const statusRow = x.success
            ? `<span class="tl-qty-up"><i class="bi bi-check-circle-fill"></i> ${ldDict().success}</span>`
            : `<span class="tl-qty-down"><i class="bi bi-x-circle-fill"></i> ${ldDict().failed}${x.errorMessage ? ` — ${escHtml(x.errorMessage)}` : ''}</span>`

        const reasonRow = `
                        <div class="tl-detail-row">
                            <i class="bi bi-chat-left-text" style="font-size:12px"></i>
                            <span>${escHtml(x.reprintReason || '-')}</span>
                        </div>`

        // Barcode ของรอบพิมพ์นี้ — คลิกเพื่อ render ZPL เป็นรูปแล้วเปิดดูผ่าน lightbox เดิม
        let barcodeRow = ''
        if (x.zplData) {
            _printZplMap[idx] = x.zplData
            barcodeRow = `
                        <div class="tl-detail-row">
                            <button type="button" class="tl-link" onclick="lotShowBarcodePreview(${idx})" title="${ldDict().viewBarcodeTooltip}">
                                <i class="bi bi-upc-scan"></i>${ldDict().viewBarcode}
                            </button>
                        </div>`
        }

        return `
        <div class="tl-item ${isCurrent ? 'current' : ''}">
            <div class="tl-dot">${txTypeIcon(typeLabel, 18)}</div>
            <div class="tl-content">
                <div class="tl-type">
                    <span class="tl-badge" style="${txTypeBadgeStyle(typeLabel)}">${typeLabel}</span>
                    ${isCurrent ? `<span class="tl-current-label"><i></i>${ldDict().current}</span>` : ''}
                    <span class="tl-time">${dt.date} · ${dt.time}</span>
                </div>
                <div class="tl-detail">
                    <div class="tl-detail-rows">
                        <div class="tl-detail-row">
                            <i class="bi bi-hdd-network" style="font-size:12px"></i>
                            <span>${_printerNameByIp[x.printerIp] ? `<strong>${escHtml(_printerNameByIp[x.printerIp])}</strong> <span style="color:var(--t2)">(${escHtml(x.printerIp)})</span>` : escHtml(x.printerIp || '—')}</span>
                        </div>
                        <div class="tl-detail-row">
                            <i class="bi bi-person-fill" style="font-size:12px"></i>
                            <strong>${escHtml(x.printUser || '—')}</strong>
                        </div>
                        <div class="tl-detail-row">
                            ${statusRow}
                        </div>${reasonRow}${barcodeRow}
                    </div>
                </div>
            </div>
        </div>`
    }

    // ── Load Transactions + Print History (timeline รวม เรียงตามเวลาเดียวกัน) ──
    async function loadTimeline() {
        try {
            const body   = { lotNo: LOT, page: 1, pageSize: 50, sortBy: 'createdAt', desc: false }
            const first  = await api('/transaction/get', 'POST', body)
            let txRows   = first.data || []
            const total  = first.totalPages || 1

            if (total > 1) {
                const rest = await Promise.all(
                    Array.from({ length: total - 1 }, (_, i) =>
                        api('/transaction/get', 'POST', { ...body, page: i + 2 })
                    )
                )
                rest.forEach(r => { txRows = txRows.concat(r.data || []) })
            }

            // Print History — endpoint แยกต่างหาก ถ้าโหลดไม่สำเร็จหรือไม่มีข้อมูลเลย ไม่ต้อง block timeline ของ transaction
            let printRows = []
            let printFetchOk = true
            try {
                const ph = await api(`/printer/histories?lotNo=${encodeURIComponent(LOT)}&page=1&pageSize=50`, 'GET')
                printRows = ph?.data || []
            } catch (err) {
                console.error('loadTimeline (print history):', err)
                printFetchOk = false
            }

            // Info card: "Printed" — ถือว่า printed ถ้ามีประวัติพิมพ์สำเร็จอย่างน้อย 1 ครั้ง (Print หรือ Re-Print)
            const printedEl = document.getElementById('infoPrinted')
            if (printedEl) {
                if (!printFetchOk) {
                    printedEl.textContent = '—'
                } else {
                    const printed = printRows.some(x => x.success)
                    printedEl.innerHTML = printed
                        ? `<span style="color:var(--green);font-weight:700;display:inline-flex;align-items:center;gap:5px"><i class="bi bi-check-circle-fill"></i>${ldDict().yes}</span>`
                        : `<span style="color:var(--t3);font-weight:700;display:inline-flex;align-items:center;gap:5px"><i class="bi bi-x-circle"></i>${ldDict().no}</span>`
                }
            }

            const rows = [
                ...txRows.map(x => ({ kind: 'tx', at: x.createdAt, raw: x })),
                ...printRows.map(x => ({ kind: 'print', at: x.printedAt, raw: x })),
            ]

            document.getElementById('txCountBadge').textContent = rows.length + ' ' + ldDict().events

            if (rows.length === 0) {
                document.getElementById('timeline').innerHTML =
                    `<div class="tl-empty">${ldDict().noTransactions}</div>`
                return
            }

            // Sort ใหม่ → เก่า (รวม transaction กับ print history เข้าด้วยกันตามเวลาจริง)
            rows.sort((a, b) => new Date(b.at) - new Date(a.at))

            txImagesMap  = {}
            _printZplMap = {}
            const html = rows.map((row, idx) =>
                row.kind === 'print' ? renderPrintItem(row.raw, idx) : renderTxItem(row.raw, idx)
            ).join('')

            document.getElementById('timeline').innerHTML = html
        } catch (err) {
            console.error('loadTimeline:', err)
            document.getElementById('timeline').innerHTML =
                `<div class="tl-empty" style="color:var(--red)">${ldDict().loadFailed}: ${err.message}</div>`
        }
    }

    // แปลภาษาหน้านี้ทั้งหมด — เรียกตอน init และทุกครั้งที่กดสลับภาษา (ผูกผ่าน window.onLangChange ที่ _Layout.cshtml เรียกให้)
    function applyLotDetailLang() {
        applyDataI18n(ldDict())
        loadLotInfo()
        loadTimeline()
    }
    window.onLangChange = applyLotDetailLang

    async function init(){
        await Promise.all([loadLocation(), loadPrinterNames()])
        applyLotDetailLang()
    }

    init()
</script>
}
