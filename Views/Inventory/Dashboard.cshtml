    // ── Transactions Today + Users Today + Receive Today ──
    // เดิมไล่ยิง /transaction/get ทีละหน้าจนกว่าจะเจอ record ที่ไม่ใช่ของวันนี้ แล้วนับ/filter เอาเองฝั่ง client (ช้า ยิงหลาย
    // request) เปลี่ยนมาใช้ 3 แหล่งข้อมูลที่ตรงกว่าตามที่ขอ:
    // - Users Today: GET /transaction/ranking?from=...&to=... คืน list ต่อ (performedBy, transactionType) — นับ distinct
    //   performedBy เอา (ไม่ใช่ sum ตัวเลขในนั้น เพราะ "Users Today" คือจำนวนคนที่ active วันนี้ ไม่ใช่ยอดรวม transaction)
    // - Transactions Today / Receive Today: POST /transaction/get เอาแค่ field "total" (totalCount) จาก response ตรงๆ
    //   ไม่ต้องไล่ยิงทุกหน้าเหมือนเดิม — Receive Today ส่ง transactionType: "Receive" เพิ่มเข้าไปกรองที่ backend เลย
    // "วันนี้" ใช้ช่วง 00:00:00 UTC ของวันนี้ ถึงเวลาปัจจุบัน (ตาม semantics เดิมที่กรองด้วย createdAt.startsWith(today) แบบ UTC)
    // แสดงลูกศรขึ้น/ลงเทียบกับค่าของ "ช่วงเวลาเดียวกัน" เมื่อสัปดาห์ที่แล้ว (ไม่ใช่เทียบกับเมื่อวาน) ข้าง wb-stat-num — previous
    // เป็น 0 แต่ current มีค่า ถือเป็น "New" (คิด % เพิ่ม/ลดจากฐาน 0 ไม่ได้) ทั้งสองเป็น 0 ถือว่าเท่ากัน ไม่ต้องโชว้ลูกศรอะไรเลย
    function renderStatDelta(elId, current, previous) {
        const el = document.getElementById(elId)
        if (!el) return
        if (previous === 0 && current === 0) { el.className = 'wb-stat-delta'; el.innerHTML = ''; return }
        if (previous === 0) { el.className = 'wb-stat-delta up'; el.innerHTML = '<i class="bi bi-arrow-up-short"></i>New'; return }
        const pct = (current - previous) / previous * 100
        const dir  = pct > 0 ? 'up' : pct < 0 ? 'down' : 'flat'
        const icon = dir === 'up' ? 'bi-arrow-up-short' : dir === 'down' ? 'bi-arrow-down-short' : 'bi-dash-lg'
        el.className = 'wb-stat-delta ' + dir
        el.innerHTML = `<i class="bi ${icon}"></i>${Math.abs(pct).toFixed(0)}%`
    }
    async function loadTodayStats() {
        try {
            const now = new Date()
            // "วันนี้" อิงเที่ยงคืนเวลาไทย (UTC+7 คงที่ ไม่มี DST) ไม่ใช่ UTC midnight แบบเดิม (เดิมรีเซ็ตตอน 07:00 เวลาไทย ทำให้
            // เช้าตรู่ยอด "Today" ว่างเปล่าทั้งที่จริงเป็นวันใหม่ตามเวลาไทยไปแล้ว 7 ชม.) — หาโดย shift เวลาไปข้างหน้า 7 ชม. ก่อน
            // ค่อยอ่าน Y/M/D (ให้ตรงกับปฏิทินไทย) แล้ว shift กลับตอนคำนวณ instant จริงของเที่ยงคืนนั้น (ไม่พึ่ง timezone ของเครื่อง)
            const THAI_OFFSET_MS   = 7 * 60 * 60 * 1000
            const nowThaiShifted   = new Date(now.getTime() + THAI_OFFSET_MS)
            const startOfDay       = new Date(Date.UTC(
                nowThaiShifted.getUTCFullYear(), nowThaiShifted.getUTCMonth(), nowThaiShifted.getUTCDate(), 0, 0, 0, 0
            ) - THAI_OFFSET_MS)
            const fromISO      = startOfDay.toISOString()
            const toISO        = now.toISOString()
            // ช่วงเดียวกันเมื่อ 7 วันก่อน (วันเดียวกันในสัปดาห์ เวลาช่วงเดียวกัน) ใช้เทียบเปอร์เซ็นต์เพิ่ม/ลด — ลบ 7×24 ชม.
            // ออกจากทั้ง from/to ตรงๆ ตรงกับ "same time last week" ไม่ใช่ทั้งวันของ 7 วันก่อน
            const WEEK_MS       = 7 * 24 * 60 * 60 * 1000
            const fromLastWkISO = new Date(startOfDay.getTime() - WEEK_MS).toISOString()
            const toLastWkISO   = new Date(now.getTime() - WEEK_MS).toISOString()

            const [ranking, txRes, rcvRes, rankingLastWk, txResLastWk, rcvResLastWk] = await Promise.all([
                api(`/transaction/ranking?${new URLSearchParams({ from: fromISO, to: toISO })}`, 'GET'),
                api('/transaction/get', 'POST', { page: 1, pageSize: 20, startDate: fromISO, endDate: toISO }),
                api('/transaction/get', 'POST', { page: 1, pageSize: 20, startDate: fromISO, endDate: toISO, transactionType: 'Receive' }),
                api(`/transaction/ranking?${new URLSearchParams({ from: fromLastWkISO, to: toLastWkISO })}`, 'GET'),
                api('/transaction/get', 'POST', { page: 1, pageSize: 20, startDate: fromLastWkISO, endDate: toLastWkISO }),
                api('/transaction/get', 'POST', { page: 1, pageSize: 20, startDate: fromLastWkISO, endDate: toLastWkISO, transactionType: 'Receive' }),
            ])

            const userCount    = new Set((ranking || []).map(r => r.performedBy).filter(Boolean)).size
            const txCount      = txRes?.total  ?? txRes?.totalCount  ?? 0
            const receiveCount = rcvRes?.total ?? rcvRes?.totalCount ?? 0

            const userCountLastWk    = new Set((rankingLastWk || []).map(r => r.performedBy).filter(Boolean)).size
            const txCountLastWk      = txResLastWk?.total  ?? txResLastWk?.totalCount  ?? 0
            const receiveCountLastWk = rcvResLastWk?.total ?? rcvResLastWk?.totalCount ?? 0

            document.getElementById("ws-txtoday").textContent        = txCount.toLocaleString()
            document.getElementById("ws-lots-available").textContent = receiveCount.toLocaleString()
            document.getElementById("ws-users-today").textContent    = userCount.toLocaleString()

            renderStatDelta('ws-users-today-delta',    userCount,    userCountLastWk)
            renderStatDelta('ws-txtoday-delta',        txCount,      txCountLastWk)
            renderStatDelta('ws-lots-available-delta', receiveCount, receiveCountLastWk)
        } catch (err) {
            console.error("loadTodayStats:", err)
            document.getElementById("ws-txtoday").textContent        = "—"
            document.getElementById("ws-lots-available").textContent = "—"
            document.getElementById("ws-users-today").textContent    = "—"
        }
    }

