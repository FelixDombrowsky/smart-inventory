                <button class="view-btn active" id="btnViewTable" onclick="setView('table')" title="Table view" data-i18n-title="tableView">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
                    </svg>
                </button>
                <button class="view-btn" id="btnViewGrid" onclick="setView('grid')" title="Grid view" data-i18n-title="gridView">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div id="tableView" style="overflow-x:auto">
        <table class="inv-table">
            <thead>
                <!-- Part | On Hand | Available | Lots — Reserved / Consumed ดูได้ตอนกดขยายแถว (toggleStockRow → _stockQtyStripHtml) -->
