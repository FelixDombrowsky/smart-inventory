    async function savePackage() {
        const id        = document.getElementById('pkgId').value
        const packageNo = document.getElementById('pkgPackageNo').value.trim()
        const width     = parseFloat(document.getElementById('pkgWidth').value)
        const height    = parseFloat(document.getElementById('pkgHeight').value)
        const length    = parseFloat(document.getElementById('pkgLength').value)
        const weight    = parseFloat(document.getElementById('pkgWeight').value)
        if (!packageNo)     { showModalError('pkgError', 'กรุณากรอก Package No.'); return }
        if (isNaN(width))   { showModalError('pkgError', 'กรุณากรอก Width');       return }
        if (isNaN(height))  { showModalError('pkgError', 'กรุณากรอก Height');      return }
        if (isNaN(length))  { showModalError('pkgError', 'กรุณากรอก Length');      return }
        if (isNaN(weight))  { showModalError('pkgError', 'กรุณากรอก Weight');      return }
        const body = {
            packageNo,
            width, height, length, weight,
            dimensionUnit: document.getElementById('pkgDimensionUnit').value.trim() || null,
            weightUnit:    document.getElementById('pkgWeightUnit').value.trim()    || null,
            description:   document.getElementById('pkgDescription').value.trim()   || null,
        }
        try {
            if (id) await api('/master/package', 'PUT', { id: +id, ...body })
            else    await api('/master/package', 'POST', body)
            closeModal('pkgModal')
            showToast('บันทึก Package สำเร็จ', 'success')
            loadPackages(1)
        } catch (err) { showModalError('pkgError', err.message) }
    }

    async function deletePackage(id) {
        if (!confirm('ลบ Package นี้?')) return
        try {
            await api(`/master/package/${id}`, 'DELETE')
            showToast('ลบสำเร็จ', 'success')
            loadPackages(1)
        } catch (err) { showToast('ลบไม่สำเร็จ: ' + err.message, 'error') }
    }

    // ── AMR Locations ──
    function _amrBool(v, trueLabel, falseLabel) {
        return v
            ? `<span style="background:var(--green-lt);color:var(--green);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">${trueLabel}</span>`
            : `<span style="background:#f0f2f5;color:var(--t3);font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px">${falseLabel}</span>`
    }

    async function loadAmrLocations(page = 1) {
        const search  = document.getElementById('amrSearch').value.trim()
        const type    = document.getElementById('amrTypeFilter').value
        const active  = document.getElementById('amrActiveFilter').value
        const ps      = parseInt(document.getElementById('amrPageSize').value)
        let url = `/amr-location?page=${page}&pageSize=${ps}`
        if (search) url += `&keyword=${encodeURIComponent(search)}`
        if (type)   url += `&pointType=${encodeURIComponent(type)}`
        if (active !== '') url += `&active=${active}`
        try {
            const res   = await api(url)
            const items = Array.isArray(res) ? res : (res?.data || [])
            const total = res?.total ?? res?.totalCount ?? items.length
            const cp    = res?.page ?? page
            document.getElementById('amrCount').textContent = total + ' items'
            renderPagination('amrPagination', 'amrPageInfo', cp, Math.ceil(total / ps) || 1, 'loadAmrLocations')
            document.getElementById('amrTable').innerHTML = items.length === 0
                ? `<tr><td colspan="11" style="text-align:center;color:var(--t3);padding:32px">No AMR Locations found</td></tr>`
                : items.map(x => `<tr>
                    <td style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">${x.pointCode ?? '—'}</td>
                    <td style="font-weight:500;color:var(--navy)">${x.displayName ?? '—'}</td>
                    <td><span style="background:var(--blue-lt);color:var(--blue);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">${x.pointType ?? '—'}</span></td>
                    <td style="color:var(--t2);font-size:12px">${x.locationId ?? '—'}</td>
                    <td style="text-align:center;color:var(--t2)">${x.sortOrder ?? 0}</td>
                    <td style="color:var(--t2);font-size:12px">${x.vendor ?? '—'}</td>
                    <td style="font-family:ui-monospace,monospace;font-size:11px;color:var(--t2)">${x.externalCode ?? '—'}</td>
                    <td>${_amrBool(x.isDefault, 'Default', '—')}</td>
                    <td>${_amrBool(x.isAvailable, 'Yes', 'No')}</td>
                    <td>${_amrBool(x.isActive, 'Active', 'Inactive')}</td>
                    <td style="white-space:nowrap">
                        <button onclick="openAmrModal(${JSON.stringify(x).replace(/"/g,'&quot;')})"
                            style="background:none;border:none;cursor:pointer;color:var(--amber);font-size:16px;padding:4px 6px;border-radius:6px" title="Edit">
                            <i class="bi bi-pencil"></i></button>
                        <button onclick="deleteAmrLocation(${x.id})"
                            style="background:none;border:none;cursor:pointer;color:var(--red);font-size:16px;padding:4px 6px;border-radius:6px" title="Delete">
                            <i class="bi bi-trash"></i></button>
                    </td>
                </tr>`).join('')
        } catch (err) {
            document.getElementById('amrTable').innerHTML =
                `<tr><td colspan="11" style="text-align:center;color:var(--red);padding:32px">Load failed: ${err.message}</td></tr>`
        }
    }

    async function _loadAmrLocationSelect() {
        try {
            const res  = await api('/amr-location?pageSize=200')
            const items = Array.isArray(res) ? res : (res?.data || [])
            const typeFilter = document.getElementById('amrTypeFilter')
            const locSelect  = document.getElementById('amrLocationId')
            const types = [...new Set(items.map(x => x.pointType).filter(Boolean))]
            typeFilter.innerHTML = '<option value="">All Types</option>' +
                types.map(t => `<option value="${t}">${t}</option>`).join('')
            if (locSelect) {
                try {
                    const locs = await api('/location?pageSize=200')
                    const la   = Array.isArray(locs) ? locs : (locs?.data || [])
                    locSelect.innerHTML = '<option value="">— None —</option>' +
                        la.map(l => `<option value="${l.id}">${l.locationCode}</option>`).join('')
                } catch (_) {}
            }
        } catch (_) {}
    }

    function resetAmrForm() {
        document.getElementById('amrId').value              = ''
        document.getElementById('amrPointCode').value       = ''
        document.getElementById('amrDisplayName').value     = ''
        document.getElementById('amrPointType').value       = ''
        document.getElementById('amrLocationId').value      = ''
        document.getElementById('amrSortOrder').value       = ''
        document.getElementById('amrCapacity').value        = ''
        document.getElementById('amrVendor').value          = ''
        document.getElementById('amrExternalCode').value    = ''
        document.getElementById('amrLatitude').value        = ''
        document.getElementById('amrLongitude').value       = ''
        document.getElementById('amrAccuracy').value        = ''
        document.getElementById('amrDescription').value     = ''
        document.getElementById('amrIsDefault').checked     = false
