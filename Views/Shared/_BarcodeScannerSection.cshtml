<style>
.bc-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.bc-card-body { padding:16px; }
.bc-scanner-box {
    width:100%; height:50vh; max-height:520px; border:3px solid var(--blue);
    border-radius:16px; position:relative; overflow:hidden; background:#000; margin:0 auto;
}
.bc-scanner-box video  { position:absolute;inset:0;width:100%;height:100%;object-fit:cover; }
.bc-scanner-box canvas { position:absolute;inset:0;width:100%;height:100%;pointer-events:none; }
.bc-label {
    position:absolute; bottom:0; left:0; right:0;
    background:rgba(0,0,0,.65); color:#fff;
    font-size:12px; font-weight:600; padding:6px 10px;
    text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
</style>

<div id="bcSection" style="display:none" class="bc-card">
    <div class="bc-card-body">
        <div class="bc-scanner-box">
            <video id="bcVideo" autoplay playsinline muted></video>
            <canvas id="bcCanvas"></canvas>
            <div class="bc-label" id="bcLabel">— กำลังค้นหา barcode —</div>
        </div>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:14px">
            <button onclick="switchCamera()"
                    style="padding:9px 20px;border:1.5px solid var(--border);border-radius:9px;background:#fff;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s"
                    onmouseover="this.style.borderColor='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)'">
                <i class="bi bi-arrow-repeat me-1"></i>สลับกล้อง
            </button>
            <button onclick="stopScan()"
                    style="padding:9px 20px;border:none;border-radius:9px;background:#fee2e2;color:var(--red);font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                ⏹ ปิดกล้อง
            </button>
        </div>
        <div id="bcStatus" style="text-align:center;font-size:13px;color:var(--t2);margin-top:10px;min-height:18px">กำลังสแกน…</div>
    </div>
</div>
