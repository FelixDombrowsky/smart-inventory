<!-- ── ตัวเลขวันนี้ — id ws-* ใช้กับ loadTodayStats() ── -->
<!-- แถวบนสุด: ซ้าย = ตัวเลขวันนี้ 3 ตัว (แทนคำทักทาย Hello ที่เอาออกแล้ว) / ขวา = ค้นหา Part No. + Location Type (กรองทั้งหน้า) -->
<div class="dash-hello">
    <div class="today-chips">
        <div class="today-chip">
            <span class="today-chip-ico"><i class="bi bi-people"></i></span>
            <div>
                <div class="today-chip-row">
                    <span class="wb-stat-num" id="ws-users-today">—</span>
                    <span class="wb-stat-delta" id="ws-users-today-delta" title="เทียบกับช่วงเดียวกันของสัปดาห์ที่แล้ว"></span>
                </div>
                <div class="wb-stat-lbl" data-i18n="usersToday">Users Today</div>
            </div>
        </div>
        <div class="today-chip">
            <span class="today-chip-ico"><i class="bi bi-arrow-left-right"></i></span>
            <div>
                <div class="today-chip-row">
                    <span class="wb-stat-num" id="ws-txtoday">—</span>
                    <span class="wb-stat-delta" id="ws-txtoday-delta" title="เทียบกับช่วงเดียวกันของสัปดาห์ที่แล้ว"></span>
                </div>
                <div class="wb-stat-lbl" data-i18n="txToday">Transactions Today</div>
            </div>
        </div>
        <div class="today-chip">
            <span class="today-chip-ico"><i class="bi bi-box-arrow-in-down"></i></span>
            <div>
                <div class="today-chip-row">
                    <span class="wb-stat-num" id="ws-lots-available">—</span>
                    <span class="wb-stat-delta" id="ws-lots-available-delta" title="เทียบกับช่วงเดียวกันของสัปดาห์ที่แล้ว"></span>
                </div>
                <div class="wb-stat-lbl" data-i18n="receiveToday">Receive Today</div>
            </div>
        </div>
        <!-- Location Type — ย้ายจาก filter bar ของ Stock Summary ขึ้นมาไว้ข้างตัวเลขวันนี้ เพราะกรองทั้ง KPI, การ์ดประเภท และตาราง (loadStock) -->
    </div>
    <div class="today-chips dash-filters">
        <!-- ค้นหา Part No. — ย้ายมาจาก filter bar ของ Stock Summary (id/โครง .ac-wrap เดิม — dashAutocomplete ใช้ได้เหมือนเดิม) -->
        <div class="ac-wrap dash-search">
            <span class="today-chip-ico"><i class="bi bi-search"></i></span>
            <input id="filterPartNo" class="ac-input dash-search-input" placeholder="Part No." data-i18n-placeholder="searchPlaceholder"
                   autocomplete="off" aria-label="Part No.">
            <button class="ac-clear" data-for="filterPartNo" tabindex="-1" aria-label="Clear">×</button>
            <div class="ac-menu" id="filterPartNoMenu"></div>
        </div>
        <!-- Location picker — รวม Location Type + Location (เดิมแยก 2 ช่อง: dropdown บนหัว + ช่องค้นหาในตาราง) เป็นช่องเดียว
             กดแล้วเปิดแผง: ค้นหา / chip ประเภท / รายชื่อ location — เลือกแค่ประเภท หรือเลือก location เจาะจงก็ได้ (ดู locPick*) -->
        <div class="locpick" id="locPick">
            <button type="button" class="locpick-trigger" id="locPickTrigger" onclick="locPickToggle()"
                    aria-haspopup="dialog" aria-expanded="false" aria-controls="locPickPanel">
                <span class="today-chip-ico"><i class="bi bi-geo-alt"></i></span>
                <span class="locpick-label" id="locPickLabel">All Locations</span>
                <i class="bi bi-chevron-down locpick-chev"></i>
            </button>
            <button type="button" class="locpick-clear" id="locPickClear" onclick="locPickClear()" aria-label="Clear location filter" hidden>
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="locpick-panel" id="locPickPanel" role="dialog" aria-label="Location filter" hidden>
                <div class="locpick-search">
                    <i class="bi bi-search"></i>
                    <input id="locPickSearch" placeholder="Search location…" data-i18n-placeholder="locSearchPlaceholder"
                           autocomplete="off" oninput="locPickRenderList()" onkeydown="locPickKey(event)" aria-label="Search location">
                </div>
                <div class="locpick-types" id="locPickTypes" role="group" aria-label="Location type"></div>
                <div class="locpick-list" id="locPickList" role="listbox"></div>
            </div>
            <input type="hidden" id="locationFilter" value="">
        </div>
    </div>
</div>

<!-- ── KPI CARDS — ค่าจาก get-stock-summary (loadStock → setEl/updateKpiFoot) ── -->
<div class="kpi-grid">
    <div class="kpi feature">
        <div class="kpi-top">
            <span class="kpi-ico"><i class="bi bi-box-seam"></i></span>
            <!-- กดเพื่อเลื่อนการ์ด Available / Reserved / Consumed ออกมา-หุบกลับ (toggleKpiMore — จำสถานะใน localStorage) -->
            <button type="button" class="kpi-go kpi-toggle" id="kpiMoreBtn" onclick="toggleKpiMore()"
                    aria-expanded="false" aria-controls="kpiMore" title="Show breakdown">
                <i class="bi bi-arrow-up-right"></i>
            </button>
        </div>
        <div class="kpi-lbl" data-i18n="totalOnHand">Total On Hand</div>
        <div class="kpi-num" id="totalOnHand">—</div>
        <!-- จำนวน P/N + จำนวน Lot — totalItem / totalLot จาก get-stock-summary ชุดเดียวกับตัวเลขบนการ์ด (กรองตาม filter เดียวกัน) -->
        <div class="kpi-foot kpi-foot-wrap">
            <span class="kpi-stat"><span class="kpi-pill" id="kpiPartsCount">—</span><span data-i18n="partNumbers">part numbers</span></span>
            <span class="kpi-stat"><span class="kpi-pill" id="kpiLotsCount">—</span><span data-i18n="lots">lots</span></span>
        </div>
    </div>
    <!-- Lot ค้างใน location เกิน 1 วัน — /inventory/lots + minInLocationDurationMinutes: 1440 (เหมือน filter "In Location: > 1 day" ในหน้า Lots) ดู loadAgedLots() -->
    <div class="kpi kpi-aged">
        <div class="kpi-top">
            <span class="kpi-ico amber"><i class="bi bi-hourglass-split"></i></span>
            <!-- href ตั้งใน loadAgedLots() — เปิดหน้า Lots พร้อม filter ชุดเดียวกับที่ใช้นับตัวเลขนี้ -->
            <a class="kpi-go" id="kpiAgedLink" href="Inventory/Lots?inLocMin=1440&amp;lotStatus=Available" aria-label="Open Lots in location over 1 day"><i class="bi bi-arrow-up-right"></i></a>
        </div>
        <div class="kpi-lbl" data-i18n="agedLots">Lots in Location &gt; 1 Day</div>
        <div class="kpi-num" id="kpiAgedLots">—</div>
        <div class="kpi-foot"><span class="kpi-pill amber" data-i18n="agedPill">&gt; 1 day</span><span data-i18n="agedFoot">not moved</span></div>
    </div>
    <div class="kpi-more" id="kpiMore">
    <div class="kpi">
        <div class="kpi-top">
            <span class="kpi-ico green"><i class="bi bi-check2-circle"></i></span>
            <a class="kpi-go" href="Inventory/Lots" aria-label="Open Lots"><i class="bi bi-arrow-up-right"></i></a>
        </div>
        <div class="kpi-lbl" data-i18n="available">Available</div>
        <div class="kpi-num" id="totalAvailable">—</div>
        <div class="kpi-foot"><div class="kpi-bar"><i id="kpiAvailBar"></i></div><span class="kpi-pill" id="kpiAvailPct">—</span></div>
    </div>
    <div class="kpi">
        <div class="kpi-top">
            <span class="kpi-ico amber"><i class="bi bi-bookmark-check"></i></span>
            <a class="kpi-go" href="Inventory/WorkOrders" aria-label="Open Work Orders"><i class="bi bi-arrow-up-right"></i></a>
        </div>
        <div class="kpi-lbl" data-i18n="totalReserved">Total Reserved</div>
        <div class="kpi-num" id="totalReserved">—</div>
        <div class="kpi-foot"><span class="kpi-pill amber" id="kpiReservedPct">—</span><span data-i18n="ofOnHand">of on hand</span></div>
    </div>
    <div class="kpi">
        <div class="kpi-top">
            <span class="kpi-ico red"><i class="bi bi-fire"></i></span>
            <a class="kpi-go" href="Inventory/Transactions" aria-label="Open Transactions"><i class="bi bi-arrow-up-right"></i></a>
        </div>
        <div class="kpi-lbl" data-i18n="totalConsumed">Total Consumed</div>
        <div class="kpi-num" id="totalConsumed">—</div>
        <!-- API ไม่มียอด consumed รวม — ตัวเลขนี้รวมจากแถวในหน้าที่แสดงอยู่ (ดู loadStock) เลยบอกจำนวนแถวไว้ให้ชัด -->
        <div class="kpi-foot"><span class="kpi-pill red" id="kpiConsumedRows">—</span><span data-i18n="rowsOnPage">rows on this page</span></div>
    </div>
    </div>
</div>

<!-- ── TYPE FILTER BAR ── -->
