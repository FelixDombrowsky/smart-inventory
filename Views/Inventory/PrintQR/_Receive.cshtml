<!-- ══════ TAB: RECEIVE ══════ -->
<partial name="_PhotoCapture" model="@("rc")" />
<div class="tab-pane active" id="tab-receive">
<div class="rcp-grid">
<div class="rcp-left">

        <!-- 1. W/O Input Layout card -->
        <div class="rp-card" style="overflow:visible">
            @* <div class="rp-card-head">
                Fill Information
            </div> *@
            <div id="rcWoCardBody" class="rp-card-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start">
                    <!-- Work Order -->
                    <div>
                        <label class="form-label" style="margin-bottom:5px">Work Order <span class="req">*</span></label>
                        <div class="wo-autocomplete">
                            <div style="position:relative">
                                <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--t3);pointer-events:none;z-index:1"></i>
                                <input class="form-input" id="rcWoInput" placeholder="ค้นหา WorkOrder" autocomplete="off"
                                    style="padding-left:32px;padding-right:90px">
                                <input id="rcLineDisplay" type="text" placeholder="Line" autocomplete="off" oninput="rcLineDisplayInput(this)"
                                    style="display:none;position:absolute;right:10px;top:50%;transform:translateY(-50%);width:70px;padding:2px 10px;background:var(--blue-lt);border:1.5px solid var(--blue);border-radius:20px;font-size:12px;font-weight:700;color:var(--blue);white-space:nowrap;text-align:center;outline:none">
                            </div>
                            <div class="wo-dropdown" id="rcWoDropdown" style="display:none"></div>
                        </div>
                    </div>
                    <!-- Layout Template -->
                    <div>
                        <div style="font-size:12px;font-weight:600;color:var(--t2);margin-bottom:5px">Layout Template <span class="req">*</span></div>
                        <div style="display:flex;gap:6px;align-items:center">
                            <div style="position:relative;flex:1;min-width:0">
                                <select class="form-select" id="rcLayout" onchange="rcLayoutChange()"
                                    style="width:100%;appearance:none;-webkit-appearance:none;-moz-appearance:none;padding-right:32px;color:var(--t3)">
                                    <option value="">-- Select Layout --</option>
                                </select>
                                <i class="bi bi-chevron-down" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--t3);pointer-events:none"></i>
                            </div>
                            <button class="btn-outline" style="padding:7px 10px;flex-shrink:0;display:flex;align-items:center;justify-content:center" onclick="goToDesignLayout(document.getElementById('rcLayout').value)" title="Design Layout"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Route Flow card: Receive Location (FROM) → Production Area (TO) -->
        <div class="rp-card" style="overflow:visible">
            @* <div class="rp-card-head">
                <span>Location</span>
            </div> *@
            <div class="rp-card-body">
                <div class="rcp-route-flow">
                    <!-- FROM: Receive Location -->
                    <div class="rcp-route-point">
                        <span class="rcp-route-tag">FROM</span>
                        <div class="rcp-route-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9.5 12 4l9 5.5"/>
                                <path d="M5 9v9.5a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1V9"/>
                                <rect x="9.5" y="9.5" width="5" height="4" rx=".6"/>
                            </svg>
                        </div>
                        <div class="rcp-route-body">
                            <div style="font-size:11px;font-weight:600;color:var(--t2);margin-bottom:5px">Receive Location <span class="req">*</span></div>
                            <div style="position:relative">
                                <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--t3);pointer-events:none;z-index:1"></i>
                                <input id="rcLocSearch" class="form-input" placeholder="ค้นหา Location..." autocomplete="off"
                                    style="padding-left:32px">
                                <div class="wo-dropdown" id="rcLocDropdown" style="display:none;min-width:100%"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Arrow: animated flow direction -->
                    <div class="rcp-route-arrow" aria-hidden="true">
                        <svg viewBox="0 0 60 38">
                            <line class="rcp-flow-line" x1="3" y1="19" x2="46" y2="19"/>
                            <path class="rcp-flow-head" d="M40 12 L50 19 L40 26"/>
                            <g class="rcp-flow-box"><rect x="-5" y="14" width="10" height="10" rx="2"/></g>
                        </svg>
                    </div>

                    <!-- TO: Production Area -->
                    <div class="rcp-route-point rcp-route-to">
                        <span class="rcp-route-tag">TO</span>
                        <div class="rcp-route-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 21V11l5-3v3l5-3v3l5-3v13"/>
                                <path d="M3 21h18"/>
                                <path d="M8 21v-4h3v4"/>
                                <circle cx="18" cy="8" r="1.2"/>
                            </svg>
                        </div>
                        <div class="rcp-route-body">
                            <div style="font-size:11px;font-weight:600;color:var(--blue);margin-bottom:5px">Production Area</div>
                            <div style="position:relative">
                                <i class="bi bi-geo-alt" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--t3);pointer-events:none;z-index:1"></i>
                                <input id="rcProductionAreaInput" class="form-input" placeholder="-- เลือก Production Area --" readonly
                                    onclick="rcOpenProdAreaDropdown()"
                                    style="padding-left:32px;padding-right:32px;cursor:pointer">
                                <i class="bi bi-chevron-down" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--t3);pointer-events:none"></i>
                                <div class="wo-dropdown" id="rcProdAreaDropdown" style="display:none;min-width:100%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3+4. Item list card (with inline manual input) -->
        <div class="rp-card" style="overflow:visible">
            <div class="rp-card-head">
                <span>Item List</span>
                <span class="rp-counter-badge" id="rcCounter">0/10</span>
                <div style="margin-left:auto"></div>
                <button id="rcManualBtn" class="btn-secondary" onclick="rcOpenManualModal()"
                    style="font-size:12px;height:38px;padding:0 12px;display:flex;align-items:center;gap:6px;box-sizing:border-box"><i class="bi bi-pencil" style="font-size:16px"></i>Manual</button>
                <button class="btn-primary" id="rcBtnCam" onclick="rcToggleCam()"
                    style="font-size:12px;width:38px;height:38px;padding:0;border-radius:8px;display:flex;align-items:center;justify-content:center;box-sizing:border-box">
                    <i class="bi bi-camera" style="font-size:16px"></i>
                </button>
                <button id="rcHwScanBtn" onclick="rpToggleHwScan()"
                    style="font-size:12px;width:38px;height:38px;padding:0;border-radius:8px;background:#6b7280;color:#fff;border:none;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;box-sizing:border-box">
                    <i class="bi bi-upc-scan" style="font-size:16px"></i>
                </button>
            </div>
            <!-- HW Scanner Section — lives here by default; rpToggleHwScan moves it to the active tab's item card -->
            <partial name="_HwScannerSection" />
            <div id="rcScanAnchor"></div>
            <div style="display:flex;align-items:center;gap:16px;padding:7px 14px;background:#f8f9fc;border-bottom:1px solid var(--border);font-size:11px;font-weight:700;color:var(--t2);letter-spacing:.04em;text-transform:uppercase">
                <div style="flex:1.4;min-width:0">Part No</div>
                <div style="flex:1.6;min-width:0">Description</div>
                <div style="width:42px;flex-shrink:0;text-align:right">Qty</div>
                <div style="width:48px;flex-shrink:0;text-align:right">Unit</div>
                <div style="width:160px"></div>
            </div>
            <div id="rcItemList">
                <div class="rp-empty-state">No items yet — scan or type to add</div>
            </div>
        </div>

        <!-- 4b. Advanced Options (admin only) -->
        <partial name="_AdvancedOptions" />

</div><!-- end .rcp-left -->

<!-- RIGHT: Label Preview panel -->
<div class="rcp-right">
    <div class="rp-card" style="overflow:visible">
        <div class="rp-card-head">
            <span><i class="bi bi-grid-3x3-gap-fill me-1"></i>Label Preview</span>
            <div class="rcp-pag" id="rcPreviewPag">
                <button type="button" class="rcp-pag-btn" onclick="rcPreviewNav(-1)"><i class="bi bi-chevron-left"></i></button>
                <span id="rcPreviewPagText">0 / 0</span>
                <button type="button" class="rcp-pag-btn" onclick="rcPreviewNav(1)"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
        <div class="rp-card-body">
            <div class="rcp-preview-box" id="rcPreviewImgBox">
                <div class="rp-empty-state">No items yet</div>
            </div>
            <div class="rcp-preview-meta" id="rcPreviewMeta"></div>

            <div class="rcp-divider"></div>

            <div class="rcp-row">
                <span class="rcp-row-label"><i class="bi bi-printer me-1"></i>Printer</span>
            </div>
            <div class="rp-pd-wrap" style="margin-bottom:16px">
                <div class="rp-pd-trigger" id="rcPrinterTrigger" tabindex="0"
                     onclick="rpPrinterDdToggle('rc')">
                    <div class="rp-pd-val">
                        <span class="rp-pd-dot" id="rcPrinterDot" style="display:none"></span>
                        <div>
                            <div class="rp-pd-sel-name" id="rcPrinterName" style="color:var(--t2);font-weight:400">-- Select Printer --</div>
                            <div class="rp-pd-sel-ip" id="rcPrinterIp" style="display:none"></div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-down rp-pd-chevron"></i>
                </div>
                <div class="rp-pd-menu" id="rcPrinterMenu" style="display:none">
                    <div class="rp-pd-msg">⏳ Loading…</div>
                </div>
                <input type="hidden" id="rcPrinterSelect">
            </div>

            <div class="rcp-row">
                <span class="rcp-row-label"><i class="bi bi-chat-left-text me-1"></i>Print Reason</span>
            </div>
            <input id="rcPrintReason" class="form-input" placeholder="Print Reason (Optional)" style="margin-bottom:16px">

            @* <div class="rcp-row" style="justify-content:space-between">
                <span class="rcp-row-label"><i class="bi bi-copy me-1"></i>Copies / item</span>
                <div class="qty-wrap">
                    <button type="button" class="rcp-step-btn" onclick="rcCopiesStep(-1)">−</button>
                    <input id="rcCopies" class="qty-input" value="1" readonly>
                    <button type="button" class="rcp-step-btn" onclick="rcCopiesStep(1)">+</button>
                </div>
            </div> *@

            <div class="rcp-total-row">
                <span>Total Label</span>
                <span class="rcp-total-num" id="rcTotalLabels">0 labels</span>
            </div>

            <div id="rcPreviewWarning" class="rcp-warning" style="display:none"></div>

            <button id="rcPrintBtn" class="btn-primary rcp-print-btn" onclick="rcValidate()"
                style="opacity:0.45;cursor:not-allowed" disabled>
                <i class="bi bi-printer"></i> <span id="rcPrintBtnLabel">Print Labels</span>
            </button>
        </div>
    </div>
</div><!-- end .rcp-right -->

</div><!-- end .rcp-grid -->
</div><!-- end #tab-receive -->

<script>
    let rcItems        = []
    let rcScannedTrace = new Set()
    let _rcPrinting        = false
    let _rcShowUnreviewed  = false
    let _rcPreviewIdx      = 0     // index ของ item ที่กำลังโชว์ใน Label Preview panel
    let _rcCopies          = 1     // Copies/item — แค่ UI แสดงผล ไม่มีผลต่อจำนวนที่พิมพ์จริง
    let rcPhoto = null  // สร้างจริงตอน DOMContentLoaded ด้านล่าง (createPhotoCapture มาจาก PhotoCapture.js ที่โหลดทีหลังใน @@section Scripts)

    let canManualEntry = false
    ;(function() {
        const adminRoles = ['Admin']
        try {
            const user       = JSON.parse(localStorage.getItem('user') || '{}')
            const userRoles  = Array.isArray(user.roles) ? user.roles : []
            const userPermis = Array.isArray(user.permissions) ? user.permissions : []
            const isAdmin    = userRoles.some(r => adminRoles.includes(r))
            applyAdvancedOptionsPermissions(userPermis, isAdmin)

            // ใช้ permission เดียวกับหน้า Receive.cshtml — คุมทั้งปุ่ม Manual และสิทธิ์แก้ไข item ใน list
            canManualEntry = isAdmin || userPermis.includes('WMS.UI.Manual.Receive')
            document.getElementById('rcManualBtn').style.display = canManualEntry ? '' : 'none'
        } catch (_) {}
    })()

    function rcShowError(id, show) {
        const el = document.getElementById(id)
        if (!el) return
        el.style.transition  = 'border-color .15s, box-shadow .15s'
        el.style.borderColor = show ? 'var(--red)' : ''
        el.style.boxShadow   = show ? '0 0 0 3px rgba(220,38,38,.15)' : ''
    }
    let rcCurrentWo      = null
    let rcCurrentLine    = null
    let rcProductionArea     = null
    let rcProductionAreaName = null
    let rcLayoutConfig = null

    function rcCheckScanReady() {
        // Scan and manual entry are always available; WO/Location are only required at print time
    }

    document.addEventListener('DOMContentLoaded', () => {
        rcPhoto = createPhotoCapture({ prefix: "rc", maxDimension: 1920 })
        document.getElementById('rcPcSendBtn')?.addEventListener('click', () => rcPrint('receive'))
        document.getElementById('rcPcCancelBtn')?.addEventListener('click', () => rcPhoto.close())

        createWorkOrderAutocomplete({
            inputId: 'rcWoInput', dropdownId: 'rcWoDropdown',
            loadingText: '⏳ Searching…', emptyText: 'No Work Order found',
            renderItem: (x, i) => `<div class="wo-item" data-idx="${i}">
                <i class="bi bi-box-seam" style="color:var(--blue);flex-shrink:0"></i>
                <span>
                    <strong>${escHtml(x.moNumber)}</strong>
                    ${x.modelName ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${escHtml(x.modelName)}</span>` : ''}
                </span>
                ${x.lineName ? `<span class="wo-item-line" style="margin-left:auto">${escHtml(x.lineName)}</span>` : ''}
            </div>`,
            onSelect: x => {
                rcCurrentWo   = x?.moNumber ?? null
                rcCurrentLine = x?.lineName || null
                const ld = document.getElementById('rcLineDisplay')
                ld.value         = rcCurrentLine || ''
                // แสดงกล่อง Line ไว้เสมอเมื่อเลือก WO แล้ว (ว่างไว้ให้พิมพ์เองได้ ถ้า WO นั้นไม่มี line ส่งมา)
                ld.style.display = x ? '' : 'none'
                if (x) rcShowError('rcWoInput', false)
                rcCheckScanReady()
                // อัปเดต item ที่ add ไปแล้ว
                rcItems.forEach(item => {
                    item.data.workOrder = rcCurrentWo   ?? ''
                    item.data.line      = rcCurrentLine ?? ''
                })
                if (rcItems.length) { rcRebuildAllZpl(); rcRenderList() }
            }
        })
    })

    // ผู้ใช้พิมพ์แก้ Line เอง (เช่น WO ที่ไม่มี line ส่งมาจาก autocomplete) — sync กลับไปยัง item ที่ add ไปแล้วเหมือนตอนเลือก WO
    function rcLineDisplayInput(el) {
        rcCurrentLine = el.value.trim() || null
        rcItems.forEach(item => { item.data.line = rcCurrentLine ?? '' })
        if (rcItems.length) { rcRebuildAllZpl(); rcRenderList() }
    }

    function rcLayoutChange() {
        const sel = document.getElementById('rcLayout')
        const id  = sel.value
        sel.style.color = id ? 'var(--text)' : 'var(--t3)'   // เทาตอนยังไม่เลือก เหมือน Production Area
        rcShowError('rcLayout', false)
        if (!id) { rcLayoutConfig = null; rcCheckScanReady(); rcRenderPreviewPanel(); return }
        const arr  = sel._layoutsData || []
        const tmpl = arr.find(l => String(l.id) === String(id))
        if (!tmpl) { rcLayoutConfig = null; rcCheckScanReady(); rcRenderPreviewPanel(); return }
        rcLayoutConfig = parseZplDataJson(tmpl)
        rcRebuildAllZpl()
        rcCheckScanReady()
        rcRenderPreviewPanel()
    }

    let _rcViewIdx  = null
    let _rcViewTab  = 'preview'

    function rcViewItemData(idx) {
        const item = rcItems[idx]
        if (!item) return
        item.reviewed = true
        _rcViewIdx = idx
        rcRenderList()
        rcRenderViewModal(idx)
        document.getElementById('rpManualModal').style.display = 'flex'
    }

    function rcViewNav(delta) {
        const n = rcItems.length
        if (!n) return
        const idx = Math.min(n - 1, Math.max(0, _rcViewIdx + delta))
        if (idx === _rcViewIdx) return
        rcViewItemData(idx)
    }

    function rcRenderViewModal(idx) {
        const item = rcItems[idx]
        if (!item) return
        const d   = item.data
        const cfg = rcLayoutConfig ?? {}
        const qrFields  = Array.isArray(cfg.qrFields)    ? cfg.qrFields    : []
        const lblFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : []

        const colHdr = document.getElementById('rpManualColHeaders')
        if (colHdr) colHdr.style.display = 'none'

        const colHeadersHtml = `<div style="position:sticky;top:0;z-index:5;background:#f8f9fc;border-bottom:2px solid var(--border);display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px 16px;align-items:center;padding:10px 16px;flex-shrink:0">
            <div style="font-size:12px;font-weight:800;color:var(--blue);text-align:center;letter-spacing:.5px">QR</div>
            <div style="font-size:12px;font-weight:800;color:var(--purple,#7c3aed);text-align:center;letter-spacing:.5px">Label</div>
            <div style="font-size:12px;font-weight:800;color:var(--navy);letter-spacing:.5px">Field</div>
            <div style="font-size:12px;font-weight:800;color:var(--navy);letter-spacing:.5px">Value</div>
        </div>`

        const fieldRows = ALL_FIELD_KEYS.map(k => {
            const inQr   = qrFields.find(f  => f.key === k)?.inQr  ?? false
            const inLbl  = lblFields.find(f => f.key === k)?.show  ?? false
            const isAuto = AUTO_GEN_KEYS.has(k)
            const prefill = k === 'productionArea'
                ? (d._productionAreaName || d[k] || rcProductionAreaName || rcProductionArea || '')
                : k === 'createdAt'
                ? fmtCreatedAt(d[k])
                : (d[k] ?? (k === 'workOrder' ? (rcCurrentWo ?? '') : k === 'line' ? (rcCurrentLine ?? '') : ''))
            const isReq  = REQUIRED_KEYS.has(k)
            const isReadonly = k === 'workOrder' || k === 'productionArea' || k === 'line'

            const inputEl = isAuto
                ? `<div style="padding:7px 10px;background:#f0f2f5;border:1.5px solid var(--border);border-radius:8px;font-size:12px;color:var(--t2);font-style:italic">${escHtml(prefill || 'Auto-Gen after receive')}</div>`
                : k === 'partNo'
                ? `<div style="position:relative">
                       <input id="rpm_partNo" class="form-input" value="${escHtml(prefill)}"
                           style="font-size:13px;padding:7px 10px;width:100%"
                           oninput="this.style.borderColor='';rcPnAutocomplete(this.value)"
                           onkeydown="rcPnKeydown(event)"
                           onblur="setTimeout(rcHidePnDropdown, 180)"
                           placeholder="${escHtml(FIELD_PLACEHOLDERS['partNo'] ?? FIELD_LABELS['partNo'])}">
                       <div id="rcPnDropdown" class="wo-dropdown" style="display:none"></div>
                   </div>`
                : k === 'quantity'
                ? `<input id="rpm_quantity" class="form-input" inputmode="decimal"
                       value="${escHtml(prefill || '1')}"
                       style="font-size:13px;padding:7px 10px"
                       oninput="this.style.borderColor=''"
                       placeholder="${escHtml(FIELD_PLACEHOLDERS['quantity'] ?? FIELD_LABELS['quantity'])}">`
                : k === 'itemType'
                ? `<select id="rpm_itemType" class="form-select" style="font-size:13px;padding:7px 10px">
                       <option value="">— Loading… —</option>
                   </select>`
                : `<input id="rpm_${cid(k)}" class="form-input" value="${escHtml(prefill)}"
                       ${isReadonly ? 'readonly' : ''}
                       style="font-size:13px;padding:7px 10px${isReadonly ? ';background:#f8f9fc' : ''}"
                       oninput="this.style.borderColor=''"
                       placeholder="${escHtml(FIELD_PLACEHOLDERS[k] ?? FIELD_LABELS[k])}">`

            return `<div style="display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px 16px;align-items:center;padding:6px 16px;border-bottom:1px solid var(--border)">
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inQr ? 'var(--blue)' : 'var(--border)'};background:${inQr ? 'var(--blue)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inQr ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inLbl ? 'var(--purple,#7c3aed)' : 'var(--border)'};background:${inLbl ? 'var(--purple,#7c3aed)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inLbl ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="font-size:13px;font-weight:600;color:var(--navy)">
                    ${escHtml(FIELD_LABELS[k])}${isReq ? ' <span style="color:var(--red)">*</span>' : ''}
                </div>
                ${inputEl}
            </div>`
        })
        const fieldRowsHtml = fieldRows.join('')

        document.getElementById('rpManualFields').innerHTML = `
            <div style="position:sticky;top:0;z-index:10;background:#fff;border-bottom:2px solid var(--border);display:flex;flex-shrink:0">
                <button id="rcViewTabPreview" onclick="rcSwitchViewTab('preview')"
                    style="padding:10px 18px;font-size:13px;font-weight:700;color:var(--blue);border:none;background:none;cursor:pointer;border-bottom:2px solid var(--blue);margin-bottom:-2px;font-family:inherit;display:flex;align-items:center;gap:6px">
                    <i class="bi bi-printer"></i> Preview Label
                </button>
                <button id="rcViewTabData" onclick="rcSwitchViewTab('data')"
                    style="padding:10px 18px;font-size:13px;font-weight:700;color:var(--t2);border:none;background:none;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;font-family:inherit;display:flex;align-items:center;gap:6px">
                    <i class="bi bi-table"></i> Data
                </button>
            </div>
            <div id="rcViewPaneData" style="display:none">${colHeadersHtml}${fieldRowsHtml}</div>
            <div id="rcViewPanePreview" style="padding:24px;text-align:center;align-items:center;justify-content:center">
                <div id="rcViewPreviewContent"></div>
            </div>`
        _rcLoadItemTypes(document.getElementById('rpm_itemType'), String(d.itemType || '1'))
        _rcSetModalEditable(canManualEntry)

        document.getElementById('rpManualModalTitle').textContent = canManualEntry
            ? '📋 Item Data #' + (idx + 1)
            : '👁 Item Data #' + (idx + 1) + ' (View Only)'
        const navEl = document.getElementById('rpManualModalNav')
        if (navEl) {
            navEl.style.display = 'flex'
            navEl.innerHTML = `
                <button type="button" class="rcp-pag-btn" onclick="rcViewNav(-1)" ${idx <= 0 ? 'disabled' : ''}><i class="bi bi-chevron-left"></i></button>
                <span style="font-size:12px;font-weight:700;color:var(--t2)">${idx + 1} / ${rcItems.length}</span>
                <button type="button" class="rcp-pag-btn" onclick="rcViewNav(1)" ${idx >= rcItems.length - 1 ? 'disabled' : ''}><i class="bi bi-chevron-right"></i></button>`
        }
        document.getElementById('rpManualModalFooter').innerHTML = canManualEntry
            ? `<button onclick="document.getElementById('rpManualModal').style.display='none'"
                style="flex:1;padding:12px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">
                Close
            </button>
            <button onclick="rcSaveAndClose()"
                style="flex:1;padding:12px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                Save
            </button>`
            : `<button onclick="document.getElementById('rpManualModal').style.display='none'"
                style="flex:1;padding:12px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">
                Close
            </button>`
        rcSwitchViewTab(_rcViewTab)
    }

    function rcSwitchViewTab(tab) {
        const dataPane    = document.getElementById('rcViewPaneData')
        const previewPane = document.getElementById('rcViewPanePreview')
        const dataBtn     = document.getElementById('rcViewTabData')
        const previewBtn  = document.getElementById('rcViewTabPreview')
        if (!dataPane) return
        _rcViewTab = tab
        if (tab === 'data') {
            dataPane.style.display    = ''
            previewPane.style.display = 'none'
            dataBtn.style.color       = 'var(--blue)';  dataBtn.style.borderBottom    = '2px solid var(--blue)'
            previewBtn.style.color    = 'var(--t2)';    previewBtn.style.borderBottom = '2px solid transparent'
        } else {
            dataPane.style.display    = 'none'
            previewPane.style.display = 'flex'
            dataBtn.style.color       = 'var(--t2)';    dataBtn.style.borderBottom    = '2px solid transparent'
            previewBtn.style.color    = 'var(--blue)';  previewBtn.style.borderBottom = '2px solid var(--blue)'
            const item    = rcItems[_rcViewIdx]
            const content = document.getElementById('rcViewPreviewContent')
            if (!item || !content) return
            if (!document.getElementById('rcLayout')?.value) {
                content.innerHTML = '<div class="rp-empty-state"><i class="bi bi-exclamation-triangle" style="color:var(--amber)"></i> Please Select Layout</div>'
                return
            }
            content.innerHTML = '<div style="color:var(--t3);font-size:13px">⏳ Loading…</div>';
            (async () => {
                try {
                    let src = item.previewSrc
                    if (!src) {
                        const cfg = rcLayoutConfig ?? {}
                        src = await renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
                        if (item) item.previewSrc = src
                    }
                    content.innerHTML = src
                        ? `<img src="${escHtml(src)}" style="max-width:100%;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.12)">`
                        : '<div style="color:var(--amber);font-size:13px">Preview not available</div>'
                } catch (err) {
                    content.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
                }
            })()
        }
    }

    function rcSaveAndClose() {
        if (!canManualEntry) { document.getElementById('rpManualModal').style.display = 'none'; return }
        const item = rcItems[_rcViewIdx]
        if (!item) { document.getElementById('rpManualModal').style.display = 'none'; return }

        // เช็ค required fields ก่อน save เหมือน submitManualEntry ของหน้า Receive — กันเคลียร์ P/N หรือ Qty เป็นค่าว่างแบบเงียบๆ
        for (const k of REQUIRED_KEYS) {
            const el = document.getElementById(`rpm_${cid(k)}`)
            if (!el || !el.value.trim()) {
                showToast(`Please fill in ${FIELD_LABELS[k]}`, 'error')
                if (el) { el.style.borderColor = 'var(--red)'; el.focus() }
                return
            }
        }
        const qtyCheckEl = document.getElementById('rpm_quantity')
        if (!(parseFloat(qtyCheckEl?.value) > 0)) {
            showToast('Quantity must be greater than 0', 'error')
            if (qtyCheckEl) { qtyCheckEl.style.borderColor = 'var(--red)'; qtyCheckEl.focus() }
            return
        }

        ALL_FIELD_KEYS.forEach(k => {
            if (AUTO_GEN_KEYS.has(k)) return
            const el = document.getElementById(`rpm_${cid(k)}`)
            if (el) item.data[k] = el.value.trim()
        })
        const itemTypeEl = document.getElementById('rpm_itemType')
        if (itemTypeEl) item.data.itemType = parseInt(itemTypeEl.value) || 1

        const newLine = item.data.line ?? ''
        rcCurrentLine = newLine
        const ld = document.getElementById('rcLineDisplay')
        if (ld) { ld.value = newLine; ld.style.display = rcCurrentWo ? '' : 'none' }

        const cfg        = rcLayoutConfig ?? {}
        const sliders    = { qrX: cfg.qrX ?? 30, qrY: cfg.qrY ?? 40, qrSize: cfg.qrSize ?? 5, dataX: cfg.dataX ?? 373, dataY: cfg.dataY ?? 58, fontSize: cfg.fontSize ?? 22, lineHeight: cfg.lineHeight ?? 33, valOffset: cfg.valOffset ?? 151 }
        const textFields  = buildLabelTextFields(cfg.labelFields, item.data)
        item.zpl        = buildZpl({ qrContent: buildQrContent(item.data, cfg.qrFields ?? null), textFields, ...sliders })
        item.previewSrc = null
        rcRenderList()

        document.getElementById('rpManualModal').style.display = 'none'
        showToast('✅ Saved', 'success')
    }

    let rcReceiveLocationCode = null
    let rcReceiveLat = 0, rcReceiveLng = 0, rcReceiveAltitude = 0

    document.addEventListener('DOMContentLoaded', () => {
        // Production Area: ไม่ใช้ autocomplete (พิมพ์ค้นหา) แล้ว — กดแล้วโชว์ทุก Location ที่ type = Factory ทันที
        document.getElementById('rcProductionAreaInput')
            .addEventListener('blur', () => setTimeout(() => {
                const dd = document.getElementById('rcProdAreaDropdown')
                if (dd) dd.style.display = 'none'
            }, 200))
        rcAutoSelectDefaultArea()
    })

    // ส่วนใหญ่ Production Area เป็น Fan_1 — auto-select ให้เป็น default ตอนโหลดหน้า (ยังกดเปลี่ยนเองได้ตามปกติ)
    async function rcAutoSelectDefaultArea() {
        if (rcProductionArea) return   // มีค่าอยู่แล้ว (เช่นผู้ใช้กดเลือกไปก่อนหน้านี้แล้ว) ไม่ต้อง override
        if (!_locNameMap.size) await loadLocation()
        const list = Array.from(_locNameMap.values()).filter(loc => (loc.typeName || '').toLowerCase() === 'factory')
        const fan1 = list.find(loc => (loc.displayName || loc.locationCode || '').toLowerCase() === 'fan_1')
                  || list.find(loc => (loc.displayName || loc.locationCode || '').toLowerCase().includes('fan_1'))
        if (!fan1 || rcProductionArea) return
        document.getElementById('rcProductionAreaInput').value = fan1.displayName || fan1.locationCode
        rcProductionArea     = fan1.locationCode
        rcProductionAreaName = fan1.displayName || fan1.locationCode
    }

    let _rcProdAreaList = null   // cache รายการ Production Area (location type = factory) — derive จาก _locNameMap ของ loadLocation.js

    async function rcOpenProdAreaDropdown() {
        const dd = document.getElementById('rcProdAreaDropdown')
        if (!dd) return
        if (dd.style.display === 'block') { dd.style.display = 'none'; return }
        if (!_locNameMap.size) {
            dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default">
                <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>⏳ Loading…
            </div>`
            dd.style.display = 'block'
            await loadLocation()
        }
        _rcProdAreaList = Array.from(_locNameMap.values()).filter(loc => (loc.typeName || '').toLowerCase() === 'factory')
        rcRenderProdAreaDropdown()
        dd.style.display = 'block'
    }

    function rcRenderProdAreaDropdown() {
        const dd = document.getElementById('rcProdAreaDropdown')
        if (!dd) return
        if (!_rcProdAreaList || !_rcProdAreaList.length) {
            dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>ไม่พบ Production Area</div>`
            return
        }
        dd.innerHTML = _rcProdAreaList.map((loc, i) => `
            <div class="wo-item" style="gap:10px" onmousedown="rcPickProdArea(${i})">
                <div style="display:flex;align-items:center;gap:10px;min-width:0">
                    <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0"></i>
                    <span style="font-weight:700">${escHtml(loc.displayName || loc.locationCode)}</span>
                    ${loc.description ? `<span style="font-size:12px;color:var(--t2)">${escHtml(loc.description)}</span>` : ''}
                </div>
            </div>`).join('')
    }

    function rcPickProdArea(i) {
        const loc = _rcProdAreaList?.[i]
        if (!loc) return
        document.getElementById('rcProductionAreaInput').value = loc.displayName || loc.locationCode
        document.getElementById('rcProdAreaDropdown').style.display = 'none'
        rcProductionArea     = loc.locationCode
        rcProductionAreaName = loc.displayName || loc.locationCode
        // อัปเดต item ที่ add ไปแล้ว
        rcItems.forEach(item => {
            item.data.productionArea      = rcProductionArea     ?? ''
            item.data._productionAreaName = rcProductionAreaName ?? ''
        })
        if (rcItems.length) { rcRebuildAllZpl(); rcRenderList() }
    }

    function rcRebuildItemZpl(item) {
        const cfg = rcLayoutConfig ?? {}
        const sliders = {
            qrX:       cfg.qrX       ?? 30,
            qrY:       cfg.qrY       ?? 40,
            qrSize:    cfg.qrSize    ?? 5,
            dataX:     cfg.dataX     ?? 373,
            dataY:     cfg.dataY     ?? 58,
            fontSize:  cfg.fontSize  ?? 22,
            lineHeight: cfg.lineHeight ?? 33,
            valOffset:  cfg.valOffset  ?? 151,
        }
        const d = item.data
        const textFields = buildLabelTextFields(cfg.labelFields, d)
        item.zpl        = buildZpl({ qrContent: buildQrContent(d, cfg.qrFields ?? null), textFields, ...sliders })
        item.previewSrc = null
    }

    function rcRebuildAllZpl() {
        if (!rcLayoutConfig || rcItems.length === 0) return
        rcItems.forEach(item => rcRebuildItemZpl(item))
    }

    const AUTO_GEN_KEYS  = new Set(['lotNo', 'uniqueId', 'createdAt'])

    // คีย์เดียวกันที่ต้องใช้ทั้งตอน add และ delete ออกจาก rcScannedTrace (กันสแกน/เพิ่มซ้ำ)
    // _scanKey มีแค่ item ที่มาจาก scan pipeline (PrintQR.cshtml) — manual entry ไม่มี เลย fallback ไป traceId/rawBarCode/partNo
    function _rcDupKey(data) {
        return data?._scanKey || data?.traceId || data?.rawBarCode || data?.partNo || null
    }

    // ล็อกทุกช่องใน View/Edit modal ให้เป็น view-only ถ้าไม่มีสิทธิ์ WMS.UI.Manual.Receive (เหมือน setModalViewOnly ของ Receive.cshtml)
    // rpm_workOrder/rpm_productionArea/rpm_line ต้อง readonly เสมอไม่ว่าจะมีสิทธิ์แก้ไขหรือไม่ — แก้ที่ช่อง Work Order/Production Area ด้านบนแทน
    const _RC_ALWAYS_READONLY_IDS = new Set(['rpm_workOrder', 'rpm_productionArea', 'rpm_line'])

    function _rcSetModalEditable(editable) {
        const container = document.getElementById('rpManualFields')
        if (!container) return
        container.querySelectorAll('input').forEach(el => {
            const ro = _RC_ALWAYS_READONLY_IDS.has(el.id) ? true : !editable
            el.readOnly = ro
            el.style.background = ro ? '#f8f9fc' : ''
            el.style.cursor     = ro ? 'default' : ''
        })
        container.querySelectorAll('select').forEach(el => { el.disabled = !editable })
    }

    // Item Type ตอนนี้เป็น key ปกติใน ALL_FIELD_KEYS แล้ว (FIELD_LABELS ใน PrintQR.cshtml) แต่ยัง render เป็น
    // <select> พิเศษแทน <input> ธรรมดา (special-case ใน rcOpenManualModal / rcRenderViewModal) เพราะต้องโหลด
    // รายการ Item Type จาก /master/items/item-type มาให้เลือก
    let _rcItemTypeCache = null

    async function _rcLoadItemTypes(sel, selectedValue) {
        if (!sel) return
        if (!_rcItemTypeCache) {
            try {
                _rcItemTypeCache = await api('/master/items/item-type', 'GET')
            } catch (_) {
                sel.innerHTML = '<option value="">— โหลดไม่สำเร็จ —</option>'
                return
            }
        }
        sel.innerHTML = _rcItemTypeCache.map(x => `<option value="${x.id}">${escHtml(x.name)}</option>`).join('')
        sel.value = selectedValue || '1'
    }

    async function _fetchUniqueId() {
        const res = await api('/printer/get-unique-id', 'GET')
        return res?.uniqueId ?? ''
    }

    let _rcPnTimer = null, _rcPnResults = []

    function _rcApplyItemMasterToForm(x) {
        const descEl = document.getElementById('rpm_description')
        if (descEl && x.itemName) descEl.value = x.itemName
        const unitEl = document.getElementById('rpm_unit')
        if (unitEl && x.baseUnit) unitEl.value = x.baseUnit
        const itemTypeEl = document.getElementById('rpm_itemType')
        if (itemTypeEl && x.itemType) itemTypeEl.value = String(x.itemType)
    }

    function rcHidePnDropdown() {
        const dd = document.getElementById('rcPnDropdown')
        if (dd) dd.style.display = 'none'
        // auto-fill unit/itemType ถ้า P/N ที่พิมพ์ตรงกับผลลัพธ์เป๊ะ (เหมือนหน้า Manual Receive)
        const partNo = document.getElementById('rpm_partNo')?.value.trim()
        if (!partNo) return
        const match = _rcPnResults.find(x => x.partNo === partNo)
        if (match) _rcApplyItemMasterToForm(match)
    }

    function rcPnAutocomplete(text) {
        const dd = document.getElementById('rcPnDropdown')
        if (!dd) return
        const q = (text || '').trim()
        if (!q) { dd.style.display = 'none'; return }
        dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default">
            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
        </div>`
        dd.style.display = 'block'
        clearTimeout(_rcPnTimer)
        _rcPnTimer = setTimeout(async () => {
            try {
                const res = await api(`/master/items?PartNo=${encodeURIComponent(q)}&page=1&pageSize=20`, 'GET')
                _rcPnResults = res.data || []
                if (!_rcPnResults.length) {
                    dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>ไม่พบรายการ</div>`
                    return
                }
                dd.innerHTML = _rcPnResults.map((x, i) => `
                    <div class="wo-item" onmousedown="rcSelectPn(${i})">
                        <span>
                            <strong>${escHtml(x.partNo)}</strong>
                            ${x.itemName ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${escHtml(x.itemName)}</span>` : ''}
                        </span>
                        ${x.baseUnit ? `<span class="wo-item-line">${escHtml(x.baseUnit)}</span>` : ''}
                    </div>`).join('')
            } catch {
                dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default"><i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ</div>`
            }
        }, 300)
    }

    function rcPnKeydown(e) {
        if (e.key !== 'Enter') return
        e.preventDefault()
        const dd = document.getElementById('rcPnDropdown')
        if (dd && dd.style.display !== 'none' && _rcPnResults.length) rcSelectPn(0)
    }

    function rcSelectPn(i) {
        const x = _rcPnResults[i]
        if (!x) return
        const inp = document.getElementById('rpm_partNo')
        if (inp) { inp.value = x.partNo; inp.style.borderColor = '' }
        _rcApplyItemMasterToForm(x)
        rcHidePnDropdown()
    }

    function rcOpenManualModal() {
        const navEl = document.getElementById('rpManualModalNav')
        if (navEl) navEl.style.display = 'none'
        const colHdr = document.getElementById('rpManualColHeaders')
        if (colHdr) colHdr.style.display = 'grid'
        const cfg        = rcLayoutConfig ?? {}
        const qrFields   = Array.isArray(cfg.qrFields)    ? cfg.qrFields    : []
        const lblFields  = Array.isArray(cfg.labelFields) ? cfg.labelFields : []

        const container = document.getElementById('rpManualFields')
        const rows = ALL_FIELD_KEYS.map(k => {
            const inQr  = qrFields.find(f => f.key === k)?.inQr   ?? false
            const inLbl = lblFields.find(f => f.key === k)?.show   ?? false
            const isAuto = AUTO_GEN_KEYS.has(k)
            const prefill = k === 'workOrder'      ? (rcCurrentWo      ?? '')
                          : k === 'line'           ? (rcCurrentLine    ?? '')
                          : k === 'productionArea' ? (rcProductionAreaName || rcProductionArea || '')
                          : ''
            const isReq = REQUIRED_KEYS.has(k)
            const inputEl = isAuto
                ? `<div style="padding:7px 10px;background:#f0f2f5;border:1.5px solid var(--border);border-radius:8px;font-size:12px;color:var(--t2);font-style:italic">Auto-Gen after add item</div>`
                : k === 'partNo'
                ? `<div style="position:relative">
                       <input id="rpm_partNo" class="form-input" value="${escHtml(prefill)}"
                           style="font-size:13px;padding:7px 10px;width:100%"
                           oninput="this.style.borderColor='';rcPnAutocomplete(this.value)"
                           onkeydown="rcPnKeydown(event)"
                           onblur="setTimeout(rcHidePnDropdown, 180)"
                           placeholder="${escHtml(FIELD_PLACEHOLDERS['partNo'] ?? FIELD_LABELS['partNo'])}">
                       <div id="rcPnDropdown" class="wo-dropdown" style="display:none"></div>
                   </div>`
                : k === 'quantity'
                ? `<input id="rpm_quantity" class="form-input" inputmode="decimal"
                       value="${escHtml(prefill || '1')}"
                       style="font-size:13px;padding:7px 10px"
                       oninput="this.style.borderColor=''"
                       placeholder="${escHtml(FIELD_PLACEHOLDERS['quantity'] ?? FIELD_LABELS['quantity'])}">`
                : k === 'itemType'
                ? `<select id="rpm_itemType" class="form-select" style="font-size:13px;padding:7px 10px">
                       <option value="">— Loading… —</option>
                   </select>`
                : `<input id="rpm_${cid(k)}" class="form-input" value="${escHtml(prefill)}"
                       style="font-size:13px;padding:7px 10px"
                       ${k === 'workOrder' || k === 'productionArea' || k === 'line' ? 'readonly style="font-size:13px;padding:7px 10px;background:#f8f9fc"' : ''}
                       oninput="this.style.borderColor=''"
                       placeholder="${escHtml(FIELD_PLACEHOLDERS[k] ?? FIELD_LABELS[k])}">`
            return `<div style="display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px 16px;align-items:center;padding:6px 16px;border-bottom:1px solid var(--border)">
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inQr ? 'var(--blue)' : 'var(--border)'};background:${inQr ? 'var(--blue)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inQr ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inLbl ? 'var(--purple,#7c3aed)' : 'var(--border)'};background:${inLbl ? 'var(--purple,#7c3aed)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inLbl ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="font-size:13px;font-weight:600;color:var(--navy)">
                    ${escHtml(FIELD_LABELS[k])}${isReq ? ' <span style="color:var(--red)">*</span>' : ''}
                </div>
                ${inputEl}
            </div>`
        })
        container.innerHTML = rows.join('')
        _rcLoadItemTypes(document.getElementById('rpm_itemType'))

        document.getElementById('rpManualModalTitle').textContent = '⌨ Manual Entry'
        document.getElementById('rpManualModalFooter').innerHTML =
            `<button onclick="document.getElementById('rpManualModal').style.display='none'"
                style="flex:1;padding:12px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">
                Cancel
            </button>
            <button onclick="rpSubmitManual()"
                style="flex:2;padding:12px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit">
                + Add Item
            </button>`
        document.getElementById('rpManualModal').style.display = 'flex'
    }

    function rpSubmitManual() {
        const data = {}
        ALL_FIELD_KEYS.forEach(k => {
            if (AUTO_GEN_KEYS.has(k)) { data[k] = ''; return }
            const el = document.getElementById(`rpm_${cid(k)}`)
            data[k] = el ? el.value.trim() : ''
        })
        data.itemType = parseInt(document.getElementById('rpm_itemType')?.value) || 1
        for (const k of REQUIRED_KEYS) {
            if (!data[k]) {
                showToast(`Please fill in ${FIELD_LABELS[k]}`, 'error')
                const el = document.getElementById(`rpm_${cid(k)}`)
                if (el) { el.style.borderColor = 'var(--red)'; el.focus() }
                return
            }
        }
        // quantity เก็บเป็น string เสมอ — "0"/"-5" ผ่าน check ข้างบนได้เพราะ string ไม่ว่างเป็น truthy ต้องเช็คค่าจริงแยกต่างหาก
        if (!(parseFloat(data.quantity) > 0)) {
            showToast('Quantity must be greater than 0', 'error')
            const el = document.getElementById('rpm_quantity')
            if (el) { el.style.borderColor = 'var(--red)'; el.focus() }
            return
        }
        document.getElementById('rpManualModal').style.display = 'none'
        rcOpenCopyQtyModal(data)
    }

    let _rcPendingCopyData = null

    // เปิด modal เลือกจำนวน copy ก่อนเพิ่มเข้า list จริง — รวมทั้ง list ต้องไม่เกิน 10 item
    function rcOpenCopyQtyModal(data) {
        _rcPendingCopyData = data
        const remain = Math.max(10 - rcItems.length, 0)
        const input = document.getElementById('rcCopyQtyInput')
        const hint  = document.getElementById('rcCopyQtyHint')
        if (input) { input.value = '1'; input.max = String(remain); input.style.borderColor = '' }
        if (hint)  hint.textContent = `เหลือที่เพิ่มได้อีก ${remain} รายการ (รวมสูงสุด 10 รายการ/List)`
        document.getElementById('rcCopyQtyModal').style.display = 'flex'
        setTimeout(() => input?.focus(), 50)
    }

    async function rcConfirmCopyQty() {
        const data = _rcPendingCopyData
        if (!data) return
        const input = document.getElementById('rcCopyQtyInput')
        const n = parseInt(input?.value)
        const remain = Math.max(10 - rcItems.length, 0)
        if (!Number.isInteger(n) || n < 1) {
            showToast('Copy Qty ต้องเป็นจำนวนเต็มมากกว่า 0', 'error')
            if (input) { input.style.borderColor = 'var(--red)'; input.focus() }
            return
        }
        if (n > remain) {
            showToast(`Copy Qty ต้องไม่เกิน ${remain} (รวม List สูงสุดไม่เกิน 10 รายการ)`, 'error')
            if (input) { input.style.borderColor = 'var(--red)'; input.focus() }
            return
        }
        document.getElementById('rcCopyQtyModal').style.display = 'none'
        _rcPendingCopyData = null

        let added = 0
        for (let i = 0; i < n; i++) {
            // clone ทุกรอบ — rcAddItem แก้ lotNo/uniqueId ใน object ตรงๆ ถ้าใช้ reference เดิมซ้ำ copy ก่อนหน้าจะโดนเขียนทับ
            const copy = { ...data }
            // copy ตั้งใจให้ partNo/traceId ซ้ำกันทุกตัว (ต่างแค่ lotNo/uniqueId ที่สุ่มใหม่ใน rcAddItem) — ข้าม dup check ยกเว้นตัวแรก
            if (i > 0) copy._skipDupCheck = true
            const ok = await rcAddItem(copy)
            if (!ok) break
            added++
        }
        if (added > 0) showToast(`✅ Added ${added} × ${data.partNo}`, 'success')
    }

    // เพิ่ม item ใน item list
    async function rcAddItem(data) {
        try {
        if (rcItems.length >= 10) {
            showToast('Maximum 10 items per batch', 'error')
            return
        }
        if (rcCurrentWo)      data.workOrder      = rcCurrentWo
        if (rcCurrentLine)    data.line            = rcCurrentLine
        if (rcProductionArea) {
            data.productionArea      = rcProductionArea
            data._productionAreaName = rcProductionAreaName ?? rcProductionArea
        }

        if (data.traceId && !data._skipDupCheck) {
            const dup = rcItems.find(i => i.data.traceId === data.traceId)
            if (dup) {
                showToast('⚠️ traceId already in list: ' + data.traceId, 'error')
                return
            }
        }

        // Manual entry (ไม่มี _scanKey เพราะไม่ได้ผ่าน scan pipeline) — เช็คซ้ำกับของที่สแกน/เพิ่มไปแล้ว เหมือนหน้า Receive
        // (item ที่มาจากสแกนถูกเช็คซ้ำไปแล้วก่อนหน้านี้ใน scan handler พร้อม modal ยืนยัน ไม่ต้องเช็คซ้ำอีกรอบตรงนี้)
        if (!data._scanKey && !data._skipDupCheck) {
            const dupKey = _rcDupKey(data)
            if (dupKey && rcScannedTrace.has(dupKey)) {
                const label = data.traceId ? 'Trace ID' : data.rawBarCode ? 'Raw Barcode' : 'Part No'
                if (canCheckScanDuplicate) {
                    const ok = await confirmDuplicate({
                        title:   `${label} ซ้ำ`,
                        body:    `${label} นี้อยู่ใน List แล้ว<br>ต้องการรับเข้าเพิ่มหรือไม่?`,
                        okLabel: 'Add to List'
                    })
                    if (!ok) return
                } else {
                    showToast('⚠️ รายการนี้ถูกเพิ่ม/สแกนไปแล้ว: ' + dupKey, 'error')
                    return
                }
            }
        }

        // ถ้ายังไม่มี itemType/description (เช่น มาจากสแกนที่ไม่ได้ให้ค่ามาครบ) — เติมจาก Master Item ตาม partNo เหมือนหน้า Receive
        if ((!data.itemType || !data.description) && data.partNo) {
            try {
                const itemMaster = await api(`/master/items/${encodeURIComponent(data.partNo)}`, 'GET')
                if (!data.itemType)    data.itemType    = itemMaster?.itemType || 1
                if (!data.description) data.description = itemMaster?.itemName || ''
            } catch (_) {
                if (!data.itemType) data.itemType = 1
            }
        }

        try {
            const trRes = await api('/inventory/new-lotNo', 'GET')
            data.lotNo  = trRes?.lotNo ?? trRes?.traceId ?? trRes?.id ?? String(trRes) ?? null
        } catch (_) {
            data.lotNo = null
        }
        data.createdAt = new Date().toISOString()
        data.uniqueId  = await _fetchUniqueId()

        const cfg = rcLayoutConfig ?? {}
        const sliders = {
            qrX:       cfg.qrX       ?? 30,
            qrY:       cfg.qrY       ?? 40,
            qrSize:    cfg.qrSize    ?? 5,
            dataX:     cfg.dataX     ?? 373,
            dataY:     cfg.dataY     ?? 58,
            fontSize:  cfg.fontSize  ?? 22,
            lineHeight: cfg.lineHeight ?? 33,
            valOffset:  cfg.valOffset  ?? 151,
        }
        const textFields = buildLabelTextFields(cfg.labelFields, data)
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        rcItems.push({ data, zpl, previewSrc: null, reviewed: true })   // ถูกโฟกัสใน Label Preview ทันที = Review Success
        _rcPreviewIdx = rcItems.length - 1   // โฟกัส Label Preview ไปที่ item ที่เพิ่งเพิ่ม
        const dupKeyAdded = _rcDupKey(data)
        if (dupKeyAdded) rcScannedTrace.add(dupKeyAdded)
        // เครื่องสั่น
        if (navigator.vibrate) navigator.vibrate(50)

        rcRenderList()
        const idx = rcItems.length - 1
        const dpi = cfg.dpi ?? '8dpmm'
        const w   = cfg.width  ?? 4
        const h   = cfg.height ?? 3
        renderZplClient(zpl, dpi, w, h).then(src => {
            if (rcItems[idx]) { rcItems[idx].previewSrc = src }
            if (idx === _rcPreviewIdx) rcRenderPreviewPanel()
        }).catch(() => {})
        return true
        } catch(e) { showToast('Failed to add item: ' + e.message, 'error'); return false }
    }

    function rcConfirmDelete(idx) {
        const item = rcItems[idx]
        if (!item) return
        const desc = document.getElementById('rpConfirmModalDesc')
        if (desc) desc.textContent = item.data.partNo ? `P/N: ${item.data.partNo}` : `Item #${idx + 1}`
        const btn = document.getElementById('rpConfirmDeleteBtn')
        if (btn) btn.onclick = () => {
            document.getElementById('rpConfirmModal').style.display = 'none'
            rcRemoveItem(idx)
        }
        document.getElementById('rpConfirmModal').style.display = 'flex'
    }

    function rcRemoveItem(idx) {
        const dupKey = _rcDupKey(rcItems[idx]?.data)
        if (dupKey) rcScannedTrace.delete(dupKey)
        rcItems.splice(idx, 1)
        if (_rcPreviewIdx >= idx && _rcPreviewIdx > 0) _rcPreviewIdx--
        if (rcItems[_rcPreviewIdx]) rcItems[_rcPreviewIdx].reviewed = true   // แสดงใน Label Preview แล้ว = Review Success
        rcRenderList()
    }

    // ── Label Preview panel (pagination + printer + copies + total + print) ──
    function rcSelectPreview(idx) {
        _rcPreviewIdx = idx
        if (rcItems[idx]) rcItems[idx].reviewed = true   // แสดงใน Label Preview แล้ว = Review Success
        rcRenderList()
    }

    function rcPreviewNav(delta) {
        const n = rcItems.length
        if (!n) return
        _rcPreviewIdx = Math.min(n - 1, Math.max(0, _rcPreviewIdx + delta))
        if (rcItems[_rcPreviewIdx]) rcItems[_rcPreviewIdx].reviewed = true   // แสดงใน Label Preview แล้ว = Review Success
        rcRenderList()
    }

    function rcCopiesStep(delta) {
        _rcCopies = Math.max(1, _rcCopies + delta)
        rcRenderPreviewPanel()
    }

    function rcRenderPreviewPanel() {
        const n = rcItems.length
        if (_rcPreviewIdx > n - 1) _rcPreviewIdx = n - 1
        if (_rcPreviewIdx < 0) _rcPreviewIdx = 0

        const pagText = document.getElementById('rcPreviewPagText')
        if (pagText) pagText.textContent = n ? `${_rcPreviewIdx + 1} / ${n}` : '0 / 0'
        const pagBtns = document.querySelectorAll('#rcPreviewPag .rcp-pag-btn')
        if (pagBtns[0]) pagBtns[0].disabled = n === 0 || _rcPreviewIdx <= 0
        if (pagBtns[1]) pagBtns[1].disabled = n === 0 || _rcPreviewIdx >= n - 1

        const box  = document.getElementById('rcPreviewImgBox')
        const meta = document.getElementById('rcPreviewMeta')
        if (n === 0) {
            box.innerHTML  = '<div class="rp-empty-state">No items yet — scan or type to add</div>'
            meta.textContent = ''
        } else if (!document.getElementById('rcLayout')?.value) {
            box.innerHTML  = '<div class="rp-empty-state"><i class="bi bi-exclamation-triangle" style="color:var(--amber)"></i> Please Select Layout</div>'
            meta.textContent = ''
        } else {
            const item = rcItems[_rcPreviewIdx]
            if (item.previewSrc) {
                box.innerHTML = `<img src="${escHtml(item.previewSrc)}" style="max-width:100%;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.12)">`
            } else {
                box.innerHTML = '<div style="color:var(--t3);font-size:13px">⏳ Rendering…</div>'
                const cfg = rcLayoutConfig ?? {}
                const myIdx = _rcPreviewIdx
                renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3).then(src => {
                    if (rcItems[myIdx]) rcItems[myIdx].previewSrc = src
                    if (myIdx === _rcPreviewIdx) rcRenderPreviewPanel()
                }).catch(() => {})
            }
            const cfg      = rcLayoutConfig ?? {}
            const dims     = `${cfg.dpi ?? '8dpmm'} · ${cfg.width ?? 4} x ${cfg.height ?? 3} in`
            const layoutSel = document.getElementById('rcLayout')
            const layoutNm  = layoutSel?.selectedOptions?.[0]?.textContent ?? '—'
            meta.textContent = `Layout: ${layoutNm} · ${dims}`
        }

        const total = n * _rcCopies
        const copiesInput = document.getElementById('rcCopies')
        if (copiesInput) copiesInput.value = _rcCopies
        const totalEl = document.getElementById('rcTotalLabels')
        if (totalEl) totalEl.textContent = `${total} label${total === 1 ? '' : 's'}`

        const unreviewed = rcItems.filter(i => !i.reviewed).length
        const warnEl = document.getElementById('rcPreviewWarning')
        if (warnEl) {
            if (unreviewed > 0) {
                warnEl.style.display = ''
                warnEl.innerHTML = `<i class="bi bi-exclamation-triangle"></i> ยังมี ${unreviewed} รายการที่ยังไม่ได้ตรวจสอบ (Review) — แตะรายการเพื่อยืนยัน`
            } else {
                warnEl.style.display = 'none'
            }
        }

        const canPrint = n > 0 && !_rcPrinting
        const labelEl  = document.getElementById('rcPrintBtnLabel')
        if (labelEl) labelEl.textContent = `Print ${total} Label${total === 1 ? '' : 's'}`
        const btn = document.getElementById('rcPrintBtn')
        if (btn) {
            btn.disabled      = !canPrint
            btn.style.opacity = canPrint ? '1' : '0.45'
            btn.style.cursor  = canPrint ? 'pointer' : 'not-allowed'
            btn.title = _rcPrinting ? 'Printing in progress…' : n === 0 ? 'Add items first' : ''
        }
    }

    function rcRenderList() {
        const container = document.getElementById('rcItemList')
        const badge     = document.getElementById('rcCounter')
        const n         = rcItems.length
        const reviewed  = rcItems.filter(i => i.reviewed).length
        badge.textContent = `${n}/10`
        badge.className   = 'rp-counter-badge' + (n >= 10 ? ' full' : '')

        const allReviewed = n > 0 && reviewed === n
        if (_rcShowUnreviewed && allReviewed) _rcShowUnreviewed = false
        if (document.getElementById('rcPrinterSelect')?.value) rcShowError('rcPrinterTrigger', false)

        if (n === 0) {
            container.innerHTML = '<div class="rp-empty-state">No items yet — scan or type to add</div>'
            rcRenderPreviewPanel()
            return
        }

        const cols = `font-size:13px;font-weight:600;color:var(--t2);font-family:monospace;flex:1.6;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap`
        container.innerHTML = rcItems.map((item, idx) => {
            const d       = item.data
            const err     = item.receiveError || item.printError
            const errType = item.receiveError ? 'Receive' : item.printError ? 'Print' : null

            if (item.processing) {
                const rxBadge = item.isReceived
                    ? `<span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#15803d;background:#f0fdf4;border:1px solid #86efac;border-radius:4px;padding:1px 7px;white-space:nowrap"><i class="bi bi-check2"></i> Received</span>`
                    : ''
                return `<div class="rp-item-row" style="opacity:0.65" onclick="rcSelectPreview(${idx})">
                    <div class="rp-item-info" style="flex:1.4"><div class="rp-item-pn">${escHtml(d.partNo || '—')}</div></div>
                    <div style="${cols}">${escHtml(d.description || '')}</div>
                    <div style="font-size:13px;font-weight:700;color:var(--text);width:42px;flex-shrink:0;text-align:right">${escHtml(String(d.quantity || ''))}</div>
                    <div style="font-size:12px;font-weight:600;color:var(--t2);width:48px;flex-shrink:0;text-align:right">${escHtml(d.unit || '')}</div>
                    <div style="width:160px;display:flex;justify-content:flex-end;align-items:center;gap:8px">
                        ${rxBadge}
                        <span style="font-size:13px;color:var(--t2)">⏳</span>
                    </div>
                </div>`
            }

            if (err) {
                const ok = item.reviewed
                const badge = errType === 'Receive'
                    ? `<span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#c2410c;background:#fff7ed;border:1px solid #fed7aa;border-radius:4px;padding:1px 6px;white-space:nowrap"><i class="bi bi-inbox"></i> Receive</span>`
                    : `<span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;border-radius:4px;padding:1px 6px;white-space:nowrap"><i class="bi bi-printer"></i> Print</span>`
                return `<div class="rp-item-row" style="flex-direction:column;gap:0;border-left:3px solid var(--red);background:#fff5f5;padding:0;align-items:stretch" onclick="rcSelectPreview(${idx})">
                    <div style="display:flex;align-items:center;gap:16px;padding:8px 14px">
                        <div class="rp-item-info" style="flex:1.4"><div class="rp-item-pn">${escHtml(d.partNo || '—')}</div></div>
                        <div style="${cols}">${escHtml(d.description || '')}</div>
                        <div style="font-size:13px;font-weight:700;color:var(--text);width:42px;flex-shrink:0;text-align:right">${escHtml(String(d.quantity || ''))}</div>
                        <div style="font-size:12px;font-weight:600;color:var(--t2);width:48px;flex-shrink:0;text-align:right">${escHtml(d.unit || '')}</div>
                        <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;width:160px;justify-content:flex-end">
                            <button onclick="event.stopPropagation();rcViewItemData(${idx})"
                                style="background:${ok ? 'var(--green-lt)' : '#fffbeb'};border:1.5px solid ${ok ? 'var(--green)' : '#f59e0b'};border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;color:${ok ? 'var(--green)' : '#d97706'};cursor:pointer;white-space:nowrap;font-family:inherit;min-width:88px;text-align:center">
                                ${ok ? '✓ Reviewed' : '📋 View Data'}
                            </button>
                            <button class="rp-remove-btn" onclick="event.stopPropagation();rcConfirmDelete(${idx})" title="Remove" style="border-color:var(--red);color:var(--red)">✕</button>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:6px;padding:4px 14px 7px;border-top:1px solid #fecaca">
                        ${item.isReceived && errType === 'Print' ? `<span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#15803d;background:#f0fdf4;border:1px solid #86efac;border-radius:4px;padding:1px 7px;white-space:nowrap"><i class="bi bi-check2"></i> Received</span>` : ''}
                        ${badge}
                        <span style="font-size:11px;color:var(--red);font-weight:600;line-height:1.4">${escHtml(err)}</span>
                    </div>
                </div>`
            }

            const ok = item.reviewed
            const needsReview = _rcShowUnreviewed && !ok
            const isSelected  = idx === _rcPreviewIdx
            const rowStyle = needsReview
                ? 'border-left:3px solid var(--amber);background:#fffbf0'
                : isSelected ? 'border-left:3px solid var(--blue);background:var(--blue-lt)' : ''
            return `<div class="rp-item-row" style="${rowStyle}" onclick="rcSelectPreview(${idx})">
                <div class="rp-item-info" style="flex:1.4"><div class="rp-item-pn">${escHtml(d.partNo || '—')}</div></div>
                <div style="${cols}">${escHtml(d.description || '')}</div>
                <div style="font-size:13px;font-weight:700;color:var(--text);width:42px;flex-shrink:0;text-align:right">${escHtml(String(d.quantity || ''))}</div>
                <div style="font-size:12px;font-weight:600;color:var(--t2);width:48px;flex-shrink:0;text-align:right">${escHtml(d.unit || '')}</div>
                <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;width:160px;justify-content:flex-end">
                    <button onclick="event.stopPropagation();rcViewItemData(${idx})"
                        style="background:${ok ? 'var(--green-lt)' : '#fffbeb'};border:1.5px solid ${ok ? 'var(--green)' : '#f59e0b'};border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;color:${ok ? 'var(--green)' : '#d97706'};cursor:pointer;white-space:nowrap;font-family:inherit;min-width:88px;text-align:center">
                        ${ok ? '✓ Reviewed' : '📋 View Data'}
                    </button>
                    <button class="rp-remove-btn" onclick="event.stopPropagation();rcConfirmDelete(${idx})" title="Remove">✕</button>
                </div>
            </div>`
        }).join('')
        rcRenderPreviewPanel()
    }

    function rpClosePreview() {
        document.getElementById('rpPreviewModal').style.display = 'none'
    }

    function rcValidate() {
        if (rcItems.length === 0 || _rcPrinting) return

        // Validate: Work Order
        if (!rcCurrentWo) {
            rcShowError('rcWoInput', true)
            document.getElementById('rcWoInput').scrollIntoView({ behavior: 'smooth', block: 'center' })
            setTimeout(() => document.getElementById('rcWoInput').focus(), 300)
            showToast('กรุณาเลือก Work Order', 'error')
            return
        }
        // Validate: Layout Template
        if (!document.getElementById('rcLayout')?.value) {
            rcShowError('rcLayout', true)
            document.getElementById('rcLayout').scrollIntoView({ behavior: 'smooth', block: 'center' })
            setTimeout(() => document.getElementById('rcLayout').focus(), 300)
            showToast('กรุณาเลือก Layout Template', 'error')
            return
        }
        // Validate: Receive Location
        if (!rcReceiveLocationCode) {
            rcShowError('rcLocSearch', true)
            document.getElementById('rcLocSearch').scrollIntoView({ behavior: 'smooth', block: 'center' })
            setTimeout(() => document.getElementById('rcLocSearch').focus(), 300)
            showToast('กรุณาเลือก Receive Location', 'error')
            return
        }
        // Validate: Printer
        if (!document.getElementById('rcPrinterSelect')?.value) {
            rcShowError('rcPrinterTrigger', true)
            document.getElementById('rcPrinterTrigger').scrollIntoView({ behavior: 'smooth', block: 'nearest' })
            document.getElementById('rcPrinterTrigger').focus()
            showToast('กรุณาเลือก Printer', 'error')
            return
        }
        // Validate: unreviewed items
        const unreviewed = rcItems.filter(i => !i.reviewed).length
        if (unreviewed > 0) {
            _rcShowUnreviewed = true
            rcRenderList()
            showToast(`กรุณา View Data ก่อน Print (${unreviewed} item ยังไม่ได้ตรวจสอบ)`, 'error')
            return
        }
        _rcShowUnreviewed = false

        // ครบแล้ว → เปิด modal ถ่ายรูปยืนยัน (ข้ามได้ถ้าติ๊ก Skip Upload Images Validation)
        if (document.getElementById('advSkipImg')?.checked) {
            rcPrint('receive')
        } else {
            rcPhoto.open()
        }
    }

    async function rcPrint(mode) {
        if (rcItems.length === 0) return
        const printerSel = document.getElementById('rcPrinterSelect')
        const printerIp   = printerSel?.value
        const printerPort = printerSel?.dataset.port || 9100
        if (!printerIp) { showToast('Please select a printer', 'error'); return }

        if (mode === 'receive' && !document.getElementById('advSkipGps')?.checked) {
            if (!navigator.geolocation) {
                showToast('Browser ไม่รองรับ GPS', 'error'); return
            }
            const btns = ['rcPrintBtn'].map(id => document.getElementById(id)).filter(Boolean)
            const prevHtmls = btns.map(b => b.innerHTML)
            btns.forEach(b => b.innerHTML = '<i class="bi bi-geo-alt"></i> Getting GPS…')
            try {
                let pos
                try {
                    pos = await new Promise((res, rej) =>
                        navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
                    )
                } catch (e) {
                    if (e.code !== e.TIMEOUT) throw e
                    console.warn('[rcPrint] high-accuracy GPS timed out, retrying with enableHighAccuracy:false')
                    btns.forEach(b => b.innerHTML = '<i class="bi bi-geo-alt"></i> Retrying GPS…')
                    pos = await new Promise((res, rej) =>
                        navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: false, timeout: 8000 })
                    )
                }
                rcReceiveLat = pos.coords.latitude
                rcReceiveLng = pos.coords.longitude
                rcReceiveAltitude = pos.coords.altitude
                //console.log('[rcPrint] GPS lat:', rcReceiveLat, 'lng:', rcReceiveLng)
            } catch (e) {
                btns.forEach((b, i) => b.innerHTML = prevHtmls[i])
                let msg
                switch (e.code) {
                    case e.PERMISSION_DENIED:
                        msg = 'ไม่ได้รับอนุญาตให้เข้าถึงตำแหน่ง — กรุณาอนุญาต Location ใน browser และตรวจสอบว่าเข้าผ่าน HTTPS'
                        break
                    case e.POSITION_UNAVAILABLE:
                        msg = 'ไม่สามารถระบุตำแหน่งได้ — ตรวจสอบว่าเปิด GPS/Location Services บนอุปกรณ์แล้ว'
                        break
                    case e.TIMEOUT:
                        msg = 'หมดเวลาในการระบุตำแหน่ง — ลองใหม่อีกครั้ง หรือไปยังที่โล่งแจ้ง'
                        break
                    default:
                        msg = e.message || 'Unknown error'
                }
                showToast('GPS error: ' + msg, 'error'); return
            }
            btns.forEach((b, i) => b.innerHTML = prevHtmls[i])
        }

        _rcPrinting = true
        rcRenderList()

        // ── ขั้น 1: Receive ทั้งก้อนในคำขอเดียว — อัปโหลดรูปยืนยันแค่ครั้งเดียว ไม่ซ้ำต่อ item เหมือนเดิม ──
        if (mode === 'receive') {
            await _rcBatchReceive()
        }

        // ── ขั้น 2: Print ทีละใบตามลำดับ (ต้องส่งทีละใบไปเครื่องพิมพ์จริงอยู่ดี ไม่สามารถ batch ได้) ──
        for (const item of [...rcItems]) {
            if (mode === 'receive' && !item.isReceived) continue   // receive ไม่ผ่าน ข้าม ไม่ print
            await _rcPrintItem(item, printerIp, printerPort, mode)
        }

        _rcPrinting = false
        if (rcItems.length === 0) {
            showToast(`🖨️ All items printed${mode === 'receive' ? ' & received' : ''} successfully`, 'success')
        }
        rcRenderList()
        if (mode === 'receive') {
            if (rcItems.length === 0) rcPhoto.reset()   // success ทั้งหมด (list ว่าง) → เคลียร์ทุกอย่างรวม scan snap เก่า
            else                       rcPhoto.close()   // ยังมี item ค้าง (receive/print error) → เคลียร์แค่ confirm photo, snap ไว้เผื่อ retry
        }
    }

    // Receive ทุก item ที่ยังไม่ได้ Receive ในคำขอเดียว (map ผลลัพธ์กลับด้วย lotNo เหมือนหน้า Receive.cshtml)
    async function _rcBatchReceive() {
        const pending = rcItems.filter(item => !item.isReceived)
        if (!pending.length) return

        pending.forEach(item => {
            item.processing   = true
            item.receiveError = null
        })
        rcRenderList()

        try {
            const receivePayload = {
                command: { items: pending.map(item => _rcBuildReceivePayload(item)) },
                options: getAdvancedOptions()
            }
            console.log('[Receive] batch payload →', JSON.stringify(receivePayload, null, 2))
            const res = await apiForm('/inventory/receive', receivePayload, rcPhoto.getBlobs(), 10000)
            console.log('[Receive] batch response →', res)
            const data      = Array.isArray(res?.data) ? res.data : []
            const globalErr = data.find(d => !d.lotNo && !(d.sucess || d.success))

            pending.forEach(item => {
                const results  = data.filter(d => d.lotNo === item.data.lotNo)
                const failures = results.filter(d => !(d.sucess || d.success))
                if (failures.length) {
                    item.receiveError = failures.map(d => [d.errorCode, d.message].filter(Boolean).join(': ') || 'Receive failed').join(', ')
                    item.reviewed      = false
                    item.processing    = false
                    showToast(`❌ ${item.data.lotNo || ''}: ${item.receiveError}`, 'error')
                } else {
                    item.isReceived = true
                    item.processing = false
                }
            })

            if (globalErr) {
                showToast(`❌ ${[globalErr.errorCode, globalErr.message].filter(Boolean).join(': ')}`, 'error')
            }
        } catch (err) {
            const msg = err.message || 'Receive failed'
            pending.forEach(item => {
                item.receiveError = msg
                item.reviewed      = false
                item.processing    = false
            })
            showToast(`❌ ${msg}`, 'error')
        }
        rcRenderList()
    }

    function _rcBuildReceivePayload(item) {
        return {
            lotNo:        item.data.lotNo        ?? '',
            partNo:       item.data.partNo       ?? '',
            description:  item.data.description  ?? '',
            workOrderNo:  item.data.workOrder    ?? item.data.workOrderNo ?? '',
            locationCode: rcReceiveLocationCode  ?? '',
            quantity:     +item.data.quantity    || 0,
            unit:         item.data.unit         ?? '',
            traceId:      item.data.traceId      ?? item.data._barcode   ?? '',
            vendor:       item.data.vendor       ?? '',
            dateCode:     item.data.dateCode     ?? '',
            tradingCode:  item.data.tradingCode  ?? '',
            po:           item.data.po           ?? '',
            inventoryNo:  item.data.inventoryNo  ?? '',
            rawBarCode:   item.data.rawBarCode   ?? item.data._barcode ?? '',
            itemType:     item.data.itemType     ?? 1,
            latitude:     rcReceiveLat,
            longitude:    rcReceiveLng,
            zHeigth:      rcReceiveAltitude      ?? 0
        }
    }

    async function _rcPrintItem(item, printerIp, printerPort, mode) {
        item.processing = true
        item.printError = null
        rcRenderList()

        try {
            const payload = {
                printerIp,
                printerPort,
                lotNo:    item.data.lotNo    ?? '',
                uniqueId: item.data.uniqueId ?? '',
                zpl:      applyPrintOffset(item.zpl, rcLayoutConfig),
            }
            // ส่ง reprintReason ทุกครั้งที่ user กรอกช่อง Print Reason ไว้ ไม่ว่าจะ print ครั้งแรกหรือ retry
            const reason = (document.getElementById('rcPrintReason')?.value || '').trim()
            if (reason) payload.reprintReason = reason
            if (item.printAttempted) {
                payload.isReprint     = true
                payload.reprintReason = reason || 'Re-Print in PrintReceive'
            }
            item.printAttempted = true
            console.log('[Print] payload →', JSON.stringify(payload, null, 2))
            const res = await api('/printer/send', 'POST', payload, 10000)
            console.log('[Print] response →', res)
            const pd  = res?.problemDetails
            if (pd || (res?.statusCode && res.statusCode >= 400)) {
                const msg = [pd?.title, pd?.detail].filter(Boolean).join(': ') || res?.message || 'Print failed'
                item.printError  = msg
                item.reviewed    = false
                item.processing  = false
                // Print failed — generate a fresh uniqueId for the next attempt
                item.data.uniqueId = await _fetchUniqueId()
                rcRebuildItemZpl(item)
                showToast(`❌ ${item.data.lotNo || ''}: ${msg}`, 'error')
                rcRenderList()
            } else {
                const i = rcItems.indexOf(item)
                if (i !== -1) {
                    const dupKey = _rcDupKey(item.data)
                    if (dupKey) rcScannedTrace.delete(dupKey)
                    rcItems.splice(i, 1)
                }
                rcRenderList()
            }
        } catch (err) {
            item.printError  = err.message || 'Print error'
            item.reviewed    = false
            item.processing  = false
            // Print failed — generate a fresh uniqueId for the next attempt
            item.data.uniqueId = genUniqueId()
            rcRebuildItemZpl(item)
            showToast(`❌ ${item.data.lotNo || ''}: ${item.printError}`, 'error')
            rcRenderList()
        }
    }

    async function rcInitLocation() {
        console.log("RcInitLocation")
        const rcLocRenderItem = (loc, i) => {
            console.log("LOC :",loc)
            return `<div class="wo-item" style="gap:10px" data-idx="${i}">
                <div style="display:flex;align-items:center;gap:10px;min-width:0">
                    <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0"></i>
                    <span style="font-weight:700">${escHtml(loc.displayName || loc.locationCode)}</span>
                     ${loc.description ? `<span style="font-size:12px;color:var(--t2)">${escHtml(loc.description)}</span>` : ''} 
                 </div>
                ${loc.typeName ? `<span style="font-size:12px;color:var(--t2);flex-shrink:0">${escHtml(loc.typeName)}</span>` : ''}
                </div>` 
            }


       

        await loadPerLocation()
        console.log("My Locations _Receive : ", myLocations)

        createLocationAutocomplete({
            inputId: 'rcLocSearch', dropdownId: 'rcLocDropdown',
            locations: myLocations,
            emptyText: 'ไม่พบ Location',
            renderItem: rcLocRenderItem,
            onSelect: loc => {
                if (loc) {
                    rcReceiveLocationCode = loc.locationCode
                    rcShowError('rcLocSearch', false)
                    rcCheckScanReady()
                } else {
                    rcReceiveLocationCode = null
                }
            }

        })
    }

    document.addEventListener('DOMContentLoaded', () => rcInitLocation())
</script>
