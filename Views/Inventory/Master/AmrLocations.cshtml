@{
    ViewData["Title"] = "Master Management";
}
<link rel="stylesheet" href="css/master-shared.css"/>
<style>
/* ── shared loc-input style (เหมือน Receive.cshtml) ── */
.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:10px 12px 10px 34px;
    border:1.5px solid var(--border); border-radius:9px;
    font-size:14px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box; background:#fff;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:11px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item {
    padding:9px 12px; font-size:13px; cursor:pointer;
    border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px;
    transition:.12s;
}
.loc-item:last-child { border-bottom:none; }
.loc-item:hover { background:var(--blue-lt); }
</style>

<div class="toast-stack" id="toastStack"></div>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2>Master Management</h2>
    </div>
</div>

@await Html.PartialAsync("Master/_MasterManagement")

<!-- ── AMR LOCATIONS ── -->
<div class="section-card">
    <div class="sc-head">
        <div class="sc-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                <circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
            </svg>
            AMR Locations
            <span id="amrCount" class="count-badge"></span>
        </div>
        <div class="filter-bar">
            <input id="amrSearch" class="filter-input" placeholder="Search Point Code..."
                   oninput="loadAmrLocations(1)">
            <select id="amrTypeFilter" class="filter-select" onchange="loadAmrLocations(1)">
                <option value="">All Types</option>
            </select>
            <select id="amrActiveFilter" class="filter-select" onchange="loadAmrLocations(1)">
                <option value="">All Status</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
            <button class="btn-create" onclick="resetAmrForm(); openModal('amrModal')">+ ADD</button>
        </div>
    </div>
    <div style="overflow-x:auto">
        <table class="inv-table">
            <thead>
                <tr>
                    <th>Point Code</th>
                    <th>Display Name</th>
                    <th>Point Type</th>
                    <th>Locations</th>
                    <th>Capacity</th>
                    <th>Vendor</th>
                    <th>Ext. Code</th>
                    <th>Coordinates</th>
                    <th>Accuracy</th>
                    <th>Description</th>
                    <th>Available</th>
                    <th>Active</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="amrTable"></tbody>
        </table>
    </div>
    <div class="pag-bar">
        <div style="display:flex;align-items:center;gap:10px">
            <select class="pag-size" id="amrPageSize" onchange="loadAmrLocations(1)">
                <option value="10" selected>10 rows</option>
                <option value="20">20 rows</option>
                <option value="50">50 rows</option>
            </select>
            <span class="pag-info" id="amrPageInfo"></span>
        </div>
        <div class="pag-btns" id="amrPagination"></div>
    </div>
</div>

<!-- ── AMR LOCATION MODAL ── -->
<div class="modal-overlay" id="amrModal">
    <div class="modal-box" style="max-width:560px">
        <div class="modal-title" id="amrModalTitle">New AMR Location</div>
        <input type="hidden" id="amrId">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="modal-field">
                <div class="modal-label">Point Code <span style="color:var(--red)">*</span></div>
                <input class="modal-input" id="amrPointCode" placeholder="e.g. P001">
            </div>
            <div class="modal-field">
                <div class="modal-label">Display Name</div>
                <input class="modal-input" id="amrDisplayName" placeholder="e.g. Charging Station 1">
            </div>
            <div class="modal-field">
                <div class="modal-label">Point Type</div>
                <select class="modal-select" id="amrPointType">
                    <option value="">— Select Type —</option>
                </select>
            </div>
            <div class="modal-field">
                <div class="modal-label">Capacity</div>
                <input class="modal-input" id="amrCapacity" type="number" min="0" placeholder="0">
            </div>
            <div class="modal-field">
                <div class="modal-label">Vendor</div>
                <input class="modal-input" id="amrVendor" placeholder="e.g. MiR">
            </div>
            <div class="modal-field">
                <div class="modal-label">External Code</div>
                <input class="modal-input" id="amrExternalCode" placeholder="External system ID">
            </div>
            <div class="modal-field">
                <div class="modal-label">Latitude</div>
                <input class="modal-input" id="amrLatitude" type="number" step="any" placeholder="e.g. 13.588">
            </div>
            <div class="modal-field">
                <div class="modal-label">Longitude</div>
                <input class="modal-input" id="amrLongitude" type="number" step="any" placeholder="e.g. 100.945">
            </div>
            <div class="modal-field">
                <div class="modal-label">Accuracy (m)</div>
                <input class="modal-input" id="amrAccuracy" type="number" step="any" min="0" placeholder="e.g. 0.5">
            </div>
        </div>
        <div class="modal-field">
            <div class="modal-label">Description</div>
            <textarea class="modal-textarea" id="amrDescription" rows="2" placeholder="รายละเอียดจุด AMR"></textarea>
        </div>
        <div style="display:flex;gap:24px;margin:10px 0">
            <label class="modal-check"><input type="checkbox" id="amrIsAvailable" checked> Available</label>
            <label class="modal-check"><input type="checkbox" id="amrIsActive" checked> Active</label>
        </div>

        <!-- ── Assigned Locations (1 AMR point → หลาย Location) — ต้องมี id (บันทึก point ก่อน) ถึงจะ assign ได้ ── -->
        <div class="modal-field" id="amrLocationsHint">
            <div style="font-size:12px;color:var(--t3);padding:8px 0">บันทึก Point นี้ก่อน แล้วจะสามารถเพิ่ม Location ได้</div>
        </div>
        <div class="modal-field" id="amrLocationsSection" style="display:none">
            <div class="modal-label">Assigned Locations</div>
            <div id="amrLocationsList" style="display:flex;flex-direction:column;gap:6px;margin-bottom:10px"></div>
            <div style="display:grid;grid-template-columns:1fr 78px auto auto;gap:8px;align-items:center">
                <div class="loc-wrap">
                    <i class="bi bi-geo-alt-fill loc-icon" style="font-size:13px"></i>
                    <input type="text" id="amrLocationSearch" class="loc-input" placeholder="ค้นหา Location..." autocomplete="off">
                    <input type="hidden" id="amrLocationId">
                    <div id="amrLocationDropdown" class="loc-dd"></div>
                </div>
                <input class="modal-input" id="amrNewSortOrder" type="number" min="0" placeholder="Sort">
                <label class="modal-check" style="white-space:nowrap"><input type="checkbox" id="amrNewIsDefault"> Default</label>
                <button type="button" class="modal-btn modal-btn-primary" style="padding:10px 16px;white-space:nowrap" onclick="amrAddLocation()">+ Add</button>
            </div>
        </div>

        <div class="modal-error" id="amrError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('amrModal')">ยกเลิก</button>
            <button class="modal-btn modal-btn-primary" onclick="saveAmrLocation()">Save</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/master-shared.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/locationAutocomplete.js"></script>
<script>
    let AmrLocationType = []

    function escHtml(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
    }

    function _amrBool(v, trueLabel, falseLabel) {
        return v
            ? `<span style="background:var(--green-lt);color:var(--green);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">${trueLabel}</span>`
            : `<span style="background:#f0f2f5;color:var(--t3);font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px">${falseLabel}</span>`
    }

    // pointType จาก /amr-location เป็น id — เอาไป match กับ AmrLocationType (จาก GET /amr-location/point-type) เพื่อโชว์ชื่อจริง
    function _amrTypeName(pointType) {
        if (pointType === null || pointType === undefined || pointType === '') return '—'
        const t = AmrLocationType.find(t => String(t.id) === String(pointType))
        return t ? t.name : String(pointType)
    }

    // สรุป Location ที่ assign ไว้ให้ point นี้เป็นเซลล์เดียว — โชว์ตัว default (หรือตัวแรกถ้าไม่มี default) + badge "+N" ถ้ามีมากกว่า 1
    function _amrLocationsCell(locs) {
        if (!Array.isArray(locs) || !locs.length) return '<span style="color:var(--t3)">—</span>'
        const def   = locs.find(l => l.isDefault) || locs[0]
        const extra = locs.length - 1
        return `<span style="font-weight:600;color:var(--navy)">${escHtml(def.displayName || def.locationCode || '—')}</span>` +
            (extra > 0 ? `<span style="background:var(--blue-lt);color:var(--blue);font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;margin-left:6px">+${extra}</span>` : '')
    }

    async function loadAmrLocations(page = 1) {
        const search = document.getElementById('amrSearch').value.trim()
        const type   = document.getElementById('amrTypeFilter').value
        const active = document.getElementById('amrActiveFilter').value
        const ps     = parseInt(document.getElementById('amrPageSize').value)

        // /amr-location ไม่รองรับ page/pageSize/pointType จริงๆ (เช็คจาก Swagger แล้ว รับแค่ active/locationId/keyword
        // แล้ว return ทุก location มาให้หมด) เลยดึงมาทั้งก้อน แล้วมา filter pointType + แบ่งหน้าเองฝั่งหน้าบ้าน
        const qs = []
        if (search) qs.push(`keyword=${encodeURIComponent(search)}`)
        if (active !== '') qs.push(`active=${active}`)
        const url = `/amr-location${qs.length ? '?' + qs.join('&') : ''}`

        // ให้ _locNameMap พร้อมก่อน (ใช้แปลง location code -> ชื่อจริงตอน render) กัน column Location โชว์ค้างเป็น code ตอนโหลดรอบแรก
        if (!_locNameMap.size) await loadLocation()

        try {
            const res = await api(url)
            let items = Array.isArray(res) ? res : (res?.data || [])
            if (type) items = items.filter(x => String(x.pointType) === String(type))

            const total      = items.length
            const totalPages = Math.ceil(total / ps) || 1
            const cp          = Math.min(Math.max(1, page), totalPages)
            const pageItems   = items.slice((cp - 1) * ps, cp * ps)

            document.getElementById('amrCount').textContent = total + ' items'
            renderPagination('amrPagination', 'amrPageInfo', cp, totalPages, 'loadAmrLocations')
            document.getElementById('amrTable').innerHTML = pageItems.length === 0
                ? `<tr><td colspan="13" style="text-align:center;color:var(--t3);padding:32px">No AMR Locations found</td></tr>`
                : pageItems.map(x => `<tr style="font-size:13px;color:var(--text)">
                    <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${x.pointCode ?? '—'}</td>
                    <td style="font-weight:600;color:var(--navy)">${x.displayName ?? '—'}</td>
                    <td><span style="background:var(--blue-lt);color:var(--blue);font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px">${_amrTypeName(x.pointType)}</span></td>
                    <td>${_amrLocationsCell(x.locations)}</td>
                    <td style="text-align:center">${x.capacity ?? '—'}</td>
                    <td>${x.vendor ?? '—'}</td>
                    <td style="font-family:ui-monospace,monospace">${x.externalCode ?? '—'}</td>
                    <td style="font-family:ui-monospace,monospace;white-space:nowrap">${(x.latitude ?? x.longitude) ? `${x.latitude ?? '—'}, ${x.longitude ?? '—'}` : '—'}</td>
                    <td style="text-align:center">${x.accuracy ?? '—'}</td>
                    <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(x.description ?? '')}">${x.description ? escHtml(x.description) : '—'}</td>
                    <td>${_amrBool(x.isAvailable, 'Yes', 'No')}</td>
                    <td>${_amrBool(x.isActive, 'Active', 'Inactive')}</td>
                    <td style="white-space:nowrap">
                        <button onclick="openAmrModal(${JSON.stringify(x).replace(/"/g,'&quot;')})"
                            style="background:none;border:none;cursor:pointer;color:var(--amber);font-size:16px;padding:4px 6px;border-radius:6px" title="Edit">
                            <i class="bi bi-pencil"></i></button>
                        <button onclick="deleteAmrLocation(${x.id})"
                            style="background:none;border:none;cursor:pointer;color:var(--red);font-size:16px;padding:4px 6px;border-radius:6px" title="Delete">
                            <i class="bi bi-trash"></i></button>
                    </td>
                </tr>`).join('')
        } catch (err) {
            console.error('[loadAmrLocations] failed:', err)
            document.getElementById('amrTable').innerHTML =
                `<tr><td colspan="13" style="text-align:center;color:var(--red);padding:32px">Load failed: ${err.message}</td></tr>`
        }
    }

    // ── Location picker (autocomplete: name, code, type) — ใช้กับแถว "+ Add" ใน Assigned Locations ──
    async function initAmrLocationPicker() {
        await loadLocation()
        createLocationAutocomplete({
            inputId:    'amrLocationSearch',
            dropdownId: 'amrLocationDropdown',
            locations:  locations,
            emptyText:  'ไม่พบ Location',
            onSelect: loc => {
                document.getElementById('amrLocationId').value = loc?.id ?? ''
            },
            onClear: () => {
                document.getElementById('amrLocationId').value = ''
            }
        })
    }

    // AMR point ที่กำลังแก้ไขอยู่ตอนนี้ (null ถ้ากำลังสร้างใหม่) + list ของ location ที่ assign ไว้ (in-memory, sync กับ server ทุกครั้งที่ add/remove)
    let _amrEditingId        = null
    let _amrEditingLocations = []

    function resetAmrForm() {
        document.getElementById('amrId').value              = ''
        document.getElementById('amrPointCode').value       = ''
        document.getElementById('amrDisplayName').value     = ''
        document.getElementById('amrPointType').value       = ''
        document.getElementById('amrCapacity').value        = ''
        document.getElementById('amrVendor').value          = ''
        document.getElementById('amrExternalCode').value    = ''
        document.getElementById('amrLatitude').value        = ''
        document.getElementById('amrLongitude').value       = ''
        document.getElementById('amrAccuracy').value        = ''
        document.getElementById('amrDescription').value     = ''
        document.getElementById('amrIsAvailable').checked   = true
        document.getElementById('amrIsActive').checked      = true
        document.getElementById('amrModalTitle').textContent = 'New AMR Location'
        _amrResetAddLocationRow()
        _amrEditingId        = null
        _amrEditingLocations = []
        document.getElementById('amrLocationsSection').style.display = 'none'
        document.getElementById('amrLocationsHint').style.display    = ''
        clearModalError('amrError')
    }

    function _amrResetAddLocationRow() {
        document.getElementById('amrLocationSearch').value = ''
        document.getElementById('amrLocationId').value     = ''
        document.getElementById('amrNewSortOrder').value   = ''
        document.getElementById('amrNewIsDefault').checked = false
    }

    function openAmrModal(x) {
        resetAmrForm()
        document.getElementById('amrModalTitle').textContent    = 'Edit AMR Location'
        document.getElementById('amrId').value                  = x.id
        document.getElementById('amrPointCode').value           = x.pointCode       ?? ''
        document.getElementById('amrDisplayName').value         = x.displayName     ?? ''
        document.getElementById('amrPointType').value           = x.pointType       ?? ''
        document.getElementById('amrCapacity').value            = x.capacity        ?? ''
        document.getElementById('amrVendor').value              = x.vendor          ?? ''
        document.getElementById('amrExternalCode').value        = x.externalCode    ?? ''
        document.getElementById('amrLatitude').value            = x.latitude        ?? ''
        document.getElementById('amrLongitude').value           = x.longitude       ?? ''
        document.getElementById('amrAccuracy').value            = x.accuracy        ?? ''
        document.getElementById('amrDescription').value         = x.description     ?? ''
        document.getElementById('amrIsAvailable').checked       = x.isAvailable !== false
        document.getElementById('amrIsActive').checked          = x.isActive    !== false

        _amrEditingId        = x.id
        _amrEditingLocations = Array.isArray(x.locations) ? [...x.locations] : []
        document.getElementById('amrLocationsSection').style.display = ''
        document.getElementById('amrLocationsHint').style.display    = 'none'
        _amrRenderLocationsList()
        openModal('amrModal')
    }

    // ── Assigned Locations (1 AMR point → หลาย Location) ──────
    function _amrRenderLocationsList() {
        const el = document.getElementById('amrLocationsList')
        if (!_amrEditingLocations.length) {
            el.innerHTML = `<div style="font-size:12px;color:var(--t3);padding:6px 0">ยังไม่มี Location ที่ assign ไว้</div>`
            return
        }
        el.innerHTML = _amrEditingLocations
            .slice()
            .sort((a, b) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0))
            .map(l => `
                <div style="display:flex;align-items:center;gap:8px;padding:7px 10px;border:1px solid var(--border);border-radius:8px;font-size:13px">
                    <span style="font-family:ui-monospace,monospace;font-weight:600;color:var(--navy)">${escHtml(l.locationCode ?? '')}</span>
                    <span style="color:var(--t2)">${escHtml(l.displayName ?? '')}</span>
                    ${l.isDefault ? `<span style="background:var(--green-lt);color:var(--green);font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px">Default</span>` : ''}
                    <span style="color:var(--t3);font-size:11px;margin-left:auto">Sort ${l.sortOrder ?? 0}</span>
                    <button type="button" onclick="amrRemoveLocation(${l.locationId})"
                        style="background:none;border:none;cursor:pointer;color:var(--red);font-size:15px;padding:2px 4px;border-radius:6px" title="Remove">
                        <i class="bi bi-x-circle"></i></button>
                </div>`)
            .join('')
    }

    async function amrAddLocation() {
        if (!_amrEditingId) return
        const locationId = parseInt(document.getElementById('amrLocationId').value)
        if (!locationId) { showModalError('amrError', 'กรุณาเลือก Location ที่จะเพิ่ม'); return }
        if (_amrEditingLocations.some(l => l.locationId === locationId)) {
            showModalError('amrError', 'Location นี้ถูก assign ไว้แล้ว')
            return
        }
        const body = {
            locationId,
            isDefault: document.getElementById('amrNewIsDefault').checked,
            sortOrder: parseInt(document.getElementById('amrNewSortOrder').value) || 0,
        }
        try {
            await api(`/amr-location/${_amrEditingId}/locations`, 'POST', body)
            const loc = _locIdMap.get(locationId)
            _amrEditingLocations.push({
                locationId,
                locationCode: loc?.locationCode ?? '',
                displayName:  loc?.displayName ?? '',
                isDefault:    body.isDefault,
                sortOrder:    body.sortOrder,
            })
            _amrResetAddLocationRow()
            _amrRenderLocationsList()
            clearModalError('amrError')
            loadAmrLocations(1)   // sync ตัวเลขในตารางหลังฉากไปด้วย (ไม่ปิด modal)
        } catch (err) {
            showModalError('amrError', 'เพิ่ม Location ไม่สำเร็จ: ' + err.message)
        }
    }

    async function amrRemoveLocation(locationId) {
        if (!_amrEditingId) return
        if (!confirm('ยกเลิก Location นี้ออกจาก AMR point?')) return
        try {
            await api(`/amr-location/${_amrEditingId}/locations/${locationId}`, 'DELETE')
            _amrEditingLocations = _amrEditingLocations.filter(l => l.locationId !== locationId)
            _amrRenderLocationsList()
            loadAmrLocations(1)
        } catch (err) {
            showModalError('amrError', 'ยกเลิกไม่สำเร็จ: ' + err.message)
        }
    }

    async function saveAmrLocation() {
        const id        = document.getElementById('amrId').value
        const pointCode = document.getElementById('amrPointCode').value.trim()
        if (!pointCode) { showModalError('amrError', 'กรุณากรอก Point Code'); return }
        // POST /amr-location และ PUT /amr-location/{id} ใช้ schema เดียวกันแล้ว (location ไม่ได้ผูกกับ point ตรงๆ อีกต่อไป
        // ต้อง assign ผ่าน /amr-location/{id}/locations แยกต่างหาก — ดู amrAddLocation/amrRemoveLocation)
        const body = {
            pointCode,
            displayName:  document.getElementById('amrDisplayName').value.trim()  || null,
            pointType:    parseInt(document.getElementById('amrPointType').value) || null,
            capacity:     parseInt(document.getElementById('amrCapacity').value)   || null,
            vendor:       document.getElementById('amrVendor').value.trim()        || null,
            externalCode: document.getElementById('amrExternalCode').value.trim()  || null,
            latitude:     parseFloat(document.getElementById('amrLatitude').value) || null,
            longitude:    parseFloat(document.getElementById('amrLongitude').value)|| null,
            accuracy:     parseFloat(document.getElementById('amrAccuracy').value) || null,
            description:  document.getElementById('amrDescription').value.trim()   || null,
            isAvailable:  document.getElementById('amrIsAvailable').checked,
            isActive:     document.getElementById('amrIsActive').checked,
        }
        // ตัด field ที่เป็น null ออกจาก payload ทั้งหมด — backend 400 ถ้าส่ง null ไปสำหรับบาง field (เจอกับ pointType ตอนส่งเป็น string ชื่อผิด type)
        Object.keys(body).forEach(k => { if (body[k] === null) delete body[k] })
        try {
            if (id) {
                console.log('[saveAmrLocation] PUT /amr-location/' + id + ' payload →', body)
                await api(`/amr-location/${id}`, 'PUT', body)
                closeModal('amrModal')
                showToast('บันทึก AMR Location สำเร็จ', 'success')
                loadAmrLocations(1)
            } else {
                console.log('[saveAmrLocation] POST /amr-location payload →', body)
                const res = await api('/amr-location', 'POST', body)
                const newId = res?.data?.id ?? res?.id
                showToast('สร้าง AMR Location สำเร็จ', 'success')
                if (newId) {
                    // ไม่ปิด modal — สลับเป็นโหมด Edit ทันทีเพื่อให้ assign Location ต่อได้เลยโดยไม่ต้องเปิดใหม่
                    document.getElementById('amrId').value = newId
                    document.getElementById('amrModalTitle').textContent = 'Edit AMR Location'
                    _amrEditingId        = newId
                    _amrEditingLocations = []
                    document.getElementById('amrLocationsSection').style.display = ''
                    document.getElementById('amrLocationsHint').style.display    = 'none'
                    _amrRenderLocationsList()
                    loadAmrLocations(1)
                } else {
                    closeModal('amrModal')
                    loadAmrLocations(1)
                }
            }
        } catch (err) {
            console.error('[saveAmrLocation] failed:', err)
            showModalError('amrError', err.message)
        }
    }

    async function deleteAmrLocation(id) {
        if (!confirm('ลบ AMR Location นี้?')) return
        try {
            await api(`/amr-location/${id}`, 'DELETE')
            showToast('ลบสำเร็จ', 'success')
            loadAmrLocations(1)
        } catch (err) { showToast('ลบไม่สำเร็จ: ' + err.message, 'error') }
    }

    async function loadAmrLocType() {
        try {
            const res = await api('/amr-location/point-type', 'GET')
            AmrLocationType = Array.isArray(res) ? res : (res?.data || [])
            renderAmrPointTypeOptions()
            renderAmrTypeFilterOptions()
        } catch (err) { showToast('โหลด AMR Location Type ไม่สำเร็จ: ' + err.message, 'error') }
    }

    function renderAmrPointTypeOptions() {
        const sel = document.getElementById('amrPointType')
        const current = sel.value
        sel.innerHTML = '<option value="">— Select Type —</option>' +
            AmrLocationType.map(t => `<option value="${t.id}">${escHtml(t.name)}</option>`).join('')
        sel.value = current
    }

    // Type filter (ด้านบนตาราง) — ใช้ชื่อจริงจาก /amr-location/point-type แทนเลข id ดิบๆ
    function renderAmrTypeFilterOptions() {
        const sel = document.getElementById('amrTypeFilter')
        const current = sel.value
        sel.innerHTML = '<option value="">All Types</option>' +
            AmrLocationType.map(t => `<option value="${t.id}">${escHtml(t.name)}</option>`).join('')
        sel.value = current
    }

    async function init(){
        await loadAmrLocType()   // ให้ AmrLocationType พร้อมก่อน แล้วค่อยโหลดตาราง กัน pointType id โชว์ค้างก่อนชื่อจริงจะมา
        loadAmrLocations(1)
        initAmrLocationPicker()
    }

    init()
</script>
}
