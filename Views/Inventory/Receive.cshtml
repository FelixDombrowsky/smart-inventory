            pendingScan.delete(data.traceId);
            scannedTrace.add(data.traceId);

            // =========================
            // 🔥 MODE
            // =========================
            if (pageMode === "MOVE") {
            addMoveRow(result);
            }
            else {
            await addOrUpdatePart(
            data.partNo,
            data.qty,
            data.unit,
            data.traceId,
            data.vendor,
            data.dateCode
            );
            }

            showResult(result, true);

            } catch {
            pendingScan.delete(data.traceId); // 🔥 สำคัญมาก
            showResult("Server Error", false)
            }

            } *@

            //=============PasuseScan===================
            function pauseScan(msg) {

            scanPaused = true;

            showResult(msg, false);

            document.getElementById("continueBtn").classList.remove("d-none");
            }





            // ================= HELPERS =================

            function buildRawBarcode(d) {

            return [
            d.partNo,
            d.qty,
            d.unit,
            d.vendor,
            d.dateCode,
            d.tradingCode || "",
            d.po || "",
            d.inventoryNo || "",
            d.traceId
            ].join(" {")
            }

            function parseBarcode(raw) {

            let parts = raw.split("{").map(x => x.trim()).filter(x => x)

            if (parts.length < 9) return null

            return {
            partNo: parts[0],
            qty: parseInt(parts[1]) || 1,
            unit: parts[2],
            vendor: parts[3],
            dateCode: parts[4],
            tradingCode: parts[5],
            po: parts[6],
            inventoryNo: parts[7],
            traceId: parts[8]
            }
            }

            function removeRowByTraceId(traceId) {

            document.querySelectorAll("#receivingTable tr")
            .forEach(r => {
            let t = r.querySelector(".traceId")?.value
            if (t === traceId) {
            r.remove()
            scannedTrace.delete(traceId)
            }
            })
            }

            // ================= TABLE =================

            function removeRow(btn) {

            let row = btn.closest("tr")
            let traceId = row.querySelector(".traceId")?.value

            if (traceId) scannedTrace.delete(traceId)

            row.remove()
            }

            function addManualRow() {

            let user = JSON.parse(localStorage.getItem("user") || "{}");

            const allowedRoles = ["Admin", "Inventory_Admin", "Admin_WH", "Supervisor"];

            if (!allowedRoles.includes(user.role)) {
            showResult("No permission", false);
            return;
            }

            document.getElementById("receivingTable")
            .insertAdjacentHTML("beforeend", `
            <tr>
            <td><input class="form-control partNo"></td>
            <td><input class="form-control desc"></td>
            <td><input class="form-control unit"></td>
            <td><input type="number" class="form-control qty" value="1"></td>
            <td><button class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button></td>
            </tr>`)
            }

            async function addOrUpdatePart(partNo, qty, unit, traceId) {

            let desc = "";
            let finalUnit = unit;

            try {
            let res = await api(`/master/items/${partNo}`, "GET");

            if (res.ok) {
            let data = await res.json();

            desc = data.itemName || "";     // 🔥 mapping
            finalUnit = data.baseUnit || unit;
            }

            } catch {
            console.log("Item not found");
            }

            let isNew = !desc;

            document.getElementById("receivingTable")
            .insertAdjacentHTML("beforeend", `
            <tr>
            <td>${partNo}</td>

            <td>
            <input class="form-control desc ${isNew ? 'border-danger' : ''}"
            value="${desc}"
            placeholder="Enter description">
            </td>

            <td>
            <input class="form-control unit" value="${finalUnit}">
            </td>

            <td>
            <input class="form-control qty" type="number" value="${qty}">
            </td>

            <td style="display:none">
            <input class="traceId" value="${traceId}">
            </td>

            <td>
            <button class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button>
            </td>
            </tr>`);
            }
            // ========================================

            async function searchWO() {

                let text = document.getElementById("woSearch").value;

                if (text.length < 2) {
                    document.getElementById("woDropdown").innerHTML = "";
                    return;
                }

                const res = await api(`/workorder?moNumber=${text}&pageSize=5`, "GET");

                if (!res.ok) return;

                const json = await res.json();

                let html = "";

                (json.data ?? json.Data ?? []).forEach(x => {
                    html += `
                    <a href="#" class="list-group-item list-group-item-action"
                    onclick="selectWO('${x.moNumber}')">
                    ${x.moNumber}
                    </a>`;
                });

                document.getElementById("woDropdown").innerHTML = html;
            }

            // ================= SELECT WO =================
            function selectWO(mo) {

                currentWO = mo;

                document.getElementById("currentWO").innerText = mo;
                document.getElementById("woSearch").value = mo;
                document.getElementById("woDropdown").innerHTML = "";

                loadParts(mo);
                loadLots(mo);
                        }

            // ================= RECEIVE (PART SUMMARY) =================
            async function loadParts(mo) {

                // 🔥 เปลี่ยนเป็น POST
                const res = await api("/inventory/lots", "POST", {
                    workOrder: mo,
                    page: 1,
                    pageSize: 200
                });

                if (!res.ok) {
                    document.getElementById("partSummaryTable").innerHTML =
                        "<tr><td colspan='6'>Error loading data</td></tr>";
                    return;
                }

                const json = await res.json();

                const list = json.data ?? json.Data ?? [];

                let map = {};

                list.forEach(l => {

                    const partNo = l.partNo ?? "";

                    if (!map[partNo]) {
                        map[partNo] = {
                            partNo: partNo,
                            description: l.description ?? "",
                            unit: l.unit ?? "",
                            onHand: 0,
                            reserved: 0,
                            available: 0
                        };
                    }

                    map[partNo].onHand += l.onHandQty ?? 0;
                    map[partNo].reserved += l.reservedQty ?? 0;
                    map[partNo].available += l.available ?? 0;
                });

                let html = "";

                Object.values(map).forEach(p => {

                    html += `
                    <tr>
                        <td>${p.partNo}</td>
                        <td>${p.description}</td>
                        <td>${p.onHand.toLocaleString()}</td>
                        <td>${p.reserved.toLocaleString()}</td>
                        <td>${p.available.toLocaleString()}</td>
                        <td>${p.unit}</td>
                    </tr>`;
                });

                document.getElementById("partSummaryTable").innerHTML = html;
            }
  
            //==================================================
            
            async function loadLots(mo) {

                const res = await api("/inventory/lots", "POST", {
                    workOrder: mo,
                    page: 1,
                    pageSize: 200,
                    desc: true
                });

                const json = await res.json();

                let html = "";

                // 🔥 API ของคุณใช้ Data (ตัวใหญ่)
                (json.data ?? json.Data ?? []).forEach(l => {

                    html += `
                    <tr>
                        <td>${l.lotNo ?? ""}</td>
                        <td>${l.partNo ?? ""}</td>
                        <td>${l.location ?? ""}</td>
                        <td>${l.onHandQty ?? 0}</td>
                        <td>${l.reservedQty ?? 0}</td>
                        <td>${l.available ?? 0}</td>
                    </tr>`;
                });

                document.getElementById("lotTable").innerHTML = html;
            }


            async function receive() {

            let locationCode = document.getElementById("locationSearch").value

            if (!locationCode) {
            showResult("Select Location", false);
            return
            }

            let rows = document.querySelectorAll("#receivingTable tr")

            let items = []

            rows.forEach(r => {

            let partNo = r.children[0].innerText || r.querySelector(".partNo")?.value
            let desc = r.querySelector(".desc")?.value
            let unit = r.querySelector(".unit")?.value
            let qty = parseInt(r.querySelector(".qty")?.value) || 0

            let traceId = r.querySelector(".traceId")?.value || ""
            let vendor = r.querySelector(".vendor")?.value || ""
            let dateCode = r.querySelector(".dateCode")?.value || ""

            if (!partNo || qty <= 0) return

            items.push({
            partNo: partNo,
            description: desc,
            workOrderNo: currentWO,
            locationCode: locationCode,   // ✅ ใช้ code
            quantity: qty,
            unit: unit,
            traceId: traceId,
            vendor: vendor,
            dateCode: dateCode,
            itemType: 1
            })

            })

            if (items.length === 0) {
            showResult("No items", false);
            return
            }

            let res = await api("/inventory/receive", "POST", { items })

            if (res.ok) {

            showResult("Receive completed", true);

            document.getElementById("receivingTable").innerHTML = ""

            loadParts(currentWO)
            loadLots(currentWO)

            }
            else {

            showResult(await res.text(), false);

            }

            }

            // ================= SWITCH CAMERA =================




            let buffer = "";
            let lastTime = Date.now();
            let scanTimer = null;

            document.addEventListener("keydown", function (e) {

            if (currentMode !== "HID") return;
            // ❌ block key พิเศษ
            if (e.key.length > 1) return;

            const now = Date.now();

            // ⏱ ถ้าห่างเกิน → reset (กัน user typing)
            if (now - lastTime > 500) {
            buffer = "";
            }

            lastTime = now;

            buffer += e.key;

            // ⏳ reset timer ทุกครั้งที่มี key ใหม่
            clearTimeout(scanTimer);

            scanTimer = setTimeout(() => {

            if (buffer.length >= 5) { // กัน noise
            scanBarcodeApi(buffer); // 🔥 ยิงเข้า flow เดิมคุณ
            }

            buffer = "";

            }, 80); // 🔥 ปรับได้ (50–120 ms)
            });
            //==================UpdateScanUI===============================
            function updateScanUI() {

            let cameraBtn = document.getElementById("cameraBtn");

            cameraBtn.disabled = currentMode !== "CAMERA";
            }




        </script>

    }