                            <a href="/Inventory/Lots"              class="list-group-item list-group-item-action border-0">Lots</a>
                            <a href="/Inventory/WorkOrders"        class="list-group-item list-group-item-action border-0">WorkOrders</a>
                            <a href="/Inventory/Receive"           class="list-group-item list-group-item-action border-0">Receive</a>
                            <a href="/Inventory/Move"              class="list-group-item list-group-item-action border-0">Move</a>
                            @* <a href="/Inventory/Reserve"           class="list-group-item list-group-item-action border-0">Reserve</a> *@
                            <a href="/Inventory/Transactions"      class="list-group-item list-group-item-action border-0">Transactions</a>
                            <a href="/Inventory/MasterManagement"  class="list-group-item list-group-item-action border-0">Master Management</a>
