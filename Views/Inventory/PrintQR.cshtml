@section Scripts {
<script src="/lib/html5-qrcode/html5-qrcode.min.js"></script>
<script src="/js/api.js"></script>
<script>
    let currentStep = 1
    let qrScanner   = null
    let scannerRunning = false

    // ── 13 Fixed Field Schema ──
    const FIELD_LABELS = {
        partNo:          'P/N',
        quantity:        'QTY',
        unit:            'UNIT',
        vendor:          'VENDOR',
        dateCode:        'D/C',
        tradingCode:     'T/C',
        po:              'PO',
        inventoryNo:     'I/N',
        traceId:         'TRACE ID',
        workOrder:       'W/O',
        line:            'LINE',
        lotNo:           'LOT NO',
        uniqueId:        'UNIQUE ID',
        productionArea:  'AREA',
    }
    const ALL_FIELD_KEYS    = Object.keys(FIELD_LABELS)
    const FIELD_PLACEHOLDERS = {
        tradingCode:  'Trading Code',
        dateCode:     'Date Code',
        inventoryNo:  'Inventory Number',
    }
    const REQUIRED_KEYS     = new Set(['partNo','quantity','unit'])
    const QR_REQUIRED_KEYS  = new Set(['lotNo','uniqueId'])
    function applyPrintOffset(zpl, cfg) {
        const x = cfg?.printOffsetX ?? 100
        const y = cfg?.printOffsetY ?? 0
        if (!x && !y) return zpl
        return zpl.replace(/(\^XA\n?)/, `$1^LH${x},${y}\n`)
    }

    // ── State ──
    let printState = {
        scannedRaw:        '',
        parsedQrData:      {},
        selectedLayoutId:  null,
        activeLayoutFields: null,
        formOverrides:     {},
        layoutSliders:     null,
        previewZpl:        '',
        previewFullData:   null,
        previewImgSrc:     null,
    }

    let _woSearchTimer = null

    // ── Helpers ──
    const cid = k => k.replace(/[^a-zA-Z0-9]/g, '_')
    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    }

    // ISO Z → local display "YYYY-MM-DD HH:mm:ss"
    function fmtCreatedAt(isoZ) {
        if (!isoZ) return ''
        try {
            const d = new Date(isoZ)
            if (isNaN(d)) return isoZ
            const pad = n => String(n).padStart(2,'0')
            return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} ` +
                   `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`
        } catch (_) { return isoZ }
    }

    // ── Toast ──
    function showToast(msg, type) {
        const tc = document.getElementById('toastContainer')
        const t  = document.createElement('div')
        t.className = `sf-toast sf-toast-${type || 'info'}`
        t.textContent = msg
        tc.appendChild(t)
        setTimeout(() => t.remove(), 3200)
    }

    // ── Map API response → 13-field schema ──
    function mapScanResponse(res) {
        return {
            partNo:          res.partNo          ?? '',
            quantity:        String(res.quantity  ?? ''),
            unit:            res.unit             ?? '',
            vendor:          res.vendor           ?? '',
            dateCode:        res.dateCode         ?? '',
            tradingCode:     res.tradingCode      ?? '',
            po:              res.po               ?? '',
            inventoryNo:     res.inventoryNo      ?? '',
            traceId:         res.wH_TraceId       || res.traceId || '',
            workOrder:       res.workOrder        ?? '',
            line:            res.line             ?? '',
            lotNo:           '',
            uniqueId:        res.uniqueId         ?? res.unique_id ?? '',
            productionArea:  res.productionArea   ?? '',
        }
    }

    // ── Scan API ──
    async function callScanAPI(barcode, displayName) {
        setScanStatus('⏳ Checking...', '#1a6fff')
        try {
            const res = await api('/scan', 'POST', { barcode, mode: 0 })
            printState.scannedRaw    = barcode
            printState.parsedQrData  = mapScanResponse(res)
            printState.formOverrides = {}
            await doScan(displayName)
        } catch (err) {
            setScanStatus('❌ ' + (err.message || 'An error occurred'), '#dc2626')
        }
    }

    function setScanStatus(msg, color) {
        const el = document.getElementById('scanStatus')
        el.textContent = msg
        el.style.color = color || 'var(--t2)'
    }

    // ── doScan: after scan success ──
    async function doScan(displayName) {
        await stopScan()
        setScanStatus('✓ Scan successful: ' + displayName, '#059669')
        const d = printState.parsedQrData
        // Banner: Part No. prominent + compact JSON below
        document.getElementById('qrPartNoLabel').textContent = d.partNo || '—'
        const display = Object.fromEntries(Object.entries(d).filter(([, v]) => v !== '' && v !== null && v !== undefined))
        document.getElementById('qrDataLabel').textContent = JSON.stringify(display)
        document.getElementById('fWO').value = d.workOrder || ''
        updateLineBadge(d.line || '')
        renderChecklist(printState.activeLayoutFields)
        goStep(2)
    }

    // ── Stepper ──
    function goStep(n) {
        currentStep = n
        ;[1,2,3].forEach(i => {
            const sc = document.getElementById('sc'+i)
            const sl = document.getElementById('sl'+i)
            sc.className = 'step-circle' + (i < n ? ' done' : i === n ? ' active' : '')
            sl.className = 'step-label'  + (i < n ? ' done' : i === n ? ' active' : '')
            if (i < 3) document.getElementById('line'+i).className = 'step-line' + (i < n ? ' done' : '')
            document.getElementById('step'+i).style.display = i === n ? '' : 'none'
        })
        if (n === 3) renderStep3()
    }

    // ── Camera Scan (html5-qrcode — รองรับ QR Code + Data Matrix + อื่นๆ) ──
    async function startScan() {
        if (scannerRunning) return
        setScanStatus('⏳ Opening camera...', 'var(--t2)')
        try {
            qrScanner = new Html5Qrcode('qrReader')
            await qrScanner.start(
                { facingMode: 'environment' },
                {
                    fps: 15,
                    qrbox: { width: 200, height: 200 },
                    aspectRatio: 1.0,
                },
                (decodedText) => {
                    callScanAPI(decodedText, 'Camera Scan')
                }
            )
            scannerRunning = true
            document.getElementById('scannerIdle').style.display  = 'none'
            document.getElementById('btnStartScan').style.display = 'none'
            document.getElementById('scannerBox').style.display   = ''
            document.getElementById('btnStopScan').style.display  = ''
            document.getElementById('scanLine').style.display     = ''
            setScanStatus('🎥 Scanning…', 'var(--blue)')
        } catch (e) {
            console.error('[startScan] error:', e)
            const msg = e?.message || e?.name || String(e) || 'unknown'
            setScanStatus('❌ [' + msg + ']', 'var(--red)')
        }
    }

    async function stopScan() {
        if (scannerRunning && qrScanner) {
            try { await qrScanner.stop(); qrScanner.clear() } catch (_) {}
        }
        scannerRunning = false
        qrScanner = null
        document.getElementById('scannerBox').style.display   = 'none'
        document.getElementById('scannerIdle').style.display  = ''
        document.getElementById('btnStartScan').style.display = ''
        document.getElementById('btnStopScan').style.display  = 'none'
        document.getElementById('scanLine').style.display     = 'none'
        setScanStatus('', '')
    }

