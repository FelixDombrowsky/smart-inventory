@section Scripts {
<script src="/js/api.js"></script>
<script src="/js/locationTypeMeta.js"></script>
<script src="/js/transactionTypeMeta.js"></script>
<script src="/js/itemTypeMeta.js"></script>
<script>
    let allLots        = []
    let allPartInfo    = {}
    let allSumGroups   = []
    let sumPage = 1,  sumPS = 10
    let allTxRows      = []
    let txPage  = 1,  txPS  = 10

    // ── Confirm Image Lightbox (เหมือนหน้า Transactions.cshtml) ──
    let lbImages = [], lbIndex = 0, lbCaption = ''
    let txImagesMap = {}   // id → { images:[...], caption }

    function openLightbox(images, index, caption) {
        lbImages  = images
        lbIndex   = ((index || 0) % images.length + images.length) % images.length
        lbCaption = caption || ''
        renderLightbox()
        document.getElementById('lightbox').classList.add('show')
    }
    function openLightboxFor(txId, index) {
        const entry = txImagesMap[txId]
        if (!entry || !entry.images.length) return
        openLightbox(entry.images, index, entry.caption)
    }
    function renderLightbox() {
        const multi = lbImages.length > 1
        document.getElementById('lightboxImg').src = lbImages[lbIndex]
        document.getElementById('lightboxCaption').textContent =
            lbCaption + (multi ? ` · ${lbIndex + 1}/${lbImages.length}` : '')
        document.getElementById('lightboxPrev').style.display = multi ? 'flex' : 'none'
        document.getElementById('lightboxNext').style.display = multi ? 'flex' : 'none'
    }
    function lightboxStep(delta) {
        if (lbImages.length < 2) return
        lbIndex = (lbIndex + delta + lbImages.length) % lbImages.length
        renderLightbox()
    }
    function closeLightbox() {
        document.getElementById('lightbox').classList.remove('show')
        document.getElementById('lightboxImg').src = ''
        lbImages = []
    }
    document.addEventListener('keydown', e => {
        if (!document.getElementById('lightbox').classList.contains('show')) return
        if (e.key === 'Escape')    closeLightbox()
        if (e.key === 'ArrowLeft')  lightboxStep(-1)
        if (e.key === 'ArrowRight') lightboxStep(1)
    })
    let allBomItems    = []
    let bomPage = 1,  bomPS = 10
    let lotPage = 1,  lotPS = 10
    let _woPlanQty     = 0
    let _distExpanded      = true
    let _distTypeMap       = {}
    let _distSelectedType  = null
    let _distPartFilter    = new Set()
    let _distPartPending   = new Set()
    let _distPartSearch    = ''
    let _distPartDropOpen  = false
    let _planTargetMode    = 'all'

    // โหลดรายชื่อ Location ทั้งหมดมา cache ครั้งเดียว (ไว้ join locationCode → location object ทั้งตัว เอา displayName/typeName มาใช้)
    let _locNameMap = new Map()
    async function _ensureLocNameMap() {
        try {
            const res = await api('/location?pageSize=500', 'GET')
            const arr = Array.isArray(res) ? res : (res?.data || [])
            arr.forEach(loc => _locNameMap.set(loc.locationCode, loc))
        } catch (_) {}
    }
    function locName(code) {
        if (!code) return '-'
        return _locNameMap.get(code)?.displayName || code
    }
    function locTypeBadgeHtml(type, label) {
        if (!type) return label ?? '-'
        return `<span style="display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;padding:1px 7px;border-radius:4px;${locTypeBadgeStyle(type)}">${locHierTypeIcon(type)}${label ?? type}</span>`
    }
    // badge ชื่อ Location พร้อม icon+สีตาม type — ใช้กับ from/to ที่มีแค่ locationCode (ต้อง join เอา type จาก _locNameMap)
    function locBadgeForCode(code) {
        if (!code) return '-'
        const found = _locNameMap.get(code)
        return locTypeBadgeHtml(found?.typeName ?? found?.type ?? '', found?.displayName || code)
    }

    // ── Generic custom-dropdown engine ใช้ร่วมกันทุก filter dropdown ในไฟล์นี้ ──
    const _ddPairs = [
        ['locationFilterTrigger',    'locationFilterMenu'],
        ['sumItemTypeFilterTrigger', 'sumItemTypeFilterMenu'],
        ['lotLocTypeFilterTrigger',  'lotLocTypeFilterMenu'],
        ['lotItemTypeFilterTrigger', 'lotItemTypeFilterMenu'],
    ]
    function _ddToggle(triggerId, menuId) {
        const menu    = document.getElementById(menuId)
        const trigger = document.getElementById(triggerId)
        if (!menu || !trigger) return
        const opening = menu.style.display === 'none'
        menu.style.display = 'none'
        trigger.classList.remove('open')
        if (opening) {
            const r = trigger.getBoundingClientRect()
            menu.style.left     = r.left + 'px'
            menu.style.top      = (r.bottom + 4) + 'px'
            menu.style.minWidth = r.width + 'px'
            menu.style.display  = ''
            trigger.classList.add('open')
        }
    }
    function _ddCloseAll(exceptMenuId) {
        _ddPairs.forEach(([tId, mId]) => {
            if (mId === exceptMenuId) return
            const menu    = document.getElementById(mId)
            const trigger = document.getElementById(tId)
            if (menu)    menu.style.display = 'none'
            if (trigger) trigger.classList.remove('open')
        })
    }
    window.addEventListener('scroll', e => {
        _ddPairs.forEach(([tId, mId]) => {
            const menu = document.getElementById(mId)
            if (!menu || menu.style.display === 'none') return
            if (menu.contains(e.target)) return // scroll ในตัว dropdown เอง ไม่ต้องปิด
            _ddToggle(tId, mId)
        })
    }, true)
    window.addEventListener('resize', () => {
        _ddPairs.forEach(([tId, mId]) => {
            const menu = document.getElementById(mId)
            if (menu && menu.style.display !== 'none') _ddToggle(tId, mId)
        })
    })
    document.addEventListener('click', e => {
        if (!e.target.closest('.loc-filter-dd-wrap')) _ddCloseAll(null)
    })

    // ── Location Type options: derive จาก _allFlatLots ที่โหลดมาจริง (เหมือน Item Type) ไม่ใช่ดึงทุก type จาก /location/types ──
    function _refreshLocationTypeOptions() {
        const types = [...new Set(_allFlatLots.map(l => l.locationType).filter(Boolean))].sort()
        const buildItems = (pickFn, allLabel) =>
            `<div class="loc-filter-dd-item active" data-val="" onclick="${pickFn}('', '${allLabel}')">${allLabel}</div>` +
            types.map(t => `<div class="loc-filter-dd-item" data-val="${t}" onclick="${pickFn}('${t}', '${t}')">
                ${locHierTypeIcon(t)} <span style="color:${locTypeMeta(t).color};font-weight:600">${t}</span>
            </div>`).join('')
        const menu = document.getElementById('locationFilterMenu')
        if (menu) menu.innerHTML = buildItems('locationFilterDdPick', 'All Locations')
        const lotMenu = document.getElementById('lotLocTypeFilterMenu')
        if (lotMenu) lotMenu.innerHTML = buildItems('lotLocTypeFilterPick', 'Location Type')
    }
    function locationFilterDdToggle() { _ddCloseAll('locationFilterMenu'); _ddToggle('locationFilterTrigger', 'locationFilterMenu') }
    function locationFilterDdPick(val, label) {
        document.getElementById('locationFilter').value = val
        document.getElementById('locationFilterLabel').innerHTML = val
            ? `${locHierTypeIcon(label)} <span style="color:${locTypeMeta(label).color};font-weight:600">${label}</span>`
            : 'All Locations'
        document.querySelectorAll('#locationFilterMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        locationFilterDdToggle()
        applySummaryFilters()
    }

    // ── Location Type filter (Lot Summary tab) — ใช้ option ชุดเดียวกับ Total Summary จาก _refreshLocationTypeOptions() ──
    let _lotLocTypeFilter = ''
    function lotLocTypeFilterDdToggle() { _ddCloseAll('lotLocTypeFilterMenu'); _ddToggle('lotLocTypeFilterTrigger', 'lotLocTypeFilterMenu') }
    function lotLocTypeFilterPick(val, label) {
        _lotLocTypeFilter = val
        document.getElementById('lotLocTypeFilterLabel').innerHTML = val
            ? `${locHierTypeIcon(label)} <span style="color:${locTypeMeta(label).color};font-weight:600">${label}</span>`
            : 'Location Type'
        document.querySelectorAll('#lotLocTypeFilterMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        lotLocTypeFilterDdToggle()
        lotPage = 1
        renderLotsPage()
    }

    // ── Item Type filter (Lot Summary + Total Summary) — สร้าง option จาก itemType ที่มีจริงใน allPartInfo (ไม่ยิง API เพิ่ม) ──
    let _lotItemTypeFilter = ''
    let _sumItemTypeFilter = ''
    function _refreshLotItemTypeOptions() {
        const types = [...new Set(Object.values(allPartInfo).map(p => p.itemType).filter(Boolean))].sort()
        const buildItems = pickFn =>
            `<div class="loc-filter-dd-item active" data-val="" onclick="${pickFn}('', 'Item Type')">All</div>` +
            types.map(t => `<div class="loc-filter-dd-item" data-val="${t}" onclick="${pickFn}('${t}', '${t}')">${itemTypeIcon(t)} <span style="color:${itemTypeMeta(t).color};font-weight:600">${t}</span></div>`).join('')
        const lotMenu = document.getElementById('lotItemTypeFilterMenu')
        if (lotMenu) lotMenu.innerHTML = buildItems('lotItemTypeFilterPick')
        const sumMenu = document.getElementById('sumItemTypeFilterMenu')
        if (sumMenu) sumMenu.innerHTML = buildItems('sumItemTypeFilterPick')
    }
    function lotItemTypeFilterDdToggle() { _ddCloseAll('lotItemTypeFilterMenu'); _ddToggle('lotItemTypeFilterTrigger', 'lotItemTypeFilterMenu') }
    function lotItemTypeFilterPick(val, label) {
        _lotItemTypeFilter = val
        document.getElementById('lotItemTypeFilterLabel').innerHTML = val
            ? `${itemTypeIcon(label)} <span style="color:${itemTypeMeta(label).color};font-weight:600">${label}</span>`
            : 'Item Type'
        document.querySelectorAll('#lotItemTypeFilterMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        lotItemTypeFilterDdToggle()
        lotPage = 1
        renderLotsPage()
    }

    function sumItemTypeFilterDdToggle() { _ddCloseAll('sumItemTypeFilterMenu'); _ddToggle('sumItemTypeFilterTrigger', 'sumItemTypeFilterMenu') }
    function sumItemTypeFilterPick(val, label) {
        _sumItemTypeFilter = val
        document.getElementById('sumItemTypeFilterLabel').innerHTML = val
            ? `${itemTypeIcon(label)} <span style="color:${itemTypeMeta(label).color};font-weight:600">${label}</span>`
            : 'Item Type'
        document.querySelectorAll('#sumItemTypeFilterMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        sumItemTypeFilterDdToggle()
        sumPage = 1
        applySummaryFilters()
    }

    function computePlanTarget() {
        if (_planTargetMode === 'all') return _woPlanQty
        // Only current: sum planQty for parts that have lots AND pass part filter
        const partsWithLots = new Set(allLots.map(l => l.partNo).filter(Boolean))
        const activeFilter  = _distPartFilter.size > 0 ? _distPartFilter : partsWithLots
        let total = 0
        allBomItems.forEach(item => {
            if (partsWithLots.has(item.partNo) && activeFilter.has(item.partNo)) {
                total += Number(item.planQty || 0)
            }
        })
        return total || 1
    }

    function setPlanTargetMode(mode) {
        _planTargetMode = mode
        buildDistributionChart()
    }

    const _groupLotsMap      = {}   // key → lots array (set on render)
    const _printStatusCache  = {}   // lotNo → { status, errorMessage }

    function getMo() {
        return new URL(window.location.href).searchParams.get("mo")
    }

    function fmt(n) { return (n || 0).toLocaleString() }

    function fmtShort(n) {
        n = Number(n) || 0
        const abs = Math.abs(n)
        if (abs >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M'
        if (abs >= 1000)    return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K'
        return n % 1 === 0 ? String(n) : n.toFixed(3).replace(/\.?0+$/, '')
    }

    // ── Distribution Chart ──
    function buildDistributionChart() {
        _distTypeMap = {}
        const src = _distPartFilter.size > 0
            ? allLots.filter(l => _distPartFilter.has(l.partNo))
            : allLots
        src.forEach(l => {
            const type = (l.locationType || 'Unknown').trim()
            _distTypeMap[type] = (_distTypeMap[type] || 0) + Number(l.onHandQty || 0)
        })
        renderDistributionChart(computePlanTarget(), _distTypeMap)
        _updateDistPartDropLabel()
    }

    function toggleDistPartDrop() {
        _distPartDropOpen = !_distPartDropOpen
        const dd  = document.getElementById('distPartDropdown')
        const btn = document.getElementById('distPartDropBtn')
        const chv = document.getElementById('distPartDropChevron')
        if (!dd) return
        if (_distPartDropOpen) {
            // position using fixed coords from button rect
            if (btn) {
                const r = btn.getBoundingClientRect()
                dd.style.top   = (r.bottom + 6) + 'px'
                dd.style.right = (window.innerWidth - r.right) + 'px'
                dd.style.left  = 'auto'
            }
            _distPartPending = new Set(_distPartFilter)
            _distPartSearch  = ''
            const inp = document.getElementById('distPartSearchInput')
            if (inp) inp.value = ''
            _renderDistPartList()
            dd.style.display = 'block'
            if (chv) chv.style.transform = 'rotate(180deg)'
            document.getElementById('distPartSearchInput')?.focus()
        } else {
            dd.style.display = 'none'
            if (chv) chv.style.transform = ''
        }
    }

    function _renderDistPartList() {
        const list = document.getElementById('distPartList')
        if (!list) return
        const allParts = [...new Set(allLots.map(l => l.partNo).filter(Boolean))].sort()
        const q        = _distPartSearch.toLowerCase()
        const filtered = q ? allParts.filter(p => p.toLowerCase().includes(q)) : allParts
        if (filtered.length === 0) {
            list.innerHTML = '<div style="padding:12px;text-align:center;color:var(--t3);font-size:12px">No parts found</div>'
            return
        }
        list.innerHTML = filtered.map(p => {
            const checked = _distPartPending.size === 0 || _distPartPending.has(p)
            const info    = allPartInfo[p] || {}
            const desc    = info.description
                ? (info.description.length > 26 ? info.description.substring(0, 26) + '…' : info.description)
                : ''
            const ps = p.replace(/'/g, "\\'")
            return `
            <div style="display:flex;align-items:center;gap:0;padding:5px 8px;border-radius:7px;transition:.1s"
                 onmouseover="this.style.background='#f4f5f7';this.querySelector('.only-btn').style.opacity='1'"
                 onmouseout="this.style.background='';this.querySelector('.only-btn').style.opacity='0'">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;flex:1;min-width:0"
                       onclick="event.preventDefault();event.stopPropagation();toggleDistPartPending('${ps}')">
                    <input type="checkbox" ${checked ? 'checked' : ''} style="width:14px;height:14px;accent-color:var(--blue);flex-shrink:0;pointer-events:none">
                    <div style="min-width:0">
                        <div style="font-family:ui-monospace,monospace;font-size:11px;font-weight:700;color:var(--navy);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${p}</div>
                        ${desc ? `<div style="font-size:10px;color:var(--t3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${desc}</div>` : ''}
                    </div>
                </label>
                <button class="only-btn" onclick="event.stopPropagation();onlyDistPartPending('${ps}')"
                        style="flex-shrink:0;padding:2px 7px;border:1px solid var(--blue);border-radius:5px;background:var(--blue-lt);color:var(--blue);font-size:10px;font-weight:700;cursor:pointer;font-family:inherit;opacity:0;transition:opacity .15s;margin-left:6px">
                    Only
                </button>
            </div>`
        }).join('')
    }

    function _updateDistPartDropLabel() {
        const lbl = document.getElementById('distPartDropLabel')
        if (!lbl) return
        const total = new Set(allLots.map(l => l.partNo).filter(Boolean)).size
        lbl.textContent = _distPartFilter.size === 0
            ? 'All Parts'
            : `${_distPartFilter.size} of ${total} parts`
        const btn = document.getElementById('distPartDropBtn')
        if (btn) btn.style.borderColor = _distPartFilter.size > 0 ? 'var(--blue)' : 'var(--border)'
        if (btn) btn.style.color       = _distPartFilter.size > 0 ? 'var(--blue)' : 'var(--text)'
    }

    function toggleDistPartPending(partNo) {
        const allParts = new Set(allLots.map(l => l.partNo).filter(Boolean))
        if (_distPartPending.size === 0) {
            allParts.forEach(p => { if (p !== partNo) _distPartPending.add(p) })
        } else if (_distPartPending.has(partNo)) {
            _distPartPending.delete(partNo)
        } else {
            _distPartPending.add(partNo)
            if (_distPartPending.size === allParts.size) _distPartPending = new Set()
        }
        _renderDistPartList()
    }

    function onlyDistPartPending(partNo) {
        _distPartPending = new Set([partNo])
        _renderDistPartList()
    }

    function distPartApply() {
        _distPartFilter   = new Set(_distPartPending)
        _distPartDropOpen = false
        const dd  = document.getElementById('distPartDropdown')
        const chv = document.getElementById('distPartDropChevron')
        if (dd)  dd.style.display = 'none'
        if (chv) chv.style.transform = ''
        buildDistributionChart()
    }

    function distPartSelectAll() {
        _distPartPending = new Set()
        _renderDistPartList()
    }

    function distPartClearAll() {
        _distPartPending = new Set()
        _renderDistPartList()
    }

    function distPartSearchChange(q) {
        _distPartSearch = q
        _renderDistPartList()
    }

    // close dropdown on outside click — discard pending, do NOT apply
    document.addEventListener('click', e => {
        if (_distPartDropOpen && !document.getElementById('distPartDropWrap')?.contains(e.target)) {
            _distPartDropOpen = false
            const dd  = document.getElementById('distPartDropdown')
            const chv = document.getElementById('distPartDropChevron')
            if (dd)  dd.style.display = 'none'
            if (chv) chv.style.transform = ''
            // pending discarded — chart unchanged
        }
    })
    // close dropdown เมื่อ scroll หน้าเพจ (position:fixed ไม่ขยับตามปุ่ม ถ้าไม่ปิดจะดูเหมือนลอยตามจอ) — scroll ในตัว dropdown เองไม่ปิด
    window.addEventListener('scroll', e => {
        if (!_distPartDropOpen) return
        const dd = document.getElementById('distPartDropdown')
        if (dd && dd.contains(e.target)) return
        _distPartDropOpen = false
        const chv = document.getElementById('distPartDropChevron')
        if (dd)  dd.style.display = 'none'
        if (chv) chv.style.transform = ''
    }, true)

    function toggleDistExpand() {
        _distExpanded = !_distExpanded
        if (!_distExpanded) _distSelectedType = null
        renderDistributionChart(computePlanTarget(), _distTypeMap)
    }

    function selectDistType(typeName) {
        _distSelectedType = _distSelectedType === typeName ? null : typeName
        renderDistributionChart(computePlanTarget(), _distTypeMap)
    }

    function showDistLocTip(e, lbl, val, pct) {
        let tip = document.getElementById('_distLocTip')
        if (!tip) {
            tip = document.createElement('div')
            tip.id = '_distLocTip'
            tip.style.cssText = 'position:fixed;background:#0f172a;color:#fff;padding:6px 12px;border-radius:8px;font-size:12px;font-weight:600;pointer-events:none;z-index:9999;white-space:nowrap;box-shadow:0 4px 14px rgba(0,0,0,.22);line-height:1.5'
            document.body.appendChild(tip)
        }
        const colors = { OH: '#1a6fff', RS: '#d97706', AV: '#059669' }
        const c = colors[lbl] || '#fff'
        tip.innerHTML = `<span style="color:${c}">${lbl}</span>&nbsp;&nbsp;${Number(val).toLocaleString()}&nbsp;<span style="color:#94a3b8;font-size:11px;font-weight:400">(${pct}%)</span>`
        tip.style.left    = (e.clientX + 14) + 'px'
        tip.style.top     = (e.clientY - 38) + 'px'
        tip.style.display = 'block'
    }

    function hideDistLocTip() {
        const tip = document.getElementById('_distLocTip')
        if (tip) tip.style.display = 'none'
    }

    // Inventory Distribution Chart
    function renderDistributionChart(target, typeMap) {
        const wrap = document.getElementById('distChartWrap')
        if (!wrap) return
        const entries     = Object.entries(typeMap).sort((a, b) => b[1] - a[1])
        const totalOnHand = entries.reduce((s, [, v]) => s + v, 0)
        if (target <= 0 && totalOnHand === 0) {
            wrap.innerHTML = '<p style="text-align:center;color:var(--t3);padding:36px 0;font-size:13px">No data available</p>'
            return
        }
        const CHART_H  = 144
        const scaleBase = target > 0 ? target : Math.max(totalOnHand, 1)

        // ใช้สีเดียวกับ locationTypeMeta.js (ตัวเดียวกับ badge ในตาราง/dropdown ทั่วแอป) แทน palette วน index เดิม
        const typeColorMap = {}
        entries.forEach(([type]) => { typeColorMap[type] = locTypeMeta(type).color })

        function makeBar({ label, value, isTarget, color, barStyle, onClickFn, selected }) {
            const h         = Math.round(Math.min(value / scaleBase, 1) * CHART_H)
            const pct       = target > 0 ? (value / target * 100) : 0
            const pctStr    = isTarget ? '100%' : (pct < 0.1 && pct > 0 ? '<0.1%' : pct.toFixed(1) + '%')
            const vc        = isTarget ? 'var(--t2)' : color
            const dimmed    = selected === false && _distSelectedType !== null
            const ring      = selected === true ? `box-shadow:0 0 0 2.5px ${color},0 6px 18px ${color}40` : ''
            const labelClr  = selected === true ? color : 'var(--t3)'
            const labelWt   = selected === true ? '700' : '400'
            return `
            <div style="display:flex;flex-direction:column;align-items:center;flex:1;min-width:60px;max-width:120px;${onClickFn ? 'cursor:pointer' : ''}"
                 ${onClickFn ? `onclick="${onClickFn}"` : ''}>
                <div style="font-size:11px;font-weight:700;color:${vc};margin-bottom:8px;text-align:center;white-space:nowrap;opacity:${dimmed ? '.35' : '1'};transition:opacity .2s">${fmtShort(value)}</div>
                <div style="width:100%;height:${CHART_H}px;display:flex;align-items:flex-end;justify-content:center">
                    <div class="dist-bar"
                         style="width:clamp(28px,55%,52px);height:0;border-radius:7px 7px 2px 2px;${barStyle};${ring};opacity:${dimmed ? '.25' : '1'};transition:height .65s cubic-bezier(.34,1.3,.64,1),opacity .2s,box-shadow .2s"
                         data-h="${h}"></div>
                </div>
                <div style="height:1px;width:100%;background:var(--border);margin-bottom:10px;opacity:${dimmed ? '.35' : '1'};transition:opacity .2s"></div>
                <div style="text-align:center;padding:0 2px;opacity:${dimmed ? '.35' : '1'};transition:opacity .2s">
                    <div style="font-size:12px;font-weight:700;color:${vc}">${pctStr}</div>
                    <div style="font-size:10px;color:${labelClr};font-weight:${labelWt};margin-top:3px;line-height:1.3">${label}</div>
                </div>
            </div>`
        }

        function makeLocationGroupBar({ label, oh, rs, av }) {
            const hOH = Math.round(Math.min(oh / scaleBase, 1) * CHART_H)
            const hRS = Math.round(Math.min(rs / scaleBase, 1) * CHART_H)
            const hAV = Math.round(Math.min(av / scaleBase, 1) * CHART_H)
            const pOH = scaleBase > 0 ? (oh / scaleBase * 100).toFixed(1) : '0.0'
            const pRS = scaleBase > 0 ? (rs / scaleBase * 100).toFixed(1) : '0.0'
            const pAV = scaleBase > 0 ? (av / scaleBase * 100).toFixed(1) : '0.0'
            const mkBar = (h, color, val, pct, lbl) =>
                `<div class="dist-bar" data-h="${h}"
                     style="width:13px;height:0;border-radius:4px 4px 2px 2px;background:${color};cursor:default"
                     onmouseenter="showDistLocTip(event,'${lbl}',${val},${pct})"
                     onmouseleave="hideDistLocTip()"></div>`
            return `
            <div style="display:flex;flex-direction:column;align-items:center;flex:1;min-width:56px;max-width:100px">
                <div style="font-size:10px;font-weight:700;color:var(--navy);margin-bottom:8px;text-align:center;white-space:nowrap">${fmtShort(oh)}</div>
                <div style="width:100%;height:${CHART_H}px;display:flex;align-items:flex-end;justify-content:center;gap:4px">
                    ${mkBar(hOH,'var(--blue)',oh,pOH,'OH')}
                    ${mkBar(hRS,'var(--amber)',rs,pRS,'RS')}
                    ${mkBar(hAV,'var(--green)',av,pAV,'AV')}
                </div>
                <div style="height:1px;width:100%;background:var(--border);margin-bottom:10px"></div>
                <div style="text-align:center">
                    <div style="display:flex;gap:5px;justify-content:center;font-size:9px;font-weight:700;margin-bottom:3px">
                        <span style="color:var(--blue)">OH</span>
                        <span style="color:var(--amber)">RS</span>
                        <span style="color:var(--green)">AV</span>
                    </div>
                    <div style="font-size:10px;color:var(--t2);font-weight:600;line-height:1.3">${label}</div>
                </div>
            </div>`
        }

        const SEP       = `<div style="width:1px;background:var(--border);margin:0 6px 62px;align-self:flex-end"></div>`
        const SEP_THICK = `<div style="width:2px;background:#94a3b8;margin:0 10px 62px;align-self:flex-end;border-radius:1px"></div>`

        let barsHtml = makeBar({
            label: 'Plan Target', value: target, isTarget: true,
            barStyle: 'border:2px dashed var(--t3);background:rgba(15,23,42,.06);box-sizing:border-box'
        })

        if (!_distExpanded) {
            barsHtml += SEP
            barsHtml += makeBar({
                label: 'Total On Hand', value: totalOnHand, isTarget: false,
                color: 'var(--blue)', barStyle: 'background:var(--blue)',
                onClickFn: 'toggleDistExpand()'
            })
        } else {
            barsHtml += SEP
            barsHtml += makeBar({
                label: 'Total On Hand', value: totalOnHand, isTarget: false,
                color: '#475569', barStyle: 'background:#475569'
            })
            barsHtml += SEP_THICK
            const singleFocus = _distPartFilter.size === 1 && _distSelectedType !== null
            entries.forEach(([type, qty], i) => {
                // Hide dimmed bars when 1 part is focused on a specific type
                if (singleFocus && type !== _distSelectedType) return
                const c   = typeColorMap[type]
                const sel = _distSelectedType === null ? undefined : (_distSelectedType === type)
                barsHtml += makeBar({
                    label: type, value: qty, isTarget: false, color: c,
                    barStyle: `background:${c}`, selected: sel,
                    onClickFn: `selectDistType('${type.replace(/'/g, "\\'")}')`
                })
                // 1 part selected + this type is focused → show location breakdown inline
                if (singleFocus && _distSelectedType === type) {
                    const selectedPart = [..._distPartFilter][0]
                    const locMap = {}
                    allLots.filter(l =>
                        l.partNo === selectedPart &&
                        (l.locationType || 'Unknown').trim() === type
                    ).forEach(l => {
                        const loc = l.location || 'Unknown'
                        if (!locMap[loc]) locMap[loc] = { oh: 0, rs: 0, av: 0 }
                        locMap[loc].oh += Number(l.onHandQty   || 0)
                        locMap[loc].rs += Number(l.reservedQty || 0)
                        locMap[loc].av += Number(l.available   || 0)
                    })
                    Object.entries(locMap).sort((a, b) => b[1].oh - a[1].oh).forEach(([loc, vals]) => {
                        barsHtml += SEP
                        barsHtml += makeLocationGroupBar({ label: locName(loc), ...vals })
                    })
                }
                if (!singleFocus && i < entries.length - 1) barsHtml += SEP
            })
        }

        // ── Drill-down detail panel ──
        let detailHtml = ''
        if (_distExpanded && _distSelectedType && typeMap[_distSelectedType] !== undefined) {
            const selColor = typeColorMap[_distSelectedType] || 'var(--blue)'
            const selTotal = typeMap[_distSelectedType] || 0
            const typeLots = allLots.filter(l =>
                (l.locationType || 'Unknown').trim() === _distSelectedType &&
                (_distPartFilter.size === 0 || _distPartFilter.has(l.partNo))
            )
            const partMap  = {}
            typeLots.forEach(l => {
                const p = l.partNo || 'Unknown'
                partMap[p] = (partMap[p] || 0) + Number(l.onHandQty || 0)
            })
            const partEntries = Object.entries(partMap).sort((a, b) => b[1] - a[1]).slice(0, 15)
            const maxPQty     = partEntries[0]?.[1] || 1
            const uniqueLocs  = [...new Set(typeLots.map(l => l.location).filter(Boolean))]

            const partRows = partEntries.map(([part, qty]) => {
                const barW = Math.round((qty / maxPQty) * 100)
                const pct  = selTotal > 0 ? (qty / selTotal * 100) : 0
                const info = allPartInfo[part] || {}
                const desc = info.description
                    ? (info.description.length > 48 ? info.description.substring(0, 48) + '…' : info.description)
                    : ''
                return `
                <div style="display:grid;grid-template-columns:130px 1fr 88px;align-items:center;gap:14px;padding:7px 0;border-bottom:1px solid #f4f5f7">
                    <div style="min-width:0">
                        <div style="display:flex;align-items:center;gap:5px;min-width:0">
                            <span title="${info.itemType || ''}" style="flex-shrink:0;display:inline-flex">${itemTypeIcon(info.itemType, 12)}</span>
                            <span style="font-family:ui-monospace,monospace;font-size:11px;font-weight:700;color:var(--navy);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0" title="${part}">${part}</span>
                        </div>
                        ${desc ? `<div style="font-size:10px;color:var(--t3);margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${desc}</div>` : ''}
                    </div>
                    <div>
                        <div style="background:#f0f2f5;border-radius:99px;height:7px;overflow:hidden">
                            <div class="dist-detail-bar" style="width:0%;height:100%;background:${selColor};border-radius:99px;transition:width .55s ease" data-w="${barW}"></div>
                        </div>
                    </div>
                    <div style="text-align:right">
                        <div style="font-size:12px;font-weight:700;color:var(--navy)">${fmt(qty)}</div>
                        <div style="font-size:10px;color:var(--t3)">${pct.toFixed(1)}%</div>
                    </div>
                </div>`
            }).join('')

            detailHtml = `
            <div style="margin-top:18px;padding:16px 20px;background:#fafbfc;border-radius:12px;border:1px solid var(--border)">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">
                    <div style="display:flex;align-items:center;gap:7px">
                        <div style="width:10px;height:10px;border-radius:3px;background:${selColor};flex-shrink:0"></div>
                        <span style="font-size:13px;font-weight:700;color:var(--navy)">${_distSelectedType}</span>
                    </div>
                    <span style="color:var(--border)">|</span>
                    <span style="font-size:12px;color:var(--t2)">${fmtShort(selTotal)} on hand</span>
                    <span style="color:var(--border)">|</span>
                    <span style="font-size:12px;color:var(--t2)">${partEntries.length} parts</span>
                    <span style="color:var(--border)">|</span>
                    <span style="font-size:12px;color:var(--t2)">${typeLots.length} lots</span>
                    <span style="color:var(--border)">|</span>
                    <span style="font-size:12px;color:var(--t2)">${uniqueLocs.length} location${uniqueLocs.length !== 1 ? 's' : ''}</span>
                </div>
                <div style="display:grid;grid-template-columns:130px 1fr 88px;gap:14px;padding:0 0 6px;border-bottom:1.5px solid var(--border);margin-bottom:2px">
                    <div style="font-size:10px;font-weight:700;color:var(--t3);letter-spacing:.05em;text-transform:uppercase">Part No.</div>
                    <div style="font-size:10px;font-weight:700;color:var(--t3);letter-spacing:.05em;text-transform:uppercase">Distribution</div>
                    <div style="font-size:10px;font-weight:700;color:var(--t3);letter-spacing:.05em;text-transform:uppercase;text-align:right">On Hand</div>
                </div>
                ${partRows || '<div style="text-align:center;color:var(--t3);padding:16px 0">No parts found</div>'}
            </div>`
        }

        const collapseBtn = _distExpanded ? `
        <div style="margin-top:12px;text-align:center">
            <button onclick="toggleDistExpand()"
                    style="padding:3px 12px;border:1px solid var(--border);border-radius:7px;background:transparent;color:var(--t2);font-size:10px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s"
                    onmouseover="this.style.borderColor='var(--blue)';this.style.color='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--t2)'">
                ▲ Collapse
            </button>
        </div>` : ''

        wrap.innerHTML = `
        <div>
            <div style="display:flex;align-items:flex-end;gap:0">${barsHtml}</div>
            ${detailHtml}
            ${collapseBtn}
        </div>`

        const legend = document.getElementById('distChartLegend')
        if (legend) legend.textContent = _distExpanded
            ? entries.length + ' location type' + (entries.length !== 1 ? 's' : '')
            : 'vs On Hand'

        requestAnimationFrame(() => requestAnimationFrame(() => {
            wrap.querySelectorAll('.dist-bar').forEach(el => { el.style.height = el.dataset.h + 'px' })
            wrap.querySelectorAll('.dist-detail-bar').forEach(el => { el.style.width = el.dataset.w + '%' })
        }))
    }

    // ── Load WO Detail (header info + BOM items) ──
    async function loadWODetail() {
        const mo = getMo()
        try {
            const detail = await api(`/workorder/${encodeURIComponent(mo)}/detail`, 'GET')

            const statusColor = detail.status === 1 ? '#10b981' : '#9ca3af'
            const statusLabel = detail.status === 1 ? 'Active' : (detail.status === 2 ? 'Closed' : (detail.status || ''))
            document.getElementById("moTitle").innerHTML =
                `MO : ${mo}&nbsp;·&nbsp;${detail.modelName || ''}&nbsp;·&nbsp;${detail.lineName || ''}&nbsp;·&nbsp;<span style="color:${statusColor};font-weight:700">${statusLabel}</span>`

            allBomItems = detail.items || []
            _woPlanQty = detail.totalPlanQty || 0
            buildDistributionChart()
            document.getElementById("bomCount").textContent = (detail.totalBomItems || allBomItems.length) + ' parts'
            document.getElementById("bomTotalRequired").textContent = fmt(detail.totalPlanQty)
            document.getElementById("bomTotalConsumed").textContent = fmt(detail.totalConsumedQty)

            const totalReq  = detail.totalPlanQty      || 0
            const totalCons = detail.totalConsumedQty  || 0
            const overallPct = totalReq > 0 ? Math.round((totalCons / totalReq) * 100) : 0
            const barColor   = overallPct >= 100 ? 'var(--green)' : overallPct >= 50 ? 'var(--amber)' : 'var(--red)'
            document.getElementById("dashBomPct").textContent      = overallPct + '%'
            document.getElementById("dashBomPct").style.color      = barColor
            document.getElementById("dashBomBar").style.width      = Math.min(overallPct, 100) + '%'
            document.getElementById("dashBomBar").style.background = barColor
            document.getElementById("dashBomConsumed").textContent = 'consumed ' + fmt(totalCons)
            document.getElementById("dashBomRequired").textContent = 'planned ' + fmt(totalReq)

            bomPage = 1
            renderBomPage()
        } catch (err) {
            console.error("loadWODetail:", err)
            document.getElementById("moTitle").textContent = `MO : ${getMo()}`
        }
    }

    function renderBomPage() {
        const nonZeroOnly = document.getElementById("bomFilterNonZero").checked
        const partQ       = (document.getElementById("bomSearchPart")?.value || '').trim().toLowerCase()
        const filtered    = allBomItems.filter(x =>
            (!nonZeroOnly || (x.planQty || 0) !== 0) &&
            (!partQ       || (x.partNo || '').toLowerCase().includes(partQ))
        )
        const total = filtered.length
        const tp    = Math.max(1, Math.ceil(total / bomPS))
        bomPage     = Math.min(bomPage, tp)
        const start = (bomPage - 1) * bomPS
        const slice = filtered.slice(start, start + bomPS)

        const partOnHand = {}
        allLots.forEach(l => {
            if (l.partNo) partOnHand[l.partNo] = (partOnHand[l.partNo] || 0) + Number(l.onHandQty || 0)
        })

        const html = slice.map((x, i) => {
            const required  = x.planQty      || 0
            const consumed  = x.consumedQty  || 0
            const remaining = x.remainingQty || (required - consumed)
            const onHand    = partOnHand[x.partNo] || 0
            let remColor = 'var(--text)'
            if (remaining <= 0 && required > 0)               remColor = 'var(--green)'
            else if (remaining > 0 && remaining < required)   remColor = 'var(--amber)'
            else if (remaining < 0)                           remColor = 'var(--red)'

            const pct      = required > 0 ? Math.round((consumed / required) * 100) : 0
            const barW     = Math.min(pct, 100)
            const barColor = pct >= 100 ? 'var(--green)' : pct >= 50 ? 'var(--amber)' : 'var(--red)'

            return `<tr>
                <td style="color:var(--t3);font-size:12px">${start + i + 1}</td>
                <td><span class="mono">${x.partNo || '-'}</span></td>
                <td style="color:var(--navy);font-size:13px;font-weight:500">${x.itemName || '-'}</td>
                <td style="font-weight:600">${fmt(x.planQty)}</td>
                <td style="font-weight:600;color:${onHand > 0 ? 'var(--green)' : 'var(--t3)'}">${onHand > 0 ? fmt(onHand) : '—'}</td>
                <td style="min-width:130px">${(() => {
                    const p  = required > 0 ? onHand / required * 100 : 0
                    const bw = Math.min(p, 100)
                    const bc = p >= 100 ? 'var(--green)' : p >= 50 ? 'var(--amber)' : 'var(--red)'
                    return required > 0 ? `
                    <div style="display:flex;align-items:center;gap:7px">
                        <div style="flex:1;background:#f0f2f5;border-radius:99px;height:7px;overflow:hidden">
                            <div style="width:${bw}%;height:100%;background:${bc};border-radius:99px;transition:width .4s"></div>
                        </div>
                        <span style="font-size:11px;font-weight:700;color:${bc};min-width:42px;text-align:right">${p.toFixed(1)}%</span>
                    </div>` : '<span style="color:var(--t3)">—</span>'
                })()}</td>
                
                <td style="font-weight:600;color:${consumed > 0 ? 'var(--amber)' : 'var(--t3)'}">${fmt(consumed)}</td>
                <td style="font-weight:700;color:${remColor}">${fmt(remaining)}</td>
                <td style="color:var(--t2);font-size:12px">${x.unit || x.baseUnit || '-'}</td>
                <td style="min-width:130px">
                    <div style="display:flex;align-items:center;gap:7px">
                        <div style="flex:1;background:#f0f2f5;border-radius:99px;height:7px;overflow:hidden">
                            <div style="width:${barW}%;height:100%;background:${barColor};border-radius:99px;transition:width .4s"></div>
                        </div>
                        <span style="font-size:11px;font-weight:700;color:${barColor};min-width:36px;text-align:right">${pct}%</span>
                    </div>
                </td>
            </tr>`
        }).join('')

        document.getElementById("bomTable").innerHTML = html ||
            `<tr><td colspan="10" style="text-align:center;color:var(--t3);padding:32px">No BOM items</td></tr>`

        document.getElementById("bomCount").textContent   = total + ' parts'
        document.getElementById("bomPrev").disabled       = bomPage <= 1
        document.getElementById("bomNext").disabled       = bomPage >= tp
        document.getElementById("bomPageNum").textContent = `${bomPage} / ${tp}`
        document.getElementById("bomPagInfo").textContent =
            total ? `Showing ${start + 1}–${Math.min(start + bomPS, total)} of ${total}` : "0 items"
    }

    function bomPrevPage() { if (bomPage > 1) { bomPage--; renderBomPage() } }
    function bomNextPage() {
        const nonZeroOnly = document.getElementById("bomFilterNonZero").checked
        const partQ       = (document.getElementById("bomSearchPart")?.value || '').trim().toLowerCase()
        const filtered    = allBomItems.filter(x =>
            (!nonZeroOnly || (x.planQty || 0) !== 0) &&
            (!partQ       || (x.partNo || '').toLowerCase().includes(partQ))
        )
        if (bomPage < Math.ceil(filtered.length / bomPS)) { bomPage++; renderBomPage() }
    }
    function bomChangePS() { bomPS = +document.getElementById("bomPageSize").value; bomPage = 1; renderBomPage() }

    // ── Load Stock Summary (item info + lot detail ในตัวเดียว) → render stat cards + expandable summary ──
    // รวม loadPartInfo()/loadLots() เดิม (2 endpoint, paginate ตาม lot 24+ หน้า) เป็นยิง get-stock-summary
    // ตัวเดียว (paginate ตาม item น้อยกว่ามาก) แล้ว flatten lotDetails[] เก็บไว้ที่ _allFlatLots
    // ส่วน Location Type filter กรองฝั่ง frontend ล้วนๆ (ข้อมูลครบอยู่แล้ว) ไม่ต้องยิง API ใหม่ทุกครั้งที่เปลี่ยน filter
    let _allFlatLots = []
    async function loadLots() {
        const mo   = getMo()
        const body = { workOrder: mo, page: 1, pageSize: 50, desc: true }

        const first      = await api("/inventory/get-stock-summary", "POST", body)
        let items        = first.data || []
        const totalPages = first.totalPages || 1

        if (totalPages > 1) {
            const pageNums = Array.from({ length: totalPages - 1 }, (_, i) => i + 2)
            const rest = await Promise.all(
                pageNums.map(p => api("/inventory/get-stock-summary", "POST", { ...body, page: p }))
            )
            rest.forEach(r => { items = items.concat(r.data || []) })
        }

        allPartInfo  = {}
        _allFlatLots = []
        items.forEach(x => {
            allPartInfo[x.itemPartNo] = {
                imagePath:   x.imagePath   || null,
                description: x.description || "-",
                itemType:    x.itemType    || null,
                unit:        x.unit        || null
            }
            ;(x.lotDetails || []).forEach(ld => {
                _allFlatLots.push({
                    lotNo:          ld.lotNo,
                    partNo:         x.itemPartNo,
                    location:       ld.locationCode,
                    locationType:   ld.locationType,
                    onHandQty:      ld.onHandQty,
                    reservedQty:    ld.reservedQty,
                    consumedQty:    ld.consumedQty,
                    available:      ld.available,
                    locationId:     ld.locationId,
                    locationTypeId: ld.locationTypeId,
                    status:         ld.status,
                    packageNo:      ld.packageNo
                })
            })
        })

        _refreshLotItemTypeOptions()
        _refreshLocationTypeOptions()
        applySummaryFilters()
    }

    // เปลี่ยน Location Type filter → กรองจาก _allFlatLots ที่โหลดไว้แล้ว ไม่ยิง API ใหม่
    // กรอง _allFlatLots ตาม Location Type + Item Type พร้อมกัน → ใช้ผลลัพธ์เดียวกันทั้ง stat card, กราฟ distribution, และตาราง Total Summary
    function applySummaryFilters() {
        const locationType = document.getElementById("locationFilter")?.value
        let filtered = locationType ? _allFlatLots.filter(l => l.locationType === locationType) : _allFlatLots
        if (_sumItemTypeFilter) {
            filtered = filtered.filter(l => allPartInfo[l.partNo]?.itemType === _sumItemTypeFilter)
        }
        allLots = filtered

        // Stat cards
        let totalOnHand = 0, totalReserved = 0, totalAvailable = 0
        allLots.forEach(x => {
            totalOnHand    += Number(x.onHandQty   || 0)
            totalReserved  += Number(x.reservedQty || 0)
            totalAvailable += Number(x.available   || 0)
        })
        document.getElementById("dashOnHand").textContent    = fmt(totalOnHand)
        document.getElementById("dashReserved").textContent  = fmt(totalReserved)
        document.getElementById("dashAvailable").textContent = fmt(totalAvailable)
        document.getElementById("dashLots").textContent      = fmt(allLots.length)

        buildDistributionChart()
        renderSummary()
    }

    // ── Render expandable summary (with pagination) ──
    function renderSummary() {
        const map = {}
        allLots.forEach(l => {
            const part = l.partNo || "UNKNOWN"
            if (!map[part]) map[part] = { partNo: part, onHand: 0, reserved: 0, available: 0, lots: [], locSet: new Set() }
            map[part].onHand    += Number(l.onHandQty   || 0)
            map[part].reserved  += Number(l.reservedQty || 0)
            map[part].available += Number(l.available   || 0)
            map[part].lots.push(l)
            map[part].locSet.add(l.location || 'UNKNOWN')
        })
        allSumGroups = Object.values(map).sort((a, b) => a.partNo.localeCompare(b.partNo))
        allSumGroups.forEach(g => { g.locations = [...g.locSet]; delete g.locSet })
        sumPage = 1
        renderSumPage()
    }

    function renderSumPage() {
        // allSumGroups ถูกกรองตาม Location Type + Item Type มาแล้วตั้งแต่ applySummaryFilters() → renderSummary()
        const total = allSumGroups.length
        document.getElementById("summaryCount").textContent = total + " items"
        const tp    = Math.max(1, Math.ceil(total / sumPS))
        sumPage     = Math.min(sumPage, tp)
        const start = (sumPage - 1) * sumPS
        const slice = allSumGroups.slice(start, start + sumPS)

        let html = ""
        slice.forEach((s, i) => {
            const globalIdx = start + i
            const availPct    = s.onHand > 0 ? Math.min(100, (s.available / s.onHand) * 100) : 0
            const reservedPct = s.onHand > 0 ? Math.min(100 - availPct, (s.reserved / s.onHand) * 100) : 0
            const avCls = availPct >= 30 ? "num-ok" : "num-bad"
            const key   = "grp_" + globalIdx
            _groupLotsMap[key] = s.lots
            const info  = allPartInfo[s.partNo] || {}
            const imgSrc = info.imagePath ? (CONFIG.INVENTORY_API + info.imagePath) : '/images/no-image.png'
            const desc   = info.description || '-'

            const locBadges = s.locations.slice(0, 2).map(loc => {
                const lot = s.lots.find(l => (l.location||'UNKNOWN') === loc)
                return locTypeBadgeHtml(lot?.locationType, locName(loc))
            }).join('')
            const moreLocBadge = s.locations.length > 2
                ? `<span style="font-size:10px;color:var(--t2);font-weight:600">+${s.locations.length - 2} more</span>` : ''

            html += `
            <tr class="sum-row" onclick="toggleExpand('${key}')">
                <td><button class="expand-btn" id="btn_${key}">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
                </button></td>
                <td>
                    <div style="display:flex;align-items:center;gap:10px">
                        <img src="${imgSrc}" style="width:42px;height:42px;object-fit:cover;border-radius:8px;border:1px solid var(--border);flex-shrink:0">
                        <div style="min-width:0">
                            <div style="display:flex;align-items:center;gap:6px">
                                <span class="mono" style="font-size:13px;line-height:1.3">${s.partNo}</span>
                                ${itemTypeBadge(info.itemType)}
                            </div>
                            <div style="font-size:11.5px;color:var(--t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px" title="${desc}">${desc}</div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="stock-bar"><div class="stock-bar-seg avail" style="width:${availPct}%"></div><div class="stock-bar-seg reserved" style="width:${reservedPct}%"></div></div>
                    <div class="stock-bar-nums">
                        <span class="${avCls}">${fmt(s.available)}</span> avail
                        <span class="stock-sep">·</span>
                        <span style="color:var(--amber);font-weight:700">${fmt(s.reserved)}</span> rsv
                        <span class="stock-sep">·</span>
                        <span style="color:var(--t2)">${fmt(s.onHand)}</span> on hand
                    </div>
                </td>
                <td>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;align-items:center">
                        ${locBadges}${moreLocBadge}
                    </div>
                </td>
                <td>
                    <span class="lots-count-badge">${s.lots.length} lot${s.lots.length === 1 ? '' : 's'}</span>
                </td>
            </tr>
            <tr class="sub-row">
                <td colspan="5">
                    <div class="sub-content" id="${key}">
                        <div class="sub-inner">
                            ${(() => {
                                // จัดกลุ่ม lot ตาม location เดียวกัน — ลดการพิมพ์ Location/Type ซ้ำทุกแถว เห็นภาพรวมต่อจุดง่ายขึ้น
                                const byLoc = {}
                                s.lots.forEach(l => {
                                    const loc = l.location || 'UNKNOWN'
                                    if (!byLoc[loc]) byLoc[loc] = []
                                    byLoc[loc].push(l)
                                })
                                return Object.entries(byLoc).map(([loc, lots]) => {
                                    const subOnHand = lots.reduce((sum, l) => sum + Number(l.onHandQty || 0), 0)
                                    return `
                                    <div class="loc-group">
                                        <div class="loc-group-head">
                                            ${locTypeBadgeHtml(lots[0]?.locationType, locName(loc))}
                                            <span class="loc-group-qty">${fmt(subOnHand)} on hand · ${lots.length} lot${lots.length === 1 ? '' : 's'}</span>
                                        </div>
                                        <table class="sub-table">
                                            <thead><tr>
                                                <th>Lot No.</th><th>On Hand</th><th>Reserved</th><th>Available</th><th>Print Status</th>
                                            </tr></thead>
                                            <tbody>
                                                ${lots.map(l => {
                                                    const lAvPct  = (l.onHandQty||0) > 0 ? ((l.available||0)/(l.onHandQty||0)*100) : 0
                                                    const avStyle = lAvPct >= 30 ? 'color:var(--green);font-weight:700' : 'color:var(--red);font-weight:700'
                                                    const psId    = 'ps_' + (l.lotNo||'').replace(/[^a-zA-Z0-9]/g,'_')
                                                    const cached  = _printStatusCache[l.lotNo]
                                                    return `<tr>
                                                        <td><span class="lot-badge">${l.lotNo}</span></td>
                                                        <td>${fmt(l.onHandQty)}</td>
                                                        <td style="color:var(--amber)">${fmt(l.reservedQty)}</td>
                                                        <td style="${avStyle}">${fmt(l.available)}</td>
                                                        <td id="${psId}">${cached ? _psBadgeHtml(cached) : '<span style="color:var(--t3);font-size:11px">⏳</span>'}</td>
                                                    </tr>`
                                                }).join('')}
                                            </tbody>
                                        </table>
                                    </div>`
                                }).join('')
                            })()}
                        </div>
                    </div>
                </td>
            </tr>`
        })

        document.getElementById("summaryTable").innerHTML = html ||
            `<tr><td colspan="5" style="text-align:center;color:var(--t3);padding:32px">No lots found</td></tr>`

        document.getElementById("sumPrev").disabled    = sumPage <= 1
        document.getElementById("sumNext").disabled    = sumPage >= tp
        document.getElementById("sumPageNum").textContent  = `${sumPage} / ${tp}`
        document.getElementById("sumPagInfo").textContent  =
            total ? `Showing ${start+1}–${Math.min(start+sumPS, total)} of ${total}` : "0 items"
    }

    function sumPrevPage()  { if (sumPage > 1) { sumPage--; renderSumPage() } }
    function sumNextPage()  { if (sumPage < Math.ceil(allSumGroups.length/sumPS)) { sumPage++; renderSumPage() } }
    function sumChangePS()  { sumPS = +document.getElementById("sumPageSize").value; sumPage = 1; renderSumPage() }

    function toggleExpand(key) {
        const content = document.getElementById(key)
        const btn     = document.getElementById("btn_" + key)
        const isOpen  = content.classList.contains("expanded")
        content.classList.toggle("expanded", !isOpen)
        btn.classList.toggle("open", !isOpen)
        if (!isOpen) loadLotPrintStatuses(_groupLotsMap[key] || [])
    }

    // ── Load Transactions (with pagination loop) ──
    async function loadTransactions() {
        const mo   = getMo()
        const body = { workOrder: mo, page: 1, pageSize: 50, sortBy: "createdAt", desc: true }

        // Page 1
        const first      = await api("/transaction/get", "POST", body)
        let rows         = first.data || []
        const totalPages = first.totalPages || 1

        // ถ้ามีหน้าต่อไป ดึงพร้อมกัน
        if (totalPages > 1) {
            const pageNums = Array.from({ length: totalPages - 1 }, (_, i) => i + 2)
            const rest = await Promise.all(
                pageNums.map(p => api("/transaction/get", "POST", { ...body, page: p }))
            )
            rest.forEach(r => { rows = rows.concat(r.data || []) })
        }

        allTxRows = rows
        txPage    = 1
        renderTxPage()
    }

    function renderTxPage() {
        const total = allTxRows.length
        const tp    = Math.max(1, Math.ceil(total / txPS))
        txPage      = Math.min(txPage, tp)
        const start = (txPage - 1) * txPS
        const slice = allTxRows.slice(start, start + txPS)

        const html = slice.map(x => {
            // ── Confirm Image (thumbnail แรก + badge จำนวนรูปที่เหลือ, กดเพื่อเปิด lightbox carousel) ──
            const confirmImages = (x.images || []).map(im => CONFIG.INVENTORY_API + im.imageUrl)
            txImagesMap[x.id] = {
                images: confirmImages,
                caption: `Lot: ${x.lotNo ?? ''} · ${x.performedBy ?? ''} · ${new Date(x.createdAt).toLocaleString("th-TH")}`
            }
            const confirmCell = confirmImages.length
                ? `<div class="thumb-wrap">
                       <img src="${confirmImages[0]}" class="proof-thumb" onclick="openLightboxFor(${x.id}, 0)"
                            onerror="this.closest('.thumb-wrap').innerHTML='<span class=no-photo>—</span>'">
                       ${confirmImages.length > 1 ? `<span class="thumb-badge">+${confirmImages.length - 1}</span>` : ''}
                   </div>`
                : `<span class="no-photo">—</span>`

            return `<tr>
            <td>${txTypeBadge(x.transactionType)}</td>
            <td><span class="mono">${x.itemPartNo || "-"}</span></td>
            <td><span class="lot-badge">${x.lotNo || "-"}</span></td>
            <td style="font-weight:600">${x.quantity || 0}</td>
            <td>${locBadgeForCode(x.fromLocation)}</td>
            <td>${locBadgeForCode(x.toLocation)}</td>
            <td style="color:var(--navy);font-weight:500">${x.performedBy || "-"}</td>
            <td style="text-align:center">${confirmCell}</td>
            <td style="color:var(--t3);font-size:12px">${new Date(x.createdAt).toLocaleString("th-TH")}</td>
        </tr>`
        }).join("")

        document.getElementById("transactionTable").innerHTML = html ||
            `<tr><td colspan="9" style="text-align:center;color:var(--t3);padding:32px">No transactions found</td></tr>`

        document.getElementById("txCount").textContent        = total + " records"
        document.getElementById("txPrev").disabled            = txPage <= 1
        document.getElementById("txNext").disabled            = txPage >= tp
        document.getElementById("txPageNum").textContent      = `${txPage} / ${tp}`
        document.getElementById("txPagInfo").textContent      =
            total ? `Showing ${start+1}–${Math.min(start+txPS, total)} of ${total}` : "0 records"
    }

    function txPrevPage() { if (txPage > 1) { txPage--; renderTxPage() } }
    function txNextPage() { if (txPage < Math.ceil(allTxRows.length/txPS)) { txPage++; renderTxPage() } }
    function txChangePS() { txPS = +document.getElementById("txPageSize").value; txPage = 1; renderTxPage() }

    function _psBadgeHtml(d) {
        if (d.status === 'success')
            return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:var(--green-lt);color:var(--green)">✓ Success</span>`
        if (d.status === 'failed') {
            const tip = d.errorMessage ? ` title="${(d.errorMessage).replace(/"/g,'&quot;')}"` : ''
            return `<span${tip} style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:var(--red-lt);color:var(--red);${d.errorMessage?'cursor:help':''}">✗ Failed</span>`
        }
        return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:#f0f2f5;color:#6b7280">— Not Printed</span>`
    }

    async function loadLotPrintStatuses(lots, prefix = 'ps_') {
        if (!lots.length) return
        const psId = l => prefix + (l.lotNo||'').replace(/[^a-zA-Z0-9]/g,'_')
        const uncached = lots.filter(l => l.lotNo && !(l.lotNo in _printStatusCache))

        // show loading spinner for uncached lots
        uncached.forEach(l => {
            const el = document.getElementById(psId(l))
            if (el) el.innerHTML = '<span style="color:var(--t3);font-size:11px">⏳</span>'
        })

        // fetch all uncached in parallel
        await Promise.all(uncached.map(async l => {
            try {
                const res = await api(`/printer/histories/${encodeURIComponent(l.lotNo)}`, 'GET')
                _printStatusCache[l.lotNo] = { status: res.success ? 'success' : 'failed', errorMessage: res.errorMessage || '' }
            } catch {
                _printStatusCache[l.lotNo] = { status: 'none' }
            }
        }))

        // update DOM for all lots (including already-cached ones)
        lots.forEach(l => {
            if (!l.lotNo) return
            const el = document.getElementById(psId(l))
            const d  = _printStatusCache[l.lotNo]
            if (el && d) el.innerHTML = _psBadgeHtml(d)
        })
    }

    function switchWoTab(name, el) {
        document.querySelectorAll('.wo-tab-pane').forEach(p => p.classList.remove('active'))
        document.querySelectorAll('.wo-tab').forEach(b => b.classList.remove('active'))
        document.getElementById('wotab-' + name).classList.add('active')
        el.classList.add('active')
        if (name === 'lots') renderLotsPage()
    }

    function renderLotsPage() {
        const partQ = (document.getElementById('lotSearchPart')?.value || '').trim().toLowerCase()
        // filter จาก _allFlatLots ตรงๆ (ไม่ใช่ allLots) — แท็บนี้มี filter ของตัวเอง แยกจาก Total Summary
        const filtered = _allFlatLots.filter(l =>
            (!partQ              || (l.partNo || '').toLowerCase().includes(partQ)) &&
            (!_lotLocTypeFilter  || l.locationType === _lotLocTypeFilter) &&
            (!_lotItemTypeFilter || allPartInfo[l.partNo]?.itemType === _lotItemTypeFilter)
        )
        const total    = filtered.length
        const tp       = Math.max(1, Math.ceil(total / lotPS))
        lotPage        = Math.min(lotPage, tp)
        const start    = (lotPage - 1) * lotPS
        const slice    = filtered.slice(start, start + lotPS)

        document.getElementById('lotCount').textContent = total + ' lots'

        const html = slice.map(l => {
            const lAvPct  = (l.onHandQty||0) > 0 ? ((l.available||0)/(l.onHandQty||0)*100) : 0
            const avStyle = lAvPct >= 30 ? 'color:var(--green);font-weight:700' : 'color:var(--red);font-weight:700'
            const psId    = 'lps_' + (l.lotNo||'').replace(/[^a-zA-Z0-9]/g,'_')
            const cached  = _printStatusCache[l.lotNo]
            return `<tr>
                <td><span class="lot-badge">${l.lotNo||'-'}</span></td>
                <td><span class="mono">${l.partNo||'-'}</span></td>
                <td>${itemTypeBadge(allPartInfo[l.partNo]?.itemType)}</td>
                <td style="font-size:13px;color:var(--navy)">${locName(l.location)}</td>
                <td>${locTypeBadgeHtml(l.locationType)}</td>
                <td style="font-weight:600">${fmt(l.onHandQty)}</td>
                <td style="color:var(--amber)">${fmt(l.reservedQty)}</td>
                <td style="${avStyle}">${fmt(l.available)}</td>
                <td id="${psId}">${cached ? _psBadgeHtml(cached) : '<span style="color:var(--t3);font-size:11px">—</span>'}</td>
            </tr>`
        }).join('')

        document.getElementById('lotTable').innerHTML = html ||
            `<tr><td colspan="9" style="text-align:center;color:var(--t3);padding:32px">No lots found</td></tr>`

        document.getElementById('lotPrev').disabled       = lotPage <= 1
        document.getElementById('lotNext').disabled       = lotPage >= tp
        document.getElementById('lotPageNum').textContent = `${lotPage} / ${tp}`
        document.getElementById('lotPagInfo').textContent =
            total ? `Showing ${start+1}–${Math.min(start+lotPS,total)} of ${total}` : '0 lots'

        loadLotPrintStatuses(slice, 'lps_')
    }

    function lotPrevPage() { if (lotPage > 1) { lotPage--; renderLotsPage() } }
    function lotNextPage() { lotPage++; renderLotsPage() }
    function lotChangePS() { lotPS = +document.getElementById('lotPageSize').value; lotPage = 1; renderLotsPage() }

    // รอ _locNameMap โหลดเสร็จก่อน แล้วค่อยเริ่ม loader ตัวอื่นที่ render โดยใช้ locName()/locBadgeForCode()
    // (กัน race condition: ถ้าปล่อยยิงพร้อมกันแบบเดิม loadLots()/loadTransactions() อาจ render ก่อน
    //  _locNameMap จะมีข้อมูล ทำให้ขึ้น code ค้างตลอดเพราะไม่มี re-render ซ้ำหลังโหลดเสร็จ)
    async function _initWorkOrderLots() {
        await _ensureLocNameMap()
        loadWODetail()
        loadLots()
        loadTransactions()
    }
    _initWorkOrderLots()
</script>
}
