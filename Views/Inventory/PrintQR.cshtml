@{
    ViewData["Title"] = "Print QR";
}

<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --card:#fff;
    --green:#059669; --green-lt:#ecfdf5;
    --amber:#d97706; --amber-lt:#fffbeb;
    --red:#dc2626; --red-lt:#fef2f2;
}

/* ── PAGE HEADER ── */
.page-header {
    background:linear-gradient(135deg,var(--navy) 0%,#1e3a6e 60%,#1a6fff 100%);
    border-radius:16px; padding:20px 28px; margin-bottom:22px;
    display:flex; align-items:center; justify-content:space-between;
    position:relative; overflow:hidden;
}
.page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04); }
.page-header h2 { font-size:22px; font-weight:700; color:#fff; margin-bottom:4px; }
.page-header p  { font-size:13px; color:rgba(255,255,255,.65); margin:0; }

/* ── TAB PILLS ── */
.tab-pills { display:flex; gap:6px; margin-bottom:20px; background:#f0f2f5; border-radius:12px; padding:5px; width:fit-content; }
.tab-pill  { padding:8px 22px; border-radius:9px; font-size:13px; font-weight:600; border:none; cursor:pointer; background:transparent; color:var(--t2); transition:.15s; font-family:inherit; }
.tab-pill.active { background:#fff; color:var(--blue); box-shadow:0 1px 4px rgba(0,0,0,.08); }
.tab-pane { display:none; }
.tab-pane.active { display:block; }

/* ── STEPPER ── */
.stepper { display:flex; align-items:center; gap:0; margin-bottom:28px; }
.step { display:flex; align-items:center; gap:8px; }
.step-circle {
    width:32px; height:32px; border-radius:50%; border:2px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    font-size:13px; font-weight:700; color:var(--t2); background:#fff;
    transition:.3s; flex-shrink:0;
}
.step-circle.done   { background:var(--green); border-color:var(--green); color:#fff; }
.step-circle.active { background:var(--blue);  border-color:var(--blue);  color:#fff; }
.step-label { font-size:13px; font-weight:600; color:var(--t2); transition:.3s; white-space:nowrap; }
.step-label.active { color:var(--blue); }
.step-label.done   { color:var(--green); }
.step-line { flex:1; height:2px; background:var(--border); margin:0 10px; min-width:40px; transition:.3s; }
.step-line.done { background:var(--green); }

/* ── CARD ── */
.card {
    background:#fff; border:1px solid var(--border); border-radius:14px;
    box-shadow:0 1px 4px rgba(0,0,0,.04); overflow:hidden;
}
.card-body { padding:24px; }

/* ── QR SCANNER ── */
.scanner-wrap {
    display:flex; flex-direction:column; align-items:center; padding:40px 20px; gap:16px;
}
.scanner-box {
    width:240px; height:240px; border:3px solid var(--blue); border-radius:16px;
    position:relative; overflow:hidden; background:#000;
}
/* ── html5-qrcode internal overrides ── */
#qrReader video { width:100% !important; height:100% !important; object-fit:cover; }
#qrReader img   { display:none !important; }
#qrReader > div:first-child { padding:0 !important; border:none !important; }
#qrReader__scan_region { width:100% !important; height:100% !important; }
#qrReader__dashboard { display:none !important; }
.scanner-box video { width:100%; height:100%; object-fit:cover; border-radius:13px; }
.scan-line {
    position:absolute; left:10px; right:10px; height:2px;
    background:#f44336;
    top:20px;
    animation:scanAnim 2s ease-in-out infinite;
    box-shadow:0 0 8px rgba(244,67,54,.7);
    border-radius:1px;
}
@@keyframes scanAnim {
    0%   { top:20px; }
    50%  { top:170px; }
    100% { top:20px; }
}
.scanner-idle {
    display:flex; flex-direction:column; align-items:center; gap:10px; color:var(--t3);
}
.scanner-idle svg { opacity:.35; }
.scanner-hint { font-size:13px; color:var(--t2); text-align:center; }

/* ── QR DATA BANNER ── */
.qr-banner {
    display:flex; align-items:center; gap:10px; padding:12px 16px;
    background:var(--blue-lt); border:1px solid #93c5fd; border-radius:10px;
    font-size:13px; font-weight:600; color:var(--blue); margin-bottom:20px;
}

/* ── FORM GRID ── */
.form-2col { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.form-group { margin-bottom:16px; }
.form-label { font-size:12px; font-weight:600; color:var(--t2); margin-bottom:5px; display:flex; align-items:center; gap:4px; }
.req { color:var(--red); }
.form-input, .form-select {
    width:100%; padding:10px 12px; border:1.5px solid var(--border); border-radius:9px;
    font-size:14px; font-family:inherit; color:var(--text); outline:none;
    transition:border-color .15s; box-sizing:border-box; background:#fff;
}
.form-input:focus, .form-select:focus { border-color:var(--blue); }
.form-input:disabled { background:#f8f9fc; color:var(--t2); }

.section-box {
    border:1px solid var(--border); border-radius:10px; padding:16px; margin-bottom:16px;
}
.section-box-title { font-size:11px; font-weight:700; color:var(--t2); letter-spacing:.06em; text-transform:uppercase; margin-bottom:12px; }

/* ── BTN ── */
.btn-primary   { padding:10px 24px; background:var(--blue); color:#fff; border:none; border-radius:9px; font-size:13px; font-weight:700; cursor:pointer; font-family:inherit; transition:.15s; }
.btn-primary:hover { background:var(--blue-dk); }
.btn-secondary { padding:10px 20px; background:#f0f2f5; color:var(--t2); border:1px solid var(--border); border-radius:9px; font-size:13px; font-weight:600; cursor:pointer; font-family:inherit; transition:.15s; }
.btn-secondary:hover { background:#e5e7eb; color:var(--text); }
.btn-outline   { padding:8px 16px; border:1.5px solid var(--blue); color:var(--blue); background:var(--blue-lt); border-radius:8px; font-size:12px; font-weight:700; cursor:pointer; font-family:inherit; transition:.15s; }
.btn-outline:hover { background:var(--blue); color:#fff; }
.btn-row { display:flex; gap:10px; margin-top:20px; }

/* ── PREVIEW LAYOUT ── */
.preview-layout { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:20px; }

/* ── SUB TABS ── */
.sub-tabs { display:flex; border-bottom:2px solid var(--border); margin-bottom:16px; }
.sub-tab { padding:8px 18px; font-size:13px; font-weight:600; color:var(--t2); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; transition:.15s; }
.sub-tab.active { color:var(--blue); border-bottom-color:var(--blue); }

/* ── LABEL PREVIEW BOX ── */
.label-preview-box {
    background:#f8f9fc; border:1px solid var(--border); border-radius:10px;
    min-height:220px; display:flex; align-items:center; justify-content:center;
    padding:16px; position:relative;
}
.label-mock {
    background:#fff; border:1px solid #ccc; border-radius:4px; padding:12px;
    display:flex; gap:12px; align-items:flex-start; font-size:11px; max-width:360px;
}
.label-mock-qr {
    width:80px; height:80px; background:#f0f2f5; border-radius:4px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; color:var(--t3); font-size:10px;
}
.label-mock-fields { flex:1; }
.label-mock-row { display:flex; gap:6px; margin-bottom:4px; font-size:10px; }
.label-mock-key { color:var(--t2); font-weight:600; min-width:70px; }
.label-mock-val { color:var(--navy); font-weight:700; word-break:break-all; }
.label-empty-hint { color:var(--t3); font-size:13px; text-align:center; }

/* ── FIELD CHECKLIST ── */
.field-list { display:flex; flex-direction:column; gap:8px; }
.field-item {
    display:flex; align-items:center; gap:10px; padding:10px 12px;
    border:1.5px solid var(--border); border-radius:8px; transition:.15s; cursor:pointer;
}
.field-item input[type=checkbox] { accent-color:var(--blue); width:16px; height:16px; cursor:pointer; flex-shrink:0; }
.field-name { font-size:13px; font-weight:700; color:var(--navy); min-width:80px; }
.field-token { font-family:ui-monospace,monospace; font-size:11px; color:var(--blue); background:var(--blue-lt); padding:2px 6px; border-radius:4px; }
.field-val { font-size:12px; color:var(--t2); margin-left:auto; }
.req-star { color:var(--red); font-size:10px; }
.field-val-input {
    margin-left:auto; width:130px; padding:4px 8px; font-size:12px; font-family:inherit;
    border:1.5px solid var(--border); border-radius:6px; outline:none; color:var(--text);
    transition:border-color .15s;
}
.field-val-input:focus { border-color:var(--blue); }

/* ── CODE BOX ── */
.code-box { background:#0f172a; color:#7dd3fc; border-radius:10px; padding:16px; font-family:ui-monospace,monospace; font-size:12px; line-height:1.7; overflow-x:auto; white-space:pre-wrap; word-break:break-all; }

/* ── SLIDERS ── */
.slider-row { margin-bottom:12px; }
.slider-row:last-child { margin-bottom:0; }
input[type=range] { flex:1; accent-color:var(--blue); height:4px; border-radius:2px; }
.slider-val-input {
    width:48px; padding:3px 4px; border:1.5px solid var(--border); border-radius:6px;
    font-size:12px; font-weight:700; color:var(--navy); text-align:center;
    font-family:inherit; outline:none; background:#fff; flex-shrink:0;
}
.slider-val-input:focus { border-color:var(--blue); }
.slider-val-input::-webkit-inner-spin-button,
.slider-val-input::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
.slider-val-input[type=number] { -moz-appearance:textfield; }

/* ── LAYOUT LIST ── */
.layout-item {
    background:#fff; border:1px solid var(--border); border-radius:12px;
    padding:14px 16px; display:flex; align-items:center; gap:14px; margin-bottom:10px;
}
.layout-item-icon { width:40px; height:40px; border-radius:10px; background:var(--blue-lt); display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
.layout-item-info { flex:1; }
.layout-item-name { font-size:14px; font-weight:700; color:var(--navy); }
.layout-item-meta { font-size:12px; color:var(--t2); margin-top:2px; }

/* ── DS FIELD ROW ── */
.ds-field-row {
    display:flex; align-items:center; gap:10px; padding:10px 12px;
    border:1px solid var(--border); border-radius:8px;
}
.ds-field-row:has(input:checked) { border-color:var(--blue-lt); background:#fafbff; }
.ds-field-cb { width:16px; height:16px; accent-color:var(--blue); cursor:pointer; flex-shrink:0; }
.ds-field-label { font-size:13px; font-weight:700; color:var(--navy); min-width:90px; }
.ds-field-label-input { font-size:13px; font-weight:700; color:var(--navy); border:none; background:transparent; outline:none; min-width:90px; }
.ds-field-token { font-family:ui-monospace,monospace; font-size:11px; color:var(--blue); margin-left:auto; }
.ds-field-pencil { background:none; border:none; cursor:pointer; color:var(--amber); font-size:14px; padding:2px 6px; }

/* ── DESIGN TAB ── */
.design-grid { display:grid; grid-template-columns:280px 1fr; gap:20px; }
.settings-card { background:#fff; border:1px solid var(--border); border-radius:14px; overflow:hidden; }
.settings-head { padding:14px 18px; border-bottom:1px solid var(--border); font-size:13px; font-weight:700; color:var(--navy); }
.settings-body { padding:18px; }
.design-canvas { background:#f8f9fc; border:2px dashed var(--border); border-radius:12px; min-height:380px; display:flex; align-items:center; justify-content:center; }

/* ── WO AUTOCOMPLETE ── */
.wo-autocomplete { position:relative; }
.wo-dropdown {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:200;
    background:#fff; border:1.5px solid var(--blue); border-radius:9px;
    box-shadow:0 4px 16px rgba(0,0,0,.12); max-height:200px; overflow-y:auto;
}
.wo-item { padding:10px 14px; font-size:13px; cursor:pointer; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; }
.wo-item:last-child { border-bottom:none; }
.wo-item:hover { background:var(--blue-lt); }
.wo-item-line { font-size:11px; color:var(--t2); font-weight:600; }

/* ── PRINTER SECTION ── */
.printer-section { margin-top:20px; padding:16px 18px; background:#f8f9fc; border:1px solid var(--border); border-radius:10px; display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
.printer-section label { font-size:12px; font-weight:700; color:var(--t2); white-space:nowrap; }
.printer-section select { flex:1; min-width:200px; padding:9px 12px; border:1.5px solid var(--border); border-radius:8px; font-size:13px; font-family:inherit; color:var(--text); outline:none; background:#fff; }
.printer-section select:focus { border-color:var(--blue); }
.qty-wrap { display:flex; align-items:center; gap:8px; }
.qty-wrap label { white-space:nowrap; }
.qty-input { width:64px; padding:9px 10px; border:1.5px solid var(--border); border-radius:8px; font-size:13px; font-family:inherit; text-align:center; outline:none; }
.qty-input:focus { border-color:var(--blue); }

/* ── TOAST ── */
.toast-container { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.toast { padding:11px 18px; border-radius:10px; font-size:13px; font-weight:600; color:#fff; box-shadow:0 4px 16px rgba(0,0,0,.18); animation:toastIn .25s ease; }
.toast.toast-success { background:var(--green); }
.toast.toast-error   { background:var(--red); }
.toast.toast-info    { background:var(--blue); }
@@keyframes toastIn { from { opacity:0; transform:translateX(30px); } to { opacity:1; transform:none; } }

/* ── PRINT CONFIRM MODAL ── */
.print-modal-overlay {
    position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:8000;
    display:flex; align-items:center; justify-content:center;
    animation:fadeOverlay .2s ease;
}
@@keyframes fadeOverlay { from { opacity:0; } to { opacity:1; } }
.print-modal {
    background:#fff; border-radius:20px; padding:32px 28px 24px;
    width:320px; max-width:90vw; box-shadow:0 20px 60px rgba(0,0,0,.18);
    position:relative; text-align:center;
    animation:slideModal .25s cubic-bezier(.34,1.56,.64,1);
}
@@keyframes slideModal { from { opacity:0; transform:translateY(24px) scale(.96); } to { opacity:1; transform:none; } }
.print-modal-close {
    position:absolute; top:14px; right:16px; background:none; border:none;
    font-size:18px; color:var(--t3); cursor:pointer; line-height:1; padding:4px;
}
.print-modal-close:hover { color:var(--text); }
.print-modal-icon { font-size:44px; margin-bottom:10px; }
.print-modal-title { font-size:18px; font-weight:800; color:var(--navy); margin-bottom:6px; }
.print-modal-printer {
    display:inline-flex; align-items:center; gap:6px; font-size:13px;
    color:var(--t2); background:#f8f9fc; border-radius:20px;
    padding:5px 14px; margin-bottom:22px;
}
.printer-dot { width:8px; height:8px; border-radius:50%; background:var(--green); flex-shrink:0; box-shadow:0 0 0 2px rgba(5,150,105,.2); }
.print-modal-btn {
    display:block; width:100%; padding:13px 16px; border-radius:12px;
    font-size:14px; font-weight:700; cursor:pointer; border:none;
    font-family:inherit; transition:.15s; margin-bottom:10px;
}
.print-modal-btn.primary { background:var(--blue); color:#fff; }
.print-modal-btn.primary:hover { background:var(--blue-dk); }
.print-modal-btn.secondary { background:#f0f2f5; color:var(--text); border:1px solid var(--border); }
.print-modal-btn.secondary:hover { background:#e5e7eb; }
.print-modal-btn-sub { font-size:11px; font-weight:400; opacity:.75; margin-top:2px; }
</style>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2>Print QR 🖨️</h2>
        <p>Scan QR · Fill Info · Preview & Print Label</p>
    </div>
</div>

<!-- TAB PILLS -->
<script>
function switchTab(name, el) {
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'))
    document.querySelectorAll('.tab-pill').forEach(b => b.classList.remove('active'))
    document.getElementById('tab-' + name).classList.add('active')
    el.classList.add('active')
}
</script>
<div class="tab-pills">
    <button class="tab-pill active" onclick="switchTab('print', this)">🖨️ Print QR-Code</button>
    <button class="tab-pill"        onclick="switchTab('design', this)">🎨 Design Layout</button>
</div>

<!-- Toast container -->
<div class="toast-container" id="toastContainer"></div>

<!-- Print Confirm Modal -->
<div class="print-modal-overlay" id="printModalOverlay" style="display:none" onclick="if(event.target===this)closePrintModal()">
    <div class="print-modal">
        <button class="print-modal-close" onclick="closePrintModal()">✕</button>
        <div class="print-modal-icon">🖨️</div>
        <div class="print-modal-title">Ready to Print?</div>
        <div class="print-modal-printer">
            <span class="printer-dot"></span>
            <span id="modalPrinterName">—</span>
        </div>
        <button class="print-modal-btn primary" onclick="doPrintConfirm('print-receive')">
            Print &amp; Receive
            <div class="print-modal-btn-sub">พิมพ์และบันทึก Receive transaction</div>
        </button>
        <button class="print-modal-btn secondary" onclick="doPrintConfirm('print-only')">
            Print Only
            <div class="print-modal-btn-sub">พิมพ์อย่างเดียว ไม่บันทึก</div>
        </button>
    </div>
</div>

<!-- ══════ TAB: PRINT ══════ -->
<div class="tab-pane active" id="tab-print">

    <!-- STEPPER -->
    <div class="stepper">
        <div class="step">
            <div class="step-circle active" id="sc1">1</div>
            <span class="step-label active" id="sl1">Scan QR</span>
        </div>
        <div class="step-line" id="line1"></div>
        <div class="step">
            <div class="step-circle" id="sc2">2</div>
            <span class="step-label" id="sl2">Fill Info</span>
        </div>
        <div class="step-line" id="line2"></div>
        <div class="step">
            <div class="step-circle" id="sc3">3</div>
            <span class="step-label" id="sl3">Preview</span>
        </div>
    </div>

    <!-- STEP 1: SCAN -->
    <div class="card" id="step1">
        <div class="card-body" style="padding:32px 24px">

            <!-- Camera box (hidden when idle) -->
            <div id="scannerBox" class="scanner-box" style="display:none;margin:0 auto 20px">
                <div id="qrReader" style="position:absolute;inset:0;border-radius:13px;overflow:hidden"></div>
                <div class="scan-line" id="scanLine" style="display:none"></div>
                <button class="btn-secondary" id="btnStopScan" onclick="stopScan()"
                    style="display:none;position:absolute;bottom:10px;left:50%;transform:translateX(-50%);font-size:12px;padding:6px 16px;z-index:10">
                    ⏹ หยุด
                </button>
            </div>

            <!-- Idle state -->
            <div id="scannerIdle" style="text-align:center">
                <div style="width:96px;height:96px;background:var(--blue-lt);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.5">
                        <path d="M23 7V1h-6M1 7V1h6M7 23H1v-6M17 23h6v-6"/>
                        <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="4" height="4" rx="0.5"/>
                    </svg>
                </div>
                <div style="font-size:18px;font-weight:700;color:var(--navy);margin-bottom:6px">สแกน QR / Barcode</div>
                <div style="font-size:13px;color:var(--t2);margin-bottom:24px">รองรับ QR Code · Data Matrix · Code 128</div>
                <button class="btn-primary" id="btnStartScan" onclick="startScan()"
                    style="padding:13px 36px;font-size:15px;border-radius:12px">
                    📷 เปิดกล้อง
                </button>
            </div>

            <!-- Status -->
            <div id="scanStatus" style="font-size:13px;min-height:18px;text-align:center;margin-top:14px"></div>

            <!-- Manual input (collapsible) -->
            <div style="margin-top:20px">
                <button onclick="toggleManualInput()" id="btnToggleManual"
                    style="background:none;border:none;cursor:pointer;font-size:12px;color:var(--t3);width:100%;display:flex;align-items:center;justify-content:center;gap:6px;padding:4px">
                    <span style="flex:1;height:1px;background:var(--border)"></span>
                    <span id="manualLabel">ป้อน Barcode ด้วยตัวเอง ↓</span>
                    <span style="flex:1;height:1px;background:var(--border)"></span>
                </button>
                <div id="manualInputArea" style="display:none;margin-top:10px">
                    <textarea id="jsonInput" rows="3"
                        style="width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:9px;font-size:12px;font-family:ui-monospace,monospace;color:var(--text);outline:none;resize:vertical;box-sizing:border-box;transition:border-color .15s"
                        onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor='var(--border)'"
                        placeholder="วางข้อความจาก QR Code หรือ barcode string..."></textarea>
                    <button class="btn-primary" style="width:100%;margin-top:8px" onclick="submitBarcode()">
                        🔍 ส่งไปตรวจสอบ
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- STEP 2: FORM -->
