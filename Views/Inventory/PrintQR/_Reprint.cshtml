        <div style="background:#fff;border-radius:14px;width:90%;max-width:340px;padding:24px 20px 16px;box-shadow:0 12px 40px rgba(0,0,0,.2);text-align:center">
            <i class="bi bi-exclamation-triangle-fill" style="font-size:36px;color:var(--amber);display:block;margin-bottom:12px"></i>
            <p style="font-size:14px;font-weight:700;color:var(--navy);margin:0 0 4px">Lot นี้ Print สำเร็จไปแล้ว</p>
            <p style="font-size:12px;color:var(--t2);margin:0 0 4px;word-break:break-all" id="rprAlreadyPrintedLotLabel"></p>
            <p style="font-size:12px;color:var(--t2);margin:0 0 16px">แน่ใจนะว่าต้องการ Re-Print ซ้ำอีกครั้ง?</p>
            <div style="display:flex;gap:8px">
                <button onclick="rprCancelAlreadyPrintedAdd()" style="flex:1;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">ยกเลิก</button>
                <button onclick="rprConfirmAlreadyPrintedAdd()" style="flex:1;padding:11px;background:var(--amber);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">OK, เพิ่มเลย</button>
            </div>
        </div>
    </div>

    <!-- ── Pick Lot modal (raw barcode ผูกกับหลาย lot ให้เลือกว่าจะ Re-Print lot ไหน) ── -->
    <div id="rprPickLotModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)closeRprPickLot()">
        <div style="background:#fff;border-radius:14px;width:90%;max-width:360px;max-height:70vh;display:flex;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.2)">
            <div style="padding:16px 18px 10px;font-size:15px;font-weight:700;color:var(--navy);flex-shrink:0">เลือก Lot ที่ต้องการ Re-Print (<span id="rprPickLotCount">0</span> รายการ)</div>
            <div id="rprPickLotList" style="overflow-y:auto;padding:0 10px 10px"></div>
            <div style="padding:10px 18px 16px;flex-shrink:0">
                <button onclick="closeRprPickLot()" style="width:100%;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">ยกเลิก</button>
            </div>
        </div>
    </div>

    <!-- ── Search W/O modal — Lot Summary grouped by Part No (ย่อจากหน้า WorkOrderLots.cshtml) ให้เลือก Lot มา Re-Print ได้เลย ── -->
    <div id="rprWoSearchModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)rprCloseWoSearch()">
        <div style="background:#fff;border-radius:14px;width:94%;max-width:780px;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.2)">
            <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:14px;flex-shrink:0">
                <div style="font-size:15px;font-weight:700;color:var(--navy);flex-shrink:0;white-space:nowrap"><i class="bi bi-search me-1"></i>Search W/O</div>
                <div class="wo-autocomplete" style="flex:1;min-width:0">
                    <div style="position:relative">
                        <i class="bi bi-box-seam" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--t3);pointer-events:none;z-index:1"></i>
                        <input class="form-input" id="rprWoInput" placeholder="ค้นหา Work Order..." autocomplete="off" style="padding-left:32px;margin:0;width:100%">
                    </div>
                    <div class="wo-dropdown" id="rprWoDropdown" style="display:none"></div>
                </div>
                <button type="button" onclick="rprCloseWoSearch()"
                    style="flex-shrink:0;width:32px;height:32px;border-radius:8px;border:none;background:#f0f2f5;color:var(--t2);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;font-family:inherit">✕</button>
            </div>

            <div id="rprWoSummaryEmpty" style="padding:60px 20px;text-align:center;color:var(--t3);font-size:13px">
                <i class="bi bi-search" style="font-size:28px;display:block;margin-bottom:10px;opacity:.5"></i>
                ค้นหา Work Order เพื่อดู Lot Summary
            </div>

            <div id="rprWoSummaryBody" style="display:none;flex-direction:column;overflow:hidden;flex:1">
                <div style="display:flex;align-items:center;gap:10px;padding:12px 20px;border-bottom:1px solid var(--border);flex-wrap:wrap;flex-shrink:0">
                    <span style="font-size:13px;font-weight:700;color:var(--navy)">Lot Summary</span>
                    <span id="rprWoSummaryCount" style="font-size:11px;background:var(--blue-lt);color:var(--blue);padding:2px 8px;border-radius:20px;font-weight:700"></span>
                    <button type="button" id="rprWoRefreshBtn" onclick="rprWoRefresh()" title="Refresh"
                            style="width:26px;height:26px;border-radius:7px;border:1.5px solid var(--border);background:#fff;color:var(--t2);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;transition:.15s">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                    <div style="position:relative;margin-left:auto">
                        <i class="bi bi-search" style="position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:11px;color:var(--t3);pointer-events:none"></i>
                        <input id="rprWoSummarySearch" type="text" placeholder="Part No. / Description" oninput="rprWoRenderSummary()"
                            style="padding:5px 9px 5px 26px;border:1px solid var(--border);border-radius:8px;font-size:12px;outline:none;font-family:inherit;width:180px">
                    </div>
                </div>
                <div style="overflow-y:auto;flex:1">
                    <table style="width:100%;border-collapse:collapse">
                        <thead>
                            <tr style="background:#f8f9fc">
                                <th style="width:30px;padding:8px 10px;border-bottom:1px solid var(--border)"></th>
                                <th style="text-align:left;padding:8px 10px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Part</th>
                                <th style="text-align:left;padding:8px 10px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border);min-width:150px">OnHand vs Target</th>
                                <th style="text-align:left;padding:8px 10px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Locations</th>
                                <th style="text-align:left;padding:8px 10px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border);width:70px">Lots</th>
                                <th style="text-align:left;padding:8px 10px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border);width:120px">Print Status</th>
                            </tr>
                        </thead>
                        <tbody id="rprWoSummaryTable"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div><!-- end #tab-reprint -->

<script>
    let rprLotTimer = null, _rprLotResults = []

    function rprHideLotDropdown() {
        const dd = document.getElementById('rprLotDropdown')
        if (dd) dd.style.display = 'none'
    }

    function rprLotAutocomplete() {
        const inp  = document.getElementById('rpReprintLot')
        const dd   = document.getElementById('rprLotDropdown')
        const text = inp.value.trim()
        if (!text) { dd.style.display = 'none'; return }

        dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default">
            <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
        </div>`
        dd.style.display = 'block'

        clearTimeout(rprLotTimer)
        rprLotTimer = setTimeout(async () => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: text })
                const list = Array.isArray(res) ? res : (res?.data || [])
                if (!list.length) {
                    dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default">
                        <i class="bi bi-search me-2"></i>ไม่พบ Lot No
                    </div>`
                    return
                }
                _rprLotResults = list
                dd.innerHTML = list.map((l, i) => {
                    const lotNo  = l.lotNo  || l
                    const partNo = l.partNo || ''
                    return `<div class="wo-item" onmousedown="rprSelectLotByIdx(${i})">
                        <span style="font-weight:700">${escHtml(String(lotNo))}</span>
                        ${partNo ? `<span class="wo-item-line">${escHtml(partNo)}</span>` : ''}
                    </div>`
                }).join('')
            } catch {
                dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default">
                    <i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ
                </div>`
            }
        }, 300)
    }

    function rprSelectLotByIdx(i) {
        const l = _rprLotResults[i]
        if (!l) return
        rprHideLotDropdown()
        document.getElementById('rpReprintLot').value = ''
        rprAddFromData(l).then(ok => {
            if (ok) showToast('✅ LOT added to Re-Print list', 'success')
        })
    }

    async function rpSearchLot() {
        const inp   = document.getElementById('rpReprintLot')
        const lotNo = inp.value.trim()
        if (!lotNo) { showToast('Please enter LOT NO', 'error'); return }
        rprHideLotDropdown()

        // 1. เอาตัวแรกใน list ที่ autocomplete โหลดไว้แล้ว (ถ้ามี)
        if (_rprLotResults.length) {
            inp.value = ''
            const ok = await rprAddFromData(_rprLotResults[0])
            if (ok) showToast('✅ LOT added to Re-Print list', 'success')
            return
        }

        // 2. ยังไม่มี list (พิมพ์แล้วกด Enter เร็วกว่า debounce) → fetch จาก API
        try {
            const res  = await api('/inventory/lots', 'POST', { lotNo })
            const list = Array.isArray(res?.data?.data) ? res.data.data : Array.isArray(res?.data) ? res.data : Array.isArray(res) ? res : []
            const match = list.find(l => (l.lotNo || '').toLowerCase() === lotNo.toLowerCase()) ?? list[0]
            inp.value = ''
            const ok = await rprAddFromData(match ?? { lotNo })
            if (ok) showToast('✅ LOT added to Re-Print list', 'success')
        } catch (e) {
            showToast('Search failed: ' + e.message, 'error')
        }
    }

    // ส่วนใหญ่ Production Area เป็น Fan_1 — ใช้เป็น default ให้ lot ที่ยังไม่เคยมีค่านี้บันทึกไว้ (ไม่ทับของเดิมที่มีอยู่แล้ว)
    // Production Area เดา (เฉพาะตอน lot ที่ scan มาไม่มีค่านี้ติดมาด้วย) — ดูชื่อ Layout Template ที่เลือกอยู่ตอนนี้
    // เหมือนหน้า Split/Merge/Receive (ชื่อ Layout ขึ้นต้น "FAN1_...", "FAN_2..." ฯลฯ ตัวเลขหลัง FAN คือ Production Area
    // ถ้าไม่เข้ารูปแบบนี้เลย default เป็น Fan_1) — ยังแก้เองทีหลังผ่าน Production Area picker ใน Item Data modal ได้ตามปกติ
    async function _rprResolveProductionArea() {
        if (!_locNameMap.size) await loadLocation()
        const sel      = document.getElementById('rprLayout')
        const arr      = sel?._layoutsData ?? []
        const tmpl     = arr.find(l => String(l.id) === String(sel?.value))
        const tplName  = (tmpl?.templateName || '').trim()
        const m        = tplName.match(/^FAN_?(\d+)/i)
        const areaCode = m ? `Fan_${m[1]}` : 'Fan_1'
        const match    = Array.from(_locNameMap.values()).find(loc =>
            (loc.locationCode || '').toLowerCase() === areaCode.toLowerCase() ||
            (loc.displayName  || '').toLowerCase() === areaCode.toLowerCase())
        return { locationCode: match?.locationCode ?? areaCode, displayName: match?.displayName ?? areaCode }
    }

    // Production Area จาก field "productionPlant" ของ /workorder/{wo}/detail (เช่น "FAN1") — เหมือนหน้า Receive
    // ชนะ Layout Template guess (_rprResolveProductionArea ด้านบน) — ใช้ตัวนี้ก่อนเสมอถ้ามี workOrder และหาเจอ
    // คืน null ถ้า fetch ไม่ได้/ไม่มี productionPlant มา ให้ผู้เรียก fallback ไป _rprResolveProductionArea() แทน
    async function _rprResolveProductionAreaFromWo(workOrder) {
        if (!workOrder) return null
        let detail = null
        try {
            detail = await api(`/workorder/${encodeURIComponent(workOrder)}/detail`, 'GET')
        } catch (_) { return null }
        const plant = (detail?.productionPlant || '').trim()
        if (!plant) return null
        const m        = plant.match(/(\d+)\s*$/)
        const areaCode = m ? `Fan_${m[1]}` : plant
        if (!_locNameMap.size) await loadLocation()
        const match = Array.from(_locNameMap.values())
            .filter(loc => (loc.typeName || '').toLowerCase() === 'factory')
            .find(loc =>
                (loc.locationCode || '').toLowerCase() === areaCode.toLowerCase() ||
                (loc.displayName  || '').toLowerCase() === areaCode.toLowerCase())
        return { locationCode: match?.locationCode ?? areaCode, displayName: match?.displayName ?? areaCode }
    }

    async function rprAddFromData(lotData) {
        if (rprItems.length >= 10) { showToast('Maximum 10 items per batch', 'error'); return false }

        const lotNo = (lotData.lotNo || '').trim()
        if (!lotNo) { showToast('Unable to read LOT NO', 'error'); return false }

        if (rprItems.find(i => i.data.lotNo === lotNo)) {
            showToast('⚠️ LOT already in list: ' + lotNo, 'error')
            return false
        }

        const workOrder = lotData.workOrder || lotData.workOrderNo || lotData.moNumber || ''

        let productionArea     = lotData.productionArea || ''
        let productionAreaName = ''
        if (!productionArea) {
            // มี workOrder → เอา productionPlant จาก /workorder/{wo}/detail มาก่อนเสมอ (แม่นกว่าเดาจากชื่อ Layout)
            const areaFromWo = await _rprResolveProductionAreaFromWo(workOrder)
            const area = areaFromWo ?? await _rprResolveProductionArea()
            productionArea     = area.locationCode
            productionAreaName = area.displayName
        }

        const data = {
            lotNo,
            traceId:        lotData.traceId        || lotData.wH_TraceId  || lotData.wHTraceId || '',
            partNo:         lotData.partNo         || '',
            quantity:       String(lotData.onHandQty ?? lotData.onHandQuantity ?? lotData.quantity ?? ''),
            unit:           lotData.unit           || lotData.baseUnit    || '',
            itemType:       lotData.itemTypeName   || (lotData.itemType != null ? String(lotData.itemType) : '') || '',
            description:    lotData.description    || '',
            workOrder,
            line:           lotData.line           || lotData.lineName    || '',
            vendor:         lotData.vendorCode      || lotData.vendor || '',
            dateCode:       lotData.dateCode       || '',
            tradingCode:    lotData.tradingCode    || '',
            po:             lotData.po             || '',
            inventoryNo:    lotData.inventoryNo    || '',
            rawBarCode:     lotData.rawBarCode     || '',
            location:       lotData.location        || '',
            productionArea,
            _productionAreaName: productionAreaName,
            createdAt:      lotData.createdAt      || '',
            printedAt:      new Date().toISOString(),   // แค่ placeholder โชว์ใน Label Preview ก่อนกด Re-Print จริง — ตอนพิมพ์จริง
                                                          // _rprPrintItem() จะ fetch เวลาจริงจาก server มาทับอีกทีเสมอ (ดู _fetchServerPrintedAt)
            uniqueId:       await _fetchUniqueId(),
        }

        const cfg         = rprLayoutConfig ?? {}
        const sliders     = { qrX: cfg.qrX??30, qrY: cfg.qrY??40, qrSize: cfg.qrSize??5, dataX: cfg.dataX??373, dataY: cfg.dataY??58, fontSize: cfg.fontSize??22, lineHeight: cfg.lineHeight??33, valOffset: cfg.valOffset??151 }
        const textFields  = buildLabelTextFields(cfg.labelFields, data)
        const zpl = buildZpl({ qrContent: buildQrContent(data, cfg.qrFields ?? null), textFields, ...sliders })

        rprItems.push({ data, zpl, previewSrc: null, reviewed: true })   // ถูกโฟกัสใน Label Preview ทันที = Review Success

        // เครื่องสั่น
        if (navigator.vibrate) navigator.vibrate(50)

        const idx = rprItems.length - 1
        _rprPreviewIdx = idx   // โฟกัส Label Preview ไปที่ item ที่เพิ่งเพิ่ม
        rprRenderList()
        renderZplClient(zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
            .then(src => { if (rprItems[idx]) { rprItems[idx].previewSrc = src; if (idx === _rprPreviewIdx) rprRenderPreviewPanel() } }).catch(() => {})
        return true
    }

    async function rprFetchAndAddByLotNo(lotNo) {
        const res  = await api('/inventory/lots', 'POST', { lotNo })
        console.log("[Re-Print] /inventory/lots : ", res)
        const list = Array.isArray(res) ? res : (res?.data || [])
        const match = list.find(l => (l.lotNo || '') === lotNo) || list[0]
        if (!match) { showToast('ไม่พบ LOT: ' + lotNo, 'error'); return false }
        return rprAddFromData(match)
    }

    // ══════ Search W/O modal — Lot Summary grouped by Part No (ย่อจากหน้า WorkOrderLots.cshtml) ══════
    let _rprWoInited      = false   // สร้าง createWorkOrderAutocomplete แค่ครั้งเดียว (ผูก event ให้ input/dropdown แล้วอยู่)
    let _rprWoSumGroups   = []      // [{ partNo, description, itemType, onHand, target, lots:[...], locTypes:[...] }]
    let _rprWoCurrent     = null    // MO Number ที่กำลังดู Lot Summary อยู่ตอนนี้ — ใช้กรอง /printer/histories?workOrder= ทีเดียวแทนการยิงทีละ lot
    let _rprWoExpanded    = new Set()   // partNo ที่ expand ค้างไว้อยู่ตอนนี้

    // Work Order Status Types — โหลดจาก /workorder/wo-status-types เอาไว้แปลง status id → ชื่อจริง โชว์ badge ในช่อง autocomplete
    // (เหมือน _rcWoStatusTypes/rcWoStatusName ใน _Receive.cshtml แต่ Search W/O นี้ไม่ต้อง disable Closed — ให้เลือกได้ทุก Status)
    let _rprWoStatusTypes = []
    async function _rprLoadWoStatusTypes() {
        try {
            const arr = await api('/workorder/wo-status-types', 'GET')
            _rprWoStatusTypes = Array.isArray(arr) ? arr : []
        } catch (_) {}
    }
    function _rprWoStatusName(statusId) {
        const found = _rprWoStatusTypes.find(t => t.id === statusId)
        return found ? found.name : (statusId ?? '—')
    }

    function rprOpenWoSearch() {
        document.getElementById('rprWoSearchModal').style.display = 'flex'
        if (!_rprWoInited) {
            _rprWoInited = true
            _rprLoadWoStatusTypes()
            createWorkOrderAutocomplete({
                inputId: 'rprWoInput', dropdownId: 'rprWoDropdown',
                loadingText: '⏳ Searching…', emptyText: 'No Work Order found',
                renderItem: (x, i) => `<div class="wo-item" data-idx="${i}">
                    <i class="bi bi-box-seam" style="color:var(--blue);flex-shrink:0"></i>
                    <span>
                        <strong>${escHtml(x.moNumber)}</strong>
                        <span style="margin-left:6px">${woStatusBadge(_rprWoStatusName(x.status))}</span>
                    </span>
                    ${x.lineName ? `<span class="wo-item-line" style="margin-left:auto">${escHtml(x.lineName)}</span>` : ''}
                </div>`,
                onSelect: x => { if (x?.moNumber) rprWoLoadSummary(x.moNumber) }
            })
        }
        setTimeout(() => document.getElementById('rprWoInput')?.focus(), 50)
    }

    function rprCloseWoSearch() {
        document.getElementById('rprWoSearchModal').style.display = 'none'
    }

    // ปุ่ม Refresh บนหัว Lot Summary — เผื่อ user อยากอัปเดตข้อมูล Lot ของ W/O ที่เปิดดูอยู่เองทันที (On Hand/Print Status อาจ
    // เปลี่ยนไปแล้วหลังโหลดครั้งแรก เช่น มีการ Receive/Re-Print เพิ่มระหว่างนั้น)
    async function rprWoRefresh() {
        if (!_rprWoCurrent) return
        const btn = document.getElementById('rprWoRefreshBtn')
        if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:12px;height:12px;border-width:2px"></span>' }
        await rprWoLoadSummary(_rprWoCurrent)
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise"></i>' }
    }

    async function rprWoLoadSummary(workOrder) {
        const emptyEl = document.getElementById('rprWoSummaryEmpty')
        const bodyEl  = document.getElementById('rprWoSummaryBody')
        emptyEl.style.display = 'block'
        bodyEl.style.display  = 'none'
        emptyEl.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>กำลังโหลด Lot Summary ของ ${escHtml(workOrder)}…`
        _rprWoCurrent = workOrder

        try {
            if (window._printQrLocationsReady) await window._printQrLocationsReady   // ต้องมี _locNameMap ก่อน ไม่งั้น rprLocBadge() ใน group header หา location ไม่เจอ

            const body       = { workOrder, page: 1, pageSize: 50, desc: true }
            const [first, detail] = await Promise.all([
                api('/inventory/get-stock-summary', 'POST', body),
                getWorkOrderDetail(workOrder).catch(() => null)
            ])
            let items        = first?.data || []
            const totalPages = first?.totalPages || 1
            if (totalPages > 1) {
                const rest = await Promise.all(
                    Array.from({ length: totalPages - 1 }, (_, i) => api('/inventory/get-stock-summary', 'POST', { ...body, page: i + 2 }))
                )
                rest.forEach(r => { items = items.concat(r?.data || []) })
            }

            const targetByPart = {}
            ;(detail?.items || []).forEach(x => { if (x.partNo) targetByPart[x.partNo] = Number(x.planQty || 0) })

            _rprWoExpanded  = new Set()
            _rprWoSumGroups = items.map(x => {
                const lots = x.lotDetails || []
                return {
                    partNo:      x.itemPartNo,
                    description: x.description || '-',
                    itemType:    x.itemType || null,
                    onHand:      lots.reduce((s, l) => s + Number(l.onHandQty || 0), 0),
                    target:      targetByPart[x.itemPartNo] ?? 0,
                    lots,
                    locTypes:    [...new Set(lots.map(l => (l.locationType || '').trim()).filter(Boolean))]
                }
            }).sort((a, b) => a.partNo.localeCompare(b.partNo))

            if (!_rprWoSumGroups.length) {
                emptyEl.innerHTML = `<i class="bi bi-inbox" style="font-size:28px;display:block;margin-bottom:10px;opacity:.5"></i>ไม่พบ Lot ของ Work Order นี้`
                emptyEl.style.display = 'block'
                bodyEl.style.display  = 'none'
                return
            }

            emptyEl.style.display = 'none'
            bodyEl.style.display  = 'flex'
            document.getElementById('rprWoSummarySearch').value = ''
            rprWoRenderSummary()
        } catch (e) {
            emptyEl.innerHTML = `<i class="bi bi-exclamation-circle" style="font-size:28px;display:block;margin-bottom:10px;color:var(--red)"></i>โหลดไม่สำเร็จ: ${escHtml(e.message || '')}`
            emptyEl.style.display = 'block'
            bodyEl.style.display  = 'none'
        }
    }

    function _rprWoStockCell(onHand, target) {
        if (!(target > 0)) return `<span style="color:var(--t3);font-size:12.5px">${onHand.toLocaleString()} · No data</span>`
        const pct   = Math.min(100, (onHand / target) * 100)
        const color = pct >= 100 ? 'var(--green)' : pct >= 30 ? '#d97706' : 'var(--red)'
        return `<div style="display:flex;height:6px;border-radius:3px;background:#eef0f5;overflow:hidden;margin-bottom:5px;min-width:120px">
                <div style="height:100%;width:${pct}%;min-width:${pct > 0 ? '2px' : '0'};background:${color}"></div>
            </div>
            <div style="font-size:11.5px;color:var(--t2);white-space:nowrap">
                <span style="color:${color};font-weight:700">${onHand.toLocaleString()}</span> / <span>${target.toLocaleString()}</span> target
                <span style="color:var(--t3);margin:0 3px">·</span>
                <span style="color:${color};font-weight:700">${pct.toFixed(1)}%</span>
            </div>`
    }

    // ── Print Status ต่อ Lot (เหมือนหน้า WorkOrderLots.cshtml) — ดู /printer/histories ของทั้ง Work Order ทีเดียว (filter by workOrder)
    // แทนที่จะยิงทีละ lot (เดิม N requests ต่อ N lot) แล้วค่อยหา latest printedAt ต่อ lot เอาเองฝั่ง client ──
    let _rprPrintStatusCache = {}

    function _rprPsId(lotNo) {
        return 'rprps_' + String(lotNo || '').replace(/[^a-zA-Z0-9]/g, '_')
    }

    async function _rprFetchWorkOrderPrintHistory(workOrder) {
        const pageSize = 200
        const first = await api(`/printer/histories?workOrder=${encodeURIComponent(workOrder)}&sortBy=PrintedAt&sortDesc=true&page=1&pageSize=${pageSize}`, 'GET')
        let rows          = first?.data || []
        const total       = first?.totalCount ?? rows.length
        const totalPages  = Math.ceil(total / pageSize) || 1
        if (totalPages > 1) {
            const rest = await Promise.all(
                Array.from({ length: totalPages - 1 }, (_, i) =>
                    api(`/printer/histories?workOrder=${encodeURIComponent(workOrder)}&sortBy=PrintedAt&sortDesc=true&page=${i + 2}&pageSize=${pageSize}`, 'GET'))
            )
            rest.forEach(r => { rows = rows.concat(r?.data || []) })
        }
        return rows
    }

    function _rprPsBadgeHtml(d) {
        if (!d) return '<span style="color:var(--t3);font-size:11px">⏳</span>'
        if (d.status === 'success')
            return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:var(--green-lt);color:var(--green)">✓ Success</span>`
        if (d.status === 'failed') {
            const tip = d.errorMessage ? ` title="${escHtml(d.errorMessage)}"` : ''
            return `<span${tip} style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:var(--red-lt);color:var(--red);${d.errorMessage ? 'cursor:help' : ''}">✗ Failed</span>`
        }
        return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:#f0f2f5;color:#6b7280">Not Printed</span>`
    }

    function _rprWoPsId(partNo) {
        return 'rprwops_' + String(partNo || '').replace(/[^a-zA-Z0-9]/g, '_')
    }

    // เวลา Print ล่าสุดของ lot นั้น — ใช้ printedAt ตัวเดียวกับที่ _rprPrintStatusCache เก็บไว้อยู่แล้ว (มาจาก latestByLot ใน
    // _rprWoLoadPrintStatuses ด้านล่าง) แค่โชว์เพิ่มเป็นคอลัมน์แยกต่างหากถัดจาก Print Status
    function _rprPrintedAtId(lotNo) {
        return 'rprpat_' + String(lotNo || '').replace(/[^a-zA-Z0-9]/g, '_')
    }
    function _rprPrintedAtHtml(d) {
        if (!d || !d.printedAt) return '<span style="color:var(--t3)">—</span>'
        return `<span style="color:var(--t2);font-size:12px;white-space:nowrap">${escHtml(fmtCreatedAt(d.printedAt))}</span>`
    }

    // สรุป Print Status รวมของทุก lot ใน part นี้ — โชว์ที่แถว Part เอง (คอลัมน์ Print Status ถัดจาก Lots) ไม่ต้อง expand ก่อนถึงจะเห็น
    // ให้ความสำคัญกับ Failed ก่อน (ต้องรู้ทันทีว่ามีพิมพ์พลาด) รองลงมาคือ Not Printed ถ้าไม่มีทั้งสองอย่างถึงจะถือว่า Printed ครบ
    function _rprWoPartPrintStatusCell(lots) {
        const withLot = (lots || []).filter(l => l.lotNo)
        if (!withLot.length) return '<span style="color:var(--t3)">—</span>'
        const statuses = withLot.map(l => _rprPrintStatusCache[l.lotNo])
        if (statuses.some(d => !d)) return '<span style="color:var(--t3);font-size:11px">⏳</span>'
        const failed     = statuses.filter(d => d.status === 'failed').length
        const notPrinted = statuses.filter(d => d.status === 'none').length
        if (failed > 0)
            return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:var(--red-lt);color:var(--red);white-space:nowrap">✗ Failed (${failed})</span>`
        if (notPrinted > 0)
            return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:#f0f2f5;color:#6b7280;white-space:nowrap">${notPrinted} Not Printed</span>`
        return `<span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;background:var(--green-lt);color:var(--green);white-space:nowrap">✓ Printed</span>`
    }

    // ยิงเช็คของ "ทุก lot ที่แสดงอยู่ในตารางตอนนี้" (ไม่ใช่แค่กลุ่มที่ expand) เพราะคอลัมน์ Print Status ที่แถว Part ต้องใช้สรุปสถานะรวมของทุก lot
    // เสมอ ไม่ว่าจะ expand ดูรายละเอียดหรือยัง — cache กันยิงซ้ำของ lot เดิม, groups (ถ้ามี) ใช้ patch คอลัมน์สรุปที่แถว Part หลัง fetch เสร็จ
    // ยิง /printer/histories?workOrder= ครั้งเดียวสำหรับทั้ง WO แล้วหา printedAt ล่าสุดต่อ lot เอาเอง แทนการยิงทีละ lot (N requests)
    async function _rprWoLoadPrintStatuses(lots, groups) {
        const uncached = lots.filter(l => l.lotNo && !(l.lotNo in _rprPrintStatusCache))
        if (uncached.length) {
            let rows = []
            try {
                rows = _rprWoCurrent ? await _rprFetchWorkOrderPrintHistory(_rprWoCurrent) : []
            } catch (_) { rows = [] }

            const latestByLot = {}
            rows.forEach(r => {
                if (!r.lotNo) return
                if (!latestByLot[r.lotNo] || new Date(r.printedAt) > new Date(latestByLot[r.lotNo].printedAt)) latestByLot[r.lotNo] = r
            })
            uncached.forEach(l => {
                const latest = latestByLot[l.lotNo]
                _rprPrintStatusCache[l.lotNo] = latest
                    ? { status: latest.success ? 'success' : 'failed', errorMessage: latest.errorMessage || '', printedAt: latest.printedAt || null }
                    : { status: 'none', printedAt: null }
            })
        }
        lots.forEach(l => {
            if (!l.lotNo) return
            const d = _rprPrintStatusCache[l.lotNo]
            const el = document.getElementById(_rprPsId(l.lotNo))
            if (el && d) el.innerHTML = _rprPsBadgeHtml(d)
            const patEl = document.getElementById(_rprPrintedAtId(l.lotNo))
            if (patEl && d) patEl.innerHTML = _rprPrintedAtHtml(d)
        })
        if (groups) {
            groups.forEach(g => {
                const el = document.getElementById(_rprWoPsId(g.partNo))
                if (el) el.innerHTML = _rprWoPartPrintStatusCell(g.lots)
            })
        }
    }

    // แยกกลุ่ม lot ของ part นี้เป็น 2 ชั้น: ชั้นนอกตาม Location Type (Busrun/Warehouse/...) ชั้นในตาม Location จริงแต่ละจุด
    // (location type เดียวกันหลายจุด เช่น Busrun ของ AHF_03 กับ STF_09 จะถูกรวมอยู่ใต้ header "Busrun" เดียวกัน ไม่กระจายแยกกัน)
    // หัวกล่องโชว์แค่ On Hand รวม (ตามที่ขอ — ไม่เอา Reserved/Available รวมมาปนในหัวกล่อง) ส่วนตารางข้างในโชว์ครบทุก field + Print Status
    function _rprWoLotGroupsHtml(lots) {
        const byLoc = {}
        lots.forEach(l => {
            const loc = l.locationCode || 'UNKNOWN'
            if (!byLoc[loc]) byLoc[loc] = []
            byLoc[loc].push(l)
        })

        // จัดกลุ่ม location เข้าด้วยกันตาม type เดียวกัน — เรียงตามลำดับที่เจอ type นั้นครั้งแรก (ไม่ใช่ A-Z) ให้ลำดับเดิมของ location กระทบน้อยที่สุด
        const typeOrder = []
        const byType     = {}
        Object.entries(byLoc).forEach(([loc, locLots]) => {
            const type = (locLots[0]?.locationType || '').trim() || 'Unknown'
            if (!byType[type]) { byType[type] = []; typeOrder.push(type) }
            byType[type].push([loc, locLots])
        })

        return typeOrder.map(type => {
            const locEntries  = byType[type]
            const typeOnHand  = locEntries.reduce((s, [, locLots]) => s + locLots.reduce((ss, l) => ss + Number(l.onHandQty || 0), 0), 0)
            const typeLotCount = locEntries.reduce((s, [, locLots]) => s + locLots.length, 0)
            const locBoxesHtml = locEntries.map(([locCode, locLots]) => _rprWoLocBoxHtml(locCode, locLots)).join('')

            return `<div style="margin:10px 12px;border:1px solid var(--border);border-radius:10px;overflow:hidden">
                <div style="display:flex;align-items:center;gap:10px;padding:8px 14px;background:#eef2ff;border-bottom:1px solid var(--border)">
                    ${locTypeBadge(type)}
                    <span style="margin-left:auto;font-size:11.5px;color:var(--t2);font-weight:600;white-space:nowrap">${typeOnHand.toLocaleString()} on hand · ${typeLotCount} lot${typeLotCount === 1 ? '' : 's'}</span>
                </div>
                <div style="background:#fff;padding:2px 0">${locBoxesHtml}</div>
            </div>`
        }).join('')
    }

    // กล่องของ location จริงหนึ่งจุด (ชั้นในของ _rprWoLotGroupsHtml) — 1 กล่องต่อ 1 location พร้อมตาราง lot ของจุดนั้น
    function _rprWoLocBoxHtml(locCode, locLots) {
        const onHandSum = locLots.reduce((s, l) => s + Number(l.onHandQty || 0), 0)
        const rows = locLots.map(l => {
                const already  = rprItems.some(it => it.data.lotNo === l.lotNo)
                const reserved = Number(l.reservedQty || 0)
                return `<tr>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5">
                        <button type="button" ${already ? 'disabled' : ''} onclick="rprWoAddLot('${escHtml(l.lotNo || '')}', this)" title="${already ? 'เพิ่มเข้า Re-Print list แล้ว' : 'เพิ่มเข้า Re-Print list'}"
                            style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;padding:2px 9px;border-radius:5px;border:none;cursor:${already ? 'default' : 'pointer'};background:${already ? '#f0f2f5' : 'var(--blue-lt)'};color:${already ? 'var(--t2)' : 'var(--blue)'}">
                            ${already ? '<i class="bi bi-check2"></i> ' : ''}${escHtml(l.lotNo || '—')}
                        </button>
                    </td>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5;color:var(--text)">${Number(l.onHandQty || 0).toLocaleString()}</td>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5"><span style="color:${reserved > 0 ? '#d97706' : 'var(--text)'};font-weight:${reserved > 0 ? 700 : 400}">${reserved.toLocaleString()}</span></td>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5"><span style="color:var(--green);font-weight:700">${Number(l.available || 0).toLocaleString()}</span></td>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5"><span id="${_rprPsId(l.lotNo)}">${_rprPsBadgeHtml(_rprPrintStatusCache[l.lotNo])}</span></td>
                    <td style="padding:7px 12px;border-bottom:1px solid #eef0f5"><span id="${_rprPrintedAtId(l.lotNo)}">${_rprPrintedAtHtml(_rprPrintStatusCache[l.lotNo])}</span></td>
                </tr>`
        }).join('')

        return `<div style="background:#fff;border:1px solid var(--border);border-radius:9px;overflow:hidden;margin:8px 10px">
            <div style="display:flex;align-items:center;gap:10px;padding:7px 12px;background:#f6f8ff;border-bottom:1px solid var(--border)">
                ${rprLocBadge(locCode)}
                <span style="margin-left:auto;font-size:11.5px;color:var(--t2);font-weight:600;white-space:nowrap">${onHandSum.toLocaleString()} on hand · ${locLots.length} lot${locLots.length === 1 ? '' : 's'}</span>
            </div>
            <div style="max-height:260px;overflow-y:auto">
                <table style="width:100%;border-collapse:collapse;font-size:13px">
                    <thead>
                        <tr>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Lot No.</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">On Hand</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Reserved</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Available</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Print Status</th>
                            <th style="position:sticky;top:0;background:#fafbfe;text-align:left;padding:7px 12px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--border)">Last Printed</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>
        </div>`
    }

    function rprWoRenderSummary() {
        const q      = (document.getElementById('rprWoSummarySearch')?.value || '').trim().toLowerCase()
        const groups = q
            ? _rprWoSumGroups.filter(g => g.partNo.toLowerCase().includes(q) || g.description.toLowerCase().includes(q))
            : _rprWoSumGroups

        document.getElementById('rprWoSummaryCount').textContent = q ? `${groups.length}/${_rprWoSumGroups.length} items` : `${groups.length} items`

        document.getElementById('rprWoSummaryTable').innerHTML = groups.map(g => {
            const open      = _rprWoExpanded.has(g.partNo)
            const locBadges = g.locTypes.map(t => locTypeBadge(t)).join('')

            return `<tr style="cursor:pointer" onclick="rprWoToggleExpand('${g.partNo}')">
                    <td style="padding:9px 10px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                        <button type="button" style="width:24px;height:24px;border-radius:7px;border:1.5px solid var(--border);background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform .15s;${open ? 'transform:rotate(90deg);background:var(--blue);border-color:var(--blue);color:#fff' : 'color:var(--t2)'}">
                            <i class="bi bi-chevron-right" style="font-size:11px"></i>
                        </button>
                    </td>
                    <td style="padding:9px 10px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                        <div style="display:flex;align-items:center;gap:6px">
                            <span style="font-family:ui-monospace,monospace;font-weight:700;font-size:13px;color:var(--navy)">${escHtml(g.partNo)}</span>
                            ${itemTypeBadge(g.itemType)}
                        </div>
                        <div style="font-size:11.5px;color:var(--t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px" title="${escHtml(g.description)}">${escHtml(g.description)}</div>
                    </td>
                    <td style="padding:9px 10px;border-bottom:1px solid #f4f4f7;vertical-align:middle">${_rprWoStockCell(g.onHand, g.target)}</td>
                    <td style="padding:9px 10px;border-bottom:1px solid #f4f4f7;vertical-align:middle"><div style="display:flex;flex-wrap:wrap;gap:4px">${locBadges}</div></td>
                    <td style="padding:9px 10px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                        <span style="background:#f0f2f5;color:#475569;padding:2px 8px;border-radius:5px;font-size:11px;font-weight:600;white-space:nowrap">${g.lots.length} lot${g.lots.length === 1 ? '' : 's'}</span>
                    </td>
                    <td style="padding:9px 10px;border-bottom:1px solid #f4f4f7;vertical-align:middle">
                        <span id="${_rprWoPsId(g.partNo)}">${_rprWoPartPrintStatusCell(g.lots)}</span>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="padding:0;border-bottom:${open ? '1px solid var(--border)' : 'none'}">
                        <div style="${open ? '' : 'display:none'};background:#f8faff;padding:2px 0">${open ? _rprWoLotGroupsHtml(g.lots) : ''}</div>
                    </td>
                </tr>`
        }).join('')

        // ยิงเช็ค Print Status ของ "ทุก" lot ในทุก part ที่แสดงอยู่ตอนนี้ (ไม่ใช่แค่กลุ่มที่ expand) — คอลัมน์ Print Status ที่แถว Part
        // ต้องใช้สรุปสถานะรวมเสมอ ส่ง groups ไปด้วยให้ patch คอลัมน์สรุปที่แถว Part ได้หลัง fetch เสร็จ
        const allVisibleLots = groups.flatMap(g => g.lots)
        if (allVisibleLots.length) _rprWoLoadPrintStatuses(allVisibleLots, groups)
    }

    // ขยายได้ทีละ Part เท่านั้น — เปิด Part ใหม่ = หุบตัวที่เปิดค้างไว้ก่อนหน้าอัตโนมัติ (_rprWoExpanded ยังเป็น Set เพื่อใช้ .has() เดิมได้ แต่มีสมาชิกได้แค่ 0-1 ตัว)
    function rprWoToggleExpand(partNo) {
        const wasOpen = _rprWoExpanded.has(partNo)
        _rprWoExpanded.clear()
        if (!wasOpen) _rprWoExpanded.add(partNo)
        rprWoRenderSummary()
    }

    // Lot ที่ Print Status = Success อยู่แล้ว (จาก _rprPrintStatusCache) ต้องเด้ง confirm ถามก่อนเสมอ กันเผลอ Re-Print ซ้ำโดยไม่ตั้งใจ
    // ตอนกวาดตาหา Lot จาก Search W/O — ตัวที่ยังไม่เคยพิมพ์/พิมพ์ล้มเหลว เพิ่มเข้า list ได้ทันทีเหมือนเดิมไม่ต้อง confirm
    let _rprPendingAlreadyPrintedLot = null   // { lotNo, btn } ที่รอ user ยืนยันอยู่

    async function rprWoAddLot(lotNo, btn) {
        if (!lotNo) return
        if (_rprPrintStatusCache[lotNo]?.status === 'success') {
            _rprPendingAlreadyPrintedLot = { lotNo, btn }
            document.getElementById('rprAlreadyPrintedLotLabel').textContent = lotNo
            document.getElementById('rprConfirmAlreadyPrintedModal').style.display = 'flex'
            return
        }
        await rprWoAddLotConfirmed(lotNo, btn)
    }

    function rprCancelAlreadyPrintedAdd() {
        _rprPendingAlreadyPrintedLot = null
        document.getElementById('rprConfirmAlreadyPrintedModal').style.display = 'none'
    }

    async function rprConfirmAlreadyPrintedAdd() {
        const pending = _rprPendingAlreadyPrintedLot
        _rprPendingAlreadyPrintedLot = null
        document.getElementById('rprConfirmAlreadyPrintedModal').style.display = 'none'
        if (!pending) return
        await rprWoAddLotConfirmed(pending.lotNo, pending.btn)
    }

    async function rprWoAddLotConfirmed(lotNo, btn) {
        if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:10px;height:10px;border-width:2px"></span>' }
        const ok = await rprFetchAndAddByLotNo(lotNo)
        if (ok) showToast('✅ LOT added to Re-Print list', 'success')
        rprWoRenderSummary()   // re-render ให้ปุ่ม Lot No เปลี่ยนเป็น "Added" ตาม rprItems ล่าสุด (กันกดซ้ำ)
    }

    // ── Pick Lot modal (raw barcode ผูกกับหลาย lot ให้เลือกว่าจะ Re-Print lot ไหน) ──
    // ดึง /inventory/lots ของทุก match มาก่อนเลย (ปกติมีไม่กี่รายการ) เพื่อโชว์ Lot/W-O/Part/Qty ให้เทียบกันได้ในลิสต์เดียว
    let _rprPickLots = []

    async function openRprPickLot(matches) {
        document.getElementById('rprPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px"><span class="spinner-border spinner-border-sm me-2"></span>กำลังโหลดข้อมูล…</div>`
        document.getElementById('rprPickLotModal').style.display = 'flex'

        // บังคับ availableOnly เสมอ — lot ที่ของหมด/ไม่ available จะไม่ถูกคืนมาจาก API เลย (lot: null) กรองทิ้งไม่ให้ขึ้นในลิสต์ให้เลือก
        const fetched = await Promise.all((matches || []).map(async m => {
            try {
                const res  = await api('/inventory/lots', 'POST', { lotNo: m.lotNo, page: 1, pageSize: 1, availableOnly: true })
                const list = Array.isArray(res) ? res : (res?.data ?? [])
                return { lotNo: m.lotNo, uniqueId: m.uniqueId, lot: list[0] ?? null }
            } catch (_) {
                return { lotNo: m.lotNo, uniqueId: m.uniqueId, lot: null }
            }
        }))
        _rprPickLots = fetched.filter(m => m.lot)
        document.getElementById('rprPickLotCount').textContent = _rprPickLots.length

        if (!_rprPickLots.length) {
            document.getElementById('rprPickLotList').innerHTML = `<div style="padding:24px;text-align:center;color:var(--t2);font-size:13px">ไม่พบ Lot ที่ Available</div>`
            return
        }

        document.getElementById('rprPickLotList').innerHTML = _rprPickLots.map((m, i) => {
            const lot = m.lot || {}
            return `<button onclick="rprPickLotSelect(${i})" style="width:100%;text-align:left;padding:11px 10px;border:none;border-bottom:1px solid #eee;background:#fff;cursor:pointer;font-family:inherit">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:3px">
                    <span style="font-weight:700;color:var(--navy);font-family:ui-monospace,monospace;font-size:13px">${m.lotNo ?? '—'}</span>
                    <span style="font-size:13px;font-weight:700;color:var(--blue)">${lot.onHandQty ?? '—'} ${lot.unit ?? ''}</span>
                </div>
                <div style="font-size:12px;color:var(--t2);display:flex;gap:12px;flex-wrap:wrap">
                    <span>W/O: ${lot.workOrder || '—'}</span>
                    <span>Part: ${lot.partNo || '—'}</span>
                </div>
            </button>`
        }).join('')
    }

    function closeRprPickLot() {
        document.getElementById('rprPickLotModal').style.display = 'none'
        _rprPickLots = []
    }

    async function rprPickLotSelect(i) {
        const m = _rprPickLots[i]
        closeRprPickLot()
        if (!m || !m.lot) { showToast('ไม่พบ LOT: ' + (m?.lotNo || ''), 'error'); return }
        const ok = await rprAddFromData(m.lot)
        if (ok) {
            showToast('✅ LOT added (' + rprItems.length + '/10)', 'success')
            rpSetCamFooter('✅ LOT added (' + rprItems.length + '/10)')
        } else {
            rpSetCamFooter('⚠️ Unable to add LOT')
        }
    }

    let rprItems = [], rprLayoutConfig = null
    let _rprPrinting = false, _rprShowUnreviewed = false
    let _rprPreviewIdx = 0   // index ของ item ที่กำลังโชว์ใน Label Preview panel

    function rprSelectPreview(idx) {
        _rprPreviewIdx = idx
        if (rprItems[idx]) rprItems[idx].reviewed = true   // แสดงใน Label Preview แล้ว = Review Success
        rprRenderList()
    }

    function rprPreviewNav(delta) {
        const n = rprItems.length
        if (!n) return
        _rprPreviewIdx = Math.min(n - 1, Math.max(0, _rprPreviewIdx + delta))
        if (rprItems[_rprPreviewIdx]) rprItems[_rprPreviewIdx].reviewed = true   // แสดงใน Label Preview แล้ว = Review Success
        rprRenderList()
    }

    function rprRenderPreviewPanel() {
        const n = rprItems.length
        if (_rprPreviewIdx > n - 1) _rprPreviewIdx = n - 1
        if (_rprPreviewIdx < 0) _rprPreviewIdx = 0

        const pagText = document.getElementById('rprPreviewPagText')
        if (pagText) pagText.textContent = n ? `${_rprPreviewIdx + 1} / ${n}` : '0 / 0'
        const pagBtns = document.querySelectorAll('#rprPreviewPag .rcp-pag-btn')
        if (pagBtns[0]) pagBtns[0].disabled = n === 0 || _rprPreviewIdx <= 0
        if (pagBtns[1]) pagBtns[1].disabled = n === 0 || _rprPreviewIdx >= n - 1

        const box  = document.getElementById('rprPreviewImgBox')
        const meta = document.getElementById('rprPreviewMeta')
        if (n === 0) {
            box.innerHTML  = '<div class="rp-empty-state">No items yet — scan or enter LOT NO</div>'
            meta.textContent = ''
        } else if (!document.getElementById('rprLayout')?.value) {
            box.innerHTML  = '<div class="rp-empty-state"><i class="bi bi-exclamation-triangle" style="color:var(--amber)"></i> Please Select Layout</div>'
            meta.textContent = ''
        } else {
            const item = rprItems[_rprPreviewIdx]
            if (item.previewSrc) {
                box.innerHTML = `<img src="${escHtml(item.previewSrc)}" style="max-width:100%;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.12)">`
            } else {
                box.innerHTML = '<div style="color:var(--t3);font-size:13px">⏳ Rendering…</div>'
                const cfg = rprLayoutConfig ?? {}
                const myIdx = _rprPreviewIdx
                renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3).then(src => {
                    if (rprItems[myIdx]) rprItems[myIdx].previewSrc = src
                    if (myIdx === _rprPreviewIdx) rprRenderPreviewPanel()
                }).catch(() => {})
            }
            const cfg       = rprLayoutConfig ?? {}
            const dims      = `${cfg.dpi ?? '8dpmm'} · ${cfg.width ?? 4} x ${cfg.height ?? 3} in`
            const layoutSel = document.getElementById('rprLayout')
            const layoutNm  = layoutSel?.selectedOptions?.[0]?.textContent ?? '—'
            meta.textContent = `Layout: ${layoutNm} · ${dims}`
        }
    }

    function rprShowError(id, show) {
        const el = document.getElementById(id)
        if (!el) return
        el.style.transition  = 'border-color .15s, box-shadow .15s'
        el.style.borderColor = show ? 'var(--red)' : ''
        el.style.boxShadow   = show ? '0 0 0 3px rgba(220,38,38,.15)' : ''
    }

    function rprLayoutChange() {
        const sel = document.getElementById('rprLayout')
        const id  = sel.value
        sel.style.color = id ? 'var(--text)' : 'var(--t3)'   // เทาตอนยังไม่เลือก เหมือนหน้า Receive
        if (!id) { rprLayoutConfig = null; rprRenderPreviewPanel(); return }
        const arr  = sel._layoutsData ?? []
        const tmpl = arr.find(l => String(l.id) === String(id))
        if (!tmpl) { rprLayoutConfig = null; rprRenderPreviewPanel(); return }
        rprLayoutConfig = parseZplDataJson(tmpl)
        rprRebuildAllZpl()
        rprRenderPreviewPanel()
    }

    function rprRebuildItemZpl(item) {
        const cfg = rprLayoutConfig ?? {}
        const sliders = { qrX: cfg.qrX??30, qrY: cfg.qrY??40, qrSize: cfg.qrSize??5, dataX: cfg.dataX??373, dataY: cfg.dataY??58, fontSize: cfg.fontSize??22, lineHeight: cfg.lineHeight??33, valOffset: cfg.valOffset??151 }
        const textFields = buildLabelTextFields(cfg.labelFields, item.data)
        item.zpl = buildZpl({ qrContent: buildQrContent(item.data, cfg.qrFields ?? null), textFields, ...sliders })
        item.previewSrc = null
        renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
            .then(src => { if (rprItems.includes(item)) item.previewSrc = src }).catch(() => {})
    }

    function rprRebuildAllZpl() {
        rprItems.forEach(item => rprRebuildItemZpl(item))
    }

    let _rprPendingRemoveIdx = null

    function rprRemoveItem(idx) {
        _rprPendingRemoveIdx = idx
        document.getElementById('rprDeleteLotLabel').textContent = rprItems[idx]?.data?.lotNo || rprItems[idx]?.data?.partNo || ''
        document.getElementById('rprConfirmDeleteModal').style.display = 'flex'
    }

    function rprCancelRemoveItem() {
        _rprPendingRemoveIdx = null
        document.getElementById('rprConfirmDeleteModal').style.display = 'none'
    }

    function rprConfirmRemoveItem() {
        if (_rprPendingRemoveIdx === null) return
        rprItems.splice(_rprPendingRemoveIdx, 1)
        _rprPendingRemoveIdx = null
        document.getElementById('rprConfirmDeleteModal').style.display = 'none'
        rprRenderList()
    }

    let _rprViewIdx = null

    // badge Location ในตาราง Item List — icon + สีตาม location type จริง (หา type จาก _locNameMap ที่ loadLocation() แชร์
    // กันทั้งระบบ ด้วย location code) เหมือน pattern sessLocTypeBadge() ใน Dashboard.cshtml / rcRenderPalletDropdown ใน _Receive.cshtml
    function rprLocBadge(code) {
        if (!code) return '<span style="color:var(--t3)">—</span>'
        const found = _locNameMap.get(code)
        const name  = found?.displayName ?? code
        const type  = found?.typeName ?? ''
        return `<span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;${locTypeBadgeStyle(type)};white-space:nowrap;display:inline-flex;align-items:center;gap:5px">${locHierTypeIcon(type)}${escHtml(name)}</span>`
    }

    function rprRenderList() {
        const container = document.getElementById('rprItemList')
        const badge     = document.getElementById('rprCounter')
        const n         = rprItems.length
        badge.textContent = `${n}/10`
        badge.className   = 'rp-counter-badge' + (n >= 10 ? ' full' : '')

        rprSyncPrintBtn()
        rprWoRenderSummary()   // sync ปุ่ม Add/Added ใน Search W/O modal ให้ตรงกับ rprItems ล่าสุด — เผื่อมีการลบ/print lot สำเร็จจาก Item List
                                // (ถ้า modal ยังไม่เคยเปิด _rprWoSumGroups ว่างอยู่แล้ว ฟังก์ชันนี้แค่เขียนทับ DOM ที่ซ่อนอยู่ ไม่มีผลอะไร)

        if (n === 0) {
            container.innerHTML = '<div class="rp-empty-state">No items yet — scan or enter LOT NO</div>'
            rprRenderPreviewPanel()
            return
        }

        const cPn  = `font-size:13px;font-weight:700;color:var(--navy);flex:1.4;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap`
        const cLot = `font-size:13px;font-weight:600;color:var(--t2);font-family:monospace;flex:1.6;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap`
        const cQty = `font-size:13px;font-weight:700;color:var(--text);width:42px;flex-shrink:0;text-align:right`
        const cUnt = `font-size:12px;font-weight:600;color:var(--t2);width:48px;flex-shrink:0;text-align:right`
        const cLoc = `flex-shrink:0`

        container.innerHTML = rprItems.map((item, idx) => {
            const d   = item.data
            const err = item.printError
            const dataCols = `
                <div style="${cPn}">${escHtml(d.partNo || '—')}</div>
                <div style="${cLot}">${escHtml(d.lotNo || '—')}</div>
                <div style="${cQty}">${escHtml(fmtQty(d.quantity))}</div>
                <div style="${cUnt}">${escHtml(d.unit || '')}</div>
                <div style="${cLoc}">${rprLocBadge(d.location)}</div>`

            if (item.processing) {
                return `<div class="rp-item-row" style="opacity:0.55" onclick="rprSelectPreview(${idx})">
                    ${dataCols}
                    <div style="width:130px;display:flex;justify-content:flex-end;align-items:center">
                        <i class="bi bi-hourglass-split" style="font-size:15px;color:var(--t2)"></i>
                    </div>
                </div>`
            }

            if (err) {
                const ok = item.reviewed
                return `<div class="rp-item-row" style="flex-direction:column;gap:0;border-left:3px solid var(--red);background:#fff5f5;padding:0;align-items:stretch" onclick="rprSelectPreview(${idx})">
                    <div style="display:flex;align-items:center;gap:16px;padding:8px 14px">
                        ${dataCols}
                        <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;width:160px;justify-content:flex-end">
                            <button onclick="event.stopPropagation();rprViewItemData(${idx})"
                                style="background:${ok ? 'var(--green-lt)' : '#fffbeb'};border:1.5px solid ${ok ? 'var(--green)' : '#f59e0b'};border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;color:${ok ? 'var(--green)' : '#d97706'};cursor:pointer;white-space:nowrap;font-family:inherit;min-width:88px;text-align:center">
                                ${ok ? '✓ Reviewed' : '📋 View Data'}
                            </button>
                            <button class="rp-remove-btn" onclick="event.stopPropagation();rprRemoveItem(${idx})" title="Remove" style="border-color:var(--red);color:var(--red)">✕</button>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:6px;padding:4px 14px 7px;border-top:1px solid #fecaca">
                        <span style="display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;border-radius:4px;padding:1px 6px;white-space:nowrap"><i class="bi bi-printer"></i> Print</span>
                        <span style="font-size:11px;color:var(--red);font-weight:600;line-height:1.4">${escHtml(err)}</span>
                    </div>
                </div>`
            }

            const ok = item.reviewed
            const needsReview = _rprShowUnreviewed && !ok
            const isSelected  = idx === _rprPreviewIdx
            const rowStyle = needsReview
                ? 'border-left:3px solid var(--amber);background:#fffbf0'
                : isSelected ? 'border-left:3px solid var(--blue);background:var(--blue-lt)' : ''
            return `<div class="rp-item-row" style="${rowStyle}" onclick="rprSelectPreview(${idx})">
                ${dataCols}
                <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;width:130px;justify-content:flex-end">
                    <button onclick="event.stopPropagation();rprViewItemData(${idx})"
                        style="background:${ok ? 'var(--green-lt)' : '#fffbeb'};border:1.5px solid ${ok ? 'var(--green)' : '#f59e0b'};border-radius:7px;padding:5px 10px;font-size:11px;font-weight:700;color:${ok ? 'var(--green)' : '#d97706'};cursor:pointer;white-space:nowrap;font-family:inherit;min-width:88px;text-align:center">
                        ${ok ? '✓ Reviewed' : '📋 View Data'}
                    </button>
                    <button class="rp-remove-btn" onclick="event.stopPropagation();rprRemoveItem(${idx})" title="Remove">✕</button>
                </div>
            </div>`
        }).join('')

        rprRenderPreviewPanel()
    }

    function rprViewItemData(idx) {
        const item = rprItems[idx]
        if (!item) return
        const navEl = document.getElementById('rpManualModalNav')
        if (navEl) navEl.style.display = 'none'
        item.reviewed = true
        _rprViewIdx = idx
        rprRenderList()

        const d   = item.data
        const cfg = rprLayoutConfig ?? {}
        const qrFields  = Array.isArray(cfg.qrFields)    ? cfg.qrFields    : []
        const lblFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : []

        const colHdr = document.getElementById('rpManualColHeaders')
        if (colHdr) colHdr.style.display = 'none'

        // ทุก field แก้ไม่ได้ ยกเว้น Production Area — ไม่ว่า role ไหนก็ตาม
        const RO_KEYS = new Set(ALL_FIELD_KEYS.filter(k => k !== 'productionArea'))

        const fieldRowsHtml = ALL_FIELD_KEYS.map(k => {
            const inQr  = qrFields.find(f => f.key === k)?.inQr  ?? false
            const inLbl = lblFields.find(f => f.key === k)?.show  ?? false
            const val   = String(d[k] ?? '')
            const id    = `rprd_${cid(k)}`

            let inputEl
            if (RO_KEYS.has(k)) {
                inputEl = `<div style="font-size:13px;color:var(--t2);padding:7px 10px;background:#f0f2f5;border:1.5px solid var(--border);border-radius:9px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(val) || '—'}</div>`
            } else if (k === 'productionArea') {
                const dispVal = d._productionAreaName || val
                inputEl = `<div style="position:relative">
                    <input id="${id}" class="form-input" value="${escHtml(dispVal)}" data-code="${escHtml(val)}" readonly
                        placeholder="-- เลือก Production Area --"
                        onclick="rprOpenProdAreaDropdown()"
                        onblur="setTimeout(()=>{const dd=document.getElementById('rprProdAreaDropdown');if(dd)dd.style.display='none'},200)"
                        style="font-size:13px;padding:7px 30px 7px 10px;cursor:pointer">
                    <svg style="position:absolute;right:10px;top:50%;transform:translateY(-50%);pointer-events:none;color:var(--t2)" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    <div class="wo-dropdown" id="rprProdAreaDropdown" style="display:none;min-width:100%"></div>
                </div>`
            } else {
                inputEl = `<input id="${id}" class="form-input" value="${escHtml(val)}"
                    style="font-size:13px;padding:7px 10px"
                    placeholder="${escHtml(FIELD_LABELS[k] ?? k)}">`
            }

            return `<div style="display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px 16px;align-items:center;padding:6px 16px;border-bottom:1px solid var(--border)">
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inQr ? 'var(--blue)' : 'var(--border)'};background:${inQr ? 'var(--blue)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inQr ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="display:flex;justify-content:center">
                    <div style="width:14px;height:14px;border-radius:3px;border:1.5px solid ${inLbl ? 'var(--purple,#7c3aed)' : 'var(--border)'};background:${inLbl ? 'var(--purple,#7c3aed)' : '#fff'};display:flex;align-items:center;justify-content:center">
                        ${inLbl ? '<svg width="9" height="9" viewBox="0 0 10 10"><polyline points="1,5 4,8 9,2" stroke="#fff" stroke-width="1.8" fill="none"/></svg>' : ''}
                    </div>
                </div>
                <div style="font-size:13px;font-weight:600;color:var(--navy)">${escHtml(FIELD_LABELS[k])}</div>
                ${inputEl}
            </div>`
        }).join('')

        document.getElementById('rpManualFields').innerHTML = `
            <div style="position:sticky;top:0;z-index:10;background:#fff;border-bottom:2px solid var(--border);display:flex;flex-shrink:0">
                <button id="rprViewTabPreview" onclick="rprSwitchViewTab('preview')"
                    style="padding:10px 18px;font-size:13px;font-weight:700;color:var(--t2);border:none;background:none;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;font-family:inherit">
                    <i class="bi bi-printer me-1"></i>Preview Label
                </button>
                <button id="rprViewTabData" onclick="rprSwitchViewTab('data')"
                    style="padding:10px 18px;font-size:13px;font-weight:700;color:var(--t2);border:none;background:none;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;font-family:inherit">
                    <i class="bi bi-table me-1"></i>Data
                </button>
            </div>
            <div id="rprViewPaneData" style="display:none">
                <div style="display:grid;grid-template-columns:28px 28px 1fr 1fr;gap:6px 16px;align-items:center;padding:5px 16px;background:#f8f9fc;border-bottom:2px solid var(--border)">
                    <div style="text-align:center;font-size:10px;font-weight:700;color:var(--t2);letter-spacing:.05em;text-transform:uppercase">QR</div>
                    <div style="text-align:center;font-size:10px;font-weight:700;color:var(--t2);letter-spacing:.05em;text-transform:uppercase">Label</div>
                    <div style="font-size:10px;font-weight:700;color:var(--t2);letter-spacing:.05em;text-transform:uppercase">Field</div>
                    <div style="font-size:10px;font-weight:700;color:var(--t2);letter-spacing:.05em;text-transform:uppercase">Value</div>
                </div>
                ${fieldRowsHtml}
            </div>
            <div id="rprViewPanePreview" style="display:none;padding:24px;text-align:center;align-items:center;justify-content:center">
                <div id="rprViewPreviewContent"></div>
            </div>`

        document.getElementById('rpManualModalTitle').textContent = 'Item Data #' + (idx + 1)
        document.getElementById('rpManualModalFooter').innerHTML =
            `<button onclick="document.getElementById('rpManualModal').style.display='none'"
                style="flex:1;padding:12px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">
                Cancel
            </button>
            <button onclick="rprSaveItemData()"
                style="flex:1;padding:12px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                Save
            </button>`
        document.getElementById('rpManualModal').style.display = 'flex'
        rprSwitchViewTab('preview')
    }

    let _rprProdAreaList = null   // cache รายการ Production Area (location type = factory)

    async function rprOpenProdAreaDropdown() {
        const dd = document.getElementById('rprProdAreaDropdown')
        if (!dd) return
        if (dd.style.display === 'block') { dd.style.display = 'none'; return }
        if (!_locNameMap.size) {
            dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default">
                <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>⏳ Loading…
            </div>`
            dd.style.display = 'block'
            await loadLocation()
        }
        _rprProdAreaList = Array.from(_locNameMap.values()).filter(loc => (loc.typeName || '').toLowerCase() === 'factory')
        rprRenderProdAreaDropdown()
        dd.style.display = 'block'
    }

    function rprRenderProdAreaDropdown() {
        const dd = document.getElementById('rprProdAreaDropdown')
        if (!dd) return
        if (!_rprProdAreaList || !_rprProdAreaList.length) {
            dd.innerHTML = `<div class="wo-item" style="color:var(--t2);cursor:default"><i class="bi bi-search me-2"></i>ไม่พบ Production Area</div>`
            return
        }
        dd.innerHTML = _rprProdAreaList.map((loc, i) => `
            <div class="wo-item" style="gap:10px" onmousedown="rprPickProdArea(${i})">
                <div style="display:flex;align-items:center;gap:10px;min-width:0">
                    <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0"></i>
                    <span style="font-weight:700">${escHtml(loc.displayName || loc.locationCode)}</span>
                    ${loc.description ? `<span style="font-size:12px;color:var(--t2)">${escHtml(loc.description)}</span>` : ''}
                </div>
            </div>`).join('')
    }

    function rprPickProdArea(i) {
        const loc   = _rprProdAreaList?.[i]
        const input = document.getElementById('rprd_productionArea')
        if (!loc || !input) return
        input.value        = loc.displayName || loc.locationCode
        input.dataset.code = loc.locationCode
        document.getElementById('rprProdAreaDropdown').style.display = 'none'
    }

    function rprSaveItemData() {
        const idx  = _rprViewIdx
        const item = rprItems[idx]
        if (!item) return
        // ทุก field แก้ไม่ได้ ยกเว้น Production Area — ไม่ว่า role ไหนก็ตาม
        const RO_SAVE = new Set(ALL_FIELD_KEYS.filter(k => k !== 'productionArea'))
        ALL_FIELD_KEYS.filter(k => !RO_SAVE.has(k)).forEach(k => {
            const el = document.getElementById(`rprd_${cid(k)}`)
            if (!el) return
            if (k === 'productionArea') {
                item.data.productionArea      = el.dataset.code || el.value.trim()
                item.data._productionAreaName = el.value.trim()
            } else {
                item.data[k] = el.value.trim()
            }
        })
        const cfg         = rprLayoutConfig ?? {}
        const sliders     = { qrX: cfg.qrX??30, qrY: cfg.qrY??40, qrSize: cfg.qrSize??5, dataX: cfg.dataX??373, dataY: cfg.dataY??58, fontSize: cfg.fontSize??22, lineHeight: cfg.lineHeight??33, valOffset: cfg.valOffset??151 }
        const textFields  = buildLabelTextFields(cfg.labelFields, item.data)
        item.zpl = buildZpl({ qrContent: buildQrContent(item.data, cfg.qrFields ?? null), textFields, ...sliders })
        item.previewSrc = null
        renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
            .then(src => { if (rprItems[idx]) rprItems[idx].previewSrc = src }).catch(() => {})
        rprRenderList()
        document.getElementById('rpManualModal').style.display = 'none'
        showToast('✅ Saved', 'success')
    }

    function rprSwitchViewTab(tab) {
        const dataPane    = document.getElementById('rprViewPaneData')
        const previewPane = document.getElementById('rprViewPanePreview')
        const dataBtn     = document.getElementById('rprViewTabData')
        const previewBtn  = document.getElementById('rprViewTabPreview')
        if (!dataPane) return
        if (tab === 'data') {
            dataPane.style.display    = ''
            previewPane.style.display = 'none'
            dataBtn.style.color       = 'var(--blue)';  dataBtn.style.borderBottom    = '2px solid var(--blue)'
            previewBtn.style.color    = 'var(--t2)';    previewBtn.style.borderBottom = '2px solid transparent'
        } else {
            dataPane.style.display    = 'none'
            previewPane.style.display = 'flex'
            dataBtn.style.color       = 'var(--t2)';    dataBtn.style.borderBottom    = '2px solid transparent'
            previewBtn.style.color    = 'var(--blue)';  previewBtn.style.borderBottom = '2px solid var(--blue)'
            const item    = rprItems[_rprViewIdx]
            const content = document.getElementById('rprViewPreviewContent')
            if (!item || !content) return
            if (!document.getElementById('rprLayout')?.value) {
                content.innerHTML = '<div class="rp-empty-state"><i class="bi bi-exclamation-triangle" style="color:var(--amber)"></i> Please Select Layout</div>'
                return
            }
            content.innerHTML = '<div style="color:var(--t3);font-size:13px">⏳ Loading…</div>';
            (async () => {
                try {
                    let src = item.previewSrc
                    if (!src) {
                        const cfg = rprLayoutConfig ?? {}
                        src = await renderZplClient(item.zpl, cfg.dpi ?? '8dpmm', cfg.width ?? 4, cfg.height ?? 3)
                        if (item) item.previewSrc = src
                    }
                    content.innerHTML = src
                        ? `<img src="${escHtml(src)}" style="max-width:100%;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.12)">`
                        : '<div style="color:var(--amber);font-size:13px">Preview not available</div>'
                } catch (err) {
                    content.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
                }
            })()
        }
    }

    function rprSyncPrintBtn() {
        const n       = rprItems.length
        const enabled = !_rprPrinting && n > 0
        document.querySelectorAll('[onclick="rprDoPrint()"]').forEach(btn => {
            btn.disabled      = !enabled
            btn.style.opacity = enabled ? '1' : '0.45'
            btn.style.cursor  = enabled ? 'pointer' : 'not-allowed'
            btn.title = _rprPrinting ? 'Printing in progress…' : n === 0 ? 'Add items first' : ''
        })
        // auto-clear printer error once printer is selected
        const _curPrinterIp = document.getElementById('rpReprintPrinterSelect')?.value
        if (_curPrinterIp) {
            rprShowError('rpReprintPrinterTrigger', false)
            // เคลียร์ warning location mismatch เฉพาะตอนเปลี่ยนไปเลือก printer เครื่องอื่นจริงๆ (เทียบกับตัวที่ตอนกด Re-Print แล้วเจอ
            // mismatch ไว้) ไม่ใช่แค่ "มี printer ถูกเลือกอยู่" เฉยๆ เพราะตอน mismatch ก็มี printer เลือกไว้อยู่แล้วตั้งแต่แรก ถ้าเคลียร์
            // ตามเงื่อนไขเดิม (มี printer = เคลียร์) warning จะหายไปเงียบๆ ทันทีที่ rprRenderList() รันรอบถัดไปโดย user ยังไม่ทันเห็นด้วยซ้ำ
            if (_rprLocMismatchForPrinterIp && _curPrinterIp !== _rprLocMismatchForPrinterIp) {
                _rprHideLocMismatch()
            }
        }
        // auto-clear unreviewed highlight if all reviewed
        if (_rprShowUnreviewed && n > 0 && rprItems.every(i => i.reviewed)) {
            _rprShowUnreviewed = false
        }
    }

    // ── ข้อความ i18n (EN/TH) — หน้านี้ยังไม่มีระบบสลับภาษาจริง (ต่างจาก Move.cshtml/Receive.cshtml ที่มี dict()/onLangChange)
    // เก็บเป็น key แยก EN/TH ไว้ก่อนเผื่อต่อเข้าระบบแปลภาษาทีหลัง ตอนนี้ใช้ .th โชว์ toast ให้ตรงกับข้อความอื่นในหน้านี้ที่เป็นไทยทั้งหมด ──
    const RPR_I18N = {
        printLocationMismatch: {
            en: 'Please Re-Print in same location as LOT',
            th: 'กรุณา Re-Print ที่โลเคชันเดียวกับ Lot นี้เท่านั้น',
        },
    }

    // มี permission WMS.UI.Reprint.Location หรือเป็น Admin ถึงจะข้ามการเช็ค location match ระหว่าง Printer กับ Lot ได้
    // (isAdmin เป็น global จาก script หลักของ PrintQR.cshtml อยู่แล้ว — ไม่ใช่ตัวใน IIFE ของ _Receive.cshtml ที่ scope ปิดแยกไว้)
    function _rprHasLocationPermission() {
        if (isAdmin) return true
        try {
            const user  = JSON.parse(localStorage.getItem('user') || '{}')
            const perms = Array.isArray(user.permissions) ? user.permissions : []
            return perms.includes('WMS.UI.Reprint.Location')
        } catch (_) {
            return false
        }
    }

    // ── inline warning banner สำหรับ location mismatch โดยเฉพาะ — แยกจาก rprShowError('rpReprintPrinterTrigger') เพราะตัวนั้นโดน
    // rprSyncPrintBtn() auto-clear ทันทีที่มี printer ถูกเลือกไว้ (ซึ่ง mismatch ก็มี printer เลือกไว้แล้วตั้งแต่แรกอยู่ดี) ──
    let _rprLocMismatchForPrinterIp = null   // printerIp ที่ตอนกด Re-Print แล้วเจอ mismatch — เทียบกันตอนจะเคลียร์ว่า user เปลี่ยน printer จริงไหม

    function _rprShowLocMismatch(msg, printerIp) {
        _rprLocMismatchForPrinterIp = printerIp
        const el  = document.getElementById('rprLocMismatchWarning')
        const txt = document.getElementById('rprLocMismatchWarningText')
        if (!el || !txt) return
        txt.textContent = msg
        el.style.display = 'flex'
    }

    function _rprHideLocMismatch() {
        _rprLocMismatchForPrinterIp = null
        const el = document.getElementById('rprLocMismatchWarning')
        if (el) el.style.display = 'none'
    }

    // location type ของ printer ที่เลือกอยู่ — หาจาก _rpAllPrinters (global, printer.locationId) เทียบกับ _locIdMap (จาก loadLocation())
    function _rprGetPrinterLocationType(printerIp) {
        const printer = (typeof _rpAllPrinters !== 'undefined' ? _rpAllPrinters : []).find(p => p.printerIp === printerIp)
        if (!printer) return null
        return _locIdMap.get(printer.locationId)?.typeName ?? null
    }

    // location type ของ Lot แต่ละ item — หาจาก item.data.location (location code จาก /inventory/lots) เทียบกับ _locNameMap
    function _rprGetLotLocationType(item) {
        const code = item.data.location
        if (!code) return null
        return _locNameMap.get(code)?.typeName ?? null
    }

    async function rprDoPrint() {
        if (rprItems.length === 0 || _rprPrinting) return

        // Validate: Layout Template
        const layoutVal = document.getElementById('rprLayout')?.value
        if (!layoutVal) {
            rprShowError('rprLayout', true)
            document.getElementById('rprLayout')?.scrollIntoView({ behavior: 'smooth', block: 'center' })
            setTimeout(() => document.getElementById('rprLayout')?.focus(), 300)
            showToast('กรุณาเลือก Layout Template', 'error')
            return
        }

        // Validate: Printer
        const printerSel  = document.getElementById('rpReprintPrinterSelect')
        const printerIp   = printerSel?.value
        const printerPort = printerSel?.dataset.port || 9100
        if (!printerIp) {
            rprShowError('rpReprintPrinterTrigger', true)
            document.getElementById('rpReprintPrinterTrigger')?.focus()
            showToast('กรุณาเลือก Printer', 'error')
            return
        }

        // Validate: Location match — เฉพาะคนไม่มี permission WMS.UI.Reprint.Location และไม่ใช่ Admin เท่านั้นที่ต้องเช็ค
        // (คนมี permission นี้/Admin ปริ้นข้ามโลเคชันได้เลย ไม่ต้องเช็ค) เทียบ location type ของ Lot กับของ Printer ที่เลือกไว้
        // ไม่ตรงกัน = block ทั้ง batch เลย (ไม่ปริ้นบางส่วน) ถ้า type ฝั่งไหนหาไม่เจอ (ไม่ผูก location ไว้) ไม่ block เพราะฟันธง mismatch ไม่ได้
        if (!_rprHasLocationPermission()) {
            const printerLocType = _rprGetPrinterLocationType(printerIp)
            const mismatchItem = rprItems.find(item => {
                const lotLocType = _rprGetLotLocationType(item)
                return lotLocType && printerLocType && lotLocType !== printerLocType
            })
            if (mismatchItem) {
                rprShowError('rpReprintPrinterTrigger', true)
                _rprShowLocMismatch(RPR_I18N.printLocationMismatch.th, printerIp)
                document.getElementById('rpReprintPrinterTrigger')?.scrollIntoView({ behavior: 'smooth', block: 'center' })
                showToast(RPR_I18N.printLocationMismatch.th, 'error')
                return
            }
        }
        _rprHideLocMismatch()

        // Validate: Print Reason (required)
        const reasonVal = (document.getElementById('rpReprintReason')?.value || '').trim()
        if (!reasonVal) {
            rprShowError('rpReprintReason', true)
            document.getElementById('rpReprintReason')?.scrollIntoView({ behavior: 'smooth', block: 'center' })
            setTimeout(() => document.getElementById('rpReprintReason')?.focus(), 300)
            showToast('กรุณากรอก Print Reason', 'error')
            return
        }

        // Validate: All items reviewed
        const unreviewed = rprItems.filter(i => !i.reviewed).length
        if (unreviewed > 0) {
            _rprShowUnreviewed = true
            rprRenderList()
            showToast(`กรุณา View Data ก่อน Re-Print (${unreviewed} item ยังไม่ได้ตรวจสอบ)`, 'error')
            return
        }

        _rprShowUnreviewed = false
        _rprPrinting = true
        rprRenderList()

        try {
            for (const item of [...rprItems]) {
                await _rprPrintItem(item, printerIp, printerPort)
            }
        } finally {
            _rprPrinting = false
            if (rprItems.length === 0) showToast('🖨️ Re-Printed all items successfully', 'success')
            rprRenderList()
        }
    }

    async function _rprPrintItem(item, printerIp, printerPort) {
        item.processing = true
        item.printError = null
        rprRenderList()

        const reason = (document.getElementById('rpReprintReason')?.value || '').trim()
        try {
            // {printedAt} เพิ่งมีค่าจริงตอนกำลังจะส่งพิมพ์เท่านั้น — ใช้เวลาจริงจาก server (_fetchServerPrintedAt) ไม่ใช่เวลาฝั่ง
            // client เพราะนาฬิกาเครื่อง user อาจเพี้ยนได้ ต้อง fetch สดทุกครั้งเสมอแม้ Re-Print ซ้ำหลายครั้งก็ตาม (pattern เดียวกับ _Receive.cshtml)
            item.data.printedAt = await _fetchServerPrintedAt()
            rprRebuildItemZpl(item)
            const payload = {
                printerIp,
                printerPort,
                lotNo:         item.data.lotNo ?? '',
                uniqueId:      item.data.uniqueId ?? '',
                zpl:           applyPrintOffset(item.zpl, rprLayoutConfig),
                isReprint:     true,
                reprintReason: reason || 'Re-Print',
            }
            console.log('[Re-Print] payload →', JSON.stringify(payload, null, 2))
            // printerSend (js/bluetoothPrinter.js): printer ปกติยิง /printer/send เหมือนเดิม, printer โหมด Bluetooth ส่งตรงจาก browser
            // (สำเร็จคืน null, ไม่สำเร็จ throw เข้า catch ด้านล่าง) — โหมด Bluetooth ต้องรอเครื่องพร้อมรับการเชื่อมต่อใหม่ได้เป็นช่วงๆ เลยแจ้ง user ครั้งเดียวพอ
            const res = await printerSend(payload, {
                onRetry: attempt => { if (attempt === 1) showToast('เครื่องพิมพ์ Bluetooth ยังไม่พร้อม กำลังลองเชื่อมต่อใหม่…', 'info') },
            })
            console.log('[Re-Print] response →', res)
            const pd = res?.problemDetails
            if (pd || (res?.statusCode && res.statusCode >= 400)) {
                const msg = [pd?.title, pd?.detail].filter(Boolean).join(': ') || res?.value?.message || res?.message || 'Print failed'
                const toastMsg = res?.statusCode ? `${res.statusCode}: ${msg}` : msg
                console.error('[Re-Print] API error response', { lotNo: item.data.lotNo, printerIp, statusCode: res?.statusCode, problemDetails: pd, fullResponse: res })
                item.printError = msg
                item.reviewed   = false
                // Print failed — fetch a fresh real uniqueId for the next attempt
                item.data.uniqueId = await _fetchUniqueId()
                rprRebuildItemZpl(item)
                showToast(`❌ ${item.data.lotNo || ''}: ${toastMsg}`, 'error')
            } else {
                const i = rprItems.indexOf(item)
                if (i !== -1) rprItems.splice(i, 1)
            }
        } catch (err) {
            console.error('[Re-Print] Exception', { lotNo: item.data.lotNo, printerIp, error: err })
            item.printError = err.message || 'Print error'
            item.reviewed   = false
            // Print failed — fetch a fresh real uniqueId for the next attempt
            item.data.uniqueId = await _fetchUniqueId()
            rprRebuildItemZpl(item)
            showToast(`❌ ${item.data.lotNo || ''}: ${item.printError}`, 'error')
        } finally {
            item.processing = false
            rprRenderList()
        }
    }
</script>
