    // ── Printers ──
    // ── Printers ──
    async function loadPrinterTab() {
        const tbody = document.getElementById('printersTable')
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:var(--t3);padding:24px">⏳ กำลังโหลด…</td></tr>`
        try {
            // เรียกทั้ง 2 API พร้อมกัน
            const [allRes, discoverRes] = await Promise.allSettled([
                api('/printer/all', 'GET'),
                api('/printer/discover', 'GET'),
            ])
            const printers  = allRes.status === 'fulfilled'
                ? (Array.isArray(allRes.value) ? allRes.value : (allRes.value?.data ?? []))
                : []
            const discovered = discoverRes.status === 'fulfilled'
                ? (Array.isArray(discoverRes.value) ? discoverRes.value : (discoverRes.value?.data ?? discoverRes.value?.printers ?? []))
                : []

            // สร้าง map IP → online status จาก discover
            const onlineMap = {}
            discovered.forEach(d => {
                const ip = d.ip ?? d.ipAddress ?? d.printerIp ?? ''
                if (ip) onlineMap[ip] = d.online !== false
            })

            document.getElementById('printerCount').textContent = printers.length
            if (printers.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:var(--t3);padding:32px">ยังไม่มีเครื่องพิมพ์ — กด "+ Add Printer" เพื่อเพิ่ม</td></tr>`
                return
            }

            const networkBadge = (online) => {
                if (online === null) return `<span style="font-size:12px;color:var(--t3)">—</span>`
                const color = online ? 'var(--green)' : 'var(--red)'
                const label = online ? 'Online' : 'Offline'
                return `<span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;color:${color}">
                    <span style="width:8px;height:8px;border-radius:50%;background:${color};flex-shrink:0"></span>${label}
                </span>`
            }

            tbody.innerHTML = printers.map(p => {
                const active  = p.isActive !== false
                const ip      = p.printerIp ?? ''
                const online  = onlineMap.hasOwnProperty(ip) ? onlineMap[ip] : null
                const activeTxt = active
                    ? `<span style="font-size:12px;font-weight:700;color:var(--green)">Active</span>`
                    : `<span style="font-size:12px;font-weight:600;color:var(--t3)">Inactive</span>`
                return `<tr>
                    <td>${networkBadge(online)}</td>
                    <td style="font-weight:600;color:var(--navy)">${p.printerName ?? '—'}</td>
                    <td style="font-family:ui-monospace,monospace;font-size:12px">${ip || '—'}</td>
                    <td>${activeTxt}</td>
                    <td style="white-space:nowrap">
                        <button onclick="openPrinterModal(${JSON.stringify(p).replace(/"/g,'&quot;')})"
                            style="background:none;border:none;cursor:pointer;color:var(--amber);font-size:16px;padding:4px 6px;border-radius:6px"
                            title="Edit"><i class="bi bi-pencil"></i></button>
                        <button onclick="deletePrinter(${p.id})"
                            style="background:none;border:none;cursor:pointer;color:var(--red);font-size:16px;padding:4px 6px;border-radius:6px"
                            title="Delete"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>`
            }).join('')
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:var(--red);padding:24px">Load failed: ${err.message}</td></tr>`
        }
    }

    function openPrinterModal(p) {
        document.getElementById('printerModalTitle').textContent = p ? 'Edit Printer' : 'Add Printer'
        document.getElementById('printerId').value   = p?.id          ?? ''
        document.getElementById('printerName').value = p?.printerName ?? ''
        document.getElementById('printerIp').value   = p?.printerIp   ?? ''
        const activeChk = document.getElementById('printerActive')
        if (activeChk) activeChk.checked = p?.isActive !== false
        clearModalError('printerError')
        openModal('printerModal')
    }

    async function savePrinter() {
        const name     = document.getElementById('printerName').value.trim()
        const ip       = document.getElementById('printerIp').value.trim()
        const isActive = document.getElementById('printerActive')?.checked ?? true
        const id       = document.getElementById('printerId').value
        if (!name) { showModalError('printerError', 'กรุณากรอก Printer Name'); return }
        if (!ip)   { showModalError('printerError', 'กรุณากรอก IP Address'); return }
        const body = { printerName: name, printerIp: ip, isActive }
        try {
            if (id) await api(`/printer/edit-printer/${id}`, 'PUT', { id: +id, ...body })
            else    await api('/printer/add-printer', 'POST', body)
            closeModal('printerModal')
            showToast('บันทึก Printer สำเร็จ', 'success')
            loadPrinterTab()
        } catch (err) { showModalError('printerError', err.message) }
    }

    async function deletePrinter(id) {
        if (!confirm('ลบ Printer นี้?')) return
        try {
            await api(`/printer/delete-printer/${id}`, 'DELETE')
            showToast('ลบ Printer สำเร็จ', 'success')
            loadPrinterTab()
        } catch (err) { showToast('ลบไม่สำเร็จ: ' + err.message, 'error') }
    }

    // ── Packages ──
    function _fmtDim(x) {
        const w = x.width ?? '—', h = x.height ?? '—', l = x.length ?? '—'
        return `${w} × ${h} × ${l}`
    }

    async function loadPackages(page = 1) {
        const search = document.getElementById('pkgSearch').value.trim()
        const ps     = parseInt(document.getElementById('pkgPageSize').value)
        let url = `/master/package?page=${page}&pageSize=${ps}`
        if (search) url += `&search=${encodeURIComponent(search)}`
        try {
            const res   = await api(url)
            const items = Array.isArray(res) ? res : (res?.data || [])
            const total = res?.total ?? res?.totalCount ?? items.length
            const cp    = res?.page ?? page
            document.getElementById('pkgCount').textContent = total + ' items'
            renderPagination('pkgPagination', 'pkgPageInfo', cp, Math.ceil(total / ps) || 1, 'loadPackages')
            document.getElementById('pkgTable').innerHTML = items.length === 0
                ? `<tr><td colspan="8" style="text-align:center;color:var(--t3);padding:32px">No packages found</td></tr>`
                : items.map(x => `<tr>
                    <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${x.packageNo ?? '—'}</td>
                    <td style="font-family:ui-monospace,monospace;font-size:12px;color:var(--t2)">${_fmtDim(x)}</td>
                    <td style="text-align:center;color:var(--t2)">${x.dimensionUnit ?? '—'}</td>
                    <td style="font-weight:600;color:var(--navy)">${x.weight ?? '—'}</td>
                    <td style="text-align:center;color:var(--t2)">${x.weightUnit ?? '—'}</td>
                    <td style="color:var(--t2);font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${x.description ?? '—'}</td>
                    <td style="color:var(--t3);font-size:12px">${x.createdAt ? new Date(x.createdAt).toLocaleString('th-TH',{dateStyle:'short',timeStyle:'short'}) : '—'}</td>
                    <td style="white-space:nowrap">
                        <button onclick="openPkgModal(${JSON.stringify(x).replace(/"/g,'&quot;')})"
                            style="background:none;border:none;cursor:pointer;color:var(--amber);font-size:16px;padding:4px 6px;border-radius:6px" title="Edit">
                            <i class="bi bi-pencil"></i></button>
                        <button onclick="deletePackage(${x.id})"
                            style="background:none;border:none;cursor:pointer;color:var(--red);font-size:16px;padding:4px 6px;border-radius:6px" title="Delete">
                            <i class="bi bi-trash"></i></button>
                    </td>
                </tr>`).join('')
        } catch (err) {
            document.getElementById('pkgTable').innerHTML =
                `<tr><td colspan="8" style="text-align:center;color:var(--red);padding:32px">Load failed: ${err.message}</td></tr>`
        }
    }

