    async function bomLoadDetail(id) {
        document.getElementById('bomDetailEmpty').style.display   = 'none'
        document.getElementById('bomDetailContent').style.display = 'block'
        document.getElementById('bomDetailPartNo').textContent    = '⏳'
        document.getElementById('bomDetailQty').textContent       = '—'
        document.getElementById('bomDetailVersion').textContent   = '—'
        document.getElementById('bomCompTableBody').innerHTML     =
            `<tr><td colspan="5" style="text-align:center;color:var(--t3);padding:16px">กำลังโหลด…</td></tr>`
        try {
            // Prefer cached data; fallback to API call
            let bom = _bomProfilesCache.find(x => x.id === id)
            if (!bom) bom = await api(`/master/bom-profiles/${id}`)
            if (!bom) throw new Error('Not found')

            const comps  = Array.isArray(bom.components) ? bom.components : []
            const outQty = bom.outputQuantity ?? 0

            document.getElementById('bomDetailPartNo').textContent    = bom.outputPartNo ?? '—'
            document.getElementById('bomDetailQty').textContent       = outQty || '—'
            document.getElementById('bomDetailVersion').textContent   = bom.version ?? '—'
            document.getElementById('bomDetailCompCount').textContent = comps.length

            const fmtRatio = (qty) => {
                if (!outQty || qty == null) return '—'
                const r = qty / outQty
                return r % 1 === 0 ? String(r) : r.toFixed(4).replace(/\.?0+$/, '')
            }
            document.getElementById('bomCompTableBody').innerHTML = comps.length === 0
                ? `<tr><td colspan="5" style="text-align:center;color:var(--t3);padding:24px">ยังไม่มี component — กด + Add Component</td></tr>`
                : comps.map((c, i) => `<tr>
                        <td style="color:var(--t3);font-size:12px">${i + 1}</td>
                        <td><span class="mono">${c.component ?? '—'}</span></td>
                        <td style="font-weight:700;color:var(--blue)">${c.quantity ?? '—'}</td>
                        <td style="font-weight:700;color:var(--navy)">${fmtRatio(c.quantity)}</td>
                        <td style="white-space:nowrap;display:flex;gap:4px;padding:9px 8px">
                            <button class="btn-edit" onclick="bomEditComp(${id},'${escJs(c.component ?? '')}',${c.quantity})" title="Edit"
                                style="width:28px;height:28px;padding:0;display:flex;align-items:center;justify-content:center">
                                <i class="bi bi-pencil-square" style="font-size:12px"></i>
                            </button>
                            <button class="btn-edit" onclick="bomRemoveComp(${id},'${escJs(c.component ?? '')}')" title="Delete"
                                style="width:28px;height:28px;padding:0;display:flex;align-items:center;justify-content:center;color:var(--red);border-color:var(--red);background:#fef2f2">
                                <i class="bi bi-trash3" style="font-size:12px"></i>
                            </button>
                        </td>
                    </tr>`).join('')
        } catch (err) {
            document.getElementById('bomDetailPartNo').textContent = 'Load failed'
            console.error('bomLoadDetail:', err)
        }
    }

