        <div class="hero-content">
            <div class="hero-title">Smart Factory<br>Inventory System</div>
            <div class="hero-sub">ระบบจัดการคลังสินค้า</div>
            
        </div>
    </div>

    <!-- ── FORM ── -->
    <div class="form-side">
        <div class="form-header">
            <img src="image/packaging_icon.png" class="form-logo" alt="logo">
            <span class="form-brand">SmartFactory</span>
            <button class="theme-toggle" onclick="toggleTheme()" id="themeBtn" title="Toggle theme">
                <i class="bi bi-moon-fill" id="themeIcon"></i>
            </button>
        </div>

        <div class="form-body">
            <div class="form-title">Create Account</div>

            <form id="regForm" onsubmit="event.preventDefault();register()">
                <div class="field-grid">
                    <div class="field">
                        <label>Employee Code</label>
                        <input id="employeeCode" type="text" placeholder="EMP-0001" autocomplete="off">
                    </div>
                    <div class="field">
                        <label>Username</label>
                        <input id="username" type="text" placeholder="Username" autocomplete="username">
                    </div>
                    <div class="field field-full">
                        <label>Display Name</label>
                        <input id="displayName" type="text" placeholder="ชื่อที่แสดงในระบบ" autocomplete="name">
                    </div>
                    <div class="field field-full">
                        <label>Email</label>
                        <input id="email" type="email" placeholder="name@@company.com" autocomplete="email">
                    </div>
                    <div class="field">
                        <label>Password</label>
                        <div class="field-password">
                            <input id="password" type="password" placeholder="••••••••" autocomplete="new-password">
                            <button class="toggle-pw" type="button" onclick="togglePw('password','eyeIcon1')" tabindex="-1">
                                <i class="bi bi-eye" id="eyeIcon1"></i>
                            </button>
                        </div>
                    </div>
                    <div class="field">
                        <label>Confirm Password</label>
                        <div class="field-password">
                            <input id="confirmPassword" type="password" placeholder="••••••••" autocomplete="new-password"
                                oninput="checkPwMatch()">
                            <button class="toggle-pw" type="button" onclick="togglePw('confirmPassword','eyeIcon2')" tabindex="-1">
                                <i class="bi bi-eye" id="eyeIcon2"></i>
                            </button>
                        </div>
                        <div class="pw-hint" id="pwHint"></div>
                    </div>
                </div>

                <button class="btn-signup" id="signupBtn" type="submit">
                    <span>Create Account</span>
                    <span class="arrow">›</span>
                </button>
                <div class="signup-err" id="signupErr"></div>
                <div class="signup-ok" id="signupOk"><i class="bi bi-check-circle-fill"></i><span>สร้างบัญชีสำเร็จ — กำลังพาไปหน้า Sign In…</span></div>
            </form>

            <div class="form-switch">มีบัญชีอยู่แล้ว? <a href="login">Sign In</a></div>
        </div>

        <div class="form-footer">© 2026 SmartFactory Inc.</div>
    </div>

    <script src="js/config.js"></script>
    <script>
        // ── Theme ──
        const THEME_KEY = 'sf_theme'   // ใช้ key เดียวกับหน้า Inventory (_Layout.cshtml) เพื่อให้ theme sync กันข้ามหน้า
        const html      = document.documentElement

        function applyTheme(t) {
            html.setAttribute('data-theme', t)
            document.getElementById('themeIcon').className =
                t === 'dark' ? 'bi bi-moon-fill' : 'bi bi-sun-fill'
            localStorage.setItem(THEME_KEY, t)
        }

        function toggleTheme() {
            applyTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark')
        }

        applyTheme(localStorage.getItem(THEME_KEY) || 'light')

        // ── Password toggle ──
        function togglePw(inputId, iconId) {
            const inp  = document.getElementById(inputId)
            const icon = document.getElementById(iconId)
            inp.type = inp.type === 'password' ? 'text' : 'password'
            icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash'
        }

        function checkPwMatch() {
            const pw      = document.getElementById('password').value
            const confirm = document.getElementById('confirmPassword').value
            const hint    = document.getElementById('pwHint')
            const inp     = document.getElementById('confirmPassword')
            if (!confirm) { hint.textContent = ''; hint.className = 'pw-hint'; inp.classList.remove('invalid'); return }
            const match = pw === confirm
            hint.textContent = match ? 'รหัสผ่านตรงกัน' : 'รหัสผ่านไม่ตรงกัน'
            hint.className   = 'pw-hint ' + (match ? 'match' : 'mismatch')
            inp.classList.toggle('invalid', !match)
        }

        // ── Register ──
        function showErr(msg) {
            document.getElementById('signupOk').style.display = 'none'
            const el = document.getElementById('signupErr')
            el.textContent = msg; el.style.display = 'block'
        }
        function clearMsgs() {
            document.getElementById('signupErr').style.display = 'none'
            document.getElementById('signupOk').style.display  = 'none'
        }
        function markInvalid(id, invalid) {
            document.getElementById(id).classList.toggle('invalid', invalid)
        }

        async function register() {
            clearMsgs()
            const btn           = document.getElementById('signupBtn')
            const employeeCode  = document.getElementById('employeeCode').value.trim()
            const username      = document.getElementById('username').value.trim()
            const displayName   = document.getElementById('displayName').value.trim()
            const email         = document.getElementById('email').value.trim()
            const password      = document.getElementById('password').value
            const confirmPwd    = document.getElementById('confirmPassword').value

            ;['employeeCode','username','displayName','email','password','confirmPassword'].forEach(id => markInvalid(id, false))

            const missing = []
            if (!employeeCode) missing.push('employeeCode')
            if (!username)     missing.push('username')
            if (!displayName)  missing.push('displayName')
            if (!email)        missing.push('email')
            if (!password)     missing.push('password')
            if (missing.length) {
                missing.forEach(id => markInvalid(id, true))
                showErr('กรุณากรอกข้อมูลให้ครบทุกช่อง')
                return
            }
            if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                markInvalid('email', true)
                showErr('รูปแบบอีเมลไม่ถูกต้อง')
                return
            }
            if (password !== confirmPwd) {
                markInvalid('confirmPassword', true)
                showErr('รหัสผ่านไม่ตรงกัน')
                return
            }

            const body = { employeeCode, username, displayName, password, email, authType: 0 }

            btn.disabled = true
            btn.innerHTML = '<span>กำลังสร้างบัญชี…</span>'
            try {
                const res = await fetch(CONFIG.AUTH_API + '/users/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                })
                if (!res.ok) {
                    showErr('สร้างบัญชีไม่สำเร็จ: ' + ((await res.text()) || res.statusText))
                    return
                }
                document.getElementById('signupOk').style.display = 'flex'
                document.getElementById('regForm').querySelectorAll('input,button').forEach(el => el.disabled = true)
                setTimeout(() => { window.location = 'login' }, 1500)
            } catch (e) {
                showErr('Connection error: ' + e.message)
            } finally {
                btn.disabled = false
                btn.innerHTML = '<span>Create Account</span><span class="arrow">›</span>'
            }
        }
    </script>
</body>
</html>
