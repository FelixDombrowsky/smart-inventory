                editingRow.querySelector(".rowVendor").value   = extras.vendor;
                editingRow.querySelector(".rowDc").value       = extras.dateCode;
                editingRow.querySelector(".rowTc").value       = extras.tradingCode;
                editingRow.querySelector(".rowPo").value       = extras.po;
