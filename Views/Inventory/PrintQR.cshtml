                        <div style="display:flex;align-items:center;gap:6px">
                            <input type="range" id="slValOffset" min="0" max="400" value="151" oninput="syncSlider('slValOffset','vValOffset');dsPreviewDebounce()">
                            <input type="number" id="vValOffset" class="slider-val-input" value="151" onchange="syncInputToSlider('vValOffset','slValOffset');dsPreviewDebounce()" onkeydown="if(event.key==='Enter'){syncInputToSlider('vValOffset','slValOffset');dsPreviewDebounce();this.blur()}">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Field List -->
        <div class="card" style="margin-bottom:16px">
            <div class="card-body" style="padding:18px">
                <div style="font-size:13px;font-weight:700;color:var(--purple,#7c3aed);margin-bottom:14px">✏️ ข้อมูลที่แสดงบน LABEL</div>
                <div id="dsFieldList" style="display:flex;flex-direction:column;gap:6px"></div>
            </div>
        </div>

        <!-- Save -->
        <div style="display:flex;gap:10px">
            <button class="btn-primary" onclick="dsDoSave()">Save Layout</button>
            <button class="btn-secondary" onclick="showListMode()">Cancel</button>
        </div>
    </div>

</div>

@section Scripts {
<script src="/lib/html5-qrcode/html5-qrcode.min.js"></script>
<script src="/js/api.js"></script>
<script>
    let currentStep = 1
    let qrScanner   = null
    let scannerRunning = false

    // ── 13 Fixed Field Schema ──
    const FIELD_LABELS = {
        partNo:          'P/N',
        quantity:        'QTY',
        unit:            'UNIT',
        vendor:          'VENDOR',
        dateCode:        'D/C',
        tradingCode:     'T/C',
        po:              'PO',
        inventoryNo:     'I/N',
        traceId:         'TRACE ID',
        workOrder:       'W/O',
        line:            'LINE',
        internalTraceId: 'IN_TRACE_ID',
        createdAt:       'CREATED AT',
    }
    const ALL_FIELD_KEYS = Object.keys(FIELD_LABELS)
    const REQUIRED_KEYS  = new Set(['partNo','quantity','workOrder','line'])

    // ── State ──
    let printState = {
        scannedRaw:        '',
        parsedQrData:      {},
        selectedLayoutId:  null,
        activeLayoutFields: null,
        formOverrides:     {},
        layoutSliders:     null,
        previewZpl:        '',
        previewFullData:   null,
        previewImgSrc:     null,
    }

    let _woSearchTimer = null

    // ── Helpers ──
    const cid = k => k.replace(/[^a-zA-Z0-9]/g, '_')
    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    }

    // ISO Z → local display "YYYY-MM-DD HH:mm:ss"
    function fmtCreatedAt(isoZ) {
        if (!isoZ) return ''
        try {
            const d = new Date(isoZ)
            if (isNaN(d)) return isoZ
            const pad = n => String(n).padStart(2,'0')
            return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} ` +
                   `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`
        } catch (_) { return isoZ }
    }

    // Any createdAt string → ISO Z (for QR encoding)
    function toIsoZ(val) {
        if (!val) return new Date().toISOString()
        if (val.endsWith('Z') || val.includes('+')) return val  // already ISO
        try {
            // "YYYY-MM-DD HH:mm:ss" → parse as local → ISO Z
            const d = new Date(val.replace(' ', 'T'))
            return isNaN(d) ? new Date().toISOString() : d.toISOString()
        } catch (_) { return new Date().toISOString() }
    }

    // ── Toast ──
    function showToast(msg, type) {
        const tc = document.getElementById('toastContainer')
        const t  = document.createElement('div')
        t.className = `toast toast-${type || 'info'}`
        t.textContent = msg
        tc.appendChild(t)
        setTimeout(() => t.remove(), 3200)
    }

    // ── Map API response → 13-field schema ──
    function mapScanResponse(res) {
        return {
            partNo:          res.partNo          ?? '',
            quantity:        String(res.quantity  ?? ''),
            unit:            res.unit             ?? '',
            vendor:          res.vendor           ?? '',
            dateCode:        res.dateCode         ?? '',
            tradingCode:     res.tradingCode      ?? '',
            po:              res.po               ?? '',
            inventoryNo:     res.inventoryNo      ?? '',
            traceId:         res.traceId          ?? '',
            workOrder:       res.workOrder        ?? '',
            line:            res.line             ?? '',
            internalTraceId: '',
            createdAt:       '',
        }
    }

    // ── Scan API ──
    async function callScanAPI(barcode, displayName) {
        setScanStatus('⏳ กำลังตรวจสอบ...', '#1a6fff')
        try {
            const res = await api('/inventory/scan', 'POST', { barcode, mode: 0 })
            printState.scannedRaw    = barcode
            printState.parsedQrData  = mapScanResponse(res)
            printState.formOverrides = {}
            await doScan(displayName)
        } catch (err) {
            setScanStatus('❌ ' + (err.message || 'เกิดข้อผิดพลาด'), '#dc2626')
        }
    }

    function setScanStatus(msg, color) {
        const el = document.getElementById('scanStatus')
        el.textContent = msg
        el.style.color = color || 'var(--t2)'
    }

    // ── doScan: after scan success ──
    async function doScan(displayName) {
        await stopScan()
        setScanStatus('✓ สแกนสำเร็จ: ' + displayName, '#059669')
        const d = printState.parsedQrData
        // Banner: Part No. prominent + compact JSON below
        document.getElementById('qrPartNoLabel').textContent = d.partNo || '—'
        const display = Object.fromEntries(Object.entries(d).filter(([, v]) => v !== '' && v !== null && v !== undefined))
        document.getElementById('qrDataLabel').textContent = JSON.stringify(display)
        document.getElementById('fWO').value = d.workOrder || ''
        updateLineBadge(d.line || '')
        renderChecklist(printState.activeLayoutFields)
        goStep(2)
    }

    // ── Stepper ──
    function goStep(n) {
        currentStep = n
        ;[1,2,3].forEach(i => {
            const sc = document.getElementById('sc'+i)
            const sl = document.getElementById('sl'+i)
            sc.className = 'step-circle' + (i < n ? ' done' : i === n ? ' active' : '')
            sl.className = 'step-label'  + (i < n ? ' done' : i === n ? ' active' : '')
            if (i < 3) document.getElementById('line'+i).className = 'step-line' + (i < n ? ' done' : '')
            document.getElementById('step'+i).style.display = i === n ? '' : 'none'
        })
        if (n === 3) renderStep3()
    }

    // ── Camera Scan (html5-qrcode — รองรับ QR Code + Data Matrix + อื่นๆ) ──
    async function startScan() {
        if (scannerRunning) return
        setScanStatus('⏳ เปิดกล้อง...', 'var(--t2)')
        try {
            qrScanner = new Html5Qrcode('qrReader')
            await qrScanner.start(
                { facingMode: 'environment' },
                {
                    fps: 15,
                    qrbox: { width: 200, height: 200 },
                    aspectRatio: 1.0,
                },
                (decodedText) => {
                    callScanAPI(decodedText, 'Camera Scan')
                }
            )
            scannerRunning = true
            document.getElementById('scannerIdle').style.display  = 'none'
            document.getElementById('btnStartScan').style.display = 'none'
            document.getElementById('scannerBox').style.display   = ''
            document.getElementById('btnStopScan').style.display  = ''
            document.getElementById('scanLine').style.display     = ''
            setScanStatus('🎥 กำลังสแกน…', 'var(--blue)')
        } catch (e) {
            console.error('[startScan] error:', e)
            const msg = e?.message || e?.name || String(e) || 'unknown'
            setScanStatus('❌ [' + msg + ']', 'var(--red)')
        }
    }

    async function stopScan() {
        if (scannerRunning && qrScanner) {
            try { await qrScanner.stop(); qrScanner.clear() } catch (_) {}
        }
        scannerRunning = false
        qrScanner = null
        document.getElementById('scannerBox').style.display   = 'none'
        document.getElementById('scannerIdle').style.display  = ''
        document.getElementById('btnStartScan').style.display = ''
        document.getElementById('btnStopScan').style.display  = 'none'
        document.getElementById('scanLine').style.display     = 'none'
        setScanStatus('', '')
    }

    // ── Toggle manual input ──
    function toggleManualInput() {
        const area  = document.getElementById('manualInputArea')
        const label = document.getElementById('manualLabel')
        const show  = area.style.display === 'none'
        area.style.display = show ? '' : 'none'
        label.textContent  = show ? 'ปิด ↑' : 'ป้อน Barcode ด้วยตัวเอง ↓'
    }

    // ── Manual barcode/JSON input ──
    function submitBarcode() {
        const raw = document.getElementById('jsonInput').value.trim()
        if (!raw) { showToast('กรุณากรอก barcode หรือ JSON ก่อน', 'error'); return }
        callScanAPI(raw, 'Manual Input')
    }


    // ──────────────────────────────────────────────────
    // STEP 2 — WorkOrder Autocomplete (GET /workorder)
    // ──────────────────────────────────────────────────

    function onWoInput() {
        const q = document.getElementById('fWO').value.trim()
        const list = document.getElementById('woDropdown')
        if (!q) { list.style.display = 'none'; return }
        clearTimeout(_woSearchTimer)
        _woSearchTimer = setTimeout(() => fetchWoList(q), 280)
    }

    async function fetchWoList(q) {
        const list = document.getElementById('woDropdown')
        list.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">⏳ กำลังค้นหา…</div>'
        list.style.display = ''
        try {
            const res = await api(`/workorder?moNumber=${encodeURIComponent(q)}&page=1&pageSize=20&sortBy=LastSyncedAt&desc=true`, 'GET')
            const arr = res?.data ?? []
            if (arr.length === 0) {
                list.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">ไม่พบ Work Order</div>'
                return
            }
            list.innerHTML = arr.map(x =>
                `<div class="wo-item" onmousedown="selectWo('${escHtml(x.moNumber)}','${escHtml(x.lineName ?? '')}')">
                    <span style="font-weight:700">${escHtml(x.moNumber)}</span>
                    <span class="wo-item-line">${escHtml(x.lineName ?? '—')} · ${escHtml(x.modelName ?? '')}</span>
                </div>`
            ).join('')
        } catch (_) {
            list.innerHTML = '<div class="wo-item" style="color:var(--red);cursor:default">โหลดไม่สำเร็จ</div>'
        }
    }

    function hideWoDropdown() {
        document.getElementById('woDropdown').style.display = 'none'
    }

    function updateLineBadge(line) {
        const badge = document.getElementById('lineBadge')
        document.getElementById('fLine').value = line
        if (!badge) return
        badge.textContent         = line || '—'
        badge.style.color         = line ? 'var(--blue)'   : 'var(--t3)'
        badge.style.background    = line ? 'var(--blue-lt)': '#f0f2f5'
        badge.style.borderColor   = line ? 'var(--blue)'   : 'var(--border)'
    }

    function goToDesignLayout() {
        const designPill = document.querySelectorAll('.tab-pill')[1]
        switchTab('design', designPill)
        const id = document.getElementById('fLayout')?.value
        if (id) {
            openEditMode(id)
        } else {
            showListMode()
        }
    }

    function toggleLabelSize() {
        const sec = document.getElementById('labelSizeSection')
        const chv = document.getElementById('labelSizeChevron')
        const show = sec.style.display === 'none'
        sec.style.display = show ? '' : 'none'
        chv.style.transform = show ? 'rotate(180deg)' : ''
    }

    function selectWo(mo, line) {
        document.getElementById('fWO').value = mo
        updateLineBadge(line)
        document.getElementById('woDropdown').style.display = 'none'
        printState.formOverrides.workOrder = mo
        printState.formOverrides.line      = line
        const woIn   = document.getElementById(`fci_val_${cid('workOrder')}`)
        const lineIn = document.getElementById(`fci_val_${cid('line')}`)
        if (woIn)   woIn.value   = mo
        if (lineIn) lineIn.value = line
    }

    // ──────────────────────────────────────────────────
    // STEP 2 — Layout Selector
    // ──────────────────────────────────────────────────

    async function loadLayoutsIntoSelect() {
        const sel = document.getElementById('fLayout')
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const arr = Array.isArray(layouts) ? layouts : (layouts?.data || [])
            sel.innerHTML = '<option value="">-- เลือก Layout --</option>' +
                arr.map(l => `<option value="${l.id}">${escHtml(l.templateName ?? 'Untitled')}</option>`).join('')
            sel._layoutsData = arr
        } catch (_) {
            sel.innerHTML = '<option value="">-- (ไม่สามารถโหลด Layout) --</option>'
        }
    }

    function applyLayoutToSliders(layout) {
        const c = parseZplDataJson(layout)
        printState.layoutSliders = {
            qrX:       c.qrX       ?? 30,
            qrY:       c.qrY       ?? 40,
            qrSize:    c.qrSize    ?? 5,
            dataX:     c.dataX     ?? 373,
            dataY:     c.dataY     ?? 58,
            fontSize:  c.fontSize  ?? 22,
            valOffset: c.valOffset ?? 151,
        }
        if (c.dpi)    document.getElementById('fDpi').value    = c.dpi.includes('12') ? '300' : '203'
        if (c.width)  document.getElementById('fWidth').value  = c.width
        if (c.height) document.getElementById('fHeight').value = c.height
    }

    function onLayoutChange() {
        const sel = document.getElementById('fLayout')
        const id  = sel.value
        if (!id) {
            printState.selectedLayoutId    = null
            printState.activeLayoutFields  = null
            printState.layoutSliders       = null
            renderChecklist(null)
            return
        }
        const layouts = sel._layoutsData || []
        const layout  = layouts.find(l => String(l.id) === String(id))
        if (!layout) return
        printState.selectedLayoutId   = layout.id
        applyLayoutToSliders(layout)
        const fields = parseLayoutFields(layout)
        printState.activeLayoutFields = fields
        renderChecklist(fields)
    }

    // ──────────────────────────────────────────────────
    // STEP 2 — Field Checklist
    // ──────────────────────────────────────────────────

    function renderChecklist(layoutFields) {
        const container = document.getElementById('step2Checklist')
        if (!container) return
        const d = printState.parsedQrData || {}
        container.innerHTML = ALL_FIELD_KEYS.map(k => {
            const lf      = layoutFields?.find(f => f.key === k)
            const label   = lf?.label ?? FIELD_LABELS[k]
            const checked = layoutFields ? (lf?.show ?? false) : false
            const rawVal  = printState.formOverrides[k] ?? d[k] ?? ''
            // createdAt: always show as human-readable in the input
            const value   = k === 'createdAt' ? fmtCreatedAt(rawVal) : rawVal
            const isReq     = REQUIRED_KEYS.has(k)
            const isAutoGen = k === 'internalTraceId' || k === 'createdAt'
            return `<div class="field-item" id="fci_row_${cid(k)}" onclick="toggleFci('${k}')">
                <input type="checkbox" id="fci_chk_${cid(k)}" ${checked ? 'checked' : ''}
                    onclick="event.stopPropagation()" onchange="updateFciRow('${k}')">
                <span class="field-name">${escHtml(label)}</span>
                ${isReq ? '<span class="req-star">*</span>' : ''}
                <span class="field-token">{${k}}</span>
                <input type="text" class="field-val-input" id="fci_val_${cid(k)}"
                    value="${escHtml(String(value))}"
                    placeholder="${isAutoGen ? '(auto-generate)' : isReq ? 'required' : ''}"
                    ${isAutoGen ? 'readonly style="margin-left:auto;width:130px;padding:4px 8px;font-size:12px;font-family:inherit;border:1.5px solid var(--border);border-radius:6px;color:var(--t2);background:#f8f9fc;cursor:default"' : ''}
                    onclick="event.stopPropagation()"
                    ${isAutoGen ? '' : 'onfocus="this.style.borderColor=\'var(--blue)\'" onblur="this.style.borderColor=\'var(--border)\'"'}
                    >
            </div>`
        }).join('')
        ALL_FIELD_KEYS.forEach(k => updateFciRow(k))
    }

    function toggleFci(k) {
        const cb = document.getElementById(`fci_chk_${cid(k)}`)
        if (cb) { cb.checked = !cb.checked; updateFciRow(k) }
    }

    function updateFciRow(k) {
        const row = document.getElementById(`fci_row_${cid(k)}`)
        const cb  = document.getElementById(`fci_chk_${cid(k)}`)
        if (!row || !cb) return
        row.style.borderColor = cb.checked ? 'var(--blue)' : 'var(--border)'
        row.style.background  = cb.checked ? 'var(--blue-lt)' : ''
    }

    function getCheckedFields() {
        return ALL_FIELD_KEYS
            .filter(k => document.getElementById(`fci_chk_${cid(k)}`)?.checked)
            .map(k => {
                const label = document.getElementById(`fci_row_${cid(k)}`)?.querySelector('.field-name')?.textContent
                    ?? FIELD_LABELS[k]
                const value = document.getElementById(`fci_val_${cid(k)}`)?.value ?? ''
                return { label, value }
            })
    }

    // ──────────────────────────────────────────────────
    // STEP 2 → STEP 3: doPreview
    // ──────────────────────────────────────────────────

    function genUlid() {
        const B32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ'
        let n = Date.now(), ts = ''
        for (let i = 9; i >= 0; i--) { ts = B32[n % 32] + ts; n = Math.floor(n / 32) }
        let rand = ''
        for (let i = 0; i < 16; i++) rand += B32[Math.floor(Math.random() * 32)]
        return ts + rand
    }

    async function doPreview() {
        // Validate required
        for (const k of REQUIRED_KEYS) {
            const val = (document.getElementById(`fci_val_${cid(k)}`)?.value ?? '').trim()
            if (!val) {
                showToast(`กรุณากรอก ${FIELD_LABELS[k]}`, 'error')
                document.getElementById(`fci_val_${cid(k)}`)?.focus()
                return
            }
        }

        // Build fullData from form inputs
        const fullData = { ...printState.parsedQrData }
        ALL_FIELD_KEYS.forEach(k => {
            const el = document.getElementById(`fci_val_${cid(k)}`)
            if (el) fullData[k] = el.value
        })

        // Fetch new traceId from API — leave null if fails, backend will handle it
        try {
            const trRes = await api('/printer/new-traceId', 'GET')
            fullData.internalTraceId = trRes?.traceId ?? trRes?.id ?? trRes ?? null
        } catch (_) {
            fullData.internalTraceId = null
        }
        fullData.createdAt = fullData.internalTraceId ? new Date().toISOString() : null

        // createdAt must always be ISO Z in fullData (for QR encoding)
        fullData.createdAt = toIsoZ(fullData.createdAt)

        // Sync auto-gen back to inputs:
        // - internalTraceId: as-is
        // - createdAt: show display format in input (label will read this)
        const intEl = document.getElementById(`fci_val_${cid('internalTraceId')}`)
        if (intEl && !intEl.value) intEl.value = fullData.internalTraceId
        const caEl = document.getElementById(`fci_val_${cid('createdAt')}`)
        if (caEl) caEl.value = fmtCreatedAt(fullData.createdAt)

        // Layout params
        const sliders = printState.layoutSliders ?? { qrX:30,qrY:40,qrSize:5,dataX:373,dataY:58,fontSize:22,valOffset:151 }
        const dpiVal  = document.getElementById('fDpi').value
        const dpiStr  = dpiVal === '300' ? '12dpmm' : '8dpmm'
        const width   = +document.getElementById('fWidth').value  || 4
        const height  = +document.getElementById('fHeight').value || 3

        // Build ZPL
        const checkedFields = getCheckedFields()
        const zpl = buildZpl({ qrContent: JSON.stringify(fullData), textFields: checkedFields, ...sliders })

        printState.previewZpl      = zpl
        printState.previewFullData = fullData
        printState.previewImgSrc   = null

        // Call preview API (returns PNG blob)
        try {
            printState.previewImgSrc = await callZplPreview(zpl, dpiStr, width, height)
        } catch (_) {}

        goStep(3)
    }

    // ──────────────────────────────────────────────────
    // STEP 3 — Render Preview
    // ──────────────────────────────────────────────────

    function switchS3Right(name, el) {
        ['data','layout'].forEach(k =>
            document.getElementById('s3r-'+k).style.display = k === name ? '' : 'none')
        document.getElementById('s3RightTabs').querySelectorAll('.sub-tab')
            .forEach(t => t.classList.remove('active'))
        el.classList.add('active')
    }

    function syncS3Slider(id, vid) {
        document.getElementById(vid).value = document.getElementById(id).value
    }

    function initS3Sliders() {
        const s = printState.layoutSliders ?? { qrX:30,qrY:40,qrSize:5,dataX:373,dataY:58,fontSize:22,valOffset:151 }
        const dpiVal = document.getElementById('fDpi').value
        document.getElementById('s3Dpi').value    = dpiVal === '300' ? '12dpmm' : '8dpmm'
        document.getElementById('s3Width').value  = document.getElementById('fWidth').value  || 4
        document.getElementById('s3Height').value = document.getElementById('fHeight').value || 3
        const pairs = [['s3SlQrX','s3vQrX',s.qrX],['s3SlQrY','s3vQrY',s.qrY],['s3SlQrSize','s3vQrSize',s.qrSize],
                       ['s3SlDataX','s3vDataX',s.dataX],['s3SlDataY','s3vDataY',s.dataY],
                       ['s3SlFontSize','s3vFontSize',s.fontSize],['s3SlValOffset','s3vValOffset',s.valOffset]]
        pairs.forEach(([sid, vid, val]) => {
            const el = document.getElementById(sid); if (el) el.value = val
            const ve = document.getElementById(vid);  if (ve) ve.value = val
        })
    }

    async function s3RePreview() {
        const sliders = {
            qrX:       +document.getElementById('s3SlQrX').value,
            qrY:       +document.getElementById('s3SlQrY').value,
            qrSize:    +document.getElementById('s3SlQrSize').value,
            dataX:     +document.getElementById('s3SlDataX').value,
            dataY:     +document.getElementById('s3SlDataY').value,
            fontSize:  +document.getElementById('s3SlFontSize').value,
            valOffset: +document.getElementById('s3SlValOffset').value,
        }
        const dpi    = document.getElementById('s3Dpi').value
        const width  = +document.getElementById('s3Width').value  || 4
        const height = +document.getElementById('s3Height').value || 3

        // Fetch new traceId + createdAt
        const fullData = { ...(printState.previewFullData || {}) }
        try {
            const trRes = await api('/printer/new-traceId', 'GET')
            fullData.internalTraceId = trRes?.traceId ?? trRes?.id ?? trRes ?? null
        } catch (_) {
            fullData.internalTraceId = null
        }
        fullData.createdAt = fullData.internalTraceId ? new Date().toISOString() : null
        printState.previewFullData = fullData

        // Sync display values back to checklist inputs
        const intEl = document.getElementById(`fci_val_${cid('internalTraceId')}`)
        if (intEl) intEl.value = fullData.internalTraceId ?? ''
        const caEl = document.getElementById(`fci_val_${cid('createdAt')}`)
        if (caEl) caEl.value = fmtCreatedAt(fullData.createdAt)

        const zpl = buildZpl({
            qrContent: JSON.stringify(fullData),
            textFields: getCheckedFields(),
            ...sliders,
        })
        printState.previewZpl    = zpl
        printState.layoutSliders = sliders
        document.getElementById('zplBox').textContent = zpl.replace(/(\^FDLA,).+?(\^FS)/s, '$1{QR_DATA}$2')
        // Re-preview image
        const wrap = document.getElementById('previewImgWrap')
        wrap.innerHTML = '<div style="color:var(--t2);font-size:13px;text-align:center">⏳ กำลัง render…</div>'
        try {
            const imgSrc = await callZplPreview(zpl, dpi, width, height)
            wrap.innerHTML = imgSrc
                ? `<img src="${escHtml(imgSrc)}" style="max-width:100%;max-height:300px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
                : '<div style="color:var(--amber);font-size:13px">⚠️ ไม่ได้รับ image</div>'
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
        // Switch back to label preview tab
        const firstTab = document.getElementById('s3SubTabs').querySelector('.sub-tab')
        switchS3Tab('labelPrev', firstTab)
    }

    function switchS3Tab(name, el) {
        ['labelPrev','qrData','zplCode'].forEach(k => {
            document.getElementById('s3-'+k).style.display = k === name ? '' : 'none'
        })
        document.getElementById('s3SubTabs').querySelectorAll('.sub-tab')
            .forEach(t => t.classList.remove('active'))
        el.classList.add('active')
    }

    function renderStep3() {
        loadPrinters(false)
        initS3Sliders()
        const d = printState.previewFullData || printState.parsedQrData || {}
        document.getElementById('qrDataLabel3').textContent = d.partNo || 'Data'
        document.getElementById('qrDataBox').textContent    = JSON.stringify(d, null, 2)
        // ZPL display: replace embedded JSON in ^FDLA,...^FS with {QR_DATA} placeholder
        const zplDisplay = (printState.previewZpl || '—').replace(/(\^FDLA,).+?(\^FS)/s, '$1{QR_DATA}$2')
        document.getElementById('zplBox').textContent = zplDisplay

        // Label Preview
        const wrap = document.getElementById('previewImgWrap')
        if (printState.previewImgSrc) {
            wrap.innerHTML =
                `<img src="${escHtml(printState.previewImgSrc)}"
                    style="max-width:100%;max-height:300px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
        } else {
            // Fallback: mock label from checked fields
            const checked = getCheckedFields()
            const rows = checked.map(f =>
                `<div class="label-mock-row">
                    <span class="label-mock-key">${escHtml(f.label)}:</span>
                    <span class="label-mock-val">${escHtml(f.value)}</span>
                </div>`
            ).join('')
            wrap.innerHTML = checked.length === 0
                ? '<div class="label-empty-hint">ไม่มี field ที่เลือก</div>'
                : `<div class="label-mock">
                        <div class="label-mock-qr">QR</div>
                        <div class="label-mock-fields">${rows}</div>
                   </div>`
        }

        // Right panel: checked fields summary
        const list    = document.getElementById('s3FieldList')
        const checked = getCheckedFields()
        list.innerHTML = checked.length === 0
            ? '<div style="color:var(--t3);font-size:13px;text-align:center;padding:16px">ไม่มี field ที่เลือก</div>'
            : checked.map(f =>
                `<div class="field-item" style="cursor:default;gap:8px">
                    <span class="field-name" style="min-width:70px">${escHtml(f.label)}</span>
                    <span style="flex:1;font-size:12px;font-weight:600;color:var(--navy);word-break:break-all">${escHtml(f.value) || '<span style="color:var(--t3)">—</span>'}</span>
                </div>`
            ).join('')
    }

    // ── Printer discovery ──
    async function loadPrinters(showFeedback) {
        const sel = document.getElementById('printerSelect')
        const prevVal = sel.value
        sel.innerHTML = '<option value="">⏳ กำลังค้นหา…</option>'
        try {
            const res = await api('/printer/discover', 'GET')
            const arr = Array.isArray(res) ? res : (res?.data ?? res?.printers ?? [])
            if (arr.length === 0) {
                sel.innerHTML = '<option value="">ไม่พบเครื่องพิมพ์</option>' +
                    '<option value="__test__">🧪 test</option>'
                if (showFeedback) showToast('ไม่พบเครื่องพิมพ์ในเครือข่าย', 'error')
                return
            }
            sel.innerHTML = '<option value="">-- เลือกเครื่องพิมพ์ --</option>' +
                arr.map(p => {
                    const id    = p.id ?? p.ip ?? p.name
                    const label = p.name
                        ? (p.ip ? `${p.name} (${p.ip})` : p.name)
                        : (p.ip ?? String(id))
                    return `<option value="${escHtml(String(id))}">${escHtml(label)}</option>`
                }).join('') +
                '<option value="__test__">🧪 test</option>'
            // Restore previous selection if still available
            if (prevVal && [...sel.options].some(o => o.value === prevVal)) sel.value = prevVal
            if (showFeedback) showToast(`พบ ${arr.length} เครื่องพิมพ์`, 'success')
        } catch (err) {
            sel.innerHTML = '<option value="">โหลดไม่สำเร็จ</option>'
            if (showFeedback) showToast('โหลดเครื่องพิมพ์ไม่สำเร็จ: ' + err.message, 'error')
        }
    }

    // ── Print ──
    function doPrint() {
        const sel = document.getElementById('printerSelect')
        if (!sel.value) { showToast('กรุณาเลือกเครื่องพิมพ์', 'error'); return }
        // Show printer name (option text) in modal
        const printerLabel = sel.options[sel.selectedIndex]?.text ?? sel.value
        document.getElementById('modalPrinterName').textContent = printerLabel
        document.getElementById('printModalOverlay').style.display = 'flex'
    }

    function closePrintModal() {
        document.getElementById('printModalOverlay').style.display = 'none'
    }

    function doPrintConfirm(mode) {
        closePrintModal()
        const sel     = document.getElementById('printerSelect')
        const payload = {
            mode,
            printer:   sel.value,
            zpl:       printState.previewZpl,
            labelData: printState.previewFullData,
        }
        console.log('[PrintQR] doPrintConfirm payload:', payload)
        showToast(mode === 'print-receive'
            ? `🖨️ Print & Receive → ${sel.value}`
            : `🖨️ Print Only → ${sel.value}`, 'info')
    }

    // ──────────────────────────────────────────────────
    // DESIGN LAYOUT
    // ──────────────────────────────────────────────────

    let dsEditLayoutId = null

    const DESIGN_SAMPLE = {
        partNo:'4104097105M', quantity:'100', unit:'PCE',
        vendor:'676894', dateCode:'260309', tradingCode:'06',
        po:'T3FY261023', inventoryNo:'QQT20260251',
        traceId:'20260309000059', workOrder:'W3622502555', line:'F05',
        internalTraceId:'TR-01KRWD7FAG', createdAt:'2026-05-18T02:04:21.200Z',
    }

    function syncSlider(sliderId, valId) {
        document.getElementById(valId).value = document.getElementById(sliderId).value
    }

    function syncInputToSlider(inputId, sliderId) {
        const inp = document.getElementById(inputId)
        const sl  = document.getElementById(sliderId)
        if (!inp || !sl) return
        const val = Math.min(+sl.max, Math.max(+sl.min, +inp.value || 0))
        inp.value = val
        sl.value  = val
    }

    function switchDsTab(name, el) {
        ['preview','qrdata','zpl'].forEach(k => {
            document.getElementById('ds-sub-'+k).style.display = k === name ? '' : 'none'
        })
        document.querySelectorAll('#tab-design .sub-tab').forEach(t => t.classList.remove('active'))
        el.classList.add('active')
    }

    function showListMode() {
        document.getElementById('designList').style.display = ''
        document.getElementById('designEdit').style.display = 'none'
        loadLayoutList()
    }

    async function loadLayoutList() {
        const container = document.getElementById('layoutListContainer')
        container.innerHTML = '<div style="text-align:center;color:var(--t3);padding:32px">Loading…</div>'
        try {
            const layouts = await api('/printer/template/all', 'GET')
            const arr = Array.isArray(layouts) ? layouts : (layouts?.data || [])
            if (arr.length === 0) {
                container.innerHTML = '<div style="text-align:center;color:var(--t3);padding:32px">ยังไม่มี Layout — กด "+ New Layout" เพื่อสร้าง</div>'
                return
            }
            container.innerHTML = arr.map(l => {
                return `<div class="layout-item">
                    <div class="layout-item-icon">🗒️</div>
                    <div class="layout-item-info">
                        <div class="layout-item-name">${escHtml(l.templateName ?? 'Untitled')}</div>
                        <div class="layout-item-meta">${escHtml(l.description ?? '')}</div>
                        <div style="display:flex;gap:16px;margin-top:4px">
                            <span style="font-size:11px;color:var(--t3)">📅 Created: <span style="color:var(--t2)">${fmtCreatedAt(l.createdAt) || '—'}</span></span>
                            <span style="font-size:11px;color:var(--t3)">✏️ Updated: <span style="color:var(--t2)">${fmtCreatedAt(l.updatedAt) || '—'}</span></span>
                        </div>
                    </div>
                    <button class="btn-outline" onclick="openEditMode(${l.id})">Edit</button>
                    <button style="padding:6px 14px;border:1.5px solid var(--red);color:var(--red);background:var(--red-lt);border-radius:8px;font-size:12px;font-weight:700;cursor:pointer"
                            onclick="deleteLayout(${l.id})">Delete</button>
                </div>`
            }).join('')
        } catch (_) {
            container.innerHTML = '<div style="text-align:center;color:var(--t3);padding:32px">ไม่สามารถโหลด Layout ได้</div>'
        }
    }

    async function deleteLayout(id) {
        if (!confirm('ลบ Layout นี้?')) return
        try {
            await api(`/printer/template/${id}`, 'DELETE')
            loadLayoutList()
            loadLayoutsIntoSelect()
        } catch (err) { showToast('ลบไม่สำเร็จ: ' + err.message, 'error') }
    }

    async function openEditMode(id) {
        document.getElementById('editModeTitle').textContent = 'Loading…'
        document.getElementById('designList').style.display = 'none'
        document.getElementById('designEdit').style.display = ''
        let layout
        try {
            layout = await api(`/printer/template/${id}`, 'GET')
        } catch (err) {
            showToast('โหลด Template ไม่สำเร็จ: ' + err.message, 'error')
            showListMode()
            return
        }
        dsEditLayoutId = layout.id
        document.getElementById('editModeTitle').textContent = 'Edit: ' + (layout.templateName ?? '')
        document.getElementById('dsTemplateName').value = layout.templateName ?? ''
        document.getElementById('dsDescription').value  = layout.description  ?? ''
        const c = parseZplDataJson(layout)
        document.getElementById('dsDpi').value    = c.dpi    ?? '8dpmm'
        document.getElementById('dsWidth').value  = c.width  ?? 4
        document.getElementById('dsHeight').value = c.height ?? 3
        setSlider('slQrX',      c.qrX       ?? 30)
        setSlider('slQrY',      c.qrY       ?? 40)
        setSlider('slQrSize',   c.qrSize    ?? 5)
        setSlider('slDataX',    c.dataX     ?? 373)
        setSlider('slDataY',    c.dataY     ?? 58)
        setSlider('slFontSize', c.fontSize  ?? 22)
        setSlider('slValOffset',c.valOffset ?? 151)
        populateDsFieldList(parseLayoutFields(layout))
        showEditMode()
        dsDoPreview()
    }

    function openCreateMode() {
        dsEditLayoutId = null
        document.getElementById('editModeTitle').textContent = 'New Layout'
        document.getElementById('dsTemplateName').value = ''
        document.getElementById('dsDescription').value  = ''
        setSlider('slQrX',30); setSlider('slQrY',40); setSlider('slQrSize',5)
        setSlider('slDataX',373); setSlider('slDataY',58)
        setSlider('slFontSize',22); setSlider('slValOffset',151)
        populateDsFieldList(null, true)
        // Force-check all after render (safety net)
        document.querySelectorAll('#dsFieldList .ds-field-cb').forEach(cb => { cb.checked = true })
        console.log('[openCreateMode] checkboxes after force-check:',
            [...document.querySelectorAll('#dsFieldList .ds-field-cb')].map(cb => cb.id + '=' + cb.checked))
        showEditMode()
        dsDoPreview()
    }

    function showEditMode() {
        document.getElementById('designList').style.display = 'none'
        document.getElementById('designEdit').style.display = ''
        document.getElementById('dsPreviewImgWrap').innerHTML =
            '<div style="color:var(--t2);font-size:13px;text-align:center">⏳ กำลัง render…</div>'
        dsUpdateQrData()
    }

    function setSlider(id, val) {
        const el = document.getElementById(id)
        if (!el) return
        el.value = val
        const vid = 'v' + id.replace('sl','')
        const vEl = document.getElementById(vid)
        if (vEl) vEl.value = val
    }

    function populateDsFieldList(savedFields, allChecked) {
        const container = document.getElementById('dsFieldList')
        container.innerHTML = ALL_FIELD_KEYS.map(k => {
            const sf      = savedFields ? savedFields.find(f => f.key === k) : null
            const label   = (sf && sf.label) ? sf.label : FIELD_LABELS[k]
            const checked = allChecked ? true : (sf ? Boolean(sf.show) : false)
            return `<div class="ds-field-row" id="dfrow_${cid(k)}">
                <input type="checkbox" class="ds-field-cb" id="dfcb_${cid(k)}" ${checked ? 'checked' : ''} onchange="dsPreviewDebounce()">
                <span id="dflabel_${cid(k)}" class="ds-field-label">${escHtml(label)}</span>
                <input type="text" id="dfinput_${cid(k)}" class="ds-field-label-input" value="${escHtml(label)}"
                    style="display:none" onkeydown="if(event.key==='Enter')confirmDsLabel('${k}')">
                <span class="ds-field-token">{${k}}</span>
                <button class="ds-field-pencil" onclick="editDsLabel('${k}')" title="แก้ชื่อ label">✏️</button>
            </div>`
        }).join('')
    }

    function editDsLabel(k) {
        const span  = document.getElementById(`dflabel_${cid(k)}`)
        const input = document.getElementById(`dfinput_${cid(k)}`)
        input.value = span.textContent
        span.style.display  = 'none'
        input.style.display = ''
        input.focus()
        input.onblur = () => confirmDsLabel(k)
    }
    function confirmDsLabel(k) {
        const span  = document.getElementById(`dflabel_${cid(k)}`)
        const input = document.getElementById(`dfinput_${cid(k)}`)
        span.textContent = input.value || FIELD_LABELS[k]
        span.style.display  = ''
        input.style.display = 'none'
        dsPreviewDebounce()
    }

    // Parse the JSON blob stored in zplData field
    function parseZplDataJson(layout) {
        const raw = layout.zplData
        if (!raw) return {}
        try {
            const obj = JSON.parse(raw)
            if (obj && typeof obj === 'object' && !Array.isArray(obj)) return obj
        } catch (_) {}
        return { zplTemplate: raw }  // legacy: plain ZPL string
    }

    function parseLayoutFields(layout) {
        const config = parseZplDataJson(layout)
        const lf = config.labelFields
        if (!lf) return null
        try {
            if (Array.isArray(lf) && lf[0]?.key) return lf
            if (Array.isArray(lf)) return lf.map(k => ({ key:k, label:FIELD_LABELS[k]??k, show:true }))
        } catch (_) {}
        return null
    }

    function getDsFields() {
        return ALL_FIELD_KEYS.map(k => ({
            key:   k,
            label: document.getElementById(`dflabel_${cid(k)}`)?.textContent ?? FIELD_LABELS[k],
            show:  document.getElementById(`dfcb_${cid(k)}`)?.checked ?? false,
        }))
    }

    // ── ZPL Builder ──
    function buildZpl({ qrContent, textFields, qrX, qrY, qrSize, dataX, dataY, fontSize, valOffset }) {
        const lineH = Math.round(fontSize * 1.5)
        let zpl = `^XA\n^CI28\n`
        zpl += `^FO${qrX},${qrY}^BQN,2,${qrSize}^FDLA,${qrContent}^FS\n`
        textFields.forEach(({ label, value }, i) => {
            const y = dataY + i * lineH
            zpl += `^FO${dataX},${y}^A0N,${fontSize},${fontSize}^FD${label}:^FS\n`
            zpl += `^FO${dataX + valOffset},${y}^A0N,${fontSize},${fontSize}^FD${value}^FS\n`
        })
        zpl += `^XZ`
        return zpl
    }

    function buildZplTemplate(fields) {
        const qrX      = +document.getElementById('slQrX').value
        const qrY      = +document.getElementById('slQrY').value
        const qrSize   = +document.getElementById('slQrSize').value
        const dataX    = +document.getElementById('slDataX').value
        const dataY    = +document.getElementById('slDataY').value
        const fontSize = +document.getElementById('slFontSize').value
        const valOffset= +document.getElementById('slValOffset').value
        const lineH    = Math.round(fontSize * 1.5)
        let zpl = `^XA\n^CI28\n`
        zpl += `^FO${qrX},${qrY}^BQN,2,${qrSize}^FDLA,{qrContent}^FS\n`
        fields.filter(f => f.show).forEach(({ key, label }, i) => {
            const y = dataY + i * lineH
            zpl += `^FO${dataX},${y}^A0N,${fontSize},${fontSize}^FD${label}:^FS\n`
            zpl += `^FO${dataX + valOffset},${y}^A0N,${fontSize},${fontSize}^FD{${key}}^FS\n`
        })
        zpl += `^XZ`
        return zpl
    }

    // ── ZPL Preview — proxied through local server → Labelary ──
    async function callZplPreview(zpl, dpi, width, height) {
        const resp = await fetch('/api/zpl/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ zpl, dpi, width, height }),
        })
        if (!resp.ok) throw new Error(`Preview ${resp.status}: ${await resp.text().catch(() => '')}`)
        const blob = await resp.blob()
        return URL.createObjectURL(blob)
    }

    let dsPreviewTimer = null
    function dsPreviewDebounce() {
        clearTimeout(dsPreviewTimer)
        dsPreviewTimer = setTimeout(() => { dsUpdateQrData(); dsDoPreview() }, 600)
    }

    function dsUpdateQrData() {
        const QR_SCHEMA = JSON.stringify(Object.fromEntries(ALL_FIELD_KEYS.map(k => [k, `{${k}}`])), null, 2)
        document.getElementById('dsQrDataBox').textContent = QR_SCHEMA
        document.getElementById('dsZplBox').textContent    = buildZplTemplate(getDsFields())
    }

    async function dsDoPreview() {
        const fields     = getDsFields()
        const textFields = fields.filter(f => f.show).map(f => ({
            label: f.label,
            value: f.key === 'createdAt' ? fmtCreatedAt(DESIGN_SAMPLE[f.key]) : (DESIGN_SAMPLE[f.key] ?? ''),
        }))
        const sliders    = {
            qrX:       +document.getElementById('slQrX').value,
            qrY:       +document.getElementById('slQrY').value,
            qrSize:    +document.getElementById('slQrSize').value,
            dataX:     +document.getElementById('slDataX').value,
            dataY:     +document.getElementById('slDataY').value,
            fontSize:  +document.getElementById('slFontSize').value,
            valOffset: +document.getElementById('slValOffset').value,
        }
        const zpl = buildZpl({ qrContent: JSON.stringify(DESIGN_SAMPLE), textFields, ...sliders })
        document.getElementById('dsZplBox').textContent = zpl
        const wrap = document.getElementById('dsPreviewImgWrap')
        wrap.innerHTML = '<div style="color:var(--t2);font-size:13px">⏳ กำลัง render…</div>'
        try {
            const dpi    = document.getElementById('dsDpi').value
            const width  = +document.getElementById('dsWidth').value  || 4
            const height = +document.getElementById('dsHeight').value || 3
            const imgSrc = await callZplPreview(zpl, dpi, width, height)
            if (imgSrc) {
                wrap.innerHTML = `<img src="${escHtml(imgSrc)}"
                    style="max-width:100%;max-height:300px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,.1)">`
            } else {
                wrap.innerHTML = '<div style="color:var(--amber);font-size:13px">⚠️ ไม่ได้รับ image กลับมา</div>'
            }
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
    }

    async function dsDoSave() {
        const name = document.getElementById('dsTemplateName').value.trim()
        if (!name) { showToast('กรุณากรอก Template Name', 'error'); return }
        const fields = getDsFields()
        // Embed all config in zplData as JSON so it survives round-trips
        const config = {
            zplTemplate: buildZplTemplate(fields),
            dpi:         document.getElementById('dsDpi').value,
            width:       +document.getElementById('dsWidth').value,
            height:      +document.getElementById('dsHeight').value,
            qrX:         +document.getElementById('slQrX').value,
            qrY:         +document.getElementById('slQrY').value,
            qrSize:      +document.getElementById('slQrSize').value,
            dataX:       +document.getElementById('slDataX').value,
            dataY:       +document.getElementById('slDataY').value,
            fontSize:    +document.getElementById('slFontSize').value,
            valOffset:   +document.getElementById('slValOffset').value,
            labelFields: fields,
        }
        const body = {
            templateName: name,
            description:  document.getElementById('dsDescription').value.trim(),
            zplData:      JSON.stringify(config),
        }
        try {
            if (dsEditLayoutId) {
                await api(`/printer/template/${dsEditLayoutId}`, 'PUT', { id: dsEditLayoutId, ...body })
            } else {
                await api('/printer/save-template', 'POST', body)
            }
            showToast('บันทึก Layout สำเร็จ', 'success')
            showListMode()
            loadLayoutsIntoSelect()
        } catch (err) { showToast('บันทึกไม่สำเร็จ: ' + err.message, 'error') }
    }

    // ── Init ──
    renderChecklist(null)
    loadLayoutsIntoSelect()
    loadLayoutList()
    loadPrinters(false)
</script>
}
