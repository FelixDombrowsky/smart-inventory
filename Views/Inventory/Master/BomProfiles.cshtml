@{
    ViewData["Title"] = "Master Management";
}
<link rel="stylesheet" href="css/master-shared.css"/>
<style>
/* ── TABLE VIEW — side panel (เปิดตอนคลิก row ดูรายละเอียดจาก GET /master/bom-profiles/{id}) ── */
.bom-ts-panel{ width:0; overflow:hidden; border-left:1px solid var(--border); flex-shrink:0; transition:width .22s ease; background:var(--card); }
.bom-ts-panel.open{ width:360px; }
.bom-ts-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; padding:14px 16px; border-bottom:1px solid var(--border); width:360px; }
.bom-ts-close{ background:none; border:none; cursor:pointer; color:var(--t2); font-size:15px; padding:4px 6px; border-radius:6px; flex-shrink:0; }
.bom-ts-close:hover{ background:var(--bg-page); color:var(--text); }
.bom-ts-body{ padding:16px; overflow-y:auto; max-height:560px; width:360px; box-sizing:border-box; }
.bom-ts-item{ display:flex; justify-content:space-between; gap:10px; padding:7px 0; border-bottom:1px solid var(--border); font-size:12.5px; }
.bom-ts-item:last-child{ border-bottom:none; }
.bom-ts-item span:first-child{ color:var(--t2); }
.bom-ts-item span:last-child{ font-weight:600; color:var(--navy); text-align:right; }
.bom-ts-comp-row{ display:flex; justify-content:space-between; align-items:center; gap:10px; padding:6px 0; border-bottom:1px solid var(--border); font-size:14px; }
.bom-ts-comp-row:last-child{ border-bottom:none; }
#bomTableBody tr{ cursor:pointer; }
#bomTableBody tr.bom-ts-row-active td{ background:var(--blue-lt); }
#bomTableView .inv-table th[id^="th-"]:hover{ color:var(--blue); }
#bomTableView .inv-table th.sort-asc::after{ content:' ↑'; color:var(--blue); }
#bomTableView .inv-table th.sort-desc::after{ content:' ↓'; color:var(--blue); }
</style>

<div class="toast-stack" id="toastStack"></div>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2>Master Management</h2>
    </div>
</div>

@await Html.PartialAsync("Master/_MasterManagement")

<!-- ── BOM PROFILES ── -->
<div class="section-card" style="overflow:visible">
    <div class="sc-head">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <div class="sc-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                    <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
                BOM Profiles
                <span id="bomCount" class="count-badge"></span>
            </div>
        </div>
        <div class="filter-bar">
            <input id="bomSearch" class="filter-input" placeholder="ค้นหา Part No…" oninput="renderBomTable(1)">
            <div id="bomTableFilters" style="display:flex;gap:8px;flex-wrap:wrap">
                <input id="bomFilterVersion" class="filter-input" type="number" min="1" placeholder="Version" style="width:90px" oninput="renderBomTable(1)">
                <input id="bomFilterComponent" class="filter-input" placeholder="Component Part No" oninput="renderBomTable(1)">
                <select id="bomFilterActive" class="filter-select" onchange="renderBomTable(1)">
                    <option value="">All</option>
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <button class="btn-create" onclick="bomOpenNew()">+ New BOM</button>
        </div>
    </div>

    <!-- ── TABLE VIEW ── -->
    <div id="bomTableView">
        <div style="display:flex;align-items:stretch">
            <div id="bomTableMain" style="flex:1;min-width:0">
                <div style="overflow-x:auto">
                    <table class="inv-table">
                        <thead>
                            <tr>
                                <th style="width:50px;cursor:default"></th>
                                <th id="th-outputPartNo" style="cursor:pointer" onclick="bomSort('outputPartNo')">Output Part No</th>
                                <th id="th-outputItemName" style="cursor:pointer" onclick="bomSort('outputItemName')">Output Item Name</th>
                                <th id="th-version" style="cursor:pointer" onclick="bomSort('version')">Version</th>
                                <th id="th-outputQuantity" style="cursor:pointer;text-align:center" onclick="bomSort('outputQuantity')">Output Qty</th>
                                <th id="th-qtyPerFG" style="cursor:pointer;text-align:center" onclick="bomSort('qtyPerFG')">Qty/FG</th>
                                <th>Components</th>
                                <th id="th-isActive" style="cursor:pointer" onclick="bomSort('isActive')">Active</th>
                                <th id="th-createdAt" style="cursor:pointer" onclick="bomSort('createdAt')" class="sort-desc">Created At</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="bomTableBody"></tbody>
                    </table>
                </div>
                <div class="pag-bar">
                    <div style="display:flex;align-items:center;gap:10px">
                        <select class="pag-size" id="bomTablePageSize" onchange="renderBomTable(1)">
                            <option value="10" selected>10 rows</option>
                            <option value="20">20 rows</option>
                            <option value="50">50 rows</option>
                        </select>
                        <span class="pag-info" id="bomTablePageInfo"></span>
                    </div>
                    <div class="pag-btns" id="bomTablePagination"></div>
                </div>
            </div>

            <!-- Side panel: คลิก row ไหนก็ได้ในตาราง เปิดดูรายละเอียดจาก GET /master/bom-profiles/{id} -->
            <div id="bomTsPanel" class="bom-ts-panel">
                <div class="bom-ts-head">
                    <div style="min-width:0">
                        <div style="font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:.05em;font-weight:700">BOM Detail</div>
                        <div id="bomTsPartNo" style="font-family:ui-monospace,monospace;font-weight:700;font-size:14px;color:var(--navy);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">—</div>
                    </div>
                    <button class="bom-ts-close" onclick="bomTableCloseSide()" title="Close"><i class="bi bi-x-lg"></i></button>
                </div>
                <div id="bomTsBody" class="bom-ts-body"></div>
            </div>
        </div>
    </div><!-- /bomTableView -->
</div>



<!-- ── BOM MODAL ── -->
<div class="modal-overlay" id="bomModal">
    <div class="modal-box">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px">
            <div class="modal-title" style="margin-bottom:0">New BOM Profile</div>
            <div class="loc-view-toggle">
                <button class="loc-view-btn active" id="bnBtn_manual" onclick="bnSetMode('manual')">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Manual
                </button>
                <button class="loc-view-btn" id="bnBtn_workorder" onclick="bnSetMode('workorder')">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                    By WorkOrder
                </button>
            </div>
        </div>
        <div id="bnManualFields">
            <div class="modal-field">
                <div class="modal-label">Output Item Name <span style="color:var(--red)">*</span></div>
                <input class="modal-input" id="bomItemName" autocomplete="off">
            </div>
            <div class="modal-field">
                <div class="modal-label">Output Item Description</div>
                <input class="modal-input" id="bomItemDescription" autocomplete="off">
            </div>
            <div class="modal-field">
                <div class="modal-label">Output Qty</div>
                <input class="modal-input" id="bomQty" type="number" min="0">
            </div>
            <div class="modal-field">
                <div class="modal-label">Qty/FG</div>
                <input class="modal-input" id="bomQtyPerFG" type="number" min="0" step="any">
            </div>
        </div>
        <div id="bnWoFields" style="display:none">
            <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px">
                <input id="bnWoInput" class="modal-input" placeholder="Work Order No. (e.g. 36225034115)"
                    style="margin-bottom:0;font-family:ui-monospace,monospace;font-size:13px;font-weight:600"
                    onkeydown="if(event.key==='Enter') bnFetchWorkOrder()">
                <button onclick="bnFetchWorkOrder()" class="btn-create" id="bnWoFetchBtn"
                    style="padding:8px 18px;font-size:12px;white-space:nowrap;flex-shrink:0">Fetch</button>
            </div>
            <div id="bnWoPreview" style="display:none;background:#f8fafc;border:1.5px solid var(--border);border-radius:10px;padding:12px 14px">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-size:11px;font-weight:700;color:var(--green)">Work Order Loaded</span>
                </div>
                <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px;margin-bottom:10px">
                    <div>
                        <div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">
                            Output Item Name <span style="color:var(--red)">*</span>
                        </div>
                        <input id="bnWoOutputItemName" class="modal-input" placeholder="Output Item Name" autocomplete="off"
                            style="margin-bottom:0;font-size:13px;font-weight:700">
                    </div>
                    <div>
                        <div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">
                            Output Qty <span style="color:var(--red)">*</span>
                        </div>
                        <input id="bnWoOutputQty" class="modal-input" type="number" min="0" step="any" placeholder="0"
                            style="margin-bottom:0;font-size:13px;font-weight:700">
                    </div>
                    <div>
                        <div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">Qty/FG</div>
                        <input id="bnWoQtyPerFG" class="modal-input" type="number" min="0" step="any" placeholder="0"
                            style="margin-bottom:0;font-size:13px;font-weight:700">
                    </div>
                </div>
                <div style="margin-bottom:10px">
                    <div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">Output Item Description</div>
                    <input id="bnWoOutputItemDesc" class="modal-input" placeholder="Output Item Description" autocomplete="off" style="margin-bottom:0;font-size:13px">
                </div>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">MO Number</div><div id="bnWoMo" style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">—</div></div>
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Model</div><div id="bnWoModel" style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--blue)">—</div></div>
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Target Qty</div><div id="bnWoQty" style="font-size:12px;font-weight:700;color:var(--navy)">—</div></div>
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Line</div><div id="bnWoLine" style="font-size:12px;font-weight:600;color:var(--text)">—</div></div>
                    <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Components</div><div id="bnWoItems" style="font-size:12px;font-weight:700;color:var(--text)">—</div></div>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin:14px 0 8px">
                    <span style="font-size:12px;font-weight:700;color:var(--navy)">Item Parts <span id="bnWoSelCount" style="color:var(--blue)"></span></span>
                    <span style="display:flex;gap:10px">
                        <span onclick="bnWoSelectAll(true)" style="font-size:11.5px;font-weight:700;color:var(--blue);cursor:pointer">Select All</span>
                        <span onclick="bnWoSelectAll(false)" style="font-size:11.5px;font-weight:700;color:var(--t2);cursor:pointer">Clear</span>
                    </span>
                </div>
                <div id="bnWoCompList" style="border:1px solid var(--border);border-radius:10px;max-height:220px;overflow-y:auto;background:#fff"></div>
            </div>
        </div>

        <!-- Components — ใช้ร่วมกันทั้ง 2 tab: ติ๊ก Item Parts จาก By WorkOrder หรือค้นหา/เพิ่มเองจาก Manual ก็มาลงที่ list เดียวกันนี้ แก้ Qty ได้ตรงนี้ -->
        <div class="modal-field">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                <span class="modal-label" style="margin-bottom:0">Components</span>
                <span id="bnCompCount" style="font-size:11px;background:var(--blue-lt);color:var(--blue);padding:2px 8px;border-radius:20px;font-weight:700">0</span>
            </div>
            <div id="bnCompList" style="border:1px solid var(--border);border-radius:10px;max-height:160px;overflow-y:auto;margin-bottom:12px;background:var(--card)">
                <div style="padding:16px;text-align:center;color:var(--t3);font-size:13px">No components yet</div>
            </div>
            <div style="background:var(--blue-lt);border:1.5px dashed var(--blue);border-radius:10px;padding:12px 14px">
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                    <div style="flex:1;min-width:160px;position:relative">
                        <input id="bnSearchInput" class="modal-input" placeholder="ค้นหา part no. หรือชื่อ item…"
                            style="margin-bottom:0;padding:8px 12px;font-size:13px"
                            oninput="bnSearchItem(this.value)" autocomplete="off">
                        <div id="bnSearchDd"
                            style="display:none;position:absolute;top:calc(100% + 3px);left:0;right:0;z-index:400;
                                   background:#fff;border:1.5px solid var(--blue);border-radius:9px;
                                   box-shadow:0 8px 24px rgba(0,0,0,.12);max-height:170px;overflow-y:auto"></div>
                        <input type="hidden" id="bnItemId">
                    </div>
                    <input id="bnAddQty" class="modal-input" type="number" min="0.001" step="any" placeholder="Qty"
                        style="width:90px;margin-bottom:0;padding:8px 10px;font-size:13px;font-weight:700;text-align:right">
                    <button type="button" onclick="bnAddComp()" class="btn-create" style="padding:8px 18px;font-size:12px;white-space:nowrap">Add</button>
                </div>
            </div>
        </div>

        <div class="modal-error" id="bomError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('bomModal')">ยกเลิก</button>
            <button class="modal-btn modal-btn-primary" onclick="saveBom()" style="display:flex;align-items:center;gap:6px">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Create BOM
            </button>
        </div>
    </div>
</div>

<!-- ── BOM EDIT MODAL ── -->
<div class="modal-overlay" id="bomEditModal">
    <div class="modal-box" style="max-width:620px;padding:0;overflow:hidden;border-radius:16px">
        <div style="padding:20px 24px 16px;border-bottom:1px solid var(--border);background:var(--bg-page)">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px">
                <div style="font-size:16px;font-weight:700;color:var(--navy);display:flex;align-items:center;gap:8px">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                    Edit BOM Profile
                </div>
                <div class="loc-view-toggle">
                    <button class="loc-view-btn active" id="beBtn_manual" onclick="beSetMode('manual')">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Manual
                    </button>
                    <button class="loc-view-btn" id="beBtn_workorder" onclick="beSetMode('workorder')">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                        By WorkOrder
                    </button>
                </div>
            </div>
            <div id="beManualFields" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
                <div style="display:flex;align-items:center;gap:7px">
                    <span style="font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.06em">Part No.</span>
                    <span id="bePartNoChip" style="font-family:ui-monospace,monospace;font-size:13px;font-weight:700;color:var(--blue);background:var(--blue-lt);padding:4px 12px;border-radius:20px;border:1.5px solid var(--blue)">—</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px">
                    <span style="font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.06em;white-space:nowrap">Output Qty</span>
                    <input id="beQty" class="modal-input" type="number" min="0" step="any"
                        style="width:120px;padding:7px 10px;font-size:14px;font-weight:700;text-align:right;margin-bottom:0">
                </div>
                <div style="display:flex;align-items:center;gap:8px">
                    <span style="font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.06em;white-space:nowrap">Qty/FG</span>
                    <input id="beQtyPerFG" class="modal-input" type="number" min="0" step="any"
                        style="width:100px;padding:7px 10px;font-size:14px;font-weight:700;text-align:right;margin-bottom:0">
                </div>
                <label style="display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--text);cursor:pointer">
                    <input type="checkbox" id="beIsActive" checked style="width:15px;height:15px;cursor:pointer;accent-color:var(--blue)">
                    Active
                </label>
            </div>
            <div id="beWoFields" style="display:none">
                <div style="display:flex;gap:8px;align-items:center">
                    <input id="beWoInput" class="modal-input" placeholder="Work Order No. (e.g. 36225034115)"
                        style="margin-bottom:0;font-family:ui-monospace,monospace;font-size:13px;font-weight:600;letter-spacing:.03em"
                        onkeydown="if(event.key==='Enter') beFetchWorkOrder()">
                    <button onclick="beFetchWorkOrder()" class="btn-create" id="beWoFetchBtn"
                        style="padding:8px 18px;font-size:12px;white-space:nowrap;flex-shrink:0">Fetch</button>
                </div>
                <div id="beWoPreview" style="display:none;margin-top:10px;background:#fff;border:1.5px solid var(--border);border-radius:10px;padding:12px 14px">
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        <span style="font-size:11px;font-weight:700;color:var(--green)">Work Order Loaded</span>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">MO Number</div><div id="beWoMo" style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">—</div></div>
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Model</div><div id="beWoModel" style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--blue)">—</div></div>
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Target Qty</div><div id="beWoQty" style="font-size:12px;font-weight:700;color:var(--navy)">—</div></div>
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Line</div><div id="beWoLine" style="font-size:12px;font-weight:600;color:var(--text)">—</div></div>
                        <div><div style="font-size:10px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.05em">Items</div><div id="beWoItems" style="font-size:12px;font-weight:700;color:var(--text)">—</div></div>
                    </div>
                </div>
            </div>
        </div>
        <div style="padding:16px 24px 0">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                <span style="font-size:12px;font-weight:700;color:var(--navy)">Components</span>
                <span id="beCompCount" style="font-size:11px;background:var(--blue-lt);color:var(--blue);padding:2px 8px;border-radius:20px;font-weight:700">0</span>
            </div>
            <div id="beCompList" style="border:1px solid var(--border);border-radius:10px;max-height:220px;overflow-y:auto;margin-bottom:12px;background:var(--card)">
                <div style="padding:20px;text-align:center;color:var(--t3);font-size:13px">No components yet</div>
            </div>
            <div style="background:var(--blue-lt);border:1.5px dashed var(--blue);border-radius:10px;padding:12px 14px">
                <div style="font-size:10px;font-weight:700;color:var(--blue);margin-bottom:8px;text-transform:uppercase;letter-spacing:.05em">+ Add Component</div>
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                    <div style="flex:1;min-width:180px;position:relative">
                        <input id="beSearchInput" class="modal-input" placeholder="Search part no. or name…"
                            style="margin-bottom:0;padding:8px 12px;font-size:13px"
                            oninput="beSearchItem(this.value)" autocomplete="off">
                        <div id="beSearchDd"
                            style="display:none;position:absolute;top:calc(100% + 3px);left:0;right:0;z-index:400;
                                   background:#fff;border:1.5px solid var(--blue);border-radius:9px;
                                   box-shadow:0 8px 24px rgba(0,0,0,.12);max-height:170px;overflow-y:auto"></div>
                        <input type="hidden" id="beItemId">
                    </div>
                    <input id="beAddQty" class="modal-input" type="number" min="0.001" step="any" placeholder="Qty"
                        style="width:90px;margin-bottom:0;padding:8px 10px;font-size:13px;font-weight:700;text-align:right">
                    <button onclick="beAddComp()" class="btn-create" style="padding:8px 18px;font-size:12px;white-space:nowrap">Add</button>
                </div>
            </div>
        </div>
        <div style="padding:16px 24px;display:flex;gap:10px;justify-content:flex-end;border-top:1px solid var(--border);margin-top:16px">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('bomEditModal')">ยกเลิก</button>
            <button class="modal-btn modal-btn-primary" onclick="beSave()" style="display:flex;align-items:center;gap:6px">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Save Changes
            </button>
        </div>
    </div>
</div>

<!-- ── IMAGE LIGHTBOX (bomOpenImg/bomCloseImg จาก master-shared.js) ── -->
<div id="bomImgOverlay" onclick="bomCloseImg()"
    style="position:fixed;inset:0;background:rgba(10,10,20,.85);backdrop-filter:blur(6px);z-index:9999;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s">
    <div style="position:relative;max-width:90vw;max-height:90vh;transform:scale(.92);transition:transform .2s" onclick="event.stopPropagation()" id="bomImgInner">
        <button onclick="bomCloseImg()"
            style="position:absolute;top:-14px;right:-14px;width:32px;height:32px;border-radius:50%;border:none;background:#fff;font-size:16px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.2)">✕</button>
        <img id="bomImgEl" src="" style="max-width:90vw;max-height:82vh;border-radius:12px;box-shadow:0 24px 60px rgba(0,0,0,.5);display:block">
        <div id="bomImgCaption" style="text-align:center;color:rgba(255,255,255,.7);font-size:12px;margin-top:10px;font-family:ui-monospace,monospace"></div>
    </div>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/master-shared.js"></script>
<script>
    let _bomProfilesCache   = []
    let _bomTablePage       = 1
    let _bomSortBy          = 'createdAt'   // default เรียงตาม Created At ล่าสุดก่อน
    let _bomSortDir         = 'desc'

    // ── Row thumbnail (column แรกของ Table view) — /master/bom-profiles ไม่ได้ส่ง imagePath มาด้วย ต้องดึงทีละ part ผ่าน /master/items/{partNo} เอง ──
    const NO_IMG = `data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2740%27 height=%2740%27 viewBox=%270 0 40 40%27%3E%3Crect width=%2740%27 height=%2740%27 rx=%276%27 fill=%27%23f0f2f5%27/%3E%3Cpath d=%27M14 26l5-6 4 5 3-3 4 4H10z%27 fill=%27%23d1d5db%27/%3E%3Ccircle cx=%2726%27 cy=%2716%27 r=%273%27 fill=%27%23d1d5db%27/%3E%3C/svg%3E`
    let _bomImgCache    = {}   // outputPartNo → imagePath ('' = confirmed ไม่มีรูป)
    let _bomImgCacheBust = Date.now()

    function _bomImgSrc(partNo) {
        const p = _bomImgCache[partNo]
        return p ? (CONFIG.INVENTORY_API + p + '?t=' + _bomImgCacheBust) : NO_IMG
    }

    // ยิงหลังบ้าน (ไม่ await ตอนเรียก) — โหลดทีละแถวที่ยังไม่เคย fetch แล้ว patch <img> ของแถวนั้นเมื่อเสร็จ ไม่บล็อกการ render ตาราง
    async function _bomLoadRowImages(rows) {
        const uncached = rows.filter(p => p.outputPartNo && !(p.outputPartNo in _bomImgCache))
        await Promise.all(uncached.map(async p => {
            try {
                const item = await api(`/master/items/${encodeURIComponent(p.outputPartNo)}`, 'GET')
                _bomImgCache[p.outputPartNo] = item?.imagePath || ''
            } catch { _bomImgCache[p.outputPartNo] = '' }
            const img = document.getElementById('bomRowImg_' + p.id)
            if (img) img.src = _bomImgSrc(p.outputPartNo)
        }))
    }

    function bomSort(col) {
        _bomSortDir = (_bomSortBy === col) ? (_bomSortDir === 'desc' ? 'asc' : 'desc') : 'desc'
        _bomSortBy  = col
        renderBomTable(1)
    }

    function _bomUpdateSortHeaders() {
        document.querySelectorAll('#bomTableView .inv-table th[id^="th-"]').forEach(th => {
            th.classList.remove('sort-asc', 'sort-desc')
            if (th.id === 'th-' + _bomSortBy) th.classList.add(_bomSortDir === 'desc' ? 'sort-desc' : 'sort-asc')
        })
    }

    async function loadBoms() {
        try {
            // Desc/Page/PageSize เป็น required param ของ endpoint นี้ (เดิมไม่ส่งเลย) — response เป็น { total, page, pageSize, items }
            const PAGE_SIZE = 10
            const first = await api(`/master/bom-profiles?page=1&pageSize=${PAGE_SIZE}&sortBy=id&desc=false`, 'GET')
            let arr     = Array.isArray(first) ? first : (first?.items || [])
            const total = first?.total ?? arr.length
            const pages = Math.ceil(total / PAGE_SIZE)
            if (pages > 1) {
                const rest = await Promise.all(
                    Array.from({ length: pages - 1 }, (_, i) =>
                        api(`/master/bom-profiles?page=${i + 2}&pageSize=${PAGE_SIZE}&sortBy=id&desc=false`, 'GET')
                    )
                )
                rest.forEach(r => { arr = arr.concat(Array.isArray(r) ? r : (r?.items || [])) })
            }
            _bomProfilesCache = arr
            renderBomTable(_bomTablePage)
        } catch (err) {
            document.getElementById('bomTableBody').innerHTML =
                `<tr><td colspan="10" style="text-align:center;color:var(--red);padding:32px">Load failed: ${err.message}</td></tr>`
        }
    }

    // Badge สถานะ Active/Inactive แบบจุดสี — เขียว+glow (Active) / เทา (Inactive) เหมือน status dot ของ printer (rp-pd-dot ใน printqr.css)
    function bomActiveBadge(isActive) {
        const active = isActive !== false
        const dot    = active ? '#22c55e' : '#d1d5db'
        return `<span style="display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;background:${active ? 'var(--green-lt)' : '#f0f2f5'};color:${active ? 'var(--green)' : 'var(--t3)'}">
            <span style="width:8px;height:8px;border-radius:50%;background:${dot};flex-shrink:0;${active ? 'box-shadow:0 0 6px #22c55e66' : ''}"></span>
            ${active ? 'Active' : 'Inactive'}
        </span>`
    }

    // Components column (Table View) — โชว์ componentPartNo สูงสุด 2 ตัว ที่เหลือรวบเป็น "+n" แทนตัวเลขจำนวนเฉยๆ
    function bomComponentsCell(components) {
        const list = Array.isArray(components) ? components : []
        if (!list.length) return `<span style="color:var(--t3)">—</span>`
        const shown = list.slice(0, 2).map(c =>
            `<span style="font-family:ui-monospace,monospace;font-size:11px;font-weight:600;color:var(--navy);background:#f0f2f5;padding:2px 8px;border-radius:5px;white-space:nowrap">${locEsc(c.componentPartNo ?? '—')} <span style="color:var(--t2);font-weight:400">×${(c.quantity ?? 0).toLocaleString()}</span></span>`
        ).join('')
        const more = list.length > 2
            ? `<span style="font-size:10px;color:var(--t2);font-weight:600">+${list.length - 2}</span>` : ''
        return `<div style="display:flex;flex-wrap:wrap;gap:4px;align-items:center">${shown}${more}</div>`
    }

    // ── Table View — flat list ของทุก BOM Profile (ต่างจาก Hierarchy ที่โชว์แค่ root) พร้อม pagination ──
    function renderBomTable(page) {
        _bomTablePage = page || 1
        const tbody = document.getElementById('bomTableBody')
        if (!tbody) return
        bomTableCloseSide()   // ปิด side panel ทุกครั้งที่ table re-render (filter/page เปลี่ยน) กัน panel ค้างข้อมูลของ row ที่หายไปแล้ว
        const q         = (document.getElementById('bomSearch')?.value || '').trim().toLowerCase()
        const fVersion  = (document.getElementById('bomFilterVersion')?.value || '').trim()
        const fActive   = document.getElementById('bomFilterActive')?.value ?? ''
        const fComp     = (document.getElementById('bomFilterComponent')?.value || '').trim().toLowerCase()
        const pageSize  = parseInt(document.getElementById('bomTablePageSize')?.value) || 10
        const filtered  = _bomProfilesCache.filter(p =>
            (!q        || (p.outputPartNo ?? '').toLowerCase().includes(q)) &&
            (!fVersion || String(p.version ?? '') === fVersion) &&
            (!fActive  || String(p.isActive !== false) === fActive) &&
            (!fComp    || (p.components || []).some(c => (c.componentPartNo ?? '').toLowerCase().includes(fComp)))
        )
        filtered.sort((a, b) => {
            let va = _bomSortBy === 'isActive' ? (a.isActive !== false) : a[_bomSortBy]
            let vb = _bomSortBy === 'isActive' ? (b.isActive !== false) : b[_bomSortBy]
            if (va == null) va = ''
            if (vb == null) vb = ''
            if (va < vb) return _bomSortDir === 'desc' ? 1 : -1
            if (va > vb) return _bomSortDir === 'desc' ? -1 : 1
            return 0
        })
        const total       = filtered.length
        const totalPages  = Math.ceil(total / pageSize) || 1
        _bomTablePage      = Math.min(Math.max(1, _bomTablePage), totalPages)
        const start        = (_bomTablePage - 1) * pageSize
        const slice         = filtered.slice(start, start + pageSize)

        document.getElementById('bomCount').textContent = total + ' profiles'

        tbody.innerHTML = slice.length === 0
            ? `<tr><td colspan="10" style="text-align:center;color:var(--t3);padding:32px">ไม่พบ BOM Profile</td></tr>`
            : slice.map(p => `
                <tr data-id="${p.id}" onclick="bomTableRowClick(${p.id})">
                    <td onclick="event.stopPropagation()">
                        <img id="bomRowImg_${p.id}" src="${_bomImgSrc(p.outputPartNo)}" onerror="this.src='${NO_IMG}'"
                            style="width:36px;height:36px;object-fit:cover;border-radius:6px;border:1px solid var(--border);cursor:zoom-in"
                            onclick="bomOpenImg(_bomImgSrc('${escJs(p.outputPartNo)}'), '${escJs(p.outputPartNo)}')">
                    </td>
                    <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${locEsc(p.outputPartNo ?? '—')}</td>
                    <td style="color:var(--blue);font-weight:700">${locEsc(p.outputItemName ?? '—')}</td>
                    <td>${p.version ?? '—'}</td>
                    <td style="text-align:center">${(p.outputQuantity ?? 0).toLocaleString()}</td>
                    <td style="text-align:center;color:var(--t2)">${p.qtyPerFG != null ? p.qtyPerFG.toLocaleString() : '—'}</td>
                    <td>${bomComponentsCell(p.components)}</td>
                    <td>${bomActiveBadge(p.isActive)}</td>
                    <td style="color:var(--t3);font-size:12px">${p.createdAt ? new Date(p.createdAt).toLocaleDateString('en-GB', {year:'numeric',month:'short',day:'numeric'}) : '—'}</td>
                    <td style="white-space:nowrap" onclick="event.stopPropagation()">
                        <button onclick="beOpen(_bomProfilesCache.find(x => x.id === ${p.id}))"
                            style="background:none;border:none;cursor:pointer;color:var(--amber);font-size:16px;padding:4px 6px;border-radius:6px" title="Edit">
                            <i class="bi bi-pencil"></i></button>
                    </td>
                </tr>`).join('')

        renderPagination('bomTablePagination', 'bomTablePageInfo', _bomTablePage, totalPages, 'renderBomTable')
        _bomUpdateSortHeaders()
        _bomLoadRowImages(slice)   // ยิงเบื้องหลัง ไม่ await กันบล็อก — เสร็จเมื่อไหร่ค่อย patch <img> ของแถวนั้นๆ
    }

    // ── Table View — side panel (คลิก row ไหนก็ได้ในตาราง เปิดดูรายละเอียดจาก GET /master/bom-profiles/{id}) ──
    let _bomTsOpenId = null

    function bomTableRowClick(id) {
        if (_bomTsOpenId === id) { bomTableCloseSide(); return }   // คลิกซ้ำแถวเดิมที่เปิดอยู่ = ปิด panel
        _bomTsOpenId = id
        document.querySelectorAll('#bomTableBody tr').forEach(tr => tr.classList.toggle('bom-ts-row-active', tr.dataset.id == id))
        document.getElementById('bomTsPanel').classList.add('open')
        document.getElementById('bomTsPartNo').textContent = 'Loading…'
        document.getElementById('bomTsBody').innerHTML = `<div style="text-align:center;color:var(--t3);padding:40px 0">Loading…</div>`
        bomTableLoadDetail(id)
    }

    function bomTableCloseSide() {
        _bomTsOpenId = null
        document.getElementById('bomTsPanel')?.classList.remove('open')
        document.querySelectorAll('#bomTableBody tr').forEach(tr => tr.classList.remove('bom-ts-row-active'))
    }

    async function bomTableLoadDetail(id) {
        try {
            const d = await api(`/master/bom-profiles/${id}`, 'GET')
            if (_bomTsOpenId !== id) return   // ปิด/คลิกแถวอื่นไปแล้วก่อน fetch เสร็จ — ไม่ต้อง render ทับ
            const comps = Array.isArray(d.components) ? d.components : []
            document.getElementById('bomTsPartNo').textContent = d.outputPartNo ?? '—'
            document.getElementById('bomTsBody').innerHTML = `
                <div style="display:flex;justify-content:center;margin-bottom:14px">
                    <img id="bomTsOutputImg" src="${_bomImgSrc(d.outputPartNo)}" onerror="this.src='${NO_IMG}'"
                        style="width:72px;height:72px;object-fit:cover;border-radius:10px;border:1px solid var(--border);cursor:zoom-in"
                        onclick="bomOpenImg(_bomImgSrc('${escJs(d.outputPartNo)}'),'${escJs(d.outputPartNo)}')">
                </div>
                <div class="bom-ts-item"><span>Output Item Name</span><span>${locEsc(d.outputItemName ?? '—')}</span></div>
                <div class="bom-ts-item"><span>Version</span><span>${d.version ?? '—'}</span></div>
                <div class="bom-ts-item"><span>Output Qty</span><span>${(d.outputQuantity ?? 0).toLocaleString()}</span></div>
                <div class="bom-ts-item"><span>Qty/FG</span><span>${d.qtyPerFG != null ? d.qtyPerFG.toLocaleString() : '—'}</span></div>
                <div class="bom-ts-item"><span>Active</span><span>${bomActiveBadge(d.isActive)}</span></div>
                <div class="bom-ts-item"><span>Created At</span><span>${d.createdAt ? new Date(d.createdAt).toLocaleString('en-GB', {year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'}</span></div>
                <div style="margin-top:14px;font-size:11px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.05em">Components (${comps.length})</div>
                <div style="margin-top:6px">
                    ${comps.length ? comps.map((c, i) => `
                        <div class="bom-ts-comp-row">
                            <div style="display:flex;align-items:center;gap:8px;min-width:0">
                                <img id="bomTsCompImg_${i}" src="${_bomImgSrc(c.componentPartNo)}" onerror="this.src='${NO_IMG}'"
                                    style="width:26px;height:26px;object-fit:cover;border-radius:5px;border:1px solid var(--border);flex-shrink:0;cursor:zoom-in"
                                    onclick="event.stopPropagation();bomOpenImg(_bomImgSrc('${escJs(c.componentPartNo)}'),'${escJs(c.componentPartNo)}')">
                                <span style="font-family:ui-monospace,monospace;font-weight:600;color:var(--navy);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${locEsc(c.componentPartNo ?? '—')}</span>
                            </div>
                            <span style="color:var(--navy);font-weight:700;flex-shrink:0">${(c.quantity ?? 0).toLocaleString()}${c.ratio != null ? ` <span style="color:var(--t3);font-weight:400">(x${c.ratio})</span>` : ''}</span>
                        </div>`).join('') : `<div style="color:var(--t3);padding:10px 0">No components</div>`}
                </div>
                <div style="margin-top:16px">
                    <button class="btn-edit" style="width:100%" onclick="beOpen(_bomProfilesCache.find(x => x.id === ${id}))"><i class="bi bi-pencil"></i> Edit</button>
                </div>`
            _bomLoadOutputImg(d.outputPartNo, id)
            _bomLoadCompImages(comps, id)
        } catch (err) {
            if (_bomTsOpenId !== id) return
            document.getElementById('bomTsBody').innerHTML = `<div style="color:var(--red);padding:20px 0;text-align:center">Load failed: ${err.message}</div>`
        }
    }

    // โหลดรูปของ Output part ใน side panel เบื้องหลัง (ใช้ cache เดียวกับ thumbnail ของ Table view/Component)
    async function _bomLoadOutputImg(partNo, forId) {
        if (partNo && !(partNo in _bomImgCache)) {
            try {
                const item = await api(`/master/items/${encodeURIComponent(partNo)}`, 'GET')
                _bomImgCache[partNo] = item?.imagePath || ''
            } catch { _bomImgCache[partNo] = '' }
        }
        if (_bomTsOpenId !== forId) return   // ปิด/เปลี่ยนแถวไปแล้วก่อน fetch เสร็จ
        const img = document.getElementById('bomTsOutputImg')
        if (img) img.src = _bomImgSrc(partNo)
    }

    // โหลดรูปของแต่ละ component ใน side panel เบื้องหลัง (ใช้ cache ร่วมกับ thumbnail ของ Table view — partNo อาจซ้ำกันได้)
    async function _bomLoadCompImages(comps, forId) {
        const uncached = comps.filter(c => c.componentPartNo && !(c.componentPartNo in _bomImgCache))
        await Promise.all(uncached.map(async c => {
            try {
                const item = await api(`/master/items/${encodeURIComponent(c.componentPartNo)}`, 'GET')
                _bomImgCache[c.componentPartNo] = item?.imagePath || ''
            } catch { _bomImgCache[c.componentPartNo] = '' }
        }))
        if (_bomTsOpenId !== forId) return   // ปิด/เปลี่ยนแถวไปแล้วก่อน fetch เสร็จ — ไม่ต้อง patch ทับ panel ที่ไม่ตรงกันแล้ว
        comps.forEach((c, i) => {
            const img = document.getElementById('bomTsCompImg_' + i)
            if (img) img.src = _bomImgSrc(c.componentPartNo)
        })
    }


    // _bnComponents = รายการ item part ทั้งหมดของ Work Order ที่ fetch มา (ใช้เป็น picker ใน tab By WorkOrder เท่านั้น)
    // _bnManualComponents = list "Components" จริงที่จะส่งสร้าง BOM — ใช้ร่วมกันทั้ง 2 tab (ติ๊กจาก WO หรือค้นหาเพิ่มเองจาก Manual ก็ลงที่นี่หมด)
    let _bomEditingId = null, _bnMode = 'manual', _bnComponents = []
    let _bnManualComponents = [], _bnSearchTimer = null

    function bnRenderComps() {
        const list = document.getElementById('bnCompList')
        document.getElementById('bnCompCount').textContent = _bnManualComponents.length
        if (!_bnManualComponents.length) {
            list.innerHTML = `<div style="padding:16px;text-align:center;color:var(--t3);font-size:13px">No components yet</div>`
            return
        }
        list.innerHTML = _bnManualComponents.map((c, i) => `
            <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:${i < _bnManualComponents.length - 1 ? '1px solid var(--border)' : 'none'}">
                <span style="font-size:11px;color:var(--t3);width:18px;flex-shrink:0;text-align:right">${i + 1}</span>
                <span style="flex:1;font-family:ui-monospace,monospace;font-size:13px;font-weight:600;color:var(--navy);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                      title="${locEsc(c.partNo)}">${locEsc(c.partNo)}</span>
                <input type="number" min="0.001" step="any" value="${c.quantity}"
                    oninput="_bnManualComponents[${i}].quantity = parseFloat(this.value)||0"
                    style="width:78px;padding:5px 8px;border:1.5px solid var(--border);border-radius:7px;font-size:13px;font-weight:700;text-align:right;font-family:inherit;outline:none;color:var(--blue);background:#fff"
                    onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor='var(--border)'">
                <button type="button" onclick="bnRemoveComp(${i})"
                    style="width:26px;height:26px;flex-shrink:0;border:1.5px solid #fca5a5;border-radius:6px;background:#fef2f2;color:var(--red);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
                </button>
            </div>`).join('')
    }

    function bnRemoveComp(idx) { _bnManualComponents.splice(idx, 1); bnRenderComps() }

    // ── Search dropdown (Add Component ทั้ง Create/Edit modal) โดนตัดขอบเพราะ .modal-box มี overflow-y:auto ทั้งยังมี transform (สร้าง containing block ใหม่ให้ position:fixed ด้วย)
    // ต้องย้าย dropdown ออกมาเป็นลูกของ <body> ตรงๆ แล้ว position:fixed คำนวณพิกัดเองจาก input ถึงจะโผล่พ้นขอบ modal ได้ (เหมือนที่แก้ไว้ใน Printers.cshtml)
    function _bomPositionDd(inputId, ddId) {
        const input = document.getElementById(inputId)
        const dd    = document.getElementById(ddId)
        if (!input || !dd) return
        if (dd.parentElement !== document.body) document.body.appendChild(dd)
        const r = input.getBoundingClientRect()
        dd.style.position = 'fixed'
        dd.style.top      = (r.bottom + 3) + 'px'
        dd.style.left     = r.left + 'px'
        dd.style.width    = r.width + 'px'
        dd.style.right    = 'auto'
        dd.style.zIndex   = '1100'   // ต้องสูงกว่า .modal-overlay (z-index:1000) ไม่งั้นโดนบังหลัง modal พอย้ายมาเป็นลูก body
    }

    function bnSearchItem(q) {
        const dd = document.getElementById('bnSearchDd')
        clearTimeout(_bnSearchTimer)
        document.getElementById('bnItemId').value = ''
        if (!q.trim()) { dd.style.display = 'none'; return }
        dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">Searching…</div>`
        _bomPositionDd('bnSearchInput', 'bnSearchDd')
        dd.style.display = 'block'
        // ค้นหาด้วยตัวพิมพ์ใหญ่เสมอ (Part No. ในระบบเก็บเป็นตัวพิมพ์ใหญ่) — ไม่กระทบข้อความที่ผู้ใช้พิมพ์ในช่อง #bnSearchInput
        const searchQ = q.trim().toUpperCase()
        _bnSearchTimer = setTimeout(async () => {
            try {
                const res   = await api(`/master/items?PartNo=${encodeURIComponent(searchQ)}&page=1&pageSize=15`)
                const items = Array.isArray(res) ? res : (res?.data || [])
                dd.innerHTML = items.length === 0
                    ? `<div style="padding:9px 14px;font-size:12px;color:var(--t2)">No items found</div>`
                    : items.map(it => `
                        <div onclick="bnPickItem(${it.id},'${escJs(it.partNo ?? '')}','${escJs(it.itemName ?? '')}')"
                            style="padding:9px 14px;font-size:13px;cursor:pointer;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px"
                            onmouseover="this.style.background='var(--blue-lt)'" onmouseout="this.style.background=''">
                            <span style="font-family:ui-monospace,monospace;font-size:12px;font-weight:700;color:var(--navy)">${locEsc(it.partNo ?? '')}</span>
                            <span style="color:var(--t2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${locEsc(it.itemName ?? '')}</span>
                        </div>`).join('')
            } catch { dd.innerHTML = `<div style="padding:9px 14px;font-size:12px;color:var(--red)">Load failed</div>` }
        }, 280)
    }

    function bnPickItem(id, partNo, desc) {
        document.getElementById('bnSearchInput').value      = `${partNo}${desc ? ' — ' + desc : ''}`
        document.getElementById('bnItemId').value           = id
        document.getElementById('bnSearchDd').style.display = 'none'
        document.getElementById('bnAddQty').focus()
    }

    function bnAddComp() {
        const itemId = parseInt(document.getElementById('bnItemId').value)
        const qty    = parseFloat(document.getElementById('bnAddQty').value)
        const label  = document.getElementById('bnSearchInput').value.trim()
        if (!itemId) { showToast('กรุณาเลือก item จาก dropdown', 'error'); return }
        if (!qty || qty <= 0) { showToast('กรุณากรอก Quantity', 'error'); return }
        if (_bnManualComponents.find(c => c.componentItemId === itemId)) { showToast('Item นี้มีอยู่แล้วใน BOM', 'error'); return }
        _bnManualComponents.push({ componentItemId: itemId, partNo: label.split(' — ')[0].trim(), quantity: qty })
        bnRenderComps()
        document.getElementById('bnSearchInput').value      = ''
        document.getElementById('bnItemId').value           = ''
        document.getElementById('bnAddQty').value           = ''
        document.getElementById('bnSearchDd').style.display = 'none'
        document.getElementById('bnSearchInput').focus()
    }

    function bnSetMode(mode) {
        _bnMode = mode
        document.getElementById('bnBtn_manual').classList.toggle('active',    mode === 'manual')
        document.getElementById('bnBtn_workorder').classList.toggle('active', mode === 'workorder')
        document.getElementById('bnManualFields').style.display = mode === 'manual'    ? '' : 'none'
        document.getElementById('bnWoFields').style.display     = mode === 'workorder' ? '' : 'none'
    }

    async function bnFetchWorkOrder() {
        const wo  = document.getElementById('bnWoInput').value.trim()
        if (!wo) { showToast('กรุณากรอก Work Order No.', 'error'); return }
        const btn = document.getElementById('bnWoFetchBtn')
        btn.disabled = true; btn.textContent = '⏳ Loading…'
        try {
            const res = await getWorkOrderDetail(wo)
            document.getElementById('bnWoMo').textContent    = res.moNumber  ?? '—'
            document.getElementById('bnWoModel').textContent = res.modelName ?? '—'
            document.getElementById('bnWoQty').textContent   = res.targetQty ?? '—'
            document.getElementById('bnWoLine').textContent  = res.lineName  ?? '—'
            // prefill Output Qty จาก Target Qty และ Output Item Name จาก Model ของ WO ให้เลย (แก้ไขได้ทั้งคู่)
            document.getElementById('bnWoOutputQty').value       = res.targetQty ?? ''
            document.getElementById('bnWoOutputItemName').value  = res.modelName ?? ''
            _bnComponents = (res.items || [])
                .filter(it => (it.planQty ?? 0) > 0)
                .map(it => ({ componentItemId: it.itemId, partNo: it.partNo ?? String(it.itemId), quantity: it.planQty, selected: true }))
            document.getElementById('bnWoItems').textContent = _bnComponents.length + ' items'
            document.getElementById('bnWoPreview').style.display = ''
            bnWoSelectAll(true)   // default: เลือกทุกตัว + ใส่เข้า Components list ให้เลย (เหมือน tab Manual)
            showToast(`โหลด Work Order สำเร็จ — ${_bnComponents.length} items`, 'success')
        } catch (err) {
            showToast('ไม่พบ Work Order: ' + err.message, 'error')
            document.getElementById('bnWoPreview').style.display = 'none'
        } finally { btn.disabled = false; btn.textContent = 'Fetch' }
    }

    function bnRenderWoComps() {
        const list = document.getElementById('bnWoCompList')
        const selCount = _bnComponents.filter(c => c.selected).length
        document.getElementById('bnWoSelCount').textContent = `(${selCount}/${_bnComponents.length} เลือกแล้ว)`
        list.innerHTML = !_bnComponents.length
            ? `<div style="padding:16px;text-align:center;color:var(--t3);font-size:13px">No items</div>`
            : _bnComponents.map((c, i) => `
                <label style="display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:${i < _bnComponents.length - 1 ? '1px solid var(--border)' : 'none'};cursor:pointer">
                    <input type="checkbox" ${c.selected ? 'checked' : ''} onchange="bnToggleWoComp(${i})" style="width:15px;height:15px;flex-shrink:0;cursor:pointer">
                    <span style="flex:1;font-family:ui-monospace,monospace;font-size:12.5px;font-weight:600;color:${c.selected ? 'var(--navy)' : 'var(--t3)'};min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${locEsc(c.partNo)}</span>
                    <span style="font-size:12px;font-weight:700;color:${c.selected ? 'var(--blue)' : 'var(--t3)'}">${c.quantity}</span>
                </label>`).join('')
    }

    // ติ๊ก/เลิกติ๊ก item part จาก Work Order = เพิ่ม/เอาออกจาก _bnManualComponents (list เดียวกับที่ tab Manual ใช้) เลย
    // กันซ้ำด้วย componentItemId — เผื่อ user เพิ่ม item เดียวกันเองผ่านช่องค้นหาไปแล้วก่อนหน้านี้
    function _bnSyncWoCompToShared(c) {
        const i = _bnManualComponents.findIndex(x => x.componentItemId === c.componentItemId)
        if (c.selected) {
            if (i === -1) _bnManualComponents.push({ componentItemId: c.componentItemId, partNo: c.partNo, quantity: c.quantity })
        } else if (i > -1) {
            _bnManualComponents.splice(i, 1)
        }
    }

    function bnToggleWoComp(idx) {
        const c = _bnComponents[idx]
        c.selected = !c.selected
        _bnSyncWoCompToShared(c)
        bnRenderWoComps()
        bnRenderComps()
    }

    function bnWoSelectAll(val) {
        _bnComponents.forEach(c => { c.selected = val; _bnSyncWoCompToShared(c) })
        bnRenderWoComps()
        bnRenderComps()
    }

