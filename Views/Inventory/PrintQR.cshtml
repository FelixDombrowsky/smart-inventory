    // ── Receive Location (GPS-based) ──
    let rpReceiveLocationCode = null

    function rpLocHaversine(lat1, lng1, lat2, lng2) {
        const R = 6371000
        const dLat = (lat2 - lat1) * Math.PI / 180
        const dLng = (lng2 - lng1) * Math.PI / 180
        const a = Math.sin(dLat/2)**2 +
                  Math.cos(lat1 * Math.PI/180) * Math.cos(lat2 * Math.PI/180) * Math.sin(dLng/2)**2
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
    }

    async function rpOpenLocDropdown() {
        const dd  = document.getElementById('rpLocDropdown')
        const btn = document.getElementById('rpLocBtn')
        if (dd.style.display !== 'none') { dd.style.display = 'none'; return }

        if (!navigator.geolocation) {
            showToast('เบราว์เซอร์นี้ไม่รองรับ GPS', 'error'); return
        }

        dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">⏳ กำลังรับ GPS…</div>'
        dd.style.display = ''
        btn.disabled = true

        let pos
        try {
            pos = await new Promise((res, rej) =>
                navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
            )
        } catch (e) {
            dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default">❌ GPS: ${e.message}</div>`
            btn.disabled = false; return
        }

        const currLat = pos.coords.latitude
        const currLng = pos.coords.longitude
        dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">⏳ กำลังค้นหา Location…</div>'

        try {
            const res = await api('/location?isActive=true&page=1&pageSize=50')
            const arr = Array.isArray(res) ? res : (res?.data || [])
            if (!arr.length) {
                dd.innerHTML = '<div class="wo-item" style="color:var(--t3);cursor:default">ไม่มี Location ในระบบ</div>'
                btn.disabled = false; return
            }

            // ดึง detail ทุก location พร้อมกัน
            const details = await Promise.allSettled(arr.map(l => api(`/location/${l.id}`)))

            const DEFAULT_RADIUS = 50
            const nearby = []
            details.forEach(r => {
                if (r.status !== 'fulfilled') return
                const d = r.value
                if (!d) return
                if (d.latitude == null || d.longitude == null) return
                const radius = (d.accuracy > 0) ? d.accuracy : DEFAULT_RADIUS
                const dist   = rpLocHaversine(currLat, currLng, d.latitude, d.longitude)
                if (dist <= radius) nearby.push({ ...d, _dist: Math.round(dist) })
            })

            btn.disabled = false

            if (!nearby.length) {
                dd.innerHTML += '<div class="wo-item" style="color:var(--t3);cursor:default">📍 ไม่พบ Location ในระยะ GPS ปัจจุบัน</div>'
                return
            }

            nearby.sort((a, b) => a._dist - b._dist)
            dd.innerHTML = nearby.map(l =>
                `<div class="wo-item" onmousedown="rpLocSelect('${escHtml(l.locationCode)}','${escHtml(l.typeName||'')}')">
                    <div style="display:flex;align-items:center;gap:6px">
                        <span style="font-weight:700;font-family:monospace">${escHtml(l.locationCode)}</span>
                        ${l.typeName ? `<span style="font-size:11px;background:var(--blue-lt);color:var(--blue);border-radius:4px;padding:1px 6px;font-weight:600">${escHtml(l.typeName)}</span>` : ''}
                        <span style="font-size:11px;color:var(--green);font-weight:600;margin-left:auto">~${l._dist} m</span>
                    </div>
                    ${l.description ? `<div style="font-size:11px;color:var(--t2);margin-top:2px">${escHtml(l.description)}</div>` : ''}
                </div>`
            ).join('')
        } catch (e) {
            btn.disabled = false
            dd.innerHTML = `<div class="wo-item" style="color:var(--red);cursor:default">โหลดไม่สำเร็จ: ${e.message}</div>`
        }
    }

    function rpLocSelect(code, typeName) {
        rpReceiveLocationCode = code
        const display = document.getElementById('rpLocDisplay')
        display.textContent = typeName ? `${code}  (${typeName})` : code
        display.style.color = 'var(--text)'
        document.getElementById('rpLocDropdown').style.display = 'none'
    }

    function rpRebuildAllZpl() {
        if (!rpLayoutConfig || rpItems.length === 0) return
        const cfg = rpLayoutConfig
        const sliders = {
            qrX:       cfg.qrX       ?? 30,
            qrY:       cfg.qrY       ?? 40,
            qrSize:    cfg.qrSize    ?? 5,
            dataX:     cfg.dataX     ?? 373,
            dataY:     cfg.dataY     ?? 58,
            fontSize:  cfg.fontSize  ?? 22,
            lineHeight: cfg.lineHeight ?? 33,
            valOffset:  cfg.valOffset  ?? 151,
        }
        const labelFields = Array.isArray(cfg.labelFields) ? cfg.labelFields : null
        rpItems.forEach(item => {
            const d = item.data
            const textFields = labelFields
                ? labelFields.filter(f => f.show).map(f => ({
                    label: f.label ?? FIELD_LABELS[f.key] ?? f.key,
                    value: f.key === 'createdAt' ? fmtCreatedAt(d[f.key]) : (d[f.key] ?? ''),
                  }))
                : Object.keys(FIELD_LABELS).filter(k => d[k]).map(k => ({
                    label: FIELD_LABELS[k],
                    value: k === 'createdAt' ? fmtCreatedAt(d[k]) : d[k],
                  }))
            item.zpl        = buildZpl({ qrContent: buildQrContent(d, cfg.qrFields ?? null), textFields, ...sliders })
            item.previewSrc = null  // invalidate cache
        })
        showToast('Layout เปลี่ยนแล้ว — preview อัปเดตทุก item', 'success')
    }

    // ── Camera (full-screen modal) ──
    let _rpScanMode = 'receive' // 'receive' | 'reprint'

    function rpToggleCam() {
        _rpScanMode = 'receive'
        if (_rpScanActive) rpStopScan()
        else rpStartScan()
    }

    function rprToggleCam() {
        _rpScanMode = 'reprint'
        if (_rpScanActive) rpStopScan()
        else rpStartScan()
    }

    function _rpUpdateCamBtn(open) {
        const label = open ? '⏹ ปิดกล้อง' : '📷 เปิดกล้อง'
        const id    = _rpScanMode === 'reprint' ? 'rprBtnCam' : 'rpBtnCam'
        const b     = document.getElementById(id)
        if (b) b.textContent = label
    }

    async function rpStartScan() {
        if (_rpScanActive) return
        document.getElementById('rpCamModal').style.display = 'flex'
        _rpUpdateCamBtn(true)
        _rpTorchOn = false
        document.getElementById('rpTorchBtn').style.opacity = '1'
        try {
            _rpHtml5Scanner = new Html5Qrcode('rpCamReader')
            await _rpHtml5Scanner.start(
                { facingMode: _rpFacingMode },
                { fps: 15, qrbox: { width: 260, height: 260 }, aspectRatio: 1.0 },
                (text) => rpOnScanSuccess(text)
            )
            _rpScanActive = true
        } catch (e) {
            showToast('เปิดกล้องไม่สำเร็จ: ' + (e?.message || String(e)), 'error')
            rpStopScan()
        }
    }

    async function rpStopScan() {
        _rpScanActive = false
        if (_rpHtml5Scanner) {
            try { await _rpHtml5Scanner.stop(); _rpHtml5Scanner.clear() } catch (_) {}
            _rpHtml5Scanner = null
        }
        document.getElementById('rpCamModal').style.display = 'none'
        _rpUpdateCamBtn(false)
    }

    async function rpSwitchCamera() {
        _rpFacingMode = _rpFacingMode === 'environment' ? 'user' : 'environment'
        if (_rpScanActive) {
            try { await _rpHtml5Scanner.stop(); _rpHtml5Scanner.clear() } catch (_) {}
            _rpHtml5Scanner = null
            _rpScanActive = false
            await rpStartScan()
        }
    }

    async function rpToggleTorch() {
        if (!_rpHtml5Scanner) return
        _rpTorchOn = !_rpTorchOn
        try {
            const track = _rpHtml5Scanner.getRunningTrackCameraCapabilities?.()
                ?? _rpHtml5Scanner._localMediaStream?.getVideoTracks?.()[0]
            if (track && track.applyConstraints) {
                await track.applyConstraints({ advanced: [{ torch: _rpTorchOn }] })
            }
            document.getElementById('rpTorchBtn').style.opacity = _rpTorchOn ? '1' : '0.5'
        } catch (_) {
            showToast('กล้องนี้ไม่รองรับ Torch', 'error')
            _rpTorchOn = false
        }
    }

    let _rpLastScanText = null, _rpScanCooldown = false
    function rpSetCamFooter(msg) {
        const el = document.getElementById('rpCamFooter')
        if (el) el.textContent = msg
    }
    function rpOnScanSuccess(text) {
        if (_rpScanCooldown || text === _rpLastScanText) return
        _rpLastScanText = text
        _rpScanCooldown = true
        setTimeout(() => {
            _rpScanCooldown  = false
            _rpLastScanText  = null
            rpSetCamFooter('รองรับ QR Code · Data Matrix · Code 128 — ชี้กล้องไปที่บาร์โค้ด')
        }, 2500)

        rpSetCamFooter('⏳ กำลังประมวลผล...')
        rpParseScan(text).then(async data => {
            if (!data) {
                rpSetCamFooter('⚠️ ไม่ได้รับข้อมูลจาก barcode')
                return
            }
            if (_rpScanMode === 'reprint') {
                const ok = await rprAddFromScan(text)
                const n  = rprItems.length
                rpSetCamFooter(ok
                    ? '✅ เพิ่ม LOT เรียบร้อย (' + n + '/10)'
                    : '⚠️ ไม่สามารถเพิ่ม LOT ได้')
            } else {
                const ok = await rpAddItem(data)
                rpSetCamFooter(ok
                    ? '✅ เพิ่ม ' + (data.partNo || 'item') + ' เรียบร้อย (' + rpItems.length + '/10)'
                    : '⚠️ ไม่สามารถเพิ่ม item ได้')
            }
        }).catch(err => {
            rpSetCamFooter('❌ ' + (err?.message || String(err)))
        })
    }

