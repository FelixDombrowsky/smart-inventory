<!-- ══════ TAB: RE-PRINT ══════ -->
<div class="tab-pane" id="tab-reprint">
<div class="rcp-grid">
<div class="rcp-left">

        <!-- Search W/O — เปิด modal Lot Summary (เหมือนหน้า WorkOrderLots.cshtml) ให้ช่วยหา Lot No ของ W/O นั้นมา Re-Print ได้เลย -->
        <button type="button" class="btn-outline" onclick="rprOpenWoSearch()"
            style="width:100%;margin-bottom:14px;padding:10px;display:flex;align-items:center;justify-content:center;gap:7px;font-size:13px;font-weight:700">
            <i class="bi bi-search"></i> Search W/O
        </button>

        <!-- Layout Template card -->
        <div class="rp-card" style="overflow:visible">
            <div class="rp-card-body">
                <label class="form-label" style="margin-bottom:5px">Layout Template <span class="req">*</span></label>
                <div style="display:flex;gap:6px;align-items:center">
                    <div style="position:relative;flex:1;min-width:0">
                        <select class="form-select" id="rprLayout" onchange="rprLayoutChange();rprShowError('rprLayout',false)" style="width:100%;appearance:none;-webkit-appearance:none;-moz-appearance:none;padding-right:32px;color:var(--t3);transition:border-color .15s,box-shadow .15s">
                            <option value="">-- Select Layout --</option>
                        </select>
                        <i class="bi bi-chevron-down" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--t3);pointer-events:none"></i>
                    </div>
                    <button class="btn-outline" style="padding:7px 10px;flex-shrink:0;display:flex;align-items:center;justify-content:center" onclick="goToDesignLayout(document.getElementById('rprLayout').value)" title="Design Layout"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                </div>
            </div>
        </div>

        <!-- Item list card -->
        <div class="rp-card" style="overflow:visible">
            <div class="rp-card-head">
                <span>Item List</span>
                <span class="rp-counter-badge" id="rprCounter">0/10</span>
            </div>
            <div class="rp-card-body" style="padding-bottom:12px">
                <div style="display:flex;gap:8px;align-items:center">
                    <div style="position:relative;flex:1">
                        <input class="form-input" id="rpReprintLot" placeholder="Search Lot No..."
                            onkeydown="if(event.key==='Enter'){rpSearchLot();event.preventDefault()}"
                            oninput="rprLotAutocomplete()"
                            onblur="setTimeout(rprHideLotDropdown, 180)"
                            style="width:100%;margin:0">
                        <div class="wo-dropdown" id="rprLotDropdown" style="display:none"></div>
                    </div>
                    <!-- Barcode type: Our (QR) vs Vendor -->
                    <div class="bc-mode-group" id="rprBcModeGroup" title="เลือกประเภท Barcode ที่จะอ่าน">
                        <button type="button" class="bc-mode-btn active" data-mode="our" onclick="setRprBarcodeMode('our')" title="Our Barcode">
                            <i class="bi bi-qr-code-scan"></i><span>Our</span>
                        </button>
                        <button type="button" class="bc-mode-btn" data-mode="vendor" onclick="setRprBarcodeMode('vendor')" title="Vendor Barcode">
                            <i class="bi bi-upc"></i><span>Vendor</span>
                        </button>
                    </div>
                    <button id="rprBtnCam" onclick="rprToggleCam()"
                        style="flex-shrink:0;height:42px;padding:0 14px;background:var(--blue);color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center">
                        <i class="bi bi-camera" style="font-size:18px"></i>
                    </button>
                    <button id="rprHwScanBtn" onclick="rpToggleHwScan()"
                        style="flex-shrink:0;height:42px;padding:0 14px;background:#6b7280;color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center">
                        <i class="bi bi-upc-scan" style="font-size:18px"></i>
                    </button>
                </div>
            </div>
            <div id="rprScanAnchor"></div>
            <div style="display:flex;align-items:center;gap:16px;padding:7px 14px;background:#f8f9fc;border-bottom:1px solid var(--border);font-size:11px;font-weight:700;color:var(--t2);letter-spacing:.04em;text-transform:uppercase">
                <div style="flex:1.4;min-width:0">Part No</div>
                <div style="flex:1.6;min-width:0">Lot No</div>
                <div style="width:42px;flex-shrink:0;text-align:right">Qty</div>
                <div style="width:48px;flex-shrink:0;text-align:right">Unit</div>
                <div style="flex-shrink:0">Location</div>
                <div style="width:130px"></div>
            </div>
            <div id="rprItemList">
                <div class="rp-empty-state">No items yet — scan or enter LOT NO</div>
            </div>
        </div>

    </div><!-- end .rcp-left -->

    <!-- RIGHT: Label Preview panel -->
    <div class="rcp-right">
        <div class="rp-card" style="overflow:visible">
            <div class="rp-card-head">
                <span><i class="bi bi-grid-3x3-gap-fill me-1"></i>Label Preview</span>
                <div class="rcp-pag" id="rprPreviewPag">
                    <button type="button" class="rcp-pag-btn" onclick="rprPreviewNav(-1)"><i class="bi bi-chevron-left"></i></button>
                    <span id="rprPreviewPagText">0 / 0</span>
                    <button type="button" class="rcp-pag-btn" onclick="rprPreviewNav(1)"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
            <div class="rp-card-body">
                <div class="rcp-preview-box" id="rprPreviewImgBox">
                    <div class="rp-empty-state">No items yet</div>
                </div>
                <div class="rcp-preview-meta" id="rprPreviewMeta"></div>

                <div class="rcp-divider"></div>

                <div class="rcp-row">
                    <span class="rcp-row-label"><i class="bi bi-printer me-1"></i>Printer</span>
                    <button type="button" class="rp-pd-refresh-btn" title="Refresh Printer" onclick="rpManualRefreshPrinters('rpReprint', this)">
                        <i class="bi bi-arrow-repeat"></i>
                    </button>
                </div>
                <div class="rp-pd-wrap" style="margin-bottom:16px">
                    <div class="rp-pd-trigger" id="rpReprintPrinterTrigger" tabindex="0"
                         onclick="rpPrinterDdToggle('rpReprint')">
                        <div class="rp-pd-val">
                            <span class="rp-pd-dot" id="rpReprintPrinterDot" style="display:none"></span>
                            <div>
                                <div class="rp-pd-sel-name" id="rpReprintPrinterName" style="color:var(--t2);font-weight:400">-- Select Printer --</div>
                                <div class="rp-pd-sel-ip" id="rpReprintPrinterIp" style="display:none"></div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-down rp-pd-chevron"></i>
                    </div>
                    <div class="rp-pd-menu" id="rpReprintPrinterMenu" style="display:none">
                        <div class="rp-pd-msg">⏳ Loading…</div>
                    </div>
                    <input type="hidden" id="rpReprintPrinterSelect">
                </div>

                <!-- Inline error เฉพาะ location mismatch — แยกจาก rprShowError('rpReprintPrinterTrigger') ของ error "ยังไม่ได้เลือก
                     Printer" เพราะ rprSyncPrintBtn() auto-clear ขอบแดงของ trigger ทันทีที่มี printer ถูกเลือกไว้แล้ว (ซึ่งกรณีนี้เลือกไว้
                     แล้วจริงๆ แค่ location ไม่ตรง) ถ้าใช้ error state เดียวกันจะโดนเคลียร์ทิ้งเงียบๆ ก่อน user ทันเห็นด้วยซ้ำ -->
                <div id="rprLocMismatchWarning" style="display:none;align-items:center;gap:8px;background:var(--red-lt);border:1px solid #fecaca;color:var(--red);font-size:12px;font-weight:600;border-radius:9px;padding:10px 12px;margin-bottom:14px;line-height:1.4">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span id="rprLocMismatchWarningText"></span>
                </div>

                <div class="rcp-row">
                    <span class="rcp-row-label"><i class="bi bi-chat-left-text me-1"></i>Print Reason <span class="req">*</span></span>
                </div>
                <input id="rpReprintReason" class="form-input" placeholder="Print Reason" style="margin-bottom:16px"
                    oninput="rprShowError('rpReprintReason', false)">

                <button id="rprPrintBtn" class="btn-primary rcp-print-btn" onclick="rprDoPrint()"
                    style="opacity:0.45;cursor:not-allowed" disabled>
                    <i class="bi bi-printer"></i> <span id="rprPrintBtnLabel">Re-Print</span>
                </button>
            </div>
        </div>
    </div>

</div><!-- end .rcp-grid -->

    <!-- ── Confirm Delete modal ── -->
    <div id="rprConfirmDeleteModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)rprCancelRemoveItem()">
        <div style="background:#fff;border-radius:14px;width:90%;max-width:320px;padding:24px 20px 16px;box-shadow:0 12px 40px rgba(0,0,0,.2);text-align:center">
            <i class="bi bi-trash3" style="font-size:36px;color:var(--red);display:block;margin-bottom:12px"></i>
            <p style="font-size:14px;font-weight:700;color:var(--navy);margin:0 0 4px">ลบรายการนี้?</p>
            <p id="rprDeleteLotLabel" style="font-size:12px;color:var(--t2);margin:0 0 16px;word-break:break-all"></p>
            <div style="display:flex;gap:8px">
                <button onclick="rprCancelRemoveItem()" style="flex:1;padding:11px;background:#f0f2f5;color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">ยกเลิก</button>
                <button onclick="rprConfirmRemoveItem()" style="flex:1;padding:11px;background:var(--red);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">ลบ</button>
            </div>
        </div>
    </div>

    <!-- ── Confirm Already-Printed modal — เตือนก่อนเพิ่ม Lot ที่ Print Status = Success แล้วจาก Search W/O เข้า Item List ── -->
