    .chk-dist-badge { font-size:11px; font-weight:700; padding:2px 9px; border-radius:20px; white-space:nowrap; margin-left:auto; }
    .chk-dist-badge-ok      { background:#dcfce7; color:#15803d; }
    .chk-dist-badge-warn    { background:#fef3c7; color:#92400e; }
    .chk-dist-badge-far     { background:#fee2e2; color:#991b1b; }
