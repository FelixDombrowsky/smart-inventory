    // -- Real-time Transactions widget: render session-summary rows (get-session ให้แค่ sessionNo/type/createdBy/createdAt/transactionCount/lots[]
    // ไม่มี partNo/workOrder/qty ต่อ transaction ตรงๆ — เลยแสดงเป็นแถวสรุประดับ session แทนแถวต่อ transaction ไม่ต้องยิง API เพิ่มต่อ lot)
    function fmtSessTime(d) {
        if (!d) return '—'
        return new Date(d).toLocaleString('th-TH-u-ca-gregory', { dateStyle: 'short', timeStyle: 'medium' })
    }
    // im.imageUrl มักเป็น null ใน payload ของ get-session/SignalR (ต่างจาก transaction list ปกติที่มี imageUrl ตรงๆ)
    // เลย fallback ไป im.filePath แทน — ยังไม่ยืนยัน 100% ว่า CONFIG.INVENTORY_API + filePath คือ URL ที่ถูกต้อง ต้องเช็คกับ backend
    function sessImgCell(images) {
        const urls = (images || []).map(im => CONFIG.INVENTORY_API + '/uploads/' + (im.imageUrl || im.filePath).replace(/^\/+/, ''))
        if (!urls.length) return `<span style="color:var(--t3)">—</span>`
        return `<div class="sess-thumb-wrap">
            <img src="${urls[0]}" class="sess-thumb" onclick="event.stopPropagation();openLightbox('${urls[0]}')"
                 onerror="this.onclick=null;this.style.cursor='default';this.src='${NO_IMG_ICON}'">
            ${urls.length > 1 ? `<span class="sess-thumb-badge">+${urls.length - 1}</span>` : ''}
        </div>`
    }
    // sessionType "ReLocation" ที่ backend ส่งมา ไม่มี key ตรงกันใน TX_TYPE_META (transactionTypeMeta.js) — โชว์เป็น "Move" แทนให้ตรงกับคำที่ใช้ทั้งแอป
    function sessDisplayType(t) {
        return t === 'ReLocation' ? 'Move' : t
    }
    // get-session ไม่มี fromLocation/toLocation มาให้ตรงๆ (มีแค่ lots[] ที่ id+lotNo) ต้องยิง /transaction/get แยก
    // กรองด้วย sessionNo เอาเอง (N+1 ต่อ session — รับได้เพราะ widget นี้โชว์แค่ 5-10 session ไม่ใช่ทั้งตาราง)
    // ผลเก็บไว้ใน s._fromLocation/_toLocation/_locMixed เพื่อให้ sessionRowHtml() ยังเป็น sync function เหมือนเดิม
    async function enrichSessionLocation(s) {
        try {
            // บาง sessionType (เช่น "Void" — เจอจากหน้า Transactions.cshtml เต็มว่า Void ไม่มี Session No จริง โชว์เป็น "—" ทุกแถว)
            // ไม่มี sessionNo จริงเลย — ถ้ายิง /transaction/get ไปพร้อม sessionNo ว่าง/null backend ดูเหมือนจะไม่กรองอะไรเลย
            // (คืน transaction ล่าสุดของทั้งระบบมาแทน ไม่ใช่ของ session นี้) ทำให้ sub-table โชว์รายการที่ไม่เกี่ยวข้องเลย —
            // เช็คก่อนเลยว่ามี sessionNo จริงไหม ไม่มีก็ไม่ต้องยิง fetch เลย (ปล่อยว่างไปดีกว่าโชว์ข้อมูลผิดๆ)
            if (!s.sessionNo) {
                s._txns = []; s._workOrders = []; s._lines = []; s._partNos = []
                s._fromLocation = null; s._toLocation = null; s._locMixed = false; s._locCount = 0
                return
            }
            const res     = await api('/transaction/get', 'POST', { sessionNo: s.sessionNo, page: 1, pageSize: 20 })
            const rawTxns = res?.data || []
            // กันเผื่ออีกชั้น แม้มี sessionNo จริงส่งไปแล้วก็ตาม — ไม่เชื่อว่า backend กรองมาให้ถูกเสมอ เอาแค่ record ที่ sessionNo
            // ตรงกับที่ขอเป๊ะๆ เท่านั้น (ถ้า backend เคยกรองผิดพลาดแบบ Void ด้านบน จะได้ไม่หลุดมาโชว์ผิด session)
            const txns = rawTxns.filter(t => t.sessionNo === s.sessionNo)
            s._txns = txns   // เก็บ transaction เต็มๆ ของ session นี้ไว้ ใช้วาด sub-table ตอนกดขยายแถว (sessSubRowHtml) ไม่ต้องยิง fetch ซ้ำ
            const fromSet = new Set(txns.map(t => t.fromLocation).filter(Boolean))
            const toSet   = new Set(txns.map(t => t.toLocation).filter(Boolean))
            s._fromLocation = fromSet.size === 1 ? [...fromSet][0] : null
            s._toLocation   = toSet.size   === 1 ? [...toSet][0]   : null
            s._locMixed     = fromSet.size > 1 || toSet.size > 1
            s._locCount     = Math.max(fromSet.size, toSet.size)
            // เก็บ WO ที่ transaction ใน session นี้แตะไว้ด้วย — เผื่อ caller อยากรีเฟรช WO นั้น (เช่น session นี้อาจ Receive เข้า
            // location Production แล้วเปลี่ยนยอด OnHand ที่ Time_to_Stockout ของ Line Status Board ใช้อยู่) ไม่ต้องยิง fetch ซ้ำ
            // ใช้ txns ก้อนเดียวกับที่ดึงมาแล้วด้านบนเลย
            s._workOrders = [...new Set(txns.map(t => t.workOrder).filter(Boolean))]
            // transaction record เองไม่มี field lineName ให้ (เช็คจาก sample จริงแล้ว) — ต้องเอา workOrder ไปหา lineName จาก
            // GET /workorder?WorkOrder=... แทน (fetchWorkOrderDetail() ฟังก์ชันเดียวกับที่ใช้รีเฟรช Line Status Board นั่นแหละ
            // response มี lineName ติดมาด้วยอยู่แล้ว) — ปกติ session นึงมักมีแค่ 1 WO เลยยิงไม่กี่ครั้ง
            const woDetails = await Promise.all(s._workOrders.map(fetchWorkOrderDetail))
            s._lines = [...new Set(woDetails.map(w => w?.lineName).filter(Boolean))]
            // Part No./Name แทนที่ Session No เดิมในคอลัมน์สรุป (ตามที่ขอ) — ต้อง fetch ชื่อ Part ล่วงหน้าตรงนี้เลย (ไม่ใช่ lazy
            // ตอนกดขยายเหมือน sub-table) เพราะ sessionRowHtml() เป็น sync function ต้องมีชื่อพร้อมใช้ตอน render แถวสรุปทันที
            s._partNos = [...new Set(txns.map(t => t.itemPartNo).filter(Boolean))]
            await fetchItemNames(s._partNos)
        } catch (_) {
            s._locError = true
            s._workOrders = []
            s._lines = []
            s._txns = []
            s._partNos = []
        }
    }
    // locTypeBadge(typeName) ของ locationTypeMeta.js รับ "location type" (warehouse/wip/production/...) ไม่ใช่ location code
    // ต้อง lookup master location เองก่อน (เอา pattern เดียวกับ locTypeBadge(code) ที่ override ไว้ใน Transactions.cshtml)
    let _dashLocations = []
    async function loadDashLocations() {
        try {
            const res  = await api('/location?page=1&pageSize=100', 'GET')
            const total = res.total, pgSize = res.pageSize
            const round = total / pgSize
            let arr = res.data || []
            for (let i = 1; i < round; i++) {
                const batch = await api(`/location?page=${i + 1}&pageSize=100`, 'GET')
                arr.push(...(batch.data || []))
            }
            _dashLocations = arr
        } catch (err) {
            console.warn('loadDashLocations:', err)
        }
    }
    function sessLocTypeBadge(code) {
        if (!code) return ''
        const found = _dashLocations.find(item => item.locationCode === code)
        const name  = found?.displayName ?? found?.locationCode ?? code
        const type  = found?.typeName ?? found?.type ?? ''
        return `<span class="loc-type-badge" style="${locTypeBadgeStyle(type)}">${locHierTypeIcon(type)}${name}</span>`
    }
    function sessLocationCell(s) {
        if (s._locError) return `<span style="color:var(--t3)">—</span>`
        if (s._locMixed) return `<span class="sess-badge" style="background:#f0f2f5;color:#475569">${s._locCount} locations</span>`
        if (!s._fromLocation && !s._toLocation) return `<span style="color:var(--t3)">—</span>`
        const from = sessLocTypeBadge(s._fromLocation)
        const to   = sessLocTypeBadge(s._toLocation)
        return `<div style="display:flex;align-items:center;gap:6px">${from}${s._fromLocation && s._toLocation ? '<i class="bi bi-arrow-right" style="color:var(--t3);font-size:11px"></i>' : ''}${to}</div>`
    }
    // ── ดึงชื่อ Part จาก /master/items ต่อ partNo (cache ไว้กันยิงซ้ำ — เอา pattern เดียวกับ Transactions.cshtml) ──
    let _dashItemNameCache = new Map()
    async function fetchItemNames(partNos) {
        const missing = [...new Set(partNos.filter(Boolean))].filter(p => !_dashItemNameCache.has(p))
        if (!missing.length) return
        await Promise.all(missing.map(async p => {
            try {
                // /master/items?PartNo=...&Page=1&PageSize=1 (list-search endpoint) ไม่คืนชื่อมาตรงๆ ตามที่ควร — ใช้
                // GET /master/item/{partNo} (เอกพจน์, path param ตรงๆ) แทน ซึ่งคืน { exists, description, unit } ตรงตัว
                const res = await api(`/master/item/${encodeURIComponent(p)}`, 'GET')
                _dashItemNameCache.set(p, res?.exists ? (res?.description ?? null) : null)
            } catch (_) { _dashItemNameCache.set(p, null) }
        }))
    }
    // ── แถวย่อยของ transaction เดี่ยวๆ ในตาราง sub-table ตอนกดขยาย session (เอา pattern เดียวกับ txSubRowHtml ของ Transactions.cshtml) ──
    function sessSubRowHtml(x) {
        const locHtml = (x.fromLocation || x.toLocation)
            ? `<div style="display:flex;align-items:center;gap:6px">${sessLocTypeBadge(x.fromLocation)}${x.fromLocation && x.toLocation ? '<i class="bi bi-arrow-right" style="color:var(--t3);font-size:11px"></i>' : ''}${sessLocTypeBadge(x.toLocation)}</div>`
            : `<span style="color:var(--t3)">—</span>`
        return `<tr>
            <td>${txTypeBadge(x.transactionType)}</td>
            <td><span class="sess-mono">${x.itemPartNo ?? '—'}</span></td>
            <td style="color:var(--t2)">${x.itemPartNo ? (_dashItemNameCache.get(x.itemPartNo) ?? '—') : '—'}</td>
            <td style="color:var(--t2);font-size:12px">${x.workOrder ?? '—'}</td>
            <td><span class="sess-mono">${x.lotNo ?? '—'}</span></td>
            <td>${locHtml}</td>
            <td>${x.quantity ?? '—'}</td>
            <td style="color:var(--navy);font-weight:500">${x.performedBy ?? '—'}</td>
        </tr>`
    }
    // ── กดขยาย session row ดู transaction ย่อยทั้งหมด — s._txns มาจาก enrichSessionLocation() ที่ยิงไปแล้วตั้งแต่โหลดแถวสรุป
    // (ไม่ต้อง fetch ซ้ำ) เหลือแค่ดึงชื่อ Part เพิ่มตอนเปิดครั้งแรกเท่านั้น (lazy — ไม่ดึงถ้าไม่มีใครกดขยายดู) ──
    async function toggleSessRow(key, sessionNo) {
        const content = document.getElementById(key)
        const btn     = document.getElementById('btn_' + key)
        if (!content || !btn) return
        const isOpen = content.classList.contains('expanded')
        if (!isOpen && !content.dataset.loaded) {
            const s = _sessBySessionNo.get(sessionNo)
            const txns = s?._txns ?? []
            await fetchItemNames(txns.map(x => x.itemPartNo))
            const tbody = content.querySelector('tbody')
            if (tbody) tbody.innerHTML = txns.length ? txns.map(sessSubRowHtml).join('') : `<tr><td colspan="8" class="rt-empty">No transactions</td></tr>`
            content.dataset.loaded = '1'
        }
        content.classList.toggle('expanded', !isOpen)
        btn.classList.toggle('open', !isOpen)
    }
    // เก็บ session object ล่าสุดไว้ต่อ sessionNo (มี ._txns ติดมาด้วยจาก enrichSessionLocation) ให้ toggleSessRow() หยิบไปใช้ได้
    // โดยไม่ต้อง fetch ซ้ำ — key ตรงกับ data-session ของแถว
    let _sessBySessionNo = new Map()
    // Part No./Name ของแถวสรุป — session เดียวอาจมีหลาย part ปนกัน (เช่น session Move ที่ลากหลาย lot คนละ part มาด้วยกัน)
    // มี part เดียวก็โชว์ตรงๆ ได้เลย ถ้ามีมากกว่า 1 โชว์ badge "N parts" แทน (เอา pattern เดียวกับ sessionGroupHtml ของ
    // Transactions.cshtml ที่ mixed-badge เวลาข้อมูลในกลุ่มไม่ตรงกันหมด)
    function sessPartCell(s) {
        const partNos = s._partNos || []
        if (!partNos.length) return `<span style="color:var(--t3)">—</span>`
        if (partNos.length > 1) return `<span class="sess-badge" style="background:#f0f2f5;color:#475569">${partNos.length} parts</span>`
        return `<span class="sess-mono">${partNos[0]}</span>`
    }
    function sessNameCell(s) {
        const partNos = s._partNos || []
        if (partNos.length !== 1) return `<span style="color:var(--t3)">—</span>`
        return `<span style="color:var(--t2)">${_dashItemNameCache.get(partNos[0]) ?? '—'}</span>`
    }
    // Work Order — s._workOrders มาจาก enrichSessionLocation() อยู่แล้ว (เก็บไว้เผื่อรีเฟรช Line Status Board ด้วย) ใช้ pattern
    // เดียวกับ sessPartCell (single WO โชว์ตรงๆ, หลาย WO ปนกันโชว์ badge "N WOs")
    function sessWorkOrderCell(s) {
        const wos = s._workOrders || []
        if (!wos.length) return `<span style="color:var(--t3)">—</span>`
        if (wos.length > 1) return `<span class="sess-badge" style="background:#f0f2f5;color:#475569">${wos.length} WOs</span>`
        return `<span style="color:var(--t2);font-size:12px">${wos[0]}</span>`
    }
    // Line — s._lines มาจาก enrichSessionLocation() (lineName ของ WO ที่เกี่ยวข้อง ไม่ใช่ field บน transaction เอง) ใช้ pattern เดียวกับ sessWorkOrderCell
    function sessLineCell(s) {
        const lines = s._lines || []
        if (!lines.length) return `<span style="color:var(--t3)">—</span>`
        if (lines.length > 1) return `<span class="sess-badge" style="background:#f0f2f5;color:#475569">${lines.length} lines</span>`
        return `<span style="color:var(--t2);font-size:12px">${lines[0]}</span>`
    }
    function sessionRowHtml(s) {
        _sessBySessionNo.set(s.sessionNo, s)
        const key = 'sess_' + s.sessionNo.replace(/[^a-zA-Z0-9]/g, '')
        // session ที่ transactionCount = 0 = กดทำรายการแล้วแต่ไม่สำเร็จเลยสัก lot (backend สร้าง session + ยิง SignalR ก่อนประมวลผล lot)
        // ยังโชว์ไว้ให้เห็นว่ามีคนพยายามทำ แต่เป็นแถวสีจาง + badge ไม่สำเร็จ (หน้า Transactions ไม่มีแถวพวกนี้เพราะไม่มี transaction จริง)
        const failed = Number(s.transactionCount) === 0
        const dict = dashDict()
        const txnsCell = failed
            ? `<span class="sess-fail-badge" title="${dict.sessFailedTip}"><i class="bi bi-x-circle"></i> ${dict.sessFailed}</span>`
            : (s.transactionCount ?? '—')
        return `<tr class="sum-row${failed ? ' sess-failed' : ''}" data-session="${s.sessionNo}" onclick="toggleSessRow('${key}','${s.sessionNo}')">
            <td>
                <div style="display:flex;align-items:center;gap:8px">
                    <button class="expand-btn" id="btn_${key}">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
                    </button>
                    ${txTypeBadge(sessDisplayType(s.sessionType))}
                </div>
            </td>
            <td>${sessPartCell(s)}</td>
            <td>${sessNameCell(s)}</td>
            <td>${sessLineCell(s)}</td>
            <td>${sessWorkOrderCell(s)}</td>
            <td>${sessLocationCell(s)}</td>
            <td class="sess-txns-cell">${txnsCell}</td>
            <td style="color:var(--navy);font-weight:500">${s.createdBy ?? '—'}</td>
            <td style="text-align:center">${sessImgCell(s.images)}</td>
            <td style="color:var(--t3);font-size:12px">${fmtSessTime(s.createdAt)}</td>
        </tr>
        <tr class="sub-row">
            <td colspan="10">
                <div class="sub-content" id="${key}">
                    <div class="sub-inner">
                        <table class="sub-table">
                            <thead><tr>
                                <th>Type</th><th>Part No.</th><th>Name</th><th>Work Order</th><th>Lot</th><th>Location</th><th>Qty</th><th>By</th>
                            </tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </td>
        </tr>`
    }

    // -- push แถวใหม่จาก SignalR เข้า rtTxBody: session เดิม (sessionNo ซ้ำ — เช่น transactionCount เพิ่มขึ้น) ให้แทนที่แถวเดิม
    // ไม่ใช่ดันแถวใหม่ซ้อน, session ใหม่เอาขึ้นบนสุดเสมอ แล้วตัดให้เหลือแค่ RT_TX_MAX แถว กัน list ยาวเรื่อยๆ — เพิ่มจาก 5 เป็น 10
    // ตามที่ขอ (เลื่อนดูได้ 10 transaction, ให้ตรงกับ pageSize ที่ loadLastSessions() ดึงมาตอน bootstrap อยู่แล้วด้วย)
    const RT_TX_MAX = 10
    async function upsertSessionRow(dto) {
        console.log("DTO : ", dto)
        await enrichSessionLocation(dto)

        const body = document.getElementById('rtTxBody')
        const placeholder = body.querySelector('.rt-empty')
        if (placeholder) placeholder.closest('tr').remove()

        // ลบทั้งคู่ (sum-row + sub-row ที่ตามติดกัน) ของ session เดิมถ้ามี — sessionRowHtml() คืนมา 2 <tr> ต่อ 1 session แล้ว
        // (สรุป + sub-table ที่ซ่อนไว้) ไม่ใช่แถวเดียวเหมือนเดิม ลบแค่ตัวแรกจะเหลือ sub-row ค้างเป็น orphan
        const existing = body.querySelector(`tr[data-session="${dto.sessionNo}"]`)
        if (existing) {
            const sub = existing.nextElementSibling
            if (sub && sub.classList.contains('sub-row')) sub.remove()
            existing.remove()
        }

        body.insertAdjacentHTML('afterbegin', sessionRowHtml(dto))

        // นับ/ตัดตาม "จำนวน session" (.sum-row) ไม่ใช่นับ <tr> ทั้งหมด เพราะ 1 session = 2 <tr> แล้ว (นับ <tr> ตรงๆ จะเหลือ
        // จริงแค่ RT_TX_MAX/2 session)
        Array.from(body.querySelectorAll('tr.sum-row')).slice(RT_TX_MAX).forEach(tr => {
            const sub = tr.nextElementSibling
            if (sub && sub.classList.contains('sub-row')) sub.remove()
            _sessBySessionNo.delete(tr.dataset.session)   // กัน Map โตไม่รู้จบถ้าเปิดจอทิ้งไว้นานๆ (แถวหลุดจาก DOM แล้วแต่ data ยังค้าง)
            tr.remove()
        })

        document.getElementById('rtTxUpdated').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-GB')

        // session นี้อาจกระทบยอด OnHand ที่ location Production ของ WO ที่เกี่ยวข้อง (เช่น Receive เข้า Production) ซึ่งเป็น field
        // ที่ Time_to_Stockout ของ Line Status Board ใช้อยู่ — รีเฟรช WO นั้นด้วย pattern เดียวกับตอน WorkOrder push
        // (fetchWorkOrderDetail + lsbApplyLiveUpdate) ไม่ await ตรงนี้ เพราะไม่อยากให้ตาราง Transactions ช้าลงรอ WO ที่อาจไม่เกี่ยว
        // กับ Line Status Board เลยก็ได้ (dto._workOrders มาจาก enrichSessionLocation() ด้านบนแล้ว ไม่ต้องยิง fetch ซ้ำเพื่อหา WO)
        dto._workOrders?.forEach(async mo => {
            const full = await fetchWorkOrderDetail(mo)
            if (full) lsbApplyLiveUpdate(full)
        })
    }

    // -- Load Last 5 Transaction Sessions
    async function loadLastSessions() {
        try {
            const res = await api('/transaction/get-session', 'POST', {
                "page": 1,
                "pageSize": 10
            });
            const sessions = res?.data || []
            await Promise.all(sessions.map(enrichSessionLocation))
            document.getElementById('rtTxBody').innerHTML = sessions.length
                ? sessions.map(sessionRowHtml).join('')
                : `<tr><td colspan="10" class="rt-empty">No recent sessions</td></tr>`
            document.getElementById('rtTxUpdated').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-GB')
        } catch (e) {
            console.warn('load Last 5 Sessions error :', e);
        }
    }

    // -- Real-time Work Orders widget
    // % On Hand / % FG Output มาจาก rate ที่ backend คำนวณมาให้แล้ว (totalOnHandRate / achievementRate) ไม่ต้องมาคิด num/den เอง
    function pctBar(rate, color) {
        if (rate == null) return `<span style="color:var(--t3)">—</span>`
        const clamped = Math.max(0, Math.min(100, rate))
        return `<div class="pct-bar-wrap">
            <div class="pct-bar-track"><div class="pct-bar-fill" style="width:${clamped}%;background:${color}"></div></div>
            <span class="pct-bar-label" style="color:${color}">${rate.toFixed(1)}%</span>
        </div>`
    }
    function workOrderRowHtml(wo) {
        return `<tr data-mo="${wo.moNumber}">
            <td><span class="wo-num">${wo.moNumber}</span></td>
            <td>${wo.lineName ?? '—'}</td>
            <td>${pctBar(wo.totalOnHandRate, 'var(--blue)')}</td>
            <td>${pctBar(wo.achievementRate, 'var(--green)')}</td>
            <td style="color:var(--t3);font-size:12px">${fmtSessTime(wo.updateAt)}</td>
        </tr>`
    }

    // SignalR "WorkOrdersChanged" ส่งมาแค่ closeDate/inputQty/lastSyncedAt/lineName/moNumber/modelName/outputQty/scrapQty/status/targetQty
    // ไม่มี totalOnHandRate/achievementRate/updateAt ที่ workOrderRowHtml() ต้องใช้ — เอา moNumber ไป search ใน GET /workorder แทนเพื่อได้ข้อมูลครบ
    async function fetchWorkOrderDetail(moNumber) {
        try {
            const res  = await api(`/workorder?Page=1&PageSize=1&WorkOrder=${encodeURIComponent(moNumber)}`, 'GET')
            const list = res?.data?.data || []
            // ตัด fallback ไปใช้ list[0] ทิ้ง — ถ้า filter ไม่ exact match เป๊ะ อาจได้ WO คนละตัวมาแปะทับ moNumber ที่ push มาแบบเงียบๆ
            return list.find(w => w.moNumber === moNumber) || null
        } catch (err) {
            console.warn('fetchWorkOrderDetail:', err)
            return null
        }
    }

    // -- push แถวใหม่จาก SignalR เข้า rtWoBody: MO เดิม (data-mo ซ้ำ) ให้แทนที่แถวเดิม ไม่ใช่ดันซ้อน, MO ที่เพิ่งเปลี่ยนเอาขึ้นบนสุดเสมอ
    // แล้วตัดให้เหลือแค่ RT_WO_MAX แถว กัน list ยาวเรื่อยๆ (เอา pattern เดียวกับ upsertSessionRow ของตาราง Transactions)
    const RT_WO_MAX = 10
    function upsertWorkOrderRow(wo) {
        const body = document.getElementById('rtWoBody')
        const placeholder = body.querySelector('.rt-empty')
        if (placeholder) placeholder.closest('tr').remove()

        const existing = body.querySelector(`tr[data-mo="${wo.moNumber}"]`)
        if (existing) existing.remove()

        body.insertAdjacentHTML('afterbegin', workOrderRowHtml(wo))

        Array.from(body.querySelectorAll('tr')).slice(RT_WO_MAX).forEach(tr => tr.remove())

        document.getElementById('rtWoUpdated').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-GB')
    }

    // -- Load Last 5 WorkOrder
    async function loadLastWorkorders() {
        try {
            const res = await api('/workorder?Page=1&PageSize=10&SortBy=updateAt&SortDir=desc', 'GET')
            const list = res?.data?.data || []
            document.getElementById('rtWoBody').innerHTML = list.length
                ? list.map(workOrderRowHtml).join('')
                : `<tr><td colspan="5" class="rt-empty">No recent work orders</td></tr>`
            document.getElementById('rtWoUpdated').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-GB')
        } catch (err) {
            console.warn('load last 5 Workorders error : ', err)
        }
    }

    // ══════════════ DASHBOARD TABS: Transactions / Work Orders / Line Dashboard ══════════════
    // รวม switchDashTab() (Live Feed/Line Status Board ชั้นนอกเดิม) กับ rtSwitchView() (Transactions/Work Orders ชั้นในเดิม)
    // เป็นฟังก์ชันเดียว คุม 3 view เสมอกันในแถวปุ่มเดียว (ตามที่ขอ) — 'tx'/'wo' โชว์แค่ section-card เต็มความกว้าง (SignalR ของทั้งคู่
    // ยังรับ push อัปเดตเบื้องหลังตลอดไม่ว่าจะโชว์อยู่หรือเปล่า ไม่ต้อง gate เพราะเป็นแค่ push เบาๆ ไม่ใช่ REST poll หนักแบบ board),
    // 'board' โชว์ Line Status Board wallboard ซึ่งยัง gate ด้วย _lsbActive เหมือนเดิม (เริ่ม/หยุด REST poll หนักๆ ตามที่เปิดดูอยู่จริง)
    let _lsbActive = false   // true เฉพาะตอน view 'board' กำลังโชว์อยู่ — กัน auto-refresh ยิง API ตอนไม่ได้ดูอยู่
    function switchDashView(name) {
        document.getElementById('rtCardTx').style.display     = name === 'tx'    ? '' : 'none'
        document.getElementById('rtCardWo').style.display     = name === 'wo'    ? '' : 'none'
        document.getElementById('dashTabBoard').style.display = name === 'board' ? '' : 'none'
        document.getElementById('l3dCard').style.display      = name === '3d'    ? '' : 'none'
        document.getElementById('dashTabBtnTx').classList.toggle('active', name === 'tx')
        document.getElementById('dashTabBtnWo').classList.toggle('active', name === 'wo')
        document.getElementById('dashTabBtnBoard').classList.toggle('active', name === 'board')
        document.getElementById('dashTabBtn3d').classList.toggle('active', name === '3d')
        _lsbActive = name === 'board'
        if (_lsbActive) { loadLineStatusBoard(); lsbStartOrdersPolling(); lsbStartFullRefreshPolling() }
        else { lsbStopOrdersPolling(); lsbStopFullRefreshPolling() }
        if (name === '3d') ensureLayout3D()
    }

    // 3D Layout โหลดแบบ lazy — ยังไม่ดึง three.js (~1.8MB) / ยิง API สต็อกต่อ location จนกว่าจะกดแทป 3D ครั้งแรก
    let _layout3dPromise = null
    function ensureLayout3D() {
        if (!_layout3dPromise) {
            _layout3dPromise = import('@Html.Raw(FileVersion.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/js/layout3d.js")))')
                .then(() => window.Layout3D)
                .catch(err => { _layout3dPromise = null; console.error('Layout3D load failed', err); throw err })
        }
        return _layout3dPromise
    }
    // ชื่อ location บนผัง 3D = RE_xx / PR_xx / BR_xx (ดู ZONE ใน layout3d.js) — เช็คจากชื่อตัวเองหรือ parent ที่ไล่ขึ้นไป
    function dashLocOnLayout(code) {
        let loc = _dashLocations.find(l => l.locationCode === code), guard = 0
        while (loc && guard++ < 12) {
            if (/^(RE|PR|BR)[_\s-]?\d{2}$/i.test((loc.displayName || '').trim())) return true
            loc = loc.parentLocationId != null ? _dashLocations.find(l => l.id === loc.parentLocationId) : null
        }
        return false
    }
    async function openLayout3DAt(code) {
        switchDashView('3d')
        document.querySelector('.dash-tabs')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
        try { (await ensureLayout3D())?.focus(code) } catch (_) { }
    }

    function lsbToggleFullscreen() {
        const el = document.getElementById('lsbWrap')
        if (!document.fullscreenElement) el.requestFullscreen?.()
        else document.exitFullscreen?.()
    }
    document.addEventListener('fullscreenchange', () => {
        const icon = document.getElementById('lsbFsIcon')
        if (icon) icon.className = document.fullscreenElement ? 'bi bi-fullscreen-exit' : 'bi bi-arrows-fullscreen'
    })

    // ลากเส้นแบ่งกลาง ปรับสัดส่วนซ้าย(Line Status)/ขวา(Queue) ได้เอง — จำสัดส่วนไว้ใน localStorage ต่อเบราว์เซอร์
    // (ไม่ sync ข้าม device/ผู้ใช้อื่น เป็นแค่ความสะดวกส่วนตัวของคนดูจอนี้)
    ;(function lsbInitResizer() {
        const LSB_SPLIT_KEY = 'sf_lsb_split_pct'
        const MIN_PCT = 25, MAX_PCT = 75
        const grid     = document.getElementById('lsbGrid')
        const left     = document.getElementById('lsbPanelLeft')
        const resizer  = document.getElementById('lsbResizer')
        if (!grid || !left || !resizer) return

        try {
            const saved = parseFloat(localStorage.getItem(LSB_SPLIT_KEY))
            if (!isNaN(saved)) left.style.flexBasis = saved + '%'
        } catch (_) {}

        let dragging = false
        resizer.addEventListener('mousedown', e => {
            dragging = true
            resizer.classList.add('lsb-resizer-active')
            document.body.style.userSelect = 'none'
            e.preventDefault()
        })
        document.addEventListener('mousemove', e => {
            if (!dragging) return
            const rect = grid.getBoundingClientRect()
            let pct = ((e.clientX - rect.left) / rect.width) * 100
            pct = Math.min(MAX_PCT, Math.max(MIN_PCT, pct))
            left.style.flexBasis = pct + '%'
        })
        document.addEventListener('mouseup', () => {
            if (!dragging) return
            dragging = false
            resizer.classList.remove('lsb-resizer-active')
            document.body.style.userSelect = ''
            try { localStorage.setItem(LSB_SPLIT_KEY, parseFloat(left.style.flexBasis)) } catch (_) {}
        })
    })()

    // ปุ่มหุบ/แสดง Priority panel (ขวา) ทั้งแถบ ให้ Line Status Board (ซ้าย) เต็มจอ — จำ state ไว้ต่อเบราว์เซอร์เหมือน split ratio ด้านบน
    const LSB_PRIORITY_HIDDEN_KEY = 'sf_lsb_priority_hidden'
    function lsbApplyPriorityPanelState(hidden) {
        const right   = document.getElementById('lsbPanelRight')
        const resizer = document.getElementById('lsbResizer')
        const left    = document.getElementById('lsbPanelLeft')
        const icon    = document.getElementById('lsbPriorityToggleIcon')
        const btn     = document.getElementById('lsbPriorityToggleBtn')
        if (!right || !resizer || !left) return
        if (hidden) {
            if (left.dataset.lsbPrevBasis === undefined) left.dataset.lsbPrevBasis = left.style.flexBasis || ''
            left.style.flexBasis = '100%'
        } else {
            left.style.flexBasis = left.dataset.lsbPrevBasis || ''
            delete left.dataset.lsbPrevBasis
        }
        right.style.display   = hidden ? 'none' : ''
        resizer.style.display = hidden ? 'none' : ''
        if (icon) icon.className = hidden ? 'bi bi-arrow-bar-left' : 'bi bi-arrow-bar-right'
        if (btn)  btn.title = hidden ? 'Show Priority panel' : 'Hide Priority panel'
    }
    function lsbTogglePriorityPanel() {
        const right  = document.getElementById('lsbPanelRight')
        if (!right) return
        const hidden = right.style.display !== 'none'   // ตอนนี้ยังโชว์อยู่ = กำลังจะหุบ
        lsbApplyPriorityPanelState(hidden)
        try { localStorage.setItem(LSB_PRIORITY_HIDDEN_KEY, hidden ? '1' : '0') } catch (_) {}
    }
    ;(function lsbInitPriorityToggle() {
        let hidden = false
        try { hidden = localStorage.getItem(LSB_PRIORITY_HIDDEN_KEY) === '1' } catch (_) {}
        if (hidden) lsbApplyPriorityPanelState(true)
    })()

    // นาฬิกาบนบอร์ด — เดินตลอดเวลาเบาๆ ไม่ต้องรอ tab active (แค่ set textContent ไม่มี cost อะไร)
    // countdown ไปรอบ full refresh อัตโนมัติถัดไป (_lsbNextFullRefreshAt ตั้งจาก lsbStartFullRefreshPolling) ใช้ตัว interval เดียวกัน
    // นี้เลย ไม่ต้องเปิด setInterval เพิ่ม — ใช้ได้ทั้ง 2 โหมด Busrun Order/FA Tracking เพราะ timer ตัวเดียวกัน ไม่แยกตาม _lsbBoardMode
    setInterval(() => {
        const el = document.getElementById('lsbClock')
        if (el) el.textContent = new Date().toLocaleTimeString('en-GB')

        const cd = document.getElementById('lsbRefreshCountdown')
        if (cd) {
            if (_lsbNextFullRefreshAt) {
                const totalSec = Math.max(0, Math.round((_lsbNextFullRefreshAt - Date.now()) / 1000))
                const mm = String(Math.floor(totalSec / 60)).padStart(2, '0')
                const ss = String(totalSec % 60).padStart(2, '0')
                cd.textContent = `Refresh in ${mm}:${ss}`
            } else {
                cd.textContent = ''
            }
        }
    }, 1000)

    function _lsbEsc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }

    // การ์ดฝั่งซ้าย (1 การ์ดต่อ 1 line) — สีตอนนี้อิงสถานะ ไม่ใช่ achievementRate อีกต่อไป (ตามที่ขอ) เรียง priority จากเร่งด่วนสุดไปน้อยสุด
    // แยกตาม _lsbBoardMode (ดู lsbSetBoardMode) 2 โหมด:
    // - "busrun" (เดิม): ORDER LATE (แดง) > ORDER CALLED (ส้ม) > IN PRODUCTION (เขียว) > NO PRODUCE (เทา) — 2 ตัวแรกมาจาก ORDERS_API
    //   /orders/pre-shipment (โพลตามความถี่ที่ปรับได้จาก dropdown #lsbRefreshIntervalSelect — ดู lsbFetchPreShipmentOrders/_lsbOrdersByLine)
    //   ไม่ผูกกับว่ามี WO current อยู่หรือเปล่า
    //   เพราะเป็น order เตรียมวัตถุดิบล่วงหน้าได้ก่อน WO จะเริ่มจริง
    // - "fa" (FA Tracking): SCRAP > 10 (แดง) > SCRAP > 5 (ส้ม) > IN PRODUCTION/NO PRODUCE เหมือนเดิม — scrapQty ของ current WO เอง
    //   (ไม่มี WO = เช็ค scrap ไม่ได้ ตกไปที่ producing/no-produce เหมือน busrun ปกติ)
    // IN PRODUCTION เช็คตรงจาก /lines เอง (ตามที่ขอ) ไม่ต้องพึ่ง /schedules อีกต่อไป: ไม่มี current WO = NO PRODUCE,
    // มี current WO แต่ status ไม่ใช่ 1 (Producing) ก็ตีเป็น NO PRODUCE เหมือนกัน — ใช้ร่วมกันทั้ง 2 โหมด
    // ld = { lineName, current, next } — มาจาก lsbRenderFromState() group by line จาก _lsbWoState แล้วเรียง achievementRate desc เอง (index 0/1)
    // แยกออกมาจาก lsbCardHtml เพื่อให้ lsbLinesStat (นับจำนวนไลน์ red+amber) ใช้เกณฑ์เดียวกับสีการ์ดเป๊ะ ไม่ต้องเขียนเงื่อนไขซ้ำ
    function lsbCardSeverity(ld) {
        const wo = ld.current
        const producing = wo?.status === 1
        if (_lsbBoardMode === 'fa') {
            const scrap = wo?.scrapQty ?? 0
            if (wo && scrap > 10) return 'red'
            if (wo && scrap > 5)  return 'amber'
            return producing ? 'green' : 'gray'
        }
        const orderInfo = _lsbOrdersByLine.get(ld.lineName)
        const isLate    = !!orderInfo?.isLate
        const isCalled  = !!orderInfo && !isLate
        if (isLate)   return 'red'
        if (isCalled) return 'amber'
        return producing ? 'green' : 'gray'
    }
    // Order (จาก ORDERS_API /orders/pre-shipment, ตัดที่ยกเลิกออกแล้ว — ดู lsbFetchPreShipmentOrders) อ้างอิง WO ด้วย field
    // "woNo" (string, ตรงกับ moNumber ของ WO เป๊ะ) — เช็คว่า WO ตัวที่กำลังจะโชว์บนการ์ด (Present หรือ Next) มี Order ที่เข้ามาเป็น
    // ของตัวเองไหม คืน order object ตัวที่ match มาเลย (เอาไป, เช็ค isLateNow ของ order ตัวนั้นเองต่อ ไม่ใช่ isLate รวมของทั้ง line)
    // ถ้า Order เป็นของ WO อื่นที่ไม่ได้โชว์อยู่บนบอร์ดนี้ (ไม่ใช่ Present/Next) ปล่อยไว้เหมือนเดิม (คืน null)
    function lsbOrderMatchesWo(lineName, moNumber) {
        // เฉพาะโหมด Busrun Order เท่านั้น — FA Tracking เป็นเรื่อง scrap ไม่เกี่ยวกับ shipment order เลย highlight นี้ไม่มีความหมาย
        // ในโหมดนั้น (แทบทุกใบติด highlight รกจอเปล่าๆ)
        if (_lsbBoardMode === 'fa') return null
        if (!moNumber) return null
        return _lsbOrdersByLine.get(lineName)?.orders.find(o => o.woNo === moNumber) ?? null
    }
    // Highlight เลข WO ตรงๆ แทน badge แยกบรรทัด (เปลืองที่) — สีตามสถานะ order ที่ match: ยัง Called (ไม่ late) = เหลือง/amber
    // เหมือนเดิม, Late แล้ว (isLateNow) = แดง ให้ตรงกับ severity สี Order Called/Order Late ที่ใช้กับตัวการ์ดเอง
    function lsbOrderHl(lineName, moNumber) {
        const text  = _lsbEsc(moNumber ?? '—')
        const order = lsbOrderMatchesWo(lineName, moNumber)
        if (!order) return text
        const cls = order.isLateNow ? 'lsb-order-hl-late' : 'lsb-order-hl'
        return `<span class="${cls}">${text}</span>`
    }
    function lsbCardHtml(ld) {
        const wo  = ld.current
        const sev = lsbCardSeverity(ld)
        const cls = 'lsb-card-' + sev
        const dot = { red: '#ef4444', amber: '#f59e0b', green: '#22c55e', gray: '#64748b' }[sev]
        if (!wo) {
            // ไม่มี current WO แต่ยังมี next WO รออยู่ได้ (เช่น line เพิ่งจบ WO เดิมไป) — โชว์ "Next: ..." แทน "No active WO" เฉยๆ
            const noWoLabel = ld.next ? `Next: ${lsbOrderHl(ld.lineName, ld.next.moNumber)}` : 'No active WO'
            return `<div class="lsb-card ${cls}" data-line="${_lsbEsc(ld.lineName)}" onclick="lsbOpenLineSchedule(this.dataset.line)">
                <div class="lsb-card-top"><span class="lsb-card-dot" style="background:${dot}"></span>${_lsbEsc(ld.lineName)}</div>
                <div class="lsb-card-mo">—</div>
                <div class="lsb-card-model">${noWoLabel}</div>
                <div class="lsb-card-ach-row"><span>ACH</span><span>—</span></div>
                <div class="lsb-card-bar-bg"><div class="lsb-card-bar-fill" style="width:0%"></div></div>
            </div>`
        }
        const ach = wo.achievementRate ?? 0
        const nextLabel = ld.next ? `Next: ${lsbOrderHl(ld.lineName, ld.next.moNumber)}` : 'Next: —'
        const statRowHtml = _lsbBoardMode === 'fa'
            ? `<div class="lsb-card-ach-row"><span>SCRAP</span><span>${(wo.scrapQty ?? 0).toLocaleString()}</span></div>
            <div class="lsb-card-bar-bg"><div class="lsb-card-bar-fill" style="width:${Math.min(100, ((wo.scrapQty ?? 0) / 10) * 100)}%;background:${dot}"></div></div>`
            : `<div class="lsb-card-ach-row"><span>ACH</span><span>${ach.toFixed(1)}%</span></div>
            <div class="lsb-card-bar-bg"><div class="lsb-card-bar-fill" style="width:${Math.min(100, Math.max(0, ach))}%"></div></div>`
        return `<div class="lsb-card ${cls}" data-line="${_lsbEsc(ld.lineName)}" onclick="lsbOpenLineSchedule(this.dataset.line)">
            <div class="lsb-card-top"><span class="lsb-card-dot" style="background:${dot}"></span>${_lsbEsc(ld.lineName)}</div>
            <div class="lsb-card-mo">${lsbOrderHl(ld.lineName, wo.moNumber)}</div>
            <div class="lsb-card-model">${nextLabel}</div>
            ${statRowHtml}
        </div>`
    }

    // ── Schedule modal (คลิก Line card ฝั่งซ้าย) ── ดึง GET /schedules?lineCode=...&page=1&pageSize=20 มาแสดงตาราง
    function lsbFmtSchedTime(iso) {
        if (!iso) return '—'
        const d = new Date(iso)
        if (isNaN(d.getTime())) return '—'
        const pad = n => String(n).padStart(2, '0')
        return `${d.getFullYear()}/${pad(d.getMonth() + 1)}/${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`
    }
    // exchangeTime มาเป็นนาทีตรงๆ จาก API — โชว์ทั้งหน่วยนาที/ชั่วโมงคู่กัน (ค่าคงที่ตอนดึงมา ไม่ใช่ live countdown)
    function lsbFmtExchangeTime(mins) {
        if (mins == null) return '—'
        return `${mins.toLocaleString()}m/${(mins / 60).toFixed(1)}h`
    }
    // Progress = outputQty / targetQty (เปลี่ยนจาก collectionQty ตามที่ขอ)
    function lsbScheduleProgress(s) {
        const target = s.targetQty ?? 0
        if (!target) return 0
        return Math.min(100, Math.max(0, (s.outputQty ?? 0) / target * 100))
    }
    // ตัด column Status (เดาจาก startDate/closeDate เอง) ออก เหลือใช้แค่ field "flag" จาก API ตรงๆ แทน (ตามที่ขอ) — รูปแบบ
    // "<จีน>--<อังกฤษ>" เช่น "生產中--In production" เอาแค่ฝั่งอังกฤษมาโชว์ แล้วจัดสีตามคำที่เจอจริงจาก sample: In production/
    // Pause/Unproduced/Close — คำอื่นที่ไม่เข้าเงื่อนไขไหนเลย fallback เป็นสีเทากลาง
    function lsbFlagInfo(s) {
        const raw   = (s.flag || '').split('--').pop()?.trim() || s.flag || '—'
        const lower = raw.toLowerCase()
        if (lower.includes('production')) return { text: raw, cls: 'lsb-sched-status-prod' }
        if (lower.includes('pause'))      return { text: raw, cls: 'lsb-sched-status-pause' }
        if (lower.includes('unproduced')) return { text: raw, cls: 'lsb-sched-status-idle' }
        if (lower.includes('close'))      return { text: raw, cls: 'lsb-sched-status-done' }
        return { text: raw, cls: 'lsb-sched-status-idle' }
    }
    // สีแท่ง progress ตามสถานะ: Done = เขียว, Producing = เหลือง/amber, Paused = เทา, no prod (ยังไม่เริ่ม) = สีเดิม (blue)
    function lsbScheduleProgressBarHtml(pct, statusCls, s) {
        const fillColor = statusCls === 'lsb-sched-status-done'  ? 'var(--green)'
            : statusCls === 'lsb-sched-status-prod'  ? 'var(--amber)'
            : statusCls === 'lsb-sched-status-pause' ? '#64748b'
            : 'var(--blue)'
        // Progress = outputQty / targetQty × 100 — โชว์สูตร + ค่าดิบให้ดูตอน hover
        const title = `${(s.outputQty ?? 0).toLocaleString()} / ${(s.targetQty ?? 0).toLocaleString()} (outputQty / targetQty × 100)`
        return `<div class="lsb-sched-progress" title="${_lsbEsc(title)}">
            <div class="lsb-sched-progress-bg"><div class="lsb-sched-progress-fill" style="width:${Math.min(100, Math.max(0, pct))}%;background:${fillColor}"></div></div>
            <span>${pct.toFixed(2)}%</span>
        </div>`
    }
    function lsbRenderLineSchedule(rows) {
        const body = document.getElementById('lsbLineScheduleBody')
        if (!rows.length) { body.innerHTML = `<tr><td colspan="13" class="lsb-sched-empty">No schedule found</td></tr>`; return }
        body.innerHTML = rows.map(s => {
            const flagInfo = lsbFlagInfo(s)
            const rowCls = flagInfo.cls === 'lsb-sched-status-prod' ? ' class="lsb-sched-row-prod"' : ''
            return `<tr${rowCls}>
                <td style="font-family:ui-monospace,monospace;font-weight:700">${_lsbEsc(s.moNumber ?? '—')}</td>
                <td style="font-family:ui-monospace,monospace">${_lsbEsc(s.scheduleNo ?? '—')}</td>
                <td>${_lsbEsc(s.model ?? '—')}</td>
                <td>${lsbScheduleProgressBarHtml(lsbScheduleProgress(s), flagInfo.cls, s)}</td>
                <td><span class="lsb-sched-status ${flagInfo.cls}">${_lsbEsc(flagInfo.text)}</span></td>
                <td>${lsbFmtSchedTime(s.startDate)}</td>
                <td>${lsbFmtSchedTime(s.closeDate)}</td>
                <td>${s.outputQty != null ? s.outputQty.toLocaleString() : '—'}</td>
                <td>${lsbFmtSchedTime(s.planStartTime)}</td>
                <td>${lsbFmtSchedTime(s.planFinishTime)}</td>
                <td>${_lsbEsc(s.processNo ?? '—')}</td>
                <td>${s.oiRate ?? '—'}</td>
                <td>${lsbFmtExchangeTime(s.exchangeTime)}</td>
            </tr>`
        }).join('')
    }
    // ดึงทุกหน้าของ /schedules?lineCode=... มาเก็บไว้ทั้งหมด (response ห่อ { data, pagination: { hasNextPage, totalPages }, sorting })
    // ไม่ได้เอาแค่หน้าแรก 20 แถวแบบเดิม — เอา pattern เดียวกับ lsbFetchAllLines()/lsbFetchAllSchedules() (มี MAX_PAGES กันวนไม่รู้จบ)
    async function lsbFetchLineScheduleAllPages(lineCode) {
        const MAX_PAGES = 20
        const pageSize  = 20
        let all = [], page = 1, hasNext = true
        while (hasNext && page <= MAX_PAGES) {
            const res = await api(`/schedules?${new URLSearchParams({ lineCode, page, pageSize })}`, 'GET')
            all = all.concat(res?.data ?? [])
            hasNext = !!res?.pagination?.hasNextPage
            page++
        }
        return all
    }
    async function lsbOpenLineSchedule(lineCode) {
        if (!lineCode) return
        document.getElementById('lsbLineScheduleTitle').textContent = lineCode
        document.getElementById('lsbLineScheduleBody').innerHTML = `<tr><td colspan="13" class="lsb-sched-empty">Loading…</td></tr>`
        // backdrop:false — Bootstrap ปกติ append .modal-backdrop เป็น sibling แยกไว้ที่ document.body ซึ่งจะอยู่นอก subtree ของ
        // #lsbWrap เหมือนปัญหา modal เดิมที่เพิ่งย้ายเข้ามา (มองไม่เห็นตอน fullscreen) — ใช้ background+blur ของตัว .modal เองแทน
        // (ดู #lsbLineScheduleModal.show ใน CSS) ซึ่งเป็น element เดียวกับที่ย้ายเข้ามาอยู่ใน #lsbWrap แล้ว รับประกันว่าโชว์แน่นอน
        new bootstrap.Modal(document.getElementById('lsbLineScheduleModal'), { backdrop: false }).show()
        try {
            const rows = await lsbFetchLineScheduleAllPages(lineCode)
            lsbRenderLineSchedule(rows)
        } catch (err) {
            console.warn('lsbOpenLineSchedule:', err)
            document.getElementById('lsbLineScheduleBody').innerHTML = `<tr><td colspan="13" class="lsb-sched-empty">Failed to load</td></tr>`
        }
    }

    // Priority ของ queue ฝั่งขวา = gap ระหว่าง %Production OH - %Input (ทั้งคู่เทียบ % กันแล้ว ไม่ผสมหน่วยดิบแบบเดิม)
    // ยิ่งน้อย/ใกล้ 0 ยิ่งเร่งด่วน (ใกล้จะหมด buffer ให้ไลน์ทำงานต่อ) — เรียง ascending ใน lsbRenderFromState()
    // Time_to_Stockout (ชม.) = (%Total OH − %Total Input) ÷ OI_Rate — ยิ่งน้อย/ติดลบ ยิ่งเร่งด่วน (ใกล้/เลยจุดที่วัตถุดิบจะหมด)
    // %Total OH = prodOH / plannedQty × 100 (จาก inventory-summary/batch), %Total Input = fgInputQty / fgTargetQty × 100 (จาก /lines)
    // ไม่รู้ oiRate (ไม่มีใน /schedules ให้) = คำนวณไม่ได้ ส่ง Infinity ไปท้ายสุด (แปลว่า "ไม่รู้" ไม่ใช่ "เร่งด่วน")
    function lsbTimeToStockout(wo) {
        if (!wo || !wo.oiRate) return Infinity
        const prodOhPct = wo.plannedQty  > 0 ? (wo.prodOH     ?? 0) / wo.plannedQty  * 100 : 0
        const inputPct  = wo.fgTargetQty > 0 ? (wo.fgInputQty ?? 0) / wo.fgTargetQty * 100 : 0
        const gap = prodOhPct - inputPct
        return gap / wo.oiRate
    }

    // แถวฝั่งขวา — 1 แถวต่อ 1 line (ld = {lineName, current, next} เหมือนการ์ดฝั่งซ้ายเป๊ะ) โชว์ Current + Next WO ในแถวเดียวกัน
    // CYCLE (min/pc) ยังไม่มี field ต้นทางในระบบ ใส่ "—" ไว้ก่อน รอข้อมูลจริง
    // Input/Output คำนวณเทียบกับ fgTargetQty เอง (ไม่ใช้ totalOnHandRate/achievementRate สำเร็จรูปแล้ว ตามที่ขอ) ของ WO current
    // Production OH = SUM(parts[].locations[Production].onHandQty) หารด้วย SUM(parts[].plannedQty) จาก POST /workorder/inventory-summary/batch
    // (ดู lsbFetchInventorySummary/_lsbInvSummary) — รวมทุก part ของ BOM ไม่ใช่แค่ FG part เดียว ตามสูตรที่ backend ให้มา
    // Total OnHand = สูตรเดียวกับ Production OH แต่ SUM(parts[].locations[*].onHandQty) ทุก location ไม่กรอง locationType — หารด้วย plannedQty ตัวเดียวกัน
    function lsbQueueRowHtml(ld, i) {
        const wo = ld.current
        const target      = wo.fgTargetQty ?? 0
        const inputPct    = target > 0 ? (wo.fgInputQty  ?? 0) / target * 100 : 0
        const outputPct   = target > 0 ? (wo.fgOutputQty ?? 0) / target * 100 : 0
        const prodOnHand  = wo.prodOH ?? 0
        const plannedQty  = wo.plannedQty ?? 0
        const oiRateHtml  = wo.oiRate != null ? wo.oiRate.toLocaleString(undefined, { maximumFractionDigits: 2 }) : '—'
        const prodOhPct   = plannedQty > 0 ? (prodOnHand / plannedQty) * 100 : 0
        const totalOnHand = wo.totalOH ?? 0
        const totalOhPct  = plannedQty > 0 ? (totalOnHand / plannedQty) * 100 : 0

        // TTS ของ current WO เท่านั้น (เดิมเอา next มาปนด้วยแบบ min(current, next) แต่ทำให้ current ที่จริงๆ ยัง OK ขึ้น STOCKOUT ผิดๆ ตาม next — ตัดออกตามที่ขอ)
        const tts = lsbTimeToStockout(wo)
        const ttsStockout = tts !== Infinity && tts <= 0
        const ttsLabel = tts === Infinity ? '—' : (ttsStockout ? 'STOCKOUT' : `${tts.toFixed(1)}h`)
        const ttsTitle = 'Time_to_Stockout = (%Production OH − %Input) ÷ OI_Rate ของ current WO เท่านั้น'

        // สี/priority แถวนี้ตาม order status (busrun) หรือ scrap threshold (fa) ของ line เดียวกับการ์ดฝั่งซ้าย (ดู lsbCardHtml)
        // แดง/ส้ม ใช้ class เดิม (.lsb-q-late/.lsb-q-called — มี blink animation อยู่แล้ว) reuse ข้ามโหมดได้เลย แค่เปลี่ยนเงื่อนไข+sub-label
        let rowCls = '', subLabelHtml = ''
        if (_lsbBoardMode === 'fa') {
            const scrap = wo.scrapQty ?? 0
            if (scrap > 10) {
                rowCls = 'lsb-q-late'
                subLabelHtml = `<div class="lsb-q-late-sub" style="color:var(--red)">Scrap ${scrap.toLocaleString()}</div>`
            } else if (scrap > 5) {
                rowCls = 'lsb-q-called'
                subLabelHtml = `<div class="lsb-q-late-sub" style="color:var(--amber)">Scrap ${scrap.toLocaleString()}</div>`
            }
        } else {
            const orderInfo = _lsbOrdersByLine.get(ld.lineName)
            rowCls = orderInfo?.isLate ? 'lsb-q-late' : (orderInfo ? 'lsb-q-called' : '')
            // late มากี่นาทีแล้ว — ใช้ตัวที่ late นานสุดของ line นี้ (lateMinutesLeft ติดลบ) ตัวเดียวกับที่ใช้จัด priority ใน lsbRenderFromState()
            // เกิน 60 นาที = โชว์เป็นชั่วโมงแทน อ่านง่ายกว่าตัวเลขหลักหมื่น
            const lateMinutesAbs = Math.abs(orderInfo?.lateMinutesLeft ?? 0)
            const lateDisplay = lateMinutesAbs > 60 ? `${(lateMinutesAbs / 60).toFixed(1)} Hrs.` : `${lateMinutesAbs.toLocaleString()} min`
            subLabelHtml = orderInfo?.isLate ? `<div class="lsb-q-late-sub">Late ${lateDisplay}</div>` : ''
        }

        const topHtml = `
            <div class="lsb-q-rank">${i + 1}</div>
            <div class="lsb-q-info" style="min-width:0">
                <div class="lsb-q-mo"><span class="lsb-q-line">${_lsbEsc(ld.lineName)}</span><span class="lsb-q-mo-big">${_lsbEsc(wo.moNumber ?? '—')}</span></div>
                ${subLabelHtml}
            </div>`

        // โหมด Stacked — เรียงแท่ง Input/Output/Production OH ต่อกันแนวตั้งเต็มความกว้าง เทียบด้วยตาง่ายกว่าตอนพื้นที่แคบ
        if (_lsbQueueStacked) {
            return `<div class="lsb-q-row lsb-q-row-stacked ${rowCls}">
                <div class="lsb-q-stacked-top">${topHtml}<div class="lsb-q-stacked-tts${ttsStockout ? ' lsb-q-tts-stockout' : ''}" title="${ttsTitle}">${ttsLabel}</div></div>
                <div class="lsb-q-stacked-metric">
                    <span class="lsb-q-stacked-label lsb-q-colhead-hint" title="(fgOutputQty / fgTargetQty) × 100">Output</span>
                    <div class="lsb-q-bar-bg lsb-q-bar-lg"><div class="lsb-q-bar-fill" style="width:${Math.min(100, Math.max(0, outputPct))}%;background:var(--green)"></div></div>
                    <span class="lsb-q-stacked-pct">${outputPct.toFixed(1)}%</span>
                </div>
                <div class="lsb-q-stacked-metric">
                    <span class="lsb-q-stacked-label lsb-q-colhead-hint" title="(fgInputQty / fgTargetQty) × 100">Input</span>
                    <div class="lsb-q-bar-bg lsb-q-bar-lg"><div class="lsb-q-bar-fill" style="width:${Math.min(100, Math.max(0, inputPct))}%;background:var(--blue)"></div></div>
                    <span class="lsb-q-stacked-pct">${inputPct.toFixed(1)}%</span>
                </div>
                <div class="lsb-q-stacked-metric">
                    <span class="lsb-q-stacked-label lsb-q-colhead-hint" title="SUM(parts[].locations[*].onHandQty) ทุก location / SUM(parts[].plannedQty) × 100 — จาก POST /workorder/inventory-summary/batch">Total OnHand</span>
                    <div class="lsb-q-bar-bg lsb-q-bar-lg"><div class="lsb-q-bar-fill" style="width:${Math.min(100, Math.max(0, totalOhPct))}%;background:var(--orange)"></div></div>
                    <span class="lsb-q-stacked-pct">${totalOhPct.toFixed(1)}%</span>
                </div>
                <div class="lsb-q-stacked-metric">
                    <span class="lsb-q-stacked-label lsb-q-colhead-hint" title="SUM(parts[].locations[Production].onHandQty) / SUM(parts[].plannedQty) × 100 — จาก POST /workorder/inventory-summary/batch">Production OH</span>
                    <div class="lsb-q-bar-bg lsb-q-bar-lg"><div class="lsb-q-bar-fill" style="width:${Math.min(100, Math.max(0, prodOhPct))}%;background:var(--purple)"></div></div>
                    <span class="lsb-q-stacked-pct">${prodOhPct.toFixed(1)}%</span>
                </div>
            </div>`
        }

        return `<div class="lsb-q-row ${rowCls}">
            ${topHtml}
            <div class="lsb-q-metric">
                <div class="lsb-q-bar-bg"><div class="lsb-q-bar-fill" style="width:${Math.min(100, Math.max(0, inputPct))}%;background:var(--blue)"></div></div>
                <span class="lsb-q-pct">${inputPct.toFixed(1)}%</span>
            </div>
            <div class="lsb-q-metric">
                <div class="lsb-q-bar-bg"><div class="lsb-q-bar-fill" style="width:${Math.min(100, Math.max(0, outputPct))}%;background:var(--green)"></div></div>
                <span class="lsb-q-pct">${outputPct.toFixed(1)}%</span>
            </div>
            <div class="lsb-q-metric">
                <div class="lsb-q-bar-bg"><div class="lsb-q-bar-fill" style="width:${Math.min(100, Math.max(0, totalOhPct))}%;background:var(--orange)"></div></div>
                <span class="lsb-q-pct">${totalOhPct.toFixed(1)}%</span>
            </div>
            <div class="lsb-q-metric">
                <div class="lsb-q-bar-bg"><div class="lsb-q-bar-fill" style="width:${Math.min(100, Math.max(0, prodOhPct))}%;background:var(--purple)"></div></div>
                <span class="lsb-q-pct">${prodOhPct.toFixed(1)}%</span>
            </div>
            <div class="lsb-q-cycle" title="OI Rate (จาก /schedules)">${oiRateHtml}</div>
            <div class="lsb-q-tts${ttsStockout ? ' lsb-q-tts-stockout' : ''}" title="${ttsTitle}">${ttsLabel}</div>
        </div>`
    }

    // ── Stacked layout toggle — จำ preference ไว้ต่อเบราว์เซอร์ (localStorage) — default เป็น Stacked ตอนยังไม่เคยตั้งค่าไว้เลย
    // (ถ้าเคยกดเลือก compact ไว้เอง ('0') ก็ยังเคารพ choice เดิม ไม่ทับ) ──
    const LSB_QUEUE_STACKED_KEY = 'sf_lsb_queue_stacked'
    let _lsbQueueStacked = (() => {
        try {
            const saved = localStorage.getItem(LSB_QUEUE_STACKED_KEY)
            return saved === null ? true : saved === '1'
        } catch (_) { return true }
    })()
    function lsbUpdateQueueLayoutBtn() {
        const icon = document.getElementById('lsbQueueLayoutIcon')
        const btn  = document.getElementById('lsbQueueLayoutBtn')
        const head = document.getElementById('lsbQColhead')
        if (icon) icon.className = _lsbQueueStacked ? 'bi bi-list-columns-reverse' : 'bi bi-bar-chart-line'
        if (btn)  btn.title = _lsbQueueStacked ? 'Switch to compact layout' : 'Stack bars for easier comparison'
        if (head) head.style.display = _lsbQueueStacked ? 'none' : ''
    }
    function lsbToggleQueueLayout() {
        _lsbQueueStacked = !_lsbQueueStacked
        try { localStorage.setItem(LSB_QUEUE_STACKED_KEY, _lsbQueueStacked ? '1' : '0') } catch (_) {}
        lsbUpdateQueueLayoutBtn()
        lsbRenderFromState()
    }

    // ── Board mode: "busrun" (เดิม — สี/priority ตาม pre-shipment order) หรือ "fa" (FA Tracking — สี/priority ตาม Scrap)
    // ทั้งการ์ดฝั่งซ้ายและ Priority Queue ฝั่งขวา — จำ preference ไว้ต่อเบราว์เซอร์เหมือน stacked-layout toggle ──
    const LSB_BOARD_MODE_KEY = 'sf_lsb_board_mode'
    let _lsbBoardMode = (() => {
        try { return localStorage.getItem(LSB_BOARD_MODE_KEY) === 'fa' ? 'fa' : 'busrun' } catch (_) { return 'busrun' }
    })()
    function lsbUpdateBoardModeUI() {
        const isFa = _lsbBoardMode === 'fa'
        const legendBusrun = document.getElementById('lsbLegendBusrun')
        const legendFa     = document.getElementById('lsbLegendFa')
        if (legendBusrun) legendBusrun.style.display = isFa ? 'none' : 'contents'
        if (legendFa)     legendFa.style.display     = isFa ? 'contents' : 'none'
        const sel = document.getElementById('lsbBoardModeSelect')
        if (sel) sel.value = _lsbBoardMode
    }
    function lsbSetBoardMode(mode) {
        _lsbBoardMode = mode === 'fa' ? 'fa' : 'busrun'
        try { localStorage.setItem(LSB_BOARD_MODE_KEY, _lsbBoardMode) } catch (_) {}
        lsbUpdateBoardModeUI()
        if (_lsbActive) lsbRenderFromState()
    }

    // ── Area multi-select (checkbox) dropdown ── ว่าง (Set ไม่มีสมาชิก) = ไม่ filter (All Areas) — ค่าคือ prodAreaCode ที่มากับ
    // /lines ตรงๆ (เช่น "WG1_FAN2_MAIN") เดิมกรองด้วย productionplant ของ /workorder แต่ /lines ไม่มี field นี้ให้ เลยเปลี่ยนไปกรองด้วย
    // prodAreaCode แทน (เป็น field ที่ /lines มีจริง) — เดิมเลือกได้ทีละอันเดียว เปลี่ยนเป็นเลือกได้หลายอันพร้อมกันตามที่ขอ (ติ๊ก checkbox
    // เหมือน Line filter ข้างๆ กันเลย)
    let _lsbSelectedPlants = new Set(['WG1_FAN1_MAIN'])   // default ตอนเปิดแท็บครั้งแรก — เคลียร์ทั้งหมดได้ = All Areas
    let _lsbAllPlantNames  = []

    function lsbPlantDdToggle() {
        const menu = document.getElementById('lsbPlantDdMenu')
        menu.style.display = menu.style.display === 'none' ? '' : 'none'
    }
    function lsbPlantDdUpdateLabel() {
        const label = document.getElementById('lsbPlantDdLabel')
        if (!label) return
        label.textContent = _lsbSelectedPlants.size === 0
            ? 'All Areas'
            : (_lsbSelectedPlants.size === 1 ? [..._lsbSelectedPlants][0] : `${_lsbSelectedPlants.size} Areas`)
    }
    // reset scroll เฉพาะตอน "รายชื่อ" area เปลี่ยนจริงๆ ไม่ใช่ทุกครั้งที่แค่ติ๊ก/เลิกติ๊ก (ปัญหา+เหตุผลเดียวกับ lsbLineDdRender ด้านล่าง)
    let _lsbPlantDdLastScopeKey = null
    // เรียกใหม่ทุกครั้งที่ loadLineStatusBoard() ได้ list plant มาสด — ไม่ reset checkbox ที่ user ติ๊กไว้แล้ว (เทียบกับ Set เดิม)
    function lsbPlantDdRender() {
        const menu = document.getElementById('lsbPlantDdMenu')
        const scopeKey = _lsbAllPlantNames.join('|')
        const scopeChanged = scopeKey !== _lsbPlantDdLastScopeKey
        _lsbPlantDdLastScopeKey = scopeKey
        if (!_lsbAllPlantNames.length) {
            menu.innerHTML = `<div class="lsb-line-dd-empty">No areas</div>`
            lsbPlantDdUpdateLabel()
            return
        }
        menu.innerHTML = _lsbAllPlantNames.map(p => `
            <label class="lsb-line-dd-item">
                <input type="checkbox" value="${_lsbEsc(p)}" ${_lsbSelectedPlants.has(p) ? 'checked' : ''} onchange="lsbPlantDdChange(this)">
                ${_lsbEsc(p)}
            </label>
        `).join('') + `
            <div class="lsb-line-dd-actions">
                <button type="button" class="lsb-line-dd-action-btn" onclick="lsbPlantDdSelectAll()">Select All</button>
                <button type="button" class="lsb-line-dd-action-btn" onclick="lsbPlantDdClear()">Clear</button>
            </div>`
        if (scopeChanged) menu.scrollTop = 0
        lsbPlantDdUpdateLabel()
    }
    // ต้อง refetch ใหม่ (ไม่ใช่ re-render เฉยๆ) ทุกครั้งที่เปลี่ยน เพราะ /schedules ส่ง prodAreaCode ไปกรองที่ backend ด้วย
    // (ส่วน /lines เอง filter ฝั่ง client เหมือนเดิม เพราะ endpoint นี้ไม่มี query param นี้ให้)
    function lsbPlantDdChange(cb) {
        if (cb.checked) _lsbSelectedPlants.add(cb.value)
        else _lsbSelectedPlants.delete(cb.value)
        lsbPlantDdUpdateLabel()
        loadLineStatusBoard()
    }
    function lsbPlantDdSelectAll() {
        _lsbSelectedPlants = new Set(_lsbAllPlantNames)
        lsbPlantDdRender()
        loadLineStatusBoard()
    }
    function lsbPlantDdClear() {
        _lsbSelectedPlants.clear()
        lsbPlantDdRender()
        loadLineStatusBoard()
    }

    // ── Line multi-select (checkbox) ── ว่าง (Set ไม่มีสมาชิก) = ไม่ filter, โชว์ทุก line
    let _lsbSelectedLines = new Set()
    let _lsbAllLineNames  = []

    function lsbLineDdToggle() {
        const menu = document.getElementById('lsbLineDdMenu')
        menu.style.display = menu.style.display === 'none' ? '' : 'none'
    }
    document.addEventListener('click', e => {
        const lineWrap  = document.getElementById('lsbLineDdWrap')
        const lineMenu  = document.getElementById('lsbLineDdMenu')
        if (lineWrap && lineMenu && !lineWrap.contains(e.target)) lineMenu.style.display = 'none'

        const plantWrap = document.getElementById('lsbPlantDdWrap')
        const plantMenu = document.getElementById('lsbPlantDdMenu')
        if (plantWrap && plantMenu && !plantWrap.contains(e.target)) plantMenu.style.display = 'none'
    })
    function lsbLineDdUpdateLabel() {
        const label = document.getElementById('lsbLineDdLabel')
        if (!label) return
        // ค่า default = ติ๊กครบทุก line ในขอบเขตปัจจุบัน (เท่ากับ "All Lines") ตามที่ขอ ไม่ใช่ "ว่าง = All" แบบเดิมอีกต่อไป —
        // ไม่ติ๊กเลย (กด Clear) ถือว่า "ไม่เลือกอะไรเลย" ไม่ใช่ All
        const total = _lsbAllLineNames.length
        label.textContent = total > 0 && _lsbSelectedLines.size === total
            ? 'All Lines'
            : (_lsbSelectedLines.size === 0 ? 'No Lines' : `${_lsbSelectedLines.size} Line${_lsbSelectedLines.size > 1 ? 's' : ''}`)
    }
    // scrollTop ของ menu ค้างที่ค่าเดิม (browser ไม่ reset ให้เองตอนแค่เปลี่ยน innerHTML) — พอ "รายชื่อ" line เปลี่ยน (จากการเปลี่ยน
    // Area filter ทำให้ list สั้น/ยาวลง) เนื้อหาที่โผล่ตรง scroll offset เดิมเลยเป็นคนละรายการกับก่อนหน้า ดูเหมือน line ที่ควรมีอยู่
    // "หายไป" ทั้งที่จริงๆ derived ถูกแล้ว แค่เลื่อนไม่เจอ — reset กลับบนสุดเฉพาะตอนรายชื่อเปลี่ยนจริงๆ เท่านั้น (เทียบ key เดิม) ไม่ใช่
    // ทุกครั้งที่ re-render เฉยๆ (เช่น แค่ติ๊ก/เลิกติ๊ก checkbox เดิม) ไม่งั้น user กำลังไล่ติ๊กทีละอันในลิสต์ยาวจะโดนเด้งกลับบนสุดทุกครั้งที่ติ๊ก
    let _lsbLineDdLastScopeKey = null
    // เรียกใหม่ทุกครั้งที่ loadLineStatusBoard() ได้ list ของ line มาสด — ไม่ reset checkbox ที่ user ติ๊กไว้แล้ว (เทียบกับ Set เดิม)
    function lsbLineDdRender() {
        const menu = document.getElementById('lsbLineDdMenu')
        const scopeKey = _lsbAllLineNames.join('|')
        const scopeChanged = scopeKey !== _lsbLineDdLastScopeKey
        _lsbLineDdLastScopeKey = scopeKey
        if (!_lsbAllLineNames.length) {
            menu.innerHTML = `<div class="lsb-line-dd-empty">No lines</div>`
            lsbLineDdUpdateLabel()
            return
        }
        menu.innerHTML = _lsbAllLineNames.map(ln => `
            <label class="lsb-line-dd-item">
                <input type="checkbox" value="${_lsbEsc(ln)}" ${_lsbSelectedLines.has(ln) ? 'checked' : ''} onchange="lsbLineDdChange(this)">
                ${_lsbEsc(ln)}
            </label>
        `).join('') + `
            <div class="lsb-line-dd-actions">
                <button type="button" class="lsb-line-dd-action-btn" onclick="lsbLineDdSelectAll()">Select All</button>
                <button type="button" class="lsb-line-dd-action-btn" onclick="lsbLineDdClear()">Clear</button>
            </div>`
        if (scopeChanged) menu.scrollTop = 0
        lsbLineDdUpdateLabel()
    }
    // เลือก/เลิกเลือก line เป็นแค่ filter แสดงผลฝั่ง client ล้วนๆ (ข้อมูลทุก line มีอยู่ใน _lsbWoState อยู่แล้วจาก bootstrap/push)
    // ไม่ต้องยิง REST ใหม่เลย แค่ re-render จาก state เดิม
    function lsbLineDdChange(cb) {
        if (cb.checked) _lsbSelectedLines.add(cb.value)
        else _lsbSelectedLines.delete(cb.value)
        lsbLineDdUpdateLabel()
        lsbRenderFromState()
    }
    function lsbLineDdSelectAll() {
        _lsbSelectedLines = new Set(_lsbAllLineNames)
        lsbLineDdRender()
        lsbRenderFromState()
    }
    function lsbLineDdClear() {
        _lsbSelectedLines.clear()
        lsbLineDdRender()
        lsbRenderFromState()
    }

    // ══ State-driven board ══
    // _lsbLines: master source ของฝั่งซ้าย/ขวาทั้งหมด — มาจาก GET /lines ตรงๆ (1 record ต่อ 1 line พร้อม currentWorkOrder/nextWorkOrder
    // ในตัวเลยไม่ต้อง group/เดาเองอีกต่อไปเหมือนของเก่าที่เอา achievementRate สูงสุดมาเดาว่าอันไหนคือ "current")
    // _lsbWoState: แค่ cache เสริม (moNumber -> WO record เต็มจาก /workorder) เติมแบบ opportunistic ผ่าน SignalR "WorkOrdersChanged"
    // เท่านั้น ใช้เสริม field ที่ /lines ไม่มีให้ (achievementRate) — prodOH/plannedQty แยกไปอยู่ _lsbInvSummary แล้ว (จาก inventory-summary/batch)
    // ถ้ายังไม่เคย push MO นั้นมาเลยก็จะไม่มีข้อมูลส่วนนี้ (โชว์ "—" ไปก่อนจนกว่าจะมี event เข้ามา)
    let _lsbLines   = []
    let _lsbWoState = new Map()
    let _lsbScheduleOiRate  = new Map()   // moNumber -> oiRate จาก /schedules — เอาไปแทนคอลัมน์ Cycle เดิม (ดู _lsbNormalizeWo)
    let _lsbOrdersByLine    = new Map()   // line -> { isLate, orders: [...] } จาก ORDERS_API /orders/pre-shipment — ใช้ตัดสินสี ORDER CALLED/ORDER LATE (ดู lsbFetchPreShipmentOrders)
    let _lsbInvSummary      = new Map()   // moNumber -> { prodOH, plannedQty } จาก POST /workorder/inventory-summary/batch — ใช้คำนวณ % Production OH/Time_to_Stockout (ดู lsbFetchInventorySummary)

    async function lsbApplyLiveUpdate(wo) {
        if (!wo?.moNumber) return
        _lsbWoState.set(wo.moNumber, wo)   // cache เสริม (achievementRate) เผื่อ enrich การ์ด/queue
        await lsbFetchInventorySummary([wo.moNumber])   // refresh prodOH/plannedQty ของ MO นี้ให้สดตาม (batch เดียว แค่ 1 ตัว)

        // ใช้ lineName จาก push ไปถาม GET /lines?Line=... ตรงๆ ว่าตอนนี้ current/next ของ line นั้นคือ WO ไหนกันแน่ (ดู lsbRefreshLine)
        // (สดกว่าการรอ reconciliation ทุก 60 วิ — ยิงแค่ line เดียวที่เปลี่ยนจริง ไม่ใช่ bootstrap ทั้งชุดใหม่)
        if (wo.lineName) await lsbRefreshLine(wo.lineName)
        else if (_lsbActive) lsbRenderFromState()
    }

    // POST /workorder/inventory-summary/batch — ยิง batch เดียวเอาหลาย moNumber ได้ในทีเดียว (ต่างจาก /workorder/{mo}/detail แบบเก่าที่ต้องยิงทีละ MO)
    // Production OH = SUM(parts[].locations[locationType===Production].onHandQty) ของทุก part ใน WO นั้น (ไม่ใช่แค่ FG part เดียว)
    // Total OnHand = SUM(parts[].locations[*].onHandQty) ทุก location (ไม่กรอง locationType) ของทุก part — หารด้วย plannedQty ตัวเดียวกับ Production OH
    // Total Current Part PlannedQty = SUM(parts[].plannedQty) ของทุก part ใน WO นั้น — สูตรตามที่ backend ให้มา
    async function lsbFetchInventorySummary(moNumbers) {
        if (!moNumbers.length) return
        try {
            const res = await api('/workorder/inventory-summary/batch', 'POST', moNumbers)
            ;(res?.data || []).forEach(entry => {
                const prodOH = (entry.parts || []).reduce((s, p) => {
                    const loc = (p.locations || []).find(l => l.locationType === 'Production')
                    return s + Number(loc?.onHandQty || 0)
                }, 0)
                const totalOH = (entry.parts || []).reduce((s, p) => {
                    return s + (p.locations || []).reduce((s2, l) => s2 + Number(l.onHandQty || 0), 0)
                }, 0)
                const plannedQty = (entry.parts || []).reduce((s, p) => s + Number(p.plannedQty || 0), 0)
                _lsbInvSummary.set(entry.workOrderNo, { prodOH, totalOH, plannedQty })
            })
        } catch (err) {
            console.warn('lsbFetchInventorySummary:', err)
        }
    }

    async function lsbRefreshLine(lineName) {
        try {
            // /lines/{lineName} ไม่มีแล้ว — เปลี่ยนมาใช้ GET /lines?Line=... (filter ตรงๆ ที่ /lines รองรับแล้วตอนนี้) แทน
            // ไม่ fallback ไปใช้ arr[0] ถ้าหา exact match ไม่เจอ (เผื่อ Line filter เป็นแบบ partial match ไม่ใช่ exact)
            // กันเหมือนกับ fetchWorkOrderDetail() ที่ตัด list[0] fallback ออกไปก่อนหน้านี้ — ผิด line ไปเงียบๆ อันตรายกว่าไม่ update
            const res  = await api(`/lines?Line=${encodeURIComponent(lineName)}&pageSize=1`, 'GET')
            // /lines คืน array ตรงๆ ไม่มี envelope ห่อ (ดู lsbFetchAllLines ด้านล่าง) — เช็ค Array.isArray ก่อนเหมือนกัน
            const arr  = Array.isArray(res) ? res : (res?.data?.data ?? res?.data ?? [])
            const line = arr.find(l => l.name === lineName) || null
            // woConnection รับ push จากทั้งระบบ ไม่ได้ scope ตาม Area ให้เราเอง — ถ้ามี Area filter อยู่ ต้องเช็ค prodAreaCode
            // ของ line ที่เพิ่งได้มาก่อนว่าตรงกับ Area ปัจจุบันไหม ไม่งั้น line จาก area อื่นจะรั่วเข้า _lsbLines แล้วไปโผล่
            // เป็นตัวเลือกแปลกปลอมใน dropdown Area/Line (การ์ด/queue เองกรองถูกอยู่แล้ว แต่ dropdown build จาก _lsbLines ดิบ)
            if (line && (!_lsbSelectedPlants.size || _lsbSelectedPlants.has(line.prodAreaCode))) {
                const idx = _lsbLines.findIndex(l => l.name === lineName)
                if (idx >= 0) _lsbLines[idx] = line
                else _lsbLines.push(line)
            }
        } catch (err) {
            console.warn('lsbRefreshLine:', lineName, err)
        } finally {
            if (_lsbActive) lsbRenderFromState()
        }
    }

    // เติม field ที่ /lines ไม่มีให้ (achievementRate) จาก _lsbWoState ถ้าเคยมี — และ alias
    // inputQty/outputQty/targetQty ของ /lines ให้เป็นชื่อ fgInputQty/fgOutputQty/fgTargetQty ที่ lsbCardHtml()/lsbQueueRowHtml() ใช้อยู่แล้ว
    function _lsbNormalizeWo(wo) {
        if (!wo) return null
        const full      = _lsbWoState.get(wo.moNumber) || {}
        const inv       = _lsbInvSummary.get(wo.moNumber)
        const targetQty = wo.targetQty ?? 0
        const outputQty = wo.outputQty ?? 0
        return {
            ...full, ...wo,
            fgInputQty:  wo.inputQty  ?? 0,
            fgOutputQty: outputQty,
            fgTargetQty: targetQty,
            achievementRate: full.achievementRate ?? (targetQty > 0 ? outputQty / targetQty * 100 : 0),
            prodOH:     inv?.prodOH ?? null,       // null = ยังไม่เคย fetch inventory-summary มา (ดู lsbFetchInventorySummary) — ต่างจาก 0 ที่แปลว่า fetch แล้วแต่ไม่มีของจริงๆ
            totalOH:    inv?.totalOH ?? null,
            plannedQty: inv?.plannedQty ?? null,
            oiRate: _lsbScheduleOiRate.get(wo.moNumber) ?? null,
        }
    }

    // filter เดียวกันนี้ใช้ทั้งตอน render จริง (lsbRenderFromState) และตอนหา scope ของ enrichment fetch (lsbEnrichWoState)
    // แยกออกมาเป็นฟังก์ชันเดียวกันกันสองที่ไม่ตรงกัน (เช่น enrich เกินหรือขาดจากที่โชว์จริง)
    function lsbFilteredLines() {
        let lines = _lsbLines.filter(l => l.isActive !== false)
        if (_lsbSelectedPlants.size) lines = lines.filter(l => _lsbSelectedPlants.has(l.prodAreaCode))
        // เทียบ unconditional (ไม่มี "ว่าง = All" แบบ Area filter ด้านบน) เพราะ _lsbSelectedLines ถูก sync ให้ default ติ๊กครบทุก
        // line ในขอบเขตอยู่แล้วเสมอ (ดู lsbRenderFromState) — ว่างจริงๆ แปลว่า user กด Clear เอง ตั้งใจไม่เอา line ไหนเลย
        lines = lines.filter(l => _lsbSelectedLines.has(l.name))
        return lines
    }

    // natural sort ชื่อ line แบบ ATH_01, ATH_02, ..., STF_01, STF_02, ... (เทียบทีละ chunk ตัวอักษร/ตัวเลข แยกกัน เลข
    // เทียบเป็นค่าตัวเลขจริง ไม่ใช่ string — กัน STF_10 โผล่มาก่อน STF_2 แบบที่ lexicographic sort ธรรมดาจะทำ)
    function lsbNaturalCompare(a, b) {
        const ax = String(a || '').match(/\d+|\D+/g) || []
        const bx = String(b || '').match(/\d+|\D+/g) || []
        const len = Math.max(ax.length, bx.length)
        for (let i = 0; i < len; i++) {
            const pa = ax[i] ?? '', pb = bx[i] ?? ''
            const na = /^\d+$/.test(pa), nb = /^\d+$/.test(pb)
            if (na && nb) {
                const diff = parseInt(pa, 10) - parseInt(pb, 10)
                if (diff) return diff
            } else if (pa !== pb) {
                return pa < pb ? -1 : 1
            }
        }
        return 0
    }

    // Re-render ฝั่งซ้าย/ขวาจาก _lsbLines ปัจจุบัน (ไม่ต้อง group หา current/next เอง — /lines บอกมาให้ตรงๆ แล้ว)
    function lsbRenderFromState() {
        _lsbAllPlantNames = [...new Set(_lsbLines.map(l => l.prodAreaCode).filter(Boolean))].sort()
        lsbPlantDdRender()
        // จำกัด choice ของ Line dropdown ให้เหลือแค่ line ที่อยู่ใน Area ที่ติ๊กเลือกไว้เท่านั้น (ไม่งั้นเลือก Area เดียวแต่ Line
        // dropdown ยังโชว์ทุก line ทั้งระบบ ~100+ ตัว ตามที่ขอ) — ไม่ติ๊ก Area ไหนเลย (All Areas) ก็โชว์ทุก line เหมือนเดิม
        const _lsbOldLineScope = new Set(_lsbAllLineNames)   // scope ก่อนหน้ารอบนี้ ใช้เทียบหา line ที่เพิ่งโผล่เข้ามาใหม่
        _lsbAllLineNames = [...new Set(
            _lsbLines
                .filter(l => !_lsbSelectedPlants.size || _lsbSelectedPlants.has(l.prodAreaCode))
                .map(l => l.name)
                .filter(Boolean)
        )].sort()
        // line ที่เพิ่งเข้ามาอยู่ใน scope ใหม่ (เช่น เพิ่ง add Area เข้าไปอีกอัน) ให้ default เป็น "ติ๊กไว้" เลยตามที่ขอ (ทุกอันต้อง
        // select หมดโดย default แล้วค่อยไป de-select เอาเอง) — ตอน bootstrap ครั้งแรก _lsbOldLineScope ว่างเปล่า เลยทุก line ที่มี
        // ถือเป็น "ใหม่" หมด ติ๊กครบทุกอันไปเลยเป็นค่าเริ่มต้น
        _lsbAllLineNames.forEach(ln => { if (!_lsbOldLineScope.has(ln)) _lsbSelectedLines.add(ln) })
        // เอา line ที่ติ๊กค้างไว้แต่หลุด scope ของ Area ปัจจุบันออกจาก selection ด้วย กัน label "N Lines" ค้างนับ line ที่มองไม่เห็นแล้ว
        const _lsbNewLineScope = new Set(_lsbAllLineNames)
        ;[..._lsbSelectedLines].forEach(ln => { if (!_lsbNewLineScope.has(ln)) _lsbSelectedLines.delete(ln) })
        lsbLineDdRender()

        const lines = lsbFilteredLines()

        const lineDetails = lines.map(l => ({
            lineName: l.name,
            current:  _lsbNormalizeWo(l.currentWorkOrder),
            next:     _lsbNormalizeWo(l.nextWorkOrder),
        }))
        // โหมด "fa": เรียงการ์ดฝั่งซ้ายตาม scrapQty มาก -> น้อย (แดง > ส้ม > เขียว/เทา) ให้ตรงกับสีการ์ดใน lsbCardHtml —
        // ส่วน "busrun" เรียงตามชื่อ line แบบ natural sort (ATH_01, ATH_02, ..., STF_01, STF_02, ...) ตามที่ขอ แทนลำดับเดิมตามที่ API ส่งมา
        const cardList = _lsbBoardMode === 'fa'
            ? [...lineDetails].sort((a, b) => (b.current?.scrapQty ?? 0) - (a.current?.scrapQty ?? 0))
            : [...lineDetails].sort((a, b) => lsbNaturalCompare(a.lineName, b.lineName))
        document.getElementById('lsbCardGrid').innerHTML = cardList.length
            ? cardList.map(lsbCardHtml).join('')
            : `<div class="lsb-empty">No active lines</div>`
        // นับไลน์ red+amber ด้วยเกณฑ์เดียวกับสีการ์ด (lsbCardSeverity) — busrun = กำลัง Calling (late+called), fa = กำลัง Scrap (>5)
        const alertCount = lineDetails.reduce((n, ld) => n + (['red', 'amber'].includes(lsbCardSeverity(ld)) ? 1 : 0), 0)
        const alertLabel = _lsbBoardMode === 'fa' ? 'Scrap' : 'Calling'
        document.getElementById('lsbLinesStat').textContent = `Lines ${lineDetails.length} · ${alertLabel} ${alertCount}`

        // ฝั่งขวา: 1 แถวต่อ 1 line เหมือนการ์ดฝั่งซ้ายเป๊ะ (โชว์ทั้ง Current + Next WO ในแถวเดียวกัน) — priority แยกตาม _lsbBoardMode:
        // "busrun" (เดิม): ชั้นแรก = สถานะ order ของ line นั้น (แดง Late ขึ้นก่อนสุด รองลงมาคือส้ม Called ตามที่ขอ) เหมือนสีการ์ดฝั่งซ้าย
        //   ภายในกลุ่ม Late ด้วยกัน เรียงต่อด้วย timeToUseMinutesLeft (ติดลบมากสุด = late มานานสุด = เร่งด่วนสุด ขึ้นก่อน)
        //   ส่วนกลุ่ม Called/ไม่มี order เรียงด้วย Time_to_Stockout ของ current WO เท่านั้น (ตัดที่เคยเอา next มาปนแบบ min(current,next) ออก
        //   ตามที่ขอ — current ที่จริงๆ ยัง OK ไม่ควรโดนลาก priority ขึ้นเพราะ next ยังไม่พร้อม)
        // "fa" (FA Tracking): เรียงตาม scrapQty ของ current WO มาก -> น้อยตรงๆ เลย (scrap เยอะสุดขึ้นก่อนสุด)
        const lsbOrderPriority = ld => {
            const info = _lsbOrdersByLine.get(ld.lineName)
            if (info?.isLate) return 0
            if (info) return 1
            return 2
        }
        const queue = lineDetails
            .filter(ld => ld.current)
            .sort((a, b) => {
                if (_lsbBoardMode === 'fa') {
                    return (b.current?.scrapQty ?? 0) - (a.current?.scrapQty ?? 0)
                }
                const prioA = lsbOrderPriority(a), prioB = lsbOrderPriority(b)
                if (prioA !== prioB) return prioA - prioB
                if (prioA === 0) {
                    const minsA = _lsbOrdersByLine.get(a.lineName)?.lateMinutesLeft ?? 0
                    const minsB = _lsbOrdersByLine.get(b.lineName)?.lateMinutesLeft ?? 0
                    return minsA - minsB
                }
                return lsbTimeToStockout(a.current) - lsbTimeToStockout(b.current)
            })
            .slice(0, 15)
        document.getElementById('lsbQueueWrap').innerHTML = queue.length
            ? queue.map(lsbQueueRowHtml).join('')
            : `<div class="lsb-empty">No open work orders</div>`
        document.getElementById('lsbQueueUpdated').textContent = new Date().toLocaleTimeString('en-GB')
    }

    // ดึงทุกหน้าของ /lines มาเก็บไว้ — เรียกตอน bootstrap (เปิดแท็บ) และ reconciliation เป็นระยะ
    // response จริงตอนนี้เป็น array ตรงๆ ไม่มี envelope ห่อเลย (ดู Res.body ที่ user ให้มา) — ไม่ใช่ {data:{data:[...]}} แบบที่เดาไว้แต่แรก
    // ทำให้ res?.data?.data / res?.data เป็น undefined เสมอ (array ไม่มี .data property) แล้ว fallback ไป [] จนการ์ด/queue ว่างเปล่าไปหมด
    // เช็ค Array.isArray(res) ก่อนเป็นอันดับแรก ยัง fallback ไป envelope shape เดิมไว้เผื่อ backend เปลี่ยนกลับมาห่ออีกทีในอนาคต
    // บั๊กที่เจอเพิ่ม: page=1&pageSize=100 กลับมาได้ record เกิน 100 ตัวเลย (ดู Res.body) แปลว่า backend ไม่สนใจ page/pageSize
    // ของ endpoint นี้จริงๆ คืนทั้งชุดทุกครั้ง — เดิม arr.length ไม่มีวัน < pageSize เลยเข้าใจผิดว่ายังมีหน้าถัดไป วนดึงชุดเดิมซ้ำ
    // แล้ว concat ต่อกันจนได้ line ซ้ำกันหลายสิบตัว (นี่คือที่มาของ "filter prodAreaCode แล้วไม่ตรง" — จริงๆ ตรงแต่มันซ้ำกันเยอะ)
    // แก้ด้วย Map keyed ด้วย id: ถ้า fetch มาแล้วไม่ได้ id ใหม่เพิ่มเลยสักตัว แปลว่าวนซ้ำข้อมูลเดิม หยุดทันที ไม่ต้องรอ MAX_PAGES
    async function lsbFetchAllLines() {
        const MAX_PAGES = 20
        const pageSize  = 100
        const byId = new Map()
        let page = 1, totalPages = 1
        do {
            const res = await api(`/lines?page=${page}&pageSize=${pageSize}`, 'GET')
            const arr = Array.isArray(res) ? res : (res?.data?.data ?? res?.data ?? [])
            const sizeBefore = byId.size
            arr.forEach(l => byId.set(l.id, l))
            if (byId.size === sizeBefore) break   // ไม่มี id ใหม่เพิ่มเลย = backend คืนชุดเดิมซ้ำ ไม่ใช่หน้าถัดไปจริง
            totalPages = res?.data?.totalPages ?? res?.totalPages ?? (arr.length < pageSize ? page : page + 1)
            page++
        } while (page <= totalPages && page <= MAX_PAGES)
        const all = Array.from(byId.values())
        return all
    }

    // ดึงทุกหน้าของ /schedules มาเก็บเป็น map moNumber -> oiRate (record แรกที่เจอของแต่ละ moNumber ชนะ — MO นึงอาจมีหลาย schedule/process step
    // แต่เอาไปโชว์แทนคอลัมน์ Cycle แค่ค่าเดียวพอ) เอา pattern การแบ่งหน้าเดียวกับ lsbFetchAllLines()
    // ถ้ามี Area filter อยู่ (prodAreaCode) ส่งไปกรองที่ backend เลย ลดจำนวน record ที่ต้องดึง — /schedules รองรับ query param นี้ตรงๆ
    // (ต่างจาก /lines ที่ไม่มี filter นี้ให้ เลยยังต้องดึงทุก line มาแล้วกรองฝั่ง client เหมือนเดิม)
    async function lsbFetchAllSchedules(prodAreaCode) {
        const MAX_PAGES = 30
        const pageSize  = 100
        let all = [], page = 1, totalPages = 1
        do {
            let url = `/schedules?page=${page}&pageSize=${pageSize}`
            if (prodAreaCode) url += `&prodAreaCode=${encodeURIComponent(prodAreaCode)}`
            const res = await api(url, 'GET')
            const arr = res?.data?.data ?? res?.data ?? []
            all = all.concat(arr)
            totalPages = res?.data?.totalPages ?? res?.totalPages ?? (arr.length < pageSize ? page : page + 1)
            page++
        } while (page <= totalPages && page <= MAX_PAGES)
        return all
    }


    // ORDERS_API เป็นคนละ host/service กับ INVENTORY_API (ดู js/config.js) ไม่มี SignalR hub ให้ — วนโพลตามความถี่ที่ตั้งไว้แทน
    // (ใช้ตัวเดียวกับ full refresh, คุมจุดเดียวจาก dropdown #lsbRefreshIntervalSelect — ดู lsbStartOrdersPolling)
    // ยิงรวมทั้งระบบครั้งเดียว (ไม่ filter ทีละ line) แล้ว group ฝั่ง client ด้วย field "line" — /orders/pre-shipment คืน { orders, subOrders }
    // ใช้แค่ orders.data (ระดับ order ไม่ใช่ subOrder) พอ เพราะมี line/isLateNow/currentStatus/cancelAt ให้ครบตามที่การ์ดต้องใช้แล้ว
    // "Order Called" (ส้ม) = มี order ของ line นี้ที่ยังไม่ถูกยกเลิก (cancelAt == null) และยังไม่ late
    // "Order Late" (แดง) = มี order ของ line นี้ที่ isLateNow = true (ยกเว้นที่ถูกยกเลิกไปแล้ว) — ดู lsbCardHtml() สำหรับ priority สี
    async function lsbFetchPreShipmentOrders() {
        try {
            const MAX_PAGES = 10
            const pageSize  = 100
            let all = [], page = 1, totalPages = 1
            do {
                const res = await api(`${CONFIG.ORDERS_API}/orders/pre-shipment?page=${page}&pageSize=${pageSize}`, 'GET')
                console.log('Orders/pre-shipment :', res)
                const arr = res?.orders?.data ?? []
                all = all.concat(arr)
                totalPages = res?.orders?.totalPages ?? 1
                page++
            } while (page <= totalPages && page <= MAX_PAGES)

            const byLine = new Map()
            all.forEach(o => {
                if (!o.line || o.cancelAt) return   // ยกเลิกไปแล้ว = ไม่เกี่ยวกับสีการ์ดอีกต่อไป
                const entry = byLine.get(o.line) || { isLate: false, orders: [], lateMinutesLeft: null }
                entry.orders.push(o)
                if (o.isLateNow) {
                    entry.isLate = true
                    // ติดลบมาก = late มานานกว่า — เก็บค่าที่ "แย่สุด" (ติดลบมากสุด) ของ line นี้ไว้ใช้จัด priority/โชว์
                    const mins = o.timeToUseMinutesLeft ?? 0
                    if (entry.lateMinutesLeft === null || mins < entry.lateMinutesLeft) entry.lateMinutesLeft = mins
                }
                byLine.set(o.line, entry)
            })
            _lsbOrdersByLine = byLine
            if (_lsbActive) lsbRenderFromState()
        } catch (err) {
            console.warn('lsbFetchPreShipmentOrders:', err)
        }
    }

    // เริ่ม/หยุดโพล /orders/pre-shipment ตอนเข้า-ออกแท็บ Line Status Board เท่านั้น (ไม่ให้วนโพลทิ้งไว้เฉยๆ ตอนไม่มีใครดูอยู่)
    // ความถี่ใช้ตัวเดียวกับ dropdown #lsbRefreshIntervalSelect (_lsbFullRefreshMinutes ประกาศไว้ด้านล่าง แต่เรียกใช้ตอนฟังก์ชันนี้
    // รันจริงๆ ตอน switchDashView ซึ่งช้ากว่าตอน script โหลดเสร็จทั้งไฟล์แล้วเสมอ เลยมีค่าพร้อมใช้แน่นอน) แทนที่จะ hardcode 60000 แยกต่างหาก
    // จะได้ปรับ control จุดเดียวคุมทั้งคู่
    let _lsbOrdersPollTimer = null
    function lsbStartOrdersPolling() {
        lsbFetchPreShipmentOrders()
        if (_lsbOrdersPollTimer) return
        _lsbOrdersPollTimer = setInterval(lsbFetchPreShipmentOrders, _lsbFullRefreshMinutes * 60 * 1000)
    }
    function lsbStopOrdersPolling() {
        if (_lsbOrdersPollTimer) { clearInterval(_lsbOrdersPollTimer); _lsbOrdersPollTimer = null }
    }

    // ยิง batch เดียวเอา prodOH/plannedQty ของทุก MO ที่โผล่เป็น current/next ในบอร์ดจริงๆ (~2 ต่อ line) ทีเดียวผ่าน
    // POST /workorder/inventory-summary/batch — ไม่ต้องยิงทีละ MO แบบ /workorder/{mo}/detail เก่าอีกต่อไป (achievementRate มี fallback
    // คำนวณเองจาก targetQty/outputQty ของ /lines อยู่แล้วใน _lsbNormalizeWo ไม่ต้องพึ่ง list endpoint เลยสำหรับบอร์ดนี้)
    // ยิงครั้งเดียวตอน bootstrap/reconnect resync ไม่ใช่ N+1 ถี่ๆ แบบที่เคยมีปัญหา
    async function lsbEnrichWoState(lines) {
        const moNumbers = new Set()
        lines.forEach(l => {
            if (l.currentWorkOrder?.moNumber) moNumbers.add(l.currentWorkOrder.moNumber)
            if (l.nextWorkOrder?.moNumber)    moNumbers.add(l.nextWorkOrder.moNumber)
        })
        await lsbFetchInventorySummary([...moNumbers])
    }

    async function loadLineStatusBoard() {
        try {
            // /schedules?prodAreaCode=... รับได้แค่ค่าเดียว (ไม่รองรับ multi-value) — เลือกพอดี 1 area ค่อยส่งไปกรองที่ backend ได้
            // เลือก 0 หรือ 2+ area ต้องดึงมาทั้งหมดแล้วปล่อยให้ lsbFilteredLines()/lsbEnrichWoState() กรองฝั่ง client แทน
            const scheduleAreaParam = _lsbSelectedPlants.size === 1 ? [..._lsbSelectedPlants][0] : null
            const [lines, schedules] = await Promise.all([
                lsbFetchAllLines(),
                lsbFetchAllSchedules(scheduleAreaParam),
            ])
            _lsbLines = lines
            _lsbScheduleOiRate = new Map()
            schedules.forEach(s => {
                if (s.moNumber && !_lsbScheduleOiRate.has(s.moNumber)) _lsbScheduleOiRate.set(s.moNumber, s.oiRate)
            })
            await lsbEnrichWoState(lsbFilteredLines())   // เฉพาะ line ที่ผ่าน filter ปัจจุบันจริงๆ (ไม่ใช่ทั้งระบบ ~119 line)
            lsbRenderFromState()
        } catch (err) {
            console.warn('loadLineStatusBoard:', err)
        }
    }

    // ปกติ resync เต็มชุดเกิดตอน woConnection.onreconnected() (ดูจุดประกาศ woConnection ด้านบน) หรือตอนเปิดแท็บนี้ใหม่
    // (switchDashView('board') เรียก loadLineStatusBoard() อยู่แล้วทุกครั้ง) ระหว่าง connect อยู่ปกติ push ทีละตัวพอ — แต่เผื่อกรณี
    // push บาง event หลุดหายไปเงียบๆ (connection ยังไม่ตัดจนเข้า onreconnected แต่ message บาง event ไม่ถึง) ทำให้ W/O เก่าค้างอยู่
    // บนจอทั้งที่ควรมี W/O ใหม่ขึ้นมาแล้ว เลย poll เต็มชุดซ้ำเป็น safety net ด้วย (เฉพาะตอนเปิดแท็บนี้ดูอยู่เท่านั้น) — ความถี่ปรับได้จาก
    // dropdown #lsbRefreshIntervalSelect (default 5 นาที) จำค่าไว้ใน localStorage ต่อเบราว์เซอร์ (เหมือน LSB_PRIORITY_HIDDEN_KEY)
    const LSB_REFRESH_INTERVAL_KEY = 'sf_lsb_refresh_interval_min'
    const LSB_REFRESH_OPTIONS      = [1, 5, 10, 15, 30, 60]
    const LSB_REFRESH_DEFAULT_MIN  = 5
    let _lsbFullRefreshMinutes = LSB_REFRESH_DEFAULT_MIN
    try {
        const saved = parseInt(localStorage.getItem(LSB_REFRESH_INTERVAL_KEY))
        if (LSB_REFRESH_OPTIONS.includes(saved)) _lsbFullRefreshMinutes = saved
    } catch (_) {}
    // sync dropdown ให้ตรงกับค่าที่จำไว้ (HTML hardcode "5 min" ไว้เป็น selected เฉยๆ เผื่อไม่เคยเปลี่ยนมาก่อน)
    ;(() => {
        const sel = document.getElementById('lsbRefreshIntervalSelect')
        if (sel) sel.value = String(_lsbFullRefreshMinutes)
    })()
    let _lsbFullRefreshTimer  = null
    let _lsbNextFullRefreshAt = null   // epoch ms ของรอบ refresh ถัดไป — null = ไม่ได้เปิดแท็บ board อยู่ ใช้วาด countdown (#lsbRefreshCountdown)
    function lsbStartFullRefreshPolling() {
        if (_lsbFullRefreshTimer) return
        const ms = _lsbFullRefreshMinutes * 60 * 1000
        _lsbNextFullRefreshAt = Date.now() + ms
        _lsbFullRefreshTimer = setInterval(() => {
            _lsbNextFullRefreshAt = Date.now() + _lsbFullRefreshMinutes * 60 * 1000
            loadLineStatusBoard()
        }, ms)
    }
    function lsbStopFullRefreshPolling() {
        if (_lsbFullRefreshTimer) { clearInterval(_lsbFullRefreshTimer); _lsbFullRefreshTimer = null }
        _lsbNextFullRefreshAt = null
    }
    // เปลี่ยนความถี่จาก dropdown — ต้อง stop/start ใหม่เสมอ (ไม่ใช่แค่เปลี่ยนตัวแปรเฉยๆ) เพราะ setInterval เดิมที่รันค้างอยู่ยัง
    // ใช้ ms เดิมที่ตั้งไว้ตอนเรียก ไม่ได้อ่านค่าตัวแปรสดทุกครั้งที่ tick ต้องสร้าง interval ใหม่ถึงจะมีผลทันที — คุมทั้ง full refresh
    // (lsbStartFullRefreshPolling) และ /orders/pre-shipment poll (lsbStartOrdersPolling) พร้อมกันด้วย interval เดียวกัน
    function lsbSetRefreshInterval(minutes) {
        if (!LSB_REFRESH_OPTIONS.includes(minutes)) return
        _lsbFullRefreshMinutes = minutes
        try { localStorage.setItem(LSB_REFRESH_INTERVAL_KEY, String(minutes)) } catch (_) {}
        if (_lsbFullRefreshTimer) { lsbStopFullRefreshPolling(); lsbStartFullRefreshPolling() }
        if (_lsbOrdersPollTimer)  { lsbStopOrdersPolling();      lsbStartOrdersPolling() }
    }

    // ── ภาษา (i18n) ── เรียกตอน init ครั้งแรก + ทุกครั้งที่กดปุ่มเปลี่ยนภาษาใน header (_Layout.cshtml เรียก window.onLangChange ให้เอง)
    // data-i18n ทั่วไปให้ applyDataI18n() (js/i18n.js) จัดการ — ส่วนที่เหลือคือข้อความที่ผสมเลข/ตัวแปรเข้าไปในสตริงเดียวกัน (เช่น "10 rows", "5 lots")
    // ซึ่ง data-i18n เฉยๆ ทำไม่ได้ ต้อง re-render ของส่วนนั้นใหม่เอง
    function applyDashboardLang() {
        const dict = dashDict()
        applyDataI18n(dict)
        window.Layout3D?.applyLang()

        document.querySelectorAll('#pageSize option').forEach(opt => { opt.textContent = opt.value + ' ' + dict.rows })

        // trigger label ของ Location filter — แปลเฉพาะตอนยังไม่ได้เลือก filter ไหน (เลือกอยู่แล้วให้คงชื่อ location เดิมไว้ ไม่ไปทับ)
        if (!document.getElementById('locationFilter').value) {
            document.getElementById('dashLocTypeDdLabel').textContent = dict.allLocations
        }

        updateStockHeader()
        renderTypeCards()
        renderRows(lastRows)
    }
    window.onLangChange = applyDashboardLang

    // ── Init ──
    window.addEventListener("load", async function () {
        applyDashboardLang();
        initStockSearchAutocomplete();
        loadLocationTypes();
        renderTypeCards();
        loadStock();
        loadTodayStats();
        loadItemTypes();
        await loadDashLocations()   // ต้องรอให้ _dashLocations โหลดเสร็จก่อน ไม่งั้น sessLocTypeBadge() ใน loadLastSessions() จะ map ไม่เจอ ขึ้น badge เปล่ารอบแรก
        loadLastSessions();
        loadLastWorkorders();
        lsbUpdateQueueLayoutBtn()   // sync ปุ่ม/colhead ให้ตรงกับค่า _lsbQueueStacked ที่ restore มาจาก localStorage ตั้งแต่โหลดหน้า
        lsbUpdateBoardModeUI()      // sync legend/dropdown ให้ตรงกับค่า _lsbBoardMode ที่ restore มาจาก localStorage เหมือนกัน
    });

    function openLightbox(src, caption) {
        document.getElementById('lightboxImg').src = src
        document.getElementById('lightbox').classList.add('show')
    }
    function closeLightbox() {
        document.getElementById('lightbox').classList.remove('show')
        document.getElementById('lightboxImg').src = ''
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox() })
</script>
}
