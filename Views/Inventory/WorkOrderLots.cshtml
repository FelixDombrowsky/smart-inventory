@{
    ViewData["Title"] = "WorkOrder Lots";
}

<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --card:#fff;
    --green:#059669; --green-lt:#ecfdf5;
    --amber:#d97706; --amber-lt:#fffbeb;
    --red:#dc2626; --red-lt:#fef2f2;
    --purple:#7c3aed; --purple-lt:#f5f3ff;
    --cyan:#0891b2; --cyan-lt:#ecfeff;
    --indigo:#6366f1; --indigo-lt:#eef0ff;
}

/* ── PAGE HEADER ── */
.wo-header {
    background: linear-gradient(135deg, var(--navy) 0%, #1e3a6e 60%, #1a6fff 100%);
    border-radius: 16px; padding: 22px 28px; margin-bottom: 22px;
    display: flex; align-items: center; justify-content: space-between;
    position: relative; overflow: hidden;
}
.wo-header::before {
    content:''; position:absolute; right:-40px; top:-40px;
    width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04);
}
.wo-header-left      { position:relative; z-index:1; display:flex; flex-direction:column; gap:10px; }

/* MO Number — ตอนนี้คือหัวเรื่องหลักของหน้า (แทนที่ label "WorkOrder Lots" เดิม) */
.wo-mo-line { display:flex; align-items:baseline; gap:10px; }
.wo-mo-lbl  { font-size:11px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:rgba(255,255,255,.5); }
.wo-mo-num  { font-size:26px; font-weight:700; color:#fff; font-family:ui-monospace,'SFMono-Regular',Consolas,monospace; letter-spacing:.01em; }

/* Model / Line / Status — เดิมยัดรวมกับ MO คั่นด้วย "·" บรรทัดเดียว แยกเป็น chip ของตัวเอง ให้รู้ว่าแต่ละค่าคือ field อะไร */
.wo-meta-row {
    display:flex; align-items:center; gap:8px; flex-wrap:wrap;
}
.wo-meta-chip {
    display:inline-flex; align-items:center; gap:6px; padding:5px 12px;
    background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.18);
    border-radius:8px; font-size:12.5px; font-weight:600; color:#fff; white-space:nowrap;
}
.wo-meta-chip .wo-meta-lbl {
    font-size:9.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase;
    color:rgba(255,255,255,.5);
}
.wo-status-chip {
    display:inline-flex; align-items:center; gap:7px; padding:5px 14px 5px 11px;
    background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.18);
    border-radius:20px; font-size:12.5px; font-weight:700; color:#fff; white-space:nowrap;
}
.wo-status-chip .dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; box-shadow:0 0 0 3px rgba(255,255,255,.14); }
.wo-warn-chip {
    display:inline-flex; align-items:center; gap:6px; padding:5px 14px 5px 11px;
    background:rgba(217,119,6,.22); border:1px solid rgba(217,119,6,.4);
    border-radius:20px; font-size:12.5px; font-weight:700; color:#fde68a; white-space:nowrap;
}
.wo-back-btn {
    padding:8px 18px; border-radius:10px; border:1.5px solid rgba(255,255,255,.3);
    background:rgba(255,255,255,.08); color:#fff; font-size:13px; font-weight:600;
    cursor:pointer; transition:.15s; position:relative; z-index:1;
    text-decoration:none; display:flex; align-items:center; gap:6px;
}
.wo-back-btn:hover { background:rgba(255,255,255,.18); color:#fff; }

/* ── STAT GRID ── */
.stat-grid-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:14px; }
.stat-grid-5 { display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin-bottom:22px; }
/* จอแคบ: เลิก wrap เป็นหลายแถว (2x2, 3+2 ฯลฯ) — คงไว้แถวเดียวต่อกลุ่มเสมอ แล้ว scroll แนวนอนแทน
   ให้เห็น "กลุ่ม" ของการ์ดชัดเจนต่อเนื่องกันแม้จอเล็ก ไม่ใช่ตัดสลับแถวจนดูแยกกลุ่มไม่ออก */
@@media (max-width:1100px) {
    .stat-grid-4, .stat-grid-5 {
        display:flex; grid-template-columns:none; overflow-x:auto; -webkit-overflow-scrolling:touch;
        scroll-snap-type:x proximity; padding-bottom:4px;
    }
    .stat-grid-4 > .stat-card, .stat-grid-5 > .stat-card { flex:0 0 220px; scroll-snap-align:start; }
}
.stat-card {
    background:var(--card); border:1px solid var(--border); border-top:3px solid transparent; border-radius:14px; padding:20px;
    display:flex; align-items:center; gap:14px;
    box-shadow:0 1px 4px rgba(0,0,0,.04); transition:transform .2s, box-shadow .2s;
}
.stat-card:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,.08); }
.stat-icon {
    width:46px; height:46px; border-radius:12px;
    display:flex; align-items:center; justify-content:center;
    font-size:13px; font-weight:800; flex-shrink:0;
}
.stat-num { font-size:22px; font-weight:700; color:var(--navy); line-height:1; }
.stat-lbl { font-size:11px; color:var(--t2); margin-top:3px; }
.stat-bar-row   { display:flex; align-items:center; gap:6px; margin:6px 0 2px; }
.stat-bar-track { flex:1; height:6px; background:var(--border); border-radius:20px; overflow:hidden; min-width:0; }
.stat-bar-fill  { height:100%; border-radius:20px; transition:width .5s; }
.stat-bar-pct   { font-size:10.5px; font-weight:700; color:var(--t2); white-space:nowrap; flex-shrink:0; }

/* ── Group band (eyebrow label above each stat row — Finished Good / Raw Material) ──
   Cards keep their own metric colours (blue=in, green=out/available, amber=reserved, red=scrap/consumed);
   only a thin top accent bar ties each row's cards to its group. ── */
.group-band  { display:flex; align-items:center; gap:9px; margin:0 0 10px; }
.group-band:not(:first-child) { margin-top:22px; }
.group-dot   { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
.group-title { font-size:12px; font-weight:700; letter-spacing:.03em; text-transform:uppercase; }
.group-sub   { font-size:12px; color:var(--t3); }
.g-fg .stat-card { border-top-color:var(--indigo); }
.g-rm .stat-card { border-top-color:var(--cyan); }
.group-title.fg  { color:var(--indigo); }
.group-title.rm  { color:var(--cyan); }
.group-dot.fg    { background:var(--indigo); }
.group-dot.rm    { background:var(--cyan); }

/* ── SECTION CARD ── */
.section-card {
    background:var(--card); border:1px solid var(--border);
    border-radius:14px; overflow:hidden;
    box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:20px;
}
.sc-head {
    padding:14px 18px; border-bottom:1px solid var(--border);
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;
}
.sc-title {
    font-size:13px; font-weight:700; color:var(--navy);
    display:flex; align-items:center; gap:8px;
}

/* ── TABLE ── */
.inv-table { width:100%; border-collapse:collapse; }
.inv-table thead { background:#f8f9fc; }
.inv-table th {
    padding:9px 14px; text-align:left; font-size:12px; font-weight:700;
    color:var(--t2); letter-spacing:.04em; text-transform:uppercase;
    border-bottom:1px solid var(--border); white-space:nowrap; user-select:none;
}
.inv-table td {
    padding:11px 14px; border-bottom:1px solid #f4f4f7;
    vertical-align:middle; font-size:14px;
}
.inv-table tbody tr.sum-row { cursor:pointer; transition:background .1s; }
.inv-table tbody tr.sum-row:hover td { background:#fafbff; }
.mono { font-family:ui-monospace,monospace; font-size:14px; color:var(--navy); font-weight:600; }
.part-nm { font-weight:600; font-size:14px; color:var(--navy); }
.num-ok  { font-weight:700; color:var(--green); }
.num-bad { font-weight:700; color:var(--red); }

/* ── EXPAND BUTTON ── */
.expand-btn {
    width:26px; height:26px; border-radius:7px;
    border:1.5px solid var(--border); background:#fff;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition:.15s; font-size:11px; color:var(--t2);
    flex-shrink:0;
}
.expand-btn:hover { border-color:var(--blue); color:var(--blue); background:var(--blue-lt); }
.expand-btn.open  { background:var(--blue); border-color:var(--blue); color:#fff; transform:rotate(90deg); }

/* ── STOCK BAR (On Hand / Reserved / Available ภาพรวมเดียว) ── */
.stock-bar {
    display:flex; height:6px; border-radius:3px; background:#eef0f5;
    overflow:hidden; margin-bottom:5px; min-width:140px;
}
.stock-bar-seg { height:100%; transition:width .25s ease; }
.stock-bar-seg.avail    { background:var(--green); }
.stock-bar-seg.reserved { background:var(--amber); }
.stock-bar-nums { font-size:11.5px; color:var(--t2); white-space:nowrap; }
.stock-bar-nums .num-ok  { font-weight:700; color:var(--green); }
.stock-bar-nums .num-bad { font-weight:700; color:var(--red); }
.stock-sep { color:var(--t3); margin:0 3px; }

.lots-count-badge {
    background:#f0f2f5; color:#475569; padding:2px 8px;
    border-radius:5px; font-size:11px; font-weight:600; white-space:nowrap;
}

/* ── SUB ROW ── */
.sub-row td { padding:0 !important; border-bottom:none !important; }
.sub-content {
    overflow:hidden; max-height:0;
    transition:max-height .3s ease;
    background:#f8faff;
}
.sub-content.expanded { max-height:2000px; }
.sub-inner { padding:14px 20px 14px 48px; border-top:1px solid var(--border); display:flex; flex-direction:column; gap:14px; }

/* ── LOCATION GROUP (จัดกลุ่ม lot ตาม location เดียวกันในแต่ละ part) ── */
.loc-group { background:#fff; border:1px solid var(--border); border-radius:10px; overflow:hidden; }
.loc-group-head {
    display:flex; align-items:center; gap:10px; padding:8px 14px;
    background:#f0f4ff; border-bottom:1px solid var(--border);
}
.loc-group-qty { font-size:11.5px; color:var(--t2); font-weight:600; margin-left:auto; }

.loc-group-scroll { max-height:340px; overflow-y:auto; }
.sub-table { width:100%; border-collapse:collapse; font-size:13px; }
.sub-table thead th { position:sticky; top:0; z-index:1; }
.sub-table th {
    padding:7px 12px; font-size:11px; font-weight:700; color:var(--t2);
    text-transform:uppercase; letter-spacing:.04em;
    border-bottom:1px solid var(--border); background:#fafbfe;
}
.sub-table td { padding:8px 12px; border-bottom:1px solid #eef0f5; color:var(--text); }
.sub-table tbody tr:last-child td { border-bottom:none; }
.sub-table tbody tr:hover td { background:#f5f8ff; }
.lot-badge {
    font-family:ui-monospace,monospace; font-size:12px;
    background:var(--blue-lt); color:var(--blue);
    padding:2px 8px; border-radius:5px; font-weight:600;
}
.btn-reprint {
    padding:3px 10px; border:1.5px solid var(--border); border-radius:7px;
    font-size:11px; font-weight:700; color:var(--t2); background:#fff;
    cursor:pointer; font-family:inherit; transition:.15s; margin-left:8px;
}
.btn-reprint:hover { border-color:var(--blue); color:var(--blue); background:var(--blue-lt); }

/* ── CONFIRM IMAGE (เหมือนหน้า Transactions.cshtml) ── */
.proof-thumb {
    width:40px; height:40px; object-fit:cover; border-radius:6px;
    border:1.5px solid var(--border); cursor:zoom-in;
    transition:transform .15s, box-shadow .15s;
}
.proof-thumb:hover { transform:scale(1.1); box-shadow:0 4px 12px rgba(0,0,0,.15); }
.no-photo { color:var(--t3); font-size:18px; }
.thumb-wrap { position:relative; display:inline-block; line-height:0; }
.thumb-badge {
    position:absolute; top:-6px; right:-6px;
    background:var(--blue); color:#fff; font-size:10px; font-weight:800; line-height:1.4;
    border-radius:9px; padding:1px 5px; min-width:16px; text-align:center;
    box-shadow:0 1px 4px rgba(0,0,0,.3); border:1.5px solid #fff; pointer-events:none;
}

/* ── LIGHTBOX ── */
.lightbox {
    position:fixed; inset:0; background:rgba(10,10,20,.85); backdrop-filter:blur(6px);
    z-index:3000; display:flex; align-items:center; justify-content:center;
    opacity:0; pointer-events:none; transition:opacity .2s;
}
.lightbox.show { opacity:1; pointer-events:all; }
.lightbox-inner {
    position:relative; max-width:90vw; max-height:90vh;
    transform:scale(.92); transition:transform .2s;
}
.lightbox.show .lightbox-inner { transform:scale(1); }
.lightbox-img {
    max-width:90vw; max-height:85vh; border-radius:12px;
    box-shadow:0 24px 60px rgba(0,0,0,.5); display:block;
}
.lightbox-close {
    position:absolute; top:-14px; right:-14px;
    width:32px; height:32px; border-radius:50%; border:none;
    background:#fff; color:var(--navy); font-size:16px; font-weight:700;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    box-shadow:0 2px 8px rgba(0,0,0,.2); line-height:1;
}
.lightbox-caption { text-align:center; color:rgba(255,255,255,.7); font-size:12px; margin-top:10px; }
.lightbox-nav {
    position:fixed; top:50%; transform:translateY(-50%);
    width:44px; height:44px; border:none; border-radius:50%;
    background:rgba(255,255,255,.12); color:#fff; font-size:22px;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    padding:0; z-index:3001; transition:.15s;
}
.lightbox-nav:hover { background:rgba(255,255,255,.25); }
.lightbox-prev { left:24px; }
.lightbox-next { right:24px; }

/* ── PARTS COUNT BADGE ── */
.count-badge {
    font-size:11px; background:var(--blue-lt); color:var(--blue);
    padding:2px 8px; border-radius:20px; font-weight:700;
}
/* ── Location filter (Total Summary): custom dropdown, icon+color จาก locationTypeMeta.js ── */
.loc-filter-dd-wrap { position:relative; }
.loc-filter-dd-trigger {
    display:flex; align-items:center; gap:8px; min-width:160px;
    padding:7px 12px; border:1px solid var(--border); border-radius:8px;
    font-size:13px; font-family:inherit; background:#fff; color:var(--text);
    cursor:pointer; user-select:none; outline:none; transition:border-color .15s;
}
.loc-filter-dd-trigger:hover, .loc-filter-dd-trigger.open { border-color:var(--blue); }
.loc-filter-dd-menu {
    position:fixed; min-width:190px; z-index:9999;
    background:#fff; border:1.5px solid var(--border); border-radius:9px;
    box-shadow:0 4px 16px rgba(0,0,0,.12); max-height:280px; overflow-y:auto;
}
.loc-filter-dd-item {
    display:flex; align-items:center; gap:8px; padding:8px 12px;
    font-size:13px; cursor:pointer; transition:background .1s;
}
.loc-filter-dd-item:hover  { background:#f1f5ff; }
.loc-filter-dd-item.active { background:#eff6ff; }
[data-theme="dark"] .loc-filter-dd-trigger { background:#0f172a; border-color:var(--border); }
[data-theme="dark"] .loc-filter-dd-menu    { background:#1e293b; border-color:var(--border); }
[data-theme="dark"] .loc-filter-dd-item:hover  { background:#253347; }
[data-theme="dark"] .loc-filter-dd-item.active { background:#162032; }

/* ── PAGINATION ── */
.pag-bar {
    display:flex; align-items:center; justify-content:space-between;
    padding:12px 18px; border-top:1px solid var(--border); flex-wrap:wrap; gap:10px;
}
.pag-info { font-size:12px; color:var(--t2); }
.pag-btns { display:flex; align-items:center; gap:8px; }
.pag-btn {
    padding:6px 13px; border:1px solid var(--border); border-radius:8px;
    font-size:12px; font-weight:600; background:#fff; color:var(--text);
    cursor:pointer; font-family:inherit; transition:.15s;
}
.pag-btn:hover:not(:disabled) { background:var(--blue); color:#fff; border-color:var(--blue); }
.pag-btn:disabled { opacity:.4; cursor:not-allowed; }
.pag-page { font-size:13px; font-weight:700; color:var(--navy); padding:0 6px; }
.pag-size {
    padding:7px 10px; border:1px solid var(--border); border-radius:8px;
    font-size:12px; background:#fff; outline:none; cursor:pointer; font-family:inherit;
}

/* ── W/O DETAIL TAB ── */
.status-badge { padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700; white-space:nowrap; }
.status-active { background:var(--green-lt); color:var(--green); }
.status-closed { background:#f0f2f5; color:#6b7280; }
.status-other  { background:var(--blue-lt); color:var(--blue); }
.pct-bar-wrap  { display:flex; align-items:center; gap:8px; }
.pct-bar-track { width:70px; height:7px; background:var(--border); border-radius:20px; overflow:hidden; flex-shrink:0; }
.pct-bar-fill  { height:100%; border-radius:20px; }
.pct-bar-label { font-size:11px; font-weight:700; white-space:nowrap; min-width:38px; }
.wod-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; padding:22px 24px; }
@@media (max-width:900px) { .wod-grid { grid-template-columns:repeat(2,1fr); } }
@@media (max-width:520px) { .wod-grid { grid-template-columns:1fr; } }
.wod-item { display:flex; flex-direction:column; gap:6px; }
.wod-lbl  { font-size:11px; font-weight:700; color:var(--t2); text-transform:uppercase; letter-spacing:.04em; }
.wod-val  { font-size:14px; font-weight:600; color:var(--navy); }

/* ── W/O Detail: section divider (Timeline / Sync Status) ── */
.wod-section       { border-top:1px solid var(--border); padding:20px 24px; }
.wod-section-title { font-size:12px; font-weight:700; color:var(--navy); display:flex; align-items:center; gap:7px; margin-bottom:16px; }

/* ── Timeline stepper (Schedule → Create → Start → Close → Target) ── */
.tl-wrap  { display:flex; align-items:flex-start; overflow-x:auto; padding:4px 2px 8px; }
.tl-step  { display:flex; flex-direction:column; align-items:center; width:118px; flex-shrink:0; position:relative; }
.tl-line  { position:absolute; top:7px; left:50%; width:100%; height:2px; background:var(--border); z-index:0; }
.tl-step:last-child .tl-line { display:none; }
.tl-step.done .tl-line { background:var(--blue); }
.tl-dot   { width:16px; height:16px; border-radius:50%; background:var(--card); border:2.5px solid var(--border); z-index:1; flex-shrink:0; }
.tl-step.done   .tl-dot { border-color:var(--blue); background:var(--blue); }
.tl-step.pending .tl-dot { border-color:var(--border); background:var(--card); }
.tl-lbl   { font-size:11px; font-weight:700; color:var(--t2); text-transform:uppercase; letter-spacing:.03em; margin-top:9px; }
.tl-date  { font-size:12.5px; font-weight:600; color:var(--navy); margin-top:3px; }
.tl-step.pending .tl-date { color:var(--t3); }

/* ── Sync Status ── */
.sync-grid  { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
@@media (max-width:900px) { .sync-grid { grid-template-columns:repeat(2,1fr); } }
@@media (max-width:520px) { .sync-grid { grid-template-columns:1fr; } }
.sync-err-banner {
    display:flex; align-items:flex-start; gap:10px; background:var(--red-lt); border:1px solid #fecaca;
    border-radius:10px; padding:12px 14px; margin-top:16px; font-size:12.5px; color:var(--red); line-height:1.5;
}

[data-theme="dark"] .sync-err-banner { border-color:#5c1e1e; }

/* ── TABS ── */
.wo-tabs { display:flex; gap:4px; margin-bottom:20px; background:#f0f2f5; border-radius:12px; padding:5px; width:fit-content; flex-wrap:wrap; }
.wo-tab  { padding:8px 20px; border-radius:9px; font-size:13px; font-weight:600; border:none; cursor:pointer; background:transparent; color:var(--t2); transition:.15s; font-family:inherit; white-space:nowrap; }
.wo-tab.active { background:#fff; color:var(--blue); box-shadow:0 1px 4px rgba(0,0,0,.08); }
.wo-tab-pane { display:none; }
.wo-tab-pane.active { display:block; }

/* ── DARK MODE ── */
[data-theme="dark"] {
    --navy:     #f1f5f9;
    --text:     #cbd5e1;
    --t2:       #94a3b8;
    --t3:       #64748b;
    --border:   #334155;
    --card:     #1e293b;
    --blue-lt:  #1e3553;
    --green-lt: #052e1c;
    --amber-lt: #2d1a00;
    --red-lt:   #2d0a0a;
    --purple-lt:#2a1e4e;
    --cyan-lt:  #0e3040;
    --indigo-lt:#23225c;
}
[data-theme="dark"] body                            { background: #0f172a !important; }
/* --navy กลายเป็นสีอ่อนในโหมดมืด (ดู :root[data-theme=dark] ด้านบน) ทำให้ปลายซ้ายของ gradient นี้ (135deg เริ่มที่ var(--navy))
   เปลี่ยนจากกรมท่าเป็นเกือบขาว — text/chip ฝั่งซ้ายของ header เลยต้องสลับเป็นสีเข้มตาม ไม่งั้นจะจางจนอ่านไม่ออก */
[data-theme="dark"] .wo-mo-lbl                      { color: #334155; }
[data-theme="dark"] .wo-mo-num                      { color: #0f172a; }
[data-theme="dark"] .wo-meta-chip                   { background: rgba(15,23,42,.07); border-color: rgba(15,23,42,.14); color: #0f172a; }
[data-theme="dark"] .wo-meta-chip .wo-meta-lbl      { color: #334155; }
[data-theme="dark"] .wo-status-chip                 { background: rgba(15,23,42,.07); border-color: rgba(15,23,42,.14); color: #0f172a; }
[data-theme="dark"] .wo-status-chip .dot            { box-shadow: 0 0 0 3px rgba(15,23,42,.1); }
[data-theme="dark"] .inv-table thead                { background: #162032; }
[data-theme="dark"] .inv-table td                   { border-bottom-color: #253347; }
[data-theme="dark"] .inv-table tbody tr.sum-row:hover td { background: #1a2a3e; }
[data-theme="dark"] .expand-btn                     { background: #1e293b; border-color: var(--border); color: var(--t2); }
[data-theme="dark"] .sub-content                    { background: #162032; }
[data-theme="dark"] .sub-inner                      { border-top-color: var(--border); }
[data-theme="dark"] .sub-table th                   { background: #1a2a3e; border-bottom-color: var(--border); }
[data-theme="dark"] .sub-table td                   { border-bottom-color: #253347; }
[data-theme="dark"] .sub-table tbody tr:hover td    { background: #1e3553; }
[data-theme="dark"] .loc-group                      { background: #1e293b; border-color: var(--border); }
[data-theme="dark"] .loc-group-head                 { background: #162032; border-bottom-color: var(--border); }
[data-theme="dark"] .stock-bar                      { background: #253347; }
[data-theme="dark"] .lots-count-badge               { background: #253347; color: #94a3b8; }
[data-theme="dark"] .pag-btn                        { background: #1e293b; color: var(--text); border-color: var(--border); }
[data-theme="dark"] .pag-size                       { background: #1e293b; color: var(--text); border-color: var(--border); }
[data-theme="dark"] select option                   { background: #1e293b; color: var(--text); }
[data-theme="dark"] .status-closed                  { background: #253347; color: #94a3b8; }
</style>

<!-- LIGHTBOX (Confirm Image) -->
<div class="lightbox" id="lightbox">
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" onclick="lightboxStep(-1)"><i class="bi bi-chevron-left"></i></button>
    <div class="lightbox-inner">
        <button class="lightbox-close" onclick="closeLightbox()">✕</button>
        <img class="lightbox-img" id="lightboxImg" src="">
        <div class="lightbox-caption" id="lightboxCaption"></div>
    </div>
    <button class="lightbox-nav lightbox-next" id="lightboxNext" onclick="lightboxStep(1)"><i class="bi bi-chevron-right"></i></button>
</div>

<!-- PAGE HEADER -->
<div class="wo-header">
    <div class="wo-header-left">
        <div class="wo-mo-line">
            <span class="wo-mo-lbl">MO</span>
            <span class="wo-mo-num" id="moTitle">Loading…</span>
        </div>
        <div class="wo-meta-row" id="woMetaRow" style="display:none">
            <span class="wo-meta-chip"><span class="wo-meta-lbl">Model</span>&nbsp;<span id="metaModel">—</span></span>
            <span class="wo-meta-chip"><span class="wo-meta-lbl">Line</span>&nbsp;<span id="metaLine">—</span></span>
            <span class="wo-status-chip" id="woStatusChip"><span class="dot"></span><span id="metaStatus">—</span></span>
            <span class="wo-warn-chip" id="woNotPrintedChip" style="display:none">
                <i class="bi bi-exclamation-triangle-fill"></i><span id="metaNotPrinted">Not Printed 0 Lot</span>
            </span>
        </div>
    </div>
    <a href="Inventory/WorkOrders" class="wo-back-btn">← Back to WorkOrders</a>
</div>

<!-- STAT CARDS — Row 1: Production Flow (Target/Input/Output/Scrap, % ของแต่ละตัวหารด้วย Target Qty) -->
<div class="group-band">
    <span class="group-dot fg"></span>
    <span class="group-title fg">Finished Good</span>
</div>
<div class="stat-grid-4 g-fg">
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--indigo-lt);color:var(--indigo)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </div>
        <div style="flex:1;min-width:0">
            <div class="stat-num" id="dashTargetQty">—</div>
            <div class="stat-lbl">Target QTY</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--blue-lt);color:var(--blue)"><i class="bi bi-box-arrow-in-down" style="font-size:20px"></i></div>
        <div style="flex:1;min-width:0">
            <div class="stat-num" id="dashInputQty">—</div>
            <div class="stat-bar-row"><div class="stat-bar-track"><div class="stat-bar-fill" id="dashInputBar" style="width:0%;background:var(--blue)"></div></div><span class="stat-bar-pct" id="dashInputPct">0%</span></div>
            <div class="stat-lbl">Input QTY</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--blue-lt);color:var(--blue)"><i class="bi bi-box-arrow-up" style="font-size:20px"></i></div>
        <div style="flex:1;min-width:0">
            <div class="stat-num" id="dashOutputQty">—</div>
            <div class="stat-bar-row"><div class="stat-bar-track"><div class="stat-bar-fill" id="dashOutputBar" style="width:0%;background:var(--blue)"></div></div><span class="stat-bar-pct" id="dashOutputPct">0%</span></div>
            <div class="stat-lbl">Output QTY</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--red-lt);color:var(--red)"><i class="bi bi-recycle" style="font-size:20px"></i></div>
        <div style="flex:1;min-width:0">
            <div class="stat-num" id="dashScrapQty" style="color:var(--red)">—</div>
            <div class="stat-bar-row"><div class="stat-bar-track"><div class="stat-bar-fill" id="dashScrapBar" style="width:0%;background:var(--red)"></div></div><span class="stat-bar-pct" id="dashScrapPct">0%</span></div>
            <div class="stat-lbl">Scrap QTY</div>
        </div>
    </div>
</div>

<!-- STAT CARDS — Row 2: Inventory Summary (Total Plan Qty ไม่มี bar, ที่เหลือหารด้วย Total Plan Qty ทั้งหมด) -->
<div class="group-band">
    <span class="group-dot rm"></span>
    <span class="group-title rm">Material In</span>
</div>
<div class="stat-grid-5 g-rm">
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--cyan-lt);color:var(--cyan)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.89 1.45l8 4A2 2 0 0 1 22 7.24v9.53a2 2 0 0 1-1.11 1.79l-8 4a2 2 0 0 1-1.79 0l-8-4a2 2 0 0 1-1.1-1.8V7.24a2 2 0 0 1 1.11-1.79l8-4a2 2 0 0 1 1.78 0z"/><polyline points="2.32 6.16 12 11 21.68 6.16"/><line x1="12" y1="22.76" x2="12" y2="11"/></svg>
        </div>
        <div style="flex:1;min-width:0">
            <div class="stat-num" id="dashPlanQty">—</div>
            <div class="stat-lbl">Total Plan QTY</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--blue-lt);color:var(--blue)">OH</div>
        <div style="flex:1;min-width:0">
            <div class="stat-num" id="dashOnHand">—</div>
            <div class="stat-bar-row"><div class="stat-bar-track"><div class="stat-bar-fill" id="dashOnHandBar" style="width:0%;background:var(--green)"></div></div><span class="stat-bar-pct" id="dashOnHandPct">0%</span></div>
            <div class="stat-lbl">Total On Hand</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--amber-lt);color:var(--amber)">RS</div>
        <div style="flex:1;min-width:0">
            <div class="stat-num" id="dashReserved">—</div>
            <div class="stat-bar-row"><div class="stat-bar-track"><div class="stat-bar-fill" id="dashReservedBar" style="width:0%;background:var(--amber)"></div></div><span class="stat-bar-pct" id="dashReservedPct">0%</span></div>
            <div class="stat-lbl">Total Reserved</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--green-lt);color:var(--green)">AV</div>
        <div style="flex:1;min-width:0">
            <div class="stat-num" id="dashAvailable">—</div>
            <div class="stat-bar-row"><div class="stat-bar-track"><div class="stat-bar-fill" id="dashAvailableBar" style="width:0%;background:var(--green)"></div></div><span class="stat-bar-pct" id="dashAvailablePct">0%</span></div>
            <div class="stat-lbl">Total Available</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--red-lt);color:var(--red)">CS</div>
        <div style="flex:1;min-width:0">
            <div class="stat-num" id="dashConsumed">—</div>
            <div class="stat-bar-row"><div class="stat-bar-track"><div class="stat-bar-fill" id="dashConsumedBar" style="width:0%;background:var(--red)"></div></div><span class="stat-bar-pct" id="dashConsumedPct">0%</span></div>
            <div class="stat-lbl">Total Consumed</div>
        </div>
    </div>
</div>

<!-- TAB PILLS -->
<div class="wo-tabs">
    <button class="wo-tab active" onclick="switchWoTab('summary',this)">Total Summary</button>
    <button class="wo-tab" onclick="switchWoTab('lots',this)">Lot Summary</button>
    <button class="wo-tab" onclick="switchWoTab('bom',this)">BOM Items</button>
    <button class="wo-tab" onclick="switchWoTab('tx',this)">Transaction</button>
    <button class="wo-tab" onclick="switchWoTab('detail',this)">W/O Detail</button>
</div>

<!-- TAB: Total Summary (grouped by location+part, expandable) -->
<div class="wo-tab-pane active" id="wotab-summary">

    <!-- Distribution Chart -->
    <div class="section-card" style="margin-bottom:20px">
        <div class="sc-head">
            <div class="sc-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2"  y="14" width="5" height="8" rx="1.5"/>
                    <rect x="9"  y="9"  width="5" height="13" rx="1.5"/>
                    <rect x="16" y="4"  width="5" height="18" rx="1.5"/>
                </svg>
                Inventory Distribution
                <span id="distChartLegend" class="count-badge"></span>
            </div>
            <div style="display:flex;align-items:center;gap:12px">
                <!-- Plan Target Mode -->
                <select id="planTargetMode" onchange="setPlanTargetMode(this.value)"
                        style="padding:5px 11px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--text);font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s;outline:none">
                    <option value="all">Plan Target: All Parts</option>
                    <option value="current">Plan Target: Only Current Part</option>
                </select>
                <!-- Part No filter dropdown -->
                <div style="position:relative" id="distPartDropWrap">
                    <button id="distPartDropBtn" onclick="toggleDistPartDrop()"
                            style="display:flex;align-items:center;gap:6px;padding:5px 11px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--text);font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s;white-space:nowrap">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
                        <span id="distPartDropLabel">All Parts</span>
                        <svg id="distPartDropChevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="transition:transform .2s"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div id="distPartDropdown" style="display:none;position:fixed;z-index:9999;background:#fff;border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,.12);width:240px">
                        <div style="padding:10px 10px 6px;border-bottom:1px solid var(--border)">
                            <input id="distPartSearchInput" type="text" placeholder="Search part no…"
                                   oninput="distPartSearchChange(this.value)"
                                   style="width:100%;padding:5px 9px;border:1px solid var(--border);border-radius:7px;font-size:12px;outline:none;font-family:inherit;box-sizing:border-box">
                            <div style="display:flex;gap:6px;margin-top:7px">
                                <button onclick="distPartSelectAll()" style="flex:1;padding:3px 0;border:1px solid var(--border);border-radius:6px;background:#f8f9fc;color:var(--t2);font-size:11px;font-weight:600;cursor:pointer;font-family:inherit">All</button>
                                <button onclick="distPartClearAll()" style="flex:1;padding:3px 0;border:1px solid var(--border);border-radius:6px;background:#f8f9fc;color:var(--t2);font-size:11px;font-weight:600;cursor:pointer;font-family:inherit">Clear</button>
                            </div>
                        </div>
                        <div id="distPartList" style="max-height:220px;overflow-y:auto;padding:6px 4px"></div>
                        <div style="padding:8px 10px;border-top:1px solid var(--border)">
                            <button onclick="distPartApply()"
                                    style="width:100%;padding:6px 0;border:none;border-radius:8px;background:var(--blue);color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;transition:.15s"
                                    onmouseover="this.style.background='var(--blue-dk)'"
                                    onmouseout="this.style.background='var(--blue)'">Apply</button>
                        </div>
                    </div>
                </div>
                @* <div style="font-size:11px;color:var(--t2)">On Hand by Location Type vs Plan Qty</div> *@
            </div>
        </div>
        <div id="distChartWrap" style="padding:20px 24px 12px">
            <div style="text-align:center;color:var(--t3);padding:36px 0;font-size:13px">Loading…</div>
        </div>
    </div>

    <div class="section-card">
        <div class="sc-head">
            <div class="sc-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                </svg>
                Total Summary
                <span id="summaryCount" class="count-badge"></span>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <div style="position:relative;display:flex;align-items:center">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--t3)" stroke-width="2.5" style="position:absolute;left:9px;pointer-events:none">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input id="sumSearchPart" type="text" placeholder="Part No. / Description"
                           oninput="sumPage=1;_distFocusPart=null;renderSumPage();_sumAutoSwitchTarget();buildDistributionChart()"
                           style="padding:5px 9px 5px 28px;border:1px solid var(--border);border-radius:8px;font-size:12px;outline:none;font-family:inherit;width:170px;transition:.15s"
                           onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor='var(--border)'">
                </div>
                <div class="loc-filter-dd-wrap">
                    <div class="loc-filter-dd-trigger" id="sumItemTypeFilterTrigger" tabindex="0" onclick="sumItemTypeFilterDdToggle()">
                        <span id="sumItemTypeFilterLabel">Item Type</span>
                        <i class="bi bi-chevron-down" style="font-size:11px;margin-left:auto;color:var(--t2)"></i>
                    </div>
                    <div class="loc-filter-dd-menu" id="sumItemTypeFilterMenu" style="display:none">
                        <div class="loc-filter-dd-item active" data-val="" onclick="sumItemTypeFilterPick('', 'Item Type')">All</div>
                    </div>
                </div>
                <div class="loc-filter-dd-wrap">
                    <div class="loc-filter-dd-trigger" id="locationFilterTrigger" tabindex="0" onclick="locationFilterDdToggle()">
                        <span id="locationFilterLabel">All Locations</span>
                        <i class="bi bi-chevron-down" style="font-size:11px;margin-left:auto;color:var(--t2)"></i>
                    </div>
                    <div class="loc-filter-dd-menu" id="locationFilterMenu" style="display:none">
                        <div class="loc-filter-dd-item active" data-val="" onclick="locationFilterDdPick('', 'All Locations')">All Locations</div>
                    </div>
                    <input type="hidden" id="locationFilter" value="">
                </div>
            </div>
        </div>
        <div style="overflow-x:auto">
            <table class="inv-table">
                <thead>
                    <tr>
                        <th style="width:40px"></th>
                        <th>Part</th>
                        <th style="min-width:180px" id="sumStockColHead">OnHand vs Target</th>
                        <th>Locations</th>
                        <th style="width:90px">Lots</th>
                    </tr>
                </thead>
                <tbody id="summaryTable"></tbody>
            </table>
        </div>
        <div class="pag-bar">
            <div style="display:flex;align-items:center;gap:10px">
                <select class="pag-size" id="sumPageSize" onchange="sumChangePS()">
                    <option value="10" selected>10 rows</option>
                    <option value="20">20 rows</option>
                    <option value="50">50 rows</option>
                </select>
                <span class="pag-info" id="sumPagInfo">—</span>
            </div>
            <div class="pag-btns">
                <button id="sumPrev" class="pag-btn" onclick="sumPrevPage()" disabled>← Prev</button>
                <span class="pag-page" id="sumPageNum">—</span>
                <button id="sumNext" class="pag-btn" onclick="sumNextPage()" disabled>Next →</button>
            </div>
        </div>
    </div>
</div>

<!-- TAB: Lot Summary (flat list of all lots) -->
<div class="wo-tab-pane" id="wotab-lots">
    <div class="section-card">
        <div class="sc-head">
            <div class="sc-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                    <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
                Lot Summary
                <span id="lotCount" class="count-badge"></span>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <div style="position:relative;display:flex;align-items:center">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--t3)" stroke-width="2.5" style="position:absolute;left:9px;pointer-events:none">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input id="lotSearchPart" type="text" placeholder="Part No."
                           oninput="lotPage=1;renderLotsPage()"
                           style="padding:5px 9px 5px 28px;border:1px solid var(--border);border-radius:8px;font-size:12px;outline:none;font-family:inherit;width:140px;transition:.15s"
                           onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor='var(--border)'">
                </div>
                <div style="position:relative;display:flex;align-items:center">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--t3)" stroke-width="2.5" style="position:absolute;left:9px;pointer-events:none">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input id="lotSearchLot" type="text" placeholder="Lot No."
                           oninput="lotPage=1;renderLotsPage()"
                           style="padding:5px 9px 5px 28px;border:1px solid var(--border);border-radius:8px;font-size:12px;outline:none;font-family:inherit;width:140px;transition:.15s"
                           onfocus="this.style.borderColor='var(--blue)'" onblur="this.style.borderColor='var(--border)'">
                </div>
                <div class="loc-filter-dd-wrap">
                    <div class="loc-filter-dd-trigger" id="lotLocTypeFilterTrigger" tabindex="0" onclick="lotLocTypeFilterDdToggle()" style="min-width:140px;padding:5px 10px;font-size:12px">
                        <span id="lotLocTypeFilterLabel">Location Type</span>
                        <i class="bi bi-chevron-down" style="font-size:10px;margin-left:auto;color:var(--t2)"></i>
                    </div>
                    <div class="loc-filter-dd-menu" id="lotLocTypeFilterMenu" style="display:none">
                        <div class="loc-filter-dd-item active" data-val="" onclick="lotLocTypeFilterPick('', 'Location Type')">All</div>
                    </div>
                </div>
                <div class="loc-filter-dd-wrap">
                    <div class="loc-filter-dd-trigger" id="lotItemTypeFilterTrigger" tabindex="0" onclick="lotItemTypeFilterDdToggle()" style="min-width:130px;padding:5px 10px;font-size:12px">
                        <span id="lotItemTypeFilterLabel">Item Type</span>
                        <i class="bi bi-chevron-down" style="font-size:10px;margin-left:auto;color:var(--t2)"></i>
                    </div>
                    <div class="loc-filter-dd-menu" id="lotItemTypeFilterMenu" style="display:none">
                        <div class="loc-filter-dd-item active" data-val="" onclick="lotItemTypeFilterPick('', 'Item Type')">All</div>
                    </div>
                </div>
            </div>
        </div>
        <div style="overflow-x:auto">
            <table class="inv-table">
                <thead>
                    <tr>
                        <th>Lot No.</th>
                        <th>Part No.</th>
                        <th>Item Type</th>
                        <th>Location</th>
                        <th>Location Type</th>
                        <th>On Hand</th>
