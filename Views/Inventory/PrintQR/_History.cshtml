<!-- ══════ TAB: HISTORY ══════ -->
<div class="tab-pane" id="tab-history">
    <div class="card">
        <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
            <div style="font-size:13px;font-weight:700;color:var(--navy);display:flex;align-items:center;gap:8px">
                <i class="bi bi-clock-history" style="color:var(--blue)"></i>
                Print History
                <span id="histCountBadge" class="count-badge"></span>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input id="histSearchLot" class="filter-input" placeholder="Lot No." style="width:140px"
                       onkeydown="if(event.key==='Enter') loadHistory(1)">
                <input id="histSearchIp" class="filter-input" placeholder="Printer IP" style="width:130px"
                       onkeydown="if(event.key==='Enter') loadHistory(1)">
                <input id="histFromDate" class="filter-input" type="date" style="width:140px"
                       onchange="loadHistory(1)">
                <input id="histToDate" class="filter-input" type="date" style="width:140px"
                       onchange="loadHistory(1)">
                <select id="histFilterSuccess" class="filter-select" onchange="loadHistory(1)">
                    <option value="">All Status</option>
                    <option value="true">Success</option>
                    <option value="false">Failed</option>
                </select>
                <select id="histFilterReprint" class="filter-select" onchange="loadHistory(1)">
                    <option value="">All Types</option>
                    <option value="false">Print</option>
                    <option value="true">Re-Print</option>
                </select>
                <button class="btn-search" onclick="loadHistory(1)">Search</button>
                <button class="btn-reset"  onclick="histReset()">Reset</button>
            </div>
        </div>
        <div style="overflow-x:auto">
            <table class="hist-table">
                <thead>
                    <tr>
                        <th>Lot No.</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Printer IP</th>
                        <th>User</th>
                        <th>Reprint Reason</th>
                        <th>Error</th>
                        <th>Printed At</th>
                        <th style="text-align:center">Action</th>
                    </tr>
                </thead>
                <tbody id="histTable"></tbody>
            </table>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-top:1px solid var(--border);flex-wrap:wrap;gap:10px">
            <div style="display:flex;align-items:center;gap:10px">
                <select class="pag-size" id="histPageSize" onchange="loadHistory(1)">
                    <option value="20" selected>20 rows</option>
                    <option value="50">50 rows</option>
                    <option value="100">100 rows</option>
                </select>
                <span class="pag-info" id="histPageInfo"></span>
            </div>
            <div class="pag-btns">
                <button id="histBtnPrev" class="pag-btn" onclick="histPrevPage()">← Prev</button>
                <span class="pag-page"  id="histPageNum">—</span>
                <button id="histBtnNext" class="pag-btn" onclick="histNextPage()">Next →</button>
            </div>
        </div>
    </div>
</div>

<script>
    let _histPage = 1, _histTotalPages = 1

    async function loadHistory(page = 1) {
        _histPage = page
        const lot      = document.getElementById('histSearchLot').value.trim()
        const ip       = document.getElementById('histSearchIp').value.trim()
        const fromDate = document.getElementById('histFromDate').value
        const toDate   = document.getElementById('histToDate').value
        const success  = document.getElementById('histFilterSuccess').value
        const reprint  = document.getElementById('histFilterReprint').value
        const ps       = parseInt(document.getElementById('histPageSize').value)

        const params = new URLSearchParams({ page, pageSize: ps })
        if (lot)        params.set('lotNo',      lot)
        if (ip)         params.set('printerIp',  ip)
        if (fromDate)   params.set('fromDate',   new Date(fromDate + 'T00:00:00').toISOString())
        if (toDate)     params.set('toDate',     new Date(toDate   + 'T23:59:59.999').toISOString())
        if (success !== '') params.set('success',   success)
        if (reprint !== '') params.set('isReprint', reprint)

        document.getElementById('histTable').innerHTML =
            `<tr><td colspan="9" style="text-align:center;color:var(--t2);padding:32px">Loading…</td></tr>`
        try {
            const res   = await api(`/printer/histories?${params}`, 'GET')
            const rows  = res?.data ?? []
            const total = res?.totalCount ?? rows.length
            const cp    = res?.page ?? page

            document.getElementById('histCountBadge').textContent = total.toLocaleString() + ' records'
            _histTotalPages = Math.ceil(total / ps) || 1

            document.getElementById('histPageInfo').textContent = `Page ${cp} / ${_histTotalPages}`
            document.getElementById('histPageNum').textContent  = cp
            document.getElementById('histBtnPrev').disabled = (cp <= 1)
            document.getElementById('histBtnNext').disabled = (cp >= _histTotalPages)

            document.getElementById('histTable').innerHTML = rows.length === 0
                ? `<tr><td colspan="9" style="text-align:center;color:var(--t3);padding:32px">No records found</td></tr>`
                : rows.map(x => `<tr>
                    <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${escHtml(x.lotNo ?? '—')}</td>
                    <td><span class="${x.isReprint ? 'hist-reprint' : 'hist-print'}">${x.isReprint ? 'Re-Print' : 'Print'}</span></td>
                    <td><span class="${x.success ? 'hist-success' : 'hist-fail'}">${x.success ? '✓ Success' : '✗ Failed'}</span></td>
                    <td style="font-family:ui-monospace,monospace;font-size:12px;color:var(--t2)">${escHtml(x.printerIp ?? '—')}</td>
                    <td style="color:var(--navy);font-weight:500;font-size:12px">${escHtml(x.printUser ?? '—')}</td>
                    <td style="color:var(--t2);font-size:12px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(x.reprintReason ?? '')}">${escHtml(x.reprintReason || '—')}</td>
                    <td style="color:var(--red);font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(x.errorMessage ?? '')}">${escHtml(x.errorMessage || '—')}</td>
                    <td style="color:var(--t2);font-size:12px;white-space:nowrap">${x.printedAt ? new Date(x.printedAt).toLocaleString('th-TH',{dateStyle:'short',timeStyle:'medium'}) : '—'}</td>
                    <td style="text-align:center;white-space:nowrap">
                        ${x.lotNo ? `<button onclick="histGoReprint('${escHtml(x.lotNo)}')"
                            style="padding:4px 10px;border:none;border-radius:7px;background:var(--blue-lt);color:var(--blue);font-size:11px;font-weight:700;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:4px;transition:.12s"
                            onmouseover="this.style.background='var(--blue)';this.style.color='#fff'"
                            onmouseout="this.style.background='var(--blue-lt)';this.style.color='var(--blue)'">
                            <i class="bi bi-printer-fill" style="font-size:11px"></i> Re-Print
                        </button>` : '—'}
                    </td>
                </tr>`).join('')
        } catch (err) {
            document.getElementById('histTable').innerHTML =
                `<tr><td colspan="9" style="text-align:center;color:var(--red);padding:32px">Load failed: ${escHtml(err.message)}</td></tr>`
        }
    }

    function histPrevPage() { if (_histPage > 1) loadHistory(_histPage - 1) }
    function histNextPage() { if (_histPage < _histTotalPages) loadHistory(_histPage + 1) }

    async function histGoReprint(lotNo) {
        if (!lotNo) return
        const reprBtn = [...document.querySelectorAll('.tab-pill')].find(b => b.textContent.includes('Re-Print'))
        if (reprBtn) reprBtn.click()
        if (typeof rprFetchAndAddByLotNo === 'function') {
            await rprFetchAndAddByLotNo(lotNo)
        }
    }
    function histReset() {
        document.getElementById('histSearchLot').value      = ''
        document.getElementById('histSearchIp').value       = ''
        document.getElementById('histFromDate').value       = ''
        document.getElementById('histToDate').value         = ''
        document.getElementById('histFilterSuccess').value  = ''
        document.getElementById('histFilterReprint').value  = ''
        loadHistory(1)
    }
</script>
