<!-- ══════ TAB: HISTORY ══════ -->
<div class="tab-pane" id="tab-history">
    <div class="card" style="overflow:visible">
        <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
            <div style="font-size:13px;font-weight:700;color:var(--navy);display:flex;align-items:center;gap:8px">
                <i class="bi bi-clock-history" style="color:var(--blue)"></i>
                Print History
                <span id="histCountBadge" class="count-badge"></span>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input id="histSearchLot" class="filter-input" placeholder="Lot No." style="width:140px"
                       oninput="histDebouncedSearch()">
                <select id="histSearchIp" class="filter-select" onchange="loadHistory(1)">
                    <option value="">All Printers</option>
                </select>
                <input id="histSearchUser" class="filter-input" placeholder="Print User" style="width:120px"
                       oninput="histDebouncedSearch()">
                <input id="histSearchReason" class="filter-input" placeholder="Reprint Reason" style="width:140px"
                       oninput="histDebouncedSearch()">
                <input id="histSearchError" class="filter-input" placeholder="Error Message" style="width:140px"
                       oninput="histDebouncedSearch()">
                <partial name="_DateRangePicker" model="@("hist")" />
                <select id="histFilterSuccess" class="filter-select" onchange="loadHistory(1)">
                    <option value="">All Status</option>
                    <option value="true">Success</option>
                    <option value="false">Failed</option>
                </select>
                <select id="histFilterReprint" class="filter-select" onchange="loadHistory(1)">
                    <option value="">All Types</option>
                    <option value="false">Print</option>
                    <option value="true">Re-Print</option>
                </select>
            </div>
        </div>
        <div style="overflow-x:auto">
            <table class="hist-table">
                <thead>
                    <tr>
                        <th>Lot No.</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>ZPL Data</th>
                        <th>Printer</th>
                        <th>User</th>
                        <th>Reprint Reason</th>
                        <th>Error</th>
                        <th>Printed At</th>
                        <th style="text-align:center">Action</th>
                    </tr>
                </thead>
                <tbody id="histTable"></tbody>
            </table>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-top:1px solid var(--border);flex-wrap:wrap;gap:10px">
            <div style="display:flex;align-items:center;gap:10px">
                <select class="pag-size" id="histPageSize" onchange="loadHistory(1)">
                    <option value="20" selected>20 rows</option>
                    <option value="50">50 rows</option>
                    <option value="100">100 rows</option>
                </select>
                <span class="pag-info" id="histPageInfo"></span>
            </div>
            <div class="pag-btns">
                <button id="histBtnPrev" class="pag-btn" onclick="histPrevPage()">← Prev</button>
                <span class="pag-page"  id="histPageNum">—</span>
                <button id="histBtnNext" class="pag-btn" onclick="histNextPage()">Next →</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ HISTORY: ZPL PREVIEW MODAL (Label Preview / QR Data / ZPL Code) ══ -->
<div id="histPreviewModal" style="display:none" onclick="if(event.target===this)histClosePreview()">
    <div class="rp-preview-inner">
        <button class="rp-preview-close" onclick="histClosePreview()">✕</button>
        <div style="font-size:14px;font-weight:700;color:var(--navy);margin-bottom:14px;display:flex;align-items:center;gap:8px">
            <i class="bi bi-qr-code" style="color:var(--blue)"></i> ZPL Preview
            <span id="histPreviewLot" style="font-size:12px;font-weight:600;color:var(--t2);font-family:ui-monospace,monospace"></span>
        </div>

        <div class="sub-tabs" id="histPrevTabs">
            <div class="sub-tab active" onclick="histSwitchTab('preview', this)"><i class="bi bi-image me-1"></i>Label Preview</div>
            <div class="sub-tab" onclick="histSwitchTab('qrdata', this)"><i class="bi bi-qr-code me-1"></i>QR Data</div>
            <div class="sub-tab" onclick="histSwitchTab('zpl', this)"><i class="bi bi-code-square me-1"></i>ZPL Code</div>
        </div>

        <div id="hist-sub-preview">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
                <i class="bi bi-rulers" style="color:var(--t2);font-size:13px;flex-shrink:0"></i>
                <span style="font-size:12px;font-weight:600;color:var(--t2);flex-shrink:0">Render Size:</span>
                <select id="histLayoutSelect" class="form-select" style="flex:1;font-size:12px;padding:5px 8px" onchange="histApplyLayoutCfg()">
                    <option value="">-- Default (8dpmm, 3.2x1.2 in) --</option>
                </select>
            </div>
            <div class="label-preview-box" id="histPreviewImgWrap">
                <div style="color:var(--t3);font-size:13px">Loading…</div>
            </div>
        </div>
        <div id="hist-sub-qrdata" style="display:none">
            <div class="code-box" id="histQrDataBox"></div>
        </div>
        <div id="hist-sub-zpl" style="display:none">
            <div class="code-box" id="histZplBox" style="max-height:320px;overflow-y:auto"></div>
        </div>
    </div>
</div>

<script>
    let _histPage = 1, _histTotalPages = 1
    let _histRows = []

    async function loadHistory(page = 1) {
        _histPage = page
        const lot      = document.getElementById('histSearchLot').value.trim()
        const ip       = document.getElementById('histSearchIp').value.trim()
        const user     = document.getElementById('histSearchUser').value.trim()
        const reason   = document.getElementById('histSearchReason').value.trim()
        const error    = document.getElementById('histSearchError').value.trim()
        const fromDate = document.getElementById('histDrFrom').value
        const toDate   = document.getElementById('histDrTo').value
        const success  = document.getElementById('histFilterSuccess').value
        const reprint  = document.getElementById('histFilterReprint').value
        const ps       = parseInt(document.getElementById('histPageSize').value)

        const params = new URLSearchParams({ page, pageSize: ps })
        if (lot)        params.set('lotNo',         lot)
        if (ip)         params.set('printerIp',     ip)
        if (user)       params.set('printUser',     user)
        if (reason)     params.set('reprintReason', reason)
        if (error)      params.set('errorMessage',  error)
        if (fromDate)   params.set('fromDate',   new Date(fromDate + 'T00:00:00').toISOString())
        if (toDate)     params.set('toDate',     new Date(toDate   + 'T23:59:59.999').toISOString())
        if (success !== '') params.set('success',   success)
        if (reprint !== '') params.set('isReprint', reprint)

        document.getElementById('histTable').innerHTML =
            `<tr><td colspan="9" style="text-align:center;color:var(--t2);padding:32px">Loading…</td></tr>`
        try {
            const res   = await api(`/printer/histories?${params}`, 'GET')
            const rows  = res?.data ?? []
            const total = res?.totalCount ?? rows.length
            const cp    = res?.page ?? page

            document.getElementById('histCountBadge').textContent = total.toLocaleString() + ' records'
            _histTotalPages = Math.ceil(total / ps) || 1

            document.getElementById('histPageInfo').textContent = `Page ${cp} / ${_histTotalPages}`
            document.getElementById('histPageNum').textContent  = cp
            document.getElementById('histBtnPrev').disabled = (cp <= 1)
            document.getElementById('histBtnNext').disabled = (cp >= _histTotalPages)

            _histRows = rows
            document.getElementById('histTable').innerHTML = rows.length === 0
                ? `<tr><td colspan="9" style="text-align:center;color:var(--t3);padding:32px">No records found</td></tr>`
                : rows.map((x, i) => `<tr>
                    <td style="font-family:ui-monospace,monospace;font-weight:700;color:var(--navy)">${escHtml(x.lotNo ?? '—')}</td>
                    <td><span class="${x.isReprint ? 'hist-reprint' : 'hist-print'}">${x.isReprint ? 'Re-Print' : 'Print'}</span></td>
                    <td><span class="${x.success ? 'hist-success' : 'hist-fail'}">${x.success ? '✓ Success' : '✗ Failed'}</span></td>
                    <td>${x.zplData
                        ? `<button class="hist-zpl-cell" onclick="histShowZplPreview(${i})" title="คลิกเพื่อดู Label Preview">
                               <i class="bi bi-qr-code-scan"></i>
                               <span class="hist-zpl-snippet">${escHtml(x.zplData.split('\n')[0])}</span>
                               <i class="bi bi-chevron-right hist-zpl-arrow"></i>
                           </button>`
                        : '—'}</td>
                    <td style="font-size:12px;color:var(--t2)">${escHtml(_histPrinterNameByIp[x.printerIp] || '—')}</td>
                    <td style="color:var(--navy);font-weight:500;font-size:12px">${escHtml(x.printUser ?? '—')}</td>
                    <td style="color:var(--t2);font-size:12px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(x.reprintReason ?? '')}">${escHtml(x.reprintReason || '—')}</td>
                    <td style="color:var(--red);font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(x.errorMessage ?? '')}">${escHtml(x.errorMessage || '—')}</td>
                    <td style="color:var(--t2);font-size:12px;white-space:nowrap">${x.printedAt ? new Date(x.printedAt).toLocaleString('th-TH',{dateStyle:'short',timeStyle:'medium'}) : '—'}</td>
                    <td style="text-align:center;white-space:nowrap">
                        ${x.lotNo ? `<button onclick="histGoReprint('${escHtml(x.lotNo)}')"
                            style="padding:4px 10px;border:none;border-radius:7px;background:var(--blue-lt);color:var(--blue);font-size:11px;font-weight:700;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:4px;transition:.12s"
                            onmouseover="this.style.background='var(--blue)';this.style.color='#fff'"
                            onmouseout="this.style.background='var(--blue-lt)';this.style.color='var(--blue)'">
                            <i class="bi bi-printer-fill" style="font-size:11px"></i> Re-Print
                        </button>` : '—'}
                    </td>
                </tr>`).join('')
        } catch (err) {
            document.getElementById('histTable').innerHTML =
                `<tr><td colspan="9" style="text-align:center;color:var(--red);padding:32px">Load failed: ${escHtml(err.message)}</td></tr>`
        }
    }

    function histSwitchTab(name, el) {
        ['preview', 'qrdata', 'zpl'].forEach(k => {
            document.getElementById('hist-sub-' + k).style.display = k === name ? '' : 'none'
        })
        document.getElementById('histPrevTabs').querySelectorAll('.sub-tab')
            .forEach(t => t.classList.remove('active'))
        el.classList.add('active')
    }

    function histClosePreview() {
        document.getElementById('histPreviewModal').style.display = 'none'
    }

    let _histCurrentZpl = null
    let _histCfg = { dpi: '8dpmm', width: 3.2, height: 1.2 }

    async function histShowZplPreview(idx) {
        const row = _histRows[idx]
        if (!row?.zplData) return

        _histCurrentZpl = row.zplData
        _histCfg = { dpi: '8dpmm', width: 3.2, height: 1.2 }
        const layoutSel = document.getElementById('histLayoutSelect')
        if (layoutSel) layoutSel.value = ''

        document.getElementById('histPreviewLot').textContent = row.lotNo ?? ''
        document.getElementById('histPreviewModal').style.display = 'flex'
        histSwitchTab('preview', document.querySelector('#histPrevTabs .sub-tab'))

        document.getElementById('histZplBox').textContent = row.zplData

        const qrMatch = row.zplData.match(/\^FDMA,(\{[\s\S]*?\})\^FS/)
        document.getElementById('histQrDataBox').textContent = qrMatch
            ? (() => { try { return JSON.stringify(JSON.parse(qrMatch[1]), null, 2) } catch { return qrMatch[1] } })()
            : '— No QR data found —'

        await _histRenderPreviewImg()
    }

    function histApplyLayoutCfg() {
        const sel = document.getElementById('histLayoutSelect')
        const id  = sel.value
        if (!id) {
            _histCfg = { dpi: '8dpmm', width: 3.2, height: 1.2 }
            _histRenderPreviewImg()
            return
        }
        const layout = (sel._layoutsData || []).find(l => String(l.id) === String(id))
        if (!layout) return
        const cfg = parseZplDataJson(layout)
        _histCfg = { dpi: cfg.dpi ?? '8dpmm', width: cfg.width ?? 3.2, height: cfg.height ?? 1.2 }
        _histRenderPreviewImg()
    }

    async function _histRenderPreviewImg() {
        if (!_histCurrentZpl) return
        const wrap = document.getElementById('histPreviewImgWrap')
        wrap.innerHTML = `<div style="color:var(--t3);font-size:13px">Loading…</div>`
        try {
            const src = await renderZplClient(_histCurrentZpl, _histCfg.dpi, _histCfg.width, _histCfg.height)
            wrap.innerHTML = src
                ? `<img src="${src}" style="max-width:100%;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.12)">`
                : `<div style="color:var(--amber);font-size:13px">Preview not available</div>`
        } catch (err) {
            wrap.innerHTML = `<div style="color:var(--red);font-size:12px">❌ ${escHtml(err.message)}</div>`
        }
    }

    function histPrevPage() { if (_histPage > 1) loadHistory(_histPage - 1) }
    function histNextPage() { if (_histPage < _histTotalPages) loadHistory(_histPage + 1) }

    // ── Date Range Picker (History filter) — component ใช้ร่วมกับหน้าอื่นได้ ดู dateRangePicker.js ──
    // สร้างตอน DOMContentLoaded เพราะ createDateRangePicker มาจาก dateRangePicker.js ที่โหลดทีหลังใน @@section Scripts
    let histDateRange = null
    document.addEventListener('DOMContentLoaded', () => {
        histDateRange = createDateRangePicker({ prefix: 'hist', onApply: () => loadHistory(1) })
        histLoadPrinterFilter()
    })

    // เติม dropdown filter "Printer IP" จาก /printer/all (โชว์ทุกเครื่องไม่กรอง permission — เป็นแค่ filter ค้นประวัติ ไม่ใช่เลือกเครื่องพิมพ์จริง)
    // เก็บ ip -> name ไว้ใน _histPrinterNameByIp ด้วย เอาไปโชว์ชื่อเครื่องแทน IP ในตาราง (แถวที่โหลดมาก่อน map พร้อมจะ fallback เป็น IP ไปก่อน)
    let _histPrinterNameByIp = {}
    async function histLoadPrinterFilter() {
        const sel = document.getElementById('histSearchIp')
        try {
            const res = await api('/printer/all', 'GET')
            const printers = Array.isArray(res) ? res : (res?.data ?? [])
            printers.forEach(p => { _histPrinterNameByIp[p.printerIp] = (p.printerName || '').replace(/[\r\n]+/g, ' ').trim() })
            sel.innerHTML = '<option value="">All Printers</option>' +
                printers.map(p => `<option value="${escHtml(p.printerIp)}">${escHtml(_histPrinterNameByIp[p.printerIp])}</option>`).join('')
        } catch (_) {
            // โหลดไม่สำเร็จ — ปล่อยเป็น "All Printers" อย่างเดียว ไม่ block การใช้งาน filter อื่น
        }
    }

    async function histGoReprint(lotNo) {
        if (!lotNo) return
        const reprBtn = [...document.querySelectorAll('.tab-pill')].find(b => b.textContent.includes('Re-Print'))
        if (reprBtn) reprBtn.click()
        if (typeof rprFetchAndAddByLotNo === 'function') {
            await rprFetchAndAddByLotNo(lotNo)
        }
    }
    // Filter แบบ autocomplete — พิมพ์แล้ว debounce รอสักครู่ค่อยยิงค้นหาเอง ไม่ต้องกด Search
    let _histSearchTimer = null
    function histDebouncedSearch() {
        clearTimeout(_histSearchTimer)
        _histSearchTimer = setTimeout(() => loadHistory(1), 400)
    }
</script>
