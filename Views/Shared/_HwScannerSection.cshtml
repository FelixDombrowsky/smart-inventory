<style>
.hw-section { padding:12px 16px; border-bottom:1px solid var(--border); background:#f0f8ff; }
.hw-wrap { position:relative; }
.hw-wrap > i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--blue); font-size:16px; pointer-events:none; }
.hw-input {
    width:100%; padding:10px 12px 10px 38px; border:1.5px solid var(--blue); border-radius:9px;
    font-size:14px; font-family:inherit; color:var(--text); outline:none; box-sizing:border-box; background:#fff;
}
.hw-status { text-align:center; font-size:13px; color:var(--t2); margin-top:8px; min-height:18px; }
</style>

<div id="hwSection" style="display:none" class="hw-section">
    <div class="hw-wrap">
        <i class="bi bi-upc-scan"></i>
        <input id="hwInput" class="hw-input" placeholder="พร้อมสแกน — สแกน barcode ได้เลย…" autocomplete="off">
    </div>
    <div id="hwStatus" class="hw-status">พร้อมสแกน…</div>
</div>
