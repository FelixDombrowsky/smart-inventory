<style>
.bc-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.bc-card-body { padding:16px; }
.bc-scanner-box {
    width:100%; height:50vh; max-height:520px; border:3px solid var(--blue);
    border-radius:16px; position:relative; overflow:hidden; background:#000; margin:0 auto;
}
@@media (orientation: landscape) {
    .bc-scanner-box { height:75vh; max-height:640px; }
}
.bc-scanner-box video  { position:absolute;inset:0;width:100%;height:100%;object-fit:cover; }
.bc-scanner-box canvas { position:absolute;inset:0;width:100%;height:100%;pointer-events:none; }
.bc-label {
    position:absolute; bottom:0; left:0; right:0;
    background:rgba(0,0,0,.65); color:#fff;
    font-size:12px; font-weight:600; padding:6px 10px;
    text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.bc-torch-btn.active { background:#fef3c7 !important; border-color:#f59e0b !important; }
.bc-torch-btn.active svg { stroke:#f59e0b !important; }
</style>

<div id="bcSection" style="display:none" class="bc-card">
    <div class="bc-card-body">
        <div class="bc-scanner-box">
            <video id="bcVideo" autoplay playsinline muted></video>
            <canvas id="bcCanvas"></canvas>
            <div class="bc-label" id="bcLabel">— กำลังค้นหา barcode —</div>
        </div>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:14px">
            <button onclick="switchCamera()" title="สลับกล้อง" aria-label="สลับกล้อง"
                    style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;border:1.5px solid var(--border);border-radius:9px;background:#fff;cursor:pointer;transition:.15s"
                    onmouseover="this.style.borderColor='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)'">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12a8 8 0 0 1 13.3-6"/>
                    <polyline points="17 2 17 6.3 12.7 6.3"/>
                    <path d="M20 12a8 8 0 0 1-13.3 6"/>
                    <polyline points="7 22 7 17.7 11.3 17.7"/>
                    <rect x="8.2" y="9" width="7.6" height="6" rx="1.4"/>
                    <circle cx="12" cy="12" r="1.2"/>
                </svg>
            </button>
            <button id="bcTorchBtn" class="bc-torch-btn" onclick="toggleTorch()" title="เปิด/ปิดแฟลช" aria-label="เปิด/ปิดแฟลช"
                    style="display:none;width:44px;height:44px;align-items:center;justify-content:center;border:1.5px solid var(--border);border-radius:9px;background:#fff;cursor:pointer;transition:.15s">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
            </button>
            <button onclick="stopScan()" title="ปิดกล้อง" aria-label="ปิดกล้อง"
                    style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;border:none;border-radius:9px;background:#fee2e2;cursor:pointer">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="1" y1="1" x2="23" y2="23"/>
                    <path d="M21 21H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3l2-3h6l2 3h4a2 2 0 0 1 2 2v9.34"/>
                    <path d="M14.12 14.12a4 4 0 1 1-5.24-5.24"/>
                </svg>
            </button>
        </div>
        <div id="bcStatus" style="text-align:center;font-size:13px;color:var(--t2);margin-top:10px;min-height:18px">กำลังสแกน…</div>
    </div>
</div>
