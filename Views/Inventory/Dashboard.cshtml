    // ── Transactions Today + Users Today + Receive Today ──
    // เดิมไล่ยิง /transaction/get ทีละหน้าจนกว่าจะเจอ record ที่ไม่ใช่ของวันนี้ แล้วนับ/filter เอาเองฝั่ง client (ช้า ยิงหลาย
    // request) เปลี่ยนมาใช้ 3 แหล่งข้อมูลที่ตรงกว่าตามที่ขอ:
    // - Users Today: GET /transaction/ranking?from=...&to=... คืน list ต่อ (performedBy, transactionType) — นับ distinct
    //   performedBy เอา (ไม่ใช่ sum ตัวเลขในนั้น เพราะ "Users Today" คือจำนวนคนที่ active วันนี้ ไม่ใช่ยอดรวม transaction)
    // - Transactions Today / Receive Today: POST /transaction/get เอาแค่ field "total" (totalCount) จาก response ตรงๆ
    //   ไม่ต้องไล่ยิงทุกหน้าเหมือนเดิม — Receive Today ส่ง transactionType: "Receive" เพิ่มเข้าไปกรองที่ backend เลย
    // "วันนี้" ใช้ช่วง 00:00:00 UTC ของวันนี้ ถึงเวลาปัจจุบัน (ตาม semantics เดิมที่กรองด้วย createdAt.startsWith(today) แบบ UTC)
    // แสดงลูกศรขึ้น/ลงเทียบกับค่าของ "ช่วงเวลาเดียวกัน" เมื่อสัปดาห์ที่แล้ว (ไม่ใช่เทียบกับเมื่อวาน) ข้าง wb-stat-num — previous
    // เป็น 0 แต่ current มีค่า ถือเป็น "New" (คิด % เพิ่ม/ลดจากฐาน 0 ไม่ได้) ทั้งสองเป็น 0 ถือว่าเท่ากัน ไม่ต้องโชว้ลูกศรอะไรเลย
    function renderStatDelta(elId, current, previous) {
        const el = document.getElementById(elId)
        if (!el) return
        if (previous === 0 && current === 0) { el.className = 'wb-stat-delta'; el.innerHTML = ''; return }
        if (previous === 0) { el.className = 'wb-stat-delta up'; el.innerHTML = '<i class="bi bi-arrow-up-short"></i>New'; return }
        const pct = (current - previous) / previous * 100
        const dir  = pct > 0 ? 'up' : pct < 0 ? 'down' : 'flat'
        const icon = dir === 'up' ? 'bi-arrow-up-short' : dir === 'down' ? 'bi-arrow-down-short' : 'bi-dash-lg'
        el.className = 'wb-stat-delta ' + dir
        el.innerHTML = `<i class="bi ${icon}"></i>${Math.abs(pct).toFixed(0)}%`
    }
    // จำนวน transaction ในช่วงเวลา (อ่านแค่ total — pageSize 1) — ถ้าเลือก Location Type ไว้ นับเฉพาะที่ "เกี่ยวกับ" type นั้น:
    // /transaction/get กรอง fromLocationType / toLocationType (id ตัวเลขจาก /location/types) ได้ทีละเงื่อนไขแบบ AND
    // เลยใช้ from=X + to=X − (from=X และ to=X) ไม่นับรายการที่ย้ายภายใน type เดียวกันซ้ำ 2 รอบ
    // onlyTo = true (ใช้กับ Receive): นับเฉพาะที่ปลายทางเป็น type นั้น (รับเข้า location ประเภทนั้น)
    async function _txCount(base, locTypeId, onlyTo = false) {
        const total = r => r?.total ?? r?.totalCount ?? 0
        const q = extra => api('/transaction/get', 'POST', { page: 1, pageSize: 1, ...base, ...extra }).then(total)
        if (!locTypeId) return q({})
        if (onlyTo)     return q({ toLocationType: locTypeId })
        const [from, to, both] = await Promise.all([
            q({ fromLocationType: locTypeId }),
            q({ toLocationType: locTypeId }),
            q({ fromLocationType: locTypeId, toLocationType: locTypeId }),
        ])
        return from + to - both
    }

    let _todayStatsToken = 0
    async function loadTodayStats() {
        const myToken = ++_todayStatsToken
        // Location Type ที่เลือกบนหัวหน้า (เก็บเป็นชื่อ) → id ที่ /transaction/get ต้องการ
        const locTypeId = filterLocationType ? (_dashLocTypes.find(t => t.name === filterLocationType)?.id ?? null) : null
        try {
            const now = new Date()
            // คิดเวลาไทย (UTC+7 คงที่ ไม่มี DST) เอง ไม่พึ่ง timezone ของเครื่อง — shift ไปข้างหน้า 7 ชม. ก่อนอ่าน Y/M/D
            // แล้ว shift กลับตอนคำนวณ instant จริง
            // "วันนี้" = วันทำงานของโรงงาน เริ่ม 07:40 เวลาไทย (ไม่ใช่เที่ยงคืน) — ก่อน 07:40 ยังนับเป็นวันทำงานของเมื่อวาน
            // (เริ่ม 07:40 เมื่อวาน) เลยถอยเวลาไทยลง 7 ชม. 40 นาทีก่อนอ่าน Y/M/D แล้วค่อยประกอบเป็น 07:40 ของวันนั้น
            const THAI_OFFSET_MS   = 7 * 60 * 60 * 1000
            const DAY_START_H = 7, DAY_START_M = 40
            const DAY_START_MS     = (DAY_START_H * 60 + DAY_START_M) * 60 * 1000
            const nowThaiShifted   = new Date(now.getTime() + THAI_OFFSET_MS - DAY_START_MS)
            const startOfDay       = new Date(Date.UTC(
                nowThaiShifted.getUTCFullYear(), nowThaiShifted.getUTCMonth(), nowThaiShifted.getUTCDate(), DAY_START_H, DAY_START_M, 0, 0
            ) - THAI_OFFSET_MS)
            const fromISO      = startOfDay.toISOString()
            const toISO        = now.toISOString()
            // ช่วงเดียวกันเมื่อ 7 วันก่อน (วันเดียวกันในสัปดาห์ เวลาช่วงเดียวกัน) ใช้เทียบเปอร์เซ็นต์เพิ่ม/ลด — ลบ 7×24 ชม.
            // ออกจากทั้ง from/to ตรงๆ ตรงกับ "same time last week" ไม่ใช่ทั้งวันของ 7 วันก่อน
            const WEEK_MS       = 7 * 24 * 60 * 60 * 1000
            const fromLastWkISO = new Date(startOfDay.getTime() - WEEK_MS).toISOString()
            const toLastWkISO   = new Date(now.getTime() - WEEK_MS).toISOString()

            const today  = { startDate: fromISO,       endDate: toISO }
            const lastWk = { startDate: fromLastWkISO, endDate: toLastWkISO }
            // Users Today: /transaction/ranking ไม่มี parameter location — ยังเป็นยอดรวมทุก location เสมอ (บอกไว้ใน tooltip)
            const [ranking, txCount, receiveCount, rankingLastWk, txCountLastWk, receiveCountLastWk] = await Promise.all([
                api(`/transaction/ranking?${new URLSearchParams({ from: fromISO, to: toISO })}`, 'GET'),
                _txCount(today, locTypeId),
                _txCount({ ...today, transactionType: 'Receive' }, locTypeId, true),
                api(`/transaction/ranking?${new URLSearchParams({ from: fromLastWkISO, to: toLastWkISO })}`, 'GET'),
                _txCount(lastWk, locTypeId),
                _txCount({ ...lastWk, transactionType: 'Receive' }, locTypeId, true),
            ])
            if (myToken !== _todayStatsToken) return   // เปลี่ยน Location Type ระหว่างรอ — ผลรอบนี้เก่าแล้ว

            const userCount       = new Set((ranking || []).map(r => r.performedBy).filter(Boolean)).size
            const userCountLastWk = new Set((rankingLastWk || []).map(r => r.performedBy).filter(Boolean)).size
            document.getElementById('ws-users-today').closest('.today-chip').title =
                locTypeId ? 'Users Today: all locations (this number is not filtered by Location Type)' : ''

            document.getElementById("ws-txtoday").textContent        = txCount.toLocaleString()
            document.getElementById("ws-lots-available").textContent = receiveCount.toLocaleString()
            document.getElementById("ws-users-today").textContent    = userCount.toLocaleString()

            renderStatDelta('ws-users-today-delta',    userCount,    userCountLastWk)
            renderStatDelta('ws-txtoday-delta',        txCount,      txCountLastWk)
            renderStatDelta('ws-lots-available-delta', receiveCount, receiveCountLastWk)
        } catch (err) {
            console.error("loadTodayStats:", err)
            if (myToken !== _todayStatsToken) return
            document.getElementById("ws-txtoday").textContent        = "—"
            document.getElementById("ws-lots-available").textContent = "—"
            document.getElementById("ws-users-today").textContent    = "—"
        }
    }

    // ── TRANSACTION TREND ──────────────────────────────────────────────────────────────────────────────────────
    // GET /transaction/stock-transactions/summary?from&to → dailySummary [{ date:'YYYY-MM-DD', transactionType:<id>, transactionCount }]
    // (endpoint เดียวกับ Trend Chart หน้า Transactions — วันแบ่งตามวันที่ UTC แบบเดียวกัน) ยิงครั้งเดียวครอบ 2 ช่วง: ช่วงที่ดู + ช่วงก่อนหน้า
    // ความยาวเท่ากัน ไว้คิด % เทียบ / endpoint นี้ไม่มี parameter location → กราฟไม่กรองตาม Location Type (บอกไว้ใน #trendNote)
    let _trendDays = 7
    let _trendTypeNames = null   // id → ชื่อ type จาก /transaction/type (โหลดครั้งเดียว)
    let _trendData = null        // { labels, all, rcv, byType, total } ล่าสุด — ใช้ re-render ตอน resize/เปลี่ยนภาษา
    let _trendToken = 0

    function _trendLabels(days, back = 0) {
        const out = []
        for (let i = days - 1; i >= 0; i--) {
            const d = new Date(); d.setDate(d.getDate() - i - back)
            out.push(d.toISOString().slice(0, 10))
        }
        return out
    }
    function _trendFmt(n) { return n >= 1000 ? +(n / 1000).toFixed(1) + 'k' : String(n) }
    // แกน Y 4 ช่อง — ขนาดช่องปัดเป็นเลขกลมๆ (1/1.5/2/2.5/3/4/5/6/8 × 10^k, อย่างน้อย 1 และเป็นจำนวนเต็ม) ป้ายจะได้ไม่ออกมาเป็น 3, 8, 13k
    // และไม่เผื่อที่ว่างเหนือเส้นมากเกินไป
    function _trendNiceMax(v) {
        const raw = Math.max(v, 1) / 4
        const mag = Math.pow(10, Math.floor(Math.log10(raw)))
        let step = [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10].map(s => s * mag).find(s => s >= raw)
        step = Math.max(1, Number.isInteger(step) ? step : Math.ceil(step))
        return step * 4
    }
    function _trendSmooth(p) {
        let d = `M${p[0].x},${p[0].y}`
        for (let i = 0; i < p.length - 1; i++) {
            const p0 = p[i - 1] || p[i], p1 = p[i], p2 = p[i + 1], p3 = p[i + 2] || p2
            d += ` C${(p1.x + (p2.x - p0.x) / 6).toFixed(1)},${(p1.y + (p2.y - p0.y) / 6).toFixed(1)}` +
                 ` ${(p2.x - (p3.x - p1.x) / 6).toFixed(1)},${(p2.y - (p3.y - p1.y) / 6).toFixed(1)} ${p2.x},${p2.y}`
        }
        return d
    }
    function _trendDayLabel(iso, short) {
        const lang = getCurrentLang() === 'th' ? 'th-TH' : 'en-GB'
        const d = new Date(iso + 'T00:00:00Z')
        return short ? d.toLocaleDateString(lang, { weekday: 'short', timeZone: 'UTC' })
                     : d.toLocaleDateString(lang, { day: 'numeric', month: 'short', timeZone: 'UTC' })
    }
    function _trendUpdateNote() {
        const el = document.getElementById('trendNote')
        if (el) el.textContent = filterLocationType ? dashDict().trendAllLoc : ''
    }

    function setTrendDays(days) {
        _trendDays = days
        document.querySelectorAll('.trend-seg button').forEach(b => b.classList.toggle('active', Number(b.dataset.days) === days))
        loadTrend()
        loadRanking()   // Top Users ใช้ช่วงเวลาเดียวกับกราฟ
    }

    async function loadTrend() {
        const myToken = ++_trendToken
        const cur = _trendLabels(_trendDays), prev = _trendLabels(_trendDays, _trendDays)
        const msg = document.getElementById('trendChart')
        msg.innerHTML = `<div class="trend-empty">Loading…</div>`
        _trendUpdateNote()
        try {
            if (!_trendTypeNames) {
                const arr = await api('/transaction/type', 'GET').catch(() => [])
                _trendTypeNames = {}
                ;(Array.isArray(arr) ? arr : []).forEach(t => { _trendTypeNames[t.id] = t.name })
            }
            _rankFillTypes()   // ตัวเลือก type ของ Top Users ใช้รายชื่อชุดเดียวกัน
            const from = new Date(prev[0] + 'T00:00:00.000Z').toISOString()
            const to   = new Date(cur[cur.length - 1] + 'T23:59:59.999Z').toISOString()
            const data = await api(`/transaction/stock-transactions/summary?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`, 'GET')
            if (myToken !== _trendToken) return

            // daily[ชื่อ type][วันที่] — ไว้วาดเส้นที่ 2 ตาม type ที่เลือกใน By Type (ค่าเริ่มต้น Receive) โดยไม่ต้องโหลดใหม่
            const all = {}, daily = {}, byType = {}, prevSet = new Set(prev)
            cur.forEach(l => { all[l] = 0 })
            let prevTotal = 0
            ;(Array.isArray(data?.dailySummary) ? data.dailySummary : []).forEach(r => {
                const c = r.transactionCount || 0
                const name = _trendTypeNames[r.transactionType] || String(r.transactionType)
                if (r.date in all) {
                    all[r.date] += c
                    ;(daily[name] ||= {})[r.date] = (daily[name][r.date] || 0) + c
                    byType[name] = (byType[name] || 0) + c
                } else if (prevSet.has(r.date)) {
                    prevTotal += c
                }
            })
            const total = cur.reduce((s, l) => s + all[l], 0)
            _trendData = { labels: cur, all, daily, byType, total }
            if (_trendSel && !byType[_trendSel]) _trendSel = null   // type ที่เลือกไว้ไม่มีในช่วงใหม่ → กลับเป็นค่าเริ่มต้น
            _trendApplySel()
            document.getElementById('trendTotal').textContent = total.toLocaleString()
            renderStatDelta('trendDelta', total, prevTotal)
            document.getElementById('trendRangeLbl').textContent =
                `${_trendDayLabel(cur[0], false)} – ${_trendDayLabel(cur[cur.length - 1], false)}`
            renderTrendChart()
            renderTrendTypes()
        } catch (err) {
            console.error('loadTrend:', err)
            if (myToken !== _trendToken) return
            msg.innerHTML = `<div class="trend-empty">${dashDict().trendLoadFailed}</div>`
            document.getElementById('trendTypeList').innerHTML = ''
        }
    }

    // กราฟเส้น 2 เส้น (ทั้งหมด = area + เส้นทึบ / Receive = เส้นประ) — วาดตามความกว้างจริงของกล่อง (1 หน่วย SVG = 1px)
    // ค่าเริ่มต้นชี้ที่วันล่าสุด (เหมือน "Jun" ในดีไซน์) — hover/แตะ เลื่อนดูวันอื่นได้
    function renderTrendChart() {
        const wrap = document.getElementById('trendChart')
        if (!_trendData || !wrap) return
        const { labels, all, daily } = _trendData
        // เส้นที่ 2 = type ที่เลือกใน By Type หรือ Receive ถ้ายังไม่ได้เลือก (ตัวแปรชื่อ rcv คงไว้จากเดิม)
        const s2Name = _trendS2Name()
        const rcv = Object.fromEntries(labels.map(l => [l, daily[s2Name]?.[l] || 0]))
        const n = labels.length
        const cs = getComputedStyle(wrap)
        const W = Math.max(wrap.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight), 280), H = 240
        const P = { top: 40, right: 14, bottom: 30, left: 40 }
        const CW = W - P.left - P.right, CH = H - P.top - P.bottom
        const max = _trendNiceMax(Math.max(...labels.map(l => all[l]), 1))
        const X = i => P.left + (n === 1 ? CW / 2 : i / (n - 1) * CW)
        const Y = v => P.top + (1 - v / max) * CH
        const ptsAll = labels.map((l, i) => ({ x: +X(i).toFixed(1), y: +Y(all[l]).toFixed(1) }))
        const ptsRcv = labels.map((l, i) => ({ x: +X(i).toFixed(1), y: +Y(rcv[l]).toFixed(1) }))
        const base = P.top + CH

        let s = `<defs><linearGradient id="trArea" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" class="tr-stop" stop-opacity=".22"/><stop offset="1" class="tr-stop" stop-opacity="0"/>
                 </linearGradient></defs>`
        ;[0, .25, .5, .75, 1].forEach(f => {
            const v = Math.round(max * f), y = Y(v)
            s += `<line class="tr-grid" x1="${P.left}" x2="${W - P.right}" y1="${y}" y2="${y}"/>`
            s += `<text class="tr-ax" x="${P.left - 8}" y="${y + 4}" text-anchor="end">${_trendFmt(v)}</text>`
        })
        const lineAll = _trendSmooth(ptsAll)
        s += `<path d="${lineAll} L${ptsAll[n - 1].x},${base} L${ptsAll[0].x},${base} Z" fill="url(#trArea)"/>`
        s += `<path class="tr-line-rcv" d="${_trendSmooth(ptsRcv)}"/>`
        s += `<path class="tr-line-all" d="${lineAll}"/>`

        // ป้ายแกน X — ≤7 วันโชว์ชื่อวันทุกจุด / ยาวกว่านั้นเว้นระยะ (โชว์จุดสุดท้ายเสมอ)
        const short = n <= 7, step = short ? 1 : Math.ceil(n / 8)
        labels.forEach((l, i) => {
            if (i % step && i !== n - 1) return
            if (!short && i !== n - 1 && n - 1 - i < step) return   // กันป้ายชนกับป้ายวันสุดท้าย
            s += `<text class="tr-ax tr-xl" data-i="${i}" x="${X(i)}" y="${H - 8}" text-anchor="middle">${_trendDayLabel(l, short)}</text>`
        })
        s += `<g id="trHover"><line class="tr-vline" x1="0" x2="0" y1="${P.top - 4}" y2="${base}"/>
                <circle class="tr-dot-rcv" r="4.5"/><circle class="tr-dot-all" r="5.5"/>
                <rect class="tr-xpill" height="20" rx="10"/><text class="tr-xpill-t" text-anchor="middle"></text></g>`
        s += `<rect class="tr-hit" x="${P.left - 10}" y="0" width="${CW + 20}" height="${H}"/>`

        wrap.innerHTML = `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" role="img"
                              aria-label="${dashDict().trendTitle}">${s}</svg><div class="tr-tip" id="trTip"></div>`

        const svg = wrap.querySelector('svg')
        const show = i => {
            const x = X(i), l = labels[i]
            const g = svg.querySelector('#trHover')
            g.querySelector('.tr-vline').setAttribute('x1', x); g.querySelector('.tr-vline').setAttribute('x2', x)
            const da = g.querySelector('.tr-dot-all'), dr = g.querySelector('.tr-dot-rcv')
            da.setAttribute('cx', x); da.setAttribute('cy', ptsAll[i].y)
            dr.setAttribute('cx', x); dr.setAttribute('cy', ptsRcv[i].y)
            const txt = _trendDayLabel(l, short), pw = Math.max(40, txt.length * 7 + 16)
            const pill = g.querySelector('.tr-xpill'), pt = g.querySelector('.tr-xpill-t')
            pill.setAttribute('x', x - pw / 2); pill.setAttribute('y', H - 23); pill.setAttribute('width', pw)
            pt.setAttribute('x', x); pt.setAttribute('y', H - 9); pt.textContent = txt
            svg.querySelectorAll('.tr-xl').forEach(t => t.style.visibility = Number(t.dataset.i) === i ? 'hidden' : '')
            const tip = document.getElementById('trTip')
            tip.innerHTML = `<span title="${dashDict().trendAll}">${all[l].toLocaleString()}</span>` +
                            `<span class="rcv" title="${_trendS2Label()}">${rcv[l].toLocaleString()}</span>`
            // กัน tooltip ล้นขอบซ้าย/ขวาของกล่อง
            const padL = parseFloat(cs.paddingLeft)
            const half = tip.offsetWidth / 2, left = Math.min(Math.max(x + padL, half + 4), W + padL - half)
            tip.style.left = left + 'px'
        }
        const pick = e => {
            const r = svg.getBoundingClientRect()
            const mx = (e.touches ? e.touches[0].clientX : e.clientX) - r.left
            show(Math.max(0, Math.min(n - 1, Math.round((mx - P.left) / (n === 1 ? 1 : CW / (n - 1))))))
        }
        const hit = svg.querySelector('.tr-hit')
        hit.addEventListener('mousemove', pick)
        hit.addEventListener('touchstart', pick, { passive: true })
        hit.addEventListener('mouseleave', () => show(n - 1))
        show(n - 1)
    }

    // การ์ดขวา: จำนวนต่อประเภทในช่วงเดียวกัน เรียงมาก → น้อย / สี+ไอคอนจาก transactionTypeMeta.js (ชุดเดียวกับ badge ทั้งแอป)
    // แสดง 5 อันดับแรก ที่เหลือหุบไว้ — ปุ่ม See more / Show less (_trendTypesOpen)
    // แผง By Type ในการ์ดกราฟ — หุบไว้เป็นค่าเริ่มต้น กดปุ่ม "By Type" ที่หัวการ์ดเพื่อเลื่อนออก/หุบกลับ (จำสถานะต่อเบราว์เซอร์)
    const TREND_SIDE_KEY = 'sf_dash_trend_side_open'
    function setTrendSide(open) {
        document.getElementById('trendCard')?.classList.toggle('side-open', open)
        document.getElementById('trendSideBtn')?.setAttribute('aria-expanded', String(open))
    }
    function toggleTrendSide() {
        const open = !document.getElementById('trendCard').classList.contains('side-open')
        setTrendSide(open)
        try { localStorage.setItem(TREND_SIDE_KEY, open ? '1' : '0') } catch (_) {}
    }
    try { setTrendSide(localStorage.getItem(TREND_SIDE_KEY) === '1') } catch (_) { setTrendSide(false) }

    const TREND_TYPES_SHOWN = 5
    let _trendTypesOpen = false
    function toggleTrendTypes() { _trendTypesOpen = !_trendTypesOpen; renderTrendTypes() }

    // กดแถวใน By Type → เส้นที่ 2 ของกราฟ (เส้นประ) แสดง type นั้นด้วยสีของ type / กดซ้ำ → กลับเป็น Receive
    let _trendSel = null
    function _trendS2Name() {
        if (_trendSel) return _trendSel
        return Object.keys(_trendData?.daily || {}).find(n => n.toLowerCase() === 'receive') || 'Receive'
    }
    function _trendS2Label() { return _trendSel ? sessDisplayType(_trendSel) : dashDict().trendReceive }
    function _trendApplySel() {
        const row = document.querySelector('.trend-row')
        if (_trendSel) row.style.setProperty('--s2', txTypeMeta(_trendSel).color)
        else row.style.removeProperty('--s2')   // กลับไปใช้สีตามธีม (navy / sky)
        const lbl = document.getElementById('trendS2Label')
        lbl.textContent = _trendS2Label()
        lbl.removeAttribute('data-i18n')        // ชื่อ type ไม่ต้องแปล — applyDataI18n จะได้ไม่ทับกลับเป็น "Receive"
        if (!_trendSel) lbl.setAttribute('data-i18n', 'trendReceive')
    }
    function selectTrendType(name) {
        _trendSel = _trendSel === name ? null : name
        _trendApplySel()
        renderTrendChart()
        renderTrendTypes()
    }
    function renderTrendTypes() {
        const box = document.getElementById('trendTypeList')
        if (!_trendData || !box) return
        const { byType, total } = _trendData
        const rows = Object.entries(byType).filter(([, c]) => c > 0).sort((a, b) => b[1] - a[1])
        if (!rows.length) { box.innerHTML = `<div class="trend-empty" style="height:120px">${dashDict().trendNoData}</div>`; return }
        const hidden = rows.length - TREND_TYPES_SHOWN
        const more = hidden > 0
            ? `<button type="button" class="tt-more" onclick="toggleTrendTypes()" aria-expanded="${_trendTypesOpen}">
                   ${_trendTypesOpen ? dashDict().showLess : `${dashDict().seeMore} (+${hidden})`}
                   <i class="bi bi-chevron-${_trendTypesOpen ? 'up' : 'down'}"></i>
               </button>`
            : ''
        box.innerHTML = rows.slice(0, _trendTypesOpen ? rows.length : TREND_TYPES_SHOWN).map(([name, c]) => {
            const m = txTypeMeta(name), pct = total ? Math.round(c / total * 100) : 0
            const on = _trendSel === name
            const nameArg = name.replace(/\\/g, '\\\\').replace(/'/g, "\\'")
            return `<div class="tt-row tt-pick${on ? ' on' : ''}" role="button" tabindex="0" aria-pressed="${on}"
                         style="--tc:${m.color}" title="${dashDict().trendPickHint}"
                         onclick="selectTrendType('${nameArg}')"
                         onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectTrendType('${nameArg}')}">
                <span class="tt-ico" style="background:${m.color}1a">${txTypeIcon(name, 16)}</span>
                <div style="min-width:0">
                    <div class="tt-name">${sessDisplayType(name)}</div>
                    <div class="tt-bar"><i style="width:${pct}%;background:${m.color}"></i></div>
                </div>
                <div class="tt-num">${c.toLocaleString()}<small>${pct}%</small></div>
            </div>`
        }).join('') + more
    }

    // ── TOP USERS ─────────────────────────────────────────────────────────────────────────────────────────────
    // GET /transaction/ranking?from&to[&transactionType=<id>] → [{ performedBy, transactionType, transactionCount, totalQuantity, rank }]
    // ไม่เลือก type → backend คืนแยกแถวต่อ (user, type) และ rank เริ่มใหม่ทุก type → รวมยอดต่อ user เองแล้วจัดอันดับใหม่
    // (แบบเดียวกับ leaderboard หน้า Transactions) / ช่วงเวลา = ช่วงเดียวกับกราฟ (_trendDays, วันแบบ UTC เหมือนกัน)
    const RANK_SHOWN = 5, RANK_MAX = 10
    let _rankToken = 0, _rankOpen = false, _rankRows = []
    const _rankMe = (() => { try { return String(JSON.parse(localStorage.getItem('user') || '{}').username || '') } catch (_) { return '' } })()

    function _rankFillTypes() {
        const sel = document.getElementById('rankType')
        if (!sel || sel.options.length > 1 || !_trendTypeNames) return
        Object.entries(_trendTypeNames).forEach(([id, name]) => sel.add(new Option(sessDisplayType(name), id)))
    }
    function toggleRankMore() { _rankOpen = !_rankOpen; renderRanking() }

    async function loadRanking() {
        const myToken = ++_rankToken
        const cur  = _trendLabels(_trendDays)
        const type = document.getElementById('rankType').value
        const qs = new URLSearchParams({
            from: new Date(cur[0] + 'T00:00:00.000Z').toISOString(),
            to:   new Date(cur[cur.length - 1] + 'T23:59:59.999Z').toISOString(),
        })
        if (type) qs.set('transactionType', type)
        document.getElementById('rankRangeLbl').textContent = `${_trendDayLabel(cur[0], false)} – ${_trendDayLabel(cur[cur.length - 1], false)}`
        document.getElementById('rankList').innerHTML = `<div class="trend-empty" style="height:160px">Loading…</div>`
        try {
            const rows = await api(`/transaction/ranking?${qs}`, 'GET')
            if (myToken !== _rankToken) return
            const byUser = {}
            ;(Array.isArray(rows) ? rows : []).forEach(r => {
                if (!r.performedBy) return
                const u = (byUser[r.performedBy] ||= { id: String(r.performedBy), cnt: 0, qty: 0 })
                u.cnt += r.transactionCount || 0
                u.qty += r.totalQuantity || 0
            })
            _rankRows = Object.values(byUser).sort((a, b) => b.cnt - a.cnt || b.qty - a.qty).slice(0, RANK_MAX)
            renderRanking()
        } catch (err) {
            console.error('loadRanking:', err)
            if (myToken === _rankToken)
                document.getElementById('rankList').innerHTML = `<div class="trend-empty" style="height:160px">${dashDict().trendLoadFailed}</div>`
        }
    }

    function renderRanking() {
        const box = document.getElementById('rankList')
        const dict = dashDict()
        if (!_rankRows.length) { box.innerHTML = `<div class="trend-empty" style="height:160px">${dict.trendNoData}</div>`; return }
        const top = _rankRows[0].cnt || 1
        const rows = _rankRows.slice(0, _rankOpen ? RANK_MAX : RANK_SHOWN)
        const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
        // วงกลมหน้าแถว = ไอคอน avatar ชั่วคราว — มี API รูปพนักงานเมื่อไหร่ เปลี่ยน <i> เป็น <img> ใน .rk-av ได้เลย (CSS รองรับแล้ว)
        box.innerHTML = rows.map((u, i) => {
            const rank = i + 1, me = _rankMe && u.id === _rankMe
            return `<div class="rk-row${me ? ' me' : ''}">
                <span class="rk-no${rank <= 3 ? ' r' + rank : ''}">${rank}</span>
                <div class="rk-user">
                    <span class="rk-av" aria-hidden="true"><i class="bi bi-person-fill"></i></span>
                    <div style="min-width:0;flex:1">
                        <span class="rk-id">${esc(u.id)}</span>${me ? `<span class="rk-you">${dict.rankYou}</span>` : ''}
                        <div class="rk-bar"><i style="width:${Math.round(u.cnt / top * 100)}%"></i></div>
                    </div>
                </div>
                <div class="rk-num">${u.cnt.toLocaleString()}<small>${u.qty.toLocaleString()} ${dict.rankQty}</small></div>
            </div>`
        }).join('') + (_rankRows.length > RANK_SHOWN
            ? `<button type="button" class="tt-more" onclick="toggleRankMore()" aria-expanded="${_rankOpen}">
                   ${_rankOpen ? dict.showLess : `${dict.seeMore} (+${_rankRows.length - RANK_SHOWN})`}
                   <i class="bi bi-chevron-${_rankOpen ? 'up' : 'down'}"></i>
               </button>`
            : '')
    }

    // วาดกราฟใหม่ทุกครั้งที่ "กล่องกราฟ" เปลี่ยนความกว้าง (ไม่ใช่แค่ window resize) — layout รอบแรกยังไม่นิ่ง (sidebar/ฟอนต์/scrollbar)
    // ทำให้วัดความกว้างพลาดแล้วกราฟล้นขอบขวาได้ ResizeObserver จับได้ทุกกรณี
    let _trendResizeRaf = 0, _trendLastW = 0
    new ResizeObserver(entries => {
        const w = Math.round(entries[0].contentRect.width)
        if (w === _trendLastW) return
        _trendLastW = w
        cancelAnimationFrame(_trendResizeRaf)
        _trendResizeRaf = requestAnimationFrame(renderTrendChart)
    }).observe(document.getElementById('trendChart'))

    // ── Load real item types from API, then fetch stats for each ──
    async function loadItemTypes() {
        try {
            const types = await api('/master/items/item-type', 'GET');
            _allItemTypes = (types || []).map(t => t.name).filter(Boolean);
            // sync MAIN_TYPES ให้ตรงกับ type จริงที่ระบบมี (ตามที่ขอ ใช้ /master/items/item-type เป็น source of truth) —
            // "Other" ใน renderTableHTML()/renderCards() ต้องอิงลิสต์นี้ ไม่ใช่ค่า hardcode เดิมที่ผิด
            if (_allItemTypes.length) MAIN_TYPES = [..._allItemTypes]
        } catch (e) {
            console.warn('loadItemTypes:', e);
            _allItemTypes = Object.keys(TYPE_CONFIG);
        }
        if (_allItemTypes.length) fetchTypeStats(_allItemTypes);
    }

    // -- Real-time Transactions widget: render session-summary rows (get-session ให้แค่ sessionNo/type/createdBy/createdAt/transactionCount/lots[]
    // ไม่มี partNo/workOrder/qty ต่อ transaction ตรงๆ — เลยแสดงเป็นแถวสรุประดับ session แทนแถวต่อ transaction ไม่ต้องยิง API เพิ่มต่อ lot)
    function fmtSessTime(d) {
        if (!d) return '—'
        return new Date(d).toLocaleString('th-TH-u-ca-gregory', { dateStyle: 'short', timeStyle: 'medium' })
    }
    // im.imageUrl มักเป็น null ใน payload ของ get-session/SignalR (ต่างจาก transaction list ปกติที่มี imageUrl ตรงๆ)
    // เลย fallback ไป im.filePath แทน — ยังไม่ยืนยัน 100% ว่า CONFIG.INVENTORY_API + filePath คือ URL ที่ถูกต้อง ต้องเช็คกับ backend
    function sessImgCell(images) {
        const urls = (images || []).map(im => CONFIG.INVENTORY_API + '/uploads/' + (im.imageUrl || im.filePath).replace(/^\/+/, ''))
        if (!urls.length) return `<span style="color:var(--t3)">—</span>`
        return `<div class="sess-thumb-wrap">
            <img src="${urls[0]}" class="sess-thumb" onclick="event.stopPropagation();openLightbox('${urls[0]}')"
                 onerror="this.onclick=null;this.style.cursor='default';this.src='${NO_IMG_ICON}'">
            ${urls.length > 1 ? `<span class="sess-thumb-badge">+${urls.length - 1}</span>` : ''}
        </div>`
    }
    // sessionType "ReLocation" ที่ backend ส่งมา ไม่มี key ตรงกันใน TX_TYPE_META (transactionTypeMeta.js) — โชว์เป็น "Move" แทนให้ตรงกับคำที่ใช้ทั้งแอป
    function sessDisplayType(t) {
        return t === 'ReLocation' ? 'Move' : t
    }
    // get-session ไม่มี fromLocation/toLocation มาให้ตรงๆ (มีแค่ lots[] ที่ id+lotNo) ต้องยิง /transaction/get แยก
    // กรองด้วย sessionNo เอาเอง (N+1 ต่อ session — รับได้เพราะ widget นี้โชว์แค่ 5-10 session ไม่ใช่ทั้งตาราง)
    // ผลเก็บไว้ใน s._fromLocation/_toLocation/_locMixed เพื่อให้ sessionRowHtml() ยังเป็น sync function เหมือนเดิม
    async function enrichSessionLocation(s) {
        try {
            // บาง sessionType (เช่น "Void" — เจอจากหน้า Transactions.cshtml เต็มว่า Void ไม่มี Session No จริง โชว์เป็น "—" ทุกแถว)
            // ไม่มี sessionNo จริงเลย — ถ้ายิง /transaction/get ไปพร้อม sessionNo ว่าง/null backend ดูเหมือนจะไม่กรองอะไรเลย
            // (คืน transaction ล่าสุดของทั้งระบบมาแทน ไม่ใช่ของ session นี้) ทำให้ sub-table โชว์รายการที่ไม่เกี่ยวข้องเลย —
            // เช็คก่อนเลยว่ามี sessionNo จริงไหม ไม่มีก็ไม่ต้องยิง fetch เลย (ปล่อยว่างไปดีกว่าโชว์ข้อมูลผิดๆ)
            if (!s.sessionNo) {
                s._txns = []; s._workOrders = []; s._lines = []; s._partNos = []
                s._fromLocation = null; s._toLocation = null; s._locMixed = false; s._locCount = 0
                return
            }
            const res     = await api('/transaction/get', 'POST', { sessionNo: s.sessionNo, page: 1, pageSize: 20 })
            const rawTxns = res?.data || []
            // กันเผื่ออีกชั้น แม้มี sessionNo จริงส่งไปแล้วก็ตาม — ไม่เชื่อว่า backend กรองมาให้ถูกเสมอ เอาแค่ record ที่ sessionNo
            // ตรงกับที่ขอเป๊ะๆ เท่านั้น (ถ้า backend เคยกรองผิดพลาดแบบ Void ด้านบน จะได้ไม่หลุดมาโชว์ผิด session)
            const txns = rawTxns.filter(t => t.sessionNo === s.sessionNo)
            s._txns = txns   // เก็บ transaction เต็มๆ ของ session นี้ไว้ ใช้วาด sub-table ตอนกดขยายแถว (sessSubRowHtml) ไม่ต้องยิง fetch ซ้ำ
            const fromSet = new Set(txns.map(t => t.fromLocation).filter(Boolean))
            const toSet   = new Set(txns.map(t => t.toLocation).filter(Boolean))
            s._fromLocation = fromSet.size === 1 ? [...fromSet][0] : null
            s._toLocation   = toSet.size   === 1 ? [...toSet][0]   : null
            s._locMixed     = fromSet.size > 1 || toSet.size > 1
            s._locCount     = Math.max(fromSet.size, toSet.size)
            // เก็บ WO ที่ transaction ใน session นี้แตะไว้ด้วย — เผื่อ caller อยากรีเฟรช WO นั้น (เช่น session นี้อาจ Receive เข้า
            // location Production แล้วเปลี่ยนยอด OnHand ที่ Time_to_Stockout ของ Line Status Board ใช้อยู่) ไม่ต้องยิง fetch ซ้ำ
            // ใช้ txns ก้อนเดียวกับที่ดึงมาแล้วด้านบนเลย
            s._workOrders = [...new Set(txns.map(t => t.workOrder).filter(Boolean))]
            // transaction record เองไม่มี field lineName ให้ (เช็คจาก sample จริงแล้ว) — ต้องเอา workOrder ไปหา lineName จาก
            // GET /workorder?WorkOrder=... แทน (fetchWorkOrderDetail() ฟังก์ชันเดียวกับที่ใช้รีเฟรช Line Status Board นั่นแหละ
            // response มี lineName ติดมาด้วยอยู่แล้ว) — ปกติ session นึงมักมีแค่ 1 WO เลยยิงไม่กี่ครั้ง
            const woDetails = await Promise.all(s._workOrders.map(fetchWorkOrderDetail))
            s._lines = [...new Set(woDetails.map(w => w?.lineName).filter(Boolean))]
            // Part No./Name แทนที่ Session No เดิมในคอลัมน์สรุป (ตามที่ขอ) — ต้อง fetch ชื่อ Part ล่วงหน้าตรงนี้เลย (ไม่ใช่ lazy
            // ตอนกดขยายเหมือน sub-table) เพราะ sessionRowHtml() เป็น sync function ต้องมีชื่อพร้อมใช้ตอน render แถวสรุปทันที
            s._partNos = [...new Set(txns.map(t => t.itemPartNo).filter(Boolean))]
            await fetchItemNames(s._partNos)
        } catch (_) {
            s._locError = true
            s._workOrders = []
            s._lines = []
            s._txns = []
            s._partNos = []
        }
    }
    // locTypeBadge(typeName) ของ locationTypeMeta.js รับ "location type" (warehouse/wip/production/...) ไม่ใช่ location code
    // ต้อง lookup master location เองก่อน (เอา pattern เดียวกับ locTypeBadge(code) ที่ override ไว้ใน Transactions.cshtml)
    let _dashLocations = []
    async function loadDashLocations() {
        try {
            const res  = await api('/location?page=1&pageSize=100', 'GET')
            const total = res.total, pgSize = res.pageSize
            const round = total / pgSize
            let arr = res.data || []
            for (let i = 1; i < round; i++) {
                const batch = await api(`/location?page=${i + 1}&pageSize=100`, 'GET')
                arr.push(...(batch.data || []))
            }
            _dashLocations = arr
            locPickRenderLabel()   // ชื่อ location ที่ restore มา (ตอนแรกรู้แค่ code)
        } catch (err) {
            console.warn('loadDashLocations:', err)
        }
    }
    function sessLocTypeBadge(code) {
        if (!code) return ''
        const found = _dashLocations.find(item => item.locationCode === code)
        const name  = found?.displayName ?? found?.locationCode ?? code
        const type  = found?.typeName ?? found?.type ?? ''
        return `<span class="loc-type-badge" style="${locTypeBadgeStyle(type)}">${locHierTypeIcon(type)}${name}</span>`
    }
    function sessLocationCell(s) {
        if (s._locError) return `<span style="color:var(--t3)">—</span>`
        if (s._locMixed) return `<span class="sess-badge" style="background:#f0f2f5;color:#475569">${s._locCount} locations</span>`
        if (!s._fromLocation && !s._toLocation) return `<span style="color:var(--t3)">—</span>`
        const from = sessLocTypeBadge(s._fromLocation)
        const to   = sessLocTypeBadge(s._toLocation)
        return `<div style="display:flex;align-items:center;gap:6px">${from}${s._fromLocation && s._toLocation ? '<i class="bi bi-arrow-right" style="color:var(--t3);font-size:11px"></i>' : ''}${to}</div>`
    }
    // ── ดึงชื่อ Part จาก /master/items ต่อ partNo (cache ไว้กันยิงซ้ำ — เอา pattern เดียวกับ Transactions.cshtml) ──
    let _dashItemNameCache = new Map()
    async function fetchItemNames(partNos) {
        const missing = [...new Set(partNos.filter(Boolean))].filter(p => !_dashItemNameCache.has(p))
        if (!missing.length) return
        await Promise.all(missing.map(async p => {
            try {
                // /master/items?PartNo=...&Page=1&PageSize=1 (list-search endpoint) ไม่คืนชื่อมาตรงๆ ตามที่ควร — ใช้
                // GET /master/item/{partNo} (เอกพจน์, path param ตรงๆ) แทน ซึ่งคืน { exists, description, unit } ตรงตัว
                const res = await api(`/master/item/${encodeURIComponent(p)}`, 'GET')
                _dashItemNameCache.set(p, res?.exists ? (res?.description ?? null) : null)
            } catch (_) { _dashItemNameCache.set(p, null) }
        }))
    }
    // ── แถวย่อยของ transaction เดี่ยวๆ ในตาราง sub-table ตอนกดขยาย session (เอา pattern เดียวกับ txSubRowHtml ของ Transactions.cshtml) ──
    function sessSubRowHtml(x) {
        const locHtml = (x.fromLocation || x.toLocation)
            ? `<div style="display:flex;align-items:center;gap:6px">${sessLocTypeBadge(x.fromLocation)}${x.fromLocation && x.toLocation ? '<i class="bi bi-arrow-right" style="color:var(--t3);font-size:11px"></i>' : ''}${sessLocTypeBadge(x.toLocation)}</div>`
            : `<span style="color:var(--t3)">—</span>`
        return `<tr>
            <td>${txTypeBadge(x.transactionType)}</td>
            <td><span class="sess-mono">${x.itemPartNo ?? '—'}</span></td>
            <td style="color:var(--t2)">${x.itemPartNo ? (_dashItemNameCache.get(x.itemPartNo) ?? '—') : '—'}</td>
            <td style="color:var(--t2);font-size:12px">${x.workOrder ?? '—'}</td>
            <td><span class="sess-mono">${x.lotNo ?? '—'}</span></td>
            <td>${locHtml}</td>
            <td>${x.quantity ?? '—'}</td>
            <td style="color:var(--navy);font-weight:500">${x.performedBy ?? '—'}</td>
        </tr>`
    }
    // ── กดขยาย session row ดู transaction ย่อยทั้งหมด — s._txns มาจาก enrichSessionLocation() ที่ยิงไปแล้วตั้งแต่โหลดแถวสรุป
    // (ไม่ต้อง fetch ซ้ำ) เหลือแค่ดึงชื่อ Part เพิ่มตอนเปิดครั้งแรกเท่านั้น (lazy — ไม่ดึงถ้าไม่มีใครกดขยายดู) ──
    async function toggleSessRow(key, sessionNo) {
        const content = document.getElementById(key)
        const btn     = document.getElementById('btn_' + key)
        if (!content || !btn) return
        const isOpen = content.classList.contains('expanded')
        if (!isOpen && !content.dataset.loaded) {
            const s = _sessBySessionNo.get(sessionNo)
            const txns = s?._txns ?? []
            await fetchItemNames(txns.map(x => x.itemPartNo))
            const tbody = content.querySelector('tbody')
            if (tbody) tbody.innerHTML = txns.length ? txns.map(sessSubRowHtml).join('') : `<tr><td colspan="8" class="rt-empty">No transactions</td></tr>`
            content.dataset.loaded = '1'
        }
        content.classList.toggle('expanded', !isOpen)
        btn.classList.toggle('open', !isOpen)
    }
    // เก็บ session object ล่าสุดไว้ต่อ sessionNo (มี ._txns ติดมาด้วยจาก enrichSessionLocation) ให้ toggleSessRow() หยิบไปใช้ได้
    // โดยไม่ต้อง fetch ซ้ำ — key ตรงกับ data-session ของแถว
    let _sessBySessionNo = new Map()
    // Part No./Name ของแถวสรุป — session เดียวอาจมีหลาย part ปนกัน (เช่น session Move ที่ลากหลาย lot คนละ part มาด้วยกัน)
    // มี part เดียวก็โชว์ตรงๆ ได้เลย ถ้ามีมากกว่า 1 โชว์ badge "N parts" แทน (เอา pattern เดียวกับ sessionGroupHtml ของ
    // Transactions.cshtml ที่ mixed-badge เวลาข้อมูลในกลุ่มไม่ตรงกันหมด)
    function sessPartCell(s) {
        const partNos = s._partNos || []
        if (!partNos.length) return `<span style="color:var(--t3)">—</span>`
        if (partNos.length > 1) return `<span class="sess-badge" style="background:#f0f2f5;color:#475569">${partNos.length} parts</span>`
        return `<span class="sess-mono">${partNos[0]}</span>`
    }
    function sessNameCell(s) {
        const partNos = s._partNos || []
        if (partNos.length !== 1) return `<span style="color:var(--t3)">—</span>`
        return `<span style="color:var(--t2)">${_dashItemNameCache.get(partNos[0]) ?? '—'}</span>`
    }
    // Work Order — s._workOrders มาจาก enrichSessionLocation() อยู่แล้ว (เก็บไว้เผื่อรีเฟรช Line Status Board ด้วย) ใช้ pattern
    // เดียวกับ sessPartCell (single WO โชว์ตรงๆ, หลาย WO ปนกันโชว์ badge "N WOs")
    function sessWorkOrderCell(s) {
        const wos = s._workOrders || []
        if (!wos.length) return `<span style="color:var(--t3)">—</span>`
        if (wos.length > 1) return `<span class="sess-badge" style="background:#f0f2f5;color:#475569">${wos.length} WOs</span>`
        return `<span style="color:var(--t2);font-size:12px">${wos[0]}</span>`
    }
    // Line — s._lines มาจาก enrichSessionLocation() (lineName ของ WO ที่เกี่ยวข้อง ไม่ใช่ field บน transaction เอง) ใช้ pattern เดียวกับ sessWorkOrderCell
    function sessLineCell(s) {
        const lines = s._lines || []
        if (!lines.length) return `<span style="color:var(--t3)">—</span>`
        if (lines.length > 1) return `<span class="sess-badge" style="background:#f0f2f5;color:#475569">${lines.length} lines</span>`
        return `<span style="color:var(--t2);font-size:12px">${lines[0]}</span>`
    }
    // ตาราง live แบบครึ่งจอ — ข้อมูลรองเป็นบรรทัดเล็กใต้ค่าหลักในช่องเดียวกัน (ชื่อ part ใต้ Part, Line · WO ใต้ Location, เวลาใต้ By)
    function _liveSub(text) {
        return text ? `<div class="lv-sub" title="${String(text).replace(/"/g, '&quot;')}">${text}</div>` : ''
    }
    function _liveMeta(s) {
        const many = (arr, unit) => !arr?.length ? '' : arr.length > 1 ? `${arr.length} ${unit}` : arr[0]
        return [many(s._lines, 'lines'), many(s._workOrders, 'WOs')].filter(Boolean).join(' · ')
    }
    function sessionRowHtml(s) {
        _sessBySessionNo.set(s.sessionNo, s)
        const key = 'sess_' + s.sessionNo.replace(/[^a-zA-Z0-9]/g, '')
        // session ที่ transactionCount = 0 = กดทำรายการแล้วแต่ไม่สำเร็จเลยสัก lot (backend สร้าง session + ยิง SignalR ก่อนประมวลผล lot)
        // ยังโชว์ไว้ให้เห็นว่ามีคนพยายามทำ แต่เป็นแถวสีจาง + badge ไม่สำเร็จ (หน้า Transactions ไม่มีแถวพวกนี้เพราะไม่มี transaction จริง)
        const failed = Number(s.transactionCount) === 0
        const dict = dashDict()
        const txnsCell = failed
            ? `<span class="sess-fail-badge" title="${dict.sessFailedTip}"><i class="bi bi-x-circle"></i> ${dict.sessFailed}</span>`
            : (s.transactionCount ?? '—')
        return `<tr class="sum-row${failed ? ' sess-failed' : ''}" data-session="${s.sessionNo}" onclick="toggleSessRow('${key}','${s.sessionNo}')">
            <td>
                <div style="display:flex;align-items:center;gap:8px">
                    <button class="expand-btn" id="btn_${key}">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
                    </button>
                    ${txTypeBadge(sessDisplayType(s.sessionType))}
                </div>
            </td>
            <td><div class="lv-main">${sessPartCell(s)}</div>${_liveSub(s._partNos?.length === 1 ? _dashItemNameCache.get(s._partNos[0]) : '')}</td>
            <td>${sessLocationCell(s)}${_liveSub(_liveMeta(s))}</td>
            <td><div class="lv-main lv-by">${s.createdBy ?? '—'}</div>${_liveSub(fmtSessTime(s.createdAt))}</td>
            <td style="text-align:center">${sessImgCell(s.images)}</td>
            <td class="sess-txns-cell" style="text-align:right">${txnsCell}</td>
        </tr>
        <tr class="sub-row">
            <td colspan="6">
                <div class="sub-content" id="${key}">
                    <div class="sub-inner">
                        <table class="sub-table">
                            <thead><tr>
                                <th>Type</th><th>Part No.</th><th>Name</th><th>Work Order</th><th>Lot</th><th>Location</th><th>Qty</th><th>By</th>
                            </tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </td>
        </tr>`
    }

    // -- push แถวใหม่จาก SignalR เข้า rtTxBody: session เดิม (sessionNo ซ้ำ — เช่น transactionCount เพิ่มขึ้น) ให้แทนที่แถวเดิม
    // ไม่ใช่ดันแถวใหม่ซ้อน, session ใหม่เอาขึ้นบนสุดเสมอ แล้วตัดให้เหลือแค่ RT_TX_MAX แถว กัน list ยาวเรื่อยๆ — เพิ่มจาก 5 เป็น 10
    // ตามที่ขอ (เลื่อนดูได้ 10 transaction, ให้ตรงกับ pageSize ที่ loadLastSessions() ดึงมาตอน bootstrap อยู่แล้วด้วย)
    const RT_TX_MAX = 10   // 10 session ล่าสุด — การ์ดสูงเท่าเดิม (ตาม Stock Summary ข้างๆ) เกินแล้ว scroll ในกล่อง
    async function upsertSessionRow(dto) {
        console.log("DTO : ", dto)
        await enrichSessionLocation(dto)

        const body = document.getElementById('rtTxBody')
        const placeholder = body.querySelector('.rt-empty')
        if (placeholder) placeholder.closest('tr').remove()

        // ลบทั้งคู่ (sum-row + sub-row ที่ตามติดกัน) ของ session เดิมถ้ามี — sessionRowHtml() คืนมา 2 <tr> ต่อ 1 session แล้ว
        // (สรุป + sub-table ที่ซ่อนไว้) ไม่ใช่แถวเดียวเหมือนเดิม ลบแค่ตัวแรกจะเหลือ sub-row ค้างเป็น orphan
        const existing = body.querySelector(`tr[data-session="${dto.sessionNo}"]`)
        if (existing) {
            const sub = existing.nextElementSibling
            if (sub && sub.classList.contains('sub-row')) sub.remove()
            existing.remove()
        }

        body.insertAdjacentHTML('afterbegin', sessionRowHtml(dto))

        // นับ/ตัดตาม "จำนวน session" (.sum-row) ไม่ใช่นับ <tr> ทั้งหมด เพราะ 1 session = 2 <tr> แล้ว (นับ <tr> ตรงๆ จะเหลือ
        // จริงแค่ RT_TX_MAX/2 session)
        Array.from(body.querySelectorAll('tr.sum-row')).slice(RT_TX_MAX).forEach(tr => {
            const sub = tr.nextElementSibling
            if (sub && sub.classList.contains('sub-row')) sub.remove()
            _sessBySessionNo.delete(tr.dataset.session)   // กัน Map โตไม่รู้จบถ้าเปิดจอทิ้งไว้นานๆ (แถวหลุดจาก DOM แล้วแต่ data ยังค้าง)
            tr.remove()
        })

        document.getElementById('rtTxUpdated').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-GB')

    }

    // -- Load Last 5 Transaction Sessions
    async function loadLastSessions() {
        try {
            const res = await api('/transaction/get-session', 'POST', {
                "page": 1,
                "pageSize": RT_TX_MAX
            });
            const sessions = res?.data || []
            await Promise.all(sessions.map(enrichSessionLocation))
            document.getElementById('rtTxBody').innerHTML = sessions.length
                ? sessions.map(sessionRowHtml).join('')
                : `<tr><td colspan="6" class="rt-empty">No recent sessions</td></tr>`
            document.getElementById('rtTxUpdated').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-GB')
        } catch (e) {
            console.warn('load Last 5 Sessions error :', e);
        }
    }

    // -- Real-time Work Orders widget
    // % On Hand / % FG Output มาจาก rate ที่ backend คำนวณมาให้แล้ว (totalOnHandRate / achievementRate) ไม่ต้องมาคิด num/den เอง
    function pctBar(rate, color) {
        if (rate == null) return `<span style="color:var(--t3)">—</span>`
        const clamped = Math.max(0, Math.min(100, rate))
        return `<div class="pct-bar-wrap">
            <div class="pct-bar-track"><div class="pct-bar-fill" style="width:${clamped}%;background:${color}"></div></div>
            <span class="pct-bar-label" style="color:${color}">${rate.toFixed(1)}%</span>
        </div>`
    }
    function workOrderRowHtml(wo) {
        return `<tr data-mo="${wo.moNumber}">
            <td><span class="wo-num">${wo.moNumber}</span></td>
            <td>${wo.lineName ?? '—'}</td>
            <td>${pctBar(wo.totalOnHandRate, 'var(--blue)')}</td>
            <td>${pctBar(wo.achievementRate, 'var(--green)')}</td>
            <td style="color:var(--t3);font-size:12px">${fmtSessTime(wo.updateAt)}</td>
        </tr>`
    }

    // SignalR "WorkOrdersChanged" ส่งมาแค่ closeDate/inputQty/lastSyncedAt/lineName/moNumber/modelName/outputQty/scrapQty/status/targetQty
    // ไม่มี totalOnHandRate/achievementRate/updateAt ที่ workOrderRowHtml() ต้องใช้ — เอา moNumber ไป search ใน GET /workorder แทนเพื่อได้ข้อมูลครบ
    async function fetchWorkOrderDetail(moNumber) {
        try {
            const res  = await api(`/workorder?Page=1&PageSize=1&WorkOrder=${encodeURIComponent(moNumber)}`, 'GET')
            const list = res?.data?.data || []
            // ตัด fallback ไปใช้ list[0] ทิ้ง — ถ้า filter ไม่ exact match เป๊ะ อาจได้ WO คนละตัวมาแปะทับ moNumber ที่ push มาแบบเงียบๆ
            return list.find(w => w.moNumber === moNumber) || null
        } catch (err) {
            console.warn('fetchWorkOrderDetail:', err)
            return null
        }
    }

    // -- push แถวใหม่จาก SignalR เข้า rtWoBody: MO เดิม (data-mo ซ้ำ) ให้แทนที่แถวเดิม ไม่ใช่ดันซ้อน, MO ที่เพิ่งเปลี่ยนเอาขึ้นบนสุดเสมอ
    // แล้วตัดให้เหลือแค่ RT_WO_MAX แถว กัน list ยาวเรื่อยๆ (เอา pattern เดียวกับ upsertSessionRow ของตาราง Transactions)
    const RT_WO_MAX = 10
    function upsertWorkOrderRow(wo) {
        const body = document.getElementById('rtWoBody')
        const placeholder = body.querySelector('.rt-empty')
        if (placeholder) placeholder.closest('tr').remove()

        const existing = body.querySelector(`tr[data-mo="${wo.moNumber}"]`)
        if (existing) existing.remove()

        body.insertAdjacentHTML('afterbegin', workOrderRowHtml(wo))

        Array.from(body.querySelectorAll('tr')).slice(RT_WO_MAX).forEach(tr => tr.remove())

        document.getElementById('rtWoUpdated').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-GB')
    }

    // -- Load Last 5 WorkOrder
    async function loadLastWorkorders() {
        try {
            const res = await api('/workorder?Page=1&PageSize=10&SortBy=updateAt&SortDir=desc', 'GET')
            const list = res?.data?.data || []
            document.getElementById('rtWoBody').innerHTML = list.length
                ? list.map(workOrderRowHtml).join('')
                : `<tr><td colspan="5" class="rt-empty">No recent work orders</td></tr>`
            document.getElementById('rtWoUpdated').textContent = 'Updated: ' + new Date().toLocaleTimeString('en-GB')
        } catch (err) {
            console.warn('load last 5 Workorders error : ', err)
        }
    }

    // ══════════════ LIVE VIEW (Transactions / Work Orders) + แท็บ 3D Layout ══════════════
    // Line Status Board ย้ายไปเป็นหน้าแยก Views/Inventory/LineDashboard.cshtml แล้ว
    // ตาราง live (Transactions / Work Orders) อยู่ในแถวแบ่งครึ่งข้าง Stock Summary แล้ว — สลับด้วยปุ่มในหัวการ์ดเอง ไม่ผ่านแท็บล่าง
    function switchLiveView(name) {
        document.getElementById('rtCardTx').style.display = name === 'tx' ? '' : 'none'
        document.getElementById('rtCardWo').style.display = name === 'wo' ? '' : 'none'
        document.querySelectorAll('.live-seg-btn').forEach(b => b.classList.toggle('active', b.dataset.live === name))
    }

    // 'tx' / 'wo' → switchLiveView (โค้ดเก่า) / '3d' → เลื่อนไปการ์ด 3D ข้าง Stock Summary (ไม่มีแท็บแล้ว การ์ดแสดงตลอด)
    function switchDashView(name) {
        if (name === 'tx' || name === 'wo') { switchLiveView(name); return }
        if (name === '3d') { document.getElementById('l3dCard')?.scrollIntoView({ behavior: 'smooth', block: 'center' }); ensureLayout3D() }
    }

    // 3D Layout โหลดแบบ lazy — ยังไม่ดึง three.js (~1.8MB) / ยิง API สต็อกต่อ location จนกว่าการ์ด 3D จะเลื่อนเข้ามาในจอครั้งแรก
    let _layout3dPromise = null
    function ensureLayout3D() {
        if (!_layout3dPromise) {
            // ต้องเป็น path relative กับ <base href="/wms/"> เหมือนไฟล์อื่นทั้งเว็บ — ห้ามใช้ Url.Content("~/...") (absolute ตาม PathBase)
            // เพราะตอน deploy หลัง reverse proxy ที่ตัด /wms ออก PathBase จะว่าง ได้ /js/layout3d.js ไปยิงที่ root แล้ว 404
            _layout3dPromise = import(new URL('.@Html.Raw(FileVersion.AddFileVersionToPath("", "/js/layout3d.js"))', document.baseURI).href)
                .then(() => window.Layout3D)
                .catch(err => { _layout3dPromise = null; console.error('Layout3D load failed', err); throw err })
        }
        return _layout3dPromise
    }
    // ชื่อ location บนผัง 3D = RE_xx / PR_xx / BR_xx (ดู ZONE ใน layout3d.js) — เช็คจากชื่อตัวเองหรือ parent ที่ไล่ขึ้นไป
    function dashLocOnLayout(code) {
        let loc = _dashLocations.find(l => l.locationCode === code), guard = 0
        while (loc && guard++ < 12) {
            if (/^(RE|PR|BR)[_\s-]?\d{2}$/i.test((loc.displayName || '').trim())) return true
            loc = loc.parentLocationId != null ? _dashLocations.find(l => l.id === loc.parentLocationId) : null
        }
        return false
    }
    async function openLayout3DAt(code) {
        document.getElementById('l3dCard')?.scrollIntoView({ behavior: 'smooth', block: 'center' })
        try { (await ensureLayout3D())?.focus(code) } catch (_) { }
    }
    // หุบ/แสดงแผงสรุปด้านขวาของผัง 3D — ผังขยายเต็มการ์ดตอนหุบ (layout3d.js มี ResizeObserver วาดใหม่ตามขนาดเอง)
    // ค่าเริ่มต้น = หุบแผง (ผังเต็มการ์ด) — key ใหม่ (_v2) ให้ทุกคนเริ่มแบบหุบ ไม่ติดค่าที่เคยเปิดค้างไว้จาก key เดิม
    const L3D_PANEL_KEY = 'sf_l3d_panel_collapsed_v2'
    function setL3dPanel(collapsed) {
        document.getElementById('l3dBody')?.classList.toggle('panel-collapsed', collapsed)
        const btn = document.getElementById('l3dPanelToggle')
        if (!btn) return
        btn.setAttribute('aria-expanded', String(!collapsed))
        btn.title = collapsed ? 'Show summary panel' : 'Hide summary panel'
        btn.querySelector('i').className = collapsed ? 'bi bi-chevron-left' : 'bi bi-layout-sidebar-inset-reverse'
    }
    function toggleL3dPanel() {
        const collapsed = !document.getElementById('l3dBody').classList.contains('panel-collapsed')
        setL3dPanel(collapsed)
        try { localStorage.setItem(L3D_PANEL_KEY, collapsed ? '1' : '0') } catch (_) {}
    }
    { let c = true; try { c = localStorage.getItem(L3D_PANEL_KEY) !== '0' } catch (_) {} setL3dPanel(c) }

    // โหลดผัง 3D เมื่อการ์ดเลื่อนเข้ามาในจอครั้งแรก (ไม่ดึง three.js ตอนเปิดหน้าถ้าผู้ใช้ไม่ได้เลื่อนลงมาดู)
    ;(function () {
        const card = document.getElementById('l3dCard')
        if (!card || !('IntersectionObserver' in window)) { ensureLayout3D(); return }
        const io = new IntersectionObserver(entries => {
            if (entries.some(e => e.isIntersecting)) { io.disconnect(); ensureLayout3D() }
        }, { rootMargin: '200px' })
        io.observe(card)
    })()

    // ── ภาษา (i18n) ── เรียกตอน init ครั้งแรก + ทุกครั้งที่กดปุ่มเปลี่ยนภาษาใน header (_Layout.cshtml เรียก window.onLangChange ให้เอง)
    // data-i18n ทั่วไปให้ applyDataI18n() (js/i18n.js) จัดการ — ส่วนที่เหลือคือข้อความที่ผสมเลข/ตัวแปรเข้าไปในสตริงเดียวกัน (เช่น "10 rows", "5 lots")
    // ซึ่ง data-i18n เฉยๆ ทำไม่ได้ ต้อง re-render ของส่วนนั้นใหม่เอง
    function applyDashboardLang() {
        const dict = dashDict()
        applyDataI18n(dict)
        window.Layout3D?.applyLang()

        document.querySelectorAll('#pageSize option').forEach(opt => { opt.textContent = opt.value + ' ' + dict.rows })

        locPickRenderLabel()   // ป้าย Location picker ("All Locations" ตามภาษา)
        if (_dashLotStatuses.length) _dashLotStatusRenderMenu()   // ชื่อ Lot Status ตามภาษา

        renderTypeCards()
        renderRows(lastRows)
        // กราฟ: ป้ายวัน/ช่วงวันที่เป็นภาษาปัจจุบัน
        _trendUpdateNote()
        if (_trendData) {
            const l = _trendData.labels
            document.getElementById('trendRangeLbl').textContent = `${_trendDayLabel(l[0], false)} – ${_trendDayLabel(l[l.length - 1], false)}`
            renderTrendChart()
            document.getElementById('rankRangeLbl').textContent = document.getElementById('trendRangeLbl').textContent
        }
        if (_rankRows.length) renderRanking()
    }
    window.onLangChange = applyDashboardLang

    // ── Init ──
    window.addEventListener("load", async function () {
        applyDashboardLang();
        initStockSearchAutocomplete();
        loadLocationTypes();
        loadLotStatusOptions();
        renderTypeCards();
        loadStock();
        loadAgedLots();
        loadTodayStats();
        loadTrend();
        loadRanking();
        loadItemTypes();
        await loadDashLocations()   // ต้องรอให้ _dashLocations โหลดเสร็จก่อน ไม่งั้น sessLocTypeBadge() ใน loadLastSessions() จะ map ไม่เจอ ขึ้น badge เปล่ารอบแรก
        loadLastSessions();
        loadLastWorkorders();
    });

    function openLightbox(src, caption) {
        document.getElementById('lightboxImg').src = src
        document.getElementById('lightbox').classList.add('show')
    }
    function closeLightbox() {
        document.getElementById('lightbox').classList.remove('show')
        document.getElementById('lightboxImg').src = ''
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox() })
</script>
}
