    .chk-nav-btn { width:32px; height:32px; border-radius:50%; border:1.5px solid var(--tint); background:#fff; color:var(--tint); font-size:16px; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; line-height:1; transition:.15s; }
    .chk-nav-btn:hover { background:var(--tint); color:#fff; }
