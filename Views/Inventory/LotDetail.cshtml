@{
    ViewData["Title"] = "Lot Detail";
}

<link rel="stylesheet" href="css/lotdetail.css"/>
<!-- @@font-face ของ ZebraFont (ใช้ตอน render barcode preview ผ่าน renderZplClient) — ประกาศไว้ที่ printqr.css ไฟล์เดียวกับ PrintQR.cshtml -->
<link rel="stylesheet" href="css/printqr.css"/>

<!-- PAGE HEADER -->
<div class="lot-header">
    <div class="lot-header-left">
        <h2 id="lotTitle">Loading…</h2>
        @* <p id="lotSubtitle">—</p> *@
    </div>
    <a href="Inventory/Lots" class="back-btn">← Back to Lots</a>
</div>

<!-- STAT CARDS -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--blue-lt);color:var(--blue)">OH</div>
        <div><div class="stat-num" id="sOnHand">—</div><div class="stat-lbl">On Hand</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--amber-lt);color:var(--amber)">RS</div>
        <div><div class="stat-num" id="sReserved">—</div><div class="stat-lbl">Reserved</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--green-lt);color:var(--green)">AV</div>
        <div><div class="stat-num" id="sAvailable">—</div><div class="stat-lbl">Available</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--red-lt);color:var(--red)">CS</div>
        <div><div class="stat-num" id="sConsumed">—</div><div class="stat-lbl">Consumed</div></div>
    </div>
</div>

<!-- MAIN LAYOUT -->
<div class="main-layout">

    <!-- LEFT: LOT INFO -->
    <div class="info-card">
        <img id="lotImg" class="info-img" src="" alt="">
        <div class="info-body">
            <div class="info-row">
                <span class="info-label">Lot No.</span>
                <span class="info-val" id="infoLotNo" style="font-family:ui-monospace,monospace;color:var(--blue);font-size:15px">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Part No.</span>
                <span class="info-val" id="infoPartNo" style="display:inline-flex;align-items:center;gap:6px;justify-content:flex-end;flex-wrap:wrap">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Description</span>
                <span class="info-val" id="infoDesc" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Work Order</span>
                <span class="info-val" id="infoWO" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Line</span>
                <span class="info-val" id="infoLine" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Model</span>
                <span class="info-val" id="infoModel" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Location</span>
                <span class="info-val" id="infoLoc" style="display:inline-flex;align-items:center;gap:6px;justify-content:flex-end;flex-wrap:wrap">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Unit</span>
                <span class="info-val" id="infoUnit" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Weight</span>
                <span class="info-val" id="infoWeight" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Status</span>
                <span class="info-val" id="infoStatus">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Printed</span>
                <span class="info-val" id="infoPrinted">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Vendor Code</span>
                <span class="info-val" id="infoVendorCode" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Date Code</span>
                <span class="info-val" id="infoDateCode" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Trading Code</span>
                <span class="info-val" id="infoTradingCode" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">PO</span>
                <span class="info-val" id="infoPO" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Inventory No.</span>
                <span class="info-val" id="infoInventoryNo" style="font-weight:400;color:var(--t2)">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Trace ID</span>
                <span class="info-val" id="infoTraceId" style="font-weight:400;color:var(--t2);font-family:ui-monospace,monospace;font-size:12px">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Raw Barcode</span>
                <span class="info-val" id="infoRawBarcode" style="font-weight:400;color:var(--t2);font-family:ui-monospace,monospace;font-size:12px;word-break:break-all;text-align:right">—</span>
            </div>
            <div class="info-row">
                <span class="info-label">Created At</span>
                <span class="info-val" id="infoCreatedAt" style="font-weight:400;color:var(--t2)">—</span>
            </div>
        </div>
    </div>

    <!-- RIGHT: TIMELINE -->
    <div class="timeline-card">
        <div class="timeline-head">
            <div class="timeline-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                Lot History
                <span id="txCountBadge" class="count-badge"></span>
            </div>
        </div>
        <div class="timeline-body">
            <div class="timeline" id="timeline">
                <div class="tl-empty">Loading…</div>
            </div>
        </div>
    </div>

</div>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox">
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" onclick="lightboxStep(-1)"><i class="bi bi-chevron-left"></i></button>
    <div class="lightbox-inner">
        <button class="lightbox-close" onclick="closeLightbox()">✕</button>
        <img class="lightbox-img" id="lightboxImg" src="">
        <div class="lightbox-caption" id="lightboxCaption"></div>
    </div>
    <button class="lightbox-nav lightbox-next" id="lightboxNext" onclick="lightboxStep(1)"><i class="bi bi-chevron-right"></i></button>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/locationTypeMeta.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/lotStatusTypeMeta.js"></script>
<script src="js/itemTypeMeta.js"></script>
<script src="js/transactionTypeMeta.js"></script>
<script src="js/zplBuilder.js"></script>
<script>
    const LOT = new URL(location.href).searchParams.get('lot') || ''

    function fmt(n) { return (n ?? 0).toLocaleString() }

    function locBadgeForCode(code) {
        if (!code) return ''
        const found = _locNameMap.get(code)
        const name  = found?.displayName ?? code
        const type  = found?.typeName ?? found?.type ?? ''
        return `<span class="loc-type-badge" style="${locTypeBadgeStyle(type)}">${locHierTypeIcon(type)}${name}</span>`
    }

    // ── Lightbox (เหมือนหน้า Transaction) ──
    let lbImages = [], lbIndex = 0, lbCaption = ''
    let txImagesMap = {}   // transactionId → { images:[...], caption }
    let _printZplMap = {}  // timeline idx → zplData ดิบ (เอาไว้ render preview ตอนกด View Barcode)

    // แปลง zplData ของ print history event เป็นรูป barcode แล้วเปิดโชว์ผ่าน lightbox เดิม (ใช้ default size 8dpmm/3.2x1.2in เหมือน _History.cshtml)
    async function lotShowBarcodePreview(idx) {
        const zpl = _printZplMap[idx]
        if (!zpl) return
        try {
            const src = await renderZplClient(zpl, '8dpmm', 3.2, 1.2)
            if (src) openLightbox([src], 0, 'Barcode Preview')
        } catch (err) {
            console.error('lotShowBarcodePreview:', err)
        }
    }

    function openLightbox(images, index, caption) {
        lbImages  = images
        lbIndex   = ((index || 0) % images.length + images.length) % images.length
        lbCaption = caption || ''
        renderLightbox()
        document.getElementById('lightbox').classList.add('show')
    }
    function openLightboxFor(txId, index) {
        const entry = txImagesMap[txId]
        if (!entry || !entry.images.length) return
        openLightbox(entry.images, index, entry.caption)
    }
    function renderLightbox() {
        const multi = lbImages.length > 1
        document.getElementById('lightboxImg').src = lbImages[lbIndex]
        document.getElementById('lightboxCaption').textContent =
            lbCaption + (multi ? ` · ${lbIndex + 1}/${lbImages.length}` : '')
        document.getElementById('lightboxPrev').style.display = multi ? 'flex' : 'none'
        document.getElementById('lightboxNext').style.display = multi ? 'flex' : 'none'
    }
    function lightboxStep(delta) {
        if (lbImages.length < 2) return
        lbIndex = (lbIndex + delta + lbImages.length) % lbImages.length
        renderLightbox()
    }
    function closeLightbox() {
        document.getElementById('lightbox').classList.remove('show')
        document.getElementById('lightboxImg').src = ''
        lbImages = []
    }
    document.addEventListener('keydown', e => {
        if (!document.getElementById('lightbox').classList.contains('show')) return
        if (e.key === 'Escape')     closeLightbox()
        if (e.key === 'ArrowLeft')  lightboxStep(-1)
        if (e.key === 'ArrowRight') lightboxStep(1)
    })

    // รูปแบบสากล ISO 8601-ish (YYYY-MM-DD HH:mm) — เลี่ยง locale เพราะ th-TH จะได้ปี พ.ศ. ที่สับสนตอนสื่อสารข้ามระบบ/ประเทศ
    function fmtDate(d) {
        if (!d) return '—'
        const dt = new Date(d)
        const pad  = n => String(n).padStart(2, '0')
        const date = `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`
        const time = `${pad(dt.getHours())}:${pad(dt.getMinutes())}`
        return { date, time, full: date + ' ' + time }
    }

    function qtyDisplay(qty, type) {
        if (!type) return `<span class="tl-qty-neu">${qty}</span>`
        const t = type.toLowerCase()
        if (['receive'].includes(t))   return `<span class="tl-qty-up">+${qty}</span>`
        if (['void'].includes(t))   return `<span class="tl-qty-down">${qty}</span>`
        return `<span class="tl-qty-neu">${qty}</span>`
    }

    function escHtml(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
    }

    // ── Load Lot Info ──
    async function loadLotInfo() {
        try {
            const data = await api('/inventory/lots', 'POST', { lotNo: LOT, page: 1, pageSize: 1 })
            const lot  = data?.data?.[0]
            if (!lot) return

            // แยก try/catch ของตัวเอง — ถ้า /master/items ล้ม ไม่ควรดึงให้ข้อมูล lot หลักทั้งหมดพังไปด้วย
            let imgPath = null
            try {
                const itemDetail = await api(`/master/items?PartNo=${encodeURIComponent(lot.partNo)}&Page=1&PageSize=1`, 'GET')
                imgPath = itemDetail?.data?.[0]?.imagePath ?? null
            } catch (err) {
                console.error('loadLotInfo (image):', err)
            }

            const locDisplay = locName(lot.location)

            document.getElementById('lotTitle').textContent    = LOT
            @* document.getElementById('lotSubtitle').textContent = `${lot.partNo ?? ''} · ${lot.description ?? ''} · ${locDisplay}` *@

            document.getElementById('sOnHand').textContent    = fmt(lot.onHandQty)
            document.getElementById('sReserved').textContent  = fmt(lot.reservedQty)
            document.getElementById('sAvailable').textContent = fmt(lot.available)
            document.getElementById('sConsumed').textContent  = fmt(lot.consumedQty)

            document.getElementById('infoLotNo').textContent  = lot.lotNo   ?? '—'
            document.getElementById('infoDesc').textContent   = lot.description ?? '—'
            document.getElementById('infoWO').textContent     = lot.workOrder   ?? '—'
            document.getElementById('infoLine').textContent   = lot.lineName    ?? '—'
            document.getElementById('infoModel').textContent  = lot.modelName   ?? '—'
            document.getElementById('infoUnit').textContent   = lot.unit ?? lot.baseUnit ?? '—'
            document.getElementById('infoWeight').textContent = lot.totalWeight ? `${fmt(lot.totalWeight)} ${lot.weightUnit ?? ''}`.trim() : '—'
            document.getElementById('infoVendorCode').textContent   = lot.vendorCode   || '—'
            document.getElementById('infoDateCode').textContent     = lot.dateCode     || '—'
            document.getElementById('infoTradingCode').textContent  = lot.tradingCode  || '—'
            document.getElementById('infoPO').textContent           = lot.po           || '—'
            document.getElementById('infoInventoryNo').textContent  = lot.inventoryNo  || '—'
            document.getElementById('infoTraceId').textContent      = lot.traceId      || '—'
            document.getElementById('infoRawBarcode').textContent   = lot.rawBarcode   || '—'
            document.getElementById('infoCreatedAt').textContent    = lot.createdAt ? fmtDate(lot.createdAt).full : '—'

            document.getElementById('infoPartNo').innerHTML =
                `<span>${lot.partNo ?? '—'}</span>${itemTypeBadge(lot.itemTypeName)}`
            document.getElementById('infoLoc').innerHTML =
                `<span>${locDisplay || '—'}</span>${locTypeBadge(lot.locationType)}`

            document.getElementById('infoStatus').innerHTML = lotStatusBadge(lot.status)

            const img = document.getElementById('lotImg')
            if (imgPath) {
                img.src = CONFIG.INVENTORY_API + imgPath
                img.onerror = () => { img.style.display = 'none' }
            } else {
                img.style.display = 'none'
            }
        } catch (err) { console.error('loadLotInfo:', err) }
    }

    // ── Render: transaction event (Receive/Move/Void/...) ──
    function renderTxItem(x, idx) {
        const dt   = fmtDate(x.createdAt)
        const isCurrent = idx === 0

        const fromBadge = locBadgeForCode(x.fromLocation)
        const toBadge   = locBadgeForCode(x.toLocation)
        const locationLine = (fromBadge || toBadge)
            ? `<div class="tl-detail-row">
                ${fromBadge}
                ${fromBadge && toBadge ? `<i class="bi bi-arrow-right tl-arrow"></i>` : ''}
                ${toBadge}
               </div>`
            : ''

        // ── Confirm Image (thumbnail แรก + badge จำนวนรูปที่เหลือ, กดเพื่อเปิด lightbox carousel) ──
        const confirmImages = (x.images || []).map(im => CONFIG.INVENTORY_API + im.imageUrl)
        txImagesMap['tx' + x.id] = {
            images: confirmImages,
            caption: `${x.transactionType ?? ''} · ${x.performedBy ?? ''} · ${dt.full}`
        }
        const imgCell = confirmImages.length
            ? `<div class="thumb-wrap">
                   <img src="${confirmImages[0]}" class="proof-thumb" onclick="openLightboxFor('tx${x.id}', 0)"
                        onerror="this.closest('.thumb-wrap').innerHTML='<span class=no-photo>—</span>'">
                   ${confirmImages.length > 1 ? `<span class="thumb-badge">+${confirmImages.length - 1}</span>` : ''}
               </div>`
            : `<span class="no-photo">—</span>`

        return `
        <div class="tl-item ${isCurrent ? 'current' : ''}">
            <div class="tl-dot">${txTypeIcon(x.transactionType, 18)}</div>
            <div class="tl-content">
                <div class="tl-type">
                    <span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;${txTypeBadgeStyle(x.transactionType)}">${x.transactionType ?? '—'}</span>
                    ${isCurrent ? '<span class="tl-current-label">● Current</span>' : ''}
                    <span class="tl-time">${dt.date}</span>
                    <span class="tl-time">${dt.time}</span>
                </div>
                <div class="tl-detail">
                    <div class="tl-detail-rows">
                        <div class="tl-detail-row">
                            @* <i class="bi bi-123" style="font-size:13px"></i> *@
                            <span>QTY :</span>
                            ${qtyDisplay(fmt(x.quantity), x.transactionType)}
                        </div>
                        ${locationLine}
                        <div class="tl-detail-row">
                            <i class="bi bi-person-fill" style="font-size:12px"></i>
                            @* <span>BY :</span> *@
                            <strong>${x.performedBy ?? '—'}</strong>
                        </div>
                    </div>
                    ${imgCell}
                </div>
            </div>
        </div>`
    }

    // ── Render: print history event (Print / Re-Print) ──
    function renderPrintItem(x, idx) {
        const dt        = fmtDate(x.printedAt)
        const isCurrent = idx === 0
        const typeLabel = x.isReprint ? 'Re-Print' : 'Print'
        const statusRow = x.success
            ? `<span class="tl-qty-up"><i class="bi bi-check-circle-fill"></i> Success</span>`
            : `<span class="tl-qty-down"><i class="bi bi-x-circle-fill"></i> Failed${x.errorMessage ? ` — ${escHtml(x.errorMessage)}` : ''}</span>`

        // Barcode ของรอบพิมพ์นี้ — คลิกเพื่อ render ZPL เป็นรูปแล้วเปิดดูผ่าน lightbox เดิม
        let barcodeRow = ''
        if (x.zplData) {
            _printZplMap[idx] = x.zplData
            barcodeRow = `
                        <div class="tl-detail-row" style="cursor:pointer" onclick="lotShowBarcodePreview(${idx})" title="คลิกเพื่อดู Barcode">
                            <i class="bi bi-upc-scan" style="font-size:12px"></i>
                            <span style="color:var(--blue);text-decoration:underline">View Barcode</span>
                        </div>`
        }

        return `
        <div class="tl-item ${isCurrent ? 'current' : ''}">
            <div class="tl-dot">${txTypeIcon(typeLabel, 18)}</div>
            <div class="tl-content">
                <div class="tl-type">
                    <span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;${txTypeBadgeStyle(typeLabel)}">${typeLabel}</span>
                    ${isCurrent ? '<span class="tl-current-label">● Current</span>' : ''}
                    <span class="tl-time">${dt.date}</span>
                    <span class="tl-time">${dt.time}</span>
                </div>
                <div class="tl-detail">
                    <div class="tl-detail-rows">
                        <div class="tl-detail-row">
                            <i class="bi bi-hdd-network" style="font-size:12px"></i>
                            <span>${escHtml(x.printerIp || '—')}</span>
                        </div>
                        <div class="tl-detail-row">
                            <i class="bi bi-person-fill" style="font-size:12px"></i>
                            <strong>${escHtml(x.printUser || '—')}</strong>
                        </div>
                        <div class="tl-detail-row">
                            ${statusRow}
                        </div>${barcodeRow}
                    </div>
                </div>
            </div>
        </div>`
    }

    // ── Load Transactions + Print History (timeline รวม เรียงตามเวลาเดียวกัน) ──
    async function loadTimeline() {
        try {
            const body   = { lotNo: LOT, page: 1, pageSize: 50, sortBy: 'createdAt', desc: false }
            const first  = await api('/transaction/get', 'POST', body)
            let txRows   = first.data || []
            const total  = first.totalPages || 1

            if (total > 1) {
                const rest = await Promise.all(
                    Array.from({ length: total - 1 }, (_, i) =>
                        api('/transaction/get', 'POST', { ...body, page: i + 2 })
                    )
                )
                rest.forEach(r => { txRows = txRows.concat(r.data || []) })
            }

            // Print History — endpoint แยกต่างหาก ถ้าโหลดไม่สำเร็จหรือไม่มีข้อมูลเลย ไม่ต้อง block timeline ของ transaction
            let printRows = []
            let printFetchOk = true
            try {
                const ph = await api(`/printer/histories?lotNo=${encodeURIComponent(LOT)}&page=1&pageSize=50`, 'GET')
                printRows = ph?.data || []
            } catch (err) {
                console.error('loadTimeline (print history):', err)
                printFetchOk = false
            }

            // Info card: "Printed" — ถือว่า printed ถ้ามีประวัติพิมพ์สำเร็จอย่างน้อย 1 ครั้ง (Print หรือ Re-Print)
            const printedEl = document.getElementById('infoPrinted')
            if (printedEl) {
                if (!printFetchOk) {
                    printedEl.textContent = '—'
                } else {
                    const printed = printRows.some(x => x.success)
                    printedEl.innerHTML = printed
                        ? `<span style="color:var(--green);font-weight:700;display:inline-flex;align-items:center;gap:5px"><i class="bi bi-check-circle-fill"></i>Yes</span>`
                        : `<span style="color:var(--t3);font-weight:700;display:inline-flex;align-items:center;gap:5px"><i class="bi bi-x-circle"></i>No</span>`
                }
            }

            const rows = [
                ...txRows.map(x => ({ kind: 'tx', at: x.createdAt, raw: x })),
                ...printRows.map(x => ({ kind: 'print', at: x.printedAt, raw: x })),
            ]

            document.getElementById('txCountBadge').textContent = rows.length + ' events'

            if (rows.length === 0) {
                document.getElementById('timeline').innerHTML =
                    `<div class="tl-empty">ไม่พบ Transaction สำหรับ Lot นี้</div>`
                return
            }

            // Sort ใหม่ → เก่า (รวม transaction กับ print history เข้าด้วยกันตามเวลาจริง)
            rows.sort((a, b) => new Date(b.at) - new Date(a.at))

            txImagesMap  = {}
            _printZplMap = {}
            const html = rows.map((row, idx) =>
                row.kind === 'print' ? renderPrintItem(row.raw, idx) : renderTxItem(row.raw, idx)
            ).join('')

            document.getElementById('timeline').innerHTML = html
        } catch (err) {
            console.error('loadTimeline:', err)
            document.getElementById('timeline').innerHTML =
                `<div class="tl-empty" style="color:var(--red)">โหลดข้อมูลไม่สำเร็จ: ${err.message}</div>`
        }
    }

    async function init(){
        await loadLocation()
        loadLotInfo()
        loadTimeline()
    }

    init()
</script>
}
