                <script>
                    (function () {
                        const path = window.location.pathname.toLowerCase()
                        // desktop nav
                        document.querySelectorAll('.custom-nav .nav-link').forEach(a => {
                            if (a.getAttribute('href') && path.startsWith(a.getAttribute('href').toLowerCase())) {
                                a.classList.add('active')
                            }
                        })
                        // mobile menu
                        document.querySelectorAll('#mobileMenu .list-group-item').forEach(a => {
                            if (a.getAttribute('href') && path.startsWith(a.getAttribute('href').toLowerCase())) {
                                a.style.color = '#1a4fc4'
                                a.style.fontWeight = '700'
                                a.style.background = 'none'
                            }
                        })
                    })()
                </script>

                <div class="container-fluid px-3">

                    <main role="main" class="pb-3">

                        @RenderBody()

                    </main>

                </div>



                <footer class="border-top footer text-muted">

                    <div class="container-fluid px-3">

                        &copy; 2026 SmartFactory

                    </div>

                </footer>



                <script src="~/lib/jquery/dist/jquery.min.js"></script>
                <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                <script src="/js/config.js"></script>
                <script src="/js/api.js"></script>


                <script>

                    let lastActivity = Date.now();
                    //============================================================//
                    document.addEventListener("mousemove", () => lastActivity = Date.now());
                    document.addEventListener("keydown", () => lastActivity = Date.now());
                    document.addEventListener("click", () => lastActivity = Date.now());

    
                    //=============================================================//

                    async function sendHeartbeat() {
                    const token = localStorage.getItem("token");

                    if (!token) return;

                    try {
                    const res = await fetch(CONFIG.AUTH_API + "/session/heartbeat", {
                        method: "POST",
                        headers: {
                        "Content-Type": "application/json",
                        "Authorization": "Bearer " + token
                    },
                    body: JSON.stringify({
                    service: "Inventory"
                    })
                    });

                    if (res.status === 401) {
                    logout();
                    }

                    } catch (err) {
                    console.warn("Heartbeat failed", err);
                    }
                    }
                    async function loadOnlineCount() {
                    const token = localStorage.getItem("token");

                    if (!token) return;

                    try {
                    const res = await fetch(CONFIG.AUTH_API + "/session/online-users?service=Inventory", {
                    headers: {
                    "Authorization": "Bearer " + token
                    }
                    });

                    if (!res.ok) return;

                    const data = await res.json();

                    document.getElementById("onlineCount").innerText =
                    "Online: " + data.length;

                    } catch (err) {
                    console.warn("Load online users failed", err);
                    }
                    }

                    function getToken() {
                    return localStorage.getItem("token")
                    }

                    let isLoggingOut = false;

                    function goHome() {
                        try {
                            const user = JSON.parse(localStorage.getItem('user') || '{}')
                            window.location.href = user.role === 'Admin'
                                ? '/Inventory/Dashboard'
                                : '/Inventory/OpDashboard'
                        } catch (_) {
                            window.location.href = '/Inventory/Dashboard'
                        }
                    }

                    async function logout() {

                    if (isLoggingOut) return;
                    isLoggingOut = true;

                    const token = localStorage.getItem("token");

                    try {
                    if (token) {
                    await fetch(CONFIG.AUTH_API + "/session/end", {
                    method: "POST",
                    headers: {
                    "Authorization": "Bearer " + token
                    }
                    });
                    }
                    } catch (err) {
                    console.warn("Failed to end session", err);
                    }

                    localStorage.removeItem("user");
                    localStorage.removeItem("token");

                    window.location = "/login";
                    }

                    function checkLogin() {

                    let token = getToken()

                    if (!token && window.location.pathname !== "/login") {
                    window.location = "/login"
                    }
                    }
                    function loadUser() {

                    const allowedRoles = ["Admin", "Inventory_Admin", "Admin_WH", "Supervisor"];
                    let user = localStorage.getItem("user")

                    if (!user) return

                    user = JSON.parse(user)

                    const displayText = user.displayName + " (" + user.role + ")"
                    const userInfoEl = document.getElementById("userInfo")
                    if (userInfoEl) userInfoEl.innerText = displayText
                    const mobileInfo = document.getElementById("userInfoMobile")
                    if (mobileInfo) mobileInfo.innerText = displayText

                    const rawPhoto = user.thumbnailPhoto ?? null
                    if (rawPhoto) {
                    const src = rawPhoto.startsWith("data:") ? rawPhoto : "data:image/jpeg;base64," + rawPhoto
                    const desktopPhoto = document.getElementById("userPhoto")
                    if (desktopPhoto) desktopPhoto.src = src
                    const mobilePhoto = document.getElementById("userPhotoMobile")
                    if (mobilePhoto) mobilePhoto.src = src
                    }

                    if (!allowedRoles.includes(user.role)) {
                    const hideEl = id => { const el = document.getElementById(id); if (el) el.style.display = "none"; };
                    hideEl("dashboardNav");
                    hideEl("reserveNav");
                    hideEl("transferNav");
                    hideEl("TransactionsNav");
                    hideEl("MasterManagementNav");
                    } 
                    
                    @* else {
                    document.getElementById("OpDashboardNav").style.display = "none"
                    } *@

                    }
                    //=======================================
                    checkLogin()
                    loadUser()
                    sendHeartbeat()
                    loadOnlineCount()

                    // ── Theme Toggle ──
                    ;(function() {
                        const THEME_KEY = 'sf_theme'
                        function applyTheme(t) {
                            document.documentElement.setAttribute('data-theme', t)
                            const icon = document.getElementById('themeIcon')
                            if (icon) icon.className = t === 'dark' ? 'bi bi-moon-fill text-warning' : 'bi bi-sun-fill text-muted'
                            localStorage.setItem(THEME_KEY, t)
                        }
                        window.toggleTheme = function() {
                            applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark')
                        }
                        applyTheme(localStorage.getItem(THEME_KEY) || 'light')
                    })()

                    //====================================


                    setInterval(() => {
                    loadOnlineCount();
                    }, 10000);

                    setInterval(() => {
                    if (Date.now() - lastActivity > 60 * 60 * 1000) { // 60 นาที
                    logout();
                    }
                    }, 10000);

                    setInterval(() => {
                    if (Date.now() - lastActivity < 60000) {
                    sendHeartbeat();
                    }
                    }, 30000);

                </script>



                @await RenderSectionAsync("Scripts", required: false)

            </body>

        </html>