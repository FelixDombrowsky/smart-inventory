<style>
.adv-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.adv-opt-row { display:flex; align-items:center; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f4f4f7; }
.adv-opt-row:last-child { border-bottom:none; }
.adv-toggle-wrap { position:relative; display:inline-block; width:38px; height:22px; flex-shrink:0; }
.adv-toggle-wrap input { opacity:0; width:0; height:0; }
.adv-toggle-slider { position:absolute; inset:0; background:#e5e7eb; border-radius:22px; cursor:pointer; transition:.2s; }
.adv-toggle-slider:before { content:''; position:absolute; left:3px; bottom:3px; width:16px; height:16px; background:#fff; border-radius:50%; transition:.2s; box-shadow:0 1px 3px rgba(0,0,0,.2); }
.adv-toggle-wrap input:checked + .adv-toggle-slider { background:var(--blue); }
.adv-toggle-wrap input:checked + .adv-toggle-slider:before { transform:translateX(16px); }
</style>

<div class="adv-card" id="advAdvancedOptions" style="margin-bottom:8px">
    <div style="padding:12px 18px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none" onclick="toggleAdvancedOptions()">
        <span style="font-size:13px;font-weight:700;color:var(--navy)">
            <i class="bi bi-sliders me-1" style="color:var(--t2)"></i> Advanced Options
        </span>
        <i class="bi bi-chevron-down" id="advOptIcon" style="color:var(--t2);font-size:13px;transition:transform .2s"></i>
    </div>
    <div id="advOptBody" style="display:none;padding:0 18px 4px;border-top:1px solid var(--border)">
        <div style="padding-top:4px">
            <div class="adv-opt-row" data-perm="WMS.SkipValidation.Gps">
                <div style="font-size:13px;color:var(--text)">Skip GPS Validation</div>
                <label class="adv-toggle-wrap"><input type="checkbox" id="advSkipGps"><span class="adv-toggle-slider"></span></label>
            </div>
            <div class="adv-opt-row" data-perm="WMS.SkipValidation.Printed">
                <div style="font-size:13px;color:var(--text)">Skip Printed Validation</div>
                <label class="adv-toggle-wrap"><input type="checkbox" id="advSkipPrinted"><span class="adv-toggle-slider"></span></label>
            </div>
            <div class="adv-opt-row" data-perm="WMS.SkipValidation.WorkOrder">
                <div style="font-size:13px;color:var(--text)">Skip Work Order Validation</div>
                <label class="adv-toggle-wrap"><input type="checkbox" id="advSkipWO"><span class="adv-toggle-slider"></span></label>
            </div>
            <div class="adv-opt-row" data-perm="WMS.SkipValidation.Location">
                <div style="font-size:13px;color:var(--text)">Skip Location Validation</div>
                <label class="adv-toggle-wrap"><input type="checkbox" id="advSkipLoc"><span class="adv-toggle-slider"></span></label>
            </div>
            <div class="adv-opt-row" data-perm="WMS.SkipValidation.LotDuplicate">
                <div style="font-size:13px;color:var(--text)">Skip Lot Duplicate Validation</div>
                <label class="adv-toggle-wrap"><input type="checkbox" id="advSkipDup"><span class="adv-toggle-slider"></span></label>
            </div>
            <div class="adv-opt-row" data-perm="WMS.SkipValidation.ReservedLot">
                <div style="font-size:13px;color:var(--text)">Skip Reserved Lot Validation</div>
                <label class="adv-toggle-wrap"><input type="checkbox" id="advSkipRes"><span class="adv-toggle-slider"></span></label>
            </div>
            <div class="adv-opt-row" data-perm="WMS.SkipValidation.ManualLot">
                <div style="font-size:13px;color:var(--text)">Skip Manual Lot Validation</div>
                <label class="adv-toggle-wrap"><input type="checkbox" id="advSkipManual"><span class="adv-toggle-slider"></span></label>
            </div>
            <div class="adv-opt-row" data-perm="WMS.SkipValidation.UniqueId">
                <div style="font-size:13px;color:var(--text)">Skip Unique ID Validation</div>
                <label class="adv-toggle-wrap"><input type="checkbox" id="advSkipUid"><span class="adv-toggle-slider"></span></label>
            </div>
            <div class="adv-opt-row" data-perm="WMS.SkipValidation.UploadImages">
                <div style="font-size:13px;color:var(--text)">Skip Upload Images Validation</div>
                <label class="adv-toggle-wrap"><input type="checkbox" id="advSkipImg"><span class="adv-toggle-slider"></span></label>
            </div>
        </div>
    </div>
</div>

<script>
function toggleAdvancedOptions() {
    const body = document.getElementById('advOptBody')
    const icon = document.getElementById('advOptIcon')
    const open = body.style.display !== 'none'
    body.style.display   = open ? 'none' : ''
    icon.style.transform = open ? '' : 'rotate(180deg)'
}

// ซ่อน/แสดง Skip toggle แต่ละแถวตาม permission ของ user (data-perm ต้องตรงกับ user.permissions)
// ถ้าไม่มี permission ที่ match เลยสักแถว จะซ่อนการ์ด Advanced Options ทั้งการ์ด
// isAdmin = true จะแสดงทุกแถว เพราะ Admin ส่ง permissions มาเป็น array ว่าง (หมายถึงทำได้ทุกสิทธิ์อยู่แล้ว)
function applyAdvancedOptionsPermissions(permissions, isAdmin) {
    const perms = Array.isArray(permissions) ? permissions : []
    const card  = document.getElementById('advAdvancedOptions')
    let anyVisible = false
    card.querySelectorAll('[data-perm]').forEach(row => {
        const visible = isAdmin || perms.includes(row.dataset.perm)
        row.style.display = visible ? '' : 'none'
        anyVisible = anyVisible || visible
    })
    card.style.display = anyVisible ? '' : 'none'
}

function getAdvancedOptions() {
    return {
        skipGpsValidation:          document.getElementById('advSkipGps')?.checked     ?? false,
        skipPrintedValidation:      document.getElementById('advSkipPrinted')?.checked ?? false,
        skipWorkOrderValidation:    document.getElementById('advSkipWO')?.checked      ?? false,
        skipLocationValidation:     document.getElementById('advSkipLoc')?.checked     ?? false,
        skipLotDuplicateValidation: document.getElementById('advSkipDup')?.checked     ?? false,
        skipReservedLotValidation:  document.getElementById('advSkipRes')?.checked     ?? false,
        skipManualLotValidation:    document.getElementById('advSkipManual')?.checked  ?? false,
        skipUniquenIdValidation:    document.getElementById('advSkipUid')?.checked     ?? false,
        skipUploadImagesValidation: document.getElementById('advSkipImg')?.checked     ?? false,
    }
}
</script>
