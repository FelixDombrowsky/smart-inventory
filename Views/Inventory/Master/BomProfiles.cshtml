    async function saveBom() {
        const isWo = _bnMode === 'workorder'
        // Components ใช้ _bnManualComponents ตัวเดียวกันเสมอไม่ว่าจะ tab ไหน — ติ๊กจาก By WorkOrder หรือค้นหาเพิ่มเองจาก Manual
        // ก็ลงท้ายมาที่ array นี้ทั้งคู่ (ดู bnToggleWoComp/bnWoSelectAll/bnAddComp)
        let outputItemName, outputItemDescription, outputQuantity, qtyPerFG
        const components = _bnManualComponents.map(c => ({ componentItemId: c.componentItemId, quantity: c.quantity }))
        if (isWo) {
            if (document.getElementById('bnWoPreview').style.display === 'none') {
                showToast('กรุณา Fetch Work Order ก่อน', 'error'); return
            }
            outputItemName        = document.getElementById('bnWoOutputItemName').value.trim()
            outputItemDescription = document.getElementById('bnWoOutputItemDesc').value.trim()
            outputQuantity        = parseFloat(document.getElementById('bnWoOutputQty').value) || 0
            qtyPerFG               = parseFloat(document.getElementById('bnWoQtyPerFG').value) || 0
            if (!outputItemName) { showToast('กรุณากรอก Output Item Name', 'error'); return }
            if (!(outputQuantity > 0)) { showToast('กรุณากรอก Output Qty', 'error'); return }
        } else {
            outputItemName        = document.getElementById('bomItemName').value.trim()
            outputItemDescription = document.getElementById('bomItemDescription').value.trim()
            outputQuantity        = parseFloat(document.getElementById('bomQty').value) || 0
            qtyPerFG               = parseFloat(document.getElementById('bomQtyPerFG').value) || 0
            if (!outputItemName) { showToast('กรุณากรอก Output Item Name', 'error'); return }
        }
        if (!components.length) { showToast('กรุณาเพิ่ม Component อย่างน้อย 1 รายการ', 'error'); return }
        try {
            // POST /master/bom-profiles สร้าง Item ใหม่ให้เลยจาก outputItemName/outputItemDescription (ไม่มี field outputPartNo — Part No. auto-gen ฝั่ง backend)
            await api('/master/bom-profiles', 'POST', { outputItemName, outputItemDescription, qtyPerFG, outputQuantity, components })
            showToast('สร้าง BOM Profile สำเร็จ')
            closeModal('bomModal')
            _bomProfilesCache = []
            loadBoms()
        } catch (err) { showToast('บันทึกไม่สำเร็จ: ' + err.message, 'error') }
    }

