@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <base href="/wms/" />
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Create Account — SmartFactory</title>
    <link rel="icon" href="favicon.ico"/>
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.min.css"/>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        /* ── THEME VARIABLES (เหมือนหน้า Login ทุกประการ เพื่อความต่อเนื่องของแบรนด์) ── */
        :root, [data-theme="dark"] {
            --bg:           #000;
            --bg-form:      #000;
            --bg-hero:      linear-gradient(160deg, #0a0a0a 0%, #0d1117 40%, #050e1a 100%);
            --hero-fade:    linear-gradient(to right, rgba(0,0,0,0) 60%, #000 100%);
            --grid-line:    rgba(255,255,255,.03);
            --text:         #fff;
            --text-muted:   rgba(255,255,255,.45);
            --text-faint:   rgba(255,255,255,.25);
            --label-color:  rgba(255,255,255,.5);
            --border-input: rgba(255,255,255,.2);
            --border-focus: #fff;
            --btn-bg:       #fff;
            --btn-color:    #000;
            --btn-hover:    #e5e5e5;
            --btn-dis-bg:   rgba(255,255,255,.2);
            --btn-dis-clr:  rgba(255,255,255,.4);
            --toggle-bg:    rgba(255,255,255,.08);
            --toggle-hover: rgba(255,255,255,.14);
            --toggle-color: rgba(255,255,255,.6);
            --hero-tag-bdr: rgba(255,255,255,.15);
            --hero-tag-clr: rgba(255,255,255,.6);
            --hero-title:   #fff;
            --hero-sub:     rgba(255,255,255,.45);
            --stat-val:     #fff;
            --stat-lbl:     rgba(255,255,255,.4);
            --footer-clr:   rgba(255,255,255,.25);
            --orb-opacity:  .18;
            --svg-opacity:  .55;
            --ok-clr:       #34d399;
            --ok-bg:        rgba(16,185,129,.12);
            --ok-bdr:       rgba(16,185,129,.3);
        }

        [data-theme="light"] {
            --bg:           #f0f2f5;
            --bg-form:      #fff;
            --bg-hero:      linear-gradient(160deg, #dce8ff 0%, #e8f0fe 40%, #f0f5ff 100%);
            --hero-fade:    linear-gradient(to right, rgba(240,242,245,0) 60%, #f0f2f5 100%);
            --grid-line:    rgba(0,0,0,.04);
            --text:         #0f172a;
            --text-muted:   rgba(15,23,42,.5);
            --text-faint:   rgba(15,23,42,.35);
            --label-color:  rgba(15,23,42,.5);
            --border-input: rgba(15,23,42,.2);
            --border-focus: #0f172a;
            --btn-bg:       #0f172a;
            --btn-color:    #fff;
            --btn-hover:    #1e293b;
            --btn-dis-bg:   rgba(15,23,42,.15);
            --btn-dis-clr:  rgba(15,23,42,.35);
            --toggle-bg:    rgba(15,23,42,.07);
            --toggle-hover: rgba(15,23,42,.12);
            --toggle-color: rgba(15,23,42,.55);
            --hero-tag-bdr: rgba(15,23,42,.15);
            --hero-tag-clr: rgba(15,23,42,.55);
            --hero-title:   #0f172a;
            --hero-sub:     rgba(15,23,42,.5);
            --stat-val:     #0f172a;
            --stat-lbl:     rgba(15,23,42,.4);
            --footer-clr:   rgba(15,23,42,.3);
            --orb-opacity:  .25;
            --svg-opacity:  .7;
            --ok-clr:       #059669;
            --ok-bg:        rgba(5,150,105,.08);
            --ok-bdr:       rgba(5,150,105,.25);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            color: var(--text);
            height: 100dvh;
            overflow: hidden;
            display: flex;
            transition: background .3s, color .3s;
        }

        /* ── HERO SIDE ── */
        .hero { flex: 1; position: relative; overflow: hidden; display: none; }
        @@media (min-width: 900px) { .hero { display: block; } }

        .hero-bg {
            position: absolute; inset: 0;
            background: var(--hero-fade), var(--bg-hero);
            transition: background .3s;
        }
        .hero-grid {
            position: absolute; inset: 0;
            background-image:
                linear-gradient(var(--grid-line) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .orb {
            position: absolute; border-radius: 50%; filter: blur(80px);
            opacity: var(--orb-opacity);
            animation: pulse 6s ease-in-out infinite;
        }
        .orb-1 { width:400px;height:400px;background:#1a6fff;top:-80px;left:-80px;animation-delay:0s }
        .orb-2 { width:300px;height:300px;background:#00d4aa;bottom:100px;left:200px;animation-delay:2s }
        .orb-3 { width:250px;height:250px;background:#7c3aed;top:40%;left:40%;animation-delay:4s }
        @@keyframes pulse {
            0%,100% { transform:scale(1); opacity:var(--orb-opacity); }
            50%      { transform:scale(1.15); }
        }

        .hero-art { position:absolute;inset:0;display:flex;align-items:center;justify-content:center; }
        .hero-art svg { opacity: var(--svg-opacity); transition: opacity .3s; }

        .scan-line {
            position:absolute;left:0;right:0;height:1px;
            background:linear-gradient(90deg,transparent,rgba(26,111,255,.6),transparent);
            animation:scanMove 4s linear infinite;
        }
        @@keyframes scanMove {
            0%   { top:10%;opacity:0 }
            10%  { opacity:1 }
            90%  { opacity:1 }
            100% { top:90%;opacity:0 }
        }

        .hero-content { position:absolute;bottom:60px;left:48px;right:48px; }
        .hero-tag {
            display:inline-flex;align-items:center;gap:8px;
            border:1px solid var(--hero-tag-bdr);border-radius:20px;
            padding:5px 14px;font-size:11px;font-weight:600;
            letter-spacing:.08em;color:var(--hero-tag-clr);
            margin-bottom:20px;text-transform:uppercase;
        }
        .hero-tag .dot { width:7px;height:7px;border-radius:50%;background:#00d4aa;animation:blink 2s ease-in-out infinite; }
        @@keyframes blink { 0%,100%{opacity:1}50%{opacity:.3} }
        .hero-title { font-size:36px;font-weight:700;line-height:1.15;letter-spacing:-.02em;margin-bottom:12px;color:var(--hero-title); }
        .hero-sub   { font-size:14px;color:var(--hero-sub);line-height:1.6;max-width:380px; }
        .hero-steps { display:flex;flex-direction:column;gap:14px;margin-top:32px; }
        .hero-step  { display:flex;align-items:center;gap:12px; }
        .hero-step-num {
            width:24px;height:24px;border-radius:50%;flex-shrink:0;
            border:1px solid var(--hero-tag-bdr);display:flex;align-items:center;justify-content:center;
            font-size:11px;font-weight:700;color:var(--hero-tag-clr);
        }
        .hero-step-txt { font-size:13px;color:var(--hero-sub); }

        /* ── FORM SIDE ── */
        .form-side {
            width:100%;max-width:520px;
            display:flex;flex-direction:column;justify-content:space-between;
            padding:36px 48px;position:relative;
            background:var(--bg-form);overflow-y:auto;
            transition:background .3s;
        }
        @@media (max-width:899px) { .form-side { max-width:100%;padding:32px 24px; } }

        .form-header { display:flex;align-items:center;gap:10px;flex-shrink:0; }
        .form-logo   { width:32px;height:32px; }
        .form-brand  { font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text);flex:1; }

        .theme-toggle {
            width:36px;height:36px;border-radius:50%;
            background:var(--toggle-bg);border:none;cursor:pointer;
            display:flex;align-items:center;justify-content:center;
            color:var(--toggle-color);font-size:16px;
            transition:background .2s,color .2s;flex-shrink:0;
        }
        .theme-toggle:hover { background:var(--toggle-hover);color:var(--text); }

        .form-body { flex:1;display:flex;flex-direction:column;justify-content:center;padding:32px 0; }
        .form-title { font-size:30px;font-weight:700;letter-spacing:-.02em;margin-bottom:20px;color:var(--text); }
        .form-desc  { font-size:14px;color:var(--text-muted);margin-bottom:32px;line-height:1.5; }

        .field-grid { display:grid;grid-template-columns:1fr 1fr;gap:0 20px; }
        @@media (max-width:420px) { .field-grid { grid-template-columns:1fr; } }
        .field-grid .field-full { grid-column:1/-1; }

        .field { margin-bottom:22px; }
        .field label {
            display:block;font-size:12px;font-weight:600;
            color:var(--label-color);letter-spacing:.05em;
            text-transform:uppercase;margin-bottom:10px;
        }
        .field input {
            width:100%;background:transparent;
            border:none;border-bottom:1px solid var(--border-input);
            color:var(--text);font-size:15px;font-family:inherit;
            padding:8px 0;outline:none;transition:border-color .2s,color .2s;
        }
        .field input::placeholder { color:var(--text-faint); }
        .field input:focus { border-bottom-color:var(--border-focus); }
        .field input.invalid { border-bottom-color:#f87171; }

        .field-password { position:relative; }
        .field-password input { padding-right:36px; }
        .toggle-pw {
            position:absolute;right:0;top:50%;transform:translateY(-50%);
            background:none;border:none;color:var(--label-color);
            cursor:pointer;font-size:16px;padding:4px;transition:color .15s;
        }
        .toggle-pw:hover { color:var(--text); }

        .pw-hint { font-size:11px;color:var(--text-faint);margin-top:6px; }
        .pw-hint.match { color:var(--ok-clr); }
        .pw-hint.mismatch { color:#f87171; }

        .btn-signup {
            width:100%;padding:16px;
            background:var(--btn-bg);color:var(--btn-color);
            border:none;border-radius:4px;
            font-size:13px;font-weight:700;font-family:inherit;
            letter-spacing:.1em;text-transform:uppercase;
            cursor:pointer;transition:background .2s;
            display:flex;align-items:center;justify-content:center;gap:10px;
            margin-top:6px;
        }
        .btn-signup:hover { background:var(--btn-hover); }
        .btn-signup:disabled { background:var(--btn-dis-bg);color:var(--btn-dis-clr);cursor:not-allowed; }
        .btn-signup .arrow { font-size:18px;transition:transform .2s; }
        .btn-signup:hover:not(:disabled) .arrow { transform:translateX(4px); }

        .signup-err {
            margin-top:14px;padding:10px 14px;
            background:rgba(220,38,38,.12);border:1px solid rgba(220,38,38,.3);
            border-radius:4px;font-size:13px;color:#f87171;display:none;
        }
        .signup-ok {
            margin-top:14px;padding:10px 14px;
            background:var(--ok-bg);border:1px solid var(--ok-bdr);
            border-radius:4px;font-size:13px;color:var(--ok-clr);display:none;
            align-items:center;gap:8px;
        }

        .form-switch { font-size:13px;color:var(--text-muted);text-align:center;margin-top:22px; }
        .form-switch a { color:var(--text);font-weight:600;text-decoration:none; }
        .form-switch a:hover { text-decoration:underline; }

        .form-footer { font-size:12px;color:var(--footer-clr);text-align:center;line-height:1.8;flex-shrink:0; }
    </style>
</head>
<body>

