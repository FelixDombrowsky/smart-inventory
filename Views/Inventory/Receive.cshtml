@{
    ViewData["Title"] = "Receive Materials";
}
<style>
:root {
    --blue:#1a6fff; --blue-lt:#e8f0ff; --blue-dk:#1456d4;
    --navy:#0f172a; --text:#1a1a2e; --t2:#6b7280; --t3:#9ca3af;
    --border:#e5e7eb; --green:#059669; --green-lt:#ecfdf5;
    --red:#dc2626;
}

/* Header */
.page-header {
    background:linear-gradient(135deg,var(--navy) 0%,#1e3a6e 60%,#1a6fff 100%);
    border-radius:16px; padding:20px 28px; margin-bottom:20px;
    position:relative; overflow:hidden;
}
.page-header::before { content:''; position:absolute; right:-40px; top:-40px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,.04); }
.page-header h2 { font-size:22px; font-weight:700; color:#fff; margin-bottom:4px; }
.page-header p  { font-size:13px; color:rgba(255,255,255,.65); margin:0; }

/* Cards */
.rx-card { background:#fff; border:1px solid var(--border); border-radius:14px; box-shadow:0 1px 4px rgba(0,0,0,.04); margin-bottom:16px; overflow:visible; }
.rx-card-body { padding:22px 24px; }

/* Scanner */
.scanner-box {
    width:100%; height:50vh; max-height:520px; border:3px solid var(--blue);
    border-radius:16px; position:relative; overflow:hidden; background:#000; margin:0 auto;
}
.scanner-box video  { position:absolute;inset:0;width:100%;height:100%;object-fit:cover; }
.scanner-box canvas { position:absolute;inset:0;width:100%;height:100%;pointer-events:none; }
.rc-detected-label {
    position:absolute; bottom:0; left:0; right:0;
    background:rgba(0,0,0,.65); color:#fff;
    font-size:12px; font-weight:600; padding:6px 10px;
    text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}

/* Location */
.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:10px 12px 10px 38px;
    border:1.5px solid var(--border); border-radius:10px;
    font-size:14px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item {
    padding:10px 14px; font-size:13px; cursor:pointer;
    border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px;
    transition:.12s;
}
.loc-item:last-child { border-bottom:none; }
.loc-item:hover { background:var(--blue-lt); }
.loc-item:first-child { border-radius:8px 8px 0 0; }
.loc-item:last-child  { border-radius:0 0 8px 8px; }

/* Table */
.rx-table { width:100%; border-collapse:collapse; font-size:13px; }
.rx-table th {
    background:#f8f9fc; color:var(--t2); font-weight:700; font-size:11px;
    letter-spacing:.04em; text-transform:uppercase;
    padding:10px 16px; border-bottom:2px solid var(--border); text-align:left;
}
.rx-table td { padding:9px 16px; border-bottom:1px solid var(--border); vertical-align:middle; }
.rx-table tr:last-child td { border-bottom:none; }
.rx-table tbody tr:hover td { background:#fafbff; }
.rx-table tbody tr.row-err td { background:#fef2f2; }
.rx-table tbody tr.row-err td:first-child { border-left:3px solid var(--red); }
.rx-table tbody tr.row-err-detail td { background:#fef2f2; border-top:1px solid #fecaca; border-left:3px solid var(--red); padding:4px 14px 7px; }
.rx-table tbody tr.row-ok  td { background:var(--green-lt); opacity:.6; transition:opacity .4s; }
.rx-input { width:100%; padding:6px 9px; border:1.5px solid var(--border); border-radius:7px; font-size:13px; font-family:inherit; outline:none; box-sizing:border-box; }
.rx-input:focus { border-color:var(--blue); }
.rx-input.err { border-color:var(--red); background:#fff8f8; }
.del-btn  { width:30px; height:30px; border:none; border-radius:7px; background:#fef2f2; color:var(--red);  cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.del-btn:hover  { background:var(--red);  color:#fff; }
.view-btn { width:30px; height:30px; border:none; border-radius:7px; background:#eff6ff; color:var(--blue); cursor:pointer; font-size:14px; display:inline-flex; align-items:center; justify-content:center; transition:.12s; }
.view-btn:hover { background:var(--blue); color:#fff; }

/* Receive button */
.receive-btn {
    width:100%; padding:14px; border:none; border-radius:12px;
    font-size:15px; font-weight:700; font-family:inherit; cursor:pointer;
    transition:.2s; background:var(--blue); color:#fff; margin-top:16px;
}
.receive-btn:disabled { background:#e5e7eb; color:#9ca3af; cursor:not-allowed; }
.receive-btn:not(:disabled):hover { background:var(--blue-dk); }

/* Options toggles */
.opt-row { display:flex; align-items:center; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f4f4f7; }
.opt-row:last-child { border-bottom:none; }
.toggle-wrap { position:relative; display:inline-block; width:38px; height:22px; flex-shrink:0; }
.toggle-wrap input { opacity:0; width:0; height:0; }
.toggle-slider { position:absolute; inset:0; background:#e5e7eb; border-radius:22px; cursor:pointer; transition:.2s; }
.toggle-slider:before { content:''; position:absolute; left:3px; bottom:3px; width:16px; height:16px; background:#fff; border-radius:50%; transition:.2s; box-shadow:0 1px 3px rgba(0,0,0,.2); }
.toggle-wrap input:checked + .toggle-slider { background:var(--blue); }
.toggle-wrap input:checked + .toggle-slider:before { transform:translateX(16px); }

/* Toast */
.toast-wrap { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
.toast-item { padding:11px 20px; border-radius:10px; font-size:13px; font-weight:600; color:#fff; box-shadow:0 4px 16px rgba(0,0,0,.18); animation:tIn .25s ease; min-width:160px; }
.toast-ok   { background:var(--green); }
.toast-err  { background:var(--red); }
.toast-warn { background:#d97706; }
@@keyframes tIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:none} }
</style>

<div class="toast-wrap" id="toastWrap"></div>

<!-- Header -->
<div class="page-header">
    <div>
        <h2 style="display:flex;align-items:center;gap:10px;margin:0">
            Receive Materials
            <i class="bi bi-inbox me-1" style="color:#fff;opacity:.85"></i>
        </h2>
    </div>
</div>

<!-- Work Order + Location + Camera -->
<div class="rx-card">
    <div class="rx-card-body">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
            <!-- Work Order -->
            <div style="flex:1;min-width:180px">
                <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                    <i class="bi bi-box-seam me-1" style="color:var(--blue)"></i> Work Order <span style="color:var(--red)">*</span>
                </div>
                <div class="loc-wrap">
                    <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                    <input id="woSearch" class="loc-input"
                           placeholder="ค้นหา Work Order..."
                           autocomplete="off"
                           oninput="searchWorkOrder()"
                           onkeydown="if(event.key==='Enter'){const v=this.value.trim();if(v){currentWO=v;rxShowError('woSearch',false);hideWODropdown();updateReceiveBtn();}event.preventDefault();}"
                           onblur="setTimeout(hideWODropdown, 200)">
                    <div id="woDropdown" class="loc-dd"></div>
                </div>
            </div>
            <!-- Location -->
            <div style="flex:1;min-width:180px">
                <div style="font-size:12px;font-weight:700;color:var(--t2);margin-bottom:7px">
                    <i class="bi bi-geo-alt-fill me-1" style="color:var(--blue)"></i>Location <span style="color:var(--red)">*</span>
                </div>
                <div class="loc-wrap">
                    <i class="bi bi-search loc-icon" style="font-size:14px"></i>
                    <input id="locationSearch" class="loc-input"
                           placeholder="ค้นหา Location..."
                           autocomplete="off"
                           oninput="searchLocation()"
                           onkeydown="if(event.key==='Enter'){const v=this.value.trim();if(v){document.getElementById('locationId').value=v;rxShowError('locationSearch',false);hideLocationDropdown();updateReceiveBtn();}event.preventDefault();}"
                           onblur="setTimeout(hideLocationDropdown, 200)">
                    <input type="hidden" id="locationId">
                    <div id="locationDropdown" class="loc-dd"></div>
                </div>
            </div>
            <!-- Camera button -->
            <button id="cameraBtn" onclick="toggleScan()"
                    style="height:44px;padding:0 20px;background:var(--blue);color:#fff;
                           border:none;border-radius:10px;font-size:14px;font-weight:700;
                           cursor:pointer;font-family:inherit;transition:.2s;white-space:nowrap;
                           display:flex;align-items:center;gap:8px;flex-shrink:0">
                <i class="bi bi-camera" style="font-size:20px"></i>
            </button>
            <!-- HW Scanner button -->
            <button id="hwScanBtn" onclick="toggleHwScan()"
                    style="height:44px;padding:0 20px;background:#6b7280;color:#fff;
                           border:none;border-radius:10px;font-size:14px;font-weight:700;
                           cursor:pointer;font-family:inherit;transition:.2s;white-space:nowrap;
                           display:flex;align-items:center;gap:8px;flex-shrink:0"
                    title="Hardware Barcode Scanner">
                <i class="bi bi-upc-scan" style="font-size:20px"></i>
            </button>
        </div>
    </div>
</div>

<!-- Scanner (hidden until open) -->
<div id="scannerSection" style="display:none" class="rx-card">
    <div class="rx-card-body" style="padding-top:16px;padding-bottom:16px">
        <div class="scanner-box">
            <video id="rcVideo" autoplay playsinline muted></video>
            <canvas id="rcCanvas"></canvas>
            <div class="rc-detected-label" id="rcLabel">— ยังไม่พบ barcode —</div>
        </div>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:14px">
            <button onclick="switchCamera()"
                    style="padding:9px 20px;border:1.5px solid var(--border);border-radius:9px;
                           background:#fff;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s"
                    onmouseover="this.style.borderColor='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)'">
                <i class="bi bi-arrow-repeat me-1"></i>สลับกล้อง
            </button>
            <button onclick="stopScan()"
                    style="padding:9px 20px;border:none;border-radius:9px;background:#fee2e2;
                           color:var(--red);font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                ⏹ หยุด
            </button>
        </div>
        <div id="scanStatus" style="text-align:center;font-size:13px;color:var(--t2);margin-top:10px;min-height:18px">
            กำลังสแกน…
        </div>
    </div>
</div>

<!-- Items table (always visible) -->
<div class="rx-card" style="overflow:hidden">
    <div style="padding:12px 18px;border-bottom:1px solid var(--border);
                display:flex;align-items:center;justify-content:space-between;gap:10px">
        <span style="font-size:13px;font-weight:700;color:var(--navy);display:flex;align-items:center;gap:8px">
            <i class="bi bi-inbox me-1" style="color:var(--blue)"></i> Receiving Items
            <span id="itemCountBadge"
                  style="background:var(--blue-lt);color:var(--blue);
                         padding:2px 12px;border-radius:20px;font-size:12px;font-weight:700">
                0/10
            </span>
        </span>
        <div style="display:flex;align-items:center;gap:8px">
            <button onclick="openManualEntry()"
                    style="padding:5px 14px;border:1.5px solid var(--border);border-radius:7px;
                           background:#fff;color:var(--t2);font-size:12px;font-weight:600;
                           cursor:pointer;font-family:inherit;transition:.15s;white-space:nowrap"
                    onmouseover="this.style.borderColor='var(--blue)';this.style.color='var(--blue)'"
                    onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--t2)'">
                <i class="bi bi-pencil me-1"></i>Manual
            </button>
        </div>
    </div>
    <!-- HW Scanner Section (inline) -->
    <div id="hwScanSection" style="display:none;padding:12px 16px;border-bottom:1px solid var(--border);background:#f8faff">
        <div style="position:relative">
            <i class="bi bi-upc-scan" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--blue);font-size:16px;pointer-events:none"></i>
            <input id="hwScanInput"
                   class="loc-input"
                   style="padding-left:38px;border-color:var(--blue);background:#fff"
                   placeholder="พร้อมสแกน — สแกน barcode ได้เลย..."
                   autocomplete="off"
                   onkeydown="onHwScanKey(event)"
                   oninput="onHwScanInput()">
        </div>
        <div id="hwScanStatus" style="text-align:center;font-size:13px;color:var(--t2);margin-top:8px;min-height:18px">พร้อมสแกน…</div>
    </div>

    <div id="receivingTableWrap">
        <table class="rx-table">
            <thead>
                <tr>
                    <th>Part No</th>
                    <th>Description</th>
                    <th style="width:110px">Qty</th>
                    <th style="width:80px">Unit</th>
                    <th style="width:46px"></th>
                </tr>
            </thead>
            <tbody id="receivingTable"></tbody>
        </table>
        <div id="emptyState" style="text-align:center;padding:32px;color:var(--t3);font-size:13px">
            <i class="bi bi-inbox" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4"></i>
            ยังไม่มีรายการ — สแกน QR หรือกด Manual
        </div>
    </div>
</div>

<div id="scanResultSection">
    <!-- Advanced Options (collapsible) -->
    <div class="rx-card" id="rcAdvancedOptions" style="margin-bottom:8px;display:none">
        <div class="rx-card-body" style="padding:12px 18px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none" onclick="toggleOptions()">
            <span style="font-size:13px;font-weight:700;color:var(--navy)">
                <i class="bi bi-sliders me-1" style="color:var(--t2)"></i> Advanced Options
            </span>
            <i class="bi bi-chevron-down" id="optIcon" style="color:var(--t2);font-size:13px;transition:transform .2s"></i>
        </div>
        <div id="optBody" style="display:none;padding:0 18px 4px;border-top:1px solid var(--border)">
            <div style="padding-top:4px">
                <div class="opt-row">
                    <div style="font-size:13px;color:var(--text)">Skip GPS Validation</div>
                    <label class="toggle-wrap"><input type="checkbox" id="optSkipGps"><span class="toggle-slider"></span></label>
                </div>
                <div class="opt-row">
                    <div style="font-size:13px;color:var(--text)">Skip Printed Validation</div>
                    <label class="toggle-wrap"><input type="checkbox" id="optSkipPrinted"><span class="toggle-slider"></span></label>
                </div>
                <div class="opt-row">
                    <div style="font-size:13px;color:var(--text)">Skip Work Order Validation</div>
                    <label class="toggle-wrap"><input type="checkbox" id="optSkipWO"><span class="toggle-slider"></span></label>
                </div>
                <div class="opt-row">
                    <div style="font-size:13px;color:var(--text)">Skip Location Validation</div>
                    <label class="toggle-wrap"><input type="checkbox" id="optSkipLoc"><span class="toggle-slider"></span></label>
                </div>
                <div class="opt-row">
                    <div style="font-size:13px;color:var(--text)">Skip Lot Duplicate Validation</div>
                    <label class="toggle-wrap"><input type="checkbox" id="optSkipDup"><span class="toggle-slider"></span></label>
                </div>
                <div class="opt-row">
                    <div style="font-size:13px;color:var(--text)">Skip Reserved Lot Validation</div>
                    <label class="toggle-wrap"><input type="checkbox" id="optSkipRes"><span class="toggle-slider"></span></label>
                </div>
                <div class="opt-row">
                    <div style="font-size:13px;color:var(--text)">Skip Manual Lot Validation</div>
                    <label class="toggle-wrap"><input type="checkbox" id="optSkipManual"><span class="toggle-slider"></span></label>
                </div>
            </div>
        </div>
    </div>
    <button class="receive-btn" id="receiveBtn" onclick="receive()" disabled>
        Receive
    </button>
</div>

<!-- Manual Entry Modal -->
<div class="modal fade" id="manualModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.18)">
            <div class="modal-header" style="border-bottom:1px solid var(--border);padding:16px 20px">
                <h5 id="manualModalTitle" class="modal-title" style="font-size:15px;font-weight:700;color:var(--navy)">
                    <i class="bi bi-pencil-square me-2" style="color:var(--blue)"></i>Manual Entry
                </h5>
                <button type="button" data-bs-dismiss="modal"
                        style="background:none;border:none;cursor:pointer;color:var(--t3);font-size:20px;line-height:1;padding:0;margin-left:auto"
                        onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--t3)'">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body" style="padding:0;max-height:70vh;overflow-y:auto">
                <table style="width:100%;border-collapse:collapse;font-size:13px">
                    <thead>
                        <tr>
                            <th style="padding:10px 16px;background:#f8f9fc;color:var(--t2);font-weight:700;font-size:11px;letter-spacing:.04em;text-transform:uppercase;border-bottom:2px solid var(--border);width:110px">Field</th>
                            <th style="padding:10px 16px;background:#f8f9fc;color:var(--t2);font-weight:700;font-size:11px;letter-spacing:.04em;text-transform:uppercase;border-bottom:2px solid var(--border)">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">P/N <span style="color:var(--red)">*</span></td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)">
                                <input id="mePn" class="rx-input" placeholder="Part No." style="width:100%"
                                       oninput="searchManualPn()" autocomplete="off"
                                       onblur="setTimeout(hidePnDropdown, 200)">
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">QTY <span style="color:var(--red)">*</span></td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meQty" class="rx-input" inputmode="decimal" placeholder="QTY" value="1" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">UNIT <span style="color:var(--red)">*</span></td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meUnit" class="rx-input" placeholder="UNIT" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">Item Type</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)">
                                <select id="meItemType" class="rx-input" style="width:100%;cursor:pointer">
                                    <option value="">— Loading… —</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">Description</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meDesc" class="rx-input" placeholder="Description" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">VENDOR</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meVendor" class="rx-input" placeholder="VENDOR" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">D/C</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meDc" class="rx-input" placeholder="Date Code" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">T/C</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meTc" class="rx-input" placeholder="Trading Code" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">PO</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="mePo" class="rx-input" placeholder="PO" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">I/N</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meIn" class="rx-input" placeholder="I/N" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">TRACE ID</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meTrace" class="rx-input" placeholder="Trace ID" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">W/O</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)">
                                <input id="meWo" class="rx-input" placeholder="MO Number" style="width:100%"
                                       oninput="searchModalWo()" autocomplete="off"
                                       onblur="setTimeout(hideWoModalDropdown, 200)">
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;border-bottom:1px solid var(--border);font-weight:600;color:var(--navy)">LINE</td>
                            <td style="padding:6px 16px;border-bottom:1px solid var(--border)"><input id="meLine" class="rx-input" placeholder="LINE" style="width:100%"></td>
                        </tr>
                        <tr>
                            <td style="padding:8px 16px;font-weight:600;color:var(--t2);font-size:12px">LOT NO</td>
                            <td style="padding:6px 16px">
                                <input id="meLotNo" class="rx-input" placeholder="auto-gen after add item" readonly
                                       style="width:100%;background:#f8f9fc;color:var(--t2);cursor:default">
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--border);padding:14px 20px;justify-content:space-between">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal"
                        style="font-size:13px;font-weight:600">Cancel</button>
                <button id="manualSubmitBtn" type="button" onclick="submitManualEntry()"
                        style="padding:8px 24px;border:none;border-radius:9px;background:var(--blue);
                               color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                    + Add Item
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius:14px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.18)">
            <div class="modal-body" style="padding:28px 20px 16px;text-align:center">
                <i class="bi bi-trash3" style="font-size:36px;color:var(--red);display:block;margin-bottom:12px"></i>
                <p style="font-size:14px;font-weight:700;color:var(--navy);margin:0 0 4px">ลบรายการนี้?</p>
                <p id="deletePartLabel" style="font-size:12px;color:var(--t2);margin:0;word-break:break-all"></p>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--border);padding:12px 20px;justify-content:space-between">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal"
                        style="font-size:13px;font-weight:600">ยกเลิก</button>
                <button type="button" onclick="confirmDelete()"
                        style="padding:8px 24px;border:none;border-radius:9px;background:var(--red);
                               color:#fff;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
                    ลบ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Autocomplete dropdowns (fixed-pos — avoids modal overflow:auto clipping) -->
<div id="pnDropdown"       class="loc-dd" style="position:fixed;z-index:9999;display:none;min-width:200px"></div>
<div id="woModalDropdown"  class="loc-dd" style="position:fixed;z-index:9999;display:none;min-width:200px"></div>

@section Scripts {
    <script src="/js/api.js"></script>
    <script>
        let rcStream = null, rcRafId = null, rcDetector = null;
        let scannerRunning = false;

        // ── Role: show Advanced Options for admin only ──
        (function() {
            const adminRoles = ['Admin', 'Inventory_Admin', 'Admin_WH', 'Supervisor'];
            try {
                const user = JSON.parse(localStorage.getItem('user') || '{}');
                if (adminRoles.includes(user.role))
                    document.getElementById('rcAdvancedOptions').style.display = '';
            } catch (_) {}
        })();
        let facingMode = "environment";
        let scannedTrace = new Set(), pendingScan = new Set();
        let currentWO = null, currentLine = null, lastScanTime = 0;
        let _rxReceiving = false;

        function rxShowError(id, show) {
            const el = document.getElementById(id);
            if (!el) return;
            el.style.transition  = "border-color .15s, box-shadow .15s";
            el.style.borderColor = show ? "var(--red)" : "";
            el.style.boxShadow   = show ? "0 0 0 3px rgba(220,38,38,.15)" : "";
        }

        window.addEventListener("beforeunload", stopScan);

        // ── Camera ─────────────────────────────────────
        function toggleScan() { if (scannerRunning) stopScan(); else startScan(); }

        function setCameraBtn(running) {
            const btn = document.getElementById("cameraBtn");
            if (running) {
                btn.style.background = "#dc2626";
                btn.onmouseover = () => btn.style.background = "#b91c1c";
                btn.onmouseout  = () => btn.style.background = "#dc2626";
            } else {
                btn.style.background = "var(--blue)";
                btn.onmouseover = () => btn.style.background = "var(--blue-dk)";
                btn.onmouseout  = () => btn.style.background = "var(--blue)";
            }
        }

        async function startScan() {
            if (!('BarcodeDetector' in window)) {
                toast("เบราว์เซอร์นี้ไม่รองรับ BarcodeDetector", "err"); return;
            }
            document.getElementById("scannerSection").style.display = "";
            document.getElementById("scanStatus").textContent = "กำลังสแกน…";
            setCameraBtn(true);
            try {
                rcStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode, width: { ideal: 1280 }, height: { ideal: 720 } }
                });
            } catch {
                try {
                    rcStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } });
                    facingMode = "user";
                } catch (e2) {
                    toast("ไม่สามารถเข้าถึงกล้อง: " + e2.message, "err");
                    document.getElementById("scannerSection").style.display = "none";
                    setCameraBtn(false);
                    return;
                }
            }
            const video = document.getElementById("rcVideo");
            video.srcObject = rcStream;
            await video.play();
            const formats = await BarcodeDetector.getSupportedFormats();
            rcDetector = new BarcodeDetector({ formats });
            scannerRunning = true;
            rcDetectLoop();
        }

        function rcDetectLoop() {
            if (!scannerRunning) return;
            const video  = document.getElementById("rcVideo");
            const canvas = document.getElementById("rcCanvas");
            const label  = document.getElementById("rcLabel");
            const ctx    = canvas.getContext("2d");

            const dw = canvas.offsetWidth, dh = canvas.offsetHeight;
            if (canvas.width !== dw || canvas.height !== dh) {
                canvas.width  = dw;
                canvas.height = dh;
            }

            if (video.readyState < 2) {
                rcRafId = requestAnimationFrame(rcDetectLoop);
                return;
            }

            rcDetector.detect(video).then(results => {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                if (results.length > 0) {
                    const scaleX = canvas.width  / (video.videoWidth  || canvas.width);
                    const scaleY = canvas.height / (video.videoHeight || canvas.height);
                    results.forEach(b => {
                        const x = b.boundingBox.x * scaleX;
                        const y = b.boundingBox.y * scaleY;
                        const w = b.boundingBox.width  * scaleX;
                        const h = b.boundingBox.height * scaleY;
                        ctx.strokeStyle = "#60a5fa";
                        ctx.lineWidth   = 3;
                        ctx.strokeRect(x, y, w, h);
                        const tagY = y > 24 ? y - 4 : y + h + 16;
                        ctx.fillStyle = "rgba(26,111,255,.88)";
                        ctx.fillRect(x, tagY - 16, Math.min(w, 180), 18);
                        ctx.fillStyle = "#fff";
                        ctx.font = "bold 11px sans-serif";
                        ctx.fillText(b.format.replace("_"," ").toUpperCase(), x + 4, tagY);
                    });
                    const first = results[0];
                    label.textContent = `${first.format}: ${first.rawValue}`;
                    scanBarcodeApi(first.rawValue);
                } else {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    label.textContent = "— กำลังค้นหา barcode —";
                }
                if (scannerRunning) rcRafId = requestAnimationFrame(rcDetectLoop);
            }).catch(() => {
                if (scannerRunning) rcRafId = requestAnimationFrame(rcDetectLoop);
            });
        }

        function stopScan() {
            scannerRunning = false;
            cancelAnimationFrame(rcRafId);
            if (rcStream) { rcStream.getTracks().forEach(t => t.stop()); rcStream = null; }
            const video = document.getElementById("rcVideo");
            if (video) video.srcObject = null;
            const canvas = document.getElementById("rcCanvas");
            if (canvas) canvas.getContext("2d").clearRect(0, 0, canvas.width, canvas.height);
            const label = document.getElementById("rcLabel");
            if (label) label.textContent = "— ยังไม่พบ barcode —";
            document.getElementById("scannerSection").style.display = "none";
            setCameraBtn(false);
        }

        async function switchCamera() {
            if (!scannerRunning) return;
            facingMode = facingMode === "environment" ? "user" : "environment";
            scannerRunning = false;
            cancelAnimationFrame(rcRafId);
            if (rcStream) { rcStream.getTracks().forEach(t => t.stop()); rcStream = null; }
            await startScan();
        }

        // ── Scan — POST /scan ─────────────────────
        function canScan() {
            const now = Date.now();
            if (now - lastScanTime < 1500) return false;
            lastScanTime = now;
            return true;
        }

        async function doReceiveScan(rawCode, onStatus) {
            rawCode = rawCode.trim();
            if (!rawCode || pendingScan.has(rawCode)) return;
            pendingScan.add(rawCode);
            onStatus?.("⏳ กำลังตรวจสอบ…");

            try {
                const res = await api("/scan", "POST", { barcode: rawCode, mode: 0 });
                const scanData = Array.isArray(res) ? (res[0] ?? {}) : (res ?? {});

                const traceId = scanData.wH_TraceId || scanData.traceId || rawCode;
                if (scannedTrace.has(traceId)) { toast("สแกนซ้ำ", "err"); return; }

                const newWO = scanData.workOrderNo || scanData.workOrder || null;
                if (newWO && currentWO && newWO !== currentWO) {
                    toast(`❌ W/O ไม่ตรง — กำลัง receive W/O: ${currentWO}`, "err"); return;
                }
                if (newWO) currentWO = newWO;

                scannedTrace.add(traceId);
                await addRow(scanData.partNo || "", scanData.quantity || 1, scanData.unit || "", traceId, {
                    vendor:      scanData.vendor      || "",
                    dateCode:    scanData.dateCode    || "",
                    tradingCode: scanData.tradingCode || "",
                    po:          scanData.po          || "",
                    inventoryNo: scanData.inventoryNo || "",
                    lotNo:       scanData.lotNo       || "",
                });
                toast(scanData.message || "สแกนสำเร็จ ✓", "ok");
                onStatus?.("กำลังสแกน…");

            } catch (err) {
                toast(err.message || "Scan ล้มเหลว", "err");
                onStatus?.("❌ " + (err.message || "Error"));
            } finally {
                pendingScan.delete(rawCode);
            }
        }

        async function scanBarcodeApi(code) {
            if (!canScan()) return;
            await doReceiveScan(code, t => { document.getElementById("scanStatus").textContent = t; });
        }

        // ── Hardware barcode scanner (keyboard wedge) ──
        let hwScanActive = false, hwAutoTimer = null;

        function toggleHwScan() {
            hwScanActive = !hwScanActive;
            const section = document.getElementById("hwScanSection");
            const btn     = document.getElementById("hwScanBtn");
            if (hwScanActive) {
                section.style.display = "";
                btn.style.background  = "#dc2626";
                btn.onmouseover = () => btn.style.background = "#b91c1c";
                btn.onmouseout  = () => btn.style.background = "#dc2626";
                setTimeout(() => document.getElementById("hwScanInput").focus(), 80);
            } else {
                section.style.display = "none";
                btn.style.background  = "#6b7280";
                btn.onmouseover = () => btn.style.background = "#4b5563";
                btn.onmouseout  = () => btn.style.background = "#6b7280";
            }
        }

        async function processHwScan(code) {
            const input  = document.getElementById("hwScanInput");
            const status = document.getElementById("hwScanStatus");
            input.value = "";
            if (!code || code.length < 2) { input.focus(); return; }
            await doReceiveScan(code, t => { status.textContent = t; });
            setTimeout(() => {
                if (hwScanActive) {
                    status.textContent = "พร้อมสแกน…";
                    input.focus();
                }
            }, 1200);
        }

        function onHwScanKey(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                clearTimeout(hwAutoTimer);
                const code = document.getElementById("hwScanInput").value.trim();
                processHwScan(code);
            }
        }

        function onHwScanInput() {
            // Auto-commit after 300ms silence (for scanners that don't send Enter)
            clearTimeout(hwAutoTimer);
            hwAutoTimer = setTimeout(() => {
                const code = document.getElementById("hwScanInput").value.trim();
                if (code.length > 3) processHwScan(code);
            }, 300);
        }

        // ── Table ──────────────────────────────────────
        async function addRow(partNo, qty, unit, traceId, extras = {}) {
            if (document.querySelectorAll("#receivingTable tr").length >= 10) {
                toast("ครบ 10 รายการแล้ว", "err"); return;
            }
            try {
                const res = await api("/inventory/new-lotNo", "GET");
                extras.lotNo = res.lotNo || "";
            } catch (_) { extras.lotNo = extras.lotNo || ""; }

            let desc = extras.description || "";
            let finalUnit = unit;
            if (!desc) {
                try {
                    const item = await api(`/master/items/${partNo}`, "GET");
                    desc = item.itemName || "";
                    finalUnit = item.baseUnit || unit;
                } catch {}
            }

            const vendor      = extras.vendor || "";
            const dateCode    = extras.dateCode || "";
            const tradingCode = extras.tradingCode || "";
            const po          = extras.po || "";
            const inventoryNo = extras.inventoryNo || "";
            const itemType    = extras.itemType || 1;

            const tbody = document.getElementById("receivingTable");
            tbody.insertAdjacentHTML("beforeend", `
                <tr>
                    <td style="font-weight:700;color:var(--navy)"></td>
                    <td><input class="rx-input desc ${desc ? '' : 'err'}" placeholder="ระบุชื่อ..."></td>
                    <td><input class="rx-input qty" type="number" value="${qty}" min="1" style="width:90px;text-align:center" oninput="updateReceiveBtn()"></td>
                    <td><input class="rx-input unit" style="width:68px"></td>
                    <td style="display:none"><input class="traceId"></td>
                    <td style="display:none"><input class="rowVendor"></td>
                    <td style="display:none"><input class="rowDc"></td>
                    <td style="display:none"><input class="rowTc"></td>
                    <td style="display:none"><input class="rowPo"></td>
                    <td style="display:none"><input class="rowIn"></td>
                    <td style="display:none"><input class="rowLotNo"></td>
                    <td style="display:none"><input class="rowItemType"></td>
                    <td style="white-space:nowrap">
                        <button class="view-btn me-1" onclick="viewRowData(this)" title="View / Edit"><i class="bi bi-pencil"></i></button>
                        <button class="del-btn" onclick="removeRow(this)" title="Remove"><i class="bi bi-trash3"></i></button>
                    </td>
                </tr>`);

            // Set values via JS — avoids HTML encoding issues that break scannedTrace lookup
            const row = tbody.lastElementChild;
            row.querySelector("td:first-child").textContent = partNo;
            row.querySelector(".desc").value        = desc;
            row.querySelector(".unit").value        = finalUnit;
            row.querySelector(".traceId").value     = traceId;
            row.querySelector(".rowVendor").value   = vendor;
            row.querySelector(".rowDc").value       = dateCode;
            row.querySelector(".rowTc").value       = tradingCode;
            row.querySelector(".rowPo").value       = po;
            row.querySelector(".rowIn").value       = inventoryNo;
            row.querySelector(".rowLotNo").value    = extras.lotNo || "";
            row.querySelector(".rowItemType").value = String(itemType);

            showScanSection();
        }

        let pendingDeleteRow = null;

        function showRowError(row, errMsg) {
            row.classList.add('row-err')
            row.style.pointerEvents = ''; row.style.opacity = ''
            const actionTd = row.querySelector('td:last-child')
            if (actionTd) actionTd.innerHTML = `
                <div style="display:flex;gap:4px">
                    <button class="view-btn" onclick="viewRowData(this)" title="View / Edit"><i class="bi bi-pencil"></i></button>
                    <button class="del-btn" onclick="removeRow(this)" title="Remove"><i class="bi bi-trash3"></i></button>
                </div>`
            const existing = row.nextElementSibling
            if (existing?.classList.contains('row-err-detail')) existing.remove()
            row.insertAdjacentHTML('afterend', `
                <tr class="row-err-detail">
                    <td colspan="5"><span style="font-size:11px;color:var(--red);font-weight:600">${esc(errMsg)}</span></td>
                </tr>`)
        }

        function removeRow(btn) {
            pendingDeleteRow = btn.closest("tr");
            const partNo = pendingDeleteRow.querySelector("td:first-child").textContent.trim();
            document.getElementById("deletePartLabel").textContent = partNo;
            new bootstrap.Modal(document.getElementById("confirmDeleteModal")).show();
        }

        function confirmDelete() {
            if (!pendingDeleteRow) return;
            const traceId = pendingDeleteRow.querySelector(".traceId")?.value;
            if (traceId) scannedTrace.delete(traceId);
            const nextRow = pendingDeleteRow.nextElementSibling
            if (nextRow?.classList.contains('row-err-detail')) nextRow.remove()
            pendingDeleteRow.remove();
            pendingDeleteRow = null;
            bootstrap.Modal.getInstance(document.getElementById("confirmDeleteModal")).hide();
            syncTableState();
        }

        function showScanSection() {
            syncWODisplay();
            syncTableState();
        }

        function syncTableState() {
            const count = document.querySelectorAll("#receivingTable tr").length;
            document.getElementById("itemCountBadge").textContent = count + "/10";
            document.getElementById("emptyState").style.display  = count === 0 ? "" : "none";
            updateReceiveBtn();
        }

        // ── P/N autocomplete ───────────────────────────
        let pnResults = [], pnSearchTimer = null;

        function searchManualPn() {
            const input = document.getElementById("mePn");
            const text  = input.value.trim();
            const dd    = document.getElementById("pnDropdown");

            if (!text) { dd.style.display = "none"; return; }

            const rect = input.getBoundingClientRect();
            dd.style.top   = (rect.bottom + 4) + "px";
            dd.style.left  = rect.left + "px";
            dd.style.width = rect.width + "px";

            dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
            </div>`;
            dd.style.display = "block";

            clearTimeout(pnSearchTimer);
            pnSearchTimer = setTimeout(async () => {
                try {
                    const json = await api(`/master/items?search=${encodeURIComponent(text)}&page=1&pageSize=20`, "GET");
                    pnResults = json.data || [];
                    if (!pnResults.length) {
                        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                            <i class="bi bi-search me-2"></i>ไม่พบรายการ
                        </div>`;
                        return;
                    }
                    dd.innerHTML = pnResults.map((x, i) => `
                        <div class="loc-item" onmousedown="selectManualItem(${i})">
                            <i class="bi bi-box" style="color:var(--blue);flex-shrink:0"></i>
                            <span>
                                <strong>${x.partNo}</strong>
                                <span style="color:var(--t2);font-size:12px;margin-left:6px">${x.itemName || ''}</span>
                            </span>
                            ${x.baseUnit ? `<span style="margin-left:auto;font-size:11px;color:var(--t3)">${x.baseUnit}</span>` : ''}
                        </div>`).join("");
                } catch {
                    dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                        <i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ
                    </div>`;
                }
            }, 300);
        }

        function selectManualItem(i) {
            const x = pnResults[i];
            document.getElementById("mePn").value   = x.partNo;
            document.getElementById("meDesc").value = x.itemName || "";
            if (x.baseUnit) document.getElementById("meUnit").value = x.baseUnit;
            document.getElementById("mePn").classList.remove("err");
            hidePnDropdown();
        }

        function hidePnDropdown() {
            document.getElementById("pnDropdown").style.display = "none";
            // auto-fill desc/unit if the typed P/N exactly matches a cached result
            const partNo = document.getElementById("mePn").value.trim();
            if (!partNo) return;
            const match = pnResults.find(x => x.partNo === partNo);
            if (match) {
                if (!document.getElementById("meDesc").value) document.getElementById("meDesc").value = match.itemName || "";
                if (match.baseUnit) document.getElementById("meUnit").value = match.baseUnit;
            }
        }

        // ── Item Type loader ───────────────────────────
        let itemTypeCache = null;

        async function loadItemTypes() {
            const sel = document.getElementById("meItemType");
            if (itemTypeCache) {
                renderItemTypes(sel, itemTypeCache); return Promise.resolve();
            }
            sel.innerHTML = '<option value="">— Loading… —</option>';
            try {
                itemTypeCache = await api("/master/items/item-type", "GET");
                renderItemTypes(sel, itemTypeCache);
            } catch {
                sel.innerHTML = '<option value="">— โหลดไม่สำเร็จ —</option>';
            }
        }

        function renderItemTypes(sel, list) {
            sel.innerHTML = '<option value="">— เลือก Item Type —</option>' +
                list.map(x => `<option value="${x.id}">${x.name}</option>`).join("");
            // default to Material (id=1)
            sel.value = "1";
        }

        // ── W/O modal autocomplete ─────────────────────
        let woModalResults = [], woModalTimer = null;

        function searchModalWo() {
            const input = document.getElementById("meWo");
            const text  = input.value.trim();
            const dd    = document.getElementById("woModalDropdown");

            if (!text) { dd.style.display = "none"; return; }

            const rect = input.getBoundingClientRect();
            dd.style.top   = (rect.bottom + 4) + "px";
            dd.style.left  = rect.left + "px";
            dd.style.width = rect.width + "px";

            dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
            </div>`;
            dd.style.display = "block";

            clearTimeout(woModalTimer);
            woModalTimer = setTimeout(async () => {
                try {
                    const json = await api(`/workorder?Page=1&PageSize=10&Search=${encodeURIComponent(text)}`, "GET");
                    woModalResults = json.data || [];
                    if (!woModalResults.length) {
                        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                            <i class="bi bi-search me-2"></i>ไม่พบ Work Order
                        </div>`;
                        return;
                    }
                    dd.innerHTML = woModalResults.map((x, i) => `
                        <div class="loc-item" onmousedown="selectModalWo(${i})">
                            <i class="bi bi-box-seam" style="color:var(--blue);flex-shrink:0"></i>
                            <span>
                                <strong>${x.moNumber}</strong>
                                ${x.modelName ? '<span style="color:var(--t2);font-size:12px;margin-left:6px">' + x.modelName + '</span>' : ''}
                            </span>
                            ${x.lineName ? '<span style="margin-left:auto;font-size:11px;color:var(--t3)">' + x.lineName + '</span>' : ''}
                        </div>`).join("");
                } catch {
                    dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                        <i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ
                    </div>`;
                }
            }, 300);
        }

        function selectModalWo(i) {
            const x = woModalResults[i];
            document.getElementById("meWo").value   = x.moNumber;
            if (x.lineName) document.getElementById("meLine").value = x.lineName;
            hideWoModalDropdown();
        }

        function hideWoModalDropdown() {
            document.getElementById("woModalDropdown").style.display = "none";
        }

        let editingRow = null;

        function openManualEntry() {
            editingRow = null;
            document.getElementById("manualModalTitle").innerHTML =
                '<i class="bi bi-pencil-square me-2" style="color:var(--blue)"></i>Manual Entry';
            document.getElementById("manualSubmitBtn").textContent = "+ Add Item";
            fillManualModal({ wo: currentWO || "", line: currentLine || "" });
            new bootstrap.Modal(document.getElementById("manualModal")).show();
        }

        function viewRowData(btn) {
            editingRow = btn.closest("tr");
            document.getElementById("manualModalTitle").innerHTML =
                '<i class="bi bi-pencil me-2" style="color:var(--blue)"></i>View / Edit Item';
            document.getElementById("manualSubmitBtn").textContent = "Update Item";
            fillManualModal({
                partNo:      editingRow.querySelector("td:first-child").textContent.trim(),
                qty:         editingRow.querySelector(".qty").value,
                unit:        editingRow.querySelector(".unit").value,
                desc:        editingRow.querySelector(".desc").value,
                vendor:      editingRow.querySelector(".rowVendor").value,
                dateCode:    editingRow.querySelector(".rowDc").value,
                tradingCode: editingRow.querySelector(".rowTc").value,
                po:          editingRow.querySelector(".rowPo").value,
                inventoryNo: editingRow.querySelector(".rowIn").value,
                lotNo:       editingRow.querySelector(".rowLotNo").value,
                traceId:     editingRow.querySelector(".traceId").value,
                itemType:    editingRow.querySelector(".rowItemType").value || "1",
                wo:          currentWO || "",
                line:        currentLine || "",
            });
            new bootstrap.Modal(document.getElementById("manualModal")).show();
        }

        function fillManualModal(d = {}) {
            document.getElementById("mePn").value     = d.partNo    || "";
            document.getElementById("meQty").value    = d.qty       || "1";
            document.getElementById("meUnit").value   = d.unit      || "";
            document.getElementById("meDesc").value   = d.desc      || "";
            document.getElementById("meVendor").value = d.vendor    || "";
            document.getElementById("meDc").value     = d.dateCode  || "";
            document.getElementById("meTc").value     = d.tradingCode || "";
            document.getElementById("mePo").value     = d.po        || "";
            document.getElementById("meIn").value     = d.inventoryNo || "";
            document.getElementById("meTrace").value  = d.traceId   || "";
            document.getElementById("meWo").value     = d.wo    || "";
            document.getElementById("meLine").value   = d.line  || "";
            document.getElementById("meLotNo").value  = d.lotNo || "";
            document.querySelectorAll("#manualModal .rx-input").forEach(el => el.classList.remove("err"));
            pnResults = []; woModalResults = [];
            loadItemTypes().then(() => {
                if (d.itemType) document.getElementById("meItemType").value = d.itemType;
            });
        }

        async function submitManualEntry() {
            const partNo   = document.getElementById("mePn").value.trim();
            const qty      = parseFloat(document.getElementById("meQty").value) || 0;
            const unit     = document.getElementById("meUnit").value.trim() || "PCS";
            const itemType = parseInt(document.getElementById("meItemType").value) || 1;

            let valid = true;
            if (!partNo) { document.getElementById("mePn").classList.add("err");  valid = false; }
            if (qty <= 0) { document.getElementById("meQty").classList.add("err"); valid = false; }
            if (!valid) return;

            const traceId = document.getElementById("meTrace").value.trim() || ("MANUAL-" + Date.now());
            const wo      = document.getElementById("meWo").value.trim();
            if (wo) {
                currentWO = wo;
                document.getElementById("woSearch").value = wo;
            }

            const extras = {
                description:  document.getElementById("meDesc").value.trim(),
                vendor:       document.getElementById("meVendor").value.trim(),
                dateCode:     document.getElementById("meDc").value.trim(),
                tradingCode:  document.getElementById("meTc").value.trim(),
                po:           document.getElementById("mePo").value.trim(),
                inventoryNo:  document.getElementById("meIn").value.trim(),
                lotNo:        document.getElementById("meLotNo").value.trim(),
                itemType,
            };

            bootstrap.Modal.getInstance(document.getElementById("manualModal")).hide();

            if (editingRow) {
                // Update existing row in-place
                editingRow.querySelector("td:first-child").textContent = partNo;
                editingRow.querySelector(".desc").value        = extras.description;
                editingRow.querySelector(".unit").value        = unit;
                editingRow.querySelector(".qty").value         = String(qty);
                editingRow.querySelector(".traceId").value     = traceId;
                editingRow.querySelector(".rowVendor").value   = extras.vendor;
                editingRow.querySelector(".rowDc").value       = extras.dateCode;
                editingRow.querySelector(".rowTc").value       = extras.tradingCode;
                editingRow.querySelector(".rowPo").value       = extras.po;
                editingRow.querySelector(".rowIn").value       = extras.inventoryNo;
                editingRow.querySelector(".rowLotNo").value    = extras.lotNo || "";
                editingRow.querySelector(".rowItemType").value = String(itemType);
                editingRow.querySelector(".desc").classList.toggle("err", !extras.description);
                editingRow = null;
                toast(`✅ อัปเดต ${partNo} สำเร็จ`, "ok");
                return;
            }

            await addRow(partNo, qty, unit, traceId, extras);
            toast(`✅ เพิ่ม ${partNo} สำเร็จ`, "ok");
        }

        function syncWODisplay() {
            if (currentWO) document.getElementById("woSearch").value = currentWO;
        }

        // ── HTML escape helper ─────────────────────────
        function esc(s) { return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }

        // ── WO autocomplete ────────────────────────────
        let woTopResults = [], woSearchTimer = null;

        function searchWorkOrder() {
            const text = document.getElementById("woSearch").value.trim();
            currentWO = null; currentLine = null;
            updateReceiveBtn();

            const dd = document.getElementById("woDropdown");
            if (!text) { dd.style.display = "none"; return; }

            dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
            </div>`;
            dd.style.display = "block";

            clearTimeout(woSearchTimer);
            woSearchTimer = setTimeout(async () => {
                try {
                    const json = await api(`/workorder?Page=1&PageSize=20&Search=${encodeURIComponent(text)}&SortBy=LastSyncedAt&SortDir=desc`, "GET");
                    woTopResults = json?.data?.data ?? json?.data ?? [];

                    if (!woTopResults.length) {
                        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                            <i class="bi bi-search me-2"></i>ไม่พบ Work Order
                        </div>`;
                        return;
                    }

                    dd.innerHTML = woTopResults.map((x, i) => `
                        <div class="loc-item" onmousedown="selectWorkOrder(${i})">
                            <i class="bi bi-box-seam" style="color:var(--blue);flex-shrink:0"></i>
                            <span>
                                <strong>${esc(x.moNumber)}</strong>
                                ${x.modelName ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${esc(x.modelName)}</span>` : ""}
                            </span>
                            ${x.lineName ? `<span style="margin-left:auto;font-size:11px;color:var(--t3)">${esc(x.lineName)}</span>` : ""}
                        </div>`).join("");
                } catch {
                    dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                        <i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ
                    </div>`;
                }
            }, 300);
        }

        function selectWorkOrder(i) {
            const x = woTopResults[i];
            document.getElementById("woSearch").value = x.moNumber;
            currentWO   = x.moNumber;
            currentLine = x.lineName || null;
            document.getElementById("woDropdown").style.display = "none";
            rxShowError("woSearch", false);
            updateReceiveBtn();
        }

        function hideWODropdown() {
            const dd = document.getElementById("woDropdown");
            if (dd) dd.style.display = "none";
        }

        function updateReceiveBtn() {
            const hasItems = document.querySelectorAll("#receivingTable tr").length > 0;
            const enabled  = hasItems && !_rxReceiving;
            const btn = document.getElementById("receiveBtn");
            btn.disabled      = !enabled;
            btn.style.opacity = enabled ? "1" : "0.45";
            btn.style.cursor  = enabled ? "pointer" : "not-allowed";
            if (currentWO)                                   rxShowError("woSearch",       false);
            if (document.getElementById("locationId").value) rxShowError("locationSearch", false);
        }

        // ── Location ───────────────────────────────────
        let locationResults = [], locationSearchTimer = null;

        async function searchLocation() {
            const text = document.getElementById("locationSearch").value.trim();
            document.getElementById("locationId").value = "";
            updateReceiveBtn();

            const dd = document.getElementById("locationDropdown");
            if (!text) { dd.style.display = "none"; return; }

            dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px"></span>กำลังค้นหา…
            </div>`;
            dd.style.display = "block";

            clearTimeout(locationSearchTimer);
            locationSearchTimer = setTimeout(async () => {
                try {
                    const json = await api(`/location?search=${encodeURIComponent(text)}&page=1&pageSize=20`, "GET");
                    locationResults = json?.data?.data ?? json?.data ?? [];

                    if (!locationResults.length) {
                        dd.innerHTML = `<div class="loc-item" style="color:var(--t2);cursor:default">
                            <i class="bi bi-search me-2"></i>ไม่พบ Location
                        </div>`;
                        return;
                    }

                    dd.innerHTML = locationResults.map((loc, i) => `
                        <div class="loc-item" onmousedown="selectLocation(${i})">
                            <i class="bi bi-geo-alt-fill" style="color:var(--blue);flex-shrink:0"></i>
                            <span>
                                <strong>${esc(loc.locationCode)}</strong>
                                ${loc.description ? `<span style="color:var(--t2);font-size:12px;margin-left:6px">${esc(loc.description)}</span>` : ""}
                            </span>
                            ${loc.typeName ? `<span style="margin-left:auto;font-size:11px;color:var(--t3)">${esc(loc.typeName)}</span>` : ""}
                        </div>`).join("");
                } catch {
                    dd.innerHTML = `<div class="loc-item" style="color:var(--red);cursor:default">
                        <i class="bi bi-exclamation-circle me-2"></i>โหลดไม่สำเร็จ
                    </div>`;
                }
            }, 300);
        }

        function selectLocation(i) {
            const loc = locationResults[i];
            document.getElementById("locationSearch").value = loc.locationCode;
            document.getElementById("locationId").value = loc.id;
            document.getElementById("locationDropdown").style.display = "none";
            rxShowError("locationSearch", false);
            updateReceiveBtn();
        }

        function hideLocationDropdown() {
            document.getElementById("locationDropdown").style.display = "none";
        }

        // ── Options ────────────────────────────────────
        function toggleOptions() {
            const body = document.getElementById("optBody");
            const icon = document.getElementById("optIcon");
            const open = body.style.display !== "none";
            body.style.display    = open ? "none" : "";
            icon.style.transform  = open ? "" : "rotate(180deg)";
        }

        // ── Receive ────────────────────────────────────
        async function receive() {
            const hasItems = document.querySelectorAll("#receivingTable tr").length > 0;
            if (!hasItems || _rxReceiving) return;

            // Validate: Work Order
            if (!currentWO) {
                rxShowError("woSearch", true);
                document.getElementById("woSearch").scrollIntoView({ behavior: "smooth", block: "center" });
                setTimeout(() => document.getElementById("woSearch").focus(), 300);
                toast("กรุณาเลือก Work Order", "err");
                return;
            }

            // Validate: Location
            const locationCode = document.getElementById("locationSearch").value.trim();
            const locationId   = document.getElementById("locationId").value;
            if (!locationCode || !locationId) {
                rxShowError("locationSearch", true);
                document.getElementById("locationSearch").scrollIntoView({ behavior: "smooth", block: "center" });
                setTimeout(() => document.getElementById("locationSearch").focus(), 300);
                toast("กรุณาเลือก Location", "err");
                return;
            }

            _rxReceiving = true;
            updateReceiveBtn();
            const btn = document.getElementById("receiveBtn");
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลัง Receive…';

            try {
            let latitude = 0, longitude = 0;
            const skipGps = document.getElementById("optSkipGps").checked;
            if (!skipGps) {
                if (!navigator.geolocation) {
                    toast("Browser ไม่รองรับ GPS", "err"); return;
                }
                btn.innerHTML = '<i class="bi bi-geo-alt"></i> Getting GPS…';
                try {
                    const pos = await new Promise((res, rej) =>
                        navigator.geolocation.getCurrentPosition(res, rej, { enableHighAccuracy: true, timeout: 8000 })
                    );
                    latitude  = pos.coords.latitude;
                    longitude = pos.coords.longitude;
                    console.log('[Receive] GPS lat:', latitude, 'lng:', longitude);
                } catch (e) {
                    toast("GPS error: " + e.message, "err"); return;
                }
                btn.innerHTML = '<i class="bi bi-hourglass-split"></i> กำลัง Receive…';
            }

            const rows  = document.querySelectorAll("#receivingTable tr");
            const items = [];
            rows.forEach(r => {
                const partNo      = r.querySelector("td:first-child")?.textContent?.trim();
                const desc        = r.querySelector(".desc")?.value || "";
                const unit        = r.querySelector(".unit")?.value || "";
                const qty         = parseInt(r.querySelector(".qty")?.value) || 0;
                const traceId     = r.querySelector(".traceId")?.value || "";
                const vendor      = r.querySelector(".rowVendor")?.value || "";
                const dateCode    = r.querySelector(".rowDc")?.value || "";
                const tradingCode = r.querySelector(".rowTc")?.value || "";
                const po          = r.querySelector(".rowPo")?.value || "";
                const inventoryNo = r.querySelector(".rowIn")?.value || "";
                const lotNo       = r.querySelector(".rowLotNo")?.value || "";
                const itemType    = parseInt(r.querySelector(".rowItemType")?.value) || 1;
                if (!partNo || qty <= 0) return;
                items.push({
                    partNo, description: desc,
                    workOrderNo: currentWO || "", locationCode,
                    quantity: qty, unit, traceId,
                    vendor, dateCode, tradingCode, po, inventoryNo,
                    lotNo, itemType, latitude, longitude
                });
            });

            if (!items.length) { toast("ไม่มีรายการ", "err"); return; }

            const allOptions = {
                skipGpsValidation:          document.getElementById("optSkipGps").checked,
                skipPrintedValidation:      document.getElementById("optSkipPrinted").checked,
                skipWorkOrderValidation:    document.getElementById("optSkipWO").checked,
                skipLocationValidation:     document.getElementById("optSkipLoc").checked,
                skipLotDuplicateValidation: document.getElementById("optSkipDup").checked,
                skipReservedLotValidation:  document.getElementById("optSkipRes").checked,
                skipManualLotValidation:    document.getElementById("optSkipManual").checked,
            };
            const options = Object.fromEntries(Object.entries(allOptions).filter(([, v]) => v));

            const findRow = traceId => [...document.querySelectorAll("#receivingTable tr")]
                .find(r => r.querySelector(".traceId")?.value === traceId);

            let successCount = 0, failCount = 0;
            for (const item of items) {
                const row = findRow(item.traceId);
                if (row) {
                    const errDetail = row.nextElementSibling
                    if (errDetail?.classList.contains('row-err-detail')) errDetail.remove()
                    row.classList.remove("row-err", "row-ok"); row.style.pointerEvents = "none"; row.style.opacity = ".5";
                }
                try {
                    const res  = await api("/inventory/receive", "POST", { command: { items: [item] }, options });
                    const data = res?.data || [];
                    const fail = data.find(d => !d.success);
                    if (fail) {
                        failCount++;
                        const errMsg = [fail.errorCode, fail.message].filter(Boolean).join(': ') || "Error";
                        toast(`❌ ${item.partNo}: ${errMsg}`, "err");
                        if (row) showRowError(row, errMsg)
                    } else {
                        successCount++;
                        if (row) {
                            row.classList.add("row-ok");
                            await new Promise(r => setTimeout(r, 600));
                            row.remove();
                        }
                        scannedTrace.delete(item.traceId);
                    }
                } catch (err) {
                    failCount++;
                    const errMsg = err.message || "Error";
                    toast(`❌ ${item.partNo}: ${errMsg}`, "err");
                    if (row) showRowError(row, errMsg)
                }
            }

            if (failCount === 0) {
                toast(`Receive สำเร็จ ${successCount} รายการ ✓`, "ok");
                currentWO = null; currentLine = null;
                syncTableState(); syncWODisplay();
            } else if (successCount > 0) {
                toast(`สำเร็จ ${successCount} — ล้มเหลว ${failCount} รายการ`, "warn");
            } else {
                toast(`ล้มเหลว ${failCount} รายการ`, "err");
            }

            } finally {
                _rxReceiving = false;
                btn.innerHTML = "Receive";
                updateReceiveBtn();
            }
        }

        // ── Toast ──────────────────────────────────────
        function toast(msg, type) {
            const wrap = document.getElementById("toastWrap");
            const el   = document.createElement("div");
            const cls  = type === "ok" ? "toast-ok" : type === "warn" ? "toast-warn" : "toast-err";
            el.className = "toast-item " + cls;
            el.textContent = msg;
            wrap.appendChild(el);
            setTimeout(() => el.remove(), type === "warn" ? 5000 : 3000);
        }

    </script>
}
