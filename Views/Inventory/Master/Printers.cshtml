@{
    ViewData["Title"] = "Master Management";
}
<link rel="stylesheet" href="css/master-shared.css"/>
<link rel="stylesheet" href="css/printqr.css"/>
<style>
/* ── Printer status detail toggle (Basic / Advance) — segmented icon switch ── */
.printer-mode-toggle { display:flex; background:#f0f2f5; border-radius:9px; padding:3px; gap:2px; }
[data-theme="dark"] .printer-mode-toggle { background:#253347; }
.printer-mode-btn {
    width:32px; height:32px; border:none; border-radius:7px; background:transparent;
    color:var(--t2); font-size:14px; cursor:pointer; display:flex; align-items:center; justify-content:center;
    transition:.15s; font-family:inherit;
}
.printer-mode-btn:hover { color:var(--blue); }
.printer-mode-btn.active { background:#fff; color:var(--blue); box-shadow:0 1px 4px rgba(0,0,0,.1); }
[data-theme="dark"] .printer-mode-btn.active { background:#1e293b; }

/* ── location badge เดี่ยว (icon + ชื่อ ย้อมสีตามประเภท) เหมือน LotDetail.cshtml ── */
.loc-type-badge {
    display:inline-flex; align-items:center; gap:4px;
    padding:2px 9px 2px 7px; border-radius:20px; font-size:11px; font-weight:700;
    white-space:nowrap; line-height:1.6;
}

/* ── shared loc-input style (เหมือน Receive.cshtml) — location picker ใน Printer modal ── */
.loc-wrap { position:relative; }
.loc-input {
    width:100%; padding:8px 10px 8px 34px;
    border:1.5px solid var(--border); border-radius:8px;
    font-size:13px; font-family:inherit; color:var(--text);
    outline:none; transition:border-color .15s; box-sizing:border-box; background:transparent;
}
.loc-input:focus { border-color:var(--blue); }
.loc-icon { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:var(--t3); pointer-events:none; }
.loc-dd {
    /* position:fixed (ไม่ใช่ absolute) + คำนวณตำแหน่งด้วย JS ตอนเปิด — กัน .modal-box ที่มี overflow-y:auto
       clip dropdown ออกไป (เจอปัญหานี้มาแล้วหลายที่ในแอป เช่น Users.cshtml) */
    position:fixed; z-index:1050;
    background:#fff; border:1.5px solid var(--blue); border-radius:10px;
    box-shadow:0 6px 24px rgba(0,0,0,.12); max-height:230px; overflow-y:auto; display:none;
}
.loc-item {
    padding:9px 12px; font-size:13px; cursor:pointer;
    border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; transition:.12s;
}
.loc-item:last-child { border-bottom:none; }
.loc-item:hover { background:var(--blue-lt); }
[data-theme="dark"] .loc-dd { background:#1e293b; }

/* ── Location Type filter dropdown (เหมือน Lots.cshtml) — trigger+menu ที่ position:fixed กันโดน .section-card overflow ตัด ── */
.loc-filter-dd-wrap { position:relative; }
.loc-filter-dd-trigger {
    display:flex; align-items:center; gap:8px; min-width:150px;
    padding:8px 12px; border:1px solid var(--border); border-radius:8px;
    font-size:13px; font-family:inherit; background:#fff; color:var(--text);
    cursor:pointer; transition:border-color .15s;
}
.loc-filter-dd-trigger:hover, .loc-filter-dd-trigger.open { border-color:var(--blue); }
.loc-filter-dd-menu {
    position:fixed; min-width:190px; z-index:9999;
    background:#fff; border:1.5px solid var(--border); border-radius:9px;
    box-shadow:0 4px 16px rgba(0,0,0,.12); max-height:280px; overflow-y:auto;
}
.loc-filter-dd-item {
    display:flex; align-items:center; gap:8px; padding:8px 12px;
    font-size:13px; cursor:pointer; transition:background .1s;
}
.loc-filter-dd-item:hover  { background:#f1f5ff; }
.loc-filter-dd-item.active { background:#eff6ff; }
[data-theme="dark"] .loc-filter-dd-trigger { background:#0f172a; border-color:var(--border); }
[data-theme="dark"] .loc-filter-dd-menu    { background:#1e293b; border-color:var(--border); }
[data-theme="dark"] .loc-filter-dd-item:hover  { background:#253347; }
[data-theme="dark"] .loc-filter-dd-item.active { background:#162032; }
</style>

<div class="toast-stack" id="toastStack"></div>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2>Master Management</h2>
    </div>
</div>

@await Html.PartialAsync("Master/_MasterManagement")

<!-- ── PRINTERS ── -->
<div class="section-card">
    <div class="sc-head">
        <div class="sc-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1a6fff" stroke-width="2.5">
                <polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
            </svg>
            Printers
            <span id="printerCount" class="count-badge"></span>
        </div>
        <div class="filter-bar">
            <input id="printerSearch" class="filter-input" placeholder="Search Name / IP..." style="min-width:190px"
                   oninput="printersDebouncedSearch()">
            <div class="loc-filter-dd-wrap">
                <div class="loc-filter-dd-trigger" id="printerLocTypeTrigger" tabindex="0" onclick="toggleFilterDd('printerLocTypeTrigger','printerLocTypeMenu')">
                    <span id="printerLocTypeLabel">All Locations</span>
                    <i class="bi bi-chevron-down" style="font-size:11px;margin-left:auto;color:var(--t2)"></i>
                </div>
                <div class="loc-filter-dd-menu" id="printerLocTypeMenu" style="display:none">
                    <div class="loc-filter-dd-item active" data-val="" onclick="printerLocTypeDdPick('', 'All Locations')">All Locations</div>
                </div>
                <input type="hidden" id="printerLocTypeFilter" value="">
            </div>
            @* <button class="btn-create" style="background:#f0f2f5;color:var(--text);border:1px solid var(--border)" onclick="loadPrinters()">🔄 Refresh</button> *@
            <div class="printer-mode-toggle" id="printerModeToggle">
                <button type="button" class="printer-mode-btn active" data-mode="basic" onclick="setPrinterStatusMode('basic')" title="Basic Status — สรุปสั้นๆ (OK หรือปัญหาที่เจอ)">
                    <i class="bi bi-circle-fill"></i>
                </button>
                <button type="button" class="printer-mode-btn" data-mode="advanced" onclick="setPrinterStatusMode('advanced')" title="Advance Status — โชว์รายละเอียดทุกฟิลด์เสมอ">
                    <i class="bi bi-list-check"></i>
                </button>
            </div>
            <button class="btn-create" onclick="openPrinterModal()">+ Add Printer</button>
        </div>
    </div>
    <div style="overflow-x:auto">
        <table class="inv-table">
            <thead>
                <tr>
                    <th>Network</th>
                    <th>Printer Name</th>
                    <th>IP Address</th>
                    <th style="text-align:center">PORT</th>
                    <th>Location</th>
                    <th style="text-align:center">Battery</th>
                    <th>Status</th>
                    <th>Active</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="printersTable">
                <tr><td colspan="9" style="text-align:center;color:var(--t3);padding:32px">⏳ กำลังโหลด…</td></tr>
            </tbody>
        </table>
    </div>
    <div class="pag-bar">
        <span class="pag-info" id="printerPageInfo"></span>
        <div class="pag-btns" id="printerPagination"></div>
    </div>
</div>

<!-- ── PRINTER MODAL ── -->
<div class="modal-overlay" id="printerModal">
    <div class="modal-box">
        <div class="modal-title" id="printerModalTitle">Add Printer</div>
        <input type="hidden" id="printerId">
        <div class="modal-field">
            <div class="modal-label">Name <span style="color:var(--red)">*</span></div>
            <input class="modal-input" id="printerName" placeholder="e.g. ZD420 · Line 1">
        </div>
        <div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end">
            <div class="modal-field" style="margin-bottom:0">
                <div class="modal-label">IP Address <span style="color:var(--red)">*</span></div>
                <input class="modal-input" id="printerIp" placeholder="e.g. 10.204.37.10">
            </div>
            <div class="modal-field" style="margin-bottom:0;width:90px">
                <div class="modal-label">Port <span style="color:var(--red)">*</span></div>
                <input class="modal-input" id="printerPort" type="number" min="1" max="65535" placeholder="9100">
            </div>
        </div>
        <div class="modal-field" style="margin-top:12px">
            <div class="modal-label">Location</div>
            <div class="loc-wrap">
                <i class="bi bi-search loc-icon" style="font-size:13px"></i>
                <input class="modal-input loc-input" id="printerLocationSearch" placeholder="ค้นหา Location..." autocomplete="off">
                <input type="hidden" id="printerLocationId">
                <input type="hidden" id="printerLocationCode">
                <div id="printerLocationDropdown" class="loc-dd"></div>
            </div>
        </div>
        <label class="modal-check" style="margin-top:12px">
            <input type="checkbox" id="printerActive" checked> Active
        </label>
        <div class="modal-error" id="printerError"></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('printerModal')">ยกเลิก</button>
            <button class="modal-btn modal-btn-primary" onclick="savePrinter()">Save</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="js/api.js"></script>
<script src="js/printerPicker.js"></script>
<script src="js/zebraHostStatus.js"></script>
<script src="js/master-shared.js"></script>
<script src="js/loadLocation.js"></script>
<script src="js/locationAutocomplete.js"></script>
<script src="js/locationTypeMeta.js"></script>
<script>
    const _PRINTER_PAGE_SIZE = 10
    let _printerRows    = []   // { p, status } — status: undefined = ยังโหลดไม่เสร็จ, null = โหลดแล้วแต่ fail, object = ผลจริง
    let _printerCurPage = 1

    // Pill badge แบบจุดสี (เขียว/แดง/เทา) เหมือน bomActiveBadge ใน BomProfiles.cshtml — ใช้ร่วมกันทั้งคอลัมน์ Status และ Active
    function _pillBadge(label, tone) {
        const TONE = {
            green: { bg: 'var(--green-lt)', color: 'var(--green)', dot: '#22c55e', glow: true },
            red:   { bg: 'var(--red-lt)',   color: 'var(--red)',   dot: '#ef4444', glow: false },
            gray:  { bg: '#f0f2f5',         color: 'var(--t3)',    dot: '#d1d5db', glow: false },
        }
        const m = TONE[tone] || TONE.gray
        return `<span style="display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;background:${m.bg};color:${m.color}">
            <span style="width:8px;height:8px;border-radius:50%;background:${m.dot};flex-shrink:0;${m.glow ? 'box-shadow:0 0 6px #22c55e66' : ''}"></span>${label}
        </span>`
    }

    const _networkBadge = (st) => {
        if (st === undefined) return `<span style="color:var(--t3)">⏳</span>`
        if (st === null)      return `<span style="color:var(--t3)">—</span>`
        const online = st.isReady === true
        return _pillBadge(online ? 'Online' : 'Offline', online ? 'green' : 'gray')
    }

    const _batteryText = (st) => {
        if (st === undefined || st === null) return '—'
        return printerBatteryHtml(st.batteryPercent) || '—'
    }

    // สถานะเครื่อง (isHeadOpen, isPaperOut จาก /printer/zebra/status/batch) — โชว์เป็น badge สีแดง/อำพัน ถ้ามีปัญหา, เขียว "OK" ถ้าไม่มี
    const _statusBadge = (label) => _pillBadge(label, 'red')

    // Basic = สรุปสั้น โชว์แค่ตอนมีปัญหา (ปกติเห็นแค่ "OK")
    // isReady:false (เครื่องไม่ตอบ) → isHeadOpen/isPaperOut จะเป็น null ทั้งคู่ ถ้าไม่เช็ค isReady ก่อนจะเข้าใจผิดว่า "OK" ทั้งที่จริงต่อเครื่องไม่ติด
    // (คอลัมน์ Network ข้างๆ บอก Online/Offline อยู่แล้ว คอลัมน์นี้เลยโชว์ "—" แทน ไม่ใช่ "OK" หรือ "Offline" ซ้ำ)
    const _statusBadgesBasic = (st) => {
        if (st.isReady !== true) return `<span style="color:var(--t3)">—</span>`
        const badges = []
        if (st.isHeadOpen)  badges.push(_statusBadge('Head Open'))
        if (st.isPaperOut)  badges.push(_statusBadge('Paper Out'))
        if (!badges.length) return _pillBadge('OK', 'green')
        return `<div style="display:flex;flex-direction:column;gap:2px">${badges.join('')}</div>`
    }

    // Advanced = parse field "rawHostStatus" (~HS ดิบจากเครื่องพิมพ์) เต็มรูปแบบ ตาม docs/zebra_hs_status_reference.md
    // /printer/zebra/status/batch ไม่คืน field นี้มาเลย (ต่างจาก endpoint เดี่ยวเดิม) เลยจะ fallback ไปโชว์สรุปสั้นแบบ Basic เสมอตอนนี้
    // ถ้า parse ไม่ได้ (ไม่มี field นี้ / เครื่องรุ่นอื่นที่ format ไม่ตรง) fallback ไปโชว์สรุปสั้นแบบ Basic แทน
    const _advChip = (label, ok) =>
        `<span style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;color:${ok ? 'var(--green)' : 'var(--red)'}">
            <i class="bi ${ok ? 'bi-check-circle-fill' : 'bi-x-circle-fill'}"></i>${label}
        </span>`
    const _statusBadgesAdvanced = (st) => {
        const parsed = parseZebraHostStatus(st.rawHostStatus)
        if (parsed) return zebraHostStatusHtml(parsed)
        // isReady:false → isHeadOpen/isPaperOut เป็น null หมด ไม่มีอะไรให้สรุปย่อจริงๆ (คอลัมน์ Network บอก Offline อยู่แล้ว)
        if (st.isReady !== true) return `<span style="color:var(--t3)">—</span>`
        return `<div style="display:flex;flex-direction:column;gap:2px">
            <span style="font-size:10px;color:var(--t3);font-style:italic">raw status ไม่พร้อม — สรุปย่อ:</span>
            ${_advChip('Head Closed', !st.isHeadOpen)}
            ${_advChip('Paper OK',    !st.isPaperOut)}
        </div>`
    }

    let _printerStatusMode = 'basic'   // 'basic' | 'advanced' — คุมด้วยปุ่ม toggle ข้าง "+ Add Printer"
    function setPrinterStatusMode(mode) {
        _printerStatusMode = mode
        document.querySelectorAll('#printerModeToggle .printer-mode-btn').forEach(b =>
            b.classList.toggle('active', b.dataset.mode === mode))
        _renderPrinterPage(_printerCurPage)
    }

    const _statusBadges = (st) => {
        if (st === undefined) return `<span style="color:var(--t3)">⏳</span>`
        if (st === null)      return `<span style="color:var(--t3)">—</span>`
        return _printerStatusMode === 'advanced' ? _statusBadgesAdvanced(st) : _statusBadgesBasic(st)
    }

    // resolve locationId/locationCode ของ printer เป็น location object เต็มๆ (ใช้ทั้งแสดงผลและ filter ตาม type)
    // ต้องรอ loadLocation() เสร็จก่อน (init() เรียกก่อน loadPrinters() อยู่แล้ว)
    function _printerLoc(p) {
        return p.locationId ? _locIdMap.get(p.locationId) : (p.locationCode ? _locNameMap.get(p.locationCode) : null)
    }

    // resolve เป็น badge เดียว (icon + ชื่อ ย้อมสีตามประเภท) — เหมือน locBadgeForCode() ใน LotDetail.cshtml
    function _printerLocDisplay(p) {
        const loc  = _printerLoc(p)
        const name = loc?.displayName || p.locationCode || null
        if (!name) return '<span style="color:var(--t3)">—</span>'
        const type = loc?.typeName || ''
        return `<span class="loc-type-badge" style="${locTypeBadgeStyle(type)}">${locHierTypeIcon(type)}${name}</span>`
    }

    // ── Search (Printer Name / IP) + Location Type filter — กรองฝั่ง client จาก _printerRows ที่โหลดมาแล้วทั้งหมด ──
    let _printerFiltered = []

    function applyPrinterFilters() {
        const q       = (document.getElementById('printerSearch')?.value || '').trim().toLowerCase()
        const locType = document.getElementById('printerLocTypeFilter')?.value || ''
        _printerFiltered = _printerRows.filter(({ p }) => {
            if (q && !((p.printerName || '').toLowerCase().includes(q) || (p.printerIp || '').toLowerCase().includes(q))) return false
            if (locType && (_printerLoc(p)?.typeName || '').toLowerCase() !== locType.toLowerCase()) return false
            return true
        })
        _renderPrinterPage(1)
    }

    let _printerSearchTimer = null
    function printersDebouncedSearch() {
        clearTimeout(_printerSearchTimer)
        _printerSearchTimer = setTimeout(applyPrinterFilters, 400)
    }

    function _renderPrinterPage(page) {
        _printerCurPage   = page
        const tbody       = document.getElementById('printersTable')
        const start       = (page - 1) * _PRINTER_PAGE_SIZE
        const slice       = _printerFiltered.slice(start, start + _PRINTER_PAGE_SIZE)
        const totalPages  = Math.ceil(_printerFiltered.length / _PRINTER_PAGE_SIZE) || 1

        if (!_printerFiltered.length) {
            tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:var(--t3);padding:32px">ไม่พบเครื่องพิมพ์ที่ตรงกับตัวกรอง</td></tr>`
            renderPagination('printerPagination', 'printerPageInfo', 1, 1, '_renderPrinterPage')
            return
        }

        tbody.innerHTML = slice.map(({ p, status }) => {
            const active    = p.isActive !== false
            const ip        = p.printerIp ?? ''
            const activeTxt = _pillBadge(active ? 'Active' : 'Inactive', active ? 'green' : 'gray')
            return `<tr data-pid="${p.id}">
                <td class="net-cell">${_networkBadge(status)}</td>
                <td style="font-weight:600;color:var(--navy)">${p.printerName ?? '—'}</td>
                <td style="font-family:ui-monospace,monospace">${ip || '—'}</td>
                <td style="font-family:ui-monospace,monospace;text-align:center">${p.printerPort ?? '—'}</td>
                <td style="color:var(--t2)">${_printerLocDisplay(p)}</td>
                <td class="batt-cell" style="text-align:center">${_batteryText(status)}</td>
                <td class="stat-cell">${_statusBadges(status)}</td>
                <td>${activeTxt}</td>
                <td style="white-space:nowrap">
                    <button onclick="openPrinterModal(${JSON.stringify(p).replace(/"/g,'&quot;')})"
                        style="background:none;border:none;cursor:pointer;color:var(--amber);font-size:16px;padding:4px 6px;border-radius:6px"
                        title="Edit"><i class="bi bi-pencil"></i></button>
                    <button onclick="deletePrinter(${p.id})"
                        style="background:none;border:none;cursor:pointer;color:var(--red);font-size:16px;padding:4px 6px;border-radius:6px"
                        title="Delete"><i class="bi bi-trash"></i></button>
                </td>
            </tr>`
        }).join('')

        renderPagination('printerPagination', 'printerPageInfo', page, totalPages, '_renderPrinterPage')
    }

    // อัปเดตแค่ row เดียวที่ status กลับมา — ไม่ re-render ทั้งตาราง
    function _patchPrinterStatus(printerId, status) {
        const row = _printerRows.find(r => r.p.id === printerId)
        if (row) row.status = status

        const tr = document.querySelector(`#printersTable tr[data-pid="${printerId}"]`)
        if (!tr) return   // ไม่ได้อยู่หน้าที่กำลังดูอยู่ตอนนี้ — ไม่ต้อง patch DOM
        tr.querySelector('.net-cell').innerHTML  = _networkBadge(status)
        tr.querySelector('.batt-cell').innerHTML = _batteryText(status)
        tr.querySelector('.stat-cell').innerHTML = _statusBadges(status)
    }

    async function loadPrinters() {
        const tbody = document.getElementById('printersTable')
        tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:var(--t3);padding:24px">⏳ กำลังโหลด…</td></tr>`
        try {
            const allRes   = await api('/printer/all', 'GET')
            const printers = Array.isArray(allRes) ? allRes : (allRes?.data ?? [])

            document.getElementById('printerCount').textContent = printers.length
            if (printers.length === 0) {
                _printerRows     = []
                _printerFiltered = []
                tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:var(--t3);padding:32px">ยังไม่มีเครื่องพิมพ์ — กด "+ Add Printer" เพื่อเพิ่ม</td></tr>`
                return
            }

            // แสดงตารางทันทีจาก /printer/all — status ยังเป็น undefined (⏳) ก่อน
            _printerRows = printers.map(p => ({ p, status: undefined }))
            _rebuildPrinterLocTypeOptions()
            applyPrinterFilters()   // เคารพ search/filter ที่พิมพ์ไว้อยู่แล้ว (เช่น ตอน reload หลัง save printer)

            // ยิง /printer/zebra/status/batch ครั้งเดียวสำหรับ printer ทั้งหมด (แทนยิงทีละตัว) — ไม่ block การแสดงตาราง
            fetchPrinterStatusBatch(printers).then(map => {
                printers.forEach(p => _patchPrinterStatus(p.id, map.get(p.printerIp) || null))
            })
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:var(--red);padding:24px">Load failed: ${err.message}</td></tr>`
        }
    }

    // ── Location Type filter dropdown — trigger+menu position:fixed กัน .section-card overflow ตัด (เหมือน Lots.cshtml) ──
    function toggleFilterDd(triggerId, menuId) {
        const menu    = document.getElementById(menuId)
        const trigger = document.getElementById(triggerId)
        const opening = menu.style.display === 'none'
        closeAllFilterDd()
        if (opening) {
            const r = trigger.getBoundingClientRect()
            menu.style.left     = r.left + 'px'
            menu.style.top      = (r.bottom + 4) + 'px'
            menu.style.minWidth = r.width + 'px'
            menu.style.display  = ''
            trigger.classList.add('open')
        }
    }
    function closeAllFilterDd() {
        const menu = document.getElementById('printerLocTypeMenu')
        const trg  = document.getElementById('printerLocTypeTrigger')
        if (menu) menu.style.display = 'none'
        if (trg)  trg.classList.remove('open')
    }
    window.addEventListener('scroll', e => {
        const el = document.getElementById('printerLocTypeMenu')
        if (el && el.style.display !== 'none' && !el.contains(e.target)) el.style.display = 'none'
    }, true)
    window.addEventListener('resize', closeAllFilterDd)
    document.addEventListener('click', e => {
        if (!e.target.closest('.loc-filter-dd-wrap')) closeAllFilterDd()
    })

    // สร้าง option ใน dropdown จาก type ที่ "มีจริง" ใน printer list ปัจจุบันเท่านั้น (ไม่ดึงทุก type จาก /location/types
    // เพราะจะมี type ที่ไม่มี printer ผูกอยู่เลยปนมาด้วย ทำให้เลือกไปแล้วได้ list ว่างเปล่า) — เรียกใหม่ทุกครั้งที่ loadPrinters() เสร็จ
    function _rebuildPrinterLocTypeOptions() {
        const menu   = document.getElementById('printerLocTypeMenu')
        const hidden = document.getElementById('printerLocTypeFilter')
        if (!menu || !hidden) return

        const typesInUse = new Map()   // key = lowercase (กันซ้ำ), value = label case ตามที่เจอครั้งแรก
        _printerRows.forEach(({ p }) => {
            const type = _printerLoc(p)?.typeName
            if (type && !typesInUse.has(type.toLowerCase())) typesInUse.set(type.toLowerCase(), type)
        })

        // type ที่เคยเลือกไว้ไม่มีในลิสต์ปัจจุบันแล้ว (เช่น printer ที่ใช้ type นั้นถูกลบ/ย้ายที่หมด) → รีเซ็ตกลับ All Locations
        let currentVal = hidden.value
        if (currentVal && !typesInUse.has(currentVal.toLowerCase())) {
            currentVal = ''
            hidden.value = ''
            document.getElementById('printerLocTypeLabel').textContent = 'All Locations'
        }

        menu.innerHTML = `<div class="loc-filter-dd-item${currentVal ? '' : ' active'}" data-val="" onclick="printerLocTypeDdPick('', 'All Locations')">All Locations</div>` +
            [...typesInUse.values()].sort((a, b) => a.localeCompare(b)).map(label =>
                `<div class="loc-filter-dd-item${currentVal.toLowerCase() === label.toLowerCase() ? ' active' : ''}" data-val="${label}" onclick="printerLocTypeDdPick('${label}', '${label}')">
                    ${locHierTypeIcon(label)} <span style="color:${locTypeMeta(label).color};font-weight:600">${label}</span>
                </div>`
            ).join('')
    }

    function printerLocTypeDdPick(val, label) {
        document.getElementById('printerLocTypeFilter').value = val
        document.getElementById('printerLocTypeLabel').innerHTML = val
            ? `${locHierTypeIcon(label)} <span style="color:${locTypeMeta(label).color};font-weight:600">${label}</span>`
            : 'All Locations'
        document.querySelectorAll('#printerLocTypeMenu .loc-filter-dd-item').forEach(it => {
            it.classList.toggle('active', it.dataset.val === val)
        })
        closeAllFilterDd()
        applyPrinterFilters()
    }

    // Location picker ใน Printer modal — ใช้ location ทั้งหมดในระบบ (ไม่กรองตาม permission ผู้ใช้ที่ login อยู่)
    // เพราะเป็นหน้า Master ตั้งค่าเครื่องพิมพ์ ไม่ใช่หน้า operation ที่ผูกกับสิทธิ์ของแต่ละคน
    // createLocationAutocomplete รับ "locations" เป็น snapshot คงที่ตอนสร้าง (ไม่รองรับ getLocations แบบ live จริง
    // ถึงจะมี param ให้ก็ตาม — ของเดิมไม่ได้ใช้ค่านี้เลยใน filter()) เลยต้อง await loadLocation() ให้เสร็จก่อนค่อยสร้าง
    let printerLocAutocomplete = null

    // .modal-box มี transform (ใช้ทำ animation เปิด/ปิด) ซึ่งทำให้กลายเป็น containing block ใหม่ของลูกที่ position:fixed
    // (แม้จะเป็น scale(1) ที่มองไม่ออกว่าเปลี่ยนอะไรก็ตาม) ทำให้ dropdown อ้างอิงตำแหน่งจาก .modal-box แทน viewport จริง
    // ย้าย element ออกไปเป็นลูกของ body ตรงๆ เลย ให้หลุดพ้นจาก transform ของ modal ไปเลย
    document.body.appendChild(document.getElementById('printerLocationDropdown'))

    // .loc-dd เป็น position:fixed เลยต้องคำนวณ top/left/width เองจาก input ทุกครั้งก่อนเปิด (มุมเดียวกับ .perm-loc-menu ใน Users.cshtml)
    function _positionPrinterLocDd() {
        const inp = document.getElementById('printerLocationSearch')
        const dd  = document.getElementById('printerLocationDropdown')
        if (!inp || !dd) return
        const rect = inp.getBoundingClientRect()
        dd.style.top   = (rect.bottom + 4) + 'px'
        dd.style.left  = rect.left + 'px'
        dd.style.width = rect.width + 'px'
    }
    document.getElementById('printerLocationSearch').addEventListener('focus', _positionPrinterLocDd)
    document.getElementById('printerLocationSearch').addEventListener('input', _positionPrinterLocDd)

    function openPrinterModal(p) {
        document.getElementById('printerModalTitle').textContent = p ? 'Edit Printer' : 'Add Printer'
        document.getElementById('printerId').value    = p?.id          ?? ''
        document.getElementById('printerName').value  = p?.printerName ?? ''
        document.getElementById('printerIp').value    = p?.printerIp   ?? ''
        document.getElementById('printerPort').value  = p?.printerPort ?? ''
        document.getElementById('printerActive').checked = p?.isActive !== false

        const loc = p?.locationId ? _locIdMap.get(p.locationId) : (p?.locationCode ? _locNameMap.get(p.locationCode) : null)
        document.getElementById('printerLocationSearch').value = loc?.displayName ?? p?.locationCode ?? ''
        document.getElementById('printerLocationId').value     = p?.locationId    ?? ''
        document.getElementById('printerLocationCode').value   = p?.locationCode  ?? ''

        clearModalError('printerError')
        openModal('printerModal')
    }

    async function savePrinter() {
        const name         = document.getElementById('printerName').value.trim()
        const ip           = document.getElementById('printerIp').value.trim()
        const port         = parseInt(document.getElementById('printerPort').value)
        const isActive     = document.getElementById('printerActive').checked
        const id           = document.getElementById('printerId').value
        const locationId   = parseInt(document.getElementById('printerLocationId').value) || 0
        const locationCode = document.getElementById('printerLocationCode').value.trim()
        if (!name)       { showModalError('printerError', 'กรุณากรอก Printer Name'); return }
        if (!ip)         { showModalError('printerError', 'กรุณากรอก IP Address');   return }
        if (!port || port < 1 || port > 65535) { showModalError('printerError', 'กรุณากรอก Port (1–65535)'); return }
        const body = { printerName: name, printerIp: ip, printerPort: port, isActive, locationId, locationCode }
        try {
            if (id) await api(`/printer/edit-printer/${id}`, 'PUT', { id: +id, ...body })
            else    await api('/printer/add-printer', 'POST', body)
            closeModal('printerModal')
            showToast('บันทึก Printer สำเร็จ', 'success')
            loadPrinters()
        } catch (err) { showModalError('printerError', err.message) }
    }

    async function deletePrinter(id) {
        if (!confirm('ลบ Printer นี้?')) return
        try {
            await api(`/printer/delete-printer/${id}`, 'DELETE')
            showToast('ลบ Printer สำเร็จ', 'success')
            loadPrinters()
        } catch (err) { showToast('ลบไม่สำเร็จ: ' + err.message, 'error') }
    }

    async function init() {
        await loadLocation()
        printerLocAutocomplete = createLocationAutocomplete({
            inputId: 'printerLocationSearch', dropdownId: 'printerLocationDropdown',
            locations: Array.from(_locNameMap.values()),
            onSelect: loc => {
                document.getElementById('printerLocationId').value   = loc.id
                document.getElementById('printerLocationCode').value = loc.locationCode
            },
            onClear: () => {
                document.getElementById('printerLocationId').value   = ''
                document.getElementById('printerLocationCode').value = ''
            }
        })
        loadPrinters()
    }
    init()
</script>
}
